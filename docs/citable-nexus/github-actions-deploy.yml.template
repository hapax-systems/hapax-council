# GitHub Actions workflow for the citable-nexus front-door site.
#
# Text template only; it is not evidence of a configured or deployed site.
# The build needs an explicitly configured HAPAX_CITABLE_NEXUS_CANONICAL_URL
# repository variable. No vault or local DataCite snapshot is supplied here;
# the build's default clears no optional inputs. The legacy bootstrap script
# needs reconciliation before reuse (its address and page-count text are stale).

name: Deploy citable-nexus

on:
  schedule:
    - cron: '30 4 * * *'  # 04:30 UTC daily
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: write  # commits the rendered HTML back into main

concurrency:
  group: deploy-${{ github.ref }}
  cancel-in-progress: false

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout hapax-research (this repo)
        uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10
        with:
          path: hapax-research
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Checkout hapax-council (renderer source)
        uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10
        with:
          repository: hapax-systems/hapax-council
          path: hapax-council
          ref: main

      - name: Set up uv
        uses: astral-sh/setup-uv@37802adc94f370d6bfd71619e3f0bf239e1f3b78
        with:
          enable-cache: true

      - name: Install council deps
        working-directory: hapax-council
        run: uv sync --extra ci

      - name: Render site
        working-directory: hapax-council
        env:
          HAPAX_CITABLE_NEXUS_CANONICAL_URL: ${{ vars.HAPAX_CITABLE_NEXUS_CANONICAL_URL }}
        run: |
          uv run python scripts/build_citable_nexus.py \
            --out "${GITHUB_WORKSPACE}/render"

      - name: Sync rendered site to hapax-research repo
        run: |
          # Preserve repository/workflow metadata; sync the build-derived CNAME.
          rsync -av --delete \
            --exclude '.git' \
            --exclude '.github' \
            "${GITHUB_WORKSPACE}/render/" \
            "${GITHUB_WORKSPACE}/hapax-research/"

      - name: Commit rendered output
        working-directory: hapax-research
        run: |
          git config user.name "hapax-research-deploy[bot]"
          git config user.email "hapax-research-deploy@noreply.github.com"
          if [[ -n "$(git status --porcelain)" ]]; then
            git add -A
            council_head="$(cd ../hapax-council && git rev-parse --short HEAD)"
            printf '%s\n' \
              "chore(render): rebuild from hapax-council@${council_head}" \
              "" \
              "Triggered by: ${{ github.event_name }}" \
              "Renderer: hapax-council/agents/citable_nexus/" \
              "Content: committed home and explicitly cleared inputs" \
              > "$RUNNER_TEMP/citable-nexus-commit-message.txt"
            git commit -F "$RUNNER_TEMP/citable-nexus-commit-message.txt"
            git push origin main
          else
            echo "No changes to render; skipping commit."
          fi
