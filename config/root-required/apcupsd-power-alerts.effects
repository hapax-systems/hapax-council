# schema=hapax.root-package-effects.v1
# cap-host=none
# file-parent-semantics=write/ensure scopes include required parent creation and mode convergence
runtime:receipt:advance:apcupsd-power-alerts
runtime:root-directory:ensure-group-write-setgid:/var/log/hapax
runtime:root-file:ensure-owner-mode:/var/log/hapax/ups-power-events.jsonl
runtime:root-file:write:/etc/UPower/UPower.conf.d/90-hapax-apcupsd-owner.conf
runtime:root-file:write:/etc/apcupsd/apcupsd.conf
runtime:root-file:write:/etc/apcupsd/doshutdown
runtime:root-file:write:/etc/apcupsd/hapax-power-event.py
runtime:root-file:write:/etc/apcupsd/offbattery
runtime:root-file:write:/etc/apcupsd/onbattery
runtime:root-file:write:/etc/logrotate.d/hapax-ups-power-events
runtime:state:drain-deferral:apcupsd-power-alerts
runtime:state:lock-root-required
runtime:state:migrate-legacy-root-required
runtime:state:publish-installed-source:apcupsd-power-alerts
runtime:systemd-system:enable-now:apcupsd.service
runtime:systemd-system:restart:apcupsd.service
runtime:systemd-system:try-restart:upower.service
