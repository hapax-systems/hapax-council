# Managed by the Hapax P0 OOM containment package.
# The former root-to-user score bridge is retired. Only fixed read-only audit
# commands remain delegated; the audit compares these two root-owned files.
Cmnd_Alias HAPAX_ROOT_REQUIRED_AUDIT = \
    /usr/bin/cmp -s /usr/local/share/hapax/root-required/hapax-oom-score-enforce.sudoers /etc/sudoers.d/hapax-oom-score-enforce, \
    /usr/bin/visudo -cf /etc/sudoers.d/hapax-oom-score-enforce

hapax ALL=(root) NOPASSWD:NOSETENV: HAPAX_ROOT_REQUIRED_AUDIT
