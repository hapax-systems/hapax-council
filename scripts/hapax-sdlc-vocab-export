#!/usr/bin/env python3
"""hapax-sdlc-vocab-export â€” write ~/.cache/hapax/coord/sdlc-vocab.json.

Owning SSOT is shared/sdlc_lifecycle.py (stage regex + ladder bridge). This
projects the live cc-task corpus into the feed hapax-coord consumes (RC-4:
a stale feed is a startup error, never a silent empty vocabulary). The council
timer runs this every 10 minutes; the staleness budget is 30 minutes.

Cache-only, support-non-authoritative: writes only
~/.cache/hapax/coord/sdlc-vocab.json.
"""

from __future__ import annotations

import json
import re
from datetime import UTC, datetime
from pathlib import Path

VAULT = Path.home() / "Documents" / "Personal" / "20-projects" / "hapax-cc-tasks"
OUT = Path.home() / ".cache" / "hapax" / "coord" / "sdlc-vocab.json"
STAGE_RE = re.compile(r"^S(\d{1,2})(?:_[A-Z][A-Z0-9_]*)?$")


def stage_from_text(text: str) -> str | None:
    m = re.search(r"^stage:\s*[\"']?([A-Za-z0-9_.]+)[\"']?\s*$", text, re.M)
    return m.group(1) if m else None


def ladder_token(raw: str) -> str:
    if raw == "BLOCKED":
        return "BLOCKED"
    m = STAGE_RE.match(raw)
    if not m:
        return "unknown"
    digits = m.group(1)
    rest = raw[1 + len(digits) :]
    if digits == "3" and (rest.startswith(".5") or rest.startswith("_5")):
        return "S3_5"
    return f"S{int(digits)}"


def main() -> int:
    observed: dict[str, dict[str, object]] = {}
    files = sorted([*(VAULT / "active").glob("*.md"), *(VAULT / "closed").glob("*.md")])
    for p in files:
        try:
            text = p.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        st = stage_from_text(text)
        if not st:
            continue
        entry = observed.setdefault(st, {"count": 0, "ladder_token": ladder_token(st)})
        entry["count"] = int(entry["count"]) + 1

    tokens = [f"S{i}" for i in range(0, 12)]
    if "S3_5" not in tokens:
        tokens.insert(5, "S3_5")

    payload = {
        "schema": 1,
        "generated_at": datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%S.%f+00:00"),
        "stage_re": r"^S(\d{1,2})(?:_[A-Z][A-Z0-9_]*)?$",
        "ladder_tokens": tokens,
        "pseudo_stages": ["BLOCKED"],
        "observed_stages": observed,
    }
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps(payload, indent=1, ensure_ascii=False) + "\n", encoding="utf-8")
    print(
        f"hapax-sdlc-vocab-export: wrote {OUT} "
        f"({len(observed)} observed stages, {len(files)} files)"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
