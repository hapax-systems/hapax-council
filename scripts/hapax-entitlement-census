#!/usr/bin/env python3
"""Keep the single entitlement view complete: held x holds-now x declared, on cadence.

Registered as one row in ``config/determination-producers.json``, so ``hapax-determine`` runs and
witnesses it. Each run:

1. reads credential NAMES, login-file existence and mtime, and harness binaries on every declared
   host (remote hosts through a non-interactive ``ssh -o BatchMode=yes`` binding);
2. performs only the allow-listed, spend-free readbacks in ``shared.entitlement_census.READBACKS``;
3. joins them with the platform registry and the quota ledger;
4. emits capability_surface_delta rows through the existing intake
   (``scripts/hapax-capability-surface-delta-intake``) and classifies newly minted ones through the
   onboarding discover bridge;
5. writes quantities in the quota ledger's measurement shape for the ledger's readers;
6. regenerates the projection (JSON view, which is also a Reins capability-surface pack, and a
   Markdown page in the vault).

Nothing is written if any rendered artifact contains secret material.

Exit codes: 0 complete; 3 complete but a declared host was unreachable (its rows are marked
unobserved: healthy bad news); 2 declaration invalid or secret material detected; 1 the intake failed.
"""

from __future__ import annotations

import argparse
import json
import os
import shlex
import subprocess
import sys
from datetime import UTC, datetime
from pathlib import Path
from typing import Any

REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from shared.capability_surface_delta import task_filename_for_delta  # noqa: E402
from shared.entitlement_census import (  # noqa: E402
    DEFAULT_OUTPUT_ROOT,
    ENTITLEMENT_CENSUS_CONFIG,
    CensusConfig,
    CensusConfigError,
    HostHoldings,
    SecretLeakError,
    collect_holdings,
    default_http_get,
    default_resolve_secret,
    load_census_config,
    render_view,
    run_census,
    write_outputs,
)
from shared.platform_capability_registry import PLATFORM_CAPABILITY_REGISTRY  # noqa: E402
from shared.quota_spend_ledger import (  # noqa: E402
    DEFAULT_QUOTA_SPEND_LEDGER_LIVE,
    QUOTA_SPEND_LEDGER_LIVE_ENV,
)

INTAKE = REPO_ROOT / "scripts" / "hapax-capability-surface-delta-intake"
EXIT_HOST_UNREACHABLE = 3
EXIT_REFUSED = 2
EXIT_INTAKE_FAILED = 1


def _now(value: str | None) -> datetime:
    if not value:
        return datetime.now(UTC).replace(microsecond=0)
    parsed = datetime.fromisoformat(value.strip().replace("Z", "+00:00"))
    return (parsed if parsed.tzinfo else parsed.replace(tzinfo=UTC)).astimezone(UTC)


def _read_json(path: Path) -> dict[str, Any] | None:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def _read_home_file(rel: str) -> bytes | None:
    path = Path.home() / rel
    try:
        return path.read_bytes() if path.is_file() else None
    except OSError:
        return None


def _scout_report(config: CensusConfig) -> dict[str, Any] | None:
    binding_ref = config.metal.scout_report
    if binding_ref is None:
        return None
    host = next((h for h in config.hosts if h.host_id == binding_ref.host_id), None)
    if host is None:
        return None
    if host.transport == "local":
        return _read_json(Path.home() / binding_ref.path)
    assert host.target is not None
    try:
        result = subprocess.run(
            [
                "ssh",
                "-o",
                "BatchMode=yes",
                "-o",
                "ConnectTimeout=8",
                "--",
                host.target,
                "cat -- " + shlex.quote(binding_ref.path),
            ],
            capture_output=True,
            text=True,
            timeout=30,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    try:
        data = json.loads(result.stdout) if result.returncode == 0 else None
    except ValueError:
        return None
    return data if isinstance(data, dict) else None


def _gpu_probe(host_id: str) -> tuple[bool, list[str]]:
    from shared.estate_host_inventory import probe_host

    facts = probe_host({"name": host_id, "os": "linux"}, self_name=os.uname().nodename)
    return facts.reachable, list(facts.gpus)


def _intake(deltas_path: Path, run_deltas: list[Any]) -> dict[str, Any]:
    result = subprocess.run(
        [sys.executable, str(INTAKE), "--fixtures", str(deltas_path), "--apply", "--json"],
        capture_output=True,
        text=True,
        timeout=120,
        check=False,
    )
    try:
        payload = json.loads(result.stdout)
    except ValueError:
        return {"ok": False, "error": f"intake exit {result.returncode}; unparseable output"}
    written = {Path(p).name for p in payload.get("written") or []}
    minted = [d for d in run_deltas if task_filename_for_delta(d) in written]
    discovered = 0
    if minted:
        from shared.capability_onboarding_discover import discover_from_deltas

        discovered = len(discover_from_deltas(minted, source_ref="entitlement-census"))
    return {
        "ok": bool(payload.get("ok")),
        "written": sorted(written),
        "skipped_existing": len(payload.get("skipped_existing") or []),
        "ignored_evidence_only": len(payload.get("ignored_evidence_only") or []),
        "discovered": discovered,
        "error": payload.get("error"),
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--config", type=Path, default=ENTITLEMENT_CENSUS_CONFIG)
    parser.add_argument("--output-root", type=Path, default=DEFAULT_OUTPUT_ROOT)
    parser.add_argument(
        "--projection-md",
        type=Path,
        default=None,
        help="Markdown projection path (default: the declaration's projection_markdown under $HOME)",
    )
    parser.add_argument(
        "--no-projection-md", action="store_true", help="Do not write the Markdown projection"
    )
    parser.add_argument("--registry", type=Path, default=PLATFORM_CAPABILITY_REGISTRY)
    parser.add_argument("--ledger", type=Path, default=None)
    parser.add_argument(
        "--no-intake", action="store_true", help="Write deltas but do not run the intake"
    )
    parser.add_argument(
        "--no-remote", action="store_true", help="Skip ssh hosts (their rows read unobserved)"
    )
    parser.add_argument("--dry-run", action="store_true", help="Observe and render; write nothing")
    parser.add_argument("--now", default=None, help="Override the run time (ISO-8601)")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)

    try:
        config = load_census_config(args.config)
    except CensusConfigError as exc:
        print(str(exc), file=sys.stderr)
        return EXIT_REFUSED
    now = _now(args.now)
    login_files = sorted({f for d in config.entitlements for f in d.login_files})
    harness_bins = sorted({b for d in config.entitlements for b in d.harness_bins})
    holdings = []
    for binding in config.hosts:
        if args.no_remote and binding.transport != "local":
            holdings.append(
                HostHoldings(
                    host_id=binding.host_id,
                    reachable=False,
                    observed_at=None,
                    error="skipped (--no-remote)",
                )
            )
            continue
        holdings.append(
            collect_holdings(binding, login_files=login_files, harness_bins=harness_bins, now=now)
        )

    ledger_path = args.ledger or Path(
        os.environ.get(QUOTA_SPEND_LEDGER_LIVE_ENV) or DEFAULT_QUOTA_SPEND_LEDGER_LIVE
    )
    run = run_census(
        config,
        now=now,
        holdings=holdings,
        registry=_read_json(args.registry) or {},
        ledger=_read_json(ledger_path),
        prior_view=_read_json(args.output_root / "view.json"),
        resolve_secret=default_resolve_secret,
        http_get=default_http_get,
        read_home_file=_read_home_file,
        scout_report=None if args.no_remote else _scout_report(config),
        gpu_probe=None if args.no_remote else _gpu_probe,
    )

    projection: Path | None = None
    if not args.no_projection_md:
        projection = args.projection_md or (
            Path.home() / config.projection_markdown if config.projection_markdown else None
        )
    outputs: dict[str, Path] = {}
    intake: dict[str, Any] | None = None
    if not args.dry_run:
        try:
            outputs = write_outputs(
                run, output_root=args.output_root, projection_md=projection, now=now
            )
        except SecretLeakError as exc:
            print(str(exc), file=sys.stderr)
            return EXIT_REFUSED
        if "surface-deltas.json" in outputs and not args.no_intake:
            intake = _intake(outputs["surface-deltas.json"], run.deltas)
    else:
        view_text = json.dumps(render_view(run, now=now))
        try:
            run.secrets.require_clean(view_text, label="dry-run view")
        except SecretLeakError as exc:
            print(str(exc), file=sys.stderr)
            return EXIT_REFUSED

    unreachable = [h.host_id for h in run.holdings if not h.reachable]
    view = render_view(run, now=now)
    summary = {
        "ok": intake is None or intake["ok"],
        "generated_at": view["generated_at"],
        "summary": view["summary"],
        "unreachable_hosts": unreachable,
        "outputs": {name: str(path) for name, path in outputs.items()},
        "intake": intake,
        "dry_run": args.dry_run,
    }
    text = json.dumps(summary, indent=2, sort_keys=True)
    try:
        run.secrets.require_clean(text, label="stdout summary")
    except SecretLeakError as exc:
        print(str(exc), file=sys.stderr)
        return EXIT_REFUSED
    if args.json:
        print(text)
    else:
        print(
            f"entitlement census: {view['summary']['rows']} rows {view['summary']['by_state']}; "
            f"{view['summary']['deltas']} deltas; unreachable {unreachable or 'none'}"
        )
    if intake is not None and not intake["ok"]:
        print(
            f"intake failed: {intake.get('error')}; next action: run the intake by hand on "
            f"{outputs.get('surface-deltas.json')} and read its error",
            file=sys.stderr,
        )
        return EXIT_INTAKE_FAILED
    return EXIT_HOST_UNREACHABLE if unreachable else 0


if __name__ == "__main__":
    raise SystemExit(main())
