#!/usr/bin/env python3
"""Run Claude Code against the Qwen Cloud Coding Plan for one invocation.

The plan key is read from the FileStore at runtime and reaches Claude only in
the environment mapping passed to ``subprocess.run``. It is never written to
disk, interpolated into a shell command, or included in a process argument.
"""

from __future__ import annotations

import os
import shutil
import subprocess
import sys
import tempfile
from collections.abc import Sequence

SECRET_NAME = "qwencloud/apikey"  # pragma: allowlist secret
OFFICIAL_BASE_URL = "https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic"
DEFAULT_MODEL = "qwen3.7-plus"
PLAN_MODELS = frozenset(
    {
        "qwen3.7-plus",
        "qwen3.6-plus",
        "qwen3.5-plus",
        "qwen3-max-2026-01-23",
        "qwen3-coder-next",
        "qwen3-coder-plus",
        "glm-5",
        "glm-4.7",
        "kimi-k2.5",
        "MiniMax-M2.5",
    }
)


def usage() -> None:
    print(
        """usage: hapax-qwencloud-claude [--check] [claude args...]
Runs Claude Code against the Qwen Cloud Coding Plan's Anthropic-compatible endpoint for this
invocation only. The plan key is read from the FileStore (hapax-secret) at runtime.
Defaults:
  secret name: qwencloud/apikey
  base URL:    https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic
  model:       qwen3.7-plus (every Claude Code role model is mapped to it)
Environment overrides:
  HAPAX_QWENCLOUD_MODEL                       one of the plan's documented model ids
  HAPAX_QWENCLOUD_ANTHROPIC_BASE_URL          endpoint override, refused unless reviewed
  HAPAX_QWENCLOUD_ALLOW_NON_PLAN_MODEL=1      allow a model id outside the documented catalogue
  HAPAX_QWENCLOUD_ALLOW_BASE_URL_OVERRIDE=1   allow a reviewed endpoint override
Recheck:
  hapax-qwencloud-claude --check"""
    )


def _error(message: str) -> None:
    print(f"hapax-qwencloud-claude: {message}", file=sys.stderr)


def _secret_output(*args: str) -> str:
    result = subprocess.run(
        ["hapax-secret", *args],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    return result.stdout.strip()


def _validate_overrides(base_url: str, model: str) -> bool:
    if base_url not in {OFFICIAL_BASE_URL, f"{OFFICIAL_BASE_URL}/"}:
        if os.environ.get("HAPAX_QWENCLOUD_ALLOW_BASE_URL_OVERRIDE", "0") != "1":
            _error(f"refusing base URL '{base_url}'; expected {OFFICIAL_BASE_URL}")
            _error(
                "Set HAPAX_QWENCLOUD_ALLOW_BASE_URL_OVERRIDE=1 only after reviewing the "
                "endpoint that will receive the plan key."
            )
            return False

    if model not in PLAN_MODELS:
        if os.environ.get("HAPAX_QWENCLOUD_ALLOW_NON_PLAN_MODEL", "0") != "1":
            _error(f"refusing model '{model}'; not in the plan's documented catalogue")
            _error(
                "Set HAPAX_QWENCLOUD_ALLOW_NON_PLAN_MODEL=1 only after rechecking the "
                "plan's model list."
            )
            return False
    return True


def _check(base_url: str, model: str) -> int:
    check_env = os.environ.copy()
    check_env.pop("ANTHROPIC_BASE_URL", None)
    check_env.pop("ANTHROPIC_AUTH_TOKEN", None)
    version_result = subprocess.run(
        ["claude", "--version"],
        env=check_env,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    if version_result.returncode != 0:
        _error(
            f"claude --version failed (exit {version_result.returncode}); "
            "install Claude Code or repair the claude executable on PATH, then retry"
        )
        return (
            version_result.returncode
            if version_result.returncode >= 0
            else 128 - version_result.returncode
        )
    version = version_result.stdout.splitlines()[0] if version_result.stdout else "claude"
    print(
        f"hapax-qwencloud-claude: ok — client {version}, endpoint {base_url}, "
        f"model {model}, secret {SECRET_NAME} present"
    )
    return 0


def _client_environment(iso_home: str, base_url: str, model: str, key: str) -> dict[str, str]:
    return {
        "HOME": iso_home,
        "PATH": os.environ.get("PATH", os.defpath),
        "TERM": os.environ.get("TERM") or "dumb",
        "LANG": os.environ.get("LANG") or "C.UTF-8",
        "ANTHROPIC_BASE_URL": base_url,
        "ANTHROPIC_AUTH_TOKEN": key,
        "ANTHROPIC_MODEL": model,
        "ANTHROPIC_SMALL_FAST_MODEL": model,
        "ANTHROPIC_DEFAULT_OPUS_MODEL": model,
        "ANTHROPIC_DEFAULT_SONNET_MODEL": model,
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": model,
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
        "DISABLE_TELEMETRY": "1",
        "DISABLE_AUTOUPDATER": "1",
    }


def main(argv: Sequence[str] | None = None) -> int:
    claude_args = list(sys.argv[1:] if argv is None else argv)
    if claude_args and claude_args[0] in {"--help", "-h"}:
        usage()
        return 0

    check_only = bool(claude_args and claude_args[0] == "--check")
    if check_only:
        claude_args.pop(0)

    base_url = os.environ.get("HAPAX_QWENCLOUD_ANTHROPIC_BASE_URL") or OFFICIAL_BASE_URL
    model = os.environ.get("HAPAX_QWENCLOUD_MODEL") or DEFAULT_MODEL
    if not _validate_overrides(base_url, model):
        return 2

    if shutil.which("claude") is None:
        _error("claude is not on PATH; install Claude Code, then retry")
        return 3
    if shutil.which("hapax-secret") is None:
        _error("hapax-secret is not on PATH; the plan key lives in the FileStore")
        return 3
    if not _secret_output("--where", SECRET_NAME):
        _error(
            f"secret '{SECRET_NAME}' is absent; store the plan's sk-sp- key with "
            "hapax-secret (TTY put), then retry"
        )
        return 4

    if check_only:
        return _check(base_url, model)

    key = _secret_output(SECRET_NAME)  # pragma: allowlist secret
    if not key:
        _error(f"secret '{SECRET_NAME}' read back empty; re-store it with hapax-secret")
        return 4

    iso_home = tempfile.mkdtemp(
        prefix="hapax-qwencloud-claude.", dir=os.environ.get("TMPDIR", "/tmp")
    )
    try:
        client_env = _client_environment(iso_home, base_url, model, key)
        result = subprocess.run(
            ["claude", *claude_args],
            env=client_env,
            check=False,
        )
        return result.returncode if result.returncode >= 0 else 128 - result.returncode
    finally:
        shutil.rmtree(iso_home)


if __name__ == "__main__":
    raise SystemExit(main())
