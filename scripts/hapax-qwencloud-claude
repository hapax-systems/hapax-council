#!/usr/bin/env bash
# hapax-qwencloud-claude - run Claude Code, a client the Qwen Cloud Coding Plan lists, against the
# plan's Anthropic-compatible endpoint, for one invocation.
#
# The plan's terms allow its keys only inside listed interactive clients (Claude Code is one) and
# forbid curl, Postman and server-side scripts. This wrapper therefore never calls the endpoint
# itself: it configures Claude Code for one run — isolated HOME, clean environment, the key read
# from the FileStore at exec time and handed over only as an environment variable — and mediates.
# It does not edit ~/.claude/settings.json and never writes the key to disk or to argv.
#
# Measured 2026-09-03 23:0xZ: the endpoint below answered `qwen3.7-plus` → "OK" in 3.7 s API time.
# The `coding-intl.dashscope.aliyuncs.com` hosts probed on 2026-09-02 are NOT this plan's hosts;
# their 401s were about the host, not the key (packet QWENCLOUD-ONBOARDING-20260902 §6).
set -euo pipefail

usage() {
  cat <<'EOF'
usage: hapax-qwencloud-claude [--check] [claude args...]
Runs Claude Code against the Qwen Cloud Coding Plan's Anthropic-compatible endpoint for this
invocation only. The plan key is read from the FileStore (hapax-secret) at runtime.
Defaults:
  secret name: qwencloud/apikey
  base URL:    https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic
  model:       qwen3.7-plus (every Claude Code role model is mapped to it)
Environment overrides:
  HAPAX_QWENCLOUD_MODEL                       one of the plan's documented model ids
  HAPAX_QWENCLOUD_ANTHROPIC_BASE_URL          endpoint override, refused unless reviewed
  HAPAX_QWENCLOUD_ALLOW_NON_PLAN_MODEL=1      allow a model id outside the documented catalogue
  HAPAX_QWENCLOUD_ALLOW_BASE_URL_OVERRIDE=1   allow a reviewed endpoint override
Recheck:
  hapax-qwencloud-claude --check
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi
check_only=false
if [[ "${1:-}" == "--check" ]]; then
  check_only=true
  shift
fi

secret_name="qwencloud/apikey"
official_base_url="https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic"
base_url="${HAPAX_QWENCLOUD_ANTHROPIC_BASE_URL:-$official_base_url}"
model="${HAPAX_QWENCLOUD_MODEL:-qwen3.7-plus}"

case "$base_url" in
  "$official_base_url"|"$official_base_url/") ;;
  *)
    if [[ "${HAPAX_QWENCLOUD_ALLOW_BASE_URL_OVERRIDE:-0}" != "1" ]]; then
      echo "hapax-qwencloud-claude: refusing base URL '$base_url'; expected $official_base_url" >&2
      echo "Set HAPAX_QWENCLOUD_ALLOW_BASE_URL_OVERRIDE=1 only after reviewing the endpoint that will receive the plan key." >&2
      exit 2
    fi
    ;;
esac

# The plan's catalogue as the stored key listed it on 2026-09-02 (packet §2); a model outside it is
# refused so a typo never spends the plan's shared pool on a fallback nobody chose.
case "$model" in
  qwen3.7-plus|qwen3.6-plus|qwen3.5-plus|qwen3-max-2026-01-23|qwen3-coder-next|qwen3-coder-plus|glm-5|glm-4.7|kimi-k2.5|MiniMax-M2.5) ;;
  *)
    if [[ "${HAPAX_QWENCLOUD_ALLOW_NON_PLAN_MODEL:-0}" != "1" ]]; then
      echo "hapax-qwencloud-claude: refusing model '$model'; not in the plan's documented catalogue" >&2
      echo "Set HAPAX_QWENCLOUD_ALLOW_NON_PLAN_MODEL=1 only after rechecking the plan's model list." >&2
      exit 2
    fi
    ;;
esac

if ! command -v claude >/dev/null 2>&1; then
  echo "hapax-qwencloud-claude: claude is not on PATH; install Claude Code, then retry" >&2
  exit 3
fi
if ! command -v hapax-secret >/dev/null 2>&1; then
  echo "hapax-qwencloud-claude: hapax-secret is not on PATH; the plan key lives in the FileStore" >&2
  exit 3
fi
if [[ -z "$(hapax-secret --where "$secret_name" 2>/dev/null || true)" ]]; then
  echo "hapax-qwencloud-claude: secret '$secret_name' is absent; store the plan's sk-sp- key with hapax-secret (TTY put), then retry" >&2
  exit 4
fi

if $check_only; then
  version="$(env -u ANTHROPIC_BASE_URL -u ANTHROPIC_AUTH_TOKEN claude --version 2>/dev/null | head -1 || true)"
  echo "hapax-qwencloud-claude: ok — client ${version:-claude}, endpoint $base_url, model $model, secret $secret_name present"
  exit 0
fi

key="$(hapax-secret "$secret_name" 2>/dev/null || true)"
if [[ -z "$key" ]]; then
  echo "hapax-qwencloud-claude: secret '$secret_name' read back empty; re-store it with hapax-secret" >&2
  exit 4
fi

iso_home="$(mktemp -d "${TMPDIR:-/tmp}/hapax-qwencloud-claude.XXXXXX")"
cleanup() { rm -rf "$iso_home"; }
trap cleanup EXIT HUP INT TERM

set +e
env -i \
  HOME="$iso_home" PATH="$PATH" TERM="${TERM:-dumb}" LANG="${LANG:-C.UTF-8}" \
  ANTHROPIC_BASE_URL="$base_url" ANTHROPIC_AUTH_TOKEN="$key" \
  ANTHROPIC_MODEL="$model" ANTHROPIC_SMALL_FAST_MODEL="$model" \
  ANTHROPIC_DEFAULT_OPUS_MODEL="$model" ANTHROPIC_DEFAULT_SONNET_MODEL="$model" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="$model" \
  CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 DISABLE_TELEMETRY=1 DISABLE_AUTOUPDATER=1 \
  claude "$@"
rc=$?
set -e
exit "$rc"
