#!/usr/bin/bash -p
# Validate the source-only OOM policy package. Production application is broker-only.

if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    printf '%s\n' "OOM policy validator must be executed, not sourced" >&2
    return 2 2>/dev/null || exit 2
fi

# This scan intentionally uses Bash builtins only. Production modes must refuse
# before source resolution, NSS, locks, command lookup, or filesystem access.
_production_requested=0
for _argument in "$@"; do
    case "$_argument" in
        --install|--verify-live|--authenticated-sealed-source)
            _production_requested=1
            ;;
    esac
done
if [ "$_production_requested" -eq 1 ]; then
    printf '%s\n' "production OOM installation and authoritative live verification are unavailable in this source revision; no source, account, lock, tool, or live-state lookup was attempted; next action: preserve the desired exact-SHA package and dispatch separately runtime-authorized root-broker work against docs/security/root-authority-hazard-register.md" >&2
    exit 77
fi
unset _argument _production_requested

if [[ "$-" != *p* ]]; then
    printf '%s\n' "OOM policy source validation requires direct privileged-mode Bash execution; next action: execute scripts/install-p0-oom-containment directly" >&2
    exit 2
fi

set -euo pipefail

ROOT="$(cd "$(/usr/bin/dirname "${BASH_SOURCE[0]}")/.." && /usr/bin/pwd -P)"
SOURCE="$ROOT"
CHECK=0
NO_RUNTIME=0

usage() {
    cat <<'USAGE'
usage: scripts/install-p0-oom-containment [--source DIR] [--check] [--no-runtime]

Validates the versioned, per-host OOM policy source package. This command does
not inspect or mutate live state and its successful exit is not runtime or task
closure evidence.

Production --install, --verify-live, and --authenticated-sealed-source modes
are unavailable until a separately reviewed root broker provides signed,
current-generation request and completion attestations.
USAGE
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --source)
            if [ "$#" -lt 2 ] || [ -z "$2" ]; then
                printf '%s\n' "source directory is required after --source" >&2
                exit 2
            fi
            SOURCE="$2"
            shift 2
            ;;
        --check)
            CHECK=1
            shift
            ;;
        --no-runtime)
            NO_RUNTIME=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            printf 'unknown argument: %s\n' "$1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if [ "$CHECK" -eq 0 ]; then
    CHECK=1
fi

# Retired selectors must not silently reopen the discarded mutation harness.
for _selector in \
    HAPAX_ROOT_REQUIRED_INSTALLER_TEST_MODE \
    HAPAX_OOM_INSTALL_SUDO \
    HAPAX_RUNTIME_AUTHORITY_TASK \
    HAPAX_ROOT_REQUIRED_SEALED_SOURCE_FDS \
    HAPAX_ROOT_REQUIRED_FINALIZE_GATE; do
    if [ -n "${!_selector:-}" ]; then
        printf '%s\n' "$_selector is retired for this source-only validator; next action: remove the selector" >&2
        exit 2
    fi
done
unset _selector

if [ "$NO_RUNTIME" -ne 0 ] && [ "$NO_RUNTIME" -ne 1 ]; then
    printf '%s\n' "internal no-runtime mode error" >&2
    exit 2
fi

/usr/bin/python3 -I -S - "$SOURCE" <<'PY'
from __future__ import annotations

import configparser
import re
import stat
import sys
from dataclasses import dataclass
from pathlib import Path, PurePosixPath


EXPECTED_HOSTS = {
    "hapax-appendix": "appendix",
    "hapax-podium": "podium",
}
POLICY_FILES = (
    "app.slice.conf",
    "user-1000.slice.conf",
    "user@1000.service.conf",
    "zram-generator.conf",
)
MEMORY_RE = re.compile(r"([1-9][0-9]*)G")
PROFILE_RE = re.compile(r"[a-z0-9][a-z0-9-]*")


class ValidationError(RuntimeError):
    pass


@dataclass(frozen=True)
class Profile:
    hostname: str
    min_memtotal_gib: int
    max_memtotal_gib: int
    name: str
    app_high: str
    app_max: str
    uid_high: str
    uid_max: str
    zram_mib: int


def regular_file(path: Path) -> None:
    try:
        metadata = path.lstat()
    except OSError as exc:
        raise ValidationError(f"missing required source file {path}: {exc}") from exc
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(metadata.st_mode):
        raise ValidationError(f"required source file must be a non-symlink regular file: {path}")


def memory_gib(value: str, field: str) -> int:
    match = MEMORY_RE.fullmatch(value)
    if match is None:
        raise ValidationError(f"invalid {field} value {value!r}; expected positive whole GiB")
    return int(match.group(1))


def read_profiles(path: Path) -> dict[str, Profile]:
    regular_file(path)
    profiles: dict[str, Profile] = {}
    names: set[str] = set()
    for line_number, raw_line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        if not raw_line or raw_line.startswith("#"):
            continue
        fields = raw_line.split("\t")
        if len(fields) != 9:
            raise ValidationError(f"{path}:{line_number}: expected exactly 9 tab-separated fields")
        hostname, minimum, maximum, name, app_high, app_max, uid_high, uid_max, zram = fields
        if hostname in profiles:
            raise ValidationError(f"{path}:{line_number}: duplicate hostname {hostname}")
        if not PROFILE_RE.fullmatch(name):
            raise ValidationError(f"{path}:{line_number}: unsafe profile name {name!r}")
        if name in names:
            raise ValidationError(f"{path}:{line_number}: duplicate profile name {name}")
        try:
            min_gib = int(minimum)
            max_gib = int(maximum)
            zram_mib = int(zram)
        except ValueError as exc:
            raise ValidationError(f"{path}:{line_number}: memory bounds and zram must be integers") from exc
        if min_gib <= 0 or max_gib < min_gib:
            raise ValidationError(f"{path}:{line_number}: invalid inclusive MemTotal interval")
        app_high_gib = memory_gib(app_high, "app_high")
        app_max_gib = memory_gib(app_max, "app_max")
        uid_high_gib = memory_gib(uid_high, "uid_high")
        uid_max_gib = memory_gib(uid_max, "uid_max")
        if not (app_high_gib < app_max_gib < min_gib):
            raise ValidationError(f"{path}:{line_number}: app ceilings must be ordered below interval floor")
        if not (uid_high_gib < uid_max_gib < min_gib):
            raise ValidationError(f"{path}:{line_number}: UID ceilings must be ordered below interval floor")
        if zram_mib < 8192 or zram_mib * 2 > min_gib * 1024:
            raise ValidationError(f"{path}:{line_number}: zram must be 8192 MiB or larger and no more than half the interval floor")
        profiles[hostname] = Profile(
            hostname,
            min_gib,
            max_gib,
            name,
            app_high,
            app_max,
            uid_high,
            uid_max,
            zram_mib,
        )
        names.add(name)

    actual_hosts = {hostname: profile.name for hostname, profile in profiles.items()}
    if actual_hosts != EXPECTED_HOSTS:
        raise ValidationError(
            f"host profile set must be exactly {EXPECTED_HOSTS}, got {actual_hosts}"
        )
    return profiles


def read_ini(path: Path) -> configparser.ConfigParser:
    regular_file(path)
    parser = configparser.ConfigParser(interpolation=None, strict=True)
    parser.optionxform = str
    try:
        parser.read_string(path.read_text(encoding="utf-8"), source=str(path))
    except (OSError, configparser.Error) as exc:
        raise ValidationError(f"cannot parse {path}: {exc}") from exc
    return parser


def require_exact_values(
    parser: configparser.ConfigParser,
    path: Path,
    expected: dict[str, dict[str, str]],
) -> None:
    if parser.defaults():
        raise ValidationError(f"{path}: DEFAULT options are forbidden")
    actual_sections = set(parser.sections())
    if actual_sections != set(expected):
        raise ValidationError(
            f"{path}: expected exactly sections {sorted(expected)}, got {sorted(actual_sections)}"
        )
    for section, expected_options in expected.items():
        actual_options = set(parser.options(section))
        if actual_options != set(expected_options):
            raise ValidationError(
                f"{path}: expected exactly {section} options {sorted(expected_options)}, "
                f"got {sorted(actual_options)}"
            )
        for key, value in expected_options.items():
            actual = parser.get(section, key, raw=True)
            if actual != value:
                raise ValidationError(
                    f"{path}: expected {section}.{key}={value}, got {actual!r}"
                )


def validate_policy_tree(source: Path, profiles: dict[str, Profile]) -> None:
    policy_root = source / "config" / "root-required" / "oom-host-policy"
    expected_relative = {
        Path(profile.name) / filename
        for profile in profiles.values()
        for filename in POLICY_FILES
    }
    if not policy_root.is_dir() or policy_root.is_symlink():
        raise ValidationError(f"policy root must be a non-symlink directory: {policy_root}")
    actual_relative = {
        path.relative_to(policy_root)
        for path in policy_root.rglob("*")
        if path.is_file() or path.is_symlink()
    }
    if actual_relative != expected_relative:
        raise ValidationError(
            f"policy tree must contain exactly {sorted(map(str, expected_relative))}, "
            f"got {sorted(map(str, actual_relative))}"
        )

    for profile in profiles.values():
        profile_root = policy_root / profile.name
        app_path = profile_root / "app.slice.conf"
        app = read_ini(app_path)
        require_exact_values(
            app,
            app_path,
            {
                "Slice": {
                    "MemoryHigh": profile.app_high,
                    "MemoryMax": profile.app_max,
                    "MemorySwapMax": "8G",
                    "MemoryLow": "16G",
                    "MemoryMin": "8G",
                }
            },
        )

        user_slice_path = profile_root / "user-1000.slice.conf"
        user_slice = read_ini(user_slice_path)
        require_exact_values(
            user_slice,
            user_slice_path,
            {
                "Slice": {
                    "MemoryHigh": profile.uid_high,
                    "MemoryMax": profile.uid_max,
                    "MemorySwapMax": "8G",
                    "MemoryLow": "20G",
                    "MemoryMin": "10G",
                }
            },
        )

        user_service_path = profile_root / "user@1000.service.conf"
        user_service = read_ini(user_service_path)
        require_exact_values(
            user_service,
            user_service_path,
            {
                "Service": {
                    "OOMScoreAdjust": "100",
                    "OOMPolicy": "continue",
                    "MemoryHigh": profile.uid_high,
                    "MemoryMax": profile.uid_max,
                    "MemorySwapMax": "8G",
                    "MemoryLow": "20G",
                    "MemoryMin": "10G",
                }
            },
        )

        zram_path = profile_root / "zram-generator.conf"
        zram = read_ini(zram_path)
        require_exact_values(
            zram,
            zram_path,
            {
                "zram0": {
                    "zram-size": str(profile.zram_mib),
                    "compression-algorithm": "zstd",
                }
            },
        )


def validate_manifest(source: Path, profiles: dict[str, Profile]) -> None:
    manifest = source / "config" / "root-required" / "oom-containment.files"
    regular_file(manifest)
    entries = [
        line
        for line in manifest.read_text(encoding="utf-8").splitlines()
        if line and not line.startswith("#")
    ]
    if len(entries) != len(set(entries)):
        raise ValidationError(f"duplicate entry in {manifest}")
    for entry in entries:
        relative = PurePosixPath(entry)
        if (
            not relative.parts
            or relative.is_absolute()
            or relative.as_posix() != entry
            or any(part in {"", ".", ".."} for part in relative.parts)
            or "\\" in entry
            or any(character.isspace() for character in entry)
        ):
            raise ValidationError(f"unsafe or non-normalized manifest entry: {entry!r}")
    expected = {"config/root-required/oom-host-profiles.tsv"}
    expected.update(
        f"config/root-required/oom-host-policy/{profile.name}/{filename}"
        for profile in profiles.values()
        for filename in POLICY_FILES
    )
    missing = sorted(expected.difference(entries))
    if missing:
        raise ValidationError(f"{manifest} omits host policy files: {missing}")
    for entry in entries:
        regular_file(source / entry)


def main() -> int:
    try:
        source = Path(sys.argv[1]).resolve(strict=True)
        if not source.is_dir():
            raise ValidationError(f"source root is not a directory: {source}")
        table = source / "config" / "root-required" / "oom-host-profiles.tsv"
        profiles = read_profiles(table)
        validate_policy_tree(source, profiles)
        validate_manifest(source, profiles)
    except (OSError, ValidationError) as exc:
        print(f"OOM policy source validation failed: {exc}", file=sys.stderr)
        return 1

    summary = ", ".join(
        f"{profile.hostname}={profile.name}[{profile.min_memtotal_gib}..{profile.max_memtotal_gib}GiB]"
        for profile in profiles.values()
    )
    print(f"OOM policy source validation complete (non-authoritative, no live state): {summary}")
    return 0


raise SystemExit(main())
PY
