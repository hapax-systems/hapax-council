# HOST-OPTIONAL protected units: present on some hosts, legitimately absent on others, so
# LoadState=not-found is an EXPECTED state for these and only these. Everything else in
# protected_user_unit_scores is REQUIRED wherever this package installs, and its absence is a
# verification FAILURE rather than a skip.
#
# Measured 2026-08-04 on both hosts:
#   pipewire / pipewire-pulse / wireplumber   loaded on podium AND appendix  -> required
#   hapax-daimonion / studio-compositor /
#   hapax-imagination                          loaded on podium, not-found on appendix -> optional
#
# RE-DERIVE the split rather than trusting this comment (it is a measurement, and measurements go
# stale — a unit installed on appendix tomorrow stops being host-optional and must leave this list):
#
#   for u in pipewire.service pipewire-pulse.service wireplumber.service \
#            hapax-daimonion.service studio-compositor.service hapax-imagination.service; do
#     printf '%-32s local=%s ' "$u" "$(systemctl --user show "$u" -p LoadState --value)"
#     ssh hapax-podium 'bash -s' <<< "systemctl --user show $u -p LoadState --value"
#   done
#
# A unit belongs here only if it is loaded on at least one host AND not-found on another. A unit
# absent EVERYWHERE is not host-optional, it is missing, and belongs in neither list until that is
# explained.
#
# The distinction is load-bearing. An earlier version of this fix skipped ANY unit reporting
# not-found, which meant a required unit disappearing from a host it belongs on would silently
# satisfy --verify-live: the verifier would report success having verified nothing. That is the
# fail-quiet class this package exists to eliminate, so the skip is now allow-listed rather than
# universal.
host_optional_user_units=(
    hapax-daimonion.service
    studio-compositor.service
    hapax-imagination.service
)

HOST_POLICY_LOADED=0
HOST_POLICY_AUTHORITY=""
HOST_HOSTNAME=""
HOST_PROFILE=""
HOST_PHYSICAL_BYTES=""
HOST_APP_MEMORY_HIGH=""
HOST_APP_MEMORY_MAX=""
HOST_UID_MEMORY_HIGH=""
HOST_UID_MEMORY_MAX=""
HOST_ZRAM_SIZE_MIB=""

is_host_optional_user_unit() {
    local candidate="$1" optional
    [ "$HOST_PROFILE" = "appendix" ] || return 1
    for optional in "${host_optional_user_units[@]}"; do
        [ "$candidate" = "$optional" ] && return 0
    done
    return 1
}

# Run systemd-analyze AS THE TARGET USER, exactly as user_systemctl does.
#
# The installer escalates for root-only steps, so this can execute with EFFECTIVE_UID=0. A bare
# `systemd-analyze --user unit-paths` under root enumerates ROOT's user manager, whose search path
# does not include /home/<target>/.config/systemd/user -- so every target-user unit would look
# absent, every allow-listed unit would become skippable, and --verify-live would pass having
# verified nothing. That is this package's own defect class (wrong-scope enumeration read as
# absence) reappearing inside the fix for it. Found by blind review (codex-1) on PR #4499.
user_systemd_analyze() {
    if [ "$EFFECTIVE_UID" = "$TARGET_UID" ]; then
        "$SYSTEMD_ANALYZE" --user "$@"
    elif [ "$EFFECTIVE_UID" = "0" ]; then
        "$RUNUSER" -u "$TARGET_USER" -- env XDG_RUNTIME_DIR="/run/user/$TARGET_UID" \
            "$SYSTEMD_ANALYZE" --user "$@"
    else
        return 1
    fi
}

governed_system_unit_search_paths() {
    local discovered override="${HAPAX_OOM_GOVERNED_SYSTEM_UNIT_PATHS:-}"
    if [ -n "$override" ]; then
        if [ "${HAPAX_OOM_ENFORCE_TEST_MODE:-0}" != "1" ]; then
            echo "governed system unit-path override is test-only; next action: remove HAPAX_OOM_GOVERNED_SYSTEM_UNIT_PATHS and rerun against systemd's authoritative search path" >&2
            return 1
        fi
        discovered="${override//:/$'\n'}"
    elif ! discovered="$("$SYSTEMD_ANALYZE" unit-paths 2>/dev/null)"; then
        echo "unable to obtain the authoritative system unit search path; next action: restore '$SYSTEMD_ANALYZE unit-paths' and rerun the OOM installer" >&2
        return 1
    fi
    printf '%s\n' "$discovered" \
        "$SYSTEMD_SYSTEM_CONTROL_DIR" \
        "$SYSTEMD_SYSTEM_RUNTIME_CONTROL_DIR" \
        "$SYSTEMD_SYSTEM_TRANSIENT_DIR" \
        "$SYSTEMD_SYSTEM_DIR" \
        | awk 'NF && !seen[$0]++'
}

governed_user_unit_search_paths() {
    local discovered override="${HAPAX_OOM_GOVERNED_USER_UNIT_PATHS:-}"
    if [ -n "$override" ]; then
        if [ "${HAPAX_OOM_ENFORCE_TEST_MODE:-0}" != "1" ]; then
            echo "governed user unit-path override is test-only; next action: remove HAPAX_OOM_GOVERNED_USER_UNIT_PATHS and rerun against systemd's authoritative search path" >&2
            return 1
        fi
        discovered="${override//:/$'\n'}"
    elif ! discovered="$(user_systemd_analyze unit-paths 2>/dev/null)"; then
        echo "unable to obtain the authoritative target-user unit search path; next action: restore '$SYSTEMD_ANALYZE --user unit-paths' for UID $TARGET_UID and rerun the OOM installer" >&2
        return 1
    fi
    printf '%s\n' "$discovered" \
        "$SYSTEMD_USER_CONTROL_DIR" \
        "$SYSTEMD_USER_RUNTIME_CONTROL_DIR" \
        "$SYSTEMD_USER_TRANSIENT_DIR" \
        "$SYSTEMD_USER_DIR" \
        | awk 'NF && !seen[$0]++'
}

# Where the user manager looks for unit files. Asked of systemd rather than hardcoded: the real
# path includes generator, transient and .control directories that a static list silently omits,
# and omitting one turns "installed here" into "absent here" -- the exact misread this whole
# section exists to prevent. The static fallback is for environments with no queryable user
# manager; it is a floor, not the answer.
user_unit_search_paths() {
    if [ -n "${HAPAX_OOM_USER_UNIT_PATHS:-}" ]; then
        if [ "${HAPAX_OOM_ENFORCE_TEST_MODE:-0}" != "1" ]; then
            echo "HAPAX_OOM_USER_UNIT_PATHS is test-only and cannot prove production unit absence" >&2
            return 2
        fi
        printf '%s\n' "${HAPAX_OOM_USER_UNIT_PATHS//:/$'\n'}"
        return 0
    fi
    if user_systemd_analyze unit-paths 2>/dev/null; then
        return 0
    fi
    # DEGRADED. Mirrors systemd's documented user unit load path, INCLUDING the .control,
    # transient, generator and user.attached directories an abbreviated list omits -- review
    # (codex-1, PR #4499) showed that a unit represented only in one of those would be classified
    # as having no unit file and skipped. Enumerated from `systemd-analyze --user unit-paths`
    # observed on hapax-appendix 2026-08-04.
    local runtime="${XDG_RUNTIME_DIR:-/run/user/$TARGET_UID}"
    printf '%s\n' \
        "$TARGET_HOME/.config/systemd/user.control" \
        "$runtime/systemd/user.control" \
        "$runtime/systemd/transient" \
        "$runtime/systemd/generator.early" \
        "$TARGET_HOME/.config/systemd/user" \
        "$TARGET_HOME/.config/systemd/user.attached" \
        /etc/systemd/user \
        "$runtime/systemd/user" \
        "$runtime/systemd/user.attached" \
        /run/systemd/user \
        "$runtime/systemd/generator" \
        "$runtime/systemd/generator.late" \
        "$TARGET_HOME/.local/share/systemd/user" \
        /usr/lib/systemd/user
    return 2
}

# Is the unit search path AUTHORITATIVE on this run, or a reconstruction?
#
# This distinction is the whole reason the skip is safe. Absence can only be asserted from an
# authoritative enumeration: if the manager could not be queried, a reconstructed list may omit a
# directory this system actually uses, and "no unit file found" then means "I did not look
# everywhere" rather than "it is not installed". Skipping on that is a false host-absence -- the
# same absent-vs-unevaluable conflation this whole section exists to remove, one level up.
# So a degraded enumeration may still PROVE presence (finding a file is positive evidence), but it
# may never be used to prove ABSENCE.
user_unit_search_paths_are_authoritative() {
    if [ -n "${HAPAX_OOM_USER_UNIT_PATHS:-}" ]; then
        [ "${HAPAX_OOM_ENFORCE_TEST_MODE:-0}" = "1" ]
        return
    fi
    user_systemd_analyze unit-paths >/dev/null 2>&1
}

# Does a unit FILE for this unit exist on this host, regardless of whether it loaded?
#
# This is the discriminator the allow-list alone cannot provide. `host_optional_user_units` says a
# unit MAY be absent somewhere; it cannot say whether THIS host is such a place, so on its own it
# would skip an allow-listed unit that vanished from a host it belongs on -- review's exact charge.
# LoadState cannot settle it either (not-found is not-found), and neither can FragmentPath, which is
# empty for every not-found unit and therefore just restates LoadState.
#
# The file on disk does settle it, and does so WITHOUT asking which host we are:
#   no unit file  -> the package was never installed here      -> absence is expected
#   unit file     -> installed here and the manager cannot load it (masked, dangling symlink,
#                    syntax error) -> absence is ALARMING and must fail closed
user_unit_file_present() {
    local unit="$1" dir
    while IFS= read -r dir; do
        [ -n "$dir" ] || continue
        # -e FOLLOWS symlinks and is false for a DANGLING one, so `-e` alone would report a broken
        # `systemctl --user enable` link as "never installed here" and take the skip -- the exact
        # installed-here-but-unloadable case this function exists to catch, inverted. A dangling
        # link is the strongest possible evidence the unit WAS installed on this host. `-L` matches
        # the link regardless of its target. Found by blind review (codex-1) on PR #4499.
        if [ -e "$dir/$unit" ] || [ -L "$dir/$unit" ]; then
            return 0
        fi
    done < <(user_unit_search_paths)
    return 1
}

src_path() {
    local rel="$1" sealed
    if [ "$AUTHENTICATED_SEALED_SOURCE" -eq 1 ]; then
        sealed="${ROOT_REQUIRED_SEALED_SOURCES[$rel]-}"
        if [ -z "$sealed" ]; then
            echo "authenticated OOM source map omits $rel; next action: leave the deferral pending and regenerate its live command with hapax-post-merge-deploy" >&2
            return 1
        fi
        printf '%s\n' "$sealed"
        return 0
    fi
    printf '%s/%s\n' "$SOURCE" "$rel"
}

production_destinations_selected() {
    local path
    for path in \
        "$SYSTEMD_SYSTEM_DIR" "$SYSTEMD_USER_DIR" "$EARLYOOM_DEST" \
        "$OOM_ENFORCER_DEST" "$OOM_TRIGGER_DEST" "$OOM_SUDOERS_DEST" \
        "$OOM_SUDOERS_REFERENCE_DEST" "$ROOT_FAILURE_INTAKE_DEST" \
        "$OOM_POLICY_AUDIT_DEST" "$ROOT_REQUIRED_AUDIT_DEST" \
        "$OOM_PROFILE_TABLE_DEST" "$ZRAM_POLICY_DEST" \
        "$ROOT_REQUIRED_STATE_ROOT" "$ROOT_REQUIRED_INSTALLED_SOURCE_ROOT" \
        "$ROOT_REQUIRED_DEFER_ROOT" "$ROOT_REQUIRED_INSTALLED_RECEIPT_ROOT" \
        "$ROOT_REQUIRED_DESIRED_RECEIPT_ROOT" "$ROOT_REQUIRED_LOCK_FILE" "$TARGET_HOME"; do
        case "$path" in
            /etc/*|/usr/local/*|/home/hapax/*) return 0 ;;
        esac
    done
    return 1
}

path_is_within_test_root() {
    local path="$1" root="$2" canonical
    canonical="$(/usr/bin/realpath -m -- "$path")" || return 1
    case "$canonical" in
        "$root"|"$root"/*) return 0 ;;
        *) return 1 ;;
    esac
}

validate_isolated_test_executable() {
    local label="$1" command="$2" root="$3" canonical
    case "$command" in
        /*) ;;
        *)
            echo "isolated OOM test install requires an absolute fake $label command under $root; got $command" >&2
            return 1
            ;;
    esac
    canonical="$(/usr/bin/realpath -e -- "$command" 2>/dev/null)" || {
        echo "isolated OOM test install cannot resolve fake $label command $command under $root" >&2
        return 1
    }
    if [ ! -f "$canonical" ] || [ -L "$command" ] || [ ! -x "$canonical" ] \
        || ! path_is_within_test_root "$canonical" "$root"; then
        echo "isolated OOM test install requires a non-symlink executable fake $label command under $root; got $command" >&2
        return 1
    fi
}

validate_authenticated_state_contract() {
    local lexical_root="$1" state_fd="${HAPAX_ROOT_REQUIRED_STATE_FD:-}"
    local lock_fd="${HAPAX_ROOT_REQUIRED_LOCK_FD:-}"
    local guard_fd="${HAPAX_ROOT_REQUIRED_GENERATION_GUARD_FD:-}"
    local expected_lock="$lexical_root/.lock"
    if ! [[ "$state_fd" =~ ^[0-9]+$ ]] || [ "$state_fd" -lt 3 ] \
        || ! [[ "$lock_fd" =~ ^[0-9]+$ ]] || [ "$lock_fd" -lt 3 ] \
        || ! [[ "$guard_fd" =~ ^[0-9]+$ ]] || [ "$guard_fd" -lt 3 ] \
        || ! [[ "$ROOT_REQUIRED_STATE_ROOT" =~ ^/proc/[1-9][0-9]*/fd/${state_fd}$ ]] \
        || [ "$ROOT_REQUIRED_INSTALLED_SOURCE_ROOT" != "$ROOT_REQUIRED_STATE_ROOT/current-source" ] \
        || [ "$ROOT_REQUIRED_INSTALLED_RECEIPT_ROOT" != "$ROOT_REQUIRED_STATE_ROOT/installed-receipts" ] \
        || [ "$ROOT_REQUIRED_DESIRED_RECEIPT_ROOT" != "$ROOT_REQUIRED_STATE_ROOT/desired-receipts" ] \
        || [ "$ROOT_REQUIRED_RECEIPT" != "$ROOT_REQUIRED_STATE_ROOT/installed-receipts/oom-containment.sha" ] \
        || [ "$ROOT_REQUIRED_DESIRED_RECEIPT" != "$ROOT_REQUIRED_STATE_ROOT/desired-receipts/oom-containment.sha" ] \
        || [ "${HAPAX_ROOT_REQUIRED_STATE_LEXICAL_ROOT:-}" != "$lexical_root" ] \
        || [ "$ROOT_REQUIRED_LOCK_FILE" != "$expected_lock" ] \
        || [ "${HAPAX_ROOT_REQUIRED_LOCK_LEXICAL_PATH:-}" != "$expected_lock" ] \
        || [ "${HAPAX_ROOT_REQUIRED_LOCK_MODE:-}" != "exclusive" ]; then
        echo "authenticated OOM install rejected a noncanonical inherited state contract; next action: discard the altered invocation and regenerate its live command with hapax-post-merge-deploy" >&2
        return 1
    fi
}

validate_authenticated_test_root() {
    local raw="$ROOT_REQUIRED_INSTALLER_TEST_ROOT" root_mode account_home
    if [ "$ROOT_REQUIRED_INSTALLER_TEST_MODE" != "1" ] || [ -z "$raw" ] \
        || [[ "$raw" != /* ]] || [ -L "$raw" ]; then
        echo "authenticated OOM isolated test mode requires an absolute non-symlink HAPAX_ROOT_REQUIRED_INSTALLER_TEST_ROOT" >&2
        return 1
    fi
    AUTHENTICATED_TEST_ROOT="$(/usr/bin/realpath -e -- "$raw" 2>/dev/null)" || {
        echo "authenticated OOM isolated test root is unavailable: $raw" >&2
        return 1
    }
    root_mode="$(/usr/bin/stat -c %a -- "$AUTHENTICATED_TEST_ROOT" 2>/dev/null || true)"
    account_home="$(/usr/bin/python3 -I -c 'import os, pwd; print(pwd.getpwuid(os.getuid()).pw_dir)')" \
        || return 1
    if [ "$AUTHENTICATED_TEST_ROOT" = / ] || [ "$AUTHENTICATED_TEST_ROOT" != "$raw" ] \
        || [ ! -d "$AUTHENTICATED_TEST_ROOT" ] \
        || [ "$(/usr/bin/stat -c %u -- "$AUTHENTICATED_TEST_ROOT" 2>/dev/null || true)" != "$(/usr/bin/id -u)" ] \
        || ! [[ "$root_mode" =~ ^[0-7]+$ ]] \
        || (( (8#$root_mode & 8#022) != 0 )) \
        || [[ "$account_home" == "$AUTHENTICATED_TEST_ROOT" ]] \
        || [[ "$account_home" == "$AUTHENTICATED_TEST_ROOT"/* ]]; then
        echo "authenticated OOM isolated test root must be physical, caller-owned, and not group/other-writable: $raw" >&2
        return 1
    fi
}

validate_authenticated_production_environment_names() {
    [ "$AUTHENTICATED_SEALED_SOURCE" -eq 1 ] || return 0
    [ "$ROOT_REQUIRED_INSTALLER_TEST_MODE" = "0" ] || return 0
    if [ "$AUTHENTICATED_PRODUCTION_INPUT_ENVIRONMENT_VALIDATED" -ne 1 ]; then
        echo "authenticated production OOM install has no complete raw-environment validation; next action: discard the direct invocation and regenerate its exact live command with hapax-post-merge-deploy" >&2
        return 1
    fi
}

validate_authenticated_production_contract() {
    local account_record account_uid account_gid account_user account_home
    local canonical_state canonical_defer canonical_release canonical_stage
    validate_authenticated_production_environment_names || return 1
    account_record="$(/usr/bin/python3 -I - <<'PY'
import os
import pwd

account = pwd.getpwuid(os.getuid())
print(f"{account.pw_uid}:{account.pw_gid}:{account.pw_name}:{account.pw_dir}")
PY
)" || return 1
    IFS=: read -r account_uid account_gid account_user account_home <<< "$account_record"
    canonical_state="$account_home/.local/state/hapax/root-required"
    canonical_defer="$account_home/.cache/hapax/post-merge-root-required"
    canonical_release="$account_home/.cache/hapax/source-activation/releases/$ROOT_REQUIRED_PACKAGE_SHA"
    canonical_stage="$canonical_defer/$ROOT_REQUIRED_PACKAGE_SHA/oom-containment"
    if [ -n "$LOCAL_JUDGE_CAP_RECEIPT_SHA256" ] \
        && ! [[ "$LOCAL_JUDGE_CAP_RECEIPT_SHA256" =~ ^[0-9a-f]{64}$ ]]; then
        echo "authenticated production OOM install rejected a malformed helper-bound local-judge cap digest; next action: discard the altered invocation and regenerate its live command with hapax-post-merge-deploy" >&2
        return 1
    fi
    if [ "$account_uid" = "0" ] || [ "$TARGET_UID" != "$account_uid" ] \
        || [ "$TARGET_GID" != "$account_gid" ] || [ "$TARGET_USER" != "$account_user" ] \
        || [ "$TARGET_HOME" != "$account_home" ] || [ "$HOME" != "$account_home" ] \
        || [ "${USER:-}" != "$account_user" ] || [ "${LOGNAME:-}" != "$account_user" ] \
        || [ "$ACTUAL_UID" != "$account_uid" ] || [ "$EFFECTIVE_UID" != "$account_uid" ] \
        || [ "${GIT_CONFIG_GLOBAL:-}" != "/dev/null" ] \
        || [ "${GIT_CONFIG_NOSYSTEM:-}" != "1" ] \
        || [ "${GIT_NO_REPLACE_OBJECTS:-}" != "1" ] \
        || [ "${GIT_OPTIONAL_LOCKS:-}" != "0" ] \
        || [ "${LANG:-}" != "C.UTF-8" ] || [ "${LC_ALL:-}" != "C.UTF-8" ] \
        || [ "$PATH" != "/usr/local/sbin:/usr/local/bin:/usr/bin:/bin" ] \
        || [ "${PYTHONNOUSERSITE:-}" != "1" ] || [ "${PYTHONSAFEPATH:-}" != "1" ] \
        || [ "${XDG_RUNTIME_DIR:-}" != "/run/user/$account_uid" ] \
        || [ "${PWD:-}" != "$canonical_release" ] || [ "${SHLVL:-}" != "1" ] \
        || [ "$DOCKER" != "/usr/bin/docker" ] || [ "$SYSTEMCTL" != "/usr/bin/systemctl" ] \
        || [ "$SYSTEMD_ANALYZE" != "/usr/bin/systemd-analyze" ] \
        || [ "$SUDO" != "/usr/bin/sudo" ] || [ "$RUNUSER" != "/usr/bin/runuser" ] \
        || [ "$VISUDO" != "/usr/bin/visudo" ] \
        || [ "$ROOT_REQUIRED_DEFER_ROOT" != "$canonical_defer" ] \
        || [ "$ROOT_REQUIRED_GIT_REPO" != "$canonical_release" ] \
        || [ "$SOURCE" != "$canonical_stage" ] \
        || [ "${HAPAX_ROOT_REQUIRED_DRAIN_DIR:-}" != "$canonical_stage" ] \
        || [[ "$RUNTIME_AUTHORITY_TASK" != /* ]]; then
        echo "authenticated production OOM install rejected a noncanonical account, release, or stage contract; next action: discard the altered invocation and regenerate its live command with hapax-post-merge-deploy" >&2
        return 1
    fi
    validate_authenticated_state_contract "$canonical_state"
}

validate_authenticated_test_contract() {
    local path selector_value
    local canonical_stage="$ROOT_REQUIRED_DEFER_ROOT/$ROOT_REQUIRED_PACKAGE_SHA/oom-containment"
    local -a destinations selector_paths
    validate_authenticated_test_root || return 1
    if [ "$SOURCE" != "$canonical_stage" ] \
        || [ "${HAPAX_ROOT_REQUIRED_DRAIN_DIR:-}" != "$canonical_stage" ]; then
        echo "authenticated OOM isolated test source and drain must name the exact staged package under $ROOT_REQUIRED_DEFER_ROOT" >&2
        return 1
    fi
    validate_authenticated_state_contract "${HAPAX_ROOT_REQUIRED_STATE_LEXICAL_ROOT:-}" || return 1
    destinations=(
        "$SYSTEMD_SYSTEM_DIR" "$SYSTEMD_USER_DIR" "$SYSTEMD_USER_CONTROL_DIR"
        "$SYSTEMD_SYSTEM_CONTROL_DIR" "$SYSTEMD_SYSTEM_RUNTIME_CONTROL_DIR"
        "$SYSTEMD_SYSTEM_TRANSIENT_DIR" "$SYSTEMD_USER_RUNTIME_CONTROL_DIR"
        "$SYSTEMD_USER_TRANSIENT_DIR" "$EARLYOOM_DEST" "$OOM_ENFORCER_DEST"
        "$OOM_TRIGGER_DEST" "$OOM_SUDOERS_DEST" "$OOM_SUDOERS_REFERENCE_DEST"
        "$ROOT_FAILURE_INTAKE_DEST" "$OOM_POLICY_AUDIT_DEST" "$ROOT_REQUIRED_AUDIT_DEST"
        "$LOCAL_JUDGE_CONTAINER_ID_DEST" "$OOM_PROFILE_TABLE_DEST" "$ZRAM_POLICY_DEST"
        "$LEGACY_ZRAM_POLICY_DEST" "$ZRAM_DISKSIZE_PATH" "$PROC_ROOT" "$CGROUP_ROOT"
        "$ROOT_REQUIRED_STATE_ROOT" "${HAPAX_ROOT_REQUIRED_STATE_LEXICAL_ROOT:-}"
        "$ROOT_REQUIRED_INSTALLED_SOURCE_ROOT" "$ROOT_REQUIRED_DEFER_ROOT"
        "$ROOT_REQUIRED_INSTALLED_RECEIPT_ROOT" "$ROOT_REQUIRED_DESIRED_RECEIPT_ROOT"
        "$ROOT_REQUIRED_LOCK_FILE" "$ROOT_REQUIRED_GIT_REPO" "$SOURCE"
        "${HAPAX_ROOT_REQUIRED_DRAIN_DIR:-}" "$RUNTIME_AUTHORITY_TASK" "$TARGET_HOME"
    )
    for selector_value in \
        "$ZRAM_DROPIN_DIRS" \
        "$ZRAM_HIGH_PRIORITY_CONFIGS" \
        "${HAPAX_OOM_GOVERNED_SYSTEM_UNIT_PATHS:-}" \
        "${HAPAX_OOM_GOVERNED_USER_UNIT_PATHS:-}" \
        "${HAPAX_OOM_USER_UNIT_PATHS:-}"; do
        IFS=: read -r -a selector_paths <<< "$selector_value"
        destinations+=("${selector_paths[@]}")
    done
    for path in "${destinations[@]}"; do
        [ -n "$path" ] || continue
        if ! path_is_within_test_root "$path" "$AUTHENTICATED_TEST_ROOT"; then
            echo "authenticated OOM isolated test destination escapes $AUTHENTICATED_TEST_ROOT: $path" >&2
            return 1
        fi
    done
    validate_isolated_test_executable Docker "$DOCKER" "$AUTHENTICATED_TEST_ROOT" || return 1
    validate_isolated_test_executable systemctl "$SYSTEMCTL" "$AUTHENTICATED_TEST_ROOT" || return 1
    validate_isolated_test_executable systemd-analyze "$SYSTEMD_ANALYZE" "$AUTHENTICATED_TEST_ROOT" || return 1
    validate_isolated_test_executable runuser "$RUNUSER" "$AUTHENTICATED_TEST_ROOT" || return 1
    validate_isolated_test_executable visudo "$VISUDO" "$AUTHENTICATED_TEST_ROOT" || return 1
    if [ -n "$SUDO" ]; then
        validate_isolated_test_executable sudo "$SUDO" "$AUTHENTICATED_TEST_ROOT" || return 1
    fi
}

validate_authenticated_install_contract() {
    [ "$AUTHENTICATED_SEALED_SOURCE" -eq 1 ] || return 0
    case "$ROOT_REQUIRED_INSTALLER_TEST_MODE" in
        0)
            [ -z "$ROOT_REQUIRED_INSTALLER_TEST_ROOT" ] || {
                echo "authenticated production OOM install refuses HAPAX_ROOT_REQUIRED_INSTALLER_TEST_ROOT without isolated test mode" >&2
                return 1
            }
            validate_authenticated_production_contract
            ;;
        1) validate_authenticated_test_contract ;;
        *)
            echo "HAPAX_ROOT_REQUIRED_INSTALLER_TEST_MODE must be exactly 1 when present" >&2
            return 1
            ;;
    esac
}

require_authenticated_install_authority() {
    local raw_root root root_mode path
    local -a destinations dropin_dirs high_priority_configs
    [ "$INSTALL" -eq 1 ] || return 0
    if [ "$AUTHENTICATED_SEALED_SOURCE" -eq 1 ]; then
        validate_authenticated_install_contract
        return
    fi
    if production_destinations_selected; then
        echo "refusing unauthenticated production OOM install; next action: set HAPAX_RUNTIME_AUTHORITY_TASK to the canonical runtime-authorized task and rerun hapax-post-merge-deploy so its sealed helper invokes this installer" >&2
        return 1
    fi
    if [ "${HAPAX_ROOT_REQUIRED_ALLOW_UNAUTHENTICATED_TEST_INSTALL:-0}" != "1" ]; then
        echo "refusing unauthenticated OOM install outside an isolated test; next action: use the authenticated hapax-post-merge-deploy helper for live installation" >&2
        return 1
    fi
    raw_root="${HAPAX_ROOT_REQUIRED_UNAUTHENTICATED_TEST_ROOT:-}"
    if [ -z "$raw_root" ] || [[ "$raw_root" != /* ]] || [ -L "$raw_root" ]; then
        echo "unauthenticated OOM test install requires an absolute non-symlink HAPAX_ROOT_REQUIRED_UNAUTHENTICATED_TEST_ROOT" >&2
        return 1
    fi
    root="$(/usr/bin/realpath -e -- "$raw_root" 2>/dev/null)" || {
        echo "unauthenticated OOM test root is unavailable: $raw_root" >&2
        return 1
    }
    root_mode="$(/usr/bin/stat -c %a -- "$root" 2>/dev/null || true)"
    if [ "$root" = / ] || [ ! -d "$root" ] \
        || [ "$(/usr/bin/stat -c %u -- "$root" 2>/dev/null || true)" != "$(/usr/bin/id -u)" ] \
        || ! [[ "$root_mode" =~ ^[0-7]+$ ]] \
        || (( (8#$root_mode & 8#022) != 0 )); then
        echo "unauthenticated OOM test root must be caller-owned and not group/other-writable: $root" >&2
        return 1
    fi
    destinations=(
        "$SYSTEMD_SYSTEM_DIR" "$SYSTEMD_USER_DIR" "$SYSTEMD_USER_CONTROL_DIR"
        "$SYSTEMD_SYSTEM_CONTROL_DIR" "$SYSTEMD_SYSTEM_RUNTIME_CONTROL_DIR"
        "$SYSTEMD_SYSTEM_TRANSIENT_DIR" "$SYSTEMD_USER_RUNTIME_CONTROL_DIR"
        "$SYSTEMD_USER_TRANSIENT_DIR" "$EARLYOOM_DEST" "$OOM_ENFORCER_DEST"
        "$OOM_TRIGGER_DEST" "$OOM_SUDOERS_DEST" "$OOM_SUDOERS_REFERENCE_DEST"
        "$ROOT_FAILURE_INTAKE_DEST" "$OOM_POLICY_AUDIT_DEST" "$ROOT_REQUIRED_AUDIT_DEST"
        "$LOCAL_JUDGE_CONTAINER_ID_DEST" "$OOM_PROFILE_TABLE_DEST" "$ZRAM_POLICY_DEST"
        "$LEGACY_ZRAM_POLICY_DEST" "$ZRAM_DISKSIZE_PATH" "$PROC_ROOT" "$CGROUP_ROOT"
        "$ROOT_REQUIRED_STATE_ROOT" "$ROOT_REQUIRED_INSTALLED_SOURCE_ROOT"
        "$ROOT_REQUIRED_DEFER_ROOT" "$ROOT_REQUIRED_INSTALLED_RECEIPT_ROOT"
        "$ROOT_REQUIRED_DESIRED_RECEIPT_ROOT" "$ROOT_REQUIRED_LOCK_FILE" "$TARGET_HOME"
    )
    IFS=: read -r -a dropin_dirs <<< "$ZRAM_DROPIN_DIRS"
    IFS=: read -r -a high_priority_configs <<< "$ZRAM_HIGH_PRIORITY_CONFIGS"
    destinations+=("${dropin_dirs[@]}" "${high_priority_configs[@]}")
    for path in "${destinations[@]}"; do
        [ -n "$path" ] || continue
        if ! path_is_within_test_root "$path" "$root"; then
            echo "unauthenticated OOM test install destination escapes $root: $path" >&2
            return 1
        fi
    done
    validate_isolated_test_executable Docker "$DOCKER" "$root"
    validate_isolated_test_executable systemctl "$SYSTEMCTL" "$root"
}

validate_docker_command() {
    local override="${HAPAX_OOM_DOCKER:-}"
    if [ -z "$override" ]; then
        [ "$DOCKER" = "/usr/bin/docker" ] || {
            echo "internal Docker command drift: expected /usr/bin/docker, got $DOCKER; next action: restore the governed installer" >&2
            return 1
        }
        return 0
    fi
    if [ "${HAPAX_OOM_ENFORCE_TEST_MODE:-0}" != "1" ]; then
        echo "HAPAX_OOM_DOCKER is test-only; production reconciliation is pinned to /usr/bin/docker" >&2
        return 1
    fi
    if production_destinations_selected; then
        echo "refusing test-mode Docker command override for production OOM destinations; next action: remove HAPAX_OOM_DOCKER and HAPAX_OOM_ENFORCE_TEST_MODE" >&2
        return 1
    fi
    case "$DOCKER" in
        /*) ;;
        *)
            echo "test Docker command override must be an absolute path: $DOCKER" >&2
            return 1
            ;;
    esac
    if [ ! -f "$DOCKER" ] || [ -L "$DOCKER" ] || [ ! -x "$DOCKER" ]; then
        echo "test Docker command override must be a non-symlink executable regular file: $DOCKER" >&2
        return 1
    fi
}

local_docker() {
    /usr/bin/env \
        --unset=DOCKER_CONTEXT \
        --unset=DOCKER_CERT_PATH \
        --unset=DOCKER_TLS_VERIFY \
        --unset=DOCKER_TLS \
        --unset=DOCKER_API_VERSION \
        DOCKER_HOST="$LOCAL_DOCKER_HOST" \
        DOCKER_CONFIG="$LOCAL_DOCKER_CONFIG" \
        "$DOCKER" --config "$LOCAL_DOCKER_CONFIG" --host "$LOCAL_DOCKER_HOST" "$@"
}

load_host_policy() {
    local output key value
    [ "$HOST_POLICY_LOADED" -eq 0 ] || return 0
    if [ "${HAPAX_OOM_ENFORCE_TEST_MODE:-0}" = "1" ] && production_destinations_selected; then
        echo "refusing test-mode host-policy overrides for production OOM destinations; next action: remove HAPAX_OOM_ENFORCE_TEST_MODE, HAPAX_OOM_POLICY_MEMTOTAL_KIB, and HAPAX_OOM_POLICY_HOSTNAME" >&2
        return 1
    fi
    if [ "$AUTHENTICATED_SEALED_SOURCE" -eq 1 ]; then
        if [ "${HAPAX_OOM_ENFORCE_TEST_MODE:-0}" = "1" ]; then
            if ! output="$(
                HAPAX_OOM_AUDIT_SEALED_PACKAGE_SOURCE=1 \
                HAPAX_OOM_AUDIT_PROC_ROOT="$PROC_ROOT" \
                HAPAX_OOM_AUDIT_TEST_MODE=1 \
                HAPAX_OOM_AUDIT_MEMTOTAL_KIB="${HAPAX_OOM_POLICY_MEMTOTAL_KIB:-}" \
                HAPAX_OOM_AUDIT_HOSTNAME="${HAPAX_OOM_POLICY_HOSTNAME:-}" \
                HAPAX_OOM_AUDIT_PROFILE_TABLE="$(src_path "$host_profile_table_source")" \
                /usr/bin/python3 -I "$(src_path "$oom_policy_audit_source")" --host-policy-lines
            )"; then
                output=""
            fi
        else
            if ! output="$(
                HAPAX_OOM_AUDIT_SEALED_PACKAGE_SOURCE=1 \
                HAPAX_OOM_AUDIT_PROFILE_TABLE="$(src_path "$host_profile_table_source")" \
                /usr/bin/python3 -I "$(src_path "$oom_policy_audit_source")" --host-policy-lines
            )"; then
                output=""
            fi
        fi
        if [ -z "$output" ]; then
            echo "unable to derive the governed OOM host policy from sealed Git sources; next action: leave the deferral pending and regenerate its live command with hapax-post-merge-deploy" >&2
            return 1
        fi
    elif ! output="$(
        HAPAX_OOM_AUDIT_PROC_ROOT="$PROC_ROOT" \
        HAPAX_OOM_AUDIT_TEST_MODE="${HAPAX_OOM_ENFORCE_TEST_MODE:-0}" \
        HAPAX_OOM_AUDIT_MEMTOTAL_KIB="${HAPAX_OOM_POLICY_MEMTOTAL_KIB:-}" \
        HAPAX_OOM_AUDIT_HOSTNAME="${HAPAX_OOM_POLICY_HOSTNAME:-}" \
        /usr/bin/python3 "$(src_path "$oom_policy_audit_source")" --host-policy-lines
    )"; then
        echo "unable to derive the governed OOM host policy from physical RAM; next action: run scripts/hapax-oom-policy-audit --host-policy-lines and add a reviewed host sizing-table entry if this is a new memory class" >&2
        return 1
    fi
    while IFS='=' read -r key value; do
        case "$key" in
            POLICY_AUTHORITY) HOST_POLICY_AUTHORITY="$value" ;;
            HOSTNAME) HOST_HOSTNAME="$value" ;;
            PROFILE) HOST_PROFILE="$value" ;;
            PHYSICAL_BYTES) HOST_PHYSICAL_BYTES="$value" ;;
            APP_MEMORY_HIGH) HOST_APP_MEMORY_HIGH="$value" ;;
            APP_MEMORY_MAX) HOST_APP_MEMORY_MAX="$value" ;;
            UID_MEMORY_HIGH) HOST_UID_MEMORY_HIGH="$value" ;;
            UID_MEMORY_MAX) HOST_UID_MEMORY_MAX="$value" ;;
            ZRAM_SIZE_MIB) HOST_ZRAM_SIZE_MIB="$value" ;;
            *)
                echo "unexpected OOM host policy field: $key; next action: restore the matched installer/audit package" >&2
                return 1
                ;;
        esac
    done <<< "$output"
    case "$HOST_POLICY_AUTHORITY" in
        internal-sealed-package-source)
            if [ "$AUTHENTICATED_SEALED_SOURCE" -ne 1 ]; then
                echo "OOM host policy falsely claims sealed-package authority; next action: restore the matched installer/audit package" >&2
                return 1
            fi
            ;;
        non-authoritative-source-tree|non-authoritative-test-override)
            if [ "$AUTHENTICATED_SEALED_SOURCE" -eq 1 ]; then
                echo "sealed OOM package did not emit sealed-package authority; next action: leave the deferral pending and regenerate it with hapax-post-merge-deploy" >&2
                return 1
            fi
            ;;
        *)
            echo "unacceptable OOM host policy authority: ${HOST_POLICY_AUTHORITY:-missing}; next action: restore the matched installer/audit package" >&2
            return 1
            ;;
    esac
    [[ "$HOST_HOSTNAME" =~ ^hapax-(appendix|podium)$ ]] \
        && [[ "$HOST_PROFILE" =~ ^(appendix|podium)$ ]] \
        && [[ "$HOST_PHYSICAL_BYTES" =~ ^[0-9]+$ ]] \
        && [[ "$HOST_APP_MEMORY_HIGH" =~ ^[0-9]+G$ ]] \
        && [[ "$HOST_APP_MEMORY_MAX" =~ ^[0-9]+G$ ]] \
        && [[ "$HOST_UID_MEMORY_HIGH" =~ ^[0-9]+G$ ]] \
        && [[ "$HOST_UID_MEMORY_MAX" =~ ^[0-9]+G$ ]] \
        && [[ "$HOST_ZRAM_SIZE_MIB" =~ ^[0-9]+$ ]] || {
        echo "incomplete or invalid OOM host policy output; next action: restore scripts/hapax-oom-policy-audit from the same package commit" >&2
        return 1
    }
    HOST_POLICY_LOADED=1
}

validate_authenticated_cap_environment_for_host() {
    [ "$AUTHENTICATED_SEALED_SOURCE" -eq 1 ] || return 0
    [ "$ROOT_REQUIRED_INSTALLER_TEST_MODE" = "0" ] || return 0
    case "$HOST_PROFILE" in
        appendix)
            if ! [[ "$LOCAL_JUDGE_CAP_RECEIPT_SHA256" =~ ^[0-9a-f]{64}$ ]]; then
                echo "authenticated appendix OOM install requires the helper-bound local-judge cap digest; next action: rerun the governed cap canary and regenerate the live command with hapax-post-merge-deploy" >&2
                return 1
            fi
            ;;
        podium)
            if [ -n "$LOCAL_JUDGE_CAP_RECEIPT_SHA256" ]; then
                echo "authenticated podium OOM install refuses an appendix-only local-judge cap digest; next action: discard the altered invocation and regenerate its live command with hapax-post-merge-deploy" >&2
                return 1
            fi
            ;;
        *)
            echo "authenticated OOM cap contract has no exact selected host profile; next action: restore the sealed host policy and regenerate the live command with hapax-post-merge-deploy" >&2
            return 1
            ;;
    esac
}

publish_installed_source_file() {
    local source="$1" dest="$2" dest_dir temp
    dest_dir="$(dirname "$dest")"
    mkdir -p "$dest_dir"
    if ! temp="$(mktemp "$dest_dir/.${dest##*/}.tmp.XXXXXX")"; then
        echo "unable to reserve installed-source snapshot for $dest; next action: verify durable state ownership and capacity, then rerun the OOM installer" >&2
        return 1
    fi
    if [ "$AUTHENTICATED_SEALED_SOURCE" -eq 1 ]; then
        cp --dereference --preserve=mode -- "$source" "$temp"
    else
        cp -a -- "$source" "$temp"
    fi || {
        rm -f "$temp" 2>/dev/null || true
        echo "unable to materialize installed-source snapshot for $dest; next action: verify the package source and durable state capacity, then rerun the OOM installer" >&2
        return 1
    }
    if ! mv -fT -- "$temp" "$dest"; then
        rm -f "$temp" 2>/dev/null || true
        echo "unable to atomically publish installed-source snapshot $dest; next action: remove unsafe destination drift and rerun the OOM installer" >&2
        return 1
    fi
}

record_installed_source() {
    local rel dest
    for rel in "${package_files[@]}"; do
        dest="$ROOT_REQUIRED_INSTALLED_SOURCE_ROOT/$rel"
        publish_installed_source_file "$(src_path "$rel")" "$dest" || return 1
    done
}

validate_package_manifest() {
    local -a declared=()
    local index
    mapfile -t declared < <(awk 'NF && $1 !~ /^#/ {print $1}' "$(src_path "$package_manifest_source")")
    if [ "${#declared[@]}" -ne "${#package_files[@]}" ]; then
        echo "OOM package ownership manifest count mismatch; next action: reconcile $package_manifest_source with package_files in scripts/install-p0-oom-containment" >&2
        return 1
    fi
    for index in "${!package_files[@]}"; do
        if [ "${declared[$index]}" != "${package_files[$index]}" ]; then
            echo "OOM package ownership manifest mismatch at index $index: declared=${declared[$index]} runtime=${package_files[$index]}; next action: update both lists in the same governed change" >&2
            return 1
        fi
    done
}

app_slice_value() {
    selected_source_unit_value "$user_dropin" "$1"
}

source_unit_value() {
    local rel="$1" key="$2" file value
    file="$(src_path "$rel")"
    value="$(awk -v key="$key" '$0 ~ "^" key "=" {sub(/^[^=]*=/, ""); print; exit}' "$file" 2>/dev/null || true)"
    if [ -z "$value" ]; then
        echo "$rel missing $key; next action: restore $rel from the P0 PR" >&2
        return 1
    fi
    printf '%s\n' "$value"
}

selected_source_rel() {
    local rel="$1"
    case "$rel" in
        systemd/units/app.slice.d/oom-containment.conf)
            printf 'config/root-required/oom-host-policy/%s/app.slice.conf\n' "$HOST_PROFILE"
            ;;
        systemd/system/user-1000.slice.d/oom-containment.conf)
            printf 'config/root-required/oom-host-policy/%s/user-1000.slice.conf\n' "$HOST_PROFILE"
            ;;
        systemd/system/user@1000.service.d/oom.conf)
            printf 'config/root-required/oom-host-policy/%s/user@1000.service.conf\n' "$HOST_PROFILE"
            ;;
        *)
            printf '%s\n' "$rel"
            ;;
    esac
}

selected_zram_source_rel() {
    printf 'config/root-required/oom-host-policy/%s/zram-generator.conf\n' "$HOST_PROFILE"
}

selected_source_unit_value() {
    local rel="$1" key="$2"
    source_unit_value "$(selected_source_rel "$rel")" "$key"
}

system_memory_value() {
    selected_source_unit_value "$1" "$2"
}

validate_selected_host_sources() {
    local actual zram_source
    [ "$(app_slice_value MemoryHigh)" = "$HOST_APP_MEMORY_HIGH" ] \
        && [ "$(app_slice_value MemoryMax)" = "$HOST_APP_MEMORY_MAX" ] \
        && [ "$(system_memory_value systemd/system/user-1000.slice.d/oom-containment.conf MemoryHigh)" = "$HOST_UID_MEMORY_HIGH" ] \
        && [ "$(system_memory_value systemd/system/user-1000.slice.d/oom-containment.conf MemoryMax)" = "$HOST_UID_MEMORY_MAX" ] \
        && [ "$(system_memory_value systemd/system/user@1000.service.d/oom.conf MemoryHigh)" = "$HOST_UID_MEMORY_HIGH" ] \
        && [ "$(system_memory_value systemd/system/user@1000.service.d/oom.conf MemoryMax)" = "$HOST_UID_MEMORY_MAX" ] || {
        echo "selected $HOST_PROFILE systemd sources disagree with the receipt-bound host profile table; next action: reconcile the exact profile sources and table in one commit" >&2
        return 1
    }
    zram_source="$(src_path "$(selected_zram_source_rel)")"
    actual="$(awk -F= '$1 ~ /^[[:space:]]*zram-size[[:space:]]*$/ {gsub(/[[:space:]]/, "", $2); print $2; exit}' "$zram_source")"
    if [ "$actual" != "$HOST_ZRAM_SIZE_MIB" ] || ! grep -Eq '^compression-algorithm[[:space:]]*=[[:space:]]*zstd$' "$zram_source"; then
        echo "selected $HOST_PROFILE zram source disagrees with the receipt-bound host profile table; next action: reconcile the exact profile source and table in one commit" >&2
        return 1
    fi
}

governed_dropin_suffixes() {
    case "$1" in
        user-1000.slice)
            printf '%s\n' user-1000.slice.d user-.slice.d slice.d
            ;;
        user@1000.service)
            printf '%s\n' user@1000.service.d user@.service.d service.d
            ;;
        system.slice|user.slice|app.slice|session.slice)
            printf '%s\n' "$1.d" slice.d
            ;;
        *)
            return 1
            ;;
    esac
}

governed_fragment_names() {
    case "$1" in
        user@1000.service)
            printf '%s\n' user@1000.service user@.service
            ;;
        system.slice|user.slice|user-1000.slice|app.slice|session.slice)
            printf '%s\n' "$1"
            ;;
        *)
            return 1
            ;;
    esac
}

systemctl_generated_property_value() {
    local path="$1" key="$2"
    [ -f "$path" ] && [ ! -L "$path" ] || return 1
    grep -Fq 'created via "systemctl set-property"' "$path" || return 1
    awk -v key="$key" '
        /^[[:space:]]*(MemoryHigh|MemoryMax|MemorySwapMax|MemoryLow|MemoryMin)[[:space:]]*=/ {
            name = $0
            sub(/^[[:space:]]*/, "", name)
            sub(/[[:space:]]*=.*/, "", name)
            value = $0
            sub(/^[^=]*=[[:space:]]*/, "", value)
            sub(/[[:space:]]*$/, "", value)
            governed += 1
            if (name == key) {
                matched += 1
                result = value
            }
        }
        END {
            if (governed == 1 && matched == 1) print result
            else exit 1
        }
    ' "$path"
}

control_property_kind() {
    local scope="$1" unit="$2" key="$3" path="$4" persistent runtime
    case "$scope|$unit" in
        system\|system.slice|system\|user.slice|system\|user-1000.slice|system\|user@1000.service)
            persistent="$SYSTEMD_SYSTEM_CONTROL_DIR/$unit.d/50-$key.conf"
            runtime="$SYSTEMD_SYSTEM_RUNTIME_CONTROL_DIR/$unit.d/50-$key.conf"
            ;;
        user\|app.slice|user\|session.slice)
            persistent="$SYSTEMD_USER_CONTROL_DIR/$unit.d/50-$key.conf"
            runtime="$SYSTEMD_USER_RUNTIME_CONTROL_DIR/$unit.d/50-$key.conf"
            ;;
        *)
            return 1
            ;;
    esac
    if [ "$path" = "$persistent" ]; then
        printf 'persistent\n'
    elif [ "$path" = "$runtime" ]; then
        printf 'runtime\n'
    else
        return 1
    fi
}

is_known_legacy_memory_override() {
    local scope="$1" unit="$2" path="$3"
    case "$scope|$unit|$path" in
        "system|user-1000.slice|$SYSTEMD_SYSTEM_DIR/user-1000.slice.d/zz-hapax-host-memory.conf"|\
        "system|user@1000.service|$SYSTEMD_SYSTEM_DIR/user@1000.service.d/zz-hapax-host-memory.conf"|\
        "user|app.slice|$SYSTEMD_USER_DIR/app.slice.d/zz-hapax-host-memory.conf")
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

check_governed_unit_dropins() {
    local allow_repair="$1" scope="$2" unit="$3" canonical="$4"
    local root fragment suffix path rc key kind found_kind roots_output fragments_output suffixes_output
    if [ "$scope" = "system" ]; then
        roots_output="$(governed_system_unit_search_paths)" || return 1
    else
        roots_output="$(governed_user_unit_search_paths)" || return 1
    fi
    fragments_output="$(governed_fragment_names "$unit")" || {
        echo "missing governed full-fragment mapping for $unit; next action: define its exact fragment and template names before extending OOM policy" >&2
        return 1
    }
    suffixes_output="$(governed_dropin_suffixes "$unit")" || {
        echo "missing governed drop-in mapping for $unit; next action: define its exact inherited drop-in names before extending OOM policy" >&2
        return 1
    }
    while IFS= read -r root; do
        [ -n "$root" ] || continue
        while IFS= read -r fragment; do
            path="$root/$fragment"
            [ -e "$path" ] || [ -L "$path" ] || continue
            if [ -L "$path" ]; then
                echo "unowned OOM memory fragment is symlinked in the $unit search path: $path; next action: remove the override or govern a regular receipt-bound file" >&2
                return 1
            fi
            if [ ! -f "$path" ]; then
                echo "unsafe non-regular OOM memory fragment in the $unit search path: $path; next action: remove the override or govern a regular receipt-bound file" >&2
                return 1
            fi
            if grep -Eq '^[[:space:]]*(MemoryHigh|MemoryMax|MemorySwapMax|MemoryLow|MemoryMin)[[:space:]]*=' "$path"; then
                echo "unowned OOM memory assignment for $unit in full fragment $path; next action: remove the governed-key assignment or fold it into the receipt-bound host profile" >&2
                return 1
            else
                rc=$?
                if [ "$rc" -gt 1 ]; then
                    echo "unable to inspect OOM memory fragment: $path; next action: restore readable trusted unit fragments and rerun the installer" >&2
                    return 1
                fi
            fi
        done <<< "$fragments_output"
        while IFS= read -r suffix; do
            [ -d "$root/$suffix" ] || continue
            for path in "$root/$suffix"/*.conf; do
                [ -e "$path" ] || [ -L "$path" ] || continue
                if [ "$path" = "$canonical" ]; then
                    if [ -L "$path" ]; then
                        echo "canonical OOM memory drop-in is symlinked: $path; next action: reinstall the receipt-bound regular file" >&2
                        return 1
                    fi
                    continue
                fi
                if [ -L "$path" ]; then
                    echo "unowned OOM memory drop-in is symlinked in the $unit search path: $path; next action: remove the override or govern a regular receipt-bound file" >&2
                    return 1
                fi
                if [ "$allow_repair" -eq 1 ] \
                    && is_known_legacy_memory_override "$scope" "$unit" "$path"; then
                    continue
                fi
                if grep -Eq '^[[:space:]]*(MemoryHigh|MemoryMax|MemorySwapMax|MemoryLow|MemoryMin)[[:space:]]*=' "$path"; then
                    :
                else
                    rc=$?
                    if [ "$rc" -gt 1 ]; then
                        echo "unable to inspect OOM memory drop-in: $path; next action: restore readable trusted drop-ins and rerun the installer" >&2
                        return 1
                    fi
                    continue
                fi
                found_kind=""
                for key in "${GOVERNED_MEMORY_KEYS[@]}"; do
                    grep -Eq "^[[:space:]]*$key[[:space:]]*=" "$path" || continue
                    kind="$(control_property_kind "$scope" "$unit" "$key" "$path" 2>/dev/null || true)"
                    if [ -n "$kind" ] && systemctl_generated_property_value "$path" "$key" >/dev/null; then
                        if [ "$allow_repair" -eq 1 ]; then
                            found_kind="$kind"
                            break
                        fi
                    fi
                    echo "unowned OOM memory assignment for $unit at $path; next action: remove the governed-key assignment or fold it into the receipt-bound host profile" >&2
                    return 1
                done
                [ -n "$found_kind" ] || {
                    echo "unable to classify governed OOM memory assignment for $unit at $path; next action: remove the override and rerun the installer" >&2
                    return 1
                }
            done
        done <<< "$suffixes_output"
    done <<< "$roots_output"
}

check_governed_memory_dropins() {
    local allow_repair="$1"
    check_governed_unit_dropins "$allow_repair" system system.slice \
        "$SYSTEMD_SYSTEM_DIR/system.slice.d/oom-containment.conf" || return 1
    check_governed_unit_dropins "$allow_repair" system user.slice \
        "$SYSTEMD_SYSTEM_DIR/user.slice.d/oom-containment.conf" || return 1
    check_governed_unit_dropins "$allow_repair" system user-1000.slice \
        "$SYSTEMD_SYSTEM_DIR/user-1000.slice.d/oom-containment.conf" || return 1
    check_governed_unit_dropins "$allow_repair" system user@1000.service \
        "$SYSTEMD_SYSTEM_DIR/user@1000.service.d/oom.conf" || return 1
    check_governed_unit_dropins "$allow_repair" user app.slice \
        "$SYSTEMD_USER_DIR/app.slice.d/oom-containment.conf" || return 1
    check_governed_unit_dropins "$allow_repair" user session.slice \
        "$SYSTEMD_USER_DIR/session.slice.d/oom-containment.conf" || return 1
}

check_zram_dropin_overrides() {
    local allow_legacy="$1" dir path rc
    while IFS= read -r path; do
        [ -n "$path" ] || continue
        if [ -e "$path" ] || [ -L "$path" ]; then
            echo "higher-priority zram-generator main configuration shadows the canonical profile: $path; next action: remove the runtime override or govern it instead of /etc/systemd/zram-generator.conf" >&2
            return 1
        fi
    done < <(printf '%s\n' "${ZRAM_HIGH_PRIORITY_CONFIGS//:/$'\n'}")
    while IFS= read -r dir; do
        [ -d "$dir" ] || continue
        for path in "$dir"/*.conf; do
            [ -e "$path" ] || [ -L "$path" ] || continue
            if [ "$allow_legacy" -eq 1 ] && [ "$path" = "$LEGACY_ZRAM_POLICY_DEST" ]; then
                continue
            fi
            if [ -L "$path" ]; then
                echo "unowned zram-generator drop-in is symlinked: $path; next action: remove the override or govern it in the canonical host profile" >&2
                return 1
            fi
            if grep -Eq '^[[:space:]]*(zram-size|compression-algorithm)[[:space:]]*=' "$path"; then
                echo "unowned zram-generator drop-in overrides the canonical profile: $path; next action: remove the governed-key assignment or fold it into the receipt-bound host profile" >&2
                return 1
            else
                rc=$?
                if [ "$rc" -gt 1 ]; then
                    echo "unable to inspect zram-generator drop-in: $path; next action: restore readable trusted drop-ins and rerun the installer" >&2
                    return 1
                fi
            fi
        done
    done < <(printf '%s\n' "${ZRAM_DROPIN_DIRS//:/$'\n'}")
}

validate_no_unauthorized_host_policy_overrides() {
    local allow_legacy="$1"
    check_governed_memory_dropins "$allow_legacy" || return 1
    check_zram_dropin_overrides "$allow_legacy" || return 1
}

scrub_generated_memory_property_files() {
    local spec scope unit dir key path value
    local -a dirs
    for spec in \
        "system|system.slice" \
        "system|user.slice" \
        "system|user-1000.slice" \
        "system|user@1000.service" \
        "user|app.slice" \
        "user|session.slice"; do
        scope="${spec%%|*}"
        unit="${spec#*|}"
        unit="${unit%%|*}"
        if [ "$scope" = "system" ]; then
            dirs=(
                "$SYSTEMD_SYSTEM_CONTROL_DIR/$unit.d"
                "$SYSTEMD_SYSTEM_RUNTIME_CONTROL_DIR/$unit.d"
            )
        else
            dirs=(
                "$SYSTEMD_USER_CONTROL_DIR/$unit.d"
                "$SYSTEMD_USER_RUNTIME_CONTROL_DIR/$unit.d"
            )
        fi
        for dir in "${dirs[@]}"; do
            [ -d "$dir" ] || continue
            for key in "${GOVERNED_MEMORY_KEYS[@]}"; do
                path="$dir/50-$key.conf"
                [ -e "$path" ] || [ -L "$path" ] || continue
                value="$(systemctl_generated_property_value "$path" "$key")" || {
                    echo "refusing non-systemctl control file at governed path: $path; next action: inspect and remove or govern it explicitly before reinstalling" >&2
                    return 1
                }
                if [ "$scope" = "system" ]; then
                    run_root rm -f -- "$path"
                else
                    rm -f -- "$path"
                fi
                echo "removed generated set-property override for $unit $key=$value at $path"
            done
            if [ "$scope" = "system" ]; then
                run_root rmdir "$dir" 2>/dev/null || true
            else
                rmdir "$dir" 2>/dev/null || true
            fi
        done
    done
}

loaded_memory_unit_property() {
    local scope="$1" unit="$2" property="$3"
    if [ "$scope" = "system" ]; then
        "$SYSTEMCTL" show "$unit" -p "$property" --value 2>/dev/null
    else
        user_systemctl show "$unit" -p "$property" --value 2>/dev/null
    fi
}

verify_loaded_governed_unit_dropins() {
    local scope="$1" unit="$2" canonical="$3" need_reload fragment paths path rc canonical_found=0
    if ! need_reload="$(loaded_memory_unit_property "$scope" "$unit" NeedDaemonReload)"; then
        echo "unable to query authoritative NeedDaemonReload for $unit; next action: restore the manager query and rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
    if [ "$need_reload" != "no" ]; then
        echo "authoritative manager state is stale for $unit: NeedDaemonReload=${need_reload:-missing}; next action: reload the manager and rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
    if ! fragment="$(loaded_memory_unit_property "$scope" "$unit" FragmentPath)"; then
        echo "unable to query authoritative FragmentPath for $unit; next action: restore the manager query and rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
    if [ -n "$fragment" ]; then
        if [ ! -f "$fragment" ] || [ -L "$fragment" ]; then
            echo "authoritative FragmentPath reports an unsafe OOM memory source for $unit: $fragment; next action: restore a readable regular fragment or remove the override before rerunning the installer" >&2
            return 1
        fi
        if grep -Eq '^[[:space:]]*(MemoryHigh|MemoryMax|MemorySwapMax|MemoryLow|MemoryMin)[[:space:]]*=' "$fragment"; then
            echo "authoritative FragmentPath reports an unowned OOM memory assignment for $unit at $fragment; next action: remove the assignment and rerun $OOM_REPAIR_ACTION" >&2
            return 1
        else
            rc=$?
            if [ "$rc" -gt 1 ]; then
                echo "unable to inspect authoritative FragmentPath for $unit: $fragment; next action: restore a readable regular source or remove it before rerunning the installer" >&2
                return 1
            fi
        fi
    fi
    if ! paths="$(loaded_memory_unit_property "$scope" "$unit" DropInPaths)"; then
        echo "unable to query authoritative DropInPaths for $unit; next action: restore the manager query and rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
    while IFS= read -r path; do
        [ -n "$path" ] || continue
        if [ "$path" = "$canonical" ]; then
            if [ ! -f "$path" ] || [ -L "$path" ]; then
                echo "authoritative DropInPaths reports an unsafe canonical OOM memory source for $unit: $path; next action: reinstall the receipt-bound regular file and reload the manager" >&2
                return 1
            fi
            canonical_found=$((canonical_found + 1))
            continue
        fi
        if grep -Eq '^[[:space:]]*(MemoryHigh|MemoryMax|MemorySwapMax|MemoryLow|MemoryMin)[[:space:]]*=' "$path"; then
            echo "authoritative DropInPaths reports an unowned OOM memory assignment for $unit at $path; next action: remove the assignment and rerun $OOM_REPAIR_ACTION" >&2
            return 1
        else
            rc=$?
            if [ "$rc" -gt 1 ]; then
                echo "unable to inspect authoritative DropInPath for $unit: $path; next action: restore a readable regular source or remove it before rerunning the installer" >&2
                return 1
            fi
        fi
    done < <(printf '%s\n' "$paths" | tr ' ' '\n')
    if [ "$canonical_found" -ne 1 ]; then
        echo "authoritative DropInPaths for $unit does not contain exactly one receipt-owned source: expected=$canonical actual=${paths:-none}; next action: reload the manager from the installed canonical policy and rerun --verify-live" >&2
        return 1
    fi
    return 0
}

verify_loaded_memory_dropin_ownership() {
    verify_loaded_governed_unit_dropins system system.slice \
        "$SYSTEMD_SYSTEM_DIR/system.slice.d/oom-containment.conf" || return 1
    verify_loaded_governed_unit_dropins system user.slice \
        "$SYSTEMD_SYSTEM_DIR/user.slice.d/oom-containment.conf" || return 1
    verify_loaded_governed_unit_dropins system user-1000.slice \
        "$SYSTEMD_SYSTEM_DIR/user-1000.slice.d/oom-containment.conf" || return 1
    verify_loaded_governed_unit_dropins system user@1000.service \
        "$SYSTEMD_SYSTEM_DIR/user@1000.service.d/oom.conf" || return 1
    verify_loaded_governed_unit_dropins user app.slice \
        "$SYSTEMD_USER_DIR/app.slice.d/oom-containment.conf" || return 1
    verify_loaded_governed_unit_dropins user session.slice \
        "$SYSTEMD_USER_DIR/session.slice.d/oom-containment.conf" || return 1
}

source_unit_optional_value() {
    local rel="$1" key="$2" file
    file="$(src_path "$rel")"
    awk -v key="$key" '$0 ~ "^" key "=" {sub(/^[^=]*=/, ""); print; exit}' \
        "$file" 2>/dev/null || true
}

loaded_unit_property() {
    local manager="$1" unit="$2" property="$3"
    if [ "$manager" = "user" ]; then
        user_systemctl show "$unit" -p "$property" --value 2>/dev/null
    else
        "$SYSTEMCTL" show "$unit" -p "$property" --value 2>/dev/null
    fi
}

verify_effective_service_unit() {
    local manager="$1" unit="$2" rel="$3" expected_fragment="$4"
    local expected_exec expected_failure expected_user actual_fragment actual_dropins
    local actual_exec actual_failure actual_user
    expected_exec="$(source_unit_value "$rel" ExecStart)" || return 1
    expected_failure="$(source_unit_optional_value "$rel" OnFailure)"
    expected_failure="${expected_failure//%n/$unit}"
    expected_user="$(source_unit_optional_value "$rel" User)"
    actual_fragment="$(loaded_unit_property "$manager" "$unit" FragmentPath)" || actual_fragment=""
    actual_dropins="$(loaded_unit_property "$manager" "$unit" DropInPaths)" || actual_dropins="query-error"
    actual_exec="$(loaded_unit_property "$manager" "$unit" ExecStart)" || actual_exec=""
    actual_failure="$(loaded_unit_property "$manager" "$unit" OnFailure)" || actual_failure="query-error"
    actual_user="$(loaded_unit_property "$manager" "$unit" User)" || actual_user="query-error"
    if [ "$actual_fragment" != "$expected_fragment" ] || [ -n "$actual_dropins" ]; then
        echo "effective $unit unit-source drift: FragmentPath=${actual_fragment:-unavailable} DropInPaths=${actual_dropins:-none} expected FragmentPath=$expected_fragment and no drop-ins; next action: remove unauthorized overrides, reload the manager, and rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
    case "$actual_exec" in
        *"argv[]=$expected_exec ;"*) ;;
        *)
            echo "effective $unit ExecStart drift: actual=${actual_exec:-unavailable} expected=$expected_exec; next action: remove unauthorized overrides, reload the manager, and rerun $OOM_REPAIR_ACTION" >&2
            return 1
            ;;
    esac
    if [ "$actual_failure" != "$expected_failure" ] || [ "$actual_user" != "$expected_user" ]; then
        echo "effective $unit failure/identity drift: OnFailure=${actual_failure:-none} User=${actual_user:-default} expected OnFailure=${expected_failure:-none} User=${expected_user:-default}; next action: remove unauthorized overrides, reload the manager, and rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
}

verify_effective_local_judge_unit() {
    local unit="hapax-local-judge.service"
    local expected_fragment="$SYSTEMD_USER_DIR/$unit"
    local need_reload actual_fragment actual_dropins actual_exec
    need_reload="$(loaded_unit_property user "$unit" NeedDaemonReload)" || need_reload="query-error"
    actual_fragment="$(loaded_unit_property user "$unit" FragmentPath)" || actual_fragment=""
    actual_dropins="$(loaded_unit_property user "$unit" DropInPaths)" || actual_dropins="query-error"
    actual_exec="$(loaded_unit_property user "$unit" ExecStart)" || actual_exec=""
    if [ "$need_reload" != "no" ]; then
        echo "effective $unit manager state is stale: NeedDaemonReload=${need_reload:-unavailable}; next action: reload the user manager and rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
    if [ "$actual_fragment" != "$expected_fragment" ] || [ -n "$actual_dropins" ]; then
        echo "effective $unit unit-source drift: FragmentPath=${actual_fragment:-unavailable} DropInPaths=${actual_dropins:-none} expected FragmentPath=$expected_fragment and no drop-ins; next action: remove unauthorized overrides, reload the user manager, and rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
    if [[ "$actual_exec" != *"argv[]=/usr/bin/env -i "* \
        || "$actual_exec" != *" /usr/bin/docker $LOCAL_JUDGE_DOCKER_HOST_ARG --config="* \
        || "$actual_exec" != *"$LOCAL_JUDGE_DOCKER_CONFIG_SUFFIX run "* \
        || "$actual_exec" != *" --name hapax-local-judge "* \
        || "$actual_exec" != *" --memory $LOCAL_JUDGE_DOCKER_MEMORY "* \
        || "$actual_exec" != *" --memory-swap $LOCAL_JUDGE_DOCKER_MEMORY_SWAP "* ]]; then
        echo "effective $unit ExecStart drift: durable launch does not contain the governed clean-environment local-Docker selector and $LOCAL_JUDGE_DOCKER_MEMORY/$LOCAL_JUDGE_DOCKER_MEMORY_SWAP limits; next action: remove unauthorized overrides, reload the user manager, and rerun the runtime-authorized hapax-post-merge-deploy reconciliation" >&2
        return 1
    fi
}

verify_effective_failure_intake_unit() {
    local unit="hapax-root-failure-intake@hapax-oom-score-enforce.service.service"
    local instance="hapax-oom-score-enforce.service"
    local rel="systemd/units/hapax-root-failure-intake@.service"
    local expected_fragment="$SYSTEMD_SYSTEM_DIR/hapax-root-failure-intake@.service"
    local expected_exec expected_user expected_environment expected_interval expected_burst
    local actual_fragment actual_dropins actual_exec actual_user actual_environment
    local actual_interval actual_burst
    expected_exec="$(source_unit_value "$rel" ExecStart)" || return 1
    expected_exec="${expected_exec//%i/$instance}"
    expected_user="$(source_unit_value "$rel" User)" || return 1
    expected_environment="$(source_unit_value "$rel" Environment)" || return 1
    expected_interval="$(source_unit_value "$rel" StartLimitIntervalSec)" || return 1
    expected_burst="$(source_unit_value "$rel" StartLimitBurst)" || return 1
    actual_fragment="$(loaded_unit_property system "$unit" FragmentPath)" || actual_fragment=""
    actual_dropins="$(loaded_unit_property system "$unit" DropInPaths)" || actual_dropins="query-error"
    actual_exec="$(loaded_unit_property system "$unit" ExecStart)" || actual_exec=""
    actual_user="$(loaded_unit_property system "$unit" User)" || actual_user="query-error"
    actual_environment="$(loaded_unit_property system "$unit" Environment)" || actual_environment="query-error"
    actual_interval="$(loaded_unit_property system "$unit" StartLimitIntervalUSec)" || actual_interval="query-error"
    actual_burst="$(loaded_unit_property system "$unit" StartLimitBurst)" || actual_burst="query-error"
    if [ "$actual_fragment" != "$expected_fragment" ] || [ -n "$actual_dropins" ]; then
        echo "effective $unit unit-source drift: FragmentPath=${actual_fragment:-unavailable} DropInPaths=${actual_dropins:-none} expected FragmentPath=$expected_fragment and no drop-ins; next action: remove unauthorized template or instance overrides, reload the manager, and rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
    case "$actual_exec" in
        *"argv[]=$expected_exec ;"*) ;;
        *)
            echo "effective $unit ExecStart drift: actual=${actual_exec:-unavailable} expected=$expected_exec; next action: remove unauthorized template or instance overrides, reload the manager, and rerun $OOM_REPAIR_ACTION" >&2
            return 1
            ;;
    esac
    if [ "$actual_user" != "$expected_user" ] || [ "$actual_environment" != "$expected_environment" ] \
        || [ "$actual_interval" != "$expected_interval" ] || [ "$actual_burst" != "$expected_burst" ]; then
        echo "effective $unit identity/limit drift: User=${actual_user:-default} Environment=${actual_environment:-none} StartLimitIntervalUSec=${actual_interval:-none} StartLimitBurst=${actual_burst:-none} expected User=$expected_user Environment=$expected_environment StartLimitIntervalUSec=$expected_interval StartLimitBurst=$expected_burst; next action: remove unauthorized template or instance overrides, reload the manager, and rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
}

verify_effective_timer_unit() {
    local manager="$1" unit="$2" rel="$3" expected_fragment="$4"
    local expected_target expected_boot expected_active actual_fragment actual_dropins
    local actual_target actual_timers
    expected_target="$(source_unit_value "$rel" Unit)" || return 1
    expected_boot="$(source_unit_value "$rel" OnBootSec)" || return 1
    expected_active="$(source_unit_value "$rel" OnUnitActiveSec)" || return 1
    actual_fragment="$(loaded_unit_property "$manager" "$unit" FragmentPath)" || actual_fragment=""
    actual_dropins="$(loaded_unit_property "$manager" "$unit" DropInPaths)" || actual_dropins="query-error"
    actual_target="$(loaded_unit_property "$manager" "$unit" Unit)" || actual_target="query-error"
    actual_timers="$(loaded_unit_property "$manager" "$unit" TimersMonotonic)" || actual_timers="query-error"
    if [ "$actual_fragment" != "$expected_fragment" ] || [ -n "$actual_dropins" ]; then
        echo "effective $unit unit-source drift: FragmentPath=${actual_fragment:-unavailable} DropInPaths=${actual_dropins:-none} expected FragmentPath=$expected_fragment and no drop-ins; next action: remove unauthorized overrides, reload the manager, and rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
    if [ "$actual_target" != "$expected_target" ]; then
        echo "effective $unit target drift: actual=${actual_target:-unavailable} expected=$expected_target; next action: remove unauthorized overrides, reload the manager, and rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
    case "$actual_timers" in
        *"OnBootUSec=$expected_boot"*"OnUnitActiveUSec=$expected_active"*|*"OnUnitActiveUSec=$expected_active"*"OnBootUSec=$expected_boot"*) ;;
        *)
            echo "effective $unit cadence drift: actual=${actual_timers:-unavailable} expected OnBootUSec=$expected_boot and OnUnitActiveUSec=$expected_active; next action: remove unauthorized overrides, reload the manager, and rerun $OOM_REPAIR_ACTION" >&2
            return 1
            ;;
    esac
}

verify_effective_safety_units() {
    verify_effective_service_unit system hapax-oom-score-enforce.service \
        systemd/units/hapax-oom-score-enforce.service \
        "$SYSTEMD_SYSTEM_DIR/hapax-oom-score-enforce.service" || return 1
    verify_effective_failure_intake_unit || return 1
    verify_effective_timer_unit system hapax-oom-score-enforce.timer \
        systemd/units/hapax-oom-score-enforce.timer \
        "$SYSTEMD_SYSTEM_DIR/hapax-oom-score-enforce.timer" || return 1
    verify_effective_service_unit user hapax-oom-policy-audit.service \
        systemd/units/hapax-oom-policy-audit.service \
        "$SYSTEMD_USER_DIR/hapax-oom-policy-audit.service" || return 1
    verify_effective_timer_unit user hapax-oom-policy-audit.timer \
        systemd/units/hapax-oom-policy-audit.timer \
        "$SYSTEMD_USER_DIR/hapax-oom-policy-audit.timer" || return 1
    verify_effective_service_unit user hapax-root-required-deploy-audit.service \
        systemd/units/hapax-root-required-deploy-audit.service \
        "$SYSTEMD_USER_DIR/hapax-root-required-deploy-audit.service" || return 1
    verify_effective_timer_unit user hapax-root-required-deploy-audit.timer \
        systemd/units/hapax-root-required-deploy-audit.timer \
        "$SYSTEMD_USER_DIR/hapax-root-required-deploy-audit.timer" || return 1
    verify_effective_local_judge_unit || return 1
}

memory_to_bytes() {
    local value="$1" number suffix
    case "$value" in
        infinity|max)
            printf 'infinity\n'
            ;;
        *K|*M|*G|*T)
            number="${value%?}"
            suffix="${value#"$number"}"
            [[ "$number" =~ ^[0-9]+$ ]] || return 1
            case "$suffix" in
                K) printf '%s\n' "$((number * 1024))" ;;
                M) printf '%s\n' "$((number * 1024 * 1024))" ;;
                G) printf '%s\n' "$((number * 1024 * 1024 * 1024))" ;;
                T) printf '%s\n' "$((number * 1024 * 1024 * 1024 * 1024))" ;;
            esac
            ;;
        *)
            [[ "$value" =~ ^[0-9]+$ ]] || return 1
            printf '%s\n' "$value"
            ;;
    esac
}

docker_policy_for_container() {
    local name="$1"
    case "$name" in
        hapax-local-judge)
            printf '%s|%s\n' "$LOCAL_JUDGE_DOCKER_MEMORY" "$LOCAL_JUDGE_DOCKER_MEMORY_SWAP"
            ;;
        hapax-github-mcp-?*)
            printf '%s|%s\n' "$MCP_DOCKER_MEMORY" "$MCP_DOCKER_MEMORY_SWAP"
            ;;
        *)
            return 1
            ;;
    esac
}

docker_container_records() {
    local output record id name remainder
    output="$(local_docker ps -a --no-trunc --format '{{.ID}}|{{.Names}}')" || return 1
    while IFS= read -r record; do
        [ -n "$record" ] || continue
        remainder="${record#*|}"
        if [ "$remainder" = "$record" ] || [[ "$remainder" == *"|"* ]]; then
            echo "unparseable Docker identity record: $record; next action: restore full two-field --no-trunc Docker enumeration before retrying" >&2
            return 1
        fi
        IFS='|' read -r id name <<< "$record"
        if ! [[ "$id" =~ ^[0-9a-f]{64}$ ]] || [ -z "$name" ]; then
            echo "unparseable Docker identity record: $record; next action: restore full 64-hex --no-trunc Docker identities before any containment mutation" >&2
            return 1
        fi
        printf '%s|%s\n' "$id" "$name"
    done <<< "$output"
}

docker_target_records() {
    local records record name
    records="$(docker_container_records)" || return 1
    while IFS= read -r record; do
        [ -n "$record" ] || continue
        name="${record#*|}"
        docker_policy_for_container "$name" >/dev/null || continue
        printf '%s\n' "$record"
    done <<< "$records"
}

verify_docker_container_limit() {
    local id="$1" name="$2" memory="$3" memory_swap="$4"
    local output separators inspected_id inspected_name actual_memory actual_swap oom_kill_disable
    local expected_memory expected_swap
    if ! output="$(local_docker inspect --format '{{.Id}}|{{.Name}}|{{.HostConfig.Memory}}|{{.HostConfig.MemorySwap}}|{{json .HostConfig.OomKillDisable}}' "$id" 2>&1)"; then
        echo "Docker inspect failed for $name id=$id: ${output:-no diagnostics returned}" >&2
        return 2
    fi
    separators="${output//[^|]/}"
    if [[ "$output" == *$'\n'* ]] || [ "${#separators}" -ne 4 ]; then
        echo "unparseable Docker inspect result for $name id=$id: expected one five-field record, got ${output:-empty}; next action: rerun $OOM_REPAIR_ACTION after repairing Docker inspect output" >&2
        return 1
    fi
    IFS='|' read -r inspected_id inspected_name actual_memory actual_swap oom_kill_disable <<< "$output"
    if [ "$oom_kill_disable" != "null" ] \
        && [ "$oom_kill_disable" != "false" ] \
        && [ "$oom_kill_disable" != "true" ]; then
        echo "unparseable Docker OomKillDisable for $name id=$id: expected canonical null, false, or true, got ${oom_kill_disable:-empty}; next action: rerun $OOM_REPAIR_ACTION after repairing Docker inspect output" >&2
        return 1
    fi
    inspected_name="${inspected_name#/}"
    expected_memory="$(memory_to_bytes "$memory")" || return 1
    expected_swap="$(memory_to_bytes "$memory_swap")" || return 1
    if [ "$inspected_id" != "$id" ] \
        || [ "$inspected_name" != "$name" ] \
        || [ "$actual_memory" != "$expected_memory" ] \
        || [ "$actual_swap" != "$expected_swap" ] \
        || [ "$oom_kill_disable" = "true" ]; then
        echo "Docker containment drift for $name: id=${inspected_id:-unavailable} name=${inspected_name:-unavailable} Memory=${actual_memory:-unavailable} MemorySwap=${actual_swap:-unavailable} OomKillDisable=${oom_kill_disable:-unavailable} expected_id=$id expected_limits=$expected_memory/$expected_swap expected_OomKillDisable=false-or-null; next action: recreate the container from its governed launch source without --oom-kill-disable and rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
}

docker_target_absent() {
    local expected_id="$1" expected_name="$2" records record id name
    records="$(docker_container_records)" || return 2
    while IFS= read -r record; do
        [ -n "$record" ] || continue
        id="${record%%|*}"
        name="${record#*|}"
        if [ "$id" = "$expected_id" ] || [ "$name" = "$expected_name" ]; then
            return 1
        fi
    done <<< "$records"
    return 0
}

reconcile_docker_memory_limits() {
    local records record id name policy memory memory_swap update_output verify_rc absence_rc
    if ! records="$(docker_target_records)"; then
        echo "unable to enumerate Docker containers for OOM containment; next action: restore Docker access and rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
    while IFS= read -r record; do
        [ -n "$record" ] || continue
        id="${record%%|*}"
        name="${record#*|}"
        policy="$(docker_policy_for_container "$name")"
        IFS='|' read -r memory memory_swap <<< "$policy"
        if ! update_output="$(local_docker update --memory "$memory" --memory-swap "$memory_swap" "$id" 2>&1)"; then
            if docker_target_absent "$id" "$name"; then
                absence_rc=0
            else
                absence_rc=$?
            fi
            case "$absence_rc" in
                0)
                    echo "Docker target $name id=$id disappeared during limit convergence; neither its identity nor owned name remains to cap"
                    continue
                    ;;
                1)
                    echo "unable to apply Docker memory limits to $name id=$id while the original identity or same-name target remains; docker update diagnostics: ${update_output:-none}; next action: resolve the reported Docker failure and rerun $OOM_REPAIR_ACTION" >&2
                    ;;
                2)
                    echo "unable to confirm Docker target $name id=$id after update failure because re-enumeration failed; docker update diagnostics: ${update_output:-none}; next action: restore Docker access and rerun $OOM_REPAIR_ACTION" >&2
                    ;;
                *)
                    echo "unexpected Docker absence-check status $absence_rc for $name id=$id after update failure; next action: restore the matched OOM installer and rerun $OOM_REPAIR_ACTION" >&2
                    ;;
            esac
            return 1
        fi
        if verify_docker_container_limit "$id" "$name" "$memory" "$memory_swap"; then
            echo "converged Docker memory limits for $name id=$id: Memory=$memory MemorySwap=$memory_swap"
            continue
        else
            verify_rc=$?
            case "$verify_rc" in
                1) ;;
                2)
                    if docker_target_absent "$id" "$name"; then
                        absence_rc=0
                    else
                        absence_rc=$?
                    fi
                    case "$absence_rc" in
                        0)
                            echo "Docker target $name id=$id disappeared during post-update verification; neither its identity nor owned name remains to cap"
                            continue
                            ;;
                        1)
                            echo "Docker inspect failed while the original identity or same-name target remains for $name id=$id; next action: restore Docker access and rerun $OOM_REPAIR_ACTION" >&2
                            ;;
                        2)
                            echo "unable to confirm Docker target $name id=$id after inspect failure because re-enumeration failed; next action: restore Docker access and rerun $OOM_REPAIR_ACTION" >&2
                            ;;
                        *)
                            echo "unexpected Docker absence-check status $absence_rc for $name id=$id after inspect failure; next action: restore the matched OOM installer and rerun $OOM_REPAIR_ACTION" >&2
                            ;;
                    esac
                    ;;
                *)
                    echo "unexpected Docker limit-verification status $verify_rc for $name id=$id; next action: restore the matched OOM installer and rerun $OOM_REPAIR_ACTION" >&2
                    ;;
            esac
            return 1
        fi
    done <<< "$records"
}

verify_docker_memory_limits() {
    local records record id name policy memory memory_swap verify_rc absence_rc
    if ! records="$(docker_target_records)"; then
        echo "unable to enumerate Docker containers for OOM containment; next action: restore Docker access and rerun scripts/install-p0-oom-containment --verify-live" >&2
        return 1
    fi
    while IFS= read -r record; do
        [ -n "$record" ] || continue
        id="${record%%|*}"
        name="${record#*|}"
        policy="$(docker_policy_for_container "$name")"
        IFS='|' read -r memory memory_swap <<< "$policy"
        if verify_docker_container_limit "$id" "$name" "$memory" "$memory_swap"; then
            echo "verified Docker memory limits for $name id=$id: Memory=$memory MemorySwap=$memory_swap"
            continue
        else
            verify_rc=$?
            case "$verify_rc" in
                1) ;;
                2)
                    if docker_target_absent "$id" "$name"; then
                        absence_rc=0
                    else
                        absence_rc=$?
                    fi
                    case "$absence_rc" in
                        0) continue ;;
                        1)
                            echo "Docker inspect failed while the original identity or same-name target remains for $name id=$id; next action: restore Docker access and rerun scripts/install-p0-oom-containment --verify-live" >&2
                            ;;
                        2)
                            echo "unable to confirm Docker target $name id=$id after inspect failure because re-enumeration failed; next action: restore Docker access and rerun scripts/install-p0-oom-containment --verify-live" >&2
                            ;;
                        *)
                            echo "unexpected Docker absence-check status $absence_rc for $name id=$id after inspect failure; next action: restore the matched OOM installer and rerun --verify-live" >&2
                            ;;
                    esac
                    ;;
                *)
                    echo "unexpected Docker limit-verification status $verify_rc for $name id=$id; next action: restore the matched OOM installer and rerun --verify-live" >&2
                    ;;
            esac
            return 1
        fi
    done <<< "$records"
}

system_dest() {
    local rel="$1"
    case "$rel" in
        systemd/system/*) printf '%s/%s\n' "$SYSTEMD_SYSTEM_DIR" "${rel#systemd/system/}" ;;
        systemd/units/*) printf '%s/%s\n' "$SYSTEMD_SYSTEM_DIR" "${rel#systemd/units/}" ;;
    esac
}

check_source() {
    local rel
    validate_package_manifest
    for rel in "${package_files[@]}"; do
        [ -f "$(src_path "$rel")" ] || {
            echo "missing source file: $(src_path "$rel"); next action: restore the source tree or rerun from the PR/activation worktree" >&2
            return 1
        }
    done
    [ -x "$(src_path "$oom_trigger_source")" ] || {
        echo "OOM startup trigger is not executable: $(src_path "$oom_trigger_source"); next action: chmod +x scripts/hapax-oom-score-trigger" >&2
        return 1
    }
    [ "$(head -n 1 "$(src_path "$oom_trigger_source")")" = "#!/usr/bin/bash" ] || {
        echo "OOM startup trigger must pin /usr/bin/bash before entering the sudo path: $(src_path "$oom_trigger_source"); next action: restore the absolute interpreter shebang and rerun scripts/install-p0-oom-containment --check" >&2
        return 1
    }
    [ -x "$(src_path "$oom_enforcer_source")" ] || {
        echo "OOM root enforcer is not executable: $(src_path "$oom_enforcer_source"); next action: chmod +x scripts/hapax-oom-score-enforce" >&2
        return 1
    }
    [ "$(head -n 1 "$(src_path "$oom_enforcer_source")")" = "#!/usr/bin/bash" ] || {
        echo "OOM root enforcer must pin /usr/bin/bash before sudo execution: $(src_path "$oom_enforcer_source"); next action: restore the absolute interpreter shebang and rerun scripts/install-p0-oom-containment --check" >&2
        return 1
    }
    "$VISUDO" -cf "$(src_path "$oom_sudoers_source")" >/dev/null || {
        echo "invalid OOM enforcer sudoers policy: $(src_path "$oom_sudoers_source"); next action: repair the allowlisted commands and rerun scripts/install-p0-oom-containment --check" >&2
        return 1
    }
    if [ "$OOM_SUDOERS_DEST" = "/etc/sudoers.d/hapax-oom-score-enforce" ] \
        && { [ "$TARGET_USER" != "hapax" ] \
            || [ "$TARGET_UID" != "1000" ] \
            || [ "$TARGET_HOME" != "/home/hapax" ] \
            || [ "$OOM_SUDOERS_REFERENCE_DEST" != "/usr/local/share/hapax/root-required/hapax-oom-score-enforce.sudoers" ] \
            || [ "$OOM_SUDOERS_OWNER_UID" != "0" ] \
            || [ "$OOM_SUDOERS_OWNER_GID" != "0" ]; }; then
        echo "production OOM sudoers policy is fixed to hapax/UID 1000, /home/hapax, and root-owned live/reference paths; next action: use the podium defaults or dispatch a host-specific package instead of overriding target identity or trust paths" >&2
        return 1
    fi
    if ! [[ "$OOM_SUDOERS_OWNER_UID" =~ ^[0-9]+$ && "$OOM_SUDOERS_OWNER_GID" =~ ^[0-9]+$ ]]; then
        echo "OOM sudoers owner UID/GID must be numeric; next action: remove invalid HAPAX_OOM_SUDOERS_OWNER_UID/GID overrides" >&2
        return 1
    fi
    grep -Eq '^OOMScoreAdjust=100$' "$(src_path systemd/system/user@1000.service.d/oom.conf)" || {
        echo "user@1000 OOM drop-in must set OOMScoreAdjust=100; next action: restore systemd/system/user@1000.service.d/oom.conf from the P0 PR" >&2
        return 1
    }
    grep -Eq '^OOMPolicy=continue$' "$(src_path systemd/system/user@1000.service.d/oom.conf)" || {
        echo "user@1000 OOM drop-in must continue after a descendant OOM; next action: restore systemd/system/user@1000.service.d/oom.conf from the P0 PR" >&2
        return 1
    }
    grep -Eq '^OOMScoreAdjust=0$' "$(src_path systemd/system/sshd.service.d/oom-protect.conf)" || {
        echo "sshd OOM drop-in must keep child-inheritable OOMScoreAdjust neutral; next action: restore systemd/system/sshd.service.d/oom-protect.conf from the P0 PR" >&2
        return 1
    }
    grep -Eq '^OOMPolicy=continue$' "$(src_path systemd/system/sshd.service.d/oom-protect.conf)" || {
        echo "sshd OOM drop-in must continue after a session OOM; next action: restore systemd/system/sshd.service.d/oom-protect.conf from the P0 PR" >&2
        return 1
    }
    source_unit_value "$user_dropin" MemoryHigh >/dev/null
    source_unit_value "$user_dropin" MemoryMax >/dev/null
    source_unit_value "$user_dropin" MemorySwapMax >/dev/null
    source_unit_value "$user_dropin" MemoryLow >/dev/null
    source_unit_value "$user_dropin" MemoryMin >/dev/null
    source_unit_value "$session_slice_dropin" MemoryHigh >/dev/null
    source_unit_value "$session_slice_dropin" MemoryMax >/dev/null
    source_unit_value "$session_slice_dropin" MemorySwapMax >/dev/null
    source_unit_value "$session_slice_dropin" MemoryLow >/dev/null
    source_unit_value "$session_slice_dropin" MemoryMin >/dev/null
    source_unit_value systemd/system/user-1000.slice.d/oom-containment.conf MemoryHigh >/dev/null
    source_unit_value systemd/system/user-1000.slice.d/oom-containment.conf MemoryMax >/dev/null
    source_unit_value systemd/system/user-1000.slice.d/oom-containment.conf MemorySwapMax >/dev/null
    source_unit_value systemd/system/user-1000.slice.d/oom-containment.conf MemoryLow >/dev/null
    source_unit_value systemd/system/user-1000.slice.d/oom-containment.conf MemoryMin >/dev/null
    source_unit_value systemd/system/system.slice.d/oom-containment.conf MemoryHigh >/dev/null
    source_unit_value systemd/system/system.slice.d/oom-containment.conf MemoryMax >/dev/null
    source_unit_value systemd/system/system.slice.d/oom-containment.conf MemorySwapMax >/dev/null
    source_unit_value systemd/system/system.slice.d/oom-containment.conf MemoryLow >/dev/null
    source_unit_value systemd/system/system.slice.d/oom-containment.conf MemoryMin >/dev/null
    source_unit_value systemd/system/user.slice.d/oom-containment.conf MemoryHigh >/dev/null
    source_unit_value systemd/system/user.slice.d/oom-containment.conf MemoryMax >/dev/null
    source_unit_value systemd/system/user.slice.d/oom-containment.conf MemorySwapMax >/dev/null
    source_unit_value systemd/system/user.slice.d/oom-containment.conf MemoryLow >/dev/null
    source_unit_value systemd/system/user.slice.d/oom-containment.conf MemoryMin >/dev/null
    source_unit_value systemd/system/user@1000.service.d/oom.conf MemoryHigh >/dev/null
    source_unit_value systemd/system/user@1000.service.d/oom.conf MemoryMax >/dev/null
    source_unit_value systemd/system/user@1000.service.d/oom.conf MemorySwapMax >/dev/null
    source_unit_value systemd/system/user@1000.service.d/oom.conf MemoryLow >/dev/null
    source_unit_value systemd/system/user@1000.service.d/oom.conf MemoryMin >/dev/null
    grep -q -- "--ignore" "$(src_path "$earlyoom_source")" || {
        echo "earlyoom config missing --ignore recovery list; next action: restore config/earlyoom/default from the P0 PR" >&2
        return 1
    }
    if grep -Eq -- "--(prefer|avoid|ignore)[[:space:]]+'" "$(src_path "$earlyoom_source")"; then
        echo "earlyoom regex arguments must not carry literal single quotes; next action: remove inner quotes from config/earlyoom/default and rerun scripts/install-p0-oom-containment --check" >&2
        return 1
    fi
}

write_oom_score() {
    local pid score path
    pid="$1"
    score="$2"
    path="$PROC_ROOT/$pid/oom_score_adj"
    [ -e "$path" ] || return 0
    if [ "${HAPAX_OOM_FORCE_DIRECT_WRITE_FAIL:-0}" != "1" ] && { printf '%s\n' "$score" > "$path"; } 2>/dev/null; then
        return 0
    fi
    [ ! -e "$path" ] && return 0
    if [ -n "$SUDO" ] || [ "$(id -u)" = "0" ]; then
        printf '%s\n' "$score" | run_root tee "$path" >/dev/null || {
            [ ! -e "$path" ] && return 0
            return 1
        }
        return 0
    fi
    return 1
}

main_pid_for_unit() {
    local unit="$1" pid
    pid="$("$SYSTEMCTL" show "$unit" -p MainPID --value 2>/dev/null || true)"
    if [[ "$pid" =~ ^[0-9]+$ ]] && [ "$pid" -gt 0 ]; then
        printf '%s\n' "$pid"
    fi
    return 0
}

main_pid_for_user_unit() {
    local unit="$1" pid
    if ! pid="$(user_systemctl show "$unit" -p MainPID --value 2>/dev/null)"; then
        echo "unable to query user unit $unit MainPID; next action: inspect the UID $TARGET_UID user manager and rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
    if [[ "$pid" =~ ^[0-9]+$ ]] && [ "$pid" -gt 0 ]; then
        printf '%s\n' "$pid"
    elif [ -n "$pid" ] && [ "$pid" != "0" ]; then
        echo "invalid user unit $unit MainPID=$pid; next action: inspect systemctl --user show $unit -p MainPID and rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
    return 0
}

control_group_for_user_unit() {
    local unit="$1" cgroup
    if ! cgroup="$(user_systemctl show "$unit" -p ControlGroup --value 2>/dev/null)"; then
        echo "unable to query user unit $unit ControlGroup; next action: inspect the UID $TARGET_UID user manager and rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
    if [ -n "$cgroup" ] && [[ "$cgroup" != /* ]]; then
        echo "invalid user unit $unit ControlGroup=$cgroup; next action: inspect systemctl --user show $unit -p ControlGroup and rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
    printf '%s\n' "$cgroup"
}

cgroup_pids() {
    local cgroup="$1" dir procs
    [ -n "$cgroup" ] || return 0
    dir="$CGROUP_ROOT/${cgroup#/}"
    [ -d "$dir" ] || return 0
    find "$dir" -name cgroup.procs -type f -print 2>/dev/null |
        while IFS= read -r procs; do
            sed -n '/^[0-9][0-9]*$/p' "$procs" 2>/dev/null || true
        done | sort -u
}

declare -A protected_user_main_pid_snapshot=()
declare -A protected_user_cgroup_snapshot=()

refresh_protected_user_unit_snapshot() {
    local spec unit pid cgroup
    local -A next_main_pids=()
    local -A next_cgroups=()
    for spec in "${protected_user_unit_scores[@]}"; do
        unit="${spec%%:*}"
        pid="$(main_pid_for_user_unit "$unit")" || return 1
        cgroup="$(control_group_for_user_unit "$unit")" || return 1
        if [ -n "$pid" ] && [ -z "$cgroup" ]; then
            echo "user unit $unit has live MainPID=$pid but an empty ControlGroup; next action: inspect systemctl --user show $unit -p MainPID -p ControlGroup and rerun $OOM_REPAIR_ACTION" >&2
            return 1
        fi
        next_main_pids["$unit"]="$pid"
        next_cgroups["$unit"]="$cgroup"
    done
    protected_user_main_pid_snapshot=()
    protected_user_cgroup_snapshot=()
    for spec in "${protected_user_unit_scores[@]}"; do
        unit="${spec%%:*}"
        protected_user_main_pid_snapshot["$unit"]="${next_main_pids[$unit]}"
        protected_user_cgroup_snapshot["$unit"]="${next_cgroups[$unit]}"
    done
}

snapshotted_user_unit_pids() {
    local unit="$1" cgroup pid
    cgroup="${protected_user_cgroup_snapshot[$unit]:-}"
    pid="${protected_user_main_pid_snapshot[$unit]:-}"
    cgroup_pids "$cgroup"
    if [ -n "$pid" ] && pid_matches_cgroup "$pid" "$cgroup"; then
        printf '%s\n' "$pid"
    fi
    return 0
}

pid_matches_cgroup() {
    local pid="$1" cgroup="$2" proc_cgroup _hierarchy _controllers path
    proc_cgroup="$PROC_ROOT/$pid/cgroup"
    [ -n "$cgroup" ] || return 1
    [ -r "$proc_cgroup" ] || return 1
    while IFS=: read -r _hierarchy _controllers path; do
        if [ "$path" = "$cgroup" ] || [[ "$path" == "$cgroup/"* ]]; then
            return 0
        fi
    done < "$proc_cgroup"
    return 1
}

write_oom_score_or_warn() {
    local pid="$1" score="$2" label="$3"
    if write_oom_score "$pid" "$score"; then
        return 0
    fi
    echo "warning: failed to set oom_score_adj for $label pid=$pid; next action: run scripts/hapax-oom-policy-audit --json and rerun $OOM_REPAIR_ACTION" >&2
    return 0
}

apply_recovery_unit_oom_scores() {
    local spec unit score pid
    for spec in "${recovery_unit_scores[@]}"; do
        unit="${spec%%:*}"
        score="${spec##*:}"
        pid="$(main_pid_for_unit "$unit")"
        [ -n "$pid" ] || continue
        write_oom_score_or_warn "$pid" "$score" "$unit"
    done
}

apply_protected_user_unit_oom_scores() {
    local spec unit score pid cgroup output
    for spec in "${protected_user_unit_scores[@]}"; do
        unit="${spec%%:*}"
        score="${spec##*:}"
        cgroup="${protected_user_cgroup_snapshot[$unit]:-}"
        output="$(snapshotted_user_unit_pids "$unit")"
        while IFS= read -r pid; do
            [ -n "$pid" ] || continue
            pid_matches_cgroup "$pid" "$cgroup" || continue
            write_oom_score_or_warn "$pid" "$score" "$unit"
        done < <(printf '%s\n' "$output" | sort -u)
    done
}

allowed_user_protected_process() {
    case "$1" in
        pipewire|pipewire-pulse|wireplumber|dbus-broker|dbus-daemon|systemd)
            return 0
            ;;
    esac
    return 1
}

protected_user_unit_member_pid() {
    local candidate="$1" spec unit cgroup
    for spec in "${protected_user_unit_scores[@]}"; do
        unit="${spec%%:*}"
        cgroup="${protected_user_cgroup_snapshot[$unit]:-}"
        pid_matches_cgroup "$candidate" "$cgroup" && return 0
    done
    return 1
}

status_field() {
    local status="$1" key="$2"
    awk -v key="$key" '$1 == key ":" {print $2; exit}' "$status" 2>/dev/null || true
}

apply_user_process_oom_floor() {
    local adj pid_dir pid status uid name score fixed=0
    [ -d "$PROC_ROOT" ] || return 0
    for adj in "$PROC_ROOT"/[0-9]*/oom_score_adj; do
        [ -e "$adj" ] || continue
        pid_dir="$(dirname "$adj")"
        pid="$(basename "$pid_dir")"
        status="$pid_dir/status"
        [ -r "$status" ] || continue
        uid="$(status_field "$status" Uid)"
        [ "$uid" = "$TARGET_UID" ] || continue
        name="$(status_field "$status" Name)"
        score="$(cat "$adj" 2>/dev/null || true)"
        [[ "$score" =~ ^-?[0-9]+$ ]] || continue
        [ "$score" -le -800 ] || continue
        protected_user_unit_member_pid "$pid" && continue
        allowed_user_protected_process "$name" && continue
        if write_oom_score "$pid" 100; then
            fixed=$((fixed + 1))
        else
            echo "warning: failed to set oom_score_adj for user process name=$name pid=$pid; next action: run scripts/hapax-oom-policy-audit --json and rerun $OOM_REPAIR_ACTION" >&2
        fi
    done
    if [ "$fixed" -gt 0 ]; then
        echo "reset $fixed stale user process oom_score_adj values to 100"
    fi
}

scrub_legacy_user_oom_overrides() {
    local rel path temp
    for rel in "${legacy_user_oom_overrides[@]}"; do
        path="$SYSTEMD_USER_DIR/$rel"
        [ -e "$path" ] || continue
        if [ -L "$path" ]; then
            echo "refusing symlinked legacy user OOM override: $path; next action: replace it with a regular file and rerun $OOM_REPAIR_ACTION" >&2
            return 1
        fi
        grep -Eq '^[[:space:]]*OOMScoreAdjust=' "$path" || continue
        temp="$(mktemp "$path.tmp.XXXXXX")"
        if ! awk '!/^[[:space:]]*OOMScoreAdjust=/' "$path" > "$temp"; then
            rm -f "$temp"
            return 1
        fi
        chmod --reference="$path" "$temp"
        if [ "$(id -u)" = "0" ]; then
            chown --reference="$path" "$temp"
        fi
        mv -f "$temp" "$path"
        echo "removed stale user-manager-inapplicable OOMScoreAdjust from $path"
    done
}

install_live() {
    local rel source_rel dest timer user_pid mem_high mem_max mem_swap
    check_source
    preflight_root
    validate_no_unauthorized_host_policy_overrides 1
    for rel in "${system_dropins[@]}"; do
        source_rel="$(selected_source_rel "$rel")"
        dest="$(system_dest "$rel")"
        run_root install -d -m 0755 "$(dirname "$dest")"
        run_root install -m 0644 "$(src_path "$source_rel")" "$dest"
        echo "  '$source_rel' -> '$dest'"
    done
    for rel in "${system_units[@]}"; do
        dest="$(system_dest "$rel")"
        run_root install -d -m 0755 "$(dirname "$dest")"
        run_root install -m 0644 "$(src_path "$rel")" "$dest"
        echo "  '$rel' -> '$dest'"
    done
    for rel in "${system_units[@]}"; do
        dest="$SYSTEMD_USER_DIR/$(basename "$rel")"
        user_systemctl disable --now "$(basename "$rel")" >/dev/null 2>&1 || true
        if [ -e "$dest" ] || [ -L "$dest" ]; then
            rm -f "$dest"
            echo "  removed stale user-scope copy '$dest'"
        fi
    done
    run_root install -d -m 0755 "$(dirname "$OOM_ENFORCER_DEST")"
    run_root install -m 0755 "$(src_path "$oom_enforcer_source")" "$OOM_ENFORCER_DEST"
    echo "  '$oom_enforcer_source' -> '$OOM_ENFORCER_DEST'"
    run_root install -d -m 0755 "$(dirname "$OOM_TRIGGER_DEST")"
    run_root install -m 0755 "$(src_path "$oom_trigger_source")" "$OOM_TRIGGER_DEST"
    echo "  '$oom_trigger_source' -> '$OOM_TRIGGER_DEST'"
    run_root install -d -o "$OOM_SUDOERS_OWNER_UID" -g "$OOM_SUDOERS_OWNER_GID" -m 0755 "$(dirname "$OOM_SUDOERS_DEST")"
    if [ "$OOM_SUDOERS_REFERENCE_DEST" = "/usr/local/share/hapax/root-required/hapax-oom-score-enforce.sudoers" ]; then
        run_root install -d -o 0 -g 0 -m 0755 /usr/local/share/hapax
    fi
    run_root install -d -o "$OOM_SUDOERS_OWNER_UID" -g "$OOM_SUDOERS_OWNER_GID" -m 0755 "$(dirname "$OOM_SUDOERS_REFERENCE_DEST")"
    run_root install -o "$OOM_SUDOERS_OWNER_UID" -g "$OOM_SUDOERS_OWNER_GID" -m 0444 "$(src_path "$oom_sudoers_source")" "$OOM_SUDOERS_REFERENCE_DEST"
    echo "  '$oom_sudoers_source' -> '$OOM_SUDOERS_REFERENCE_DEST' (root-owned audit reference)"
    run_root install -o "$OOM_SUDOERS_OWNER_UID" -g "$OOM_SUDOERS_OWNER_GID" -m 0440 "$(src_path "$oom_sudoers_source")" "$OOM_SUDOERS_DEST"
    run_root "$VISUDO" -cf "$OOM_SUDOERS_DEST" >/dev/null || {
        echo "installed OOM enforcer sudoers policy is invalid: $OOM_SUDOERS_DEST; next action: restore it from the exact root-required package" >&2
        return 1
    }
    echo "  '$oom_sudoers_source' -> '$OOM_SUDOERS_DEST'"
    run_root install -d -m 0755 "$(dirname "$ROOT_FAILURE_INTAKE_DEST")"
    run_root install -m 0755 "$(src_path "$root_failure_intake_source")" "$ROOT_FAILURE_INTAKE_DEST"
    echo "  '$root_failure_intake_source' -> '$ROOT_FAILURE_INTAKE_DEST'"
    run_root install -d -m 0755 "$(dirname "$OOM_POLICY_AUDIT_DEST")"
    run_root install -m 0755 "$(src_path "$oom_policy_audit_source")" "$OOM_POLICY_AUDIT_DEST"
    echo "  '$oom_policy_audit_source' -> '$OOM_POLICY_AUDIT_DEST'"
    run_root install -d -m 0755 "$(dirname "$ROOT_REQUIRED_AUDIT_DEST")"
    run_root install -m 0755 "$(src_path "$root_required_audit_source")" "$ROOT_REQUIRED_AUDIT_DEST"
    echo "  '$root_required_audit_source' -> '$ROOT_REQUIRED_AUDIT_DEST'"
    install -d -m 0755 "$(dirname "$LOCAL_JUDGE_CONTAINER_ID_DEST")"
    [ ! -L "$LOCAL_JUDGE_CONTAINER_ID_DEST" ] || rm -f "$LOCAL_JUDGE_CONTAINER_ID_DEST"
    install -m 0755 "$(src_path scripts/hapax-local-judge-container-id)" \
        "$LOCAL_JUDGE_CONTAINER_ID_DEST"
    echo "  'scripts/hapax-local-judge-container-id' -> '$LOCAL_JUDGE_CONTAINER_ID_DEST'"
    run_root install -d -m 0755 "$(dirname "$OOM_PROFILE_TABLE_DEST")"
    run_root install -m 0644 "$(src_path "$host_profile_table_source")" "$OOM_PROFILE_TABLE_DEST"
    echo "  '$host_profile_table_source' -> '$OOM_PROFILE_TABLE_DEST'"
    source_rel="$(selected_zram_source_rel)"
    run_root install -d -m 0755 "$(dirname "$ZRAM_POLICY_DEST")"
    run_root install -m 0644 "$(src_path "$source_rel")" "$ZRAM_POLICY_DEST"
    echo "  '$source_rel' -> '$ZRAM_POLICY_DEST'"
    run_root install -d -m 0755 "$(dirname "$EARLYOOM_DEST")"
    run_root install -m 0644 "$(src_path "$earlyoom_source")" "$EARLYOOM_DEST"
    echo "  '$earlyoom_source' -> '$EARLYOOM_DEST'"

    for rel in "${user_slice_dropins[@]}"; do
        source_rel="$(selected_source_rel "$rel")"
        dest="$SYSTEMD_USER_DIR/${rel#systemd/units/}"
        install -d -m 0755 "$(dirname "$dest")"
        if [ -L "$dest" ]; then
            rm -f "$dest"
        fi
        install -m 0644 "$(src_path "$source_rel")" "$dest"
        echo "  '$source_rel' -> '$dest' (copy)"
    done

    run_root rm -f \
        "$SYSTEMD_SYSTEM_DIR/user-1000.slice.d/zz-hapax-host-memory.conf" \
        "$SYSTEMD_SYSTEM_DIR/user@1000.service.d/zz-hapax-host-memory.conf"
    rm -f "$SYSTEMD_USER_DIR/app.slice.d/zz-hapax-host-memory.conf"
    run_root rm -f "$LEGACY_ZRAM_POLICY_DEST"
    scrub_generated_memory_property_files
    validate_no_unauthorized_host_policy_overrides 0

    for rel in "${user_protection_dropins[@]}"; do
        dest="$SYSTEMD_USER_DIR/${rel#systemd/units/}"
        install -d -m 0755 "$(dirname "$dest")"
        install -m 0644 "$(src_path "$rel")" "$dest"
        echo "  '$rel' -> '$dest' (copy)"
    done

    scrub_legacy_user_oom_overrides

    for rel in "${managed_user_units[@]}"; do
        dest="$SYSTEMD_USER_DIR/${rel#systemd/units/}"
        install -d -m 0755 "$(dirname "$dest")"
        [ ! -L "$dest" ] || rm -f "$dest"
        install -m 0644 "$(src_path "$rel")" "$dest"
        echo "  '$rel' -> '$dest' (copy)"
    done

    run_root "$SYSTEMCTL" daemon-reload
    run_root "$SYSTEMCTL" enable --now hapax-oom-score-enforce.timer >/dev/null 2>&1 || {
        echo "unable to enable hapax-oom-score-enforce.timer; next action: run sudo systemctl enable --now hapax-oom-score-enforce.timer" >&2
        return 1
    }
    run_root "$SYSTEMCTL" enable --now earlyoom.service >/dev/null 2>&1 || {
        echo "unable to enable earlyoom.service; next action: run sudo systemctl enable --now earlyoom.service" >&2
        return 1
    }
    run_root "$SYSTEMCTL" restart earlyoom.service || {
        echo "unable to restart earlyoom.service with the installed policy; next action: run sudo systemctl restart earlyoom.service and inspect journalctl -u earlyoom.service" >&2
        return 1
    }
    user_systemctl daemon-reload
    for timer in "${user_audit_timers[@]}"; do
        user_systemctl enable --now "$timer" >/dev/null 2>&1 || {
            echo "unable to enable $timer for UID $TARGET_UID; next action: run systemctl --user enable --now $timer as $TARGET_USER" >&2
            return 1
        }
    done
    if [ "$APPLY_RUNTIME" -eq 1 ]; then
        apply_system_runtime_memory system.slice systemd/system/system.slice.d/oom-containment.conf
        apply_system_runtime_memory user.slice systemd/system/user.slice.d/oom-containment.conf
        apply_system_runtime_memory user-1000.slice systemd/system/user-1000.slice.d/oom-containment.conf
        apply_system_runtime_memory user@1000.service systemd/system/user@1000.service.d/oom.conf
        mem_high="$(app_slice_value MemoryHigh)"
        mem_max="$(app_slice_value MemoryMax)"
        mem_swap="$(app_slice_value MemorySwapMax)"
        user_systemctl set-property --runtime app.slice \
            "MemoryHigh=$mem_high" \
            "MemoryMax=$mem_max" \
            "MemorySwapMax=$mem_swap" \
            "MemoryLow=$(app_slice_value MemoryLow)" \
            "MemoryMin=$(app_slice_value MemoryMin)"
        user_systemctl set-property --runtime session.slice \
            "MemoryHigh=$(source_unit_value "$session_slice_dropin" MemoryHigh)" \
            "MemoryMax=$(source_unit_value "$session_slice_dropin" MemoryMax)" \
            "MemorySwapMax=$(source_unit_value "$session_slice_dropin" MemorySwapMax)" \
            "MemoryLow=$(source_unit_value "$session_slice_dropin" MemoryLow)" \
            "MemoryMin=$(source_unit_value "$session_slice_dropin" MemoryMin)"
        scrub_generated_memory_property_files
        validate_no_unauthorized_host_policy_overrides 0
        run_root "$SYSTEMCTL" daemon-reload || {
            echo "unable to reload the system manager after scrubbing transient OOM controls; next action: rerun $OOM_REPAIR_ACTION" >&2
            return 1
        }
        user_systemctl daemon-reload || {
            echo "unable to reload the user manager after scrubbing transient OOM controls; next action: rerun $OOM_REPAIR_ACTION" >&2
            return 1
        }
        apply_recovery_unit_oom_scores
        refresh_protected_user_unit_snapshot
        apply_protected_user_unit_oom_scores
        user_pid="$("$SYSTEMCTL" show user@1000.service -p MainPID --value 2>/dev/null || true)"
        if [[ "$user_pid" =~ ^[0-9]+$ ]] && [ "$user_pid" -gt 0 ]; then
            write_oom_score_or_warn "$user_pid" 100 "user@1000.service"
        fi
        apply_user_process_oom_floor
        reconcile_docker_memory_limits
    fi
}

apply_system_runtime_memory() {
    local unit="$1" rel="$2"
    run_root "$SYSTEMCTL" set-property --runtime "$unit" \
        "MemoryHigh=$(system_memory_value "$rel" MemoryHigh)" \
        "MemoryMax=$(system_memory_value "$rel" MemoryMax)" \
        "MemorySwapMax=$(system_memory_value "$rel" MemorySwapMax)" \
        "MemoryLow=$(system_memory_value "$rel" MemoryLow)" \
        "MemoryMin=$(system_memory_value "$rel" MemoryMin)" || {
        echo "unable to apply runtime memory policy to $unit; next action: run $OOM_REPAIR_ACTION" >&2
        return 1
    }
}

verify_pair() {
    local source="$1" dest="$2"
    [ -f "$dest" ] || {
        echo "missing live file: $dest; next action: run $OOM_REPAIR_ACTION" >&2
        return 1
    }
    cmp -s "$source" "$dest" || {
        echo "live drift: $dest differs from $source; next action: run $OOM_REPAIR_ACTION" >&2
        return 1
    }
}

verify_root_pair() {
    local source="$1" dest="$2"
    run_root test -f "$dest" || {
        echo "missing live file: $dest; next action: run $OOM_REPAIR_ACTION" >&2
        return 1
    }
    run_root cmp -s "$source" "$dest" || {
        echo "live drift: $dest differs from $source; next action: run $OOM_REPAIR_ACTION" >&2
        return 1
    }
}

verify_sudoers_trust() {
    local path="$1" expected_mode="$2" label="$3" actual
    if [ ! -f "$path" ] || [ -L "$path" ]; then
        echo "installed OOM $label is missing, symlinked, or not a regular file: $path; next action: rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
    actual="$(stat -c '%u:%g:%a' "$path" 2>/dev/null || true)"
    if [ "$actual" != "$OOM_SUDOERS_OWNER_UID:$OOM_SUDOERS_OWNER_GID:$expected_mode" ]; then
        echo "installed OOM $label trust drift: $path owner/mode=${actual:-unavailable} expected=$OOM_SUDOERS_OWNER_UID:$OOM_SUDOERS_OWNER_GID:$expected_mode; next action: rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
}

verify_production_reference_dirs() {
    local path actual
    for path in /usr/local/share/hapax /usr/local/share/hapax/root-required; do
        if [ ! -d "$path" ] || [ -L "$path" ]; then
            echo "installed OOM sudoers reference directory is missing, symlinked, or not a directory: $path; next action: rerun $OOM_REPAIR_ACTION" >&2
            return 1
        fi
        actual="$(stat -c '%u:%g:%a' "$path" 2>/dev/null || true)"
        if [ "$actual" != "0:0:755" ]; then
            echo "installed OOM sudoers reference directory trust drift: $path owner/mode=${actual:-unavailable} expected=0:0:755; next action: rerun $OOM_REPAIR_ACTION" >&2
            return 1
        fi
    done
}

verify_root_artifact_trust() {
    local path="$1" expected_mode="$2" expected_uid expected_gid actual parent parent_actual parent_mode
    case "$path" in
        /etc/*|/usr/local/*)
            expected_uid=0
            expected_gid=0
            ;;
        *)
            expected_uid="$(/usr/bin/id -u)"
            expected_gid="$(/usr/bin/id -g)"
            ;;
    esac
    if [ ! -f "$path" ] || [ -L "$path" ]; then
        echo "installed root artifact is missing, symlinked, or not a regular file: $path; next action: rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
    actual="$(stat -c '%u:%g:%a' "$path" 2>/dev/null || true)"
    if [ "$actual" != "$expected_uid:$expected_gid:$expected_mode" ]; then
        echo "installed root artifact trust drift: $path owner/mode=${actual:-unavailable} expected=$expected_uid:$expected_gid:$expected_mode; next action: rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
    parent="$(dirname "$path")"
    parent_actual="$(stat -c '%u:%g' "$parent" 2>/dev/null || true)"
    parent_mode="$(stat -c '%a' "$parent" 2>/dev/null || true)"
    if [ ! -d "$parent" ] || [ -L "$parent" ] \
        || [ "$parent_actual" != "$expected_uid:$expected_gid" ] \
        || ! [[ "$parent_mode" =~ ^[0-7]+$ ]] \
        || (( (8#$parent_mode & 8#022) != 0 )); then
        echo "installed root artifact parent trust drift: $parent owner/mode=${parent_actual:-unavailable}:${parent_mode:-unavailable}; next action: repair the root-owned directory and rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
}

verify_selected_host_policy_files() {
    local source_rel actual_zram expected_zram legacy
    verify_root_pair "$(src_path "$host_profile_table_source")" "$OOM_PROFILE_TABLE_DEST"
    verify_root_artifact_trust "$OOM_PROFILE_TABLE_DEST" 644
    source_rel="$(selected_zram_source_rel)"
    verify_root_pair "$(src_path "$source_rel")" "$ZRAM_POLICY_DEST"
    verify_root_artifact_trust "$ZRAM_POLICY_DEST" 644
    for legacy in \
        "$SYSTEMD_SYSTEM_DIR/user-1000.slice.d/zz-hapax-host-memory.conf" \
        "$SYSTEMD_SYSTEM_DIR/user@1000.service.d/zz-hapax-host-memory.conf" \
        "$LEGACY_ZRAM_POLICY_DEST"; do
        if run_root test -e "$legacy" || run_root test -L "$legacy"; then
            echo "legacy OOM host-policy override remains authoritative: $legacy; next action: rerun $OOM_REPAIR_ACTION" >&2
            return 1
        fi
    done
    legacy="$SYSTEMD_USER_DIR/app.slice.d/zz-hapax-host-memory.conf"
    if [ -e "$legacy" ] || [ -L "$legacy" ]; then
        echo "legacy OOM host-policy override remains authoritative: $legacy; next action: rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
    expected_zram=$((HOST_ZRAM_SIZE_MIB * 1024 * 1024))
    actual_zram="$(cat "$ZRAM_DISKSIZE_PATH" 2>/dev/null || true)"
    if [ "$actual_zram" != "$expected_zram" ]; then
        echo "live zram size drift: actual=${actual_zram:-unavailable} expected=$expected_zram for $HOST_PROFILE; next action: apply the installed zram policy through a separately authorized reboot or safe zram recreation, then rerun --verify-live" >&2
        return 1
    fi
    validate_no_unauthorized_host_policy_overrides 0
    verify_loaded_memory_dropin_ownership
}

verify_live() {
    local rel source_rel dest timer
    for rel in "${system_dropins[@]}"; do
        source_rel="$(selected_source_rel "$rel")"
        dest="$(system_dest "$rel")"
        verify_pair "$(src_path "$source_rel")" "$dest"
        verify_root_artifact_trust "$dest" 644
    done
    for rel in "${system_units[@]}"; do
        dest="$(system_dest "$rel")"
        verify_pair "$(src_path "$rel")" "$dest"
        verify_root_artifact_trust "$dest" 644
        dest="$SYSTEMD_USER_DIR/$(basename "$rel")"
        if [ -e "$dest" ] || [ -L "$dest" ]; then
            echo "stale user-scope copy of system unit remains: $dest; next action: rerun $OOM_REPAIR_ACTION" >&2
            return 1
        fi
    done
    verify_pair "$(src_path "$oom_enforcer_source")" "$OOM_ENFORCER_DEST"
    verify_root_artifact_trust "$OOM_ENFORCER_DEST" 755
    verify_pair "$(src_path "$oom_trigger_source")" "$OOM_TRIGGER_DEST"
    verify_root_artifact_trust "$OOM_TRIGGER_DEST" 755
    [ -x "$OOM_TRIGGER_DEST" ] || {
        echo "installed OOM startup trigger is not executable: $OOM_TRIGGER_DEST; next action: rerun $OOM_REPAIR_ACTION" >&2
        return 1
    }
    verify_sudoers_trust "$OOM_SUDOERS_DEST" 440 "sudoers policy"
    verify_sudoers_trust "$OOM_SUDOERS_REFERENCE_DEST" 444 "sudoers audit reference"
    verify_root_artifact_trust "$OOM_SUDOERS_DEST" 440
    verify_root_artifact_trust "$OOM_SUDOERS_REFERENCE_DEST" 444
    if [ "$OOM_SUDOERS_REFERENCE_DEST" = "/usr/local/share/hapax/root-required/hapax-oom-score-enforce.sudoers" ]; then
        verify_production_reference_dirs
    fi
    verify_pair "$(src_path "$oom_sudoers_source")" "$OOM_SUDOERS_REFERENCE_DEST"
    verify_root_pair "$OOM_SUDOERS_REFERENCE_DEST" "$OOM_SUDOERS_DEST"
    run_root "$VISUDO" -cf "$OOM_SUDOERS_DEST" >/dev/null || {
        echo "installed OOM enforcer sudoers policy no longer parses: $OOM_SUDOERS_DEST; next action: rerun $OOM_REPAIR_ACTION" >&2
        return 1
    }
    verify_pair "$(src_path "$root_failure_intake_source")" "$ROOT_FAILURE_INTAKE_DEST"
    verify_root_artifact_trust "$ROOT_FAILURE_INTAKE_DEST" 755
    verify_pair "$(src_path "$oom_policy_audit_source")" "$OOM_POLICY_AUDIT_DEST"
    verify_root_artifact_trust "$OOM_POLICY_AUDIT_DEST" 755
    verify_pair "$(src_path "$root_required_audit_source")" "$ROOT_REQUIRED_AUDIT_DEST"
    verify_root_artifact_trust "$ROOT_REQUIRED_AUDIT_DEST" 755
    if [ -L "$LOCAL_JUDGE_CONTAINER_ID_DEST" ]; then
        echo "live local-judge lifecycle helper is a symlink: $LOCAL_JUDGE_CONTAINER_ID_DEST; next action: rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
    verify_pair "$(src_path scripts/hapax-local-judge-container-id)" \
        "$LOCAL_JUDGE_CONTAINER_ID_DEST"
    [ -x "$LOCAL_JUDGE_CONTAINER_ID_DEST" ] || {
        echo "live local-judge lifecycle helper is not executable: $LOCAL_JUDGE_CONTAINER_ID_DEST; next action: rerun $OOM_REPAIR_ACTION" >&2
        return 1
    }
    verify_selected_host_policy_files
    verify_pair "$(src_path "$earlyoom_source")" "$EARLYOOM_DEST"
    verify_root_artifact_trust "$EARLYOOM_DEST" 644
    run_root "$SYSTEMCTL" is-enabled --quiet earlyoom.service || {
        echo "earlyoom.service is not enabled; next action: run sudo systemctl enable --now earlyoom.service" >&2
        return 1
    }
    run_root "$SYSTEMCTL" is-active --quiet earlyoom.service || {
        echo "earlyoom.service is not active; next action: run sudo systemctl enable --now earlyoom.service and inspect journalctl -u earlyoom.service" >&2
        return 1
    }
    for rel in "${user_slice_dropins[@]}"; do
        source_rel="$(selected_source_rel "$rel")"
        dest="$SYSTEMD_USER_DIR/${rel#systemd/units/}"
        if [ -L "$dest" ]; then
            echo "live P0 slice drop-in is a symlink: $dest; next action: run $OOM_REPAIR_ACTION to replace it with a copy" >&2
            return 1
        fi
        verify_pair "$(src_path "$source_rel")" "$dest"
    done
    for rel in "${user_protection_dropins[@]}"; do
        verify_pair "$(src_path "$rel")" "$SYSTEMD_USER_DIR/${rel#systemd/units/}"
    done
    for rel in "${managed_user_units[@]}"; do
        dest="$SYSTEMD_USER_DIR/${rel#systemd/units/}"
        if [ -L "$dest" ]; then
            echo "live P0 managed user unit is a symlink: $dest; next action: run $OOM_REPAIR_ACTION" >&2
            return 1
        fi
        verify_pair "$(src_path "$rel")" "$dest"
    done
    for timer in "${user_audit_timers[@]}"; do
        user_systemctl is-enabled --quiet "$timer" || {
            echo "$timer is not enabled for UID $TARGET_UID; next action: run systemctl --user enable --now $timer as $TARGET_USER" >&2
            return 1
        }
        user_systemctl is-active --quiet "$timer" || {
            echo "$timer is not active for UID $TARGET_UID; next action: run systemctl --user enable --now $timer as $TARGET_USER" >&2
            return 1
        }
    done
    verify_user_audit_loaded_timeouts
    verify_enforcer_loaded_timeout
    verify_effective_safety_units || return 1
    verify_user_manager_oom_score
    verify_system_unit_runtime_memory system.slice systemd/system/system.slice.d/oom-containment.conf
    verify_system_unit_runtime_memory user.slice systemd/system/user.slice.d/oom-containment.conf
    verify_system_unit_runtime_memory user-1000.slice systemd/system/user-1000.slice.d/oom-containment.conf
    verify_system_unit_runtime_memory user@1000.service systemd/system/user@1000.service.d/oom.conf
    verify_app_slice_runtime
    verify_session_slice_runtime
    verify_recovery_unit_oom_scores
    refresh_protected_user_unit_snapshot
    verify_protected_user_unit_oom_scores
    verify_user_process_oom_floor
    verify_docker_memory_limits
}

verify_user_audit_loaded_timeouts() {
    local spec rel unit expected actual expected_environment loaded_environment
    for spec in \
        "hapax-oom-policy-audit.service|systemd/units/hapax-oom-policy-audit.service" \
        "hapax-root-required-deploy-audit.service|systemd/units/hapax-root-required-deploy-audit.service"; do
        unit="${spec%%|*}"
        rel="${spec#*|}"
        expected="$(source_unit_value "$rel" TimeoutStartSec)" || return 1
        if ! actual="$(user_systemctl show "$unit" -p TimeoutStartUSec --value 2>/dev/null)"; then
            echo "unable to query loaded $unit TimeoutStartUSec; next action: inspect systemctl --user status $unit and rerun $OOM_REPAIR_ACTION" >&2
            return 1
        fi
        if [ "$actual" != "$expected" ]; then
            echo "live $unit TimeoutStartUSec drift: actual=${actual:-unavailable} expected=$expected; next action: run systemctl --user daemon-reload and $OOM_REPAIR_ACTION" >&2
            return 1
        fi
        expected_environment="$(source_unit_value "$rel" Environment)" || return 1
        if ! loaded_environment="$(user_systemctl show "$unit" -p Environment --value 2>/dev/null)"; then
            echo "unable to query loaded $unit Environment; next action: inspect systemctl --user status $unit and rerun $OOM_REPAIR_ACTION" >&2
            return 1
        fi
        case " $loaded_environment " in
            *" $expected_environment "*) ;;
            *)
                echo "live $unit Environment drift: actual=${loaded_environment:-unavailable} expected to contain $expected_environment; next action: run systemctl --user daemon-reload and $OOM_REPAIR_ACTION" >&2
                return 1
                ;;
        esac
    done
}

verify_enforcer_loaded_timeout() {
    local expected actual
    expected="$(source_unit_value systemd/units/hapax-oom-score-enforce.service TimeoutStartSec)"
    if ! actual="$("$SYSTEMCTL" show hapax-oom-score-enforce.service -p TimeoutStartUSec --value 2>/dev/null)"; then
        echo "unable to query loaded hapax-oom-score-enforce.service TimeoutStartUSec; next action: inspect systemctl status hapax-oom-score-enforce.service and rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
    if [ "$actual" != "$expected" ]; then
        echo "live hapax-oom-score-enforce.service TimeoutStartUSec drift: actual=${actual:-unavailable} expected=$expected; next action: run sudo systemctl daemon-reload and $OOM_REPAIR_ACTION" >&2
        return 1
    fi
}

verify_system_unit_runtime_memory() {
    local unit="$1" rel="$2" key expected_raw expected_bytes actual failed=0
    for key in MemoryHigh MemoryMax MemorySwapMax MemoryLow MemoryMin; do
        expected_raw="$(system_memory_value "$rel" "$key")"
        expected_bytes="$(memory_to_bytes "$expected_raw")" || {
            echo "cannot parse $unit $key=$expected_raw from $rel; next action: fix the source drop-in and rerun scripts/install-p0-oom-containment --check" >&2
            return 1
        }
        actual="$("$SYSTEMCTL" show "$unit" -p "$key" --value 2>/dev/null || true)"
        if [ "$actual" != "$expected_raw" ] && [ "$actual" != "$expected_bytes" ]; then
            echo "live $unit $key drift: actual=$actual expected=$expected_raw; next action: run $OOM_REPAIR_ACTION" >&2
            failed=1
        fi
    done
    [ "$failed" -eq 0 ]
}

verify_app_slice_runtime() {
    local key expected_raw expected_bytes actual failed=0
    for key in MemoryHigh MemoryMax MemorySwapMax MemoryLow MemoryMin; do
        expected_raw="$(app_slice_value "$key")"
        expected_bytes="$(memory_to_bytes "$expected_raw")" || {
            echo "cannot parse app.slice $key=$expected_raw from $user_dropin; next action: fix the source drop-in and rerun scripts/install-p0-oom-containment --check" >&2
            return 1
        }
        actual="$(user_systemctl show app.slice -p "$key" --value 2>/dev/null || true)"
        if [ "$actual" != "$expected_raw" ] && [ "$actual" != "$expected_bytes" ]; then
            echo "live app.slice $key drift: actual=$actual expected=$expected_raw; next action: run $OOM_REPAIR_ACTION" >&2
            failed=1
        fi
    done
    [ "$failed" -eq 0 ]
}

verify_session_slice_runtime() {
    local key expected_raw expected_bytes actual failed=0
    for key in MemoryHigh MemoryMax MemorySwapMax MemoryLow MemoryMin; do
        expected_raw="$(source_unit_value "$session_slice_dropin" "$key")"
        expected_bytes="$(memory_to_bytes "$expected_raw")" || {
            echo "cannot parse session.slice $key=$expected_raw from $session_slice_dropin; next action: fix the source drop-in and rerun scripts/install-p0-oom-containment --check" >&2
            return 1
        }
        actual="$(user_systemctl show session.slice -p "$key" --value 2>/dev/null || true)"
        if [ "$actual" != "$expected_raw" ] && [ "$actual" != "$expected_bytes" ]; then
            echo "live session.slice $key drift: actual=$actual expected=$expected_raw; next action: run $OOM_REPAIR_ACTION" >&2
            failed=1
        fi
    done
    [ "$failed" -eq 0 ]
}

verify_recovery_unit_oom_scores() {
    local spec unit score pid actual configured policy failed=0
    for spec in "${recovery_unit_scores[@]}"; do
        unit="${spec%%:*}"
        score="${spec##*:}"
        configured="$("$SYSTEMCTL" show "$unit" -p OOMScoreAdjust --value 2>/dev/null || true)"
        if [ "$configured" != "$score" ]; then
            echo "effective OOM policy drift for $unit: configured=$configured expected=$score; next action: remove higher-priority drop-in drift and rerun $OOM_REPAIR_ACTION" >&2
            failed=1
        fi
        if [ "$unit" = "sshd.service" ]; then
            policy="$("$SYSTEMCTL" show "$unit" -p OOMPolicy --value 2>/dev/null || true)"
            if [ "$policy" != "continue" ]; then
                echo "effective OOM policy drift for sshd.service: OOMPolicy=$policy expected=continue; next action: remove higher-priority drop-in drift and rerun $OOM_REPAIR_ACTION" >&2
                failed=1
            fi
        fi
        pid="$(main_pid_for_unit "$unit")"
        if [ -z "$pid" ]; then
            echo "recovery daemon has no live MainPID: $unit; next action: inspect systemctl status $unit and rerun $OOM_REPAIR_ACTION" >&2
            failed=1
            continue
        fi
        actual="$(cat "$PROC_ROOT/$pid/oom_score_adj" 2>/dev/null || true)"
        if [ "$actual" != "$score" ]; then
            echo "live OOM score drift for $unit pid $pid: actual=$actual expected=$score; next action: run $OOM_REPAIR_ACTION" >&2
            failed=1
        fi
    done
    [ "$failed" -eq 0 ]
}

verify_user_manager_oom_score() {
    local pid actual policy configured
    configured="$("$SYSTEMCTL" show user@1000.service -p OOMScoreAdjust --value 2>/dev/null || true)"
    if [ "$configured" != "100" ]; then
        echo "effective user@1000.service OOMScoreAdjust drift: actual=$configured expected=100; next action: remove higher-priority drop-in drift and rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
    policy="$("$SYSTEMCTL" show user@1000.service -p OOMPolicy --value 2>/dev/null || true)"
    if [ "$policy" != "continue" ]; then
        echo "effective user@1000.service OOMPolicy drift: actual=$policy expected=continue; next action: remove higher-priority drop-in drift and rerun $OOM_REPAIR_ACTION" >&2
        return 1
    fi
    pid="$("$SYSTEMCTL" show user@1000.service -p MainPID --value 2>/dev/null || true)"
    if ! [[ "$pid" =~ ^[0-9]+$ ]] || [ "$pid" -le 0 ]; then
        echo "unable to read live user@1000.service MainPID; next action: run $OOM_REPAIR_ACTION" >&2
        return 1
    fi
    actual="$(cat "$PROC_ROOT/$pid/oom_score_adj" 2>/dev/null || true)"
    if [ "$actual" != "100" ]; then
        echo "live user@1000.service OOM score drift: pid=$pid actual=$actual expected=100; next action: run $OOM_REPAIR_ACTION" >&2
        return 1
    fi
}

verify_protected_user_unit_oom_scores() {
    local spec unit score pid actual configured rel expected_slice key expected_raw expected_bytes cgroup failed=0
    local verified=0 skipped=0
    for spec in "${protected_user_unit_scores[@]}"; do
        unit="${spec%%:*}"
        score="${spec##*:}"
        cgroup="${protected_user_cgroup_snapshot[$unit]:-}"
        # HOST FIT: a unit that does not exist on this host has no live properties to verify.
        # systemctl STILL answers `show` for an unknown unit, with DEFAULTS -- OOMScoreAdjust=200,
        # Slice=, MemoryLow=0, MemoryMin=0 -- every one of which this loop then reads as drift and
        # hard-fails on. Absent is not drifted; it is UNEVALUABLE, and conflating the two is what
        # bricked source activation on hapax-appendix for three weeks: hapax-daimonion /
        # studio-compositor / hapax-imagination are LoadState=not-found on appendix, so every run
        # failed verify, exited 1, rolled the deploy back, and repeated every two minutes -- 2176
        # incident events before containment stopped it.
        #
        # But UNEVALUABLE-AND-EXPECTED and UNEVALUABLE-AND-ALARMING are different states, and only
        # the first may be skipped. Skipping both is how --verify-live comes to PASS WITHOUT
        # VERIFYING ANYTHING: a required unit vanishing from a host it belongs on would report
        # success. The skip is therefore allow-listed to host_optional_user_units; every other
        # protected unit is required wherever this package installs, and its absence fails closed.
        if [ "$(user_systemctl show "$unit" -p LoadState --value 2>/dev/null || true)" = "not-found" ]; then
            # Allow-list membership is necessary but NOT sufficient. It says the unit may be absent
            # on SOME host; only the unit file says whether THIS host is one of them. Checked first,
            # so an allow-listed unit that is installed here but unloadable can never reach the skip.
            if user_unit_file_present "$unit"; then
                echo "protected user unit $unit reports LoadState=not-found but a unit file for it EXISTS on this host: the package IS installed here and the user manager cannot load it, so this is a load failure, not host-absence, and skipping it would report success having verified nothing; next action: run 'systemctl --user status $unit' and 'systemd-analyze --user verify $unit' to find the masked/dangling/malformed unit, then rerun $OOM_REPAIR_ACTION" >&2
                failed=1
                continue
            fi
            if is_host_optional_user_unit "$unit"; then
                # The skip rests on having proven absence, which a reconstructed search path
                # cannot do. Fail closed rather than skip on a list that may not be complete.
                if ! user_unit_search_paths_are_authoritative; then
                    echo "protected user unit $unit is not loaded and no unit file was found, but the user unit search path could NOT be obtained from systemd ('$SYSTEMD_ANALYZE --user unit-paths' failed), so the list searched is a RECONSTRUCTION and may omit a directory this system uses; absence is therefore unproven and skipping it would be a false green; next action: restore '$SYSTEMD_ANALYZE --user unit-paths' for the target user, then rerun $OOM_REPAIR_ACTION" >&2
                    failed=1
                    continue
                fi
                skipped=$((skipped + 1))
                echo "p0-oom: skipping $unit — host-optional protected unit, no unit file on this host (LoadState=not-found); nothing to verify" >&2
                continue
            fi
            echo "required protected user unit $unit is absent on this host (LoadState=not-found): --verify-live cannot confirm OOM policy for a unit that is not loaded, and treating it as verified would be a false green; next action: install/enable $unit on this host, or if it is legitimately host-optional add it to host_optional_user_units in scripts/install-p0-oom-containment with the measurement that justifies it" >&2
            failed=1
            continue
        fi
        configured="$(user_systemctl show "$unit" -p OOMScoreAdjust --value 2>/dev/null || true)"
        if [ "$configured" != "100" ]; then
            echo "user unit startup OOM policy drift for $unit: configured=$configured expected=100; the user manager cannot lower a child score, so root must apply live score $score after start; next action: run $OOM_REPAIR_ACTION" >&2
            failed=1
        fi
        case "$unit" in
            pipewire.service|pipewire-pulse.service|wireplumber.service)
                expected_slice=session.slice
                actual="$(user_systemctl show "$unit" -p NoNewPrivileges --value 2>/dev/null || true)"
                if [ "$actual" != "yes" ]; then
                    echo "live user unit NoNewPrivileges drift for $unit: actual=$actual expected=yes; next action: restore the distro audio sandbox and rerun $OOM_REPAIR_ACTION" >&2
                    failed=1
                fi
                ;;
            *) expected_slice=app.slice ;;
        esac
        actual="$(user_systemctl show "$unit" -p Slice --value 2>/dev/null || true)"
        if [ "$actual" != "$expected_slice" ]; then
            echo "live user unit Slice drift for $unit: actual=$actual expected=$expected_slice; next action: remove higher-priority user-unit drop-in drift and rerun $OOM_REPAIR_ACTION" >&2
            failed=1
        fi
        rel="systemd/units/$unit.d/oom-protect.conf"
        for key in MemoryLow MemoryMin; do
            expected_raw="$(source_unit_value "$rel" "$key")"
            expected_bytes="$(memory_to_bytes "$expected_raw")" || {
                echo "cannot parse protected user unit $unit $key=$expected_raw from $rel; next action: fix the source drop-in and rerun scripts/install-p0-oom-containment --check" >&2
                return 1
            }
            actual="$(user_systemctl show "$unit" -p "$key" --value 2>/dev/null || true)"
            if [ "$actual" != "$expected_raw" ] && [ "$actual" != "$expected_bytes" ]; then
                echo "live user unit $key drift for $unit: actual=$actual expected=$expected_raw; next action: remove higher-priority user-unit drop-in drift and rerun $OOM_REPAIR_ACTION" >&2
                failed=1
            fi
        done
        while IFS= read -r pid; do
            [ -n "$pid" ] || continue
            if ! pid_matches_cgroup "$pid" "$cgroup"; then
                echo "live user unit cgroup changed before OOM score readback for $unit pid $pid; next action: rerun $OOM_REPAIR_ACTION after unit churn settles" >&2
                failed=1
                continue
            fi
            actual="$(cat "$PROC_ROOT/$pid/oom_score_adj" 2>/dev/null || true)"
            if [ "$actual" != "$score" ]; then
                echo "live user unit OOM score drift for $unit pid $pid: actual=$actual expected=$score; next action: run $OOM_REPAIR_ACTION" >&2
                failed=1
            fi
        done < <(snapshotted_user_unit_pids "$unit")
        verified=$((verified + 1))
    done
    # VACUOUS-PASS GUARD. Every check above is universally quantified over the units that survived
    # the skip, and a universally quantified check over an EMPTY set is true. So a --verify-live that
    # examined nothing returns exactly what a --verify-live that examined everything returns, and the
    # two are indistinguishable from the exit code -- which is the failure mode this package was
    # written to stop, reappearing one level up in the package's own verifier.
    #
    # The allow-list is the mechanism that could empty the set: it is edited by hand, under pressure,
    # by whoever is trying to get a host to deploy. Nothing structurally prevents it from growing
    # until it covers every protected unit, at which point verify-live passes on every host forever.
    # This makes that state loud instead of green.
    if [ "$verified" -eq 0 ]; then
        echo "--verify-live examined 0 of ${#protected_user_unit_scores[@]} protected user units ($skipped skipped as host-optional): a verification that evaluates nothing PASSES VACUOUSLY and cannot be told apart from one that actually verified the policy; next action: confirm this host is meant to run none of the protected units, and if so stop running --verify-live here, otherwise install the units or shrink host_optional_user_units in scripts/install-p0-oom-containment" >&2
        failed=1
    fi
    [ "$failed" -eq 0 ]
}

verify_user_process_oom_floor() {
    local adj pid_dir pid status uid name score failed=0
    [ -d "$PROC_ROOT" ] || return 0
    for adj in "$PROC_ROOT"/[0-9]*/oom_score_adj; do
        [ -e "$adj" ] || continue
        pid_dir="$(dirname "$adj")"
        pid="$(basename "$pid_dir")"
        status="$pid_dir/status"
        [ -r "$status" ] || continue
        uid="$(status_field "$status" Uid)"
        [ "$uid" = "$TARGET_UID" ] || continue
        name="$(status_field "$status" Name)"
        score="$(cat "$adj" 2>/dev/null || true)"
        [[ "$score" =~ ^-?[0-9]+$ ]] || continue
        [ "$score" -le -800 ] || continue
        protected_user_unit_member_pid "$pid" && continue
        allowed_user_protected_process "$name" && continue
        echo "residual inherited OOM protection: pid=$pid name=$name oom_score_adj=$score; next action: run $OOM_REPAIR_ACTION" >&2
        failed=1
    done
    [ "$failed" -eq 0 ]
}

validate_authenticated_production_environment_names
load_authenticated_sealed_sources
require_authenticated_install_authority
if [ "$INSTALL" -eq 1 ]; then
    refuse_whole_script_root
    reexec_with_safe_root_required_lock
    acquire_root_required_lock
    validate_authenticated_install_contract
fi
if [ "$INSTALL" -eq 1 ] && [ "$AUTHENTICATED_SEALED_SOURCE" -eq 1 ]; then
    bind_authenticated_release_root
    validate_package_source_matches_commit
    load_host_policy
    validate_authenticated_cap_environment_for_host
    validate_selected_host_sources
    run_authenticated_authority_gate authority-only
fi
validate_docker_command

if [ "$INSTALL" -eq 1 ]; then
    validate_root_required_package_order
    if [ "$SKIP_SUPERSEDED_INSTALL" -eq 1 ]; then
        run_authenticated_authority_gate authority-only
        normalize_existing_root_required_package_receipts
        drain_root_required_deferral
        echo "p0 oom containment superseded deferral drained without live mutation"
        exit 0
    fi
    run_authenticated_authority_gate candidate
    validate_package_source_matches_commit
    validate_no_unhandled_package_removals
    validate_root_required_deferral
    check_source
    load_host_policy
    validate_selected_host_sources
    install_live
elif [ "$CHECK" -eq 1 ] || [ "$VERIFY_LIVE" -eq 1 ]; then
    check_source
    load_host_policy
    validate_selected_host_sources
fi
if [ "$VERIFY_LIVE" -ne 0 ]; then
    verify_live
fi
if [ "$INSTALL" -ne 0 ]; then
    run_authenticated_authority_gate applied
    record_installed_source
    record_root_required_package_receipt
    drain_root_required_deferral
fi
echo "p0 oom containment install/check complete"
