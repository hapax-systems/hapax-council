}

verify_recovery_unit_oom_scores() {
    local spec unit score pid actual configured policy failed=0
    for spec in "${recovery_unit_scores[@]}"; do
        unit="${spec%%:*}"
        score="${spec##*:}"
        configured="$("$SYSTEMCTL" show "$unit" -p OOMScoreAdjust --value 2>/dev/null || true)"
        if [ "$configured" != "$score" ]; then
            echo "effective OOM policy drift for $unit: configured=$configured expected=$score; next action: remove higher-priority drop-in drift and rerun scripts/install-p0-oom-containment --install --verify-live" >&2
            failed=1
        fi
        if [ "$unit" = "sshd.service" ]; then
            policy="$("$SYSTEMCTL" show "$unit" -p OOMPolicy --value 2>/dev/null || true)"
            if [ "$policy" != "continue" ]; then
                echo "effective OOM policy drift for sshd.service: OOMPolicy=$policy expected=continue; next action: remove higher-priority drop-in drift and rerun scripts/install-p0-oom-containment --install --verify-live" >&2
                failed=1
            fi
        fi
        pid="$(main_pid_for_unit "$unit")"
        if [ -z "$pid" ]; then
            echo "recovery daemon has no live MainPID: $unit; next action: inspect systemctl status $unit and rerun scripts/install-p0-oom-containment --install --verify-live" >&2
            failed=1
            continue
        fi
        actual="$(cat "$PROC_ROOT/$pid/oom_score_adj" 2>/dev/null || true)"
        if [ "$actual" != "$score" ]; then
            echo "live OOM score drift for $unit pid $pid: actual=$actual expected=$score; next action: run scripts/install-p0-oom-containment --install --verify-live" >&2
            failed=1
        fi
    done
    [ "$failed" -eq 0 ]
}

verify_user_manager_oom_score() {
    local pid actual policy configured
    configured="$("$SYSTEMCTL" show user@1000.service -p OOMScoreAdjust --value 2>/dev/null || true)"
    if [ "$configured" != "100" ]; then
        echo "effective user@1000.service OOMScoreAdjust drift: actual=$configured expected=100; next action: remove higher-priority drop-in drift and rerun scripts/install-p0-oom-containment --install --verify-live" >&2
        return 1
    fi
    policy="$("$SYSTEMCTL" show user@1000.service -p OOMPolicy --value 2>/dev/null || true)"
    if [ "$policy" != "continue" ]; then
        echo "effective user@1000.service OOMPolicy drift: actual=$policy expected=continue; next action: remove higher-priority drop-in drift and rerun scripts/install-p0-oom-containment --install --verify-live" >&2
        return 1
    fi
    pid="$("$SYSTEMCTL" show user@1000.service -p MainPID --value 2>/dev/null || true)"
    if ! [[ "$pid" =~ ^[0-9]+$ ]] || [ "$pid" -le 0 ]; then
        echo "unable to read live user@1000.service MainPID; next action: run scripts/install-p0-oom-containment --install --verify-live" >&2
        return 1
    fi
    actual="$(cat "$PROC_ROOT/$pid/oom_score_adj" 2>/dev/null || true)"
    if [ "$actual" != "100" ]; then
        echo "live user@1000.service OOM score drift: pid=$pid actual=$actual expected=100; next action: run scripts/install-p0-oom-containment --install --verify-live" >&2
        return 1
    fi
}

verify_protected_user_unit_oom_scores() {
    local spec unit score pid actual configured rel expected_slice key expected_raw expected_bytes cgroup failed=0
    local verified=0 skipped=0
    for spec in "${protected_user_unit_scores[@]}"; do
        unit="${spec%%:*}"
        score="${spec##*:}"
        cgroup="${protected_user_cgroup_snapshot[$unit]:-}"
        # HOST FIT: a unit that does not exist on this host has no live properties to verify.
        # systemctl STILL answers `show` for an unknown unit, with DEFAULTS -- OOMScoreAdjust=200,
        # Slice=, MemoryLow=0, MemoryMin=0 -- every one of which this loop then reads as drift and
        # hard-fails on. Absent is not drifted; it is UNEVALUABLE, and conflating the two is what
        # bricked source activation on hapax-appendix for three weeks: hapax-daimonion /
        # studio-compositor / hapax-imagination are LoadState=not-found on appendix, so every run
        # failed verify, exited 1, rolled the deploy back, and repeated every two minutes -- 2176
        # incident events before containment stopped it.
        #
        # But UNEVALUABLE-AND-EXPECTED and UNEVALUABLE-AND-ALARMING are different states, and only
        # the first may be skipped. Skipping both is how --verify-live comes to PASS WITHOUT
        # VERIFYING ANYTHING: a required unit vanishing from a host it belongs on would report
        # success. The skip is therefore allow-listed to host_optional_user_units; every other
        # protected unit is required wherever this package installs, and its absence fails closed.
        if [ "$(user_systemctl show "$unit" -p LoadState --value 2>/dev/null || true)" = "not-found" ]; then
            # Allow-list membership is necessary but NOT sufficient. It says the unit may be absent
            # on SOME host; only the unit file says whether THIS host is one of them. Checked first,
            # so an allow-listed unit that is installed here but unloadable can never reach the skip.
            if user_unit_file_present "$unit"; then
                echo "protected user unit $unit reports LoadState=not-found but a unit file for it EXISTS on this host: the package IS installed here and the user manager cannot load it, so this is a load failure, not host-absence, and skipping it would report success having verified nothing; next action: run 'systemctl --user status $unit' and 'systemd-analyze --user verify $unit' to find the masked/dangling/malformed unit, then rerun scripts/install-p0-oom-containment --install --verify-live" >&2
                failed=1
                continue
            fi
            if is_host_optional_user_unit "$unit"; then
                # The skip rests on having proven absence, which a reconstructed search path
                # cannot do. Fail closed rather than skip on a list that may not be complete.
                if ! user_unit_search_paths_are_authoritative; then
                    echo "protected user unit $unit is not loaded and no unit file was found, but the user unit search path could NOT be obtained from systemd ('$SYSTEMD_ANALYZE --user unit-paths' failed), so the list searched is a RECONSTRUCTION and may omit a directory this system uses; absence is therefore unproven and skipping it would be a false green; next action: restore '$SYSTEMD_ANALYZE --user unit-paths' for the target user, then rerun scripts/install-p0-oom-containment --install --verify-live" >&2
                    failed=1
                    continue
                fi
                skipped=$((skipped + 1))
                echo "p0-oom: skipping $unit — host-optional protected unit, no unit file on this host (LoadState=not-found); nothing to verify" >&2
                continue
            fi
            echo "required protected user unit $unit is absent on this host (LoadState=not-found): --verify-live cannot confirm OOM policy for a unit that is not loaded, and treating it as verified would be a false green; next action: install/enable $unit on this host, or if it is legitimately host-optional add it to host_optional_user_units in scripts/install-p0-oom-containment with the measurement that justifies it" >&2
            failed=1
            continue
        fi
        configured="$(user_systemctl show "$unit" -p OOMScoreAdjust --value 2>/dev/null || true)"
        if [ "$configured" != "100" ]; then
            echo "user unit startup OOM policy drift for $unit: configured=$configured expected=100; the user manager cannot lower a child score, so root must apply live score $score after start; next action: run scripts/install-p0-oom-containment --install --verify-live" >&2
            failed=1
        fi
        case "$unit" in
            pipewire.service|pipewire-pulse.service|wireplumber.service)
                expected_slice=session.slice
                actual="$(user_systemctl show "$unit" -p NoNewPrivileges --value 2>/dev/null || true)"
                if [ "$actual" != "yes" ]; then
                    echo "live user unit NoNewPrivileges drift for $unit: actual=$actual expected=yes; next action: restore the distro audio sandbox and rerun scripts/install-p0-oom-containment --install --verify-live" >&2
                    failed=1
                fi
                ;;
            *) expected_slice=app.slice ;;
        esac
        actual="$(user_systemctl show "$unit" -p Slice --value 2>/dev/null || true)"
        if [ "$actual" != "$expected_slice" ]; then
            echo "live user unit Slice drift for $unit: actual=$actual expected=$expected_slice; next action: remove higher-priority user-unit drop-in drift and rerun scripts/install-p0-oom-containment --install --verify-live" >&2
            failed=1
        fi
        rel="systemd/units/$unit.d/oom-protect.conf"
        for key in MemoryLow MemoryMin; do
            expected_raw="$(source_unit_value "$rel" "$key")"
            expected_bytes="$(memory_to_bytes "$expected_raw")" || {
                echo "cannot parse protected user unit $unit $key=$expected_raw from $rel; next action: fix the source drop-in and rerun scripts/install-p0-oom-containment --check" >&2
                return 1
            }
            actual="$(user_systemctl show "$unit" -p "$key" --value 2>/dev/null || true)"
            if [ "$actual" != "$expected_raw" ] && [ "$actual" != "$expected_bytes" ]; then
                echo "live user unit $key drift for $unit: actual=$actual expected=$expected_raw; next action: remove higher-priority user-unit drop-in drift and rerun scripts/install-p0-oom-containment --install --verify-live" >&2
                failed=1
            fi
        done
        while IFS= read -r pid; do
            [ -n "$pid" ] || continue
            if ! pid_matches_cgroup "$pid" "$cgroup"; then
                echo "live user unit cgroup changed before OOM score readback for $unit pid $pid; next action: rerun scripts/install-p0-oom-containment --install --verify-live after unit churn settles" >&2
                failed=1
                continue
            fi
            actual="$(cat "$PROC_ROOT/$pid/oom_score_adj" 2>/dev/null || true)"
            if [ "$actual" != "$score" ]; then
                echo "live user unit OOM score drift for $unit pid $pid: actual=$actual expected=$score; next action: run scripts/install-p0-oom-containment --install --verify-live" >&2
                failed=1
            fi
        done < <(snapshotted_user_unit_pids "$unit")
        verified=$((verified + 1))
    done
    # VACUOUS-PASS GUARD. Every check above is universally quantified over the units that survived
    # the skip, and a universally quantified check over an EMPTY set is true. So a --verify-live that
    # examined nothing returns exactly what a --verify-live that examined everything returns, and the
    # two are indistinguishable from the exit code -- which is the failure mode this package was
    # written to stop, reappearing one level up in the package's own verifier.
    #
    # The allow-list is the mechanism that could empty the set: it is edited by hand, under pressure,
    # by whoever is trying to get a host to deploy. Nothing structurally prevents it from growing
    # until it covers every protected unit, at which point verify-live passes on every host forever.
    # This makes that state loud instead of green.
    if [ "$verified" -eq 0 ]; then
        echo "--verify-live examined 0 of ${#protected_user_unit_scores[@]} protected user units ($skipped skipped as host-optional): a verification that evaluates nothing PASSES VACUOUSLY and cannot be told apart from one that actually verified the policy; next action: confirm this host is meant to run none of the protected units, and if so stop running --verify-live here, otherwise install the units or shrink host_optional_user_units in scripts/install-p0-oom-containment" >&2
        failed=1
    fi
    [ "$failed" -eq 0 ]
}

verify_user_process_oom_floor() {
    local adj pid_dir pid status uid name score failed=0
    [ -d "$PROC_ROOT" ] || return 0
    for adj in "$PROC_ROOT"/[0-9]*/oom_score_adj; do
        [ -e "$adj" ] || continue
        pid_dir="$(dirname "$adj")"
        pid="$(basename "$pid_dir")"
        status="$pid_dir/status"
        [ -r "$status" ] || continue
        uid="$(status_field "$status" Uid)"
        [ "$uid" = "$TARGET_UID" ] || continue
        name="$(status_field "$status" Name)"
        score="$(cat "$adj" 2>/dev/null || true)"
        [[ "$score" =~ ^-?[0-9]+$ ]] || continue
        [ "$score" -le -800 ] || continue
        protected_user_unit_member_pid "$pid" && continue
        allowed_user_protected_process "$name" && continue
        echo "residual inherited OOM protection: pid=$pid name=$name oom_score_adj=$score; next action: run scripts/install-p0-oom-containment --install --verify-live" >&2
        failed=1
    done
    [ "$failed" -eq 0 ]
}

if [ "$INSTALL" -eq 1 ]; then
    refuse_whole_script_root
    reexec_with_safe_root_required_lock
    acquire_root_required_lock
    validate_root_required_package_order
    if [ "$SKIP_SUPERSEDED_INSTALL" -eq 1 ]; then
        drain_root_required_deferral
        echo "p0 oom containment superseded deferral drained without live mutation"
        exit 0
    fi
    validate_package_source_matches_commit
    validate_no_unhandled_package_removals
    validate_root_required_deferral
    check_source
    load_host_policy
    validate_selected_host_sources
    install_live
elif [ "$CHECK" -eq 1 ] || [ "$VERIFY_LIVE" -eq 1 ]; then
    check_source
    load_host_policy
    validate_selected_host_sources
fi
[ "$VERIFY_LIVE" -eq 0 ] || verify_live
[ "$INSTALL" -eq 0 ] || record_installed_source
[ "$INSTALL" -eq 0 ] || record_root_required_package_receipt
[ "$INSTALL" -eq 0 ] || drain_root_required_deferral
echo "p0 oom containment install/check complete"
