#!/usr/bin/bash -p
# Install P0 OOM containment policy from the source tree to live systemd/earlyoom paths.
if [[ "${BASH_SOURCE[0]}" != "$0" ]] || [[ "${BASH_LINENO[0]:-1}" != "0" ]]; then
    printf '%s\n' "OOM containment installer must be executed, not sourced; next action: execute scripts/install-p0-oom-containment as a command through hapax-post-merge-deploy" >&2
    return 1
fi
case "$-" in
    *p*) ;;
    *)
        printf '%s\n' "OOM containment installer requires Bash privileged mode; next action: execute the installer directly or let hapax-post-merge-deploy invoke its sealed copy" >&2
        exit 1
        ;;
esac
set -euo pipefail
ORIGINAL_ARGS=("$@")
readonly -a AUTHENTICATED_PRODUCTION_REQUIRED_ENV_NAMES=(
    GIT_CONFIG_GLOBAL
    GIT_CONFIG_NOSYSTEM
    GIT_NO_REPLACE_OBJECTS
    GIT_OPTIONAL_LOCKS
    HAPAX_LOCAL_JUDGE_CAP_RECEIPT_SHA256
    HAPAX_POST_MERGE_ROOT_DEFER_DIR
    HAPAX_ROOT_REQUIRED_DESIRED_RECEIPT_ROOT
    HAPAX_ROOT_REQUIRED_DRAIN_DIR
    HAPAX_ROOT_REQUIRED_GENERATION_GUARD_FD
    HAPAX_ROOT_REQUIRED_GIT_REPO
    HAPAX_ROOT_REQUIRED_INSTALLED_RECEIPT_ROOT
    HAPAX_ROOT_REQUIRED_INSTALLED_SOURCE_ROOT
    HAPAX_ROOT_REQUIRED_LOCK_FD
    HAPAX_ROOT_REQUIRED_LOCK_FILE
    HAPAX_ROOT_REQUIRED_LOCK_LEXICAL_PATH
    HAPAX_ROOT_REQUIRED_LOCK_MODE
    HAPAX_ROOT_REQUIRED_PACKAGE_SHA
    HAPAX_ROOT_REQUIRED_SEALED_SOURCE_FDS
    HAPAX_ROOT_REQUIRED_STATE_FD
    HAPAX_ROOT_REQUIRED_STATE_LEXICAL_ROOT
    HAPAX_ROOT_REQUIRED_STATE_ROOT
    HAPAX_RUNTIME_AUTHORITY_TASK
    HAPAX_RUNTIME_AUTHORITY_TASK_SHA256
    HOME
    LANG
    LC_ALL
    LOGNAME
    PATH
    PWD
    PYTHONNOUSERSITE
    PYTHONSAFEPATH
    SHLVL
    USER
    XDG_RUNTIME_DIR
)
AUTHENTICATED_PRODUCTION_INPUT_ENV_NAMES=()
AUTHENTICATED_PRODUCTION_MISSING_ENV_NAMES=()
AUTHENTICATED_PRODUCTION_RAW_ENVIRONMENT=()
AUTHENTICATED_PRODUCTION_UNEXPECTED_ENV_NAMES=()
AUTHENTICATED_PRODUCTION_INPUT_ENVIRONMENT_VALIDATED=0
_authenticated_requested=0
_source_value_follows=0
# This bootstrap must remain Bash-only until the inherited vocabulary and fixed
# command-resolution values have been accepted.
for _argument in "$@"; do
    if [ "$_source_value_follows" -eq 1 ]; then
        _source_value_follows=0
        continue
    fi
    case "$_argument" in
        --source) _source_value_follows=1 ;;
        --authenticated-sealed-source) _authenticated_requested=1 ;;
    esac
done
if [ "$_authenticated_requested" -eq 1 ] \
    && [ "${HAPAX_ROOT_REQUIRED_INSTALLER_TEST_MODE:-0}" != "1" ]; then
    if ! mapfile -d '' -t AUTHENTICATED_PRODUCTION_RAW_ENVIRONMENT < "/proc/$$/environ"; then
        echo "authenticated production OOM install cannot read its raw exported environment; next action: discard the direct invocation and regenerate its exact live command with hapax-post-merge-deploy" >&2
        exit 1
    fi
    for _environment_entry in "${AUTHENTICATED_PRODUCTION_RAW_ENVIRONMENT[@]}"; do
        case "$_environment_entry" in
            *=*) _environment_name="${_environment_entry%%=*}" ;;
            *) _environment_name= ;;
        esac
        if [[ "$_environment_name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
            _environment_display="$_environment_name"
        else
            _environment_display="<invalid-environment-entry>"
        fi
        _environment_duplicate=0
        for _observed_environment_name in "${AUTHENTICATED_PRODUCTION_INPUT_ENV_NAMES[@]}"; do
            if [ "$_environment_name" = "$_observed_environment_name" ]; then
                _environment_duplicate=1
                break
            fi
        done
        if [ "$_environment_duplicate" -eq 1 ]; then
            AUTHENTICATED_PRODUCTION_UNEXPECTED_ENV_NAMES+=("$_environment_display(duplicate)")
            continue
        fi
        AUTHENTICATED_PRODUCTION_INPUT_ENV_NAMES+=("$_environment_name")
        _environment_allowed=0
        for _allowed_environment_name in "${AUTHENTICATED_PRODUCTION_REQUIRED_ENV_NAMES[@]}"; do
            case "$_allowed_environment_name" in
                PWD|SHLVL) continue ;;
            esac
            if [ "$_environment_name" = "$_allowed_environment_name" ]; then
                _environment_allowed=1
                break
            fi
        done
        if [ "$_environment_allowed" -eq 0 ]; then
            AUTHENTICATED_PRODUCTION_UNEXPECTED_ENV_NAMES+=("$_environment_display")
        fi
    done
    for _required_environment_name in "${AUTHENTICATED_PRODUCTION_REQUIRED_ENV_NAMES[@]}"; do
        case "$_required_environment_name" in
            PWD|SHLVL) continue ;;
        esac
        _environment_found=0
        for _observed_environment_name in "${AUTHENTICATED_PRODUCTION_INPUT_ENV_NAMES[@]}"; do
            if [ "$_required_environment_name" = "$_observed_environment_name" ]; then
                _environment_found=1
                break
            fi
        done
        [ "$_environment_found" -eq 1 ] \
            || AUTHENTICATED_PRODUCTION_MISSING_ENV_NAMES+=("$_required_environment_name")
    done
    if [ "${#AUTHENTICATED_PRODUCTION_UNEXPECTED_ENV_NAMES[@]}" -ne 0 ] \
        || [ "${#AUTHENTICATED_PRODUCTION_MISSING_ENV_NAMES[@]}" -ne 0 ]; then
        echo "authenticated production OOM install refuses an unexpected raw exported environment vocabulary: missing=${AUTHENTICATED_PRODUCTION_MISSING_ENV_NAMES[*]:-none} unexpected=${AUTHENTICATED_PRODUCTION_UNEXPECTED_ENV_NAMES[*]:-none}; next action: discard the direct invocation and regenerate its exact live command with hapax-post-merge-deploy" >&2
        exit 1
    fi
    if [ "${GIT_CONFIG_GLOBAL-}" != "/dev/null" ] \
        || [ "${GIT_CONFIG_NOSYSTEM-}" != "1" ] \
        || [ "${GIT_NO_REPLACE_OBJECTS-}" != "1" ] \
        || [ "${GIT_OPTIONAL_LOCKS-}" != "0" ] \
        || [ "${LANG-}" != "C.UTF-8" ] || [ "${LC_ALL-}" != "C.UTF-8" ] \
        || [ "${PATH-}" != "/usr/local/sbin:/usr/local/bin:/usr/bin:/bin" ] \
        || [ "${PYTHONNOUSERSITE-}" != "1" ] || [ "${PYTHONSAFEPATH-}" != "1" ] \
        || [ "${XDG_RUNTIME_DIR-}" != "/run/user/$UID" ] || [ "${SHLVL-}" != "1" ] \
        || { [ -n "${HAPAX_LOCAL_JUDGE_CAP_RECEIPT_SHA256-}" ] \
            && ! [[ "${HAPAX_LOCAL_JUDGE_CAP_RECEIPT_SHA256-}" =~ ^[0-9a-f]{64}$ ]]; }; then
        echo "authenticated production OOM install refuses noncanonical fixed environment values before command execution; next action: discard the direct invocation and regenerate its exact live command with hapax-post-merge-deploy" >&2
        exit 1
    fi
    AUTHENTICATED_PRODUCTION_INPUT_ENVIRONMENT_VALIDATED=1
fi
unset AUTHENTICATED_PRODUCTION_INPUT_ENV_NAMES AUTHENTICATED_PRODUCTION_RAW_ENVIRONMENT
unset _allowed_environment_name _argument _authenticated_requested _environment_allowed
unset _environment_display _environment_duplicate _environment_entry _environment_found
unset _environment_name _observed_environment_name _required_environment_name
unset _source_value_follows

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SOURCE="$ROOT"
SYSTEMD_SYSTEM_DIR="${HAPAX_OOM_SYSTEMD_SYSTEM_DIR:-/etc/systemd/system}"
TARGET_UID="${HAPAX_OOM_TARGET_UID:-1000}"
TARGET_USER="${HAPAX_OOM_TARGET_USER:-}"
TARGET_HOME="${HAPAX_OOM_TARGET_HOME:-}"
TARGET_GID="${HAPAX_OOM_TARGET_GID:-}"
if [ -z "$TARGET_USER" ]; then
    TARGET_USER="$(/usr/bin/getent passwd "$TARGET_UID" | /usr/bin/cut -d: -f1 || true)"
fi
if [ -z "$TARGET_HOME" ]; then
    TARGET_HOME="$(/usr/bin/getent passwd "$TARGET_UID" | /usr/bin/cut -d: -f6 || true)"
fi
if [ -z "$TARGET_GID" ]; then
    TARGET_GID="$(/usr/bin/getent passwd "$TARGET_UID" | /usr/bin/cut -d: -f4 || true)"
fi
if [ -z "$TARGET_USER" ] || [ -z "$TARGET_HOME" ] || [ -z "$TARGET_GID" ]; then
    echo "unable to resolve account/home/group for OOM target UID $TARGET_UID; next action: set HAPAX_OOM_TARGET_UID, HAPAX_OOM_TARGET_USER, HAPAX_OOM_TARGET_HOME, and HAPAX_OOM_TARGET_GID explicitly" >&2
    exit 2
fi
SYSTEMD_USER_DIR="${HAPAX_OOM_SYSTEMD_USER_DIR:-$TARGET_HOME/.config/systemd/user}"
SYSTEMD_USER_CONTROL_DIR="${HAPAX_OOM_SYSTEMD_USER_CONTROL_DIR:-$TARGET_HOME/.config/systemd/user.control}"
SYSTEMD_SYSTEM_CONTROL_DIR="${HAPAX_OOM_SYSTEMD_SYSTEM_CONTROL_DIR:-/etc/systemd/system.control}"
SYSTEMD_SYSTEM_RUNTIME_CONTROL_DIR="${HAPAX_OOM_SYSTEMD_SYSTEM_RUNTIME_CONTROL_DIR:-/run/systemd/system.control}"
SYSTEMD_SYSTEM_TRANSIENT_DIR="${HAPAX_OOM_SYSTEMD_SYSTEM_TRANSIENT_DIR:-/run/systemd/transient}"
SYSTEMD_USER_RUNTIME_CONTROL_DIR="${HAPAX_OOM_SYSTEMD_USER_RUNTIME_CONTROL_DIR:-/run/user/$TARGET_UID/systemd/user.control}"
SYSTEMD_USER_TRANSIENT_DIR="${HAPAX_OOM_SYSTEMD_USER_TRANSIENT_DIR:-/run/user/$TARGET_UID/systemd/transient}"
EARLYOOM_DEST="${HAPAX_OOM_EARLYOOM_DEST:-/etc/default/earlyoom}"
OOM_ENFORCER_DEST="${HAPAX_OOM_ENFORCER_DEST:-/usr/local/sbin/hapax-oom-score-enforce}"
OOM_TRIGGER_DEST="${HAPAX_OOM_TRIGGER_DEST:-/usr/local/bin/hapax-oom-score-trigger}"
OOM_SUDOERS_DEST="${HAPAX_OOM_SUDOERS_DEST:-/etc/sudoers.d/hapax-oom-score-enforce}"
OOM_SUDOERS_REFERENCE_DEST="${HAPAX_OOM_SUDOERS_REFERENCE_DEST:-/usr/local/share/hapax/root-required/hapax-oom-score-enforce.sudoers}"
OOM_SUDOERS_OWNER_UID="${HAPAX_OOM_SUDOERS_OWNER_UID:-0}"
OOM_SUDOERS_OWNER_GID="${HAPAX_OOM_SUDOERS_OWNER_GID:-0}"
ROOT_FAILURE_INTAKE_DEST="${HAPAX_ROOT_FAILURE_INTAKE_DEST:-/usr/local/sbin/hapax-root-failure-intake}"
OOM_POLICY_AUDIT_DEST="${HAPAX_OOM_POLICY_AUDIT_DEST:-/usr/local/sbin/hapax-oom-policy-audit}"
ROOT_REQUIRED_AUDIT_DEST="${HAPAX_ROOT_REQUIRED_AUDIT_DEST:-/usr/local/sbin/hapax-root-required-deploy-audit}"
LOCAL_JUDGE_CONTAINER_ID_DEST="$TARGET_HOME/.local/bin/hapax-local-judge-container-id"
OOM_PROFILE_TABLE_DEST="${HAPAX_OOM_PROFILE_TABLE_DEST:-/usr/local/share/hapax/root-required/oom-host-profiles.tsv}"
ZRAM_POLICY_DEST="${HAPAX_OOM_ZRAM_POLICY_DEST:-/etc/systemd/zram-generator.conf}"
LEGACY_ZRAM_POLICY_DEST="${HAPAX_OOM_LEGACY_ZRAM_POLICY_DEST:-/etc/systemd/zram-generator.conf.d/90-hapax-host-policy.conf}"
ZRAM_DROPIN_DIRS="${HAPAX_OOM_ZRAM_DROPIN_DIRS:-/etc/systemd/zram-generator.conf.d:/run/systemd/zram-generator.conf.d:/usr/local/lib/systemd/zram-generator.conf.d:/usr/lib/systemd/zram-generator.conf.d}"
ZRAM_HIGH_PRIORITY_CONFIGS="${HAPAX_OOM_ZRAM_HIGH_PRIORITY_CONFIGS:-/run/systemd/zram-generator.conf}"
ZRAM_DISKSIZE_PATH="${HAPAX_OOM_ZRAM_DISKSIZE_PATH:-/sys/block/zram0/disksize}"
DOCKER="${HAPAX_OOM_DOCKER:-/usr/bin/docker}"
LOCAL_DOCKER_HOST="unix:///var/run/docker.sock"
LOCAL_DOCKER_CONFIG="/nonexistent/hapax-local-docker-config"
SYSTEMCTL="${HAPAX_OOM_SYSTEMCTL:-/usr/bin/systemctl}"
SYSTEMD_ANALYZE="${HAPAX_OOM_SYSTEMD_ANALYZE:-/usr/bin/systemd-analyze}"
SUDO="${HAPAX_OOM_INSTALL_SUDO-/usr/bin/sudo}"
ACTUAL_UID="$(/usr/bin/id -u)"
if [ "$ACTUAL_UID" != "0" ] && [ "${HAPAX_OOM_INSTALL_TEST_ACTUAL_UID:-}" = "0" ]; then
    ACTUAL_UID=0
fi
RUNUSER="${HAPAX_OOM_RUNUSER:-/usr/bin/runuser}"
VISUDO="${HAPAX_OOM_VISUDO:-/usr/bin/visudo}"
EFFECTIVE_UID="${HAPAX_OOM_EFFECTIVE_UID:-$(/usr/bin/id -u)}"
ROOT_REQUIRED_STATE_ROOT="${HAPAX_ROOT_REQUIRED_STATE_ROOT:-$TARGET_HOME/.local/state/hapax/root-required}"
ROOT_REQUIRED_INSTALLED_SOURCE_ROOT="${HAPAX_ROOT_REQUIRED_INSTALLED_SOURCE_ROOT:-$ROOT_REQUIRED_STATE_ROOT/current-source}"
ROOT_REQUIRED_DEFER_ROOT="${HAPAX_POST_MERGE_ROOT_DEFER_DIR:-$TARGET_HOME/.cache/hapax/post-merge-root-required}"
ROOT_REQUIRED_INSTALLED_RECEIPT_ROOT="${HAPAX_ROOT_REQUIRED_INSTALLED_RECEIPT_ROOT:-$ROOT_REQUIRED_STATE_ROOT/installed-receipts}"
ROOT_REQUIRED_DESIRED_RECEIPT_ROOT="${HAPAX_ROOT_REQUIRED_DESIRED_RECEIPT_ROOT:-$ROOT_REQUIRED_STATE_ROOT/desired-receipts}"
ROOT_REQUIRED_GIT_REPO="${HAPAX_ROOT_REQUIRED_GIT_REPO:-$TARGET_HOME/.cache/hapax/source-activation/worktree}"
ROOT_REQUIRED_PACKAGE_SHA="${HAPAX_ROOT_REQUIRED_PACKAGE_SHA:-}"
ROOT_REQUIRED_LOCK_FILE="${HAPAX_ROOT_REQUIRED_LOCK_FILE:-$ROOT_REQUIRED_STATE_ROOT/.lock}"
ROOT_REQUIRED_SEALED_SOURCE_FDS="${HAPAX_ROOT_REQUIRED_SEALED_SOURCE_FDS:-}"
ROOT_REQUIRED_LEGACY_FINALIZE_GATE="${HAPAX_ROOT_REQUIRED_FINALIZE_GATE:-}"
ROOT_REQUIRED_INSTALLER_TEST_MODE="${HAPAX_ROOT_REQUIRED_INSTALLER_TEST_MODE:-0}"
ROOT_REQUIRED_INSTALLER_TEST_ROOT="${HAPAX_ROOT_REQUIRED_INSTALLER_TEST_ROOT:-}"
RUNTIME_AUTHORITY_TASK="${HAPAX_RUNTIME_AUTHORITY_TASK:-}"
RUNTIME_AUTHORITY_TASK_SHA256="${HAPAX_RUNTIME_AUTHORITY_TASK_SHA256:-}"
LOCAL_JUDGE_CAP_RECEIPT_SHA256="${HAPAX_LOCAL_JUDGE_CAP_RECEIPT_SHA256:-}"
ROOT_REQUIRED_RECEIPT="$ROOT_REQUIRED_INSTALLED_RECEIPT_ROOT/oom-containment.sha"
ROOT_REQUIRED_DESIRED_RECEIPT="$ROOT_REQUIRED_DESIRED_RECEIPT_ROOT/oom-containment.sha"
SKIP_SUPERSEDED_INSTALL=0
AUTHENTICATED_SEALED_SOURCE=0
PROC_ROOT="${HAPAX_OOM_PROC_ROOT:-/proc}"
if [ -n "${HAPAX_OOM_CGROUP_ROOT:-}" ]; then
    CGROUP_ROOT="$HAPAX_OOM_CGROUP_ROOT"
elif [ "$PROC_ROOT" != "/proc" ]; then
    CGROUP_ROOT="$(dirname "$PROC_ROOT")/cgroup"
else
    CGROUP_ROOT="/sys/fs/cgroup"
fi
ROOT_REQUIRED_RC=77
INSTALL=0
CHECK=0
VERIFY_LIVE=0
APPLY_RUNTIME=1
MCP_DOCKER_MEMORY="512M"
MCP_DOCKER_MEMORY_SWAP="768M"
LOCAL_JUDGE_DOCKER_MEMORY="4G"
LOCAL_JUDGE_DOCKER_MEMORY_SWAP="6G"
LOCAL_JUDGE_DOCKER_HOST_ARG="--host=unix:///var/run/docker.sock"
LOCAL_JUDGE_DOCKER_CONFIG_SUFFIX="/hapax-local-judge/docker-config"
readonly OOM_REPAIR_ACTION="the runtime-authorized hapax-post-merge-deploy OOM reconciliation for the desired receipt SHA with HAPAX_RUNTIME_AUTHORITY_TASK"
GOVERNED_MEMORY_KEYS=(MemoryHigh MemoryMax MemorySwapMax MemoryLow MemoryMin)

usage() {
    cat <<'USAGE'
usage: scripts/install-p0-oom-containment [--source DIR] [--check] [--install] [--verify-live] [--no-runtime]

Installs the P0 host-profiled OOM containment package:
  systemd/system/user@1000.service.d/oom.conf       -> /etc/systemd/system/user@1000.service.d/oom.conf
  systemd/system/system.slice.d/oom-containment.conf -> /etc/systemd/system/system.slice.d/oom-containment.conf
  systemd/system/*.service.d/oom-protect.conf       -> /etc/systemd/system/*.service.d/oom-protect.conf
  systemd/units/hapax-root-failure-intake@.service  -> /etc/systemd/system/
  systemd/units/hapax-oom-score-enforce.{service,timer} -> /etc/systemd/system/
  scripts/hapax-oom-score-enforce                   -> /usr/local/sbin/hapax-oom-score-enforce
  scripts/hapax-oom-score-trigger                   -> /usr/local/bin/hapax-oom-score-trigger
  config/root-required/hapax-oom-score-enforce.sudoers -> /etc/sudoers.d/hapax-oom-score-enforce
                                                   and root-owned audit reference under /usr/local/share/hapax/root-required/
  scripts/hapax-root-failure-intake                  -> /usr/local/sbin/hapax-root-failure-intake
  scripts/hapax-oom-policy-audit                     -> /usr/local/sbin/hapax-oom-policy-audit
  scripts/hapax-root-required-deploy-audit            -> /usr/local/sbin/hapax-root-required-deploy-audit
  config/root-required/oom-host-profiles.tsv          -> /usr/local/share/hapax/root-required/
  selected host zram policy                           -> /etc/systemd/zram-generator.conf
  systemd/units/hapax-local-judge.service             -> ~/.config/systemd/user/
  systemd/units/hapax-{oom-policy,root-required-deploy}-audit.{service,timer}
                                                     -> ~/.config/systemd/user/
  systemd/units/*.service.d/oom-protect.conf        -> ~/.config/systemd/user/*.service.d/oom-protect.conf
  systemd/units/{app,session}.slice.d/oom-containment.conf -> ~/.config/systemd/user/<slice>.slice.d/oom-containment.conf
  config/earlyoom/default                           -> /etc/default/earlyoom

The app.slice and session.slice drop-ins are copied, not symlinked, so live
containment does not depend on a mutable PR worktree. Runtime activation uses
set-property without restarting either slice, then removes the generated
control files and reloads the receipt-owned canonical policy. Run as the target
account; the installer uses sudo only for root-owned destinations and refuses
whole-script root execution. Production --install is accepted only through the
authenticated sealed-source helper emitted by hapax-post-merge-deploy.
USAGE
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --source)
            SOURCE="${2:?source dir required after --source}"
            shift 2
            ;;
        --check)
            CHECK=1
            shift
            ;;
        --install)
            INSTALL=1
            shift
            ;;
        --verify-live)
            VERIFY_LIVE=1
            shift
            ;;
        --no-runtime)
            APPLY_RUNTIME=0
            shift
            ;;
        --authenticated-sealed-source)
            AUTHENTICATED_SEALED_SOURCE=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if [ "$INSTALL" -eq 1 ]; then
    VERIFY_LIVE=1
fi

if [ "$CHECK" -eq 0 ] && [ "$INSTALL" -eq 0 ] && [ "$VERIFY_LIVE" -eq 0 ]; then
    CHECK=1
fi

run_root() {
    if [ -n "$SUDO" ]; then
        "$SUDO" "$@"
    else
        "$@"
    fi
}

user_systemctl() {
    if [ "$EFFECTIVE_UID" = "$TARGET_UID" ]; then
        "$SYSTEMCTL" --user "$@"
    elif [ "$EFFECTIVE_UID" = "0" ]; then
        "$RUNUSER" -u "$TARGET_USER" -- env XDG_RUNTIME_DIR="/run/user/$TARGET_UID" "$SYSTEMCTL" --user "$@"
    else
        echo "cannot control UID $TARGET_UID user manager from effective UID $EFFECTIVE_UID; next action: run as UID $TARGET_UID or root, or set HAPAX_OOM_TARGET_UID/USER/HOME correctly" >&2
        return 1
    fi
}

preflight_root() {
    if [ -n "$SUDO" ] && [ "$INSTALL" -eq 1 ]; then
        "$SUDO" -n true 2>/dev/null || {
            echo "sudo non-interactive access is required for OOM containment install; next action: run sudo -v or grant the target account NOPASSWD for the governed install/systemctl/tee commands, then rerun as that account" >&2
            return "$ROOT_REQUIRED_RC"
        }
    fi
}

refuse_whole_script_root() {
    if [ "$INSTALL" -eq 1 ] && [ "$ACTUAL_UID" = "0" ]; then
        echo "whole-script root execution is refused because durable package state and its shared lock are owned by UID $TARGET_UID; next action: run this installer as UID $TARGET_UID after sudo -v so only run_root commands cross the privilege boundary" >&2
        return 2
    fi
}

canonical_dir() {
    local dir="$1"
    [ -d "$dir" ] || return 1
    (cd "$dir" && pwd -P)
}

git() {
    /usr/bin/env -i \
        HOME=/nonexistent \
        PATH=/usr/bin:/bin \
        LANG=C.UTF-8 \
        LC_ALL=C.UTF-8 \
        GIT_CONFIG_GLOBAL=/dev/null \
        GIT_CONFIG_NOSYSTEM=1 \
        GIT_NO_REPLACE_OBJECTS=1 \
        GIT_OPTIONAL_LOCKS=0 \
        /usr/bin/git "$@"
}

acquire_root_required_lock() {
    local lock_fd="${HAPAX_ROOT_REQUIRED_LOCK_FD:-}"
    local state_fd="${HAPAX_ROOT_REQUIRED_STATE_FD:-}"
    local guard_fd="${HAPAX_ROOT_REQUIRED_GENERATION_GUARD_FD:-}"
    local lexical_root="${HAPAX_ROOT_REQUIRED_STATE_LEXICAL_ROOT:-}"
    if ! [[ "$lock_fd" =~ ^[0-9]+$ ]] || [ "$lock_fd" -lt 3 ] \
        || ! [[ "$state_fd" =~ ^[0-9]+$ ]] || [ "$state_fd" -lt 3 ] \
        || ! [[ "$guard_fd" =~ ^[0-9]+$ ]] || [ "$guard_fd" -lt 3 ]; then
        echo "OOM installer refused invalid shared lock descriptor: the lock, state, or generation-guard descriptor is absent; next action: remove caller-supplied HAPAX_ROOT_REQUIRED_LOCK_* values and rerun the unmodified installer as UID $TARGET_UID" >&2
        return 1
    fi
    /usr/bin/python3 - \
        "$lock_fd" "$state_fd" "$guard_fd" "$ROOT_REQUIRED_LOCK_FILE" \
        "$ROOT_REQUIRED_STATE_ROOT" "$lexical_root" <<'PY' || return 1
from __future__ import annotations

import fcntl
import os
import stat
import sys


def host_root_uid() -> int:
    with open("/proc/self/uid_map", encoding="ascii") as stream:
        for line in stream:
            inside, outside, length = (int(field) for field in line.split())
            if outside <= 0 < outside + length:
                return inside - outside
    return 65534


fd = int(sys.argv[1])
state_fd = int(sys.argv[2])
guard_fd = int(sys.argv[3])
lock_path = sys.argv[4]
bound_root = sys.argv[5]
lexical_root = sys.argv[6]
lock_parent = os.path.dirname(lock_path) or "."
lock_base = os.path.basename(lock_path)
parent_fd = -1
try:
    if (
        not os.path.isabs(lock_path)
        or not lock_base
        or not os.path.isabs(lexical_root)
        or os.path.abspath(os.path.normpath(lock_parent))
        != os.path.abspath(os.path.normpath(lexical_root))
    ):
        raise OSError("lock path must be absolute and name one file")
    guard_inode = os.fstat(guard_fd)
    published_guard = os.stat("/home", follow_symlinks=False)
    if (
        not stat.S_ISDIR(guard_inode.st_mode)
        or guard_inode.st_uid != host_root_uid()
        or guard_inode.st_mode & 0o022
        or (guard_inode.st_dev, guard_inode.st_ino)
        != (published_guard.st_dev, published_guard.st_ino)
    ):
        raise OSError("generation guard is not the immutable host anchor")
    fcntl.flock(guard_fd, fcntl.LOCK_EX)
    locked_guard = os.fstat(guard_fd)
    published_guard = os.stat("/home", follow_symlinks=False)
    if (locked_guard.st_dev, locked_guard.st_ino) != (
        published_guard.st_dev,
        published_guard.st_ino,
    ):
        raise OSError("generation-guard anchor changed during acquisition")
    parent_fd = os.open(
        lock_parent,
        os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | os.O_NOFOLLOW,
    )
    parent_inode = os.fstat(parent_fd)
    state_inode = os.fstat(state_fd)
    inode = os.fstat(fd)
    path_inode = os.stat(lock_base, dir_fd=parent_fd, follow_symlinks=False)
    bound_inode = os.stat(bound_root)
    lexical_inode = os.stat(lexical_root, follow_symlinks=False)
except OSError as exc:
    if parent_fd >= 0:
        os.close(parent_fd)
    print(
        f"OOM installer refused invalid shared lock descriptor for {lock_path}: {exc}; "
        "next action: remove caller-supplied HAPAX_ROOT_REQUIRED_LOCK_* values and rerun",
        file=sys.stderr,
    )
    raise SystemExit(1) from exc
if (
    not stat.S_ISDIR(parent_inode.st_mode)
    or parent_inode.st_uid != os.geteuid()
    or parent_inode.st_mode & 0o022
    or (state_inode.st_dev, state_inode.st_ino)
    != (parent_inode.st_dev, parent_inode.st_ino)
    or (bound_inode.st_dev, bound_inode.st_ino)
    != (state_inode.st_dev, state_inode.st_ino)
    or (lexical_inode.st_dev, lexical_inode.st_ino)
    != (state_inode.st_dev, state_inode.st_ino)
    or not stat.S_ISREG(inode.st_mode)
    or not stat.S_ISREG(path_inode.st_mode)
    or (inode.st_dev, inode.st_ino) != (path_inode.st_dev, path_inode.st_ino)
    or inode.st_uid != os.geteuid()
    or inode.st_nlink != 1
    or inode.st_mode & 0o022
):
    os.close(parent_fd)
    print(
        f"OOM installer refused invalid shared lock descriptor for {lock_path}; expected the "
        "caller-owned, single-link, non-group-writable regular path inode; next action: "
        "remove caller-supplied HAPAX_ROOT_REQUIRED_LOCK_* values and rerun",
        file=sys.stderr,
    )
    raise SystemExit(1)
os.fchmod(fd, 0o600)
fcntl.flock(fd, fcntl.LOCK_EX)
locked_inode = os.fstat(fd)
locked_path_inode = os.stat(lock_base, dir_fd=parent_fd, follow_symlinks=False)
locked_lexical_inode = os.stat(lexical_root, follow_symlinks=False)
if (
    (locked_inode.st_dev, locked_inode.st_ino)
    != (locked_path_inode.st_dev, locked_path_inode.st_ino)
    or locked_inode.st_uid != os.geteuid()
    or locked_inode.st_nlink != 1
    or stat.S_IMODE(locked_inode.st_mode) != 0o600
    or (locked_lexical_inode.st_dev, locked_lexical_inode.st_ino)
    != (state_inode.st_dev, state_inode.st_ino)
):
    os.close(parent_fd)
    print(
        f"OOM installer shared lock path changed during acquisition for {lock_path}; "
        "next action: stop the competing state mutation and rerun",
        file=sys.stderr,
    )
    raise SystemExit(1)
os.close(parent_fd)
PY
    mkdir -p "$ROOT_REQUIRED_DEFER_ROOT" || return 1
    migrate_legacy_root_required_state || return 1
}

reexec_with_safe_root_required_lock() {
    [ -z "${HAPAX_ROOT_REQUIRED_LOCK_FD:-}" ] || return 0
    exec /usr/bin/python3 - \
        "$ROOT_REQUIRED_STATE_ROOT" "$ROOT_REQUIRED_LOCK_FILE" \
        "$0" "${ORIGINAL_ARGS[@]}" <<'PY'
from __future__ import annotations

import fcntl
import os
import stat
import sys


def host_root_uid() -> int:
    with open("/proc/self/uid_map", encoding="ascii") as stream:
        for line in stream:
            inside, outside, length = (int(field) for field in line.split())
            if outside <= 0 < outside + length:
                return inside - outside
    return 65534


state_root, lock_path, script, *args = sys.argv[1:]
lock_parent = os.path.dirname(lock_path) or "."
lock_base = os.path.basename(lock_path)
lexical_root = os.path.abspath(os.path.normpath(state_root))
if (
    not os.path.isabs(state_root)
    or not os.path.isabs(lock_path)
    or not lock_base
    or os.path.abspath(os.path.normpath(lock_parent)) != lexical_root
):
    print(
        f"OOM installer refused invalid shared lock path {lock_path}; expected an absolute "
        ".lock inside the selected durable state root; next action: restore the canonical "
        "durable state path",
        file=sys.stderr,
    )
    raise SystemExit(1)
try:
    guard_fd = os.open(
        "/home",
        os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | os.O_NOFOLLOW,
    )
    guard_inode = os.fstat(guard_fd)
    published_guard = os.stat("/home", follow_symlinks=False)
    if (
        not stat.S_ISDIR(guard_inode.st_mode)
        or guard_inode.st_uid != host_root_uid()
        or guard_inode.st_mode & 0o022
        or (guard_inode.st_dev, guard_inode.st_ino)
        != (published_guard.st_dev, published_guard.st_ino)
    ):
        raise OSError("generation guard is not the immutable host anchor")
    fcntl.flock(guard_fd, fcntl.LOCK_EX)
    locked_guard = os.fstat(guard_fd)
    published_guard = os.stat("/home", follow_symlinks=False)
    if (locked_guard.st_dev, locked_guard.st_ino) != (
        published_guard.st_dev,
        published_guard.st_ino,
    ):
        raise OSError("generation-guard anchor changed during acquisition")
except OSError as exc:
    print(
        f"OOM installer cannot acquire the host-global state-generation guard: {exc}; "
        "next action: repair the immutable /home anchor and rerun",
        file=sys.stderr,
    )
    raise SystemExit(1) from exc
old_umask = os.umask(0o077)
try:
    os.makedirs(lexical_root, exist_ok=True)
finally:
    os.umask(old_umask)
try:
    parent_fd = os.open(
        lexical_root,
        os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | os.O_NOFOLLOW,
    )
except OSError as exc:
    print(
        f"OOM installer refused unsafe shared lock parent {lock_parent}: {exc}; next action: "
        "restore a caller-owned physical durable state directory and rerun as the target account",
        file=sys.stderr,
    )
    raise SystemExit(1) from exc
parent_inode = os.fstat(parent_fd)
if (
    not stat.S_ISDIR(parent_inode.st_mode)
    or parent_inode.st_uid != os.geteuid()
    or parent_inode.st_mode & 0o022
):
    print(
        f"OOM installer refused unsafe shared lock parent {lock_parent}; expected a "
        "caller-owned, non-group-writable physical directory; next action: repair "
        "the durable root-required state directory and rerun as the target account",
        file=sys.stderr,
    )
    raise SystemExit(1)
try:
    fd = os.open(
        lock_base,
        os.O_CLOEXEC | os.O_CREAT | os.O_NOFOLLOW | os.O_RDWR,
        0o600,
        dir_fd=parent_fd,
    )
except OSError as exc:
    os.close(parent_fd)
    print(
        f"OOM installer refused unsafe shared lock {lock_path}: {exc}; "
        "next action: remove only a confirmed symlink/non-regular lock and rerun as the target account",
        file=sys.stderr,
    )
    raise SystemExit(1) from exc
try:
    inode = os.fstat(fd)
    if (
        not stat.S_ISREG(inode.st_mode)
        or inode.st_uid != os.geteuid()
        or inode.st_nlink != 1
        or inode.st_mode & 0o022
    ):
        print(
            f"OOM installer refused unsafe shared lock inode {lock_path}; expected one "
            "regular, caller-owned, non-group-writable file; next action: remove only a "
            "confirmed unsafe lock and rerun as the target account",
            file=sys.stderr,
        )
        raise SystemExit(1)
    os.fchmod(fd, 0o600)
    fcntl.flock(fd, fcntl.LOCK_EX)
    locked_inode = os.fstat(fd)
    locked_path_inode = os.stat(lock_base, dir_fd=parent_fd, follow_symlinks=False)
    published_parent_inode = os.stat(lexical_root, follow_symlinks=False)
    if (
        (locked_inode.st_dev, locked_inode.st_ino)
        != (locked_path_inode.st_dev, locked_path_inode.st_ino)
        or locked_inode.st_uid != os.geteuid()
        or locked_inode.st_nlink != 1
        or stat.S_IMODE(locked_inode.st_mode) != 0o600
        or (parent_inode.st_dev, parent_inode.st_ino)
        != (published_parent_inode.st_dev, published_parent_inode.st_ino)
    ):
        print(
            f"OOM installer shared lock path changed during acquisition for {lock_path}; "
            "next action: stop the competing state mutation and rerun",
            file=sys.stderr,
        )
        raise SystemExit(1)
    env = os.environ.copy()
    env.pop("HAPAX_ROOT_REQUIRED_LOCK_HELD", None)
    stable_root = f"/proc/{os.getpid()}/fd/{parent_fd}"
    env["HAPAX_ROOT_REQUIRED_STATE_ROOT"] = stable_root
    env["HAPAX_ROOT_REQUIRED_LOCK_FILE"] = lock_path
    env["HAPAX_ROOT_REQUIRED_LOCK_FD"] = str(fd)
    env["HAPAX_ROOT_REQUIRED_STATE_FD"] = str(parent_fd)
    env["HAPAX_ROOT_REQUIRED_GENERATION_GUARD_FD"] = str(guard_fd)
    env["HAPAX_ROOT_REQUIRED_STATE_LEXICAL_ROOT"] = lexical_root
    env["HAPAX_ROOT_REQUIRED_LOCK_LEXICAL_PATH"] = lock_path
    executable = os.path.abspath(script)
    os.set_inheritable(fd, True)
    os.set_inheritable(parent_fd, True)
    os.set_inheritable(guard_fd, True)
    os.execve(executable, [executable, *args], env)
except OSError as exc:
    print(
        f"OOM installer could not re-exec under the shared lock: {exc}; next action: "
        "leave the deferral pending and rerun its exact authenticated command",
        file=sys.stderr,
    )
    raise SystemExit(1) from exc
finally:
    os.close(fd)
    os.close(parent_fd)
    os.close(guard_fd)
PY
}

read_safe_root_required_sha_receipt() {
    local receipt="$1" kind="$2"
    /usr/bin/python3 -I - "$receipt" "$kind" <<'PY'
from __future__ import annotations

import os
import re
import stat
import sys

receipt, kind = sys.argv[1:]
parent = os.path.dirname(receipt) or "."
base = os.path.basename(receipt)


def refuse(message: str) -> None:
    print(
        f"unsafe {kind} root-required receipt {receipt}: {message}; next action: "
        "repair only the caller-owned receipt state and rerun the exact governed package",
        file=sys.stderr,
    )
    raise SystemExit(1)


def snapshot(inode: os.stat_result) -> tuple[int, ...]:
    return (
        inode.st_dev,
        inode.st_ino,
        inode.st_uid,
        inode.st_gid,
        inode.st_nlink,
        stat.S_IMODE(inode.st_mode),
        inode.st_size,
        inode.st_mtime_ns,
        inode.st_ctime_ns,
    )


parent_fd = -1
fd = -1
try:
    if not os.path.isabs(receipt) or not base:
        refuse("the receipt path must be absolute and name one file")
    parent_fd = os.open(
        parent,
        os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | os.O_NOFOLLOW,
    )
    parent_inode = os.fstat(parent_fd)
    if (
        not stat.S_ISDIR(parent_inode.st_mode)
        or parent_inode.st_uid != os.geteuid()
        or parent_inode.st_mode & 0o022
    ):
        refuse("the parent is not a caller-owned, non-group-writable physical directory")
    expected = os.stat(base, dir_fd=parent_fd, follow_symlinks=False)
    if (
        not stat.S_ISREG(expected.st_mode)
        or expected.st_uid != os.geteuid()
        or expected.st_nlink != 1
        or expected.st_mode & 0o022
        or expected.st_size != 41
    ):
        refuse(
            f"owner={expected.st_uid} links={expected.st_nlink} "
            f"mode={stat.S_IMODE(expected.st_mode):04o} size={expected.st_size}"
        )
    fd = os.open(
        base,
        os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC | os.O_NOFOLLOW,
        dir_fd=parent_fd,
    )
    opened = os.fstat(fd)
    if snapshot(opened) != snapshot(expected):
        refuse("the receipt inode or metadata changed while opening")
    chunks: list[bytes] = []
    remaining = 42
    while remaining:
        chunk = os.read(fd, remaining)
        if not chunk:
            break
        chunks.append(chunk)
        remaining -= len(chunk)
    data = b"".join(chunks)
    after = os.fstat(fd)
    published = os.stat(base, dir_fd=parent_fd, follow_symlinks=False)
except OSError as exc:
    refuse(f"cannot inspect or read the receipt: {exc}")
finally:
    if fd >= 0:
        os.close(fd)
    if parent_fd >= 0:
        os.close(parent_fd)
if snapshot(after) != snapshot(opened) or snapshot(published) != snapshot(after):
    refuse("the receipt inode or metadata changed while reading")
if re.fullmatch(rb"[0-9a-f]{40}\n", data) is None:
    refuse("content is not exactly 40 lowercase hex characters and one newline")
print(data[:-1].decode("ascii"))
PY
}

write_root_required_sha_receipt() {
    local receipt="$1" sha="$2" publication_mode="${3:-publish}"
    /usr/bin/python3 -I - "$receipt" "$sha" "$publication_mode" <<'PY'
from __future__ import annotations

import os
import re
import secrets
import stat
import sys

receipt, sha, publication_mode = sys.argv[1:]
payload = f"{sha}\n".encode()
parent = os.path.dirname(receipt)
base = os.path.basename(receipt)
temp: str | None = None
parent_fd = -1


def refuse(message: str) -> None:
    print(
        f"root-required receipt publication refused for {receipt}: {message}; next action: "
        "repair the caller-owned receipt state and rerun the exact governed package",
        file=sys.stderr,
    )
    raise SystemExit(1)


def snapshot(inode: os.stat_result) -> tuple[int, ...]:
    return (
        inode.st_dev,
        inode.st_ino,
        inode.st_uid,
        inode.st_gid,
        inode.st_nlink,
        stat.S_IMODE(inode.st_mode),
        inode.st_size,
        inode.st_mtime_ns,
        inode.st_ctime_ns,
    )


try:
    if (
        not os.path.isabs(receipt)
        or not base
        or re.fullmatch(r"[0-9a-f]{40}", sha) is None
        or publication_mode not in {"publish", "preserve-canonical"}
    ):
        refuse("the path must be absolute and the value exactly 40 lowercase hex characters")
    old_umask = os.umask(0o077)
    try:
        os.makedirs(parent, mode=0o700, exist_ok=True)
    finally:
        os.umask(old_umask)
    parent_fd = os.open(
        parent,
        os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | os.O_NOFOLLOW,
    )
    parent_inode = os.fstat(parent_fd)
    if parent_inode.st_uid != os.geteuid() or parent_inode.st_mode & 0o022:
        refuse("the receipt directory is not caller-owned and non-group-writable")
    if publication_mode == "preserve-canonical":
        expected = os.stat(base, dir_fd=parent_fd, follow_symlinks=False)
        if (
            not stat.S_ISREG(expected.st_mode)
            or expected.st_uid != os.geteuid()
            or expected.st_nlink != 1
            or expected.st_mode & 0o022
            or expected.st_size != len(payload)
        ):
            refuse("the existing receipt is unsafe to normalize")
        fd = os.open(
            base,
            os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC | os.O_NOFOLLOW,
            dir_fd=parent_fd,
        )
        try:
            opened = os.fstat(fd)
            chunks: list[bytes] = []
            remaining = len(payload) + 1
            while remaining:
                chunk = os.read(fd, remaining)
                if not chunk:
                    break
                chunks.append(chunk)
                remaining -= len(chunk)
            observed = b"".join(chunks)
            after = os.fstat(fd)
            published = os.stat(base, dir_fd=parent_fd, follow_symlinks=False)
        finally:
            os.close(fd)
        if (
            snapshot(expected) != snapshot(opened)
            or snapshot(opened) != snapshot(after)
            or snapshot(after) != snapshot(published)
            or observed != payload
        ):
            refuse("the existing receipt changed during normalization")
        if stat.S_IMODE(after.st_mode) == 0o600:
            raise SystemExit(0)
    temp = f".{base}.tmp.{os.getpid()}.{secrets.token_hex(8)}"
    fd = os.open(
        temp,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
        0o600,
        dir_fd=parent_fd,
    )
    try:
        os.fchmod(fd, 0o600)
        view = memoryview(payload)
        while view:
            written = os.write(fd, view)
            if written <= 0:
                refuse("the temporary receipt write made no progress")
            view = view[written:]
        os.fsync(fd)
        inode = os.fstat(fd)
        if (
            not stat.S_ISREG(inode.st_mode)
            or inode.st_uid != os.geteuid()
            or inode.st_nlink != 1
            or stat.S_IMODE(inode.st_mode) != 0o600
            or inode.st_size != len(payload)
        ):
            refuse("the temporary receipt inode failed its owner/link/mode/size check")
    finally:
        os.close(fd)
    os.replace(temp, base, src_dir_fd=parent_fd, dst_dir_fd=parent_fd)
    temp = None
    expected = os.stat(base, dir_fd=parent_fd, follow_symlinks=False)
    fd = os.open(
        base,
        os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC | os.O_NOFOLLOW,
        dir_fd=parent_fd,
    )
    try:
        opened = os.fstat(fd)
        chunks: list[bytes] = []
        remaining = len(payload) + 1
        while remaining:
            chunk = os.read(fd, remaining)
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        observed = b"".join(chunks)
        after = os.fstat(fd)
        published = os.stat(base, dir_fd=parent_fd, follow_symlinks=False)
    finally:
        os.close(fd)
    if (
        snapshot(expected) != snapshot(opened)
        or snapshot(opened) != snapshot(after)
        or snapshot(after) != snapshot(published)
        or not stat.S_ISREG(after.st_mode)
        or after.st_uid != os.geteuid()
        or after.st_nlink != 1
        or stat.S_IMODE(after.st_mode) != 0o600
        or after.st_size != len(payload)
        or observed != payload
    ):
        refuse("the published receipt failed its stable path/inode/mode/content readback")
    os.fsync(parent_fd)
except OSError as exc:
    refuse(f"atomic mode-0600 publication failed: {exc}")
finally:
    if temp is not None and parent_fd >= 0:
        try:
            os.unlink(temp, dir_fd=parent_fd)
        except FileNotFoundError:
            pass
    if parent_fd >= 0:
        os.close(parent_fd)
PY
}

migrate_legacy_root_required_state() {
    local label legacy receipt desired temp receipt_sha
    legacy="$ROOT_REQUIRED_DEFER_ROOT/current-source"
    if [ ! -e "$ROOT_REQUIRED_INSTALLED_SOURCE_ROOT" ] && [ -d "$legacy" ]; then
        mkdir -p "$(dirname "$ROOT_REQUIRED_INSTALLED_SOURCE_ROOT")" || return 1
        temp="$ROOT_REQUIRED_INSTALLED_SOURCE_ROOT.migrate.$$"
        rm -rf "$temp" || return 1
        cp -a "$legacy" "$temp" || return 1
        mv "$temp" "$ROOT_REQUIRED_INSTALLED_SOURCE_ROOT" || return 1
        echo "migrated root-required installed-source snapshot to durable state"
    fi
    for label in oom-containment apcupsd-power-alerts; do
        legacy="$ROOT_REQUIRED_DEFER_ROOT/installed-receipts/$label.sha"
        receipt="$ROOT_REQUIRED_INSTALLED_RECEIPT_ROOT/$label.sha"
        if [ -e "$receipt" ] || [ -L "$receipt" ]; then
            read_safe_root_required_sha_receipt "$receipt" installed >/dev/null || return 1
        elif [ "$legacy" != "$receipt" ] && { [ -e "$legacy" ] || [ -L "$legacy" ]; }; then
            receipt_sha="$(read_safe_root_required_sha_receipt "$legacy" legacy-installed)" || return 1
            write_root_required_sha_receipt \
                "$receipt" "$receipt_sha" || return 1
            echo "migrated $label installed-package receipt to durable state"
        fi
        receipt="$ROOT_REQUIRED_INSTALLED_RECEIPT_ROOT/$label.sha"
        desired="$ROOT_REQUIRED_DESIRED_RECEIPT_ROOT/$label.sha"
        if [ -e "$desired" ] || [ -L "$desired" ]; then
            read_safe_root_required_sha_receipt "$desired" desired >/dev/null || return 1
        elif [ -e "$receipt" ] || [ -L "$receipt" ]; then
            receipt_sha="$(read_safe_root_required_sha_receipt "$receipt" installed)" || return 1
            write_root_required_sha_receipt \
                "$desired" "$receipt_sha" || return 1
            echo "initialized $label desired-package receipt from installed state"
        fi
    done
}

package_commits_equivalent() {
    local installed_sha="$1" candidate_sha="$2" rel installed_mode candidate_mode
    cmp -s \
        <(git -C "$ROOT_REQUIRED_GIT_REPO" show "$installed_sha:$package_manifest_source" 2>/dev/null) \
        <(git -C "$ROOT_REQUIRED_GIT_REPO" show "$candidate_sha:$package_manifest_source" 2>/dev/null) || return 1
    for rel in "${package_files[@]}"; do
        git -C "$ROOT_REQUIRED_GIT_REPO" cat-file -e "$installed_sha:$rel" 2>/dev/null || return 1
        git -C "$ROOT_REQUIRED_GIT_REPO" cat-file -e "$candidate_sha:$rel" 2>/dev/null || return 1
        cmp -s \
            <(git -C "$ROOT_REQUIRED_GIT_REPO" show "$installed_sha:$rel") \
            <(git -C "$ROOT_REQUIRED_GIT_REPO" show "$candidate_sha:$rel") || return 1
        installed_mode="$(git -C "$ROOT_REQUIRED_GIT_REPO" ls-tree "$installed_sha" -- "$rel" | awk 'NR == 1 {print $1}')"
        candidate_mode="$(git -C "$ROOT_REQUIRED_GIT_REPO" ls-tree "$candidate_sha" -- "$rel" | awk 'NR == 1 {print $1}')"
        [ -n "$installed_mode" ] && [ "$installed_mode" = "$candidate_mode" ] || return 1
    done
}

validate_candidate_against_receipt() {
    local receipt_kind="$1" receipt_path="$2" receipt_sha
    if [ ! -e "$receipt_path" ] && [ ! -L "$receipt_path" ]; then
        return 0
    fi
    receipt_sha="$(read_safe_root_required_sha_receipt "$receipt_path" "$receipt_kind")" || return 1
    [ "$receipt_sha" != "$ROOT_REQUIRED_PACKAGE_SHA" ] || return 0
    if ! git -C "$ROOT_REQUIRED_GIT_REPO" cat-file -e "$receipt_sha^{commit}" 2>/dev/null; then
        echo "cannot validate OOM package order for $receipt_kind=$receipt_sha candidate=$ROOT_REQUIRED_PACKAGE_SHA; next action: fetch both commits into $ROOT_REQUIRED_GIT_REPO, rerun hapax-post-merge-deploy, and use its live next-action command" >&2
        return 1
    fi
    if git -C "$ROOT_REQUIRED_GIT_REPO" merge-base --is-ancestor "$receipt_sha" "$ROOT_REQUIRED_PACKAGE_SHA"; then
        return 0
    fi
    if git -C "$ROOT_REQUIRED_GIT_REPO" merge-base --is-ancestor "$ROOT_REQUIRED_PACKAGE_SHA" "$receipt_sha"; then
        SKIP_SUPERSEDED_INSTALL=1
        echo "root-required OOM package $ROOT_REQUIRED_PACKAGE_SHA is superseded by $receipt_kind $receipt_sha; live files and durable desired state will not be rolled back"
        return 0
    fi
    if package_commits_equivalent "$receipt_sha" "$ROOT_REQUIRED_PACKAGE_SHA"; then
        echo "root-required OOM package and $receipt_kind receipt are ancestry-divergent but package-content equivalent; accepting squash/rebase transition"
        return 0
    fi
    echo "refusing divergent OOM package $receipt_kind=$receipt_sha candidate=$ROOT_REQUIRED_PACKAGE_SHA; next action: dispatch a governed reconciliation from current main and leave this RUNBOOK pending" >&2
    return 1
}

validate_root_required_package_order() {
    local staged_sha package_sha_file
    package_sha_file="$SOURCE/.hapax-root-required-package-sha"
    if [ -f "$package_sha_file" ]; then
        staged_sha="$(tr -d '[:space:]' < "$package_sha_file")"
        if [ -z "$ROOT_REQUIRED_PACKAGE_SHA" ]; then
            ROOT_REQUIRED_PACKAGE_SHA="$staged_sha"
        elif [ "$ROOT_REQUIRED_PACKAGE_SHA" != "$staged_sha" ]; then
            echo "root-required OOM package SHA mismatch: env=$ROOT_REQUIRED_PACKAGE_SHA staged=$staged_sha; next action: rerun hapax-post-merge-deploy for the desired SHA and use only its live next-action command" >&2
            return 1
        fi
    fi
    if [ -z "$ROOT_REQUIRED_PACKAGE_SHA" ]; then
        ROOT_REQUIRED_PACKAGE_SHA="$(git -C "$SOURCE" rev-parse HEAD 2>/dev/null || true)"
    fi
    if [ -z "$ROOT_REQUIRED_PACKAGE_SHA" ]; then
        echo "OOM install source has no package SHA; next action: run from a clean Git worktree or rerun hapax-post-merge-deploy for the desired SHA" >&2
        return 1
    fi
    [[ "$ROOT_REQUIRED_PACKAGE_SHA" =~ ^[0-9a-f]{40}$ ]] || {
        echo "invalid root-required package SHA: $ROOT_REQUIRED_PACKAGE_SHA; next action: rerun hapax-post-merge-deploy for the desired receipt SHA and use its live next-action command" >&2
        return 1
    }
    git -C "$ROOT_REQUIRED_GIT_REPO" cat-file -e "$ROOT_REQUIRED_PACKAGE_SHA^{commit}" 2>/dev/null || {
        echo "root-required OOM package commit is unavailable: $ROOT_REQUIRED_PACKAGE_SHA; next action: fetch it into $ROOT_REQUIRED_GIT_REPO, rerun hapax-post-merge-deploy, and use its live next-action command" >&2
        return 1
    }
    validate_candidate_against_receipt installed "$ROOT_REQUIRED_RECEIPT" || return 1
    validate_candidate_against_receipt desired "$ROOT_REQUIRED_DESIRED_RECEIPT" || return 1
}

record_root_required_package_receipt() {
    write_root_required_sha_receipt \
        "$ROOT_REQUIRED_RECEIPT" "$ROOT_REQUIRED_PACKAGE_SHA" || return 1
    write_root_required_sha_receipt \
        "$ROOT_REQUIRED_DESIRED_RECEIPT" "$ROOT_REQUIRED_PACKAGE_SHA" || return 1
}

normalize_existing_root_required_package_receipts() {
    local receipt receipt_sha
    for receipt in "$ROOT_REQUIRED_RECEIPT" "$ROOT_REQUIRED_DESIRED_RECEIPT"; do
        if [ -e "$receipt" ] || [ -L "$receipt" ]; then
            receipt_sha="$(read_safe_root_required_sha_receipt "$receipt" existing)" || return 1
            write_root_required_sha_receipt \
                "$receipt" "$receipt_sha" preserve-canonical || return 1
        fi
    done
}

expected_package_git_mode() {
    case "$1" in
        scripts/*) printf '%s\n' 100755 ;;
        *) printf '%s\n' 100644 ;;
    esac
}

validate_package_source_matches_commit() {
    local rel git_mode expected_mode source_path
    for rel in "${package_files[@]}"; do
        source_path="$(src_path "$rel")" || return 1
        git_mode="$(git -C "$ROOT_REQUIRED_GIT_REPO" ls-tree "$ROOT_REQUIRED_PACKAGE_SHA" -- "$rel" | awk 'NR == 1 {print $1}')"
        expected_mode="$(expected_package_git_mode "$rel")"
        if [ "$git_mode" != "$expected_mode" ]; then
            echo "OOM package Git mode violates the destination contract at $rel: actual=$git_mode expected=$expected_mode; next action: restore the tracked executable class and rerun from a clean Git worktree or a fresh post-merge live command" >&2
            return 1
        fi
        if ! /usr/bin/python3 - "$source_path" "$git_mode" "$AUTHENTICATED_SEALED_SOURCE" <<'PY'
from __future__ import annotations

import os
import stat
import sys

path, git_mode, sealed = sys.argv[1:]
try:
    inode = os.stat(path) if sealed == "1" else os.lstat(path)
except OSError:
    raise SystemExit(1)
if not stat.S_ISREG(inode.st_mode):
    raise SystemExit(1)
worktree_mode = "100755" if stat.S_IMODE(inode.st_mode) & 0o111 else "100644"
if git_mode not in {"100644", "100755"} or worktree_mode != git_mode:
    raise SystemExit(1)
PY
        then
            echo "OOM install source is not a regular file with the claimed Git mode at $rel; next action: discard the substituted or mode-drifted package and rerun from a clean Git worktree or a fresh post-merge live command" >&2
            return 1
        fi
        if ! cmp -s <(git -C "$ROOT_REQUIRED_GIT_REPO" show "$ROOT_REQUIRED_PACKAGE_SHA:$rel") "$source_path"; then
            echo "OOM install source does not match claimed commit $ROOT_REQUIRED_PACKAGE_SHA at $rel; next action: discard the modified package and rerun from a clean Git worktree or a fresh post-merge live command" >&2
            return 1
        fi
    done
}

validate_no_unhandled_package_removals() {
    local installed_sha rel
    if [ ! -e "$ROOT_REQUIRED_RECEIPT" ] && [ ! -L "$ROOT_REQUIRED_RECEIPT" ]; then
        return 0
    fi
    installed_sha="$(read_safe_root_required_sha_receipt "$ROOT_REQUIRED_RECEIPT" installed)" \
        || return 1
    if ! git -C "$ROOT_REQUIRED_GIT_REPO" cat-file -e "$installed_sha:$package_manifest_source" 2>/dev/null; then
        echo "installed OOM commit predates the versioned ownership manifest; package-removal guard is using the one-time legacy bridge"
        return 0
    fi
    while IFS= read -r rel; do
        if ! awk -v wanted="$rel" 'NF && $1 !~ /^#/ && $1 == wanted { found = 1 } END { exit !found }' "$(src_path "$package_manifest_source")"; then
            echo "refusing OOM package removal or rename of $rel; next action: retain the owned path or add explicit governed live-removal handling before advancing receipts" >&2
            return 1
        fi
    done < <(
        git -C "$ROOT_REQUIRED_GIT_REPO" show "$installed_sha:$package_manifest_source" |
            awk 'NF && $1 !~ /^#/ {print $1}'
    )
}

validate_root_required_deferral_dir() {
    local drain="$1" root_real drain_real expected_real source_real
    [ -n "$drain" ] || return 0
    case "$drain" in
        /*) ;;
        *)
            echo "refusing relative root-required drain dir: $drain; next action: set HAPAX_ROOT_REQUIRED_DRAIN_DIR to the absolute deferral directory named in its RUNBOOK.txt" >&2
            return 1
            ;;
    esac
    [ -f "$drain/RUNBOOK.txt" ] || {
        echo "root-required drain dir missing RUNBOOK.txt: $drain; next action: inspect the staged deferral and rerun with the exact directory named by hapax-post-merge-deploy" >&2
        return 1
    }
    root_real="$(canonical_dir "$ROOT_REQUIRED_DEFER_ROOT")" || {
        echo "root-required defer root missing: $ROOT_REQUIRED_DEFER_ROOT; next action: set HAPAX_POST_MERGE_ROOT_DEFER_DIR to the parent of the requested deferral" >&2
        return 1
    }
    drain_real="$(canonical_dir "$drain")" || {
        echo "root-required drain dir missing: $drain; next action: clear HAPAX_ROOT_REQUIRED_DRAIN_DIR if it was already drained, or use the extant staged directory" >&2
        return 1
    }
    case "$drain_real" in
        "$root_real"/*) ;;
        *)
            echo "refusing root-required drain dir outside defer root: $drain; next action: set HAPAX_POST_MERGE_ROOT_DEFER_DIR to its governed parent and retry" >&2
            return 1
            ;;
    esac
    expected_real="$(canonical_dir "$ROOT_REQUIRED_DEFER_ROOT/$ROOT_REQUIRED_PACKAGE_SHA/oom-containment")" || {
        echo "expected OOM deferral package is missing: $ROOT_REQUIRED_DEFER_ROOT/$ROOT_REQUIRED_PACKAGE_SHA/oom-containment; next action: rerun hapax-post-merge-deploy for $ROOT_REQUIRED_PACKAGE_SHA and use its live next-action command" >&2
        return 1
    }
    source_real="$(canonical_dir "$SOURCE")" || {
        echo "OOM install source is missing: $SOURCE; next action: rerun hapax-post-merge-deploy for $ROOT_REQUIRED_PACKAGE_SHA and use its live next-action command" >&2
        return 1
    }
    if [ "$drain_real" != "$expected_real" ] || [ "$source_real" != "$expected_real" ]; then
        echo "refusing mismatched OOM deferral drain: source=$source_real drain=$drain_real expected=$expected_real; next action: rerun hapax-post-merge-deploy for $ROOT_REQUIRED_PACKAGE_SHA and use only its live next-action command" >&2
        return 1
    fi
    ROOT_REQUIRED_DRAIN_REAL="$drain_real"
}

validate_root_required_deferral() {
    [ -n "${HAPAX_ROOT_REQUIRED_DRAIN_DIR:-}" ] || return 0
    validate_root_required_deferral_dir "$HAPAX_ROOT_REQUIRED_DRAIN_DIR"
}

drain_root_required_deferral() {
    [ -n "${HAPAX_ROOT_REQUIRED_DRAIN_DIR:-}" ] || return 0
    [ -n "${ROOT_REQUIRED_DRAIN_REAL:-}" ] || validate_root_required_deferral || return 1
    mv -fT -- "$ROOT_REQUIRED_DRAIN_REAL/RUNBOOK.txt" \
        "$ROOT_REQUIRED_DRAIN_REAL/DRAINED.txt" || return 1
    echo "root-required deferral marked drained: $ROOT_REQUIRED_DRAIN_REAL"
}

