declare -A ROOT_REQUIRED_SEALED_SOURCES=()

load_authenticated_sealed_sources() {
    local raw="$ROOT_REQUIRED_SEALED_SOURCE_FDS" index
    local -a source_fds=()
    if [ "$AUTHENTICATED_SEALED_SOURCE" -eq 0 ]; then
        if [ -n "$raw" ] || [ -n "$ROOT_REQUIRED_LEGACY_FINALIZE_GATE" ] \
            || [ -n "$RUNTIME_AUTHORITY_TASK_SHA256" ] \
            || [ -n "$LOCAL_JUDGE_CAP_RECEIPT_SHA256" ]; then
            echo "refusing sealed-source, authority-snapshot, or retired finalizer descriptors without the authenticated helper protocol flag; next action: remove helper-owned descriptor variables and regenerate the live command with hapax-post-merge-deploy" >&2
            return 1
        fi
        return 0
    fi
    if [ -n "$ROOT_REQUIRED_LEGACY_FINALIZE_GATE" ]; then
        echo "refusing the retired caller-supplied finalizer protocol; next action: remove HAPAX_ROOT_REQUIRED_FINALIZE_GATE and regenerate the live command with hapax-post-merge-deploy" >&2
        return 1
    fi
    if [ "$INSTALL" -ne 1 ] || [ -z "$raw" ] || [ -z "$RUNTIME_AUTHORITY_TASK" ] \
        || ! [[ "$ROOT_REQUIRED_PACKAGE_SHA" =~ ^[0-9a-f]{40}$ ]] \
        || ! [[ "$RUNTIME_AUTHORITY_TASK_SHA256" =~ ^[0-9a-f]{64}$ ]]; then
        echo "authenticated sealed-source mode requires --install, an exact 40-hex package SHA, helper-owned source descriptors, HAPAX_RUNTIME_AUTHORITY_TASK, and its helper-bound SHA-256 snapshot; next action: regenerate the live command with hapax-post-merge-deploy" >&2
        return 1
    fi
    IFS=: read -r -a source_fds <<< "$raw"
    if [ "${#source_fds[@]}" -ne "${#package_files[@]}" ]; then
        echo "authenticated OOM source descriptor count mismatch: actual=${#source_fds[@]} expected=${#package_files[@]}; next action: discard the altered invocation and regenerate it with hapax-post-merge-deploy" >&2
        return 1
    fi
    if ! /usr/bin/python3 -I - "${source_fds[@]}" <<'PY'
from __future__ import annotations

import fcntl
import os
import re
import stat
import sys

required = fcntl.F_SEAL_SEAL | fcntl.F_SEAL_SHRINK | fcntl.F_SEAL_GROW | fcntl.F_SEAL_WRITE
source_paths = sys.argv[1:]
holder_pids: set[str] = set()
for path in source_paths:
    match = re.fullmatch(r"/proc/([1-9][0-9]*)/fd/([0-9]+)", path)
    if match is None:
        raise SystemExit(1)
    holder_pids.add(match.group(1))
    try:
        target = os.readlink(path)
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
        try:
            inode = os.fstat(fd)
            seals = fcntl.fcntl(fd, fcntl.F_GET_SEALS)
        finally:
            os.close(fd)
    except OSError:
        raise SystemExit(1)
    if (
        not target.startswith("/memfd:hapax-")
        or not stat.S_ISREG(inode.st_mode)
        or inode.st_uid != os.geteuid()
        or seals & required != required
    ):
        raise SystemExit(1)
if len(holder_pids) != 1:
    raise SystemExit(1)
PY
    then
        echo "authenticated OOM source descriptors are unavailable, unsealed, or not caller-owned memfds; next action: leave the deferral pending and regenerate its live command with hapax-post-merge-deploy" >&2
        return 1
    fi
    for index in "${!package_files[@]}"; do
        ROOT_REQUIRED_SEALED_SOURCES["${package_files[$index]}"]="${source_fds[$index]}"
    done
}

bind_authenticated_release_root() {
    [ "$AUTHENTICATED_SEALED_SOURCE" -eq 1 ] || return 0
    production_destinations_selected || return 0
    local account_home activation_alias release_root release provided owner_uid git_root git_head
    account_home="$(/usr/bin/python3 -I -c 'import os, pwd; print(pwd.getpwuid(os.getuid()).pw_dir)')" || {
        echo "authenticated OOM install cannot derive the caller account home; next action: repair the local passwd entry and regenerate the live command with hapax-post-merge-deploy" >&2
        return 1
    }
    activation_alias="$account_home/.cache/hapax/source-activation/worktree"
    release_root="$account_home/.cache/hapax/source-activation/releases"
    release="$(/usr/bin/realpath -e -- "$activation_alias" 2>/dev/null)" || {
        echo "authenticated OOM install cannot resolve the canonical source-activation release; next action: reconcile source activation and regenerate the live command with hapax-post-merge-deploy" >&2
        return 1
    }
    provided="$(/usr/bin/realpath -e -- "$ROOT_REQUIRED_GIT_REPO" 2>/dev/null)" || {
        echo "authenticated OOM install cannot resolve its claimed Git repository; next action: discard the altered invocation and regenerate it with hapax-post-merge-deploy" >&2
        return 1
    }
    if [ "$release" != "$release_root/$ROOT_REQUIRED_PACKAGE_SHA" ] || [ "$provided" != "$release" ]; then
        echo "authenticated OOM install is not bound to the canonical exact-SHA release: activation=$release claimed=$provided expected=$release_root/$ROOT_REQUIRED_PACKAGE_SHA; next action: reconcile source activation and regenerate the live command with hapax-post-merge-deploy" >&2
        return 1
    fi
    owner_uid="$(/usr/bin/stat -c %u -- "$release" 2>/dev/null || true)"
    git_root="$(git -C "$release" rev-parse --show-toplevel 2>/dev/null || true)"
    git_root="$(/usr/bin/realpath -e -- "$git_root" 2>/dev/null || true)"
    git_head="$(git -C "$release" rev-parse --verify HEAD 2>/dev/null || true)"
    if [ "$owner_uid" != "$(/usr/bin/id -u)" ] || [ "$git_root" != "$release" ] \
        || [ "$git_head" != "$ROOT_REQUIRED_PACKAGE_SHA" ]; then
        echo "authenticated OOM install rejected an unowned or mismatched canonical release; next action: reconcile source-activation ownership and HEAD, then regenerate the live command with hapax-post-merge-deploy" >&2
        return 1
    fi
    ROOT_REQUIRED_GIT_REPO="$release"
}

run_authenticated_authority_gate() {
    [ "$AUTHENTICATED_SEALED_SOURCE" -eq 1 ] || return 0
    local cap_phase="${1:-candidate}" verifier
    local -a scopes=()
    case "$cap_phase" in
        candidate|applied|authority-only) ;;
        *)
            echo "invalid authenticated authority phase: $cap_phase; next action: regenerate the live command with hapax-post-merge-deploy" >&2
            return 1
            ;;
    esac
    verifier="$(src_path "$authority_verifier_source")" || return 1
    mapfile -t scopes < <(/usr/bin/awk '/^runtime:/ {print}' "$(src_path "$effect_descriptor_source")")
    if [ "${#scopes[@]}" -eq 0 ] || [ "$(printf '%s\n' "${scopes[@]}" | /usr/bin/sort -u | /usr/bin/wc -l)" -ne "${#scopes[@]}" ]; then
        echo "authenticated OOM effect scope set is empty or duplicated; next action: restore the exact effect descriptor and regenerate the live command with hapax-post-merge-deploy" >&2
        return 1
    fi
    /usr/bin/env -i \
        HOME="$TARGET_HOME" \
        PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/bin \
        LANG=C.UTF-8 \
        LC_ALL=C.UTF-8 \
        GIT_CONFIG_GLOBAL=/dev/null \
        GIT_CONFIG_NOSYSTEM=1 \
        GIT_NO_REPLACE_OBJECTS=1 \
        GIT_OPTIONAL_LOCKS=0 \
        PYTHONNOUSERSITE=1 \
        PYTHONSAFEPATH=1 \
        /usr/bin/bash --noprofile --norc -p "$verifier" \
        --verify-runtime-authority-snapshot-for-release \
        "$ROOT_REQUIRED_PACKAGE_SHA" "$RUNTIME_AUTHORITY_TASK" \
        "$RUNTIME_AUTHORITY_TASK_SHA256" "${scopes[@]}" || {
        echo "authenticated OOM runtime-authority recheck rejected; no further effect or receipt advancement is permitted; next action: restore the canonical runtime-authorized task and regenerate the live command with hapax-post-merge-deploy" >&2
        return 1
    }
    if [ "$cap_phase" != authority-only ] && [ "$HOST_PROFILE" = appendix ]; then
        if ! [[ "$LOCAL_JUDGE_CAP_RECEIPT_SHA256" =~ ^[0-9a-f]{64}$ ]]; then
            echo "authenticated OOM local-judge cap snapshot is absent or malformed; next action: regenerate the live command with hapax-post-merge-deploy" >&2
            return 1
        fi
        /usr/bin/env -i \
            HOME="$TARGET_HOME" \
            PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/bin \
            LANG=C.UTF-8 \
            LC_ALL=C.UTF-8 \
            GIT_CONFIG_GLOBAL=/dev/null \
            GIT_CONFIG_NOSYSTEM=1 \
            GIT_NO_REPLACE_OBJECTS=1 \
            GIT_OPTIONAL_LOCKS=0 \
            PYTHONNOUSERSITE=1 \
            PYTHONSAFEPATH=1 \
            HAPAX_ROOT_REQUIRED_STATE_ROOT="$ROOT_REQUIRED_STATE_ROOT" \
            HAPAX_ROOT_REQUIRED_LOCK_FILE="$ROOT_REQUIRED_LOCK_FILE" \
            HAPAX_ROOT_REQUIRED_LOCK_FD="$HAPAX_ROOT_REQUIRED_LOCK_FD" \
            HAPAX_ROOT_REQUIRED_STATE_FD="$HAPAX_ROOT_REQUIRED_STATE_FD" \
            HAPAX_ROOT_REQUIRED_GENERATION_GUARD_FD="$HAPAX_ROOT_REQUIRED_GENERATION_GUARD_FD" \
            HAPAX_ROOT_REQUIRED_STATE_LEXICAL_ROOT="$HAPAX_ROOT_REQUIRED_STATE_LEXICAL_ROOT" \
            HAPAX_ROOT_REQUIRED_LOCK_LEXICAL_PATH="$HAPAX_ROOT_REQUIRED_LOCK_LEXICAL_PATH" \
            HAPAX_ROOT_REQUIRED_LOCK_MODE=exclusive \
            /usr/bin/bash --noprofile --norc -p "$verifier" \
            --verify-local-judge-cap-receipt-snapshot \
            "$ROOT_REQUIRED_PACKAGE_SHA" "$cap_phase" \
            "$LOCAL_JUDGE_CAP_RECEIPT_SHA256" || {
            echo "authenticated OOM local-judge cap recheck rejected at phase $cap_phase; no further effect or receipt advancement is permitted; next action: rerun the governed cap canary and regenerate the live command with hapax-post-merge-deploy" >&2
            return 1
        }
    fi
}
