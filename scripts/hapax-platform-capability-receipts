    ],
    "claude": ["~/.claude/settings.json", "~/.claude.json", "CLAUDE.md"],
    "codex": ["~/.codex/config.toml", "~/.codex/AGENTS.md", "AGENTS.md"],
    "glmcp": [
        "scripts/hapax-glmcp-reviewer",
        "scripts/hapax-glmcp-quota-admission",
        "scripts/hapax-quota-telemetry-writer",
        "config/platform-capability-registry.json",
        "config/quota-spend-ledger-fixtures.json",
    ],
    "vibe": [
        "~/.vibe/config.toml",
        "~/.vibe/.env",
        "~/.cache/hapax/relay/onboarding-vbe.md",
    ],
}
SECRETISH_RE = re.compile(r"(?i)(api[_-]?key|token|secret|password|credential)([=:])(\S+)")
RETIRED_ANTIGRAV_PLATFORMS = frozenset({"antigrav", "antigravity", "gemini-cli"})


def parse_utc(value: str) -> datetime:
    raw = value.strip()
    if raw.endswith("Z"):
        raw = raw[:-1] + "+00:00"
    parsed = datetime.fromisoformat(raw)
    if parsed.tzinfo is None:
        return parsed.replace(tzinfo=UTC)
    return parsed.astimezone(UTC)


def iso_z(value: datetime) -> str:
    return value.astimezone(UTC).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def safe_text(value: str | None, *, limit: int = 500) -> str | None:
    if value is None:
        return None
    home = str(Path.home())
    sanitized = value.replace("\x00", "").replace(home, "~")
    sanitized = SECRETISH_RE.sub(r"\1\2<redacted>", sanitized)
    sanitized = " ".join(sanitized.split())
    if len(sanitized) > limit:
        return sanitized[: limit - 3] + "..."
    return sanitized


def display_path(path: Path) -> str:
    try:
        return str(path.expanduser().resolve()).replace(str(Path.home()), "~")
    except OSError:
        return str(path.expanduser()).replace(str(Path.home()), "~")


def resolve_ref(path_ref: str) -> Path:
    expanded = Path(path_ref).expanduser()
    if expanded.is_absolute():
        return expanded
    return REPO_ROOT / expanded


def launcher_command_path(route: PlatformCapabilityRoute) -> Path | None:
    """The sanctioned wrapper's command path, or None when the route declares no wrapper.

    A blank ``sanctioned_wrapper`` used to fall through ``shlex.split(...)[0]`` into a second,
    equally failing ``.split()[0]`` and raise IndexError out of the observer. No wrapper is a
    legitimate declared state (review finding on #4616); it is reported as missing, not crashed on.
    """
    wrapper = (route.sanctioned_wrapper or "").strip()
    if not wrapper:
        return None
    try:
        parts = shlex.split(wrapper)
    except ValueError:
        parts = wrapper.split()
    if not parts:
        return None
    return resolve_ref(parts[0])


def sha256_file(path: Path) -> str | None:
    if not path.is_file():
        return None
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def candidate_binaries(platform: str) -> list[str]:
    override = os.environ.get(f"HAPAX_{platform.upper()}_BIN", "").strip()
    if platform == "codex":
        candidates = []
        candidates.append(BINARY_BY_PLATFORM[platform])
        path_override = os.environ.get("HAPAX_CODEX_BIN_PATH", "").strip()
        if path_override:
            candidates.append(path_override)
        candidates.extend(
            [
                str(Path.home() / ".npm-global" / "bin" / "codex"),
                *(
                    [f"{os.environ['NPM_CONFIG_PREFIX'].rstrip('/')}/bin/codex"]
                    if os.environ.get("NPM_CONFIG_PREFIX")
                    else []
                ),
                str(Path.home() / ".local" / "share" / "npm" / "bin" / "codex"),
                "/usr/local/bin/codex",
            ]
        )
        return list(dict.fromkeys(candidates))
    candidates = [BINARY_BY_PLATFORM[platform]]
    if override:
        candidates.insert(0, override)
    return list(dict.fromkeys(candidates))


def resolve_binary(binary: str) -> str | None:
    path = Path(binary).expanduser()
    if path.is_absolute():
        return str(path) if path.is_file() and os.access(path, os.X_OK) else None
    if "/" in binary:
        resolved = resolve_ref(binary)
        return str(resolved) if resolved.is_file() and os.access(resolved, os.X_OK) else None
    return shutil.which(binary)


def resolve_platform_binary(platform: str) -> tuple[str, str | None, list[str]]:
    attempted: list[str] = []
    binary = BINARY_BY_PLATFORM[platform]
    resolved = None
    for candidate in candidate_binaries(platform):
        attempted.append(candidate)
        resolved = resolve_binary(candidate)
        if resolved is not None:
            binary = candidate
            break
    return binary, resolved, attempted


def observe_cli(platform: str, *, timeout: float) -> CliEvidence:
    binary, resolved, attempted = resolve_platform_binary(platform)
    if resolved is None:
        return CliEvidence(
            binary=binary,
            available=False,
            error=f"{binary} not found; tried {', '.join(attempted)}",
        )
    command = [resolved, *VERSION_ARGS_BY_PLATFORM[platform]]
    try:
        result = subprocess.run(
            command,
            check=False,
            text=True,
            capture_output=True,
            timeout=timeout,
            env={**os.environ, "NO_COLOR": "1"},
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return CliEvidence(binary=binary, available=False, error=safe_text(str(exc)))
    output = safe_text(result.stdout or result.stderr)
    if result.returncode != 0:
        return CliEvidence(
            binary=binary,
            available=False,
            version=output,
            error=safe_text(result.stderr or result.stdout or f"exit {result.returncode}"),
        )
    return CliEvidence(binary=binary, available=True, version=output)


def codex_exec_auth_sentinel_observed(stdout: str) -> bool:
    for line in stdout.splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if codex_exec_auth_event_text(event).strip() == CODEX_EXEC_AUTH_SENTINEL:
            return True
    return False


def codex_exec_auth_event_text(event: Any) -> str:
    if not isinstance(event, dict):
        return ""
    if event.get("type") == "item.completed":
        item = event.get("item")
        if isinstance(item, dict) and item.get("type") == "agent_message":
            text = item.get("text")
            return text if isinstance(text, str) else ""
    if event.get("type") == "response.output_text.done":
        text = event.get("text")
        return text if isinstance(text, str) else ""
    if event.get("role") == "assistant":
        return assistant_content_text(event.get("content"))
    message = event.get("message")
    if isinstance(message, dict) and message.get("role") == "assistant":
        return assistant_content_text(message.get("content"))
    return ""


def assistant_content_text(content: Any) -> str:
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return ""
    parts = []
    for part in content:
        if isinstance(part, str):
            parts.append(part)
        elif isinstance(part, dict) and part.get("type") in {"text", "output_text"}:
            text = part.get("text")
            if isinstance(text, str):
                parts.append(text)
    return "\n".join(parts)


# Host identity comes from the shared resolver, not a local copy of the derivation. The
# producer stamps `host:<host>:codex:exec:auth:saved-login:observed` and two readers decide
# whether that host is the one they expect; each side used to derive it independently from its
# own ambient environment, so the same observation on the same machine was spelled
# `host:local:...` under `HAPAX_DISPATCH_HOST=local` and `host:hapax-appendix:...` under the
# systemd unit, and the readers refused one of them.
normalize_host = normalize_exec_auth_host
current_host = local_exec_auth_host


def codex_exec_auth_host() -> str:
    """The DESTINATION of the probe: the configured value, verbatim.

    This is an ssh(1) destination, so it must stay exactly what the operator configured --
    `podium` is an ssh_config alias and `hapax-podium` need not resolve. The first cut of
    the host-SSOT change returned the canonical identity here and broke the remote probe;
    destination and witness identity are two different things and are now two functions.
    """

    return configured_exec_auth_host()


def codex_exec_auth_witness_host() -> str:
    """The IDENTITY the observation is stamped with: `host:<identity>:codex:exec:auth:...`.

    Every spelling of "this machine" resolves to this machine's own name, so the stamp does
    not depend on the ambient environment of whichever process ran the producer. A remote
    destination resolves to that remote host's canonical identity.
    """

    return resolve_exec_auth_host(codex_exec_auth_host())


def codex_exec_auth_is_local(target: str) -> bool:
    """Does this destination name the machine the producer is running on?"""

    return resolve_exec_auth_host(target) == local_exec_auth_host()


def codex_exec_auth_command(*, codex_bin: str, cwd: Path) -> list[str]:
    return [
        codex_bin,
        "exec",
        "--ephemeral",
        "--skip-git-repo-check",
        "--ignore-rules",
        "--sandbox",
        "read-only",
        "--json",
        "--cd",
        str(cwd),
        "Reply exactly: HAPAX_CODEX_EXEC_AUTH_OK",
    ]


def codex_exec_auth_env() -> dict[str, str]:
    env = {
        key: value
        for key in (
            "ALL_PROXY",
            "HOME",
            "HTTP_PROXY",
            "HTTPS_PROXY",
            "LANG",
            "LC_ALL",
            "NO_PROXY",
            "PATH",
            "REQUESTS_CA_BUNDLE",
            "SSL_CERT_FILE",
        )
        if (value := os.environ.get(key)) is not None
    }
    env["NO_COLOR"] = "1"
    env.pop("CODEX_ACCESS_TOKEN", None)
    env.pop("CODEX_HOME", None)
    env.pop("CODEX_API_KEY", None)
    env.pop("OPENAI_API_KEY", None)
    return env


def classify_codex_exec_auth_failure(output: str) -> list[str]:
    reasons = ["codex_exec_auth_failed"]
    if "agent identity JWT payload is not valid JSON" in output:
        reasons.append("codex_exec_auth_agent_identity_jwt_invalid_json")
    if "refresh_token_invalidated" in output:
        reasons.append("codex_exec_auth_refresh_token_invalidated")
    if re.search(r"(?<!refresh_)token_invalidated", output):
        reasons.append("codex_exec_auth_token_invalidated")
    if re.search(r"(?i)(login required|required to log in|please log in|not logged in)", output):
        reasons.append("codex_exec_auth_login_required")
    return reasons


def remote_codex_exec_auth_command(*, cwd: Path) -> str:
    inner = "unset CODEX_ACCESS_TOKEN CODEX_HOME CODEX_API_KEY OPENAI_API_KEY; exec " + shlex.join(
        codex_exec_auth_command(codex_bin="codex", cwd=cwd)
    )
    return "bash -lc " + shlex.quote(inner)


def observe_codex_exec_auth(*, enabled: bool, timeout: float) -> tuple[list[str], list[str]]:
    if not enabled:
        return [], ["codex_exec_auth_probe_not_requested"]
    if not math.isfinite(timeout) or timeout <= 0:
        return [], ["codex_exec_auth_invalid_timeout"]
    target_host = codex_exec_auth_host()
    normalized_target = codex_exec_auth_witness_host()
    try:
        if codex_exec_auth_is_local(target_host):
            _, resolved, _ = resolve_platform_binary("codex")
            if resolved is None:
                return [], ["codex_exec_auth_binary_missing"]
            command = codex_exec_auth_command(codex_bin=resolved, cwd=REPO_ROOT)
            result = subprocess.run(
                command,
                check=False,
                text=True,
                capture_output=True,
                timeout=timeout,
                env=codex_exec_auth_env(),
            )
        else:
            remote_cwd = Path(os.environ.get("HAPAX_CODEX_EXEC_AUTH_REMOTE_CWD", str(Path.home())))
            remote_command = remote_codex_exec_auth_command(cwd=remote_cwd)
            result = subprocess.run(
                [
                    "ssh",
                    "-o",
                    "BatchMode=yes",
                    "-o",
                    f"ConnectTimeout={max(1, int(timeout))}",
                    target_host,
                    remote_command,
                ],
                check=False,
                text=True,
                capture_output=True,
                timeout=max(timeout + 5, 10),
                env=codex_exec_auth_env(),
            )
    except subprocess.TimeoutExpired:
        return [], ["codex_exec_auth_timeout"]
    except OSError:
        return [], ["codex_exec_auth_exec_failed"]
    if result.returncode == 0:
        if codex_exec_auth_sentinel_observed(result.stdout):
            host_ref = f"host:{normalized_target}:codex:exec:auth:saved-login:observed"
            if codex_exec_auth_is_local(target_host):
                return ["local:codex:exec:auth:observed", host_ref], []
            return [f"remote:{normalized_target}:codex:exec:auth:observed", host_ref], []
        return [], ["codex_exec_auth_sentinel_missing"]

    output = safe_text("\n".join([result.stderr or "", result.stdout or ""]), limit=2000) or ""
    return [], classify_codex_exec_auth_failure(output)


def observe_wrapper(route: PlatformCapabilityRoute) -> WrapperEvidence:
    path = launcher_command_path(route)
    if path is None:
        # No sanctioned wrapper declared: observed as missing, with nothing to hash.
        return WrapperEvidence(path="", exists=False, executable=False, sha256=None)
    return WrapperEvidence(
        path=display_path(path),
        exists=path.exists(),
        executable=os.access(path, os.X_OK),
        sha256=sha256_file(path),
    )


def observe_route_wrappers(
    routes: list[PlatformCapabilityRoute],
) -> dict[str, WrapperEvidence]:
    return {route.route_id: observe_wrapper(route) for route in routes}


def wrapper_reason_label(wrapper: WrapperEvidence) -> str:
    label = Path(wrapper.path).name or wrapper.path
    return re.sub(r"[^A-Za-z0-9_.-]+", "-", label).strip("-") or "unknown-wrapper"


def config_refs(platform: str) -> list[ConfigEvidence]:
    refs: list[ConfigEvidence] = []
    for path_ref in CONFIG_REFS_BY_PLATFORM[platform]:
        path = resolve_ref(path_ref)
        refs.append(ConfigEvidence(path=display_path(path), exists=path.exists()))
    return refs


def provider_doc_refs(routes: list[PlatformCapabilityRoute]) -> list[str]:
    refs: list[str] = []
    for route in routes:
        refs.extend(route.freshness.evidence.provider_docs.evidence_refs)
    return list(dict.fromkeys(refs))


def tool_state(routes: list[PlatformCapabilityRoute]) -> list[ToolEvidence]:
    by_tool: dict[str, ToolEvidence] = {}
    for route in routes:
        for tool in route.tool_state:
            by_tool.setdefault(
                tool.tool_id,
                ToolEvidence(
                    tool_id=tool.tool_id,
                    available=tool.available,
                    authority_use=[item.value for item in tool.authority_use],
                    evidence_ref=f"platform-capability-registry:{route.route_id}:tool:{tool.tool_id}",
                ),
            )
    return [by_tool[tool_id] for tool_id in sorted(by_tool)]


#: Where the estate's own quota producers write. `hapax-claude-account-live-observe` (10-minute
#: timer) and the per-platform `*-quota-admission` scripts land here; `shared/quota_wall.py` and
#: `shared/sdlc_pressure_gate.py` already read it.
QUOTA_RECEIPT_DIR = Path.home() / ".cache" / "hapax" / "relay" / "receipts"
# The live quota-spend ledger is the VALIDATED projection of those receipts (the telemetry writer
# rejects malformed, expired and lane-presence receipts before a snapshot exists). Quota is
# observed for a route only when a fresh positive receipt AND a fresh ledger snapshot both name it.
QUOTA_LEDGER_LIVE = Path(
    os.environ.get(QUOTA_SPEND_LEDGER_LIVE_ENV, "").strip() or DEFAULT_QUOTA_SPEND_LEDGER_LIVE
)
QUOTA_RECEIPT_MAX_STALE_SECONDS = 3600
QUOTA_RECEIPT_FUTURE_SKEW_SECONDS = 60


def _ledger_fresh_routes(
    route_ids: set[str], *, now: datetime
) -> tuple[dict[str, tuple[tuple[str, ...], datetime | None]], bool]:
    """Routes the live ledger's own fail-closed validator reports FRESH: route_id -> (refs, bound).

    The state comes from ``subscription_quota_state_for_route`` — the ledger's validator, which
    enforces capacity pool, expected provider, telemetry-writer provenance, sanitised admission
    evidence and the PAYG spend gate — never from a snapshot's raw ``subscription_quota_state``
    (review finding on #4616). ``refs`` are the validator's redacted evidence references. ``bound``
    is the earliest ``fresh_until`` among the route's subscription snapshots, used only to cap the
    receipt's stale_after. The second value is False when the ledger is missing or invalid — the
    honest state is then ``quota_telemetry_unknown``, never a guess from raw receipts alone.
    """
    try:
        ledger = load_quota_spend_ledger(QUOTA_LEDGER_LIVE)
    except (OSError, ValueError, QuotaSpendLedgerError):
        return {}, False
    fresh: dict[str, tuple[tuple[str, ...], datetime | None]] = {}
    for route_id in sorted(route_ids):
        try:
            state, refs = subscription_quota_state_for_route(ledger, route_id, now=now)
        except (ValueError, QuotaSpendLedgerError):
            continue
        if state is not SubscriptionQuotaState.FRESH:
            continue
        bounds = [
            snapshot.fresh_until
            for snapshot in ledger.quota_snapshots
            if snapshot.route_id == route_id and snapshot.fresh_until is not None
        ]
        fresh[route_id] = (
            tuple(_typed_evidence_ref(ref) for ref in refs),
            min(bounds) if bounds else None,
        )
    return fresh, True


def _typed_evidence_ref(ref: str) -> str:
    """The validator's references in the form ``SurfaceEvidence`` accepts.

    ``subscription_quota_state_for_route`` returns the ledger's provenance entries (its
    ``generated_from``, e.g. ``scripts/hapax-quota-telemetry-writer``) alongside the admission
    evidence. A bare path carries no namespace and ``SurfaceEvidence`` refuses it — measured
    2026-09-02 18:12 CDT on this consumer's first activated run, which crashed on exactly that
    entry and took every platform's refresh down with it. Provenance is typed as provenance.
    """
    if is_syntactically_typed_policy_evidence_reference(ref):
        return ref
    return f"quota-spend-ledger:generated_from:{ref}"


def _fresh_quota_receipt(
    path: Path, *, route_ids: set[str], now: datetime
) -> dict[str, Any] | None:
    """A quota receipt from `path` if it is fresh, positive, and for one of these routes.

    Refuses lane-presence evidence explicitly. The receipt carries
    `lane_presence_used_as_quota_evidence`, and the estate's standing rule is that a lane existing
    is not evidence its quota has headroom — accepting it would rebuild the attestation-in-disguise
    this whole path exists to remove.
    """
    try:
        doc = yaml.safe_load(path.read_text(encoding="utf-8"))
    except (OSError, ValueError, yaml.YAMLError):
        # ValueError covers UnicodeDecodeError: one corrupt receipt is rejected, it does not
        # abort the refresh (review finding on #4616).
        return None
    if not isinstance(doc, dict) or doc.get("route_id") not in route_ids:
        return None
    if doc.get("lane_presence_used_as_quota_evidence") is True:
        return None
    if doc.get("status") != "quota_available":
        return None
    # **PyYAML parses an ISO timestamp into a `datetime`, not a `str`.** The first version tested
    # `isinstance(observed_raw, str)` and therefore rejected every well-formed receipt on disk —
    # reporting quota unobservable for exactly the reason it was meant to fix. Accept both, and
    # normalise a naive datetime to UTC rather than assuming tzinfo is present.
    observed_raw = doc.get("observed_at")
    stale_seconds = doc.get("stale_after_seconds")
    # A receipt's own TTL is bounded: the admission writers use 900–1800 s. Anything above an hour
    # is a receipt that could vouch for quota it never observed (review finding on #4616).
    if not isinstance(stale_seconds, int) or isinstance(stale_seconds, bool):
        return None
    if stale_seconds <= 0 or stale_seconds > QUOTA_RECEIPT_MAX_STALE_SECONDS:
        return None
    if isinstance(observed_raw, datetime):
        observed = observed_raw if observed_raw.tzinfo else observed_raw.replace(tzinfo=UTC)
    elif isinstance(observed_raw, str):
        try:
            observed = parse_utc(observed_raw)
        except ValueError:
            return None
    else:
        return None
    age = (now - observed).total_seconds()
    if age < -QUOTA_RECEIPT_FUTURE_SKEW_SECONDS:
        return None  # a future-dated receipt has observed nothing yet
    if age > stale_seconds:
        return None
    doc["_observed"] = observed
    return doc


def observe_quota(
    platform: str, routes: list[PlatformCapabilityRoute], *, now: datetime
) -> SurfaceEvidence:
    """Quota status read from the estate's own receipts — not hardcoded.

    **This was a literal.** `quota` was constructed as UNOBSERVABLE with
    `account_live_quota_receipt_absent` unconditionally, for every platform, on every run. No lookup
    existed. So every one of the 16 declared routes reported its quota unobservable while
    `hapax-claude-account-live-observe` wrote fresh, positive, mechanically-obtained receipts every
    ten minutes — 6,917 of them on disk when this was found.

    That inverts the estate's own recorded failure. The 2026-08-19 rule says *"account-live is a
    fundamental property of a capability... I should not have to intervene on any measurement"*, and
    diagnosed the hazard as **an allowed observation with no producer**, which degrades into an
    operator attestation. Here the producer exists and runs; the CONSUMER was the stub. The symptom
    is identical — a property reported unobservable that is in fact observed — and a hardcoded
    verdict is worse than a missing one, because it cannot come back.

    Fails closed: no fresh positive receipt for any of this platform's routes yields UNOBSERVABLE
    with the original reason code, which is the honest state when nothing has been observed.
    """
    route_ids = {route.route_id for route in routes}
    # Per route, the newest fresh positive receipt (review finding on #4616: one route's receipt
    # used to mark the whole platform observed).
    best_by_route: dict[str, tuple[datetime, dict[str, Any], Path]] = {}
    if QUOTA_RECEIPT_DIR.is_dir():
        for path in QUOTA_RECEIPT_DIR.glob("*quota*admission*.yaml"):
            doc = _fresh_quota_receipt(path, route_ids=route_ids, now=now)
            if doc is None:
                continue
            route_id = str(doc["route_id"])
            observed = doc["_observed"]
            current = best_by_route.get(route_id)
            if current is None or observed > current[0]:
                best_by_route[route_id] = (observed, doc, path)
    ledger_fresh, ledger_readable = _ledger_fresh_routes(route_ids, now=now)
    # Observed only where a fresh relay receipt AND the ledger's validator agree on the route.
    observed_routes = sorted(route_id for route_id in best_by_route if route_id in ledger_fresh)
    if not observed_routes:
        # No fresh receipt for any route: the producer wrote nothing — receipt absent. Receipts
        # present but the validated ledger unreadable: telemetry unknown. Receipts present and the
        # ledger readable but not fresh for those routes: the admission is absent per the ledger.
        reason = (
            "quota_telemetry_unknown"
            if best_by_route and not ledger_readable
            else "account_live_quota_receipt_absent"
        )
        unobserved_refs = [f"local:{platform}:quota-probe:unobservable"]
        if best_by_route and not ledger_readable:
            unobserved_refs.append(
                f"quota-spend-ledger:{display_path(QUOTA_LEDGER_LIVE)}:unreadable"
            )
        return surface_evidence(
            status=EvidenceStatus.UNOBSERVABLE,
            source="local_receipt_probe",
            observed_at=now,
            stale_after="15m",
            evidence_refs=unobserved_refs,
            reason_codes=[reason],
        )
    evidence_refs: list[str] = []
    observed_at = min(best_by_route[route_id][0] for route_id in observed_routes)
    stale_candidates: list[int] = []
    for route_id in observed_routes:
        # The platform receipt is dated from its own generation, so it may carry only what is LEFT
        # of the raw receipt's lifetime, never the raw receipt's full TTL (review finding on
        # #4616: a receipt observed 890 s into a 900 s TTL was being renewed for another 900 s).
        raw_observed, raw_doc, _path = best_by_route[route_id]
        raw_expiry = raw_observed + timedelta(seconds=int(raw_doc["stale_after_seconds"]))
        stale_candidates.append(max(1, int((raw_expiry - now).total_seconds())))
        bound = ledger_fresh[route_id][1]
        if bound is not None:
            stale_candidates.append(max(1, int((bound - now).total_seconds())))
    stale_seconds = min(stale_candidates)
    for route_id in observed_routes:
        # Nothing from the raw receipt is copied into the platform receipt (review finding on
        # #4616): the ledger's validator already vouched for the route and its references are
        # redacted; the relay receipt contributes only the fact that it exists and is fresh.
        validator_refs, _bound = ledger_fresh[route_id]
        evidence_refs.extend(validator_refs)
        evidence_refs.extend(
            [
                f"local:{platform}:quota-admission-receipt:{route_id}:present",
                f"platform-capability-registry:{route_id}:quota:observed",
            ]
        )
    evidence_refs = list(dict.fromkeys(evidence_refs))
    return surface_evidence(
        status=EvidenceStatus.OBSERVED,
        source="local_receipt_probe",
        observed_at=observed_at,
        stale_after=f"{stale_seconds}s",
        evidence_refs=evidence_refs,
        reason_codes=[],
    )


def surface_evidence(
    *,
    status: EvidenceStatus,
    source: str,
    observed_at: datetime,
    stale_after: str,
    evidence_refs: list[str] | None = None,
    reason_codes: list[str] | None = None,
) -> SurfaceEvidence:
    return SurfaceEvidence(
        status=status,
        source=source,
        observed_at=observed_at,
        stale_after=stale_after,
        evidence_refs=evidence_refs or [],
        reason_codes=reason_codes or [],
    )


def build_receipt(
    *,
    platform: str,
    routes: list[PlatformCapabilityRoute],
    observed_at: datetime,
    stale_after: str,
    provider_docs_stale_after: str,
    timeout: float,
    codex_exec_auth_timeout: float,
    codex_exec_auth_probe: bool,
) -> PlatformCapabilityReceipt:
    primary_route = routes[0]
    cli = observe_cli(platform, timeout=timeout)
    route_wrappers = observe_route_wrappers(routes)
    wrappers = {wrapper.path: wrapper for wrapper in route_wrappers.values()}
    wrapper_list = [wrappers[path] for path in sorted(wrappers)]
    wrapper = route_wrappers.get(primary_route.route_id) or observe_wrapper(primary_route)
    route_ids = sorted(route.route_id for route in routes)
    receipt_id = f"{platform}-{observed_at.strftime('%Y%m%dT%H%M%SZ')}"
    capability_reasons: list[str] = []
    capability_refs: list[str] = []
    unusable_wrappers = [
        item for item in wrapper_list if not (item.exists and item.executable and item.sha256)
    ]
    wrapper_usable = not unusable_wrappers
    if cli.available:
        capability_refs.append(f"local:{platform}:cli-version:{cli.version or 'available'}")
    else:
        capability_reasons.append("cli_missing_or_unusable")
    capability_refs.extend(
        f"local:{item.path}:sha256:{item.sha256}"
        for item in wrapper_list
        if item.exists and item.executable and item.sha256
    )
    if not wrapper_usable:
        non_executable = [
            item
            for item in unusable_wrappers
            if item.exists and item.sha256 and not item.executable
        ]
        missing_or_unreadable = [
            item for item in unusable_wrappers if not item.exists or not item.sha256
        ]
        if non_executable:
            if len(route_ids) == 1:
                capability_reasons.append("sanctioned_wrapper_not_executable")
            capability_reasons.extend(
                f"sanctioned_wrapper_not_executable:{wrapper_reason_label(item)}"
                for item in non_executable
            )
        if missing_or_unreadable:
            if len(route_ids) == 1:
                capability_reasons.append("sanctioned_wrapper_missing_or_unreadable")
            capability_reasons.extend(
                f"sanctioned_wrapper_missing_or_unreadable:{wrapper_reason_label(item)}"
                for item in missing_or_unreadable
            )
    if platform == "codex":
        exec_auth_refs, exec_auth_reasons = observe_codex_exec_auth(
            enabled=codex_exec_auth_probe,
            timeout=codex_exec_auth_timeout,
        )
        capability_refs.extend(exec_auth_refs)
        capability_reasons.extend(exec_auth_reasons)
    capability_status = (
        EvidenceStatus.OBSERVED if not capability_reasons else EvidenceStatus.BLOCKED
    )
    if wrapper_usable:
        resource_status = EvidenceStatus.OBSERVED
        resource_reasons: list[str] = []
    elif any(item.exists and not item.executable for item in unusable_wrappers):
        resource_status = EvidenceStatus.BLOCKED
        resource_reasons = ["wrapper_not_executable"]
    else:
        resource_status = EvidenceStatus.MISSING
        resource_reasons = ["wrapper_missing"]
    resource_refs = [
        ref
        for item in wrapper_list
        for ref in (
            f"local:{item.path}:exists:{str(item.exists).lower()}",
            f"local:{item.path}:executable:{str(item.executable).lower()}",
        )
    ]
    quota = observe_quota(platform, routes, now=observed_at)
    provider_refs = provider_doc_refs(routes)
    if not provider_refs:
        provider_refs = [f"platform-capability-registry:{platform}:provider-docs:absent"]
    receipt = PlatformCapabilityReceipt(
        receipt_id=receipt_id,
        platform=platform,
        routes=route_ids,
        observed_at=observed_at,
        stale_after=stale_after,
        cli=cli,
        wrapper=wrapper,
        route_wrappers=route_wrappers,
        config_refs=config_refs(platform),
        tool_state=tool_state(routes),
        mcp_status=sorted({mcp for route in routes for mcp in route.tool_access.mcp}),
        capability=surface_evidence(
            status=capability_status,
            source="local_receipt_probe",
            observed_at=observed_at,
            stale_after=stale_after,
            evidence_refs=capability_refs,
            reason_codes=capability_reasons,
        ),
        resource=surface_evidence(
            status=resource_status,
            source="local_receipt_probe",
            observed_at=observed_at,
            stale_after=stale_after,
            evidence_refs=resource_refs,
            reason_codes=resource_reasons,
        ),
        quota=quota,
        provider_docs=ProviderDocsEvidence(
            refs=provider_refs,
            fetched_at=observed_at,
            stale_after=provider_docs_stale_after,
            fetch_status=EvidenceStatus.OBSERVED,
        ),
        known_unknowns=known_unknowns_for(platform),
    )
    receipt.capability.evidence_refs.append(receipt_reference(receipt))
    receipt.resource.evidence_refs.append(receipt_reference(receipt))
    receipt.quota.evidence_refs.append(receipt_reference(receipt))
    return receipt


def known_unknowns_for(platform: str) -> list[str]:
    unknowns = []
    if platform == "api":
        unknowns.insert(
            0,
            "Provider spend is authorized by the quota/spend ledger, not by this local receipt.",
        )
        unknowns.append(
            "Receipt command records config paths and existence only; it never reads secret values."
        )
    elif platform == "glmcp":
        unknowns.extend(
            [
                "GLMCP quota freshness is admitted by short-lived quota-spend-ledger receipts; this local receipt reports quota observed for a route only when a fresh relay admission receipt AND the ledger's validator both vouch for that route, and checks wrapper/config/docs/resource surfaces otherwise.",
                "GLMCP receipt refresh may read the pass-backed secret to verify wrapper availability; it records only redacted metadata and never persists the secret value.",
            ]
        )
    elif platform == "codex":
        unknowns.insert(
            0,
            "Account-live subscription quota is observed by this receipt only when a fresh relay admission receipt AND a fresh validated quota-spend-ledger snapshot both name a route; it is unobservable otherwise, never assumed.",
        )
        unknowns.append(
            "Codex exec-auth probe runs a bounded saved-login codex exec sentinel on the effective dispatch host; it never injects or persists bearer tokens."
        )
    else:
        unknowns.insert(
            0,
            "Account-live subscription quota is observed by this receipt only when a fresh relay admission receipt AND a fresh validated quota-spend-ledger snapshot both name a route; it is unobservable otherwise, never assumed.",
        )
        unknowns.append(
            "Receipt command records config paths and existence only; it never reads secret values."
        )
    return unknowns


def platform_routes(
    registry_routes: list[PlatformCapabilityRoute],
) -> dict[str, list[PlatformCapabilityRoute]]:
    routes: dict[str, list[PlatformCapabilityRoute]] = {}
    for route in registry_routes:
        platform = route.platform.value
        if platform in BINARY_BY_PLATFORM:
            routes.setdefault(platform, []).append(route)
    return routes


def write_receipt(receipt: PlatformCapabilityReceipt, receipt_dir: Path) -> Path:
    receipt_dir.mkdir(parents=True, exist_ok=True)
    path = receipt_dir / f"{receipt.platform}.json"
    path.write_text(
        json.dumps(receipt.model_dump(mode="json"), indent=2, sort_keys=True), encoding="utf-8"
    )
    return path


RETIRED_RECEIPT_DIRNAME = "retired"
#: A receipt's `platform` becomes a filename. Anything outside this shape is refused rather
#: than joined onto a path: `../rogue` would otherwise move the file to `<receipt_dir>/rogue.json`
#: and REPORT a successful retirement while leaving the original inside the live reader glob,
#: and an absolute value would escape the receipt directory entirely.
SAFE_PLATFORM_RE = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._-]{0,63}\Z")


def _safe_platform_name(value: Any) -> str | None:
    if not isinstance(value, str):
        return None
    candidate = value.strip()
    if candidate in {".", ".."} or not SAFE_PLATFORM_RE.match(candidate):
        return None
    return candidate


def _unused_archive_path(archive_dir: Path, platform: str, stamp: str) -> Path:
    """A destination that does not exist yet -- never one that overwrites an archive.

    The first cut checked only `<platform>.json` and then fell back to a stamp computed ONCE
    per sweep, so a third receipt for one platform in a sweep, or a second sweep inside the
    same second, resolved to the same fallback and `Path.replace` destroyed the earlier
    archive AND its record with no trace. The documented guarantee is never-overwrite; this
    is what makes it true.
    """

    candidate = archive_dir / f"{platform}.json"
    if not candidate.exists():
        return candidate
    base = f"{platform}.{stamp.replace(':', '')}"
    candidate = archive_dir / f"{base}.json"
    serial = 1
    while candidate.exists():
        candidate = archive_dir / f"{base}.{serial:03d}.json"
        serial += 1
    return candidate


def retire_receipts_without_routes(
    *,
    receipt_dir: Path,
    live_platforms: set[str],
    observed_at: datetime,
) -> tuple[list[dict[str, str]], list[dict[str, str]]]:
    """Archive receipts whose platform no longer has a route, with a dated record.

    Returns ``(retired, skipped)``. A skipped entry names a file the sweep could NOT decide
    about, so the operator is told which capability surfaces the sweep did not cover.

    `--all` refreshes only the platforms the registry still declares routes for, so a
    receipt written before its platform was excised is never touched again. Measured
    2026-09-16 on this estate: `gemini.json` (observed 2026-06-30T17:05:59Z),
    `antigrav.json` (2026-07-04) and `grok.json` (2026-07-09) were sitting in the live
    receipt directory carrying `stale_after: 24h`, 68-78 days past their own expiry, while
    the same `--all` run wrote six other platforms.

    **Retire-with-record, not skip and not delete.** Skipping is what produced the lingering
    files. Deleting would destroy an observation, and this estate does not delete evidence.
    Archiving moves the receipt out of the directory every reader globs, so it cannot be
    read as live surface by any future reader regardless of that reader's freshness logic,
    and writes a retirement record so the retirement itself is an observed, dated fact
    rather than an absence.

    Freshness is deliberately NOT the predicate: a platform with no declared route has no
    live surface however recently something observed its CLI, and a FRESH receipt for a
    retired platform is the case that could actually be misread. `receipt_is_fresh` stays
    exactly as it is on the read path -- this is a second, independent reason the file is
    gone, not a replacement for expiry.

    **Refuses to sweep on an empty live set.** `live_platforms` is an assertion about the
    registry, and an empty one is never a true statement that every platform was retired --
    it is a registry that failed to load or parse. Sweeping on it would move the ENTIRE live
    receipt directory into `retired/` and stamp each record with a reason that is false,
    leaving every reader with no capability receipts at all: the maximal form of the very
    route-blocking this change exists to reduce.
    """

    if not receipt_dir.is_dir():
        return [], []
    if not live_platforms:
        raise PlatformCapabilityReceiptError(
            "refusing to retire receipts: the live platform set is empty, which is a "
            "registry that did not load rather than a registry with no platforms. "
            "Next action: check the platform-capability registry loads, then rerun."
        )
    retired: list[dict[str, str]] = []
    skipped: list[dict[str, str]] = []
    archive_dir = receipt_dir / RETIRED_RECEIPT_DIRNAME
    stamp = observed_at.astimezone(UTC).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    for path in sorted(receipt_dir.glob("*.json")):
        if not path.is_file():
            continue
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError) as exc:
            # The file stays exactly where it is -- but a file the sweep could not read is a
            # capability surface whose retire-or-keep decision was NOT made, and the operator
            # is told so with a next action. The first cut `continue`d in silence while main
            # still reported ok=true.
            skipped.append(
                {
                    "path": str(path),
                    "reason": "receipt_unparseable_left_in_place",
                    "detail": f"{type(exc).__name__}: {exc}"[:200],
                    "next_action": "inspect or remove this file; the receipt loader will reject it too",
                }
            )
            continue
        if not isinstance(payload, dict):
            skipped.append(
                {
                    "path": str(path),
                    "reason": "receipt_not_a_json_object_left_in_place",
                    "detail": type(payload).__name__,
                    "next_action": "inspect or remove this file; the receipt loader will reject it too",
                }
            )
            continue
        raw_platform = payload.get("platform")
        platform = _safe_platform_name(raw_platform)
        if platform is None:
            skipped.append(
                {
                    "path": str(path),
                    "reason": "receipt_platform_identifier_unsafe_left_in_place",
                    "detail": repr(raw_platform)[:120],
                    "next_action": "a platform must match [A-Za-z0-9][A-Za-z0-9._-]{0,63}; repair or remove this file",
                }
            )
            continue
        if platform in live_platforms:
            continue
        archive_dir.mkdir(parents=True, exist_ok=True)
        destination = _unused_archive_path(archive_dir, platform, stamp)
        resolved_archive = archive_dir.resolve()
        if not destination.resolve().is_relative_to(resolved_archive):
            skipped.append(
                {
                    "path": str(path),
                    "reason": "retirement_destination_escapes_archive_left_in_place",
                    "detail": str(destination)[:200],
                    "next_action": "inspect this receipt; its platform resolved outside the archive",
                }
            )
            continue
        record = {
            "archived_from": str(path),
            "archived_to": str(destination),
            "platform": platform,
            "reason": "no_registry_route_declares_this_platform",
            "receipt_observed_at": str(payload.get("observed_at") or ""),
            "record_schema": "hapax.platform-capability-receipt-retirement.v1",
            "retired_at": stamp,
        }
        path.replace(destination)
        record_path = archive_dir / f"{destination.stem}.retirement.json"
        record_path.write_text(json.dumps(record, indent=2, sort_keys=True), encoding="utf-8")
        retired.append(record)
    return retired, skipped


def positive_float_env_default(name: str, default: float) -> float:
    raw = os.environ.get(name)
    if raw is None or raw == "":
        return default
    try:
        value = float(raw)
    except (TypeError, ValueError):
        print(
            f"hapax-platform-capability-receipts: invalid {name}={raw!r}; using {default:g}s",
            file=sys.stderr,
        )
        return default
    if not math.isfinite(value):
        print(
            f"hapax-platform-capability-receipts: invalid {name}={raw!r}; using {default:g}s",
            file=sys.stderr,
        )
        return default
    if value <= 0:
        print(
            f"hapax-platform-capability-receipts: nonpositive {name}={raw!r}; using {default:g}s",
            file=sys.stderr,
        )
        return default
    return value


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--registry", type=Path, default=PLATFORM_CAPABILITY_REGISTRY)
    parser.add_argument(
        "--receipt-dir",
        type=Path,
        default=Path(
            os.environ.get(
                PLATFORM_CAPABILITY_RECEIPT_DIR_ENV,
                str(DEFAULT_PLATFORM_CAPABILITY_RECEIPT_DIR),
            )
        ),
    )
    parser.add_argument("--platform", action="append", default=[])
    parser.add_argument("--all", action="store_true", help="Refresh every known coding platform")
    parser.add_argument("--now", help="Override observation time as ISO-8601 UTC")
    parser.add_argument("--stale-after", default="24h")
    parser.add_argument("--provider-docs-stale-after", default="30d")
    parser.add_argument("--timeout", type=float, default=5.0)
    parser.add_argument(
        "--codex-exec-auth-timeout",
        type=float,
        default=positive_float_env_default("HAPAX_CODEX_EXEC_AUTH_TIMEOUT_SECONDS", 30.0),
        help=(
            "Timeout in seconds for the bounded Codex exec-auth sentinel. "
            "Defaults to HAPAX_CODEX_EXEC_AUTH_TIMEOUT_SECONDS or 30."
        ),
    )
    parser.add_argument(
        "--codex-exec-auth-probe",
        action="store_true",
        help=(
            "For Codex receipts, run a bounded codex exec probe and only emit "
            "exec-auth evidence if the dispatch auth path succeeds."
        ),
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help=(
            "Do not write receipts. Observation probes still run, including "
            "--codex-exec-auth-probe when that flag is supplied."
        ),
    )
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)

    observed_at = parse_utc(args.now) if args.now else datetime.now(UTC).replace(microsecond=0)
    registry, non_supply_observation_errors = load_platform_capability_registry_for_dispatch(
        args.registry,
        now=observed_at,
        apply_receipts=False,
    )
    if non_supply_observation_errors and not args.json:
        for err in non_supply_observation_errors:
            print(
                f"NOTE: non-supply observation error (inert for receipt write): {err}",
                file=sys.stderr,
            )
    routes_by_platform = platform_routes(registry.routes)
    selected = (
        sorted(routes_by_platform)
        if args.all or not args.platform
        else [platform.lower() for platform in args.platform]
    )
    unknown = sorted(set(selected) - set(routes_by_platform))
    if unknown:
        retired = [platform for platform in unknown if platform in RETIRED_ANTIGRAV_PLATFORMS]
        for platform in retired:
            print(
                f"platform '{platform}' is retired/excised; use agy.review.direct for "
                "the live read-only review route",
                file=sys.stderr,
            )
        if retired:
            retired_set = set(retired)
            unknown = [platform for platform in unknown if platform not in retired_set]
        if unknown:
            print(f"unknown platform(s): {', '.join(unknown)}", file=sys.stderr)
        return 2

    outputs: list[dict[str, Any]] = []
    for platform in selected:
        receipt = build_receipt(
            platform=platform,
            routes=routes_by_platform[platform],
            observed_at=observed_at,
            stale_after=args.stale_after,
            provider_docs_stale_after=args.provider_docs_stale_after,
            timeout=args.timeout,
            codex_exec_auth_timeout=args.codex_exec_auth_timeout,
            codex_exec_auth_probe=args.codex_exec_auth_probe,
        )
        path = None if args.dry_run else write_receipt(receipt, args.receipt_dir)
        outputs.append(
            {
                "platform": platform,
                "receipt_id": receipt.receipt_id,
                "path": str(path) if path else None,
                "cli_available": receipt.cli.available,
                "wrapper_exists": receipt.wrapper.exists,
                "capability_status": receipt.capability.status.value,
                "capability_reason_codes": receipt.capability.reason_codes,
                "resource_status": receipt.resource.status.value,
                "resource_reason_codes": receipt.resource.reason_codes,
                "quota_status": receipt.quota.status.value,
                "quota_reason_codes": receipt.quota.reason_codes,
            }
        )

    # Only --all knows the whole live set. A --platform run observed a subset and must not
    # conclude that everything it did not name is retired.
    retired_receipts: list[dict[str, str]] = []
    skipped_receipts: list[dict[str, str]] = []
    if args.all and not args.dry_run:
        # The protection set is EVERY platform the registry declares a route for -- not the
        # subset this script can probe. `routes_by_platform` is filtered through
        # BINARY_BY_PLATFORM, which omits `local_tool`; the registry declares
        # `local_tool.local.worker`, so deriving the set from the probe map would archive a
        # local_tool receipt under `no_registry_route_declares_this_platform`, a reason that
        # is false. Probe support and route declaration are different facts.
        declared_platforms = {route.platform.value for route in registry.routes}
        try:
            retired_receipts, skipped_receipts = retire_receipts_without_routes(
                receipt_dir=args.receipt_dir,
                live_platforms=declared_platforms,
                observed_at=observed_at,
            )
        except PlatformCapabilityReceiptError as exc:
            print(f"hapax-platform-capability-receipts: {exc}", file=sys.stderr)
            return 4

    payload = {
        "ok": True,
        "observed_at": iso_z(observed_at),
        "receipt_dir": str(args.receipt_dir),
        "dry_run": args.dry_run,
        "receipts": outputs,
        "retired_receipts": retired_receipts,
        "skipped_receipts": skipped_receipts,
    }
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        for item in outputs:
            target = item["path"] or "<dry-run>"
            print(
                f"{item['platform']}: wrote {target} "
                f"cli={item['cli_available']} wrapper={item['wrapper_exists']} "
                f"quota={item['quota_status']}"
            )
        for item in retired_receipts:
            print(
                f"{item['platform']}: retired {item['archived_from']} -> "
                f"{item['archived_to']} (observed {item['receipt_observed_at']}, "
                f"{item['reason']})"
            )
        for item in skipped_receipts:
            print(
                f"SKIPPED {item['path']}: {item['reason']} ({item['detail']}). "
                f"Next action: {item['next_action']}",
                file=sys.stderr,
            )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
