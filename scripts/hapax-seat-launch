#!/usr/bin/env python3
"""Start a coordinator seat only after its Codex instruction binding is current.

The live seat is never replaced.  ``--check`` is a read-only admission probe;
normal invocation refuses an existing tmux session before starting anything.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import resource
import secrets
import subprocess
import sys
import time
from pathlib import Path

SEAT_SESSION = "hapax-codex-seat"
INNER_MARKER = "HAPAX_SEAT_LAUNCH_INNER"
LAUNCH_ID_VAR = "HAPAX_SEAT_LAUNCH_ID"
SEAT_MODEL = "gpt-6-sol"
SEAT_EFFORT = "high"


class SeatBindingError(ValueError):
    """A seat start must stop before any runtime action."""


def _digest(body: bytes) -> str:
    return hashlib.sha256(body).hexdigest()


def verify_codex_binding(home: Path, environment: dict[str, str]) -> dict[str, str]:
    """Check the deployed, receipted body at the *dedicated* Codex home."""
    home = home.resolve()
    seat_home = home / ".codex-seat"
    declared = environment.get("CODEX_HOME")
    if declared and Path(declared).expanduser().resolve() != seat_home:
        raise SeatBindingError(f"wrong_home: CODEX_HOME={declared}; expected {seat_home}")

    shared = home / ".config/hapax/agent-instructions/AGENTS.md"
    generated = home / ".codex/AGENTS.md"
    seat_binding = seat_home / "AGENTS.md"
    receipt_path = shared.parent / "current.json"
    if (shared.parent / "pending.json").exists():
        raise SeatBindingError("instruction_install_pending: recover the installation first")
    if not receipt_path.is_file() or receipt_path.is_symlink():
        raise SeatBindingError("missing_instruction_receipt")
    try:
        receipt = json.loads(receipt_path.read_text())
    except (OSError, ValueError) as exc:
        raise SeatBindingError("invalid_instruction_receipt") from exc
    if not isinstance(receipt, dict) or receipt.get("observation") != "filesystem_readback":
        raise SeatBindingError("unverified_instruction_receipt")
    files = receipt.get("files")
    if not isinstance(files, list):
        raise SeatBindingError("invalid_instruction_receipt_files")
    for binding, path in (("shared", shared), ("codex", generated)):
        entries = [
            item for item in files if isinstance(item, dict) and item.get("binding") == binding
        ]
        if len(entries) != 1 or entries[0].get("path") != str(path):
            raise SeatBindingError(f"wrong_{binding}_receipt_path")
        if not path.is_file() or path.is_symlink():
            raise SeatBindingError(f"missing_{binding}_binding")
        body = path.read_bytes()
        if (
            not body
            or _digest(body) != entries[0].get("sha256")
            or len(body) != entries[0].get("bytes")
        ):
            raise SeatBindingError(f"stale_{binding}_body")

    common_body = shared.read_bytes()
    active_source = (
        home / ".cache/hapax/source-activation/worktree/config/agent-instructions/AGENTS.md"
    )
    if not active_source.is_file() or active_source.read_bytes() != common_body:
        raise SeatBindingError("stale_shared_vs_active_source")
    generated_body = generated.read_bytes()
    prefix = b"<!-- Generated from Council config/agent-instructions; edit the source. -->\n\n"
    if generated_body != prefix + common_body:
        raise SeatBindingError("generated_body_not_exact_shared_binding")
    shadow = seat_home / "AGENTS.override.md"
    if shadow.exists() and shadow.read_bytes().strip():
        raise SeatBindingError("seat_global_override_shadows_binding")
    if not seat_binding.is_symlink():
        raise SeatBindingError("missing_seat_agents_symlink")
    if seat_binding.resolve() != generated:
        raise SeatBindingError("wrong_home_seat_agents_target")
    if seat_binding.read_bytes() != generated_body:
        raise SeatBindingError("stale_seat_agents_body")
    for name in ("auth.json", "config.toml"):
        candidate = seat_home / name
        if not candidate.is_symlink() or candidate.resolve() != home / ".codex" / name:
            raise SeatBindingError(f"wrong_home_{name}_target")
    return {
        "seat_home": str(seat_home),
        "source_revision": str(receipt.get("source_revision", "")),
        "shared_sha256": _digest(common_body),
        "codex_sha256": _digest(generated_body),
    }


def _raise_nofile() -> None:
    soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
    if hard != resource.RLIM_INFINITY and hard < 65536:
        raise SeatBindingError("nofile_hard_limit_below_65536")
    if soft < 65536:
        resource.setrlimit(resource.RLIMIT_NOFILE, (65536, hard))


def _require_inner_session() -> None:
    if os.environ.get(INNER_MARKER) != SEAT_SESSION or not os.environ.get("TMUX"):
        raise SeatBindingError("inner_invocation_outside_seat_launcher")
    launch_id = os.environ.get(LAUNCH_ID_VAR, "")
    if re.fullmatch(r"[0-9a-f]{32}", launch_id) is None:
        raise SeatBindingError("missing_seat_launch_id")
    observed = subprocess.run(
        ["tmux", "display-message", "-p", "#{session_name}"],
        capture_output=True,
        text=True,
        check=False,
    )
    if observed.returncode != 0 or observed.stdout.strip() != SEAT_SESSION:
        raise SeatBindingError("inner_invocation_wrong_tmux_session")


def _inner_codex(home: Path) -> None:
    _require_inner_session()
    verify_codex_binding(home, os.environ)
    _raise_nofile()
    environment = os.environ.copy()
    environment.pop(INNER_MARKER, None)
    launch_id = environment.pop(LAUNCH_ID_VAR)
    environment["CODEX_HOME"] = str(home / ".codex-seat")
    environment["HAPAX_AGENT_ROLE"] = "dev1-seat-codex"
    prompt = (
        "Take the coordinator seat. Read "
        "30-areas/hapax/frame/coordinator-succession-20260924/"
        "HANDOFF-seat-claude-to-codex-20260929.md in the canonical vault, "
        "then COORDINATOR-SEAT.md sections 0 through 3. Follow the handoff starting at section 0. "
        f"Seat startup receipt: {launch_id}."
    )
    command = [
        "systemd-run",
        "--user",
        "--scope",
        "--collect",
        "-p",
        "MemoryHigh=5G",
        "-p",
        "MemoryMax=7G",
        "codex",
        "-s",
        "danger-full-access",
        "-a",
        "never",
        "-m",
        SEAT_MODEL,
        "-c",
        f"model_reasoning_effort={SEAT_EFFORT}",
        prompt,
    ]
    os.chdir(home / "projects")
    os.execvpe(command[0], command, environment)


def _first_turn_state(path: Path, launch_id: str) -> str:
    """Observe the first submitted turn in one new Codex rollout, without logging its content."""
    first_turn = None
    prompt_seen = False
    route_seen = False
    wrong_route = False
    completion = False
    aborted = False
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError):
        return "pending"
    for line in lines:
        try:
            record = json.loads(line)
        except ValueError:
            continue  # An in-progress final JSONL line is not yet evidence.
        if not isinstance(record, dict):
            continue
        payload = record.get("payload")
        if not isinstance(payload, dict):
            continue
        kind = payload.get("type")
        if record.get("type") == "event_msg" and kind == "task_started" and first_turn is None:
            first_turn = payload.get("turn_id")
        elif record.get("type") == "turn_context" and first_turn and not route_seen:
            route_seen = True
            wrong_route = payload.get("model") != SEAT_MODEL or payload.get("effort") != SEAT_EFFORT
        elif record.get("type") == "response_item" and kind == "message":
            if payload.get("role") == "user":
                prompt_seen |= any(
                    part.get("type") == "input_text"
                    and f"Seat startup receipt: {launch_id}." in part.get("text", "")
                    for part in payload.get("content", [])
                    if isinstance(part, dict)
                )
        elif record.get("type") == "event_msg" and payload.get("turn_id") == first_turn:
            message = payload.get("last_agent_message")
            if (
                kind == "task_complete"
                and prompt_seen
                and isinstance(message, str)
                and message.strip()
            ):
                completion = True
            if kind == "turn_aborted":
                aborted = True
    if not prompt_seen or not first_turn:
        return "pending"
    if wrong_route:
        return "wrong_route"
    if aborted:
        return "aborted"
    return "ready" if completion and route_seen else "pending"


def _startup_timeout(environment: dict[str, str]) -> float:
    raw = environment.get("HAPAX_SEAT_STARTUP_TIMEOUT_SECONDS", "300")
    try:
        timeout = float(raw)
    except ValueError as exc:
        raise SeatBindingError("invalid_startup_timeout") from exc
    if not 0 < timeout <= 600:
        raise SeatBindingError("invalid_startup_timeout")
    return timeout


def _wait_first_turn(seat_home: Path, launch_id: str, prior: set[Path], timeout: float) -> Path:
    deadline = time.monotonic() + timeout
    sessions = seat_home / "sessions"
    while True:
        live = subprocess.run(["tmux", "has-session", "-t", SEAT_SESSION], capture_output=True)
        if live.returncode != 0:
            raise SeatBindingError("seat_exited_before_first_turn")
        for path in sessions.rglob("rollout-*.jsonl"):
            if path in prior:
                continue
            state = _first_turn_state(path, launch_id)
            if state == "aborted":
                raise SeatBindingError("seat_first_turn_aborted")
            if state == "wrong_route":
                raise SeatBindingError("seat_first_turn_wrong_route")
            if state == "ready":
                return path
        if time.monotonic() >= deadline:
            raise SeatBindingError("seat_first_turn_timeout")
        time.sleep(min(1.0, max(0.0, deadline - time.monotonic())))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("harness", nargs="?", choices=("codex", "opencode"), default="codex")
    parser.add_argument("--check", action="store_true", help="read-only binding admission check")
    parser.add_argument("--inner-codex", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.harness != "codex":
        print("hapax-seat-launch: OpenCode launcher is not yet admitted", file=sys.stderr)
        return 2
    try:
        evidence = verify_codex_binding(Path.home(), os.environ)
    except (OSError, SeatBindingError) as exc:
        print(f"hapax-seat-launch: REFUSED {exc}", file=sys.stderr)
        return 2
    if args.check:
        print(json.dumps(evidence, sort_keys=True))
        return 0
    if args.inner_codex:
        try:
            _inner_codex(Path.home())
        except (OSError, SeatBindingError) as exc:
            print(f"hapax-seat-launch: REFUSED {exc}", file=sys.stderr)
            return 2
        return 0
    if (
        subprocess.run(["tmux", "has-session", "-t", SEAT_SESSION], capture_output=True).returncode
        == 0
    ):
        print(
            f"hapax-seat-launch: REFUSED live session {SEAT_SESSION} already exists",
            file=sys.stderr,
        )
        return 2
    try:
        timeout = _startup_timeout(os.environ)
        prior = set((Path(evidence["seat_home"]) / "sessions").rglob("rollout-*.jsonl"))
    except (OSError, SeatBindingError) as exc:
        print(f"hapax-seat-launch: REFUSED {exc}", file=sys.stderr)
        return 2
    launch_id = secrets.token_hex(16)
    command = [
        "tmux",
        "new-session",
        "-d",
        "-s",
        SEAT_SESSION,
        "-c",
        str(Path.home() / "projects"),
        "env",
        f"CODEX_HOME={evidence['seat_home']}",
        f"{INNER_MARKER}={SEAT_SESSION}",
        f"{LAUNCH_ID_VAR}={launch_id}",
        sys.executable,
        str(Path(__file__).resolve()),
        "codex",
        "--inner-codex",
    ]
    created = subprocess.run(command, check=False)
    if created.returncode != 0:
        return created.returncode
    try:
        rollout = _wait_first_turn(Path(evidence["seat_home"]), launch_id, prior, timeout)
    except (OSError, SeatBindingError) as exc:
        print(f"hapax-seat-launch: REFUSED {exc}", file=sys.stderr)
        return 2
    print(json.dumps({"readiness": "first_turn_complete", "rollout": str(rollout)}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
