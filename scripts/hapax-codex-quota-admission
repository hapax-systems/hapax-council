#!/usr/bin/env python3
"""Write Codex subscription-quota admission receipts from an account-live observation.

The command records a short-lived, sanitized observation that a Codex receipt-bounded route has
fresh account-live subscription quota. It is patterned after
``scripts/hapax-claude-subscription-quota-admission`` / ``scripts/hapax-agy-quota-admission``:
positive receipts are consumed by ``scripts/hapax-quota-telemetry-writer`` before that route is
treated as quota-fresh.

Codex account-live subscription quota IS mechanically observable, contrary to
CASE-CAPACITY-ROUTING-001 R2 ("use receipts and manual refresh until observable"). As of
codex-cli 0.146.0 the CLI writes the provider's entitlement limits into its own session rollouts
(``~/.codex/sessions/**/rollout-*.jsonl``): ``limit_id: "codex"`` with a primary window carrying
``used_percent`` / ``window_minutes`` / ``resets_at``, plus a credits balance. That is a real
headroom magnitude for the SUBSCRIPTION — not an API key — and ``--from-rollout`` reads it with
zero provider calls and no spend. Prefer it: a measurement beats an attestation.

The telemetry writer's ``codex exec`` saved-login sentinel proves AUTH (the login is valid and not
invalidated), which is a different claim than HEADROOM — a valid login says nothing about remaining
quota. That distinction is why this writer exists and why an auth-probe evidence ref is refused.

Without ``--from-rollout`` this records an OPERATOR / governed-probe attestation of a bounded
account-live observation (an evidence ref naming what was observed), NEVER a live Codex smoke (no
runtime side effect, no provider spend) and NEVER lane/tmux/session presence. It persists no secret
value and no prompt/response content, and the receipt is short-lived so it cannot stand as stale
evidence. Fail-closed throughout: an unsafe, stale, or exhausted observation exits non-zero and
writes nothing, so the route stays held.

Note ``codex.headless.full`` still holds on ``account_live_quota_receipt_absent`` after this runs.
That blocker is a platform-capability-receipt concern, and the honest repair is for
``scripts/hapax-platform-capability-receipts`` to stop reporting ``quota-probe:unobservable`` and
observe the same rollout — not for this receipt to be folded into the ledger snapshot, whose
codex-fresh-on-saved-login behaviour is deliberate and test-pinned.
"""

from __future__ import annotations

import argparse
import os
import re
import sys
import tempfile
from datetime import UTC, datetime
from pathlib import Path

DEFAULT_RECEIPT_DIR = Path(
    os.environ.get(
        "HAPAX_RELAY_RECEIPT_DIR",
        str(Path.home() / ".cache/hapax/relay/receipts"),
    )
)

ADMISSION_SCHEMA = "hapax.codex_quota_admission.v1"
PROVIDER = "openai-codex-subscription"
DEFAULT_ROUTE_ID = "codex.headless.full"
ALLOWED_ROUTE_IDS = ("codex.headless.full", "codex.headless.spark")
CAPACITY_POOL = "subscription_quota"
# The registry records auth_surface "oauth" for both codex routes (Codex CLI saved login), not the
# "subscription" surface Claude uses. Keep these in step: the fold side matches on this value.
AUTH_SURFACE = "oauth"
BILLING_MODE = "operator_session_subscription"
SECRET_SOURCE = "codex:operator-session-saved-login"
DEFAULT_STALE_AFTER_SECONDS = 900
MIN_STALE_AFTER_SECONDS = 60
MAX_STALE_AFTER_SECONDS = 3600

# The bounded observation kinds this writer will attest. Each names an account-live subscription
# observation that is NOT lane/tmux/session presence and NOT a saved-login auth probe: a real Codex
# invocation completed without a subscription quota wall, or an operator confirmed live subscription
# headroom out-of-band. Keep this set small and explicit — a free-form observation string is refused.
ALLOWED_OBSERVATIONS = (
    "subscription_quota_headroom_observed",
    "operator_confirmed_subscription_headroom",
)

VALIDATION_RECOVERY_HINT = (
    "next action: rerun with --help to confirm bounds, pass a sanitized --evidence-ref that names "
    "the account-live observation (never a lane/tmux name, never a saved-login auth probe), pick an "
    "allowed --observation, then rerun after a genuine account-live subscription observation"
)

SAFE_REF_RE = re.compile(r"\A[a-z0-9][a-z0-9_.+-]{2,239}\Z")
WITNESS_ALLOWLIST_RE = re.compile(
    r"\Acodex-(?:subscription-headroom-observed|operator-confirmed-subscription-headroom)-"
    r"\d{8}t\d{4}(?:\d{2})?z\Z"
)
SAFE_RECEIPT_NAME_RE = re.compile(r"\A[a-z0-9_.+-]+\.yaml\Z")
SECRETISH_RE = re.compile(
    r"(?:api[_-]?key|bearer|secret|token|sk-[a-z0-9_-]+|[a-z0-9]{32,})",
    re.IGNORECASE,
)
BILLINGISH_RE = re.compile(
    r"(?:"
    r"(?:^|[-_.+:])(?:billing|customer|account|invoice|payment)[a-z0-9]*(?:$|[-_.+:])|"
    r"(?:^|[-_.+:])subscription[-_.+:]?id[a-z0-9]*(?:$|[-_.+:])|"
    r"(?:^|[-_.+:])(?:cus|sub|acct|in|ch)[0-9][a-z0-9]*(?:$|[-_.+:])|"
    r"(?:^|[-_.+:])(?:cus|sub|acct|in|ch)[-_.+:][a-z0-9]+(?:$|[-_.+:])"
    r")",
    re.IGNORECASE,
)
# Guard against laundering lane/session presence into quota evidence. Codex lanes are named
# hapax-codex-cx-<color> and their worktrees cx-<name>, so both spellings are refused alongside the
# shared greek-letter/vbe lane vocabulary.
LANE_PRESENCE_RE = re.compile(
    r"(?:"
    r"hapax-codex-[a-z0-9-]+|hapax-claude-[a-z0-9-]+|session-present|lane-present|lane-exists|"
    r"(?:^|[-_.+])"
    r"(?:(?:tmux|sessions?|lanes?|dev)[0-9]*|"
    r"(?:alpha|beta|gamma|delta|epsilon|zeta|eta|theta|iota|kappa|"
    r"lambda|mu|nu|xi|omicron|pi|rho|sigma|tau|upsilon|phi|chi|psi|omega)[0-9]*|"
    r"cx-[a-z0-9-]+|vbe-[0-9]+)"
    r"(?:$|[-_.+])"
    r")",
    re.IGNORECASE,
)
# Diagnostic refinement, not a security boundary. WITNESS_ALLOWLIST_RE is a strict whitelist, so it
# already refuses every ref below this line — removing this check leaves the suite green on exit
# codes alone. It earns its place by naming the specific mistake: Codex ships a live saved-login
# ``codex exec`` sentinel that looks like quota evidence and is not, so that confusion is the one a
# future operator will actually make here. The same is true of LANE_PRESENCE_RE and BILLINGISH_RE
# above. Tests assert the message, not just the refusal, or they pin nothing.
AUTH_PROBE_RE = re.compile(
    r"(?:codex[-_.]?exec[-_.]?auth|saved[-_.]?login|auth[-_.]?probe|login[-_.]?sentinel)",
    re.IGNORECASE,
)


def _parse_utc(value: str) -> datetime | None:
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=UTC)
    return parsed.astimezone(UTC).replace(microsecond=0)


def _iso(value: datetime) -> str:
    return value.astimezone(UTC).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def _now(args: argparse.Namespace) -> datetime:
    if args.now:
        parsed = _parse_utc(args.now)
        if parsed is None:
            raise ValueError("invalid --now; expected ISO-8601 UTC timestamp")
        return parsed
    return datetime.now(UTC).replace(microsecond=0)


def _safe_reference(value: str, *, label: str) -> str:
    normalized = " ".join(value.strip().split())
    if SAFE_REF_RE.fullmatch(normalized) is None or SECRETISH_RE.search(normalized) is not None:
        raise ValueError(f"unsafe {label}; expected a 3-240 character sanitized reference")
    if BILLINGISH_RE.search(normalized) is not None:
        raise ValueError(f"unsafe {label}; billing/account identifiers must not be persisted")
    if LANE_PRESENCE_RE.search(normalized) is not None:
        raise ValueError(
            f"unsafe {label}; lane/tmux/session presence must not be used as quota evidence"
        )
    if AUTH_PROBE_RE.search(normalized) is not None:
        raise ValueError(
            f"unsafe {label}; a saved-login auth probe proves auth, not quota headroom, and must "
            "not be used as quota evidence"
        )
    if WITNESS_ALLOWLIST_RE.fullmatch(normalized) is None:
        raise ValueError(
            f"unsafe {label}; expected a codex subscription headroom witness reference"
        )
    return normalized


def _observation(value: str) -> str:
    normalized = " ".join(value.strip().split())
    if normalized not in ALLOWED_OBSERVATIONS:
        raise ValueError(
            "invalid --observation; expected one of: " + ", ".join(ALLOWED_OBSERVATIONS)
        )
    return normalized


def _route_id(value: str) -> str:
    normalized = " ".join(value.strip().split())
    if normalized not in ALLOWED_ROUTE_IDS:
        raise ValueError("invalid --route-id; expected one of: " + ", ".join(ALLOWED_ROUTE_IDS))
    return normalized


def _route_slug(route_id: str) -> str:
    return route_id.replace(".", "-")


def _receipt_name(args: argparse.Namespace, *, route_id: str, observed_at: datetime) -> str:
    stamp = observed_at.strftime("%Y%m%dT%H%M%SZ").lower()
    default = f"codex-quota-admission-{_route_slug(route_id)}-{stamp}.yaml"
    name = args.receipt_name or default
    if SAFE_RECEIPT_NAME_RE.fullmatch(name) is None or SECRETISH_RE.search(name) is not None:
        raise ValueError("unsafe receipt name")
    name_stem = name.removesuffix(".yaml")
    if BILLINGISH_RE.search(name_stem) is not None:
        raise ValueError("unsafe receipt name; billing/account identifiers must not be persisted")
    if LANE_PRESENCE_RE.search(name_stem) is not None:
        raise ValueError("unsafe receipt name; lane/tmux/session presence must not be persisted")
    if "codex-quota-admission" not in name:
        raise ValueError("receipt name must contain 'codex-quota-admission'")
    return name


def _write_flat_yaml_atomic(path: Path, fields: list[tuple[str, object]]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".tmp")
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            for key, value in fields:
                if isinstance(value, bool):
                    rendered = "true" if value else "false"
                else:
                    rendered = str(value)
                handle.write(f"{key}: {rendered}\n")
        os.replace(tmp_name, path)
        os.chmod(path, 0o600)
    except Exception:
        try:
            Path(tmp_name).unlink()
        except OSError:
            # Cleanup is best-effort; preserve and re-raise the original write failure.
            pass
        raise


# The rollout reader lives in shared/ so this writer and
# scripts/hapax-platform-capability-receipts read the same bytes the same way. Two hand-synced
# copies of one predicate is precisely the drift this estate keeps paying for.
REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from shared.codex_rollout_quota import (  # noqa: E402
    DEFAULT_MAX_OBSERVATION_AGE_SECONDS,
    RolloutObservation,
    latest_rollout_observation,
)
from shared.codex_rollout_quota import (
    DEFAULT_SESSIONS_DIR as CODEX_SESSIONS_DIR,
)


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--receipt-dir", type=Path, default=DEFAULT_RECEIPT_DIR)
    parser.add_argument("--receipt-name")
    parser.add_argument("--now")
    parser.add_argument(
        "--evidence-ref",
        help=(
            "Sanitized ref naming the account-live observation (never a lane/tmux name, never a "
            "saved-login auth probe), for example "
            "codex-subscription-headroom-observed-20260809t1630z. Required unless --from-rollout "
            "derives it from a measured observation."
        ),
    )
    parser.add_argument(
        "--from-rollout",
        action="store_true",
        help=(
            "Derive the observation from the newest rate_limits snapshot Codex CLI already wrote "
            "to its session rollouts. This is a MEASURED headroom reading, not an attestation: it "
            "calls no provider and spends nothing. Refuses on a stale observation or an exhausted "
            "window."
        ),
    )
    parser.add_argument(
        "--sessions-dir",
        type=Path,
        default=CODEX_SESSIONS_DIR,
        help="Codex sessions directory to scan with --from-rollout",
    )
    parser.add_argument(
        "--max-observation-age-seconds",
        type=int,
        default=DEFAULT_MAX_OBSERVATION_AGE_SECONDS,
        help="With --from-rollout, refuse an observation older than this",
    )
    parser.add_argument(
        "--observation",
        default=ALLOWED_OBSERVATIONS[0],
        help="Account-live observation kind: " + ", ".join(ALLOWED_OBSERVATIONS),
    )
    parser.add_argument(
        "--route-id",
        default=DEFAULT_ROUTE_ID,
        help="Codex receipt-bounded route id: " + ", ".join(ALLOWED_ROUTE_IDS),
    )
    parser.add_argument(
        "--stale-after-seconds",
        type=int,
        default=DEFAULT_STALE_AFTER_SECONDS,
    )
    parser.add_argument("--json", action="store_true")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    try:
        observed_at = _now(args)
        if not MIN_STALE_AFTER_SECONDS <= args.stale_after_seconds <= MAX_STALE_AFTER_SECONDS:
            raise ValueError(
                f"--stale-after-seconds must be between {MIN_STALE_AFTER_SECONDS} and "
                f"{MAX_STALE_AFTER_SECONDS}"
            )
        observation = _observation(args.observation)
        route_id = _route_id(args.route_id)
        rollout: RolloutObservation | None = None
        if args.from_rollout:
            rollout = latest_rollout_observation(
                args.sessions_dir,
                now=observed_at,
                max_age_seconds=args.max_observation_age_seconds,
            )
            # The witness is stamped with the observation's own time, not now: the receipt attests
            # what was measured and when, and a later stamp would overstate its freshness.
            observed_at = rollout.observed_at
            derived_ref = (
                "codex-subscription-headroom-observed-"
                + observed_at.strftime("%Y%m%dt%H%Mz").lower()
            )
            if args.evidence_ref and args.evidence_ref != derived_ref:
                raise ValueError(
                    "--evidence-ref conflicts with --from-rollout; omit it and let the measured "
                    "observation name itself"
                )
            evidence_ref = _safe_reference(derived_ref, label="evidence-ref")
            observation = "subscription_quota_headroom_observed"
        elif not args.evidence_ref:
            raise ValueError(
                "--evidence-ref is required unless --from-rollout derives one from a measured "
                "observation"
            )
        else:
            evidence_ref = _safe_reference(args.evidence_ref, label="evidence-ref")
        receipt_name = _receipt_name(args, route_id=route_id, observed_at=observed_at)
        path = args.receipt_dir / receipt_name
        fields: list[tuple[str, object]] = [
            ("schema", ADMISSION_SCHEMA),
            ("status", "quota_available"),
            ("provider", PROVIDER),
            ("route_id", route_id),
            ("capacity_pool", CAPACITY_POOL),
            ("auth_surface", AUTH_SURFACE),
            ("observation", observation),
            ("observed_at", _iso(observed_at)),
            ("stale_after_seconds", args.stale_after_seconds),
            ("evidence_ref", evidence_ref),
            ("secret_source", SECRET_SOURCE),
            ("secret_value_persisted", False),
            ("prompt_or_output_persisted", False),
            ("billing_mode", BILLING_MODE),
            ("account_live_quota_observed", True),
            ("lane_presence_used_as_quota_evidence", False),
            ("saved_login_auth_probe_used_as_quota_evidence", False),
            ("positive_admission", True),
        ]
        _write_flat_yaml_atomic(path, fields)
    except ValueError as exc:
        print(
            f"hapax-codex-quota-admission: {exc}; {VALIDATION_RECOVERY_HINT}",
            file=sys.stderr,
        )
        return 2
    except OSError as exc:
        print(
            "hapax-codex-quota-admission: failed to write receipt: "
            f"{exc}; check receipt-dir existence/permissions or rerun with a writable "
            "--receipt-dir under the governed relay receipts path",
            file=sys.stderr,
        )
        return 1

    summary = {
        "receipt_kind": "admission",
        "path": str(path),
        "route_id": route_id,
        "capacity_pool": CAPACITY_POOL,
        "auth_surface": AUTH_SURFACE,
        "observation": observation,
        "observed_at": _iso(observed_at),
        "stale_after_seconds": args.stale_after_seconds,
        "fresh_until": _iso(
            datetime.fromtimestamp(observed_at.timestamp() + args.stale_after_seconds, UTC)
        ),
        "account_live_quota_observed": True,
        "lane_presence_used_as_quota_evidence": False,
        "saved_login_auth_probe_used_as_quota_evidence": False,
    }
    if rollout is not None:
        # Operator-facing only. These are deliberately NOT receipt fields: the telemetry writer
        # validates a strict field set and an unknown key makes the receipt unparseable.
        summary["measured"] = {
            "source": "codex_cli_session_rollout",
            "primary_used_percent": rollout.used_percent,
            "primary_remaining_percent": round(100.0 - rollout.used_percent, 4),
            "primary_window_minutes": rollout.window_minutes,
            "provider_calls_made": 0,
        }
    if args.json:
        import json

        print(json.dumps(summary, indent=2, sort_keys=True))
    else:
        print(f"hapax-codex-quota-admission: wrote admission receipt -> {path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
