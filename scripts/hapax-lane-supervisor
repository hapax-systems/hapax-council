#!/usr/bin/env bash
# hapax-lane-supervisor — FM-11 lane supervisor (one_for_one re-spawn).
#
# Recover dead lanes without inventing session ownership. Unclaimed lanes come
# up read-only and await governed dispatch. An active lease requires inspection
# of its holding session; a role-level live pane cannot prove that holder lives.
# Under CASE-SYSTEM-INTEGRITY-20260611 (2026-09-24 repair spec), an unresolved or
# orphaned lease is held for governed rebind, never copied/reoffered by this loop.
# Appendix/thin-client hosts suppress unclaimed local idle-await respawns.
#
# Coverage spans active admitted runtimes:
#   - claude (greek): headless pidfile model at $RUNTIME_DIR/<lane>.pid, OR a
#                     live tmux session hapax-claude-<lane>.
#   - codex  (cx-*):  tmux session hapax-codex-<lane>.
#
# Spam control mirrors systemd Restart=always + StartLimit: a per-lane restart
# cooldown plus a burst cap over a sliding window.
#
# Runs as a systemd oneshot on a 60s timer (hapax-lane-supervisor.timer).
set -euo pipefail

now="$(date +%s)"

STATE_DIR="${HAPAX_SUPERVISOR_STATE_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hapax-lane-supervisor}"
RUNTIME_DIR="${HAPAX_SUPERVISOR_RUNTIME_DIR:-/run/user/$(id -u)/hapax-claude}"
WORKTREE_ROOT="${HAPAX_SUPERVISOR_WORKTREE_ROOT:-$HOME/projects}"
VAULT_ROOT="${HAPAX_SUPERVISOR_VAULT_ROOT:-$HOME/Documents/Personal/20-projects/hapax-cc-tasks}"

# Lanes that must stay alive. Greek = non-alpha headless-capable roles (alpha is
# the operator-attended integrator, never auto-respawned); all greek lanes have
# real worktrees (some parked under ~/.claude/worktrees/ — see lane_has_worktree).
#
# Codex supervision is OPT-IN (default empty). The prior hardcoded
# defaults (cx-cpu-bridge/cx-effect-drift-current/cx-preset-storm/cx-visual-bandwidth
# and a bare `antigrav`) named lanes with NO git worktree and NO repo references.
# The live codex lanes are color-named and task-spawned; designating an always-on
# codex roster is an operator policy decision (Phase 6 canonical lane registry).
# Set HAPAX_SUPERVISOR_CODEX_LANES (e.g. a systemd drop-in) to supervise
# specific lanes — a rostered lane that lacks a worktree now
# ESCALATES (below) instead of being silently skipped.
# P0 incident intake is the exception: when an offered P0 incident backlog exists,
# the supervisor may temporarily add HAPAX_P0_CODEX_DRAIN_LANES or
# HAPAX_SUPERVISOR_P0_CODEX_LANES (default: cx-p0 cx-crit, with
# HAPAX_SUPERVISOR_P0_CODEX_LANE as a legacy singular fallback) as Codex drain
# lanes, still gated by real worktrees and the same restart limits.
# `${VAR-default}` (not `:-`): an explicitly-set empty roster means "supervise no
# lanes of this kind", not "fall back to the default". Only an UNSET var defaults.
CLAUDE_LANES="${HAPAX_SUPERVISOR_CLAUDE_LANES-beta gamma delta epsilon zeta eta theta}"
CODEX_LANES="${HAPAX_SUPERVISOR_CODEX_LANES-}"
ANTIGRAV_LANES="${HAPAX_SUPERVISOR_ANTIGRAV_LANES-}"
if [ -n "$ANTIGRAV_LANES" ]; then
  echo "hapax-lane-supervisor: HAPAX_SUPERVISOR_ANTIGRAV_LANES is retired; antigrav/agy is not admitted live supply" >&2
  ANTIGRAV_LANES=""
fi
if [ "${HAPAX_P0_CODEX_DRAIN_LANES+x}" = x ]; then
  P0_CODEX_LANES="$HAPAX_P0_CODEX_DRAIN_LANES"
elif [ "${HAPAX_SUPERVISOR_P0_CODEX_LANES+x}" = x ]; then
  P0_CODEX_LANES="$HAPAX_SUPERVISOR_P0_CODEX_LANES"
else
  P0_CODEX_LANES="${HAPAX_SUPERVISOR_P0_CODEX_LANE-cx-p0 cx-crit}"
fi
P0_CODEX_LANES="${P0_CODEX_LANES//,/ }"
P0_CODEX_DRAIN_ACTIVE=""

RESTART_COOLDOWN_S="${HAPAX_SUPERVISOR_RESTART_COOLDOWN_S:-120}"
BURST_LIMIT="${HAPAX_SUPERVISOR_BURST_LIMIT:-5}"
BURST_WINDOW_S="${HAPAX_SUPERVISOR_BURST_WINDOW_S:-600}"
LAUNCH_TIMEOUT_S="${HAPAX_SUPERVISOR_LAUNCH_TIMEOUT_S:-60}"
# hapax-claude waits for its readiness witness before it returns. Two bounds keep that
# wait inside this oneshot unit's TimeoutStartSec=120:
#   - each claude respawn gets CLAUDE_READY_TIMEOUT_S, well under LAUNCH_TIMEOUT_S, so
#     the `timeout` kill (rc=124) stays an exception;
#   - a claude respawn that could run past CYCLE_BUDGET_S into this cycle is deferred
#     to the next cycle (the timer runs every 60 s). It is never launched unwitnessed.
CLAUDE_READY_TIMEOUT_S="${HAPAX_SUPERVISOR_CLAUDE_READY_TIMEOUT_S:-30}"
CYCLE_BUDGET_S="${HAPAX_SUPERVISOR_CYCLE_BUDGET_S:-90}"
case "$CLAUDE_READY_TIMEOUT_S" in
  '' | *[!0-9]* | 0) CLAUDE_READY_TIMEOUT_S=30 ;; # 0 would switch the witness off
esac
DRY_RUN="${HAPAX_SUPERVISOR_DRY_RUN:-0}"

CLAUDE_HEADLESS_BIN="${HAPAX_CLAUDE_HEADLESS_BIN:-$HOME/.local/bin/hapax-claude-headless}"
CLAUDE_BIN="${HAPAX_CLAUDE_BIN:-$HOME/.local/bin/hapax-claude}"
CODEX_BIN="${HAPAX_CODEX_BIN:-$HOME/.local/bin/hapax-codex}"
CODEX_SLOT="${HAPAX_SUPERVISOR_CODEX_SLOT:-beta}"

# ── escalation thresholds (surface chronic failures; never exit-0-silently) ─────
# A lane that respawn-fails this many times in a row, or sits in the roster with no
# worktree for this many sweep cycles, is escalated via ntfy instead of being
# logged-and-forgotten. Re-fires at most once per ESCALATE_REFIRE_S while unhealthy.
ESCALATE_RESPAWN_FAILS="${HAPAX_SUPERVISOR_ESCALATE_RESPAWN_FAILS:-3}"
ESCALATE_MISSING_WORKTREE_CYCLES="${HAPAX_SUPERVISOR_ESCALATE_MISSING_WORKTREE_CYCLES:-10}"
ESCALATE_REFIRE_S="${HAPAX_SUPERVISOR_ESCALATE_REFIRE_S:-3600}"
NOTIFY_CMD="${HAPAX_SUPERVISOR_NOTIFY_CMD:-}"
NTFY_URL="${HAPAX_SUPERVISOR_NTFY_URL:-${NTFY_URL:-https://ntfy.sh}}"
NTFY_TOPIC="${HAPAX_SUPERVISOR_NTFY_TOPIC:-${NTFY_TOPIC:-hapax-ops}}"

# Output silence is diagnostic only: it cannot distinguish a stopped turn from
# a live writer thinking/building, and a role's old headless log says nothing
# about a pane. Never nudge, reoffer, or launch from its age.
CLAUDE_LOG_DIR="${HAPAX_SUPERVISOR_CLAUDE_LOG_DIR:-$HOME/.cache/hapax/claude-headless}"
STALL_T="${HAPAX_SUPERVISOR_STALL_T:-900}"
PROGRESS_OFF="${HAPAX_SUPERVISOR_PROGRESS_OFF:-0}"
# Admission state command (DI seam; default is the resource-shielding L3 gate).
ADMISSION_CMD="${HAPAX_SUPERVISOR_ADMISSION_CMD:-python3 -m shared.sdlc_pressure_gate --state}"
METRICS_FILE="${HAPAX_SUPERVISOR_METRICS_FILE:-$HOME/.local/var/lib/node_exporter/textfile_collector/hapax-lane-supervisor.prom}"

# ── zombie-launcher reaper ────────────────────────────────────────────────────
# A headless launcher can outlive its task: claude reads its stdin from a FIFO
# whose write-end the launcher holds open, so claude never EOFs, the launcher's
# `wait` never returns, and its own task_is_terminal teardown is unreachable. The
# launcher then pins the lane (lifetime flock) and blocks re-dispatch. The
# launcher now self-reaps out-of-band, but (a) launchers deployed before that fix
# and (b) any future wedge need a supervisor-side backstop. This leg SIGTERMs the
# EXACT launcher pid (single positive pid — NEVER a process group, the pinned
# exit-144 cascade) when the lane's task is terminal (gated on admission_state)
# or a terminal-task launcher exceeds the lifetime ceiling. Age alone cannot
# authorize a reap; active or unresolved claims hold at the signal boundary.
REAP_OFF="${HAPAX_SUPERVISOR_REAP_OFF:-0}"
LAUNCHER_MAX_LIFETIME_S="${HAPAX_SUPERVISOR_LAUNCHER_MAX_LIFETIME_S:-21600}"  # 6h
# Grace between SIGTERMing a launcher for the ceiling and calling that reap
# failed. One sweep is 60s; a launcher whose EXIT trap is mid-teardown must not
# be mistaken for one that ignored the signal.
LIFETIME_REAP_GRACE_S="${HAPAX_SUPERVISOR_LIFETIME_REAP_GRACE_S:-120}"
PROC_SCAN_LAUNCHERS="${HAPAX_SUPERVISOR_PROC_SCAN_LAUNCHERS:-1}"

# Repo root for `python3 -m shared.…`. Resolve $0 through the deploy symlink
# (~/.local/bin/…) so REPO_DIR is the release dir that actually ships shared/;
# fall back to the integrator worktree. admission_state fails open regardless.
REPO_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." 2>/dev/null && pwd || true)"
[ -n "$REPO_DIR" ] && [ -d "$REPO_DIR/shared" ] || REPO_DIR="$HOME/projects/hapax-council"

PROGRESS_STALLED_TICK=0  # per-tick gauge: lanes found output-stalled this sweep
mkdir -p "$STATE_DIR"

log() { printf '%s lane-supervisor: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }

site_class() {
  # Explicit site classes (G1 D2). Host names and mode strings map here; they
  # are placement hints, not identity. remote/thin-client are NOT appendix.
  local mode="${HAPAX_LOCAL_DEV_MAINTENANCE_MODE:-}"
  if [ -z "$mode" ]; then
    mode="${HAPAX_DEFAULT_DISPATCH_HOST:-${HAPAX_DISPATCH_HOST:-local}}"
  fi
  case "$mode" in
    appendix|hapax-appendix|appendix-only|appendix_only)
      echo "appendix-only"
      ;;
    remote|thin-client|thin_client|remote-client)
      echo "remote-client"
      ;;
    *)
      echo "local"
      ;;
  esac
}

local_dev_maintenance_mode() {
  # Policy derived from site class, not from the mode string. Both non-local
  # classes suppress local required-lane launch; they stay distinct so a future
  # policy split is one map entry, not a string-match rewrite.
  case "$(site_class)" in
    appendix-only|remote-client)
      echo "appendix-only"
      ;;
    *)
      echo "local"
      ;;
  esac
}

SITE_CLASS="$(site_class)"
LOCAL_DEV_MAINTENANCE_MODE="$(local_dev_maintenance_mode)"
log "site-class ${SITE_CLASS} (maintenance=${LOCAL_DEV_MAINTENANCE_MODE})"
if [ "$LOCAL_DEV_MAINTENANCE_MODE" = "appendix-only" ]; then
  log "appendix-only local-dev maintenance: unclaimed idle-await respawns disabled; active claims held for session ownership resolution"
fi

p0_intake_backlog_present() {
  [ "${HAPAX_SUPERVISOR_P0_IDLE_RESPAWN:-1}" = "1" ] || return 1
  python3 - "$VAULT_ROOT/active" <<'PY'
import re
import sys
from pathlib import Path

active = Path(sys.argv[1])
if not active.is_dir():
    sys.exit(1)


def field(frontmatter: str, key: str) -> str:
    match = re.search(rf"(?im)^{re.escape(key)}:\s*(.*)$", frontmatter)
    return match.group(1).strip().strip("\"'") if match else ""


for path in sorted(active.glob("*.md")):
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        continue
    if not text.startswith("---"):
        continue
    parts = text.split("---", 2)
    if len(parts) < 3:
        continue
    frontmatter = parts[1]
    if field(frontmatter, "status").lower() != "offered":
        continue
    if field(frontmatter, "priority").lower() != "p0":
        continue
    haystack = " ".join(
        (
            path.stem,
            field(frontmatter, "title"),
            field(frontmatter, "kind"),
            field(frontmatter, "tags"),
        )
    ).lower()
    if (
        "p0-incident" in path.stem.lower()
        or "incident-intake" in haystack
        or "technical-alert" in haystack
    ):
        sys.exit(0)
sys.exit(1)
PY
}

task_note_is_p0_incident() {
  local task_id="$1"
  [ -n "$task_id" ] || return 1
  python3 - "$VAULT_ROOT/active" "$task_id" <<'PY'
import re
import sys
from pathlib import Path

active, task_id = Path(sys.argv[1]), sys.argv[2]
if not active.is_dir():
    sys.exit(1)

note = active / f"{task_id}.md"
if not note.is_file():
    note = next(iter(sorted(active.glob(f"{task_id}-*.md"))), None)
if note is None or not note.is_file():
    sys.exit(1)

text = note.read_text(encoding="utf-8", errors="replace")
if not text.startswith("---"):
    sys.exit(1)
parts = text.split("---", 2)
if len(parts) < 3:
    sys.exit(1)
frontmatter = parts[1]

def field(key: str) -> str:
    match = re.search(rf"(?im)^{re.escape(key)}:\s*(.*)$", frontmatter)
    return match.group(1).strip().strip("\"'") if match else ""

if field("priority").lower() != "p0":
    sys.exit(1)

haystack = " ".join(
    (
        note.stem,
        field("title"),
        field("kind"),
        field("tags"),
        field("incident_kind"),
        field("incident_fingerprint"),
    )
).lower().replace("_", "-")
markers = ("p0-incident", "incident-intake", "technical-alert", "sdlc-task-stalled")
sys.exit(0 if any(marker in haystack for marker in markers) else 1)
PY
}

codex_p0_drain_lane_configured() {
  [ -n "$P0_CODEX_LANES" ] || return 1
  [ "$P0_CODEX_LANES" != "none" ] || return 1
  local lane="$1" configured
  for configured in $P0_CODEX_LANES; do
    [ "$configured" = "none" ] && continue
    [ "$configured" = "$lane" ] && return 0
  done
  return 1
}

codex_p0_drain_lane_active() {
  case " $P0_CODEX_DRAIN_ACTIVE " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

codex_drain_lane_has_claimed_p0_incident() {
  local lane="$1" task_line task_id
  task_line="$(resolve_claimed_task "$lane")"
  IFS=$'\t' read -r task_id _ <<< "$task_line"
  [ -n "$task_id" ] || return 1
  task_note_is_p0_incident "$task_id"
}

codex_should_force_respawn() {
  local lane="$1" task_id="${2:-}"
  if [ -n "$task_id" ]; then
    codex_p0_drain_lane_configured "$lane" && task_note_is_p0_incident "$task_id"
    return
  fi
  codex_p0_drain_lane_active "$lane"
}

activate_p0_codex_drain_lane() {
  [ -n "$P0_CODEX_LANES" ] || return 0
  [ "$P0_CODEX_LANES" != "none" ] || return 0
  local backlog_present=0 lane activation_reason=""
  if p0_intake_backlog_present; then
    backlog_present=1
  fi
  for lane in $P0_CODEX_LANES; do
    [ "$lane" != "none" ] || continue
    activation_reason=""
    if [ "$backlog_present" = "1" ]; then
      activation_reason="backlog"
    elif codex_drain_lane_has_claimed_p0_incident "$lane"; then
      activation_reason="claimed"
    else
      continue
    fi
    if ! lane_has_worktree "$lane"; then
      log "P0 incident drain lane $lane is needed ($activation_reason) but has no worktree — cannot add drain capacity; recheck: test -d $WORKTREE_ROOT/hapax-council--$lane; provision: git -C $WORKTREE_ROOT/hapax-council worktree add $WORKTREE_ROOT/hapax-council--$lane -b codex/$lane origin/main; or remove/override it via HAPAX_P0_CODEX_DRAIN_LANES, HAPAX_SUPERVISOR_P0_CODEX_LANES, HAPAX_SUPERVISOR_P0_CODEX_LANE, or the built-in default"
      continue
    fi
    case " $P0_CODEX_DRAIN_ACTIVE " in
      *" $lane "*) ;;
      *) P0_CODEX_DRAIN_ACTIVE="${P0_CODEX_DRAIN_ACTIVE:+$P0_CODEX_DRAIN_ACTIVE }$lane" ;;
    esac
    case " $CODEX_LANES " in
      *" $lane "*) ;;
      *)
        CODEX_LANES="${CODEX_LANES:+$CODEX_LANES }$lane"
        if [ "$activation_reason" = "claimed" ]; then
          log "P0 incident task is claimed by codex drain lane $lane — preserving drain supervision"
        else
          log "P0 incident backlog exists — adding codex drain lane $lane"
        fi
        ;;
    esac
  done
}

# ── liveness ──────────────────────────────────────────────────────────────────

# Every session target below is anchored to the EXACT name. tmux resolves a bare
# target by exact name, then by PREFIX, then by fnmatch — so `hapax-claude-cx-cap`
# resolves to `hapax-claude-cx-cap-money` whenever the former is missing, and this
# estate's lane names do nest like that. Measured on tmux 3.7c, private socket, with
# only `hapax-claude-delta-2` running: `has-session -t hapax-claude-delta` returned 0
# and `kill-session -t hapax-claude-delta` killed the sibling. `=name` forces an exact
# match on has-session and kill-session. It does NOT help list-panes: `-s -t =name`
# still reported the sibling's panes instead of failing — so the pane list is read
# server-wide and filtered on the exact name rather than targeted at all.

# tmux_session_panes <session> <format>: one line of <format> per pane belonging to
# exactly <session>, across ALL of its windows. Empty when it has none.
tmux_session_panes() {
  local session="$1" fmt="$2"
  tmux list-panes -a -F "#{session_name}"$'\t'"$fmt" 2>/dev/null |
    awk -F '\t' -v s="$session" '$1 == s { print substr($0, length(s) + 2) }'
}

# A session is alive only if it still has at least one LIVE pane.
#
# `has-session` is not that test. Lane windows are now created with
# `remain-on-exit failed` (see hapax-claude / hapax-codex), so a pane whose process
# dies on a signal or a non-zero status is KEPT — exit status, signal and scrollback
# intact — because a lane death used to destroy its own evidence. But a retained dead
# pane keeps the SESSION, so `has-session` reports a corpse as a live lane and the
# supervisor never respawns it. That is FM-11 defeated by the very change meant to make
# deaths legible, which is why liveness moved here rather than remain-on-exit being
# left off.
#
# Every window matters: a lane whose active window died must not read as alive on the
# strength of another, which is why the listing is server-wide (`-a`) and filtered by
# session rather than `list-panes -t <session>`, which reports one window.
tmux_has_live_pane() {
  local session="$1" states=""
  tmux has-session -t "=$session" 2>/dev/null || return 1
  states="$(tmux_session_panes "$session" '#{pane_dead}')"
  # No pane list at all — a tmux too old for the format, or a race with teardown.
  # Fall back to has-session, which is what this test used to be. Failing OPEN keeps a
  # working lane running; failing closed would respawn on top of a live one.
  [ -n "$states" ] || return 0
  # Only a complete all-dead observation permits recovery. Malformed pane
  # data is occupied/unknown, never evidence that it is safe to launch.
  if printf '%s\n' "$states" | grep -qvx '1'; then
    return 0
  fi
  return 1
}

claude_alive() {
  local lane="$1" pidfile="$RUNTIME_DIR/$1.pid" pid=""
  if [ -f "$pidfile" ]; then
    pid="$(cat "$pidfile" 2>/dev/null || true)"
    if [[ ! "$pid" =~ ^[1-9][0-9]*$ ]]; then
      log "$lane: writer_unresolved:invalid_pid — inspect $pidfile"
      return 0
    fi
    if kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
  fi
  tmux_has_live_pane "hapax-claude-$lane"
}

tmux_session_alive() { tmux_has_live_pane "$1"; }

# ── dead-pane forensics ──────────────────────────────────────────────────────
#
# The measured gap this closes: the dev lane's claude died at 01:19:34Z with no
# coredump, no kernel line, no oomd record and no supervisor or launcher kill — and
# the pane went with it, so the cause was not merely unknown but UNMEASURABLE. With
# `remain-on-exit failed` the corpse is kept; this reads it before the respawn clears
# it away. Writing the log is therefore a precondition of the kill, not a courtesy
# after it: kill first and the evidence is gone exactly as before.
#
# A tmux hook could capture this and deliberately does not. Measured 2026-09-16:
# `pane-exited` never fires when `remain-on-exit` retains the pane (nothing exited —
# the pane went dead), but `pane-died` does, and `#{hook_pane}`, `#{pane_dead_status}`,
# `#{pane_dead_signal}` and `#{pane_start_command}` all resolve correctly inside it.
# It is still the wrong home for this: the corpse must also be KILLED or the launcher
# cannot start, the capture and the kill have to be one ordered unit owned by whoever
# does the respawn, and a hook set at launch covers only sessions created after this
# change — not one left by an older launcher or started by hand. Splitting the record
# across a hook and this function would be two writers for one log.
PANE_EXIT_LOG_DIR="${HAPAX_PANE_EXIT_LOG_DIR:-$HOME/.cache/hapax/tmux-pane-exits}"
PANE_EXIT_RETENTION_DAYS="${HAPAX_PANE_EXIT_RETENTION_DAYS:-30}"

# capture_dead_pane <lane> <session>: record why the pane died, then remove the
# session so the launcher's `new-session` can succeed. Never fails the caller — a
# respawn must not be blocked by the forensics failing.
capture_dead_pane() {
  local lane="$1" session="$2" stamp logfile pane dead=""
  tmux has-session -t "=$session" 2>/dev/null || return 0

  # Only a session with NO live pane is a corpse. Anything else is a working lane and
  # must never be killed here on the strength of one dead window.
  if tmux_has_live_pane "$session"; then
    return 0
  fi

  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  mkdir -p "$PANE_EXIT_LOG_DIR" 2>/dev/null || true
  logfile="$PANE_EXIT_LOG_DIR/$stamp-$lane.log"

  {
    printf 'lane: %s\n' "$lane"
    printf 'session: %s\n' "$session"
    printf 'captured_at: %s\n' "$stamp"
    # One block per pane, addressed by pane id rather than by session: `capture-pane
    # -t <session>` reads only the current window's active pane, which would silently
    # drop the very pane that died in a multi-window lane.
    while IFS= read -r pane; do
      [ -n "$pane" ] || continue
      # These four fields are the whole reason this function exists. status and signal
      # say HOW it died — and they are mutually exclusive, so both must be recorded
      # (measured: SIGKILL gives signal=9 with status empty; `exit 42` gives status=42
      # with signal empty). start_command says what was running, dead_time says when.
      tmux display-message -p -t "$pane" \
        'pane: #{pane_id} pane_dead=#{pane_dead} pane_dead_status=#{pane_dead_status} pane_dead_signal=#{pane_dead_signal} pane_dead_time=#{pane_dead_time} pane_start_command=#{pane_start_command}' \
        2>/dev/null || printf 'pane: %s <display-message failed>\n' "$pane"
      printf -- '--- %s: last 60 lines ---\n' "$pane"
      tmux capture-pane -p -S -60 -t "$pane" 2>/dev/null || printf '<capture-pane failed>\n'
    done <<< "$(tmux_session_panes "$session" '#{pane_id}')"
  } >"$logfile" 2>/dev/null || true

  dead="$(tmux_session_panes "$session" 'status=#{pane_dead_status} signal=#{pane_dead_signal}' | head -1 || true)"
  # Name the evidence only if it exists. The capture is best-effort by design — a
  # respawn must never be blocked by forensics failing — which is exactly why this
  # line may not assert a file it has not checked: pointing the operator at an empty
  # path is the silent loss this whole change exists to remove.
  if [ -s "$logfile" ]; then
    log "$lane: dead pane retained by remain-on-exit (${dead:-unknown}) — forensics in $logfile"
  else
    log "$lane: dead pane retained by remain-on-exit (${dead:-unknown}) — forensics NOT written to $logfile and this corpse is cleared below, so its last lines are lost; next: make $PANE_EXIT_LOG_DIR a writable directory before the next death (mkdir -p \"$PANE_EXIT_LOG_DIR\"; ls -ld \"$PANE_EXIT_LOG_DIR\") or point HAPAX_PANE_EXIT_LOG_DIR elsewhere"
  fi

  # Only now. The launchers refuse to start over an existing session, so the kill is
  # what makes the respawn possible; doing it before the read would restore exactly the
  # blindness this exists to remove. Exact name: see the liveness section.
  if tmux_has_live_pane "$session"; then
    log "$lane: respawn_hold:pane_changed_during_capture — preserving session; next: inspect tmux list-panes -a and the claim-holder receipt, then recheck the next supervisor tick"
    return 0
  fi
  tmux kill-session -t "=$session" 2>/dev/null || true

  # Retention, best-effort and last, so a prune failure never costs us a capture.
  find "$PANE_EXIT_LOG_DIR" -maxdepth 1 -name '*.log' -type f \
    -mtime "+$PANE_EXIT_RETENTION_DAYS" -delete 2>/dev/null || true
}

# ── spam control ────────────────────────────────────────────────────────────

within_cooldown() {
  local marker="$STATE_DIR/$1.last-restart" last elapsed
  [ -f "$marker" ] || return 1
  last="$(cat "$marker" 2>/dev/null || echo 0)"
  elapsed=$(( now - last ))
  [ "$elapsed" -lt "$RESTART_COOLDOWN_S" ]
}

burst_exhausted() {
  local logf="$STATE_DIR/$1.restart-log" cutoff count=0 ts
  [ -f "$logf" ] || return 1
  cutoff=$(( now - BURST_WINDOW_S ))
  while read -r ts; do
    [ -z "$ts" ] && continue
    [ "$ts" -ge "$cutoff" ] && count=$(( count + 1 ))
  done < "$logf"
  [ "$count" -ge "$BURST_LIMIT" ]
}

record_restart() {
  echo "$now" > "$STATE_DIR/$1.last-restart"
  echo "$now" >> "$STATE_DIR/$1.restart-log"
}

# ── escalation ────────────────────────────────────────────────────────────────

# notify <title> <body>: emit an operator-visible alert. Overridable for tests
# via HAPAX_SUPERVISOR_NOTIFY_CMD; the default posts to ntfy (headless-safe) plus
# a best-effort desktop notification.
notify() {
  local title="$1" body="$2"
  log "ESCALATION — $title: $body"
  if [ -n "$NOTIFY_CMD" ]; then
    "$NOTIFY_CMD" "$title" "$body" || log "notify: NOTIFY_CMD failed"
    return 0
  fi
  if [ -n "$NTFY_TOPIC" ] && command -v curl >/dev/null 2>&1; then
    curl -fsS --max-time 10 \
      -H "Title: $title" -H "Priority: high" -H "Tags: warning,robot" \
      -d "$body" "$NTFY_URL/$NTFY_TOPIC" >/dev/null 2>&1 \
      || log "notify: ntfy POST to $NTFY_URL/$NTFY_TOPIC failed"
  fi
  if [ -x "$REPO_DIR/scripts/hapax-p0-incident-intake" ]; then
    "$REPO_DIR/scripts/hapax-p0-incident-intake" notification \
      --title "$title" \
      --message "$body" \
      --priority urgent \
      --tag skull \
      --technical >/dev/null 2>&1 \
      && return 0
    log "notify: p0 incident intake failed; next action: inspect ~/.cache/hapax/p0-incident-intake/state.json and events.jsonl, then rerun $REPO_DIR/scripts/hapax-p0-incident-intake notification with this title/body"
  fi
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -u critical "$title" "$body" >/dev/null 2>&1 || true
  fi
}

# bump_streak <lane> <tag>: increment a persisted counter, echo the new value.
bump_streak() {
  local f="$STATE_DIR/$1.$2-streak" v=0
  [ -f "$f" ] && v="$(cat "$f" 2>/dev/null || echo 0)"
  case "$v" in '' | *[!0-9]*) v=0 ;; esac
  v=$(( v + 1 ))
  echo "$v" > "$f"
  printf '%s\n' "$v"
}

# clear_streak <lane> <tag>: reset counter + escalation marker after recovery.
clear_streak() {
  rm -f "$STATE_DIR/$1.$2-streak" "$STATE_DIR/$1.$2-escalated-at" 2>/dev/null || true
}

# escalate <lane> <tag> <title> <body>: notify on first crossing, then at most
# once per ESCALATE_REFIRE_S while the condition persists (avoids per-cycle spam).
escalate() {
  local lane="$1" tag="$2" title="$3" body="$4"
  local marker="$STATE_DIR/$lane.$tag-escalated-at" last=0
  [ -f "$marker" ] && last="$(cat "$marker" 2>/dev/null || echo 0)"
  case "$last" in '' | *[!0-9]*) last=0 ;; esac
  if [ "$(( now - last ))" -lt "$ESCALATE_REFIRE_S" ]; then
    return 0
  fi
  notify "$title" "$body"
  echo "$now" > "$marker"
}

# lane_has_worktree <lane>: true if the lane has a real worktree. Checks the
# configured root first (common case + tests), then any registered git worktree
# (greek lanes can be parked under ~/.claude/worktrees/, not ~/projects/), so a
# live lane is never falsely flagged missing.
lane_has_worktree() {
  local lane="$1"
  [ -d "$WORKTREE_ROOT/hapax-council--$lane" ] && return 0
  if [ "${HAPAX_SUPERVISOR_GIT_WORKTREE_DETECT:-1}" = "1" ] && command -v git >/dev/null 2>&1; then
    local gitdir="${HAPAX_SUPERVISOR_GIT_DIR:-$WORKTREE_ROOT/hapax-council}"
    if [ -d "$gitdir" ] && git -C "$gitdir" worktree list --porcelain 2>/dev/null \
        | grep -qE "^worktree .*/hapax-council--$lane$"; then
      return 0
    fi
  fi
  return 1
}

# Active owned task → "task_id<TAB>title", else empty. The claim file names the
# task; the vault note is the authority for status/assignment. Keep the accepted
# statuses aligned with shared.sdlc_lifecycle.TASK_MUTABLE_STATUSES without
# importing from systemd-launched embedded Python.
resolve_claimed_task() {
  local lane="$1"
  python3 - "$VAULT_ROOT" "$lane" "$HOME/.cache/hapax/cc-active-task-$lane" <<'PY' 2>/dev/null || true
import re
import sys
from pathlib import Path

vault_root, lane, claim_file = Path(sys.argv[1]), sys.argv[2], Path(sys.argv[3])
active = vault_root / "active"
claim_files = [claim_file]
claim_files.extend(sorted(claim_file.parent.glob(f"{claim_file.name}-*")))

def field(name: str) -> str:
    m = re.search(rf"^{name}:\s*(.+?)\s*$", text, re.MULTILINE)
    return m.group(1).strip().strip('"').strip("'") if m else ""

for candidate in sorted(
    [path for path in claim_files if path.is_file()],
    key=lambda path: path.stat().st_mtime,
    reverse=True,
):
    lines = [ln.strip() for ln in candidate.read_text(errors="replace").splitlines() if ln.strip()]
    if not lines:
        continue
    task_id = lines[0]
    note = active / f"{task_id}.md"
    if not note.is_file():
        note = next(iter(sorted(active.glob(f"{task_id}-*.md"))), None) if active.is_dir() else None
    if note is None or not note.is_file():
        continue
    text = note.read_text(errors="replace")
    active_owned_statuses = {
        "claimed",
        "in_progress",
        "pr_open",
        "merge_queue",
        "ci_green",
        "ready",
        "ready_for_review",
        "review_ready",
        "ready_for_merge",
    }
    if field("status") in active_owned_statuses and field("assigned_to") == lane:
        print(f"{task_id}\t{field('title')}")
        sys.exit(0)
PY
}

# Inspect every session claim before the role-level liveness short circuit.
# An active claim is NOT authority to mint a successor session. Until a governed
# rebind exists, all active leases hold automatic respawn: live, unknown, or
# orphaned. This observer never writes a task, claim marker, or epoch sidecar.
claim_holder_guard() {
  python3 - "$REPO_DIR" "$VAULT_ROOT" "$1" "$RUNTIME_DIR" "$STATE_DIR" \
    "${HAPAX_SUPERVISOR_LANEBUS_DIR:-$HOME/Documents/Personal/30-areas/hapax/lanebus}" "${2:-observe}" "${3:-}" <<'PYCLAIM'
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

repo, vault, lane, runtime, state_dir, bus, mode, reap_pid = sys.argv[1:]
sys.path.insert(0, repo)
from shared.session_identity import is_claim_keyable_session_id, session_role_marker_path

cache = Path.home() / ".cache/hapax"
prefix = f"cc-active-task-{lane}"
# Preserve the reaper's established cleanup vocabulary; canonical lifecycle
# membership is verified in test_reaper_status_vocabulary; keep this stdlib-only
# observer usable in the service interpreter without adding a YAML dependency.
terminal = {"done", "completed", "closed", "withdrawn", "superseded", "cancelled", "canceled", "abandoned"}
reap_inputs = {}


def read_input(path):
    if mode != "reap":
        return path.read_text()
    if path.is_symlink():
        raise ValueError("symlinked_reap_input")
    before = path.stat()
    content = path.read_bytes()
    after = path.stat()
    stamp = lambda st: (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns, st.st_ctime_ns)
    observed = (stamp(after), content)
    if stamp(before) != stamp(after) or (path in reap_inputs and reap_inputs[path] != observed):
        raise ValueError("reap_input_changed")
    reap_inputs[path] = observed
    return content.decode()


def check_epoch(path, task):
    epoch = cache / path.name.replace("cc-active-task-", "cc-claim-epoch-", 1)
    parts = read_input(epoch).split()
    if len(parts) != 2 or not parts[0].isdecimal() or int(parts[0]) <= 0 or parts[1] != task:
        raise ValueError("claim_epoch_unresolved")



def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() else None


def field(text, name):
    match = re.search(rf"^{name}:[ \t]*(.*)$", text, re.MULTILINE)
    return match.group(1).strip().strip("\"'") if match else ""


def launcher_binding():
    # Use the launcher's existing session PID and current-task producers. A
    # role marker, old terminal session, or inherited environment is not its
    # task identity. Missing/ambiguous/older-than-process bindings hold.
    if not re.fullmatch(r"[1-9][0-9]*", reap_pid):
        raise ValueError("invalid_launcher_pid")
    proc = Path("/proc") / reap_pid
    stat = (proc / "stat").read_text().rsplit(")", 1)[1].split()
    if stat[0] in {"Z", "X"}:
        raise ValueError("launcher_exited")
    boot = next(line.split()[1] for line in Path("/proc/stat").read_text().splitlines()
                if line.startswith("btime "))
    started = int(boot) + int(stat[19]) / os.sysconf("SC_CLK_TCK")
    bindings = []
    for path in Path(runtime).glob(f"{lane}-*.launcher.pid"):
        if read_input(path).strip() != reap_pid:
            continue
        sid = path.name[len(lane) + 1:-len(".launcher.pid")]
        if not is_claim_keyable_session_id(sid) or path.stat().st_mtime < started:
            raise ValueError("stale_or_invalid_session_pid")
        if read_input(session_role_marker_path(sid, cache_dir=cache)).strip() != lane:
            raise ValueError("launcher_session_role_mismatch")
        bindings.append(sid)
    if len(bindings) != 1:
        raise ValueError("launcher_session_not_unique")
    task = read_input(Path(runtime) / f"{lane}.current-task").strip()
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", task):
        raise ValueError("launcher_task_unresolved")
    return bindings[0], task


def writer_process_state(proc, sid):
    # Session variables are inherited by helpers. Identify the native writer
    # executable as well; argv, comm and the session environment alone cannot
    # distinguish Claude from a surviving shell/sleep/tool. The launcher also
    # resolves `claude` on PATH. An unavailable, upgraded or interpreted binding
    # is unresolved, never evidence authorizing recovery.
    try:
        before = (proc / "stat").read_text().rsplit(")", 1)[1].split()
        if before[0] in {"Z", "X"}:
            return "dead", "pid_exited"
        env = dict(part.split("=", 1) for part in (proc / "environ").read_text().split("\0") if "=" in part)
        if env.get("HOME") != str(Path.home()) or env.get("HAPAX_SESSION_ID") != sid:
            return "unknown", "pid_identity_mismatch"
        binding = shutil.which("claude")
        if not binding:
            return "unknown", "writer_binding_unresolved"
        with Path(binding).open("rb") as executable:
            if executable.read(4) != b"\x7fELF":
                return "unknown", "writer_binding_unresolved"
        if not (proc / "exe").samefile(binding):
            return "unknown", "writer_executable_mismatch"
        after = (proc / "stat").read_text().rsplit(")", 1)[1].split()
        if after[0] in {"Z", "X"} or before[19] != after[19]:
            return "unknown", "writer_changed_during_inspection"
        return "live", "session_process"
    except (OSError, ValueError, IndexError):
        return "unknown", "writer_inspection_unresolved"


def pid_state(path, sid, launcher=False):
    try:
        raw = path.read_text().strip()
        if not raw.isdecimal() or int(raw) <= 0:
            return "unknown", "invalid_pid"
        proc = Path("/proc") / raw
        try:
            stat = (proc / "stat").read_text().rsplit(")", 1)[1].split()
        except FileNotFoundError:
            return "dead", "pid_gone"
        if stat[0] in {"Z", "X"}:
            return "dead", "pid_exited"
        if launcher:
            # A wrapper can outlive its writer, even with the right session env.
            return "unknown", "launcher_identity_unobserved"
        return writer_process_state(proc, sid)
    except (OSError, ValueError, IndexError):
        return "unknown", "pid_unreadable"


def pane_holder_state(sid):
    # Walk all exact-session pane roots and descendants, never another role's
    # pane. A retained dead pane is not a live process. Failure proves nothing.
    try:
        rows = subprocess.run(
            ["tmux", "list-panes", "-a", "-F", "#{session_name}\t#{pane_dead}\t#{pane_pid}"],
            capture_output=True, text=True, timeout=3, check=True,
        ).stdout.splitlines()
        roots = set()
        for row in rows:
            fields = row.split("\t")
            if fields[0] != f"hapax-claude-{lane}":
                continue
            if len(fields) != 3 or fields[1] not in {"0", "1"}:
                return "unknown"
            if fields[1] == "0":
                if not fields[2].isdecimal() or int(fields[2]) <= 0:
                    return "unknown"
                roots.add(fields[2])
        if not roots:
            return "absent"
        parents = {}
        for proc in Path("/proc").iterdir():
            if not proc.name.isdecimal():
                continue
            try:
                fields = (proc / "stat").read_text().rsplit(")", 1)[1].split()
                if fields[0] not in {"Z", "X"}:
                    parents[proc.name] = fields[1]
            except (OSError, IndexError):
                continue
        if not roots.issubset(parents):
            return "unknown"
        descendants = set(roots)
        while True:
            expanded = descendants | {pid for pid, parent in parents.items() if parent in descendants}
            if expanded == descendants:
                break
            descendants = expanded
        unreadable = False
        for pid in descendants:
            observed, why = writer_process_state(Path("/proc") / pid, sid)
            if observed == "live":
                return "live"
            # A same-session helper is not the writer, but it may also be an
            # older writer executable after an upgrade. Preserve that uncertainty
            # even when a stale headless PID says dead.
            if observed == "unknown" and why != "pid_identity_mismatch":
                unreadable = True
        return "unknown" if unreadable else "absent"
    except (OSError, subprocess.SubprocessError):
        return "unknown"


def holder_state(sid):
    if not sid:
        return "unknown", "legacy_claim_without_session"
    pane_state = pane_holder_state(sid)
    if pane_state == "live":
        return "live", "pane_session_process"
    paths = [(Path(runtime) / f"{lane}-{sid}.pid", False),
             (Path(runtime) / f"{lane}-{sid}.launcher.pid", True)]
    observed = [pid_state(path, sid, launcher) for path, launcher in paths if path.exists()]
    if any(state == "live" for state, _ in observed):
        return "live", "session_process"
    if pane_state == "unknown":
        return "unknown", "pane_inspection_unresolved"
    if observed and all(state == "dead" for state, _ in observed):
        return "dead", "session_pids_exited"
    return "unknown", next((why for state, why in observed if state == "unknown"), "session_pid_unresolved")


def record_claim_observation(path, sid, task, observed, why, note):
    # Invalid session keys are still observed claims. Preserve their exact path
    # instead of reconstructing a legacy key from the unresolved session ID.
    epoch = cache / path.name.replace("cc-active-task-", "cc-claim-epoch-", 1)
    if (path.parent != cache or not (path.name == prefix or path.name.startswith(prefix + "-"))
            or path.is_symlink() or epoch.is_symlink()):
        raise ValueError("claim_path_outside_cache_namespace")
    receipt = dict(lane=lane, session_id=sid or None, task_id=task, state=observed, reason=why,
                   pid_bindings={str(p): digest(p) for p in Path(runtime).glob(f"{lane}-{sid}*.pid")} if sid else {},
                   claim_path=str(path), claim_sha256=digest(path), epoch_sha256=digest(epoch),
                   note_sha256=digest(note) if note else None, next_action="preserve_claim; governed_rebind_required" if observed == "dead" else "preserve_claim; inspect_session")
    if observed != "live":
        current = Path(state_dir) / f"{lane}-{sid or 'legacy'}.claim-holder.json"
        previous = json.loads(current.read_text()) if current.exists() else None
        if previous != receipt:
            folder = Path(bus) / lane
            folder.mkdir(parents=True, exist_ok=True)
            stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
            with (folder / f"{stamp}-claim-holder-{sid or 'legacy'}.json").open("x") as output:
                json.dump(dict(receipt, observed_at=stamp), output, sort_keys=True)
                output.write("\n")
            current.write_text(json.dumps(receipt, sort_keys=True) + "\n")


try:
    claims = []
    claim_paths = sorted(cache.glob(prefix + "-*"))
    for path in claim_paths:
        sid = path.name[len(prefix) + 1:]
        if not is_claim_keyable_session_id(sid):
            claims.append((path, ""))
            continue
        claims.append((path, sid))
    covered = {read_input(path).strip() for path, _ in claims}
    legacy = cache / prefix
    if legacy.exists() and read_input(legacy).strip() not in covered:
        claims.append((legacy, ""))
    held = False
    terminal_claims = set()
    # cc-claim publishes the task note before its epochs/claim files. Observe
    # owned active notes as part of the same snapshot, including this first
    # publication window where every old sidecar can still agree.
    active_notes = sorted((Path(vault) / "active").glob("*.md")) if mode == "reap" else []
    for active_note in active_notes:
        content = read_input(active_note)
        front = content.split("---", 2)[1] if content.startswith("---\n") else ""
        if field(front, "assigned_to") == lane and field(front, "status") not in terminal:
            print(f"{lane}: reap_hold:nonterminal_owned_note:{active_note}; preserve launcher and inspect claim publication", flush=True)
            held = True
    for path, sid in claims:
        task = read_input(path).strip()
        if not task:
            held = True
            print(f"{lane}: claim_orphan_unresolved:empty_claim; preserve claim and inspect publication at {path}", flush=True)
            record_claim_observation(path, sid, None, "unknown", "empty_claim", None)
            continue
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", task):
            held = True
            print(f"{lane}: claim_orphan_unresolved:invalid_task_id; preserve claim and inspect {path} through governed repair", flush=True)
            record_claim_observation(path, sid, None, "unknown", "invalid_task_id", None)
            continue
        note = Path(vault) / "active" / f"{task}.md"
        if not note.is_file():
            note = Path(vault) / "closed" / f"{task}.md"
        text = read_input(note) if note.is_file() else ""
        frontmatter = text.split("---", 2)[1] if text.startswith("---\n") else ""
        if field(frontmatter, "status") in terminal and (mode != "reap" or field(frontmatter, "assigned_to") == lane):
            if mode == "reap":
                if field(frontmatter, "task_id") != task:
                    raise ValueError("terminal_note_task_mismatch")
                check_epoch(path, task)
            terminal_claims.add((sid, task))
            continue
        # A role can prefix another role's marker key. Exclude a sibling only
        # when the task's assigned role and the complete key identify it; a
        # conflicting session-role marker for OUR key is uncertainty, not absence.
        owner = field(frontmatter, "assigned_to")
        if owner and owner != lane:
            owner_prefix = f"cc-active-task-{owner}"
            if path.name == owner_prefix:
                continue
            if path.name.startswith(owner_prefix + "-"):
                owner_sid = path.name[len(owner_prefix) + 1:]
                if is_claim_keyable_session_id(owner_sid):
                    owner_marker = session_role_marker_path(owner_sid, cache_dir=cache)
                    if owner_marker.is_file() and owner_marker.read_text().strip() == owner:
                        continue
        held = True
        observed, why = holder_state(sid)
        if sid:
            role_marker = session_role_marker_path(sid, cache_dir=cache)
            if role_marker.exists() and role_marker.read_text().strip() != lane:
                observed, why = "unknown", "session_role_mismatch"
        if field(frontmatter, "assigned_to") != lane or not field(frontmatter, "status"):
            observed, why = "unknown", "task_note_unresolved"
        event = "claim_holder_live" if observed == "live" else "claim_orphaned" if observed == "dead" else "claim_orphan_unresolved"
        print(f"{lane}: {event}:{task}:{sid or 'legacy'}:{why}; preserve claim and inspect {path} and session identity before governed repair", flush=True)
        if observed == "dead":
            print(f"{lane}: claim_orphan_unresolved:governed_rebind_required:{task}:{sid}; preserve claim and use governed stale-lease/rebind repair", flush=True)
        record_claim_observation(path, sid, task, observed, why, note)
    if mode == "reap":
        if not terminal_claims:
            print(f"{lane}: reap_hold:terminal_state_unverified; preserve launcher and inspect its task binding and task note", flush=True)
            held = True
        try:
            sid, task = launcher_binding()
            # A terminal claim from a previous launcher must never authorize
            # killing the current one, even when the new claim is absent.
            if (sid, task) not in terminal_claims:
                raise ValueError("terminal_claim_mismatch")
            if read_input(cache / f"{prefix}-{sid}").strip() != task:
                raise ValueError("launcher_claim_changed")
            # Legacy projection is commonly covered by the session claim, but
            # its epoch may publish first. It must agree too when present.
            if legacy.exists():
                legacy_task = read_input(legacy).strip()
                if legacy_task != task:
                    raise ValueError("role_claim_changed")
                check_epoch(legacy, task)
            if sorted(cache.glob(prefix + "-*")) != claim_paths:
                raise ValueError("claim_inventory_changed")
            if sorted((Path(vault) / "active").glob("*.md")) != active_notes:
                raise ValueError("task_note_inventory_changed")
            for path in tuple(reap_inputs):
                read_input(path)
            if launcher_binding() != (sid, task):
                raise ValueError("launcher_binding_changed")
        except (OSError, ValueError, IndexError, StopIteration) as exc:
            print(f"{lane}: reap_hold:launcher_binding_unresolved:{type(exc).__name__}:{exc}; preserve launcher and inspect session PID/current-task/claim bindings", flush=True)
            held = True
    sys.exit(1 if held else 0)
except (OSError, ValueError) as exc:
    if mode == "reap":
        print(f"{lane}: reap_hold:publication_unresolved:{type(exc).__name__}:{exc}; preserve launcher and recheck claim/note/epoch publication", flush=True)
    print(f"{lane}: claim_orphan_unresolved:observation_failed:{type(exc).__name__}; inspect claim inputs and receipt destination", flush=True)
    sys.exit(1)
PYCLAIM
}

# ── respawn ───────────────────────────────────────────────────────────────────

# Fast launchers (hapax-claude --readonly / hapax-codex) create
# a detached tmux session and return promptly, so run them synchronously bounded
# by a timeout. The headless launcher runs a foreground supervise-loop forever,
# so it is the only one backgrounded (setsid + disown).
respawn_sync() {
  local lane="$1"; shift
  local rc=0
  timeout "$LAUNCH_TIMEOUT_S" "$@" >"/tmp/hapax-supervisor-$lane.log" 2>&1 || rc=$?
  # hapax-claude's exit codes: 20 a dialog holds the pane, 21 no readiness witness in
  # time, 22 the lane died first, 23 a brief could not be delivered. 124 is timeout(1)
  # killing the launcher itself: no verdict at all.
  case "$rc" in
    0) ;;
    124) log "$lane: respawn launcher killed by timeout after ${LAUNCH_TIMEOUT_S}s (rc=124): no readiness verdict; its session may still be starting and is counted as NOT launched — see /tmp/hapax-supervisor-$lane.log" ;;
    20 | 21 | 22 | 23) log "$lane: respawned lane is NOT ready (rc=$rc; the pane text is in /tmp/hapax-supervisor-$lane.log); counted as not launched" ;;
    *) log "$lane: respawn command exited rc=$rc — see /tmp/hapax-supervisor-$lane.log" ;;
  esac
  return "$rc"
}

# guard <lane> <kind>: ensure the lane process exists; respawn if dead.
guard() {
  local lane="$1" kind="$2" worktree="$WORKTREE_ROOT/hapax-council--$1"
  local task_line task_id title claims_hold=0
  if [ "$kind" = "claude" ]; then
    claim_holder_guard "$lane" || claims_hold=1
  fi
  task_line="$(resolve_claimed_task "$lane")"
  IFS=$'\t' read -r task_id title _ <<< "$task_line"

  # A rostered lane with no worktree can never be launched. Don't silently skip
  # it forever — count the cycles and escalate once it crosses the threshold, so
  # the operator either provisions the worktree or removes the lane (the roster
  # is then honest). The escalation is the safety net for any future roster drift.
  if ! lane_has_worktree "$lane"; then
    if [ "$LOCAL_DEV_MAINTENANCE_MODE" = "appendix-only" ] && [ -z "$task_id" ]; then
      log "$lane ($kind): no worktree and no active task — appendix-only local-dev maintenance suppresses idle-await respawn"
      return 0
    fi
    local wstreak
    wstreak="$(bump_streak "$lane" no-worktree)"
    log "$lane ($kind): no worktree (configured root $worktree) — skipping (cycle $wstreak)"
    if [ "$wstreak" -ge "$ESCALATE_MISSING_WORKTREE_CYCLES" ]; then
      escalate "$lane" no-worktree \
        "Hapax lane-supervisor: $lane has no worktree" \
        "Rostered $kind lane '$lane' has had no worktree for $wstreak supervisor cycles (~$(( wstreak * 60 ))s). Provision its worktree or drop '$lane' from HAPAX_SUPERVISOR_${kind^^}_LANES."
    fi
    return 0
  fi
  clear_streak "$lane" no-worktree

  case "$kind" in
    claude)   reap_guard "$lane"; if launcher_alive "$lane" || claude_alive "$lane"; then progress_guard "$lane"; return 0; fi ;;
    codex)    tmux_session_alive "hapax-codex-$lane" && return 0 ;;
  esac

  if [ "$kind" = "claude" ] && [ "$claims_hold" = "1" ]; then
    log "$lane: respawn_hold:active_claim — resolve session ownership through governed repair"
    return 0
  fi

  # No observed live writer or unresolved Claude lease. Cooldown and burst
  # control may still defer recovery; recheck occupancy immediately before use.
  if within_cooldown "$lane"; then
    log "$lane ($kind): DEAD but within restart cooldown — deferring"
    return 0
  fi
  if burst_exhausted "$lane"; then
    log "$lane ($kind): DEAD but restart burst limit reached (StartLimit) — backing off"
    return 0
  fi

  if [ "$LOCAL_DEV_MAINTENANCE_MODE" = "appendix-only" ] && [ -z "$task_id" ]; then
    if p0_intake_backlog_present; then
      log "$lane ($kind): DEAD with no active task but P0 incident backlog exists — allowing idle-await respawn"
    else
      log "$lane ($kind): DEAD with no active task — appendix-only local-dev maintenance suppresses idle-await respawn"
      return 0
    fi
  fi

  if [ "$DRY_RUN" = "1" ]; then
    if [ -n "$task_id" ]; then
      log "$lane ($kind): DEAD — WOULD respawn (resume task $task_id) [dry-run]"
    else
      log "$lane ($kind): DEAD — WOULD respawn into idle-await [dry-run]"
    fi
    return 0
  fi

  # The lane is dead and about to be relaunched. With `remain-on-exit failed` the dead
  # pane may still be holding its session open, and both launchers refuse to start over
  # an existing session — so read the corpse and only then clear it. This sits AFTER the
  # dry-run return on purpose: a dry run must not destroy the thing it is describing.
  case "$kind" in
    claude)
      if launcher_alive "$lane" || claude_alive "$lane" || ! claim_holder_guard "$lane"; then
        log "$lane: respawn_hold:occupancy_changed — recheck next tick"
        return 0
      fi
      capture_dead_pane "$lane" "hapax-claude-$lane"
      ;;
    codex)  capture_dead_pane "$lane" "hapax-codex-$lane" ;;
  esac

  # respawn_tracked=1 only for the synchronous launchers whose exit code we can
  # observe; the backgrounded headless resume returns immediately (rc unknowable
  # here) so it is neither counted as a failure nor a recovery.
  local respawn_rc=0 respawn_tracked=0
  case "$kind" in
    claude)
      if launcher_alive "$lane" || claude_alive "$lane" || ! claim_holder_guard "$lane"; then
        log "$lane: respawn_hold:occupancy_changed — recheck next tick"
        return 0
      fi
      if [ -n "$task_id" ]; then
        log "$lane ($kind): DEAD with active task $task_id — respawning headless (resume)"
        setsid "$CLAUDE_HEADLESS_BIN" --task "$task_id" "$lane" \
          "Resume your assigned task: $task_id — $title. Ship a PR and cc-close --pr N after merge." \
          >"/tmp/hapax-supervisor-$lane.log" 2>&1 &
        disown
      else
        # Headless launcher is default-deny without a governed task; bring the
        # lane up read-only so the process exists and awaits governed dispatch.
        if [ $((SECONDS + CLAUDE_READY_TIMEOUT_S + 10)) -gt "$CYCLE_BUDGET_S" ]; then
          log "$lane ($kind): DEAD with no active task — respawn DEFERRED to the next cycle (this cycle is ${SECONDS}s in; a witnessed respawn could run past its ${CYCLE_BUDGET_S}s budget)"
          return 0
        fi
        log "$lane ($kind): DEAD with no active task — respawning read-only (idle-await)"
        respawn_sync "$lane" env HAPAX_CLAUDE_READY_TIMEOUT="$CLAUDE_READY_TIMEOUT_S" \
          "$CLAUDE_BIN" --role "$lane" --terminal tmux --readonly || respawn_rc=$?
        respawn_tracked=1
      fi
      ;;
    codex)
      if tmux_session_alive "hapax-codex-$lane"; then
        log "$lane: respawn_hold:occupancy_changed — recheck next tick"
        return 0
      fi
      log "$lane ($kind): DEAD — respawning tmux lane (idle-await; lane reads its own claim)"
      codex_force=0
      codex_args=("$CODEX_BIN" --session "$lane" --slot "$CODEX_SLOT" --no-claim --terminal tmux)
      if codex_should_force_respawn "$lane" "$task_id"; then
        codex_args+=(--force)
        codex_force=1
      fi
      if [ "$codex_force" = "1" ]; then
        respawn_sync "$lane" env HAPAX_DISPATCH_HOST_FALLBACK=local "${codex_args[@]}" || respawn_rc=$?
      else
        respawn_sync "$lane" "${codex_args[@]}" || respawn_rc=$?
      fi
      respawn_tracked=1
      ;;
  esac

  record_restart "$lane"

  # A respawn that keeps failing (e.g. codex-not-found rc=4) is a chronic crash
  # loop the cooldown can never cure — escalate after N consecutive failures
  # instead of returning exit 0 forever.
  if [ "$respawn_tracked" = "1" ]; then
    if [ "$respawn_rc" -ne 0 ]; then
      local fstreak
      fstreak="$(bump_streak "$lane" respawn-fail)"
      if [ "$fstreak" -ge "$ESCALATE_RESPAWN_FAILS" ]; then
        escalate "$lane" respawn-fail \
          "Hapax lane-supervisor: $lane respawn failing" \
          "$kind lane '$lane' failed to respawn $fstreak consecutive times (last rc=$respawn_rc) — chronically DOWN. See /tmp/hapax-supervisor-$lane.log."
      fi
    else
      clear_streak "$lane" respawn-fail
    fi
  fi
}

# ── progress-watchdog (alive-but-output-stalled recovery) ─────────────────────

# The launcher can keep its session alive during child restart/backoff.
launcher_alive() {
  launcher_pid "$1" >/dev/null
}

# Seconds since output.jsonl was last written; returns 1 (no echo) if absent
# (interactive/tmux lanes have none — naturally excluded).
output_age() {
  local oj="$CLAUDE_LOG_DIR/$1/output.jsonl" mt=""
  [ -f "$oj" ] || return 1
  mt="$(stat -c %Y "$oj" 2>/dev/null || true)"
  [ -n "$mt" ] || return 1
  echo $(( now - mt ))
}

# Admission state via the resource-shielding L3 gate (fail-open to "open" so the
# floor never wedges on the gate). 'closed' -> defer (queue, never drop).
admission_state() {
  [ "${HAPAX_SDLC_PRESSURE_GATE_OFF:-}" = "1" ] && { echo open; return; }
  local out=""
  out="$( cd "$REPO_DIR" 2>/dev/null; bash -c "$ADMISSION_CMD" 2>/dev/null || true )"
  case "$out" in
    open|paced|closed) echo "$out" ;;
    *) echo open ;;
  esac
}

# task_id<TAB>status<TAB>title for the lane's active claim (any status), else
# empty. The claim names the task; the vault note is authority for status.
resolve_task_meta() {
  python3 - "$VAULT_ROOT" "$1" "$HOME/.cache/hapax/cc-active-task-$1" <<'PY' 2>/dev/null || true
import re
import sys
from pathlib import Path

vault_root, lane, claim_file = Path(sys.argv[1]), sys.argv[2], Path(sys.argv[3])
active = vault_root / "active"
claim_files = [claim_file]
claim_files.extend(sorted(claim_file.parent.glob(f"{claim_file.name}-*")))


def field(name: str) -> str:
    m = re.search(rf"^{name}:\s*(.+?)\s*$", text, re.MULTILINE)
    return m.group(1).strip().strip('"').strip("'") if m else ""


for candidate in sorted(
    [path for path in claim_files if path.is_file()],
    key=lambda path: path.stat().st_mtime,
    reverse=True,
):
    lines = [ln.strip() for ln in candidate.read_text(errors="replace").splitlines() if ln.strip()]
    if not lines:
        continue
    task_id = lines[0]
    note = active / f"{task_id}.md"
    if not note.is_file():
        note = next(iter(sorted(active.glob(f"{task_id}-*.md"))), None) if active.is_dir() else None
    if note is None or not note.is_file():
        continue
    text = note.read_text(errors="replace")
    if field("assigned_to") == lane:
        print(f"{task_id}\t{field('status')}\t{field('title')}")
        sys.exit(0)
PY
}

bump_counter() {
  local f="$STATE_DIR/$1" n
  n="$(cat "$f" 2>/dev/null || echo 0)"
  echo $(( n + 1 )) > "$f"
}

emit_progress_metrics() {
  [ -n "$METRICS_FILE" ] || return 0
  local resumed exhausted reaped lifetime_reaped dir
  resumed="$(cat "$STATE_DIR/lanes_resumed_total" 2>/dev/null || echo 0)"
  exhausted="$(cat "$STATE_DIR/resume_exhausted_total" 2>/dev/null || echo 0)"
  reaped="$(cat "$STATE_DIR/launchers_reaped_total" 2>/dev/null || echo 0)"
  lifetime_reaped="$(cat "$STATE_DIR/launcher_lifetime_reaps_total" 2>/dev/null || echo 0)"
  dir="$(dirname "$METRICS_FILE")"
  mkdir -p "$dir" 2>/dev/null || return 0
  {
    printf '# HELP hapax_lane_supervisor_lanes_stalled Lanes detected output-stalled this tick\n'
    printf '# TYPE hapax_lane_supervisor_lanes_stalled gauge\n'
    printf 'hapax_lane_supervisor_lanes_stalled %s\n' "$PROGRESS_STALLED_TICK"
    printf '# HELP hapax_lane_supervisor_lanes_resumed_total Cumulative lane progress resumes\n'
    printf '# TYPE hapax_lane_supervisor_lanes_resumed_total counter\n'
    printf 'hapax_lane_supervisor_lanes_resumed_total %s\n' "$resumed"
    printf '# HELP hapax_lane_supervisor_resume_exhausted_total Cumulative resume-exhaustion reoffers\n'
    printf '# TYPE hapax_lane_supervisor_resume_exhausted_total counter\n'
    printf 'hapax_lane_supervisor_resume_exhausted_total %s\n' "$exhausted"
    printf '# HELP hapax_lane_supervisor_launchers_reaped_total Cumulative zombie launchers reaped\n'
    printf '# TYPE hapax_lane_supervisor_launchers_reaped_total counter\n'
    printf 'hapax_lane_supervisor_launchers_reaped_total %s\n' "$reaped"
    # The routine ceiling reap no longer escalates, so this counter (not the
    # alert bus) is where launcher-lifetime pressure is read. A rising rate is
    # normal; a rate that jumps means lanes are parking idle sooner.
    printf '# HELP hapax_lane_supervisor_launcher_lifetime_reaps_total Cumulative launcher lifetime-ceiling reaps\n'
    printf '# TYPE hapax_lane_supervisor_launcher_lifetime_reaps_total counter\n'
    printf 'hapax_lane_supervisor_launcher_lifetime_reaps_total %s\n' "$lifetime_reaped"
  } > "$METRICS_FILE.tmp" 2>/dev/null && mv "$METRICS_FILE.tmp" "$METRICS_FILE" 2>/dev/null || true
}

# Silence is an observation, never a recovery predicate. Both a pane and a
# headless writer may think/build without emitting output. Dead-writer recovery
# belongs to guard, where occupancy and claim identity are checked at use.
progress_guard() {
  local lane="$1" age meta task status
  [ "$PROGRESS_OFF" = "1" ] && return 0
  age="$(output_age "$lane")" || return 0
  [ "$age" -gt "$STALL_T" ] || return 0
  meta="$(resolve_task_meta "$lane")"
  IFS=$'\t' read -r task status _ <<< "$meta"
  [ "$status" = "in_progress" ] || return 0
  PROGRESS_STALLED_TICK=$(( PROGRESS_STALLED_TICK + 1 ))
  log "$lane: progress_hold:output_silence — task $task, output age ${age}s; inspect the session's work, no recovery authorized by age"
}

# ── zombie-launcher reaper (terminal-task + lifetime ceiling) ─────────────────

# launcher_pid_from_proc <lane>: echo a live hapax-claude-headless wrapper whose
# pidfile was lost. Constrain to the current HOME so tests and other users' lanes
# cannot be mistaken for this supervisor's fleet.
launcher_pid_from_proc() {
  [ "$PROC_SCAN_LAUNCHERS" = "1" ] || return 1
  python3 - "$1" "$HOME" <<'PY' 2>/dev/null
import os
import sys
from pathlib import Path

lane, expected_home = sys.argv[1], sys.argv[2]


def read_parts(path: Path) -> list[str]:
    try:
        raw = path.read_bytes()
    except OSError:
        return []
    return [part.decode("utf-8", "replace") for part in raw.split(b"\0") if part]


def env_home(pid: str) -> str:
    for part in read_parts(Path("/proc") / pid / "environ"):
        if part.startswith("HOME="):
            return part.split("=", 1)[1]
    return ""


for entry in sorted(Path("/proc").iterdir(), key=lambda path: int(path.name) if path.name.isdigit() else -1):
    if not entry.name.isdigit():
        continue
    pid = entry.name
    if int(pid) in {os.getpid(), os.getppid()}:
        continue
    argv = read_parts(entry / "cmdline")
    if not argv:
        continue
    if not any(Path(arg).name == "hapax-claude-headless" for arg in argv):
        continue
    if lane not in argv:
        continue
    if env_home(pid) != expected_home:
        continue
    try:
        os.kill(int(pid), 0)
    except OSError:
        continue
    print(pid)
    sys.exit(0)
sys.exit(1)
PY
}

launcher_pid_from_pidfile() {
  local lpf="$RUNTIME_DIR/$1.launcher.pid"
  [ -f "$lpf" ] || return 1
  python3 - "$1" "$lpf" "$HOME" <<'PY' 2>/dev/null
import os
import sys
from pathlib import Path

lane, pidfile, expected_home = sys.argv[1], Path(sys.argv[2]), sys.argv[3]


def read_parts(path: Path) -> list[str]:
    try:
        raw = path.read_bytes()
    except OSError:
        return []
    return [part.decode("utf-8", "replace") for part in raw.split(b"\0") if part]


def env_home(pid: int) -> str:
    for part in read_parts(Path("/proc") / str(pid) / "environ"):
        if part.startswith("HOME="):
            return part.split("=", 1)[1]
    return ""


try:
    pid = int(pidfile.read_text().strip())
except (OSError, ValueError):
    sys.exit(1)
try:
    os.kill(pid, 0)
except OSError:
    sys.exit(1)
argv = read_parts(Path("/proc") / str(pid) / "cmdline")
if not any(Path(arg).name == "hapax-claude-headless" for arg in argv):
    sys.exit(1)
if lane not in argv:
    sys.exit(1)
if env_home(pid) != expected_home:
    sys.exit(1)
print(pid)
PY
}

# launcher_pid <lane>: echo the lane's LIVE launcher pid, or return 1 if there is
# no live launcher. The pidfile is authoritative when present; the /proc fallback
# catches lock-holding wrappers whose pidfile/fifo was lost mid-loop.
launcher_pid() {
  launcher_pid_from_pidfile "$1" && return 0
  launcher_pid_from_proc "$1"
}

# launcher_etimes <pid>: elapsed seconds since the launcher started, or return 1
# if unknowable.
launcher_etimes() {
  local et=""
  et="$(ps -o etimes= -p "$1" 2>/dev/null | tr -d ' ' || true)"
  case "$et" in '' | *[!0-9]*) return 1 ;; esac
  printf '%s\n' "$et"
}

# reap_launcher <lane> <pid> <reason>: SIGTERM the EXACT launcher pid. A single
# POSITIVE pid only — NEVER a process group / negative pid (`kill -- -PGID`): the
# exit-144 group-kill cascade that took down sibling lanes is pinned here. The
# launcher's own EXIT trap reaps its fifo + lock; closing its FIFO write-end EOFs
# the claude child, which exits. The next sweep brings the lane back read-only
# into idle-await.
reap_launcher() {
  local lane="$1" pid="$2" reason="$3"
  local current_pid
  current_pid="$(launcher_pid "$lane")" || current_pid=""
  if [ "$current_pid" != "$pid" ]; then
    log "$lane: reap_hold:launcher_changed — preserve processes; inspect launcher pidfile and recheck next tick"
    return 1
  fi
  # Reuse the claim observation boundary after admission/age inspection. Every
  # active or unresolved lease holds, even beneath a newer terminal role claim.
  # A missing note/claim is uncertainty, not proof that the launcher is idle.
  if ! claim_holder_guard "$lane" reap "$pid"; then
    log "$lane: reap_hold:active_or_unresolved_claim — preserve launcher; inspect claim-holder evidence and task state"
    return 1
  fi
  if [ "$DRY_RUN" = "1" ]; then
    log "$lane: WOULD reap launcher pid=$pid ($reason) [dry-run]"
    return 0
  fi
  log "$lane: reaping launcher pid=$pid ($reason) — SIGTERM (single pid)"
  if ! kill -TERM "$pid" 2>/dev/null; then
    log "$lane: SIGTERM pid=$pid failed (already gone?)"
    return 1
  fi
  bump_counter launchers_reaped_total
}

# note_lifetime_reap <lane> <pid>: count the ceiling reap and remember the pid we
# are about to SIGTERM, so the next crossing can tell "fresh launcher" from "the
# same one survived". Dry-run signals nothing, so it records nothing — a later
# dry-run sweep seeing the same pid is expected, not a reap that failed.
note_lifetime_reap() {
  if [ "$DRY_RUN" != "1" ]; then
    bump_counter launcher_lifetime_reaps_total
    echo "$2 $now" > "$STATE_DIR/$1.launcher-lifetime-reaped"
  fi
}

# lifetime_reap_failed <lane> <pid>: 0 if we already SIGTERMed THIS pid for the
# ceiling more than the grace window ago and it is still over it. A reap that
# took effect ends the launcher, so a healthy fleet always crosses with a fresh
# pid; the same pid surviving means the signal did not land.
lifetime_reap_failed() {
  local marker="$STATE_DIR/$1.launcher-lifetime-reaped" prev_pid="" prev_ts=""
  [ -f "$marker" ] || return 1
  read -r prev_pid prev_ts < "$marker" 2>/dev/null || return 1
  [ "$prev_pid" = "$2" ] || return 1
  case "$prev_ts" in '' | *[!0-9]*) return 1 ;; esac
  [ "$(( now - prev_ts ))" -ge "$LIFETIME_REAP_GRACE_S" ]
}

# reap_guard <lane>: reap a zombie headless launcher that has outlived its task.
# Two triggers: (1) the claimed task has a verified terminal status — gated on
# admission_state so a pressure-closed window defers (queued, retried next tick);
# (2) a terminal-task launcher exceeds the lifetime ceiling. Both paths must
# pass the same fresh claim/terminal-state check in reap_launcher. Nonterminal
# tasks (including claimed/pr_open/blocked), missing notes and unknown ownership
# never authorize a signal. Terminal ceiling cleanup is routine; only a prior
# authorized reap that did not take escalates, after the fresh check passes.
reap_guard() {
  local lane="$1"
  [ "$REAP_OFF" = "1" ] && return 0
  local pid
  pid="$(launcher_pid "$lane")" || return 0   # no live launcher -> nothing to reap

  local age
  if age="$(launcher_etimes "$pid")" && [ "$age" -ge "$LAUNCHER_MAX_LIFETIME_S" ]; then
    reap_launcher "$lane" "$pid" "lifetime-ceiling ${age}s" || return 0
    if lifetime_reap_failed "$lane" "$pid"; then
      escalate "$lane" launcher-lifetime \
        "Hapax lane-supervisor: $lane launcher over lifetime ceiling" \
        "Headless launcher pid=$pid for lane '$lane' has run ${age}s (>=${LAUNCHER_MAX_LIFETIME_S}s) and SURVIVED an earlier SIGTERM — the lifetime reap is not taking. Next action: inspect pid $pid (trapped SIGTERM? uninterruptible sleep?) and terminate it by hand."
    else
      log "$lane: launcher pid=$pid past lifetime ceiling (${age}s >= ${LAUNCHER_MAX_LIFETIME_S}s) — routine reap, no escalation (escalates only if this pid survives it)"
    fi
    note_lifetime_reap "$lane" "$pid"
    return 0
  fi

  local adm
  adm="$(admission_state)"
  if [ "$adm" = "closed" ]; then
    log "$lane: launcher pid=$pid — sdlc-pressure CLOSED, deferring reap (task state must still be verified next tick)"
    return 0
  fi
  reap_launcher "$lane" "$pid" "terminal-task" || return 0
}

# ── sweep ─────────────────────────────────────────────────────────────────────

activate_p0_codex_drain_lane

for lane in $CLAUDE_LANES;   do guard "$lane" claude;   done
for lane in $CODEX_LANES;    do guard "$lane" codex;     done
emit_progress_metrics

exit 0
