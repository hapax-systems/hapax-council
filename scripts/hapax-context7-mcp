#!/usr/bin/env bash
# Launch Context7 MCP with credentials resolved in the child process.

set -euo pipefail

# Secrets come from the FileStore through the one shared helper, never from pass.
# Operator ruling 2026-09-16: pass and gopass are not used to manage secrets going forward.
. "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/lib/secret.sh"

LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/hapax/mcp-logs"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/context7-mcp.log"

hapax_secret_into CONTEXT7_API_KEY context7/api-key || {
  echo "hapax-context7-mcp: no token found. Next action: put one with \`hapax-secret context7/api-key\`, or export CONTEXT7_API_KEY." >&2
  exit 2
}

exec npx -y @upstash/context7-mcp@2.2.4 2>>"$LOG_FILE"
