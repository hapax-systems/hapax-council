#!/usr/bin/env bash
set -euo pipefail

# Retired safety sentinel. GitHub MCP containers now use --rm plus an
# immutable-signature, process-lease reconciliation protocol in the launcher.
# A periodic age-based process cannot distinguish a healthy long-running stdio
# lease from an orphan, so the launcher owns lifecycle reconciliation.
/usr/bin/printf '[%s] retired: launcher owns lifecycle reconciliation; no container mutation performed\n' \
    "$(/usr/bin/date -Iseconds)"
exit 0
