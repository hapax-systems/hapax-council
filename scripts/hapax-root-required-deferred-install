class DeferredInstallError(RuntimeError):
    pass


class ActionableArgumentParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        self.print_usage(sys.stderr)
        self.exit(
            2,
            f"{self.prog}: error: {message}; next action: rerun {self.prog} --help "
            "and use one governed package label, receipt SHA, and activation release\n",
        )


@dataclass(frozen=True)
class Package:
    label: str
    manifest: str
    effect_descriptor: str
    installer: str
    cap_host: str | None


@dataclass(frozen=True)
class InstallPaths:
    home: Path
    state_root: Path
    defer_root: Path
    repo_alias: Path
    sudo: Path
    test_mode: bool
    test_root: Path | None


@dataclass(frozen=True)
class RuntimeGateSnapshot:
    task_sha256: str
    cap_receipt_sha256: str | None


@dataclass(frozen=True)
class RuntimeEffectPolicy:
    cap_host: str | None
    scopes: tuple[str, ...]


@dataclass(frozen=True)
class LockedState:
    lexical_root: Path
    lexical_lock: Path
    state_fd: int
    lock_fd: int
    guard_fd: int


@dataclass(frozen=True)
class BrokerRequest:
    package: Package
    sha: str


