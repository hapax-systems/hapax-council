#!/usr/bin/python3 -I
"""Install one exact deferred root-required package through a trusted Git object."""

from __future__ import annotations

import argparse
import ctypes
import fcntl
import hashlib
import os
import pwd
import re
import signal
import socket
import stat
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path, PurePosixPath

SAFE_PATH = "/usr/local/sbin:/usr/local/bin:/usr/bin:/bin"
GIT = "/usr/bin/git"
BASH = "/usr/bin/bash"
DEFAULT_SUDO = "/usr/bin/sudo"
SHA_RE = re.compile(rb"[0-9a-f]{40}\n\Z")
SHA_TEXT_RE = re.compile(r"[0-9a-f]{40}\Z")
EFFECT_SCOPE_RE = re.compile(r"runtime:[A-Za-z0-9_./@*:+-]+\Z")
TEST_MODE_ENV = "HAPAX_ROOT_REQUIRED_DEFERRED_INSTALL_TEST_MODE"
TEST_HOSTNAME_ENV = "HAPAX_ROOT_REQUIRED_DEFERRED_INSTALL_TEST_HOSTNAME"
AFTER_SUDO_HOOK_ENV = "HAPAX_ROOT_REQUIRED_DEFERRED_INSTALL_AFTER_SUDO_HOOK"
SEALED_SOURCE_FDS_ENV = "HAPAX_ROOT_REQUIRED_SEALED_SOURCE_FDS"
AUTHORITY_VERIFIER_REL = PurePosixPath("scripts/hapax-post-merge-deploy")
REQUIRED_MEMFD_SEALS = (
    fcntl.F_SEAL_SEAL | fcntl.F_SEAL_SHRINK | fcntl.F_SEAL_GROW | fcntl.F_SEAL_WRITE
)
LIBC = ctypes.CDLL(None, use_errno=True)
PR_SET_PDEATHSIG = 1


class DeferredInstallError(RuntimeError):
    pass


class ActionableArgumentParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        self.print_usage(sys.stderr)
        self.exit(
            2,
            f"{self.prog}: error: {message}; next action: rerun {self.prog} --help "
            "and use one governed package label, receipt SHA, and activation release\n",
        )


@dataclass(frozen=True)
class Package:
    label: str
    manifest: str
    effect_descriptor: str
    installer: str
    cap_host: str | None


@dataclass(frozen=True)
class InstallPaths:
    home: Path
    state_root: Path
    defer_root: Path
    repo_alias: Path
    sudo: Path
    test_mode: bool


@dataclass(frozen=True)
class RuntimeGateSnapshot:
    task_sha256: str
    cap_receipt_sha256: str | None


@dataclass(frozen=True)
class RuntimeEffectPolicy:
    cap_host: str | None
    scopes: tuple[str, ...]


OOM_PACKAGE = Package(
    label="oom-containment",
    manifest="config/root-required/oom-containment.files",
    effect_descriptor="config/root-required/oom-containment.effects",
    installer="scripts/install-p0-oom-containment",
    cap_host="hapax-appendix",
)
APCUPSD_PACKAGE = Package(
    label="apcupsd-power-alerts",
    manifest="config/root-required/apcupsd-power-alerts.files",
    effect_descriptor="config/root-required/apcupsd-power-alerts.effects",
    installer="scripts/install-apcupsd-power-alerts",
    cap_host=None,
)
PACKAGES = {package.label: package for package in (OOM_PACKAGE, APCUPSD_PACKAGE)}


def _error(message: str) -> DeferredInstallError:
    return DeferredInstallError(
        f"{message}; next action: discard the altered deferral and rerun "
        "hapax-post-merge-deploy from the governed activation release"
    )


def _authorize_isolated_test_mode() -> bool:
    raw = os.environ.get(TEST_MODE_ENV)
    if raw is None:
        return False
    if raw != "1":
        raise _error(f"{TEST_MODE_ENV} must be exactly 1 when present")
    if os.geteuid() == 0:
        raise _error("deferred-install test mode refuses a root caller")
    invoked = Path(sys.argv[0])
    if not invoked.is_absolute():
        raise _error("deferred-install test mode requires an absolute repository script path")
    try:
        invoked_inode = invoked.lstat()
        invoked_real = invoked.resolve(strict=True)
    except OSError as exc:
        raise _error(f"cannot resolve deferred-install test source: {exc}") from exc
    source_root = invoked_real.parent.parent
    if (
        invoked != invoked_real
        or not stat.S_ISREG(invoked_inode.st_mode)
        or invoked_inode.st_nlink != 1
        or invoked_real != source_root / "scripts/hapax-root-required-deferred-install"
        or not (source_root / ".git").exists()
    ):
        raise _error("deferred-install test mode requires the real repository script")
    for path in (source_root, source_root / "scripts", invoked_real):
        try:
            inode = path.lstat()
        except OSError as exc:
            raise _error(f"cannot inspect deferred-install test source {path}: {exc}") from exc
        if path.is_symlink() or inode.st_uid != os.getuid() or inode.st_mode & 0o022:
            raise _error(
                "deferred-install test source must be caller-owned and not group/other-writable"
            )
    git_env = {
        "HOME": "/nonexistent",
        "PATH": "/usr/bin:/bin",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_NO_REPLACE_OBJECTS": "1",
        "GIT_OPTIONAL_LOCKS": "0",
    }
    root_result = subprocess.run(
        [GIT, "-C", str(source_root), "rev-parse", "--show-toplevel"],
        capture_output=True,
        check=False,
        env=git_env,
        text=True,
    )
    tracked_result = subprocess.run(
        [
            GIT,
            "-C",
            str(source_root),
            "ls-files",
            "--error-unmatch",
            "--",
            "scripts/hapax-root-required-deferred-install",
        ],
        capture_output=True,
        check=False,
        env=git_env,
    )
    if (
        root_result.returncode != 0
        or Path(root_result.stdout.strip()).resolve(strict=True) != source_root
        or tracked_result.returncode != 0
    ):
        raise _error("deferred-install test source is not its tracked Git worktree root")
    return True


def _production_defaults() -> InstallPaths:
    account = pwd.getpwuid(os.getuid())
    home = Path(account.pw_dir)
    return InstallPaths(
        home=home,
        state_root=home / ".local/state/hapax/root-required",
        defer_root=home / ".cache/hapax/post-merge-root-required",
        repo_alias=home / ".cache/hapax/source-activation/worktree",
        sudo=Path(DEFAULT_SUDO),
        test_mode=False,
    )


def _absolute_env_path(name: str) -> Path:
    value = os.environ.get(name, "")
    path = Path(value)
    if not value or not path.is_absolute():
        raise _error(f"{name} must be an explicit absolute test path")
    return path


def _install_paths() -> InstallPaths:
    defaults = _production_defaults()
    test_mode = _authorize_isolated_test_mode()
    override_names = {
        "HAPAX_ROOT_REQUIRED_STATE_ROOT",
        "HAPAX_POST_MERGE_ROOT_DEFER_DIR",
        "HAPAX_ROOT_REQUIRED_GIT_REPO",
        "HAPAX_ROOT_REQUIRED_DEFERRED_INSTALL_SUDO",
        TEST_HOSTNAME_ENV,
        AFTER_SUDO_HOOK_ENV,
    }
    present = sorted(name for name in override_names if name in os.environ)
    if not test_mode:
        if TEST_MODE_ENV in os.environ or present:
            raise _error(
                "deferred-install test selectors are refused outside isolated test mode: "
                + ", ".join([*present, *([TEST_MODE_ENV] if TEST_MODE_ENV in os.environ else [])])
            )
        return defaults

    paths = InstallPaths(
        home=defaults.home,
        state_root=_absolute_env_path("HAPAX_ROOT_REQUIRED_STATE_ROOT"),
        defer_root=_absolute_env_path("HAPAX_POST_MERGE_ROOT_DEFER_DIR"),
        repo_alias=_absolute_env_path("HAPAX_ROOT_REQUIRED_GIT_REPO"),
        sudo=_absolute_env_path("HAPAX_ROOT_REQUIRED_DEFERRED_INSTALL_SUDO"),
        test_mode=True,
    )
    for test_path, production_path in (
        (paths.state_root, defaults.state_root),
        (paths.defer_root, defaults.defer_root),
        (paths.repo_alias, defaults.repo_alias),
    ):
        test_resolved = test_path.resolve(strict=False)
        production_resolved = production_path.resolve(strict=False)
        if (
            test_resolved == production_resolved
            or test_resolved.is_relative_to(production_resolved)
            or production_resolved.is_relative_to(test_resolved)
        ):
            raise _error("isolated test mode cannot target a production deferred-install path")
    return paths


def _lstat_regular(path: Path, *, label: str, executable: bool | None = None) -> os.stat_result:
    try:
        inode = path.lstat()
    except OSError as exc:
        raise _error(f"{label} is unavailable at {path}: {exc}") from exc
    if not stat.S_ISREG(inode.st_mode) or inode.st_nlink != 1:
        raise _error(f"{label} must be a single-link non-symlink regular file: {path}")
    if executable is not None and bool(inode.st_mode & 0o111) != executable:
        expected = "executable" if executable else "non-executable"
        raise _error(f"{label} must be {expected}: {path}")
    return inode


def _lstat_directory(path: Path, *, label: str) -> None:
    try:
        inode = path.lstat()
    except OSError as exc:
        raise _error(f"{label} is unavailable at {path}: {exc}") from exc
    if not stat.S_ISDIR(inode.st_mode):
        raise _error(f"{label} must be a non-symlink directory: {path}")


def _validate_owned_directory(path: Path, *, label: str) -> None:
    _lstat_directory(path, label=label)
    inode = path.stat()
    if inode.st_uid != os.getuid() or inode.st_mode & 0o022:
        raise _error(f"{label} must be caller-owned and not group/other-writable: {path}")


def _read_regular_bytes(path: Path, *, label: str, executable: bool | None = None) -> bytes:
    expected = _lstat_regular(path, label=label, executable=executable)
    flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(path, flags)
        try:
            actual = os.fstat(fd)
            if (
                (actual.st_dev, actual.st_ino) != (expected.st_dev, expected.st_ino)
                or not stat.S_ISREG(actual.st_mode)
                or actual.st_nlink != 1
            ):
                raise _error(f"{label} changed while it was opened: {path}")
            with os.fdopen(fd, "rb", closefd=False) as handle:
                data = handle.read()
        finally:
            os.close(fd)
    except OSError as exc:
        raise _error(f"cannot read {label} at {path}: {exc}") from exc
    return data


def _read_exact_sha(path: Path, *, label: str) -> str:
    data = _read_regular_bytes(path, label=label, executable=False)
    if SHA_RE.fullmatch(data) is None:
        raise _error(f"{label} must contain exactly 40 lowercase hex characters and one newline")
    return data[:-1].decode("ascii")


def _bounded_diagnostic(stdout: bytes, stderr: bytes) -> str:
    raw = stderr or stdout
    first_line = next(iter(raw.decode("utf-8", errors="replace").strip().splitlines()), "none")
    return "".join(character if character.isprintable() else "?" for character in first_line)[:320]


def _runtime_task_digest(task: Path) -> str:
    if not task.is_absolute():
        raise _error("runtime authority task path must be absolute")
    inode = _lstat_regular(task, label="runtime authority task", executable=False)
    if inode.st_uid != os.getuid() or inode.st_mode & 0o022 or inode.st_size > 2 * 1024 * 1024:
        raise _error(
            "runtime authority task must be caller-owned, non-group-writable, and at most 2 MiB"
        )
    return hashlib.sha256(
        _read_regular_bytes(task, label="runtime authority task", executable=False)
    ).hexdigest()


def _cap_receipt_digest(paths: InstallPaths, sha: str) -> str:
    receipt = paths.state_root / "local-judge-cap-canary" / f"{sha}.env"
    inode = _lstat_regular(receipt, label="local-judge cap receipt", executable=False)
    if (
        inode.st_uid != os.getuid()
        or inode.st_nlink != 1
        or stat.S_IMODE(inode.st_mode) != 0o600
        or inode.st_size > 2048
    ):
        raise _error(
            "local-judge cap receipt must be caller-owned mode-0600, single-link, and at most 2048 bytes"
        )
    return hashlib.sha256(
        _read_regular_bytes(receipt, label="local-judge cap receipt", executable=False)
    ).hexdigest()


def _runtime_hostname(paths: InstallPaths) -> str:
    if paths.test_mode and TEST_HOSTNAME_ENV in os.environ:
        hostname = os.environ[TEST_HOSTNAME_ENV]
    else:
        hostname = socket.gethostname()
    if hostname not in {"hapax-appendix", "hapax-podium"}:
        raise _error(f"runtime root-package host is unsupported: {hostname or 'empty'}")
    return hostname


def _run_exact_authority_verifier(
    paths: InstallPaths, repo: Path, sha: str, arguments: list[str]
) -> None:
    if _git_mode(repo, sha, AUTHORITY_VERIFIER_REL) != "100755":
        raise _error("exact runtime-authority verifier Git mode is not executable")
    fd = _write_sealed_memfd(
        name="hapax-runtime-authority-verifier",
        data=_git(repo, "show", f"{sha}:{AUTHORITY_VERIFIER_REL}"),
        mode=0o755,
    )
    verifier = f"/proc/{os.getpid()}/fd/{fd}"
    try:
        result = subprocess.run(
            [BASH, verifier, *arguments],
            capture_output=True,
            check=False,
            env=_safe_subprocess_env(paths.home),
            preexec_fn=_parent_death_preexec(os.getpid()),
        )
    except OSError as exc:
        raise _error(f"cannot execute exact runtime-authority verifier: {exc}") from exc
    finally:
        os.close(fd)
    if result.returncode != 0:
        raise _error(
            f"exact runtime gate {' '.join(arguments[:1])} rejected with rc={result.returncode}: "
            f"{_bounded_diagnostic(result.stdout, result.stderr)}"
        )
    if result.stdout:
        sys.stdout.buffer.write(result.stdout)
        sys.stdout.buffer.flush()


def _validate_runtime_gates(
    paths: InstallPaths,
    repo: Path,
    sha: str,
    package: Package,
    runtime_task: Path,
    *,
    expected: RuntimeGateSnapshot | None = None,
    cap_phase: str = "candidate",
) -> RuntimeGateSnapshot:
    policy = _runtime_effect_policy(repo, sha, package)
    scopes = list(policy.scopes)
    task_digest = _runtime_task_digest(runtime_task)
    _run_exact_authority_verifier(
        paths,
        repo,
        sha,
        [
            "--verify-runtime-authority-for-release",
            sha,
            str(runtime_task),
            *scopes,
        ],
    )
    cap_digest: str | None = None
    hostname = _runtime_hostname(paths)
    if policy.cap_host == hostname:
        cap_digest = _cap_receipt_digest(paths, sha)
        _run_exact_authority_verifier(
            paths,
            repo,
            sha,
            ["--verify-local-judge-cap-receipt", sha, cap_phase],
        )
    snapshot = RuntimeGateSnapshot(
        task_sha256=_runtime_task_digest(runtime_task),
        cap_receipt_sha256=(_cap_receipt_digest(paths, sha) if cap_digest is not None else None),
    )
    if task_digest != snapshot.task_sha256 or cap_digest != snapshot.cap_receipt_sha256:
        raise _error("runtime authority task or cap receipt changed during gate verification")
    if expected is not None and snapshot != expected:
        raise _error("runtime authority task or cap receipt changed during sudo warmup")
    print(
        "hapax-root-required-deferred-install: runtime gates accepted "
        f"package={package.label} sha={sha} scopes={len(scopes)} host={hostname} "
        f"cap_phase={cap_phase}",
        flush=True,
    )
    return snapshot


def _safe_subprocess_env(home: Path) -> dict[str, str]:
    return {
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_NO_REPLACE_OBJECTS": "1",
        "GIT_OPTIONAL_LOCKS": "0",
        "HOME": str(home),
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "PATH": SAFE_PATH,
        "PYTHONNOUSERSITE": "1",
        "PYTHONSAFEPATH": "1",
    }


def _git(repo: Path, *args: str, check: bool = True) -> bytes:
    result = subprocess.run(
        [GIT, "-C", str(repo), *args],
        capture_output=True,
        check=False,
        env=_safe_subprocess_env(_production_defaults().home),
    )
    if check and result.returncode != 0:
        raise _error(f"Git object lookup failed for {' '.join(args[:2])}")
    return result.stdout


def _physical_repo(alias: Path) -> Path:
    try:
        repo = alias.resolve(strict=True)
    except OSError as exc:
        raise _error(f"activation release alias is unavailable: {alias}: {exc}") from exc
    _lstat_directory(repo, label="physical activation release")
    top = Path(_git(repo, "rev-parse", "--show-toplevel").decode().strip()).resolve(strict=True)
    if top != repo:
        raise _error(f"activation release does not resolve to its Git top level: {repo}")
    return repo


def _validate_commit(repo: Path, sha: str) -> None:
    if SHA_TEXT_RE.fullmatch(sha) is None:
        raise _error("expected package SHA is malformed")
    resolved = _git(repo, "rev-parse", "--verify", f"{sha}^{{commit}}").decode().strip()
    if resolved != sha:
        raise _error(f"receipt commit did not resolve exactly: expected={sha} actual={resolved}")


def _manifest_files(repo: Path, sha: str, package: Package) -> tuple[PurePosixPath, ...]:
    raw = _git(repo, "show", f"{sha}:{package.manifest}")
    try:
        lines = raw.decode("utf-8").splitlines()
    except UnicodeDecodeError as exc:
        raise _error("root-required package manifest is not UTF-8") from exc
    files: list[PurePosixPath] = []
    seen: set[str] = set()
    for line in lines:
        if not line or line.startswith("#"):
            continue
        if line != line.strip() or any(character.isspace() for character in line):
            raise _error(f"unsafe whitespace in root-required manifest entry: {line!r}")
        rel = PurePosixPath(line)
        if rel.is_absolute() or ".." in rel.parts or str(rel) in {"", "."}:
            raise _error(f"unsafe root-required manifest entry: {line!r}")
        if line in seen:
            raise _error(f"duplicate root-required manifest entry: {line}")
        seen.add(line)
        files.append(rel)
    required = {
        package.manifest,
        package.effect_descriptor,
        package.installer,
        str(AUTHORITY_VERIFIER_REL),
    }
    if not required.issubset(seen):
        raise _error(
            "root-required manifest omits its manifest, effect descriptor, installer, or exact authority verifier"
        )
    return tuple(files)


def _runtime_effect_policy(repo: Path, sha: str, package: Package) -> RuntimeEffectPolicy:
    try:
        lines = (
            _git(repo, "show", f"{sha}:{package.effect_descriptor}").decode("utf-8").splitlines()
        )
    except UnicodeDecodeError as exc:
        raise _error("root-required effect descriptor is not UTF-8") from exc
    if len(lines) < 3 or lines[0] != "# schema=hapax.root-package-effects.v1":
        raise _error("root-required effect descriptor has an unsupported schema")
    cap_value = lines[1].removeprefix("# cap-host=")
    if lines[1] != f"# cap-host={cap_value}" or cap_value not in {
        "none",
        "hapax-appendix",
    }:
        raise _error("root-required effect descriptor has an unsupported cap host")
    cap_host = None if cap_value == "none" else cap_value
    if cap_host != package.cap_host:
        raise _error("root-required effect descriptor changed the package cap contract")
    scopes = tuple(line for line in lines[2:] if line and not line.startswith("#"))
    if not scopes or len(scopes) != len(set(scopes)) or list(scopes) != sorted(scopes):
        raise _error("root-required effect scopes must be nonempty, unique, and sorted")
    if any(line != line.strip() or EFFECT_SCOPE_RE.fullmatch(line) is None for line in scopes):
        raise _error("root-required effect descriptor contains an unsafe scope")
    expected_receipt = f"runtime:receipt:advance:{package.label}"
    if expected_receipt not in scopes:
        raise _error("root-required effect descriptor omits receipt advancement")
    return RuntimeEffectPolicy(cap_host=cap_host, scopes=scopes)


def _git_mode(repo: Path, sha: str, rel: PurePosixPath) -> str:
    output = _git(repo, "ls-tree", sha, "--", str(rel)).decode().splitlines()
    if len(output) != 1:
        raise _error(f"package Git tree has no unique entry for {rel}")
    mode = output[0].split(maxsplit=1)[0]
    if mode not in {"100644", "100755"}:
        raise _error(f"unsupported package Git mode {mode} for {rel}")
    return mode


def _validate_parent_directories(stage: Path, rel: PurePosixPath) -> None:
    current = stage
    for part in rel.parts[:-1]:
        current /= part
        _validate_owned_directory(current, label=f"package parent for {rel}")


def _validate_stage(paths: InstallPaths, repo: Path, sha: str, package: Package) -> Path:
    _validate_owned_directory(paths.defer_root, label="root-required defer root")
    defer_real = paths.defer_root.resolve(strict=True)
    if defer_real != paths.defer_root:
        raise _error(f"root-required defer root must not be a symlink: {paths.defer_root}")
    sha_dir = defer_real / sha
    stage = sha_dir / package.label
    _validate_owned_directory(sha_dir, label="receipt SHA directory")
    _validate_owned_directory(stage, label="deferred package directory")
    if stage.resolve(strict=True) != stage:
        raise _error(f"deferred package path must not traverse a symlink: {stage}")
    marker = stage / ".hapax-root-required-package-sha"
    if _read_exact_sha(marker, label="staged package SHA marker") != sha:
        raise _error("staged package SHA marker does not match the desired receipt")
    for rel in _manifest_files(repo, sha, package):
        _validate_parent_directories(stage, rel)
        candidate = stage.joinpath(*rel.parts)
        mode = _git_mode(repo, sha, rel)
        candidate_bytes = _read_regular_bytes(
            candidate,
            label=f"staged package file {rel}",
            executable=mode == "100755",
        )
        if candidate_bytes != _git(repo, "show", f"{sha}:{rel}"):
            raise _error(f"staged package bytes do not match {sha}:{rel}")
    return stage


def _validate_sudo(path: Path, *, test_mode: bool) -> None:
    if not test_mode and path != Path(DEFAULT_SUDO):
        raise _error(f"production sudo command must be {DEFAULT_SUDO}")
    inode = _lstat_regular(path, label="sudo command", executable=True)
    if test_mode:
        try:
            resolved = path.resolve(strict=True)
        except OSError as exc:
            raise _error(f"cannot resolve isolated test sudo command: {exc}") from exc
        if resolved == Path(DEFAULT_SUDO) or inode.st_uid != os.getuid() or inode.st_mode & 0o6022:
            raise _error(
                "isolated test sudo must be a caller-owned, non-setid, non-writable fake and never /usr/bin/sudo"
            )


def _validate_test_installer_sudo(name: str, value: str) -> None:
    if not value:
        return
    path = Path(value)
    if not path.is_absolute():
        raise _error(f"isolated {name} must be an absolute fake sudo path")
    _validate_sudo(path, test_mode=True)


def _run_after_sudo_hook(paths: InstallPaths) -> None:
    raw = os.environ.get(AFTER_SUDO_HOOK_ENV, "")
    if not raw:
        return
    if not paths.test_mode:
        raise _error(f"{AFTER_SUDO_HOOK_ENV} is test-only")
    hook = Path(raw)
    if not hook.is_absolute():
        raise _error(f"{AFTER_SUDO_HOOK_ENV} must be absolute")
    _lstat_regular(hook, label="after-sudo test hook", executable=True)
    result = subprocess.run([str(hook)], check=False, env=_safe_subprocess_env(paths.home))
    if result.returncode != 0:
        raise _error(f"after-sudo test hook failed with rc={result.returncode}")


def _child_env(paths: InstallPaths, repo: Path, sha: str, stage: Path) -> dict[str, str]:
    account = pwd.getpwuid(os.getuid())
    env = _safe_subprocess_env(paths.home)
    env.update(
        {
            "LOGNAME": account.pw_name,
            "USER": account.pw_name,
            "HAPAX_POST_MERGE_ROOT_DEFER_DIR": str(paths.defer_root),
            "HAPAX_ROOT_REQUIRED_STATE_ROOT": str(paths.state_root),
            "HAPAX_ROOT_REQUIRED_INSTALLED_SOURCE_ROOT": str(paths.state_root / "current-source"),
            "HAPAX_ROOT_REQUIRED_INSTALLED_RECEIPT_ROOT": str(
                paths.state_root / "installed-receipts"
            ),
            "HAPAX_ROOT_REQUIRED_DESIRED_RECEIPT_ROOT": str(paths.state_root / "desired-receipts"),
            "HAPAX_ROOT_REQUIRED_GIT_REPO": str(repo),
            "HAPAX_ROOT_REQUIRED_PACKAGE_SHA": sha,
            "HAPAX_ROOT_REQUIRED_DRAIN_DIR": str(stage),
        }
    )
    runtime = Path(f"/run/user/{os.getuid()}")
    if runtime.is_dir():
        env["XDG_RUNTIME_DIR"] = str(runtime)
    if paths.test_mode:
        test_prefixes = ("HAPAX_APCUPSD_", "HAPAX_OOM_", "HAPAX_UPS_", "HAPAX_UPOWER_")
        test_names = {"HAPAX_ROOT_FAILURE_INTAKE_DEST", "HAPAX_ROOT_REQUIRED_AUDIT_DEST"}
        for name in ("HAPAX_APCUPSD_INSTALL_SUDO", "HAPAX_OOM_INSTALL_SUDO"):
            value = os.environ.get(name, "")
            _validate_test_installer_sudo(name, value)
            env[name] = value
        env.update(
            (name, value)
            for name, value in os.environ.items()
            if name.startswith(test_prefixes) or name in test_names
        )
    return env


def _write_sealed_memfd(*, name: str, data: bytes, mode: int) -> int:
    try:
        fd = os.memfd_create(name, os.MFD_CLOEXEC | os.MFD_ALLOW_SEALING)
    except (AttributeError, OSError) as exc:
        raise _error(f"cannot create sealed Git source descriptor for {name}: {exc}") from exc
    try:
        view = memoryview(data)
        while view:
            written = os.write(fd, view)
            if written <= 0:
                raise OSError("short write to memfd")
            view = view[written:]
        os.fchmod(fd, mode)
        os.lseek(fd, 0, os.SEEK_SET)
        fcntl.fcntl(fd, fcntl.F_ADD_SEALS, REQUIRED_MEMFD_SEALS)
        actual_seals = fcntl.fcntl(fd, fcntl.F_GET_SEALS)
        if actual_seals & REQUIRED_MEMFD_SEALS != REQUIRED_MEMFD_SEALS:
            raise OSError(f"incomplete memfd seals: {actual_seals:#x}")
        return fd
    except BaseException:
        os.close(fd)
        raise


def _parent_death_preexec(parent_pid: int):
    def arm() -> None:
        if LIBC.prctl(PR_SET_PDEATHSIG, signal.SIGKILL, 0, 0, 0) != 0:
            os._exit(126)
        if os.getppid() != parent_pid:
            os._exit(126)

    return arm


def _sealed_git_sources(
    repo: Path, sha: str, package: Package
) -> tuple[tuple[PurePosixPath, int], ...]:
    sources: list[tuple[PurePosixPath, int]] = []
    try:
        for index, rel in enumerate(_manifest_files(repo, sha, package)):
            mode = _git_mode(repo, sha, rel)
            fd = _write_sealed_memfd(
                name=f"hapax-{package.label}-{index}",
                data=_git(repo, "show", f"{sha}:{rel}"),
                mode=0o755 if mode == "100755" else 0o644,
            )
            sources.append((rel, fd))
    except BaseException:
        for _, fd in sources:
            os.close(fd)
        raise
    return tuple(sources)


def _execute_installer(
    paths: InstallPaths,
    repo: Path,
    sha: str,
    stage: Path,
    package: Package,
    runtime_authority_task: Path,
) -> int:
    installer_rel = PurePosixPath(package.installer)
    if _git_mode(repo, sha, installer_rel) != "100755":
        raise _error("root-required installer Git mode is not executable")
    env = _child_env(paths, repo, sha, stage)
    sources = _sealed_git_sources(repo, sha, package)
    source_paths = {rel: f"/proc/{os.getpid()}/fd/{fd}" for rel, fd in sources}
    installer = source_paths.get(installer_rel)
    if installer is None:
        for _, fd in sources:
            os.close(fd)
        raise _error("sealed Git source set omits the package installer")
    env[SEALED_SOURCE_FDS_ENV] = ":".join(source_paths[rel] for rel, _ in sources)
    env["HAPAX_RUNTIME_AUTHORITY_TASK"] = str(runtime_authority_task)
    print(
        "hapax-root-required-deferred-install: authenticated "
        f"package={package.label} sha={sha} source=sealed-git-memfd",
        flush=True,
    )
    result: subprocess.CompletedProcess[bytes] | None = None
    execution_error: OSError | None = None
    close_errors: list[str] = []
    try:
        try:
            result = subprocess.run(
                [
                    BASH,
                    installer,
                    "--source",
                    str(stage),
                    "--authenticated-sealed-source",
                    "--install",
                    "--verify-live",
                ],
                check=False,
                env=env,
                preexec_fn=_parent_death_preexec(os.getpid()),
            )
        except OSError as exc:
            execution_error = exc
    finally:
        for rel, fd in sources:
            try:
                os.close(fd)
            except OSError as exc:
                close_errors.append(f"{rel}: {exc}")
    if close_errors:
        raise _error("cannot close sealed Git source descriptors: " + "; ".join(close_errors))
    if execution_error is not None:
        raise _error(f"cannot execute the sealed package installer: {execution_error}")
    if result is None:
        raise _error("package installer did not start")
    return result.returncode


def install(
    package: Package,
    *,
    expected_sha: str,
    activation_release: Path,
    runtime_authority_task: Path,
) -> int:
    paths = _install_paths()
    _validate_sudo(paths.sudo, test_mode=paths.test_mode)
    _validate_owned_directory(paths.state_root, label="root-required state root")
    desired_receipts = paths.state_root / "desired-receipts"
    _validate_owned_directory(desired_receipts, label="desired-receipt directory")
    receipt = desired_receipts / f"{package.label}.sha"
    sha = _read_exact_sha(receipt, label="desired package receipt")
    if sha != expected_sha:
        raise _error(f"desired package receipt changed: expected={expected_sha} actual={sha}")
    repo = _physical_repo(paths.repo_alias)
    try:
        expected_repo = activation_release.resolve(strict=True)
    except OSError as exc:
        raise _error(
            f"authenticated activation release is unavailable: {activation_release}"
        ) from exc
    if not activation_release.is_absolute() or repo != expected_repo:
        raise _error(
            f"activation release changed after helper authentication: expected={expected_repo} actual={repo}"
        )
    _validate_commit(repo, sha)
    _validate_stage(paths, repo, sha, package)
    runtime_gates = _validate_runtime_gates(paths, repo, sha, package, runtime_authority_task)
    sudo_result = subprocess.run(
        [str(paths.sudo), "-v"], check=False, env=_safe_subprocess_env(paths.home)
    )
    if sudo_result.returncode != 0:
        raise _error(f"sudo credential warmup failed with rc={sudo_result.returncode}")
    _run_after_sudo_hook(paths)
    if _read_exact_sha(receipt, label="desired package receipt after sudo") != sha:
        raise _error("desired package receipt changed during sudo warmup")
    _validate_commit(repo, sha)
    stage = _validate_stage(paths, repo, sha, package)
    _validate_runtime_gates(
        paths,
        repo,
        sha,
        package,
        runtime_authority_task,
        expected=runtime_gates,
    )
    result = _execute_installer(paths, repo, sha, stage, package, runtime_authority_task)
    if result != 0:
        return result
    print(
        "hapax-root-required-deferred-install: completed authenticated "
        f"package={package.label} sha={sha}",
        flush=True,
    )
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = ActionableArgumentParser(
        prog="hapax-root-required-deferred-install", description=__doc__
    )
    parser.add_argument("--package", choices=sorted(PACKAGES), required=True)
    parser.add_argument("--expected-sha", required=True)
    parser.add_argument("--activation-release", type=Path, required=True)
    parser.add_argument("--runtime-authority-task", type=Path, required=True)
    args = parser.parse_args(argv)
    if SHA_TEXT_RE.fullmatch(args.expected_sha) is None:
        parser.error("--expected-sha must be exactly 40 lowercase hex characters")
    try:
        return install(
            PACKAGES[args.package],
            expected_sha=args.expected_sha,
            activation_release=args.activation_release,
            runtime_authority_task=args.runtime_authority_task,
        )
    except DeferredInstallError as exc:
        print(f"hapax-root-required-deferred-install: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
