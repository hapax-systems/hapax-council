#!/usr/bin/env bash
# cc-claim <task_id>
#
# Claim a vault cc-task for the current session. Atomic: rewrites the
# task note frontmatter (status: offered -> claimed; assigned_to:
# unassigned -> $HAPAX_AGENT_ROLE/$CODEX_ROLE/$CLAUDE_ROLE; claimed_at: now), then writes the
# session's claim file at ~/.cache/hapax/cc-active-task-{role}.
#
# After this, the next file-mutating tool call passes through the
# cc-task-gate hook (which auto-transitions claimed → in_progress).
#
# Operator can also pre-claim a task by hand-editing the frontmatter
# in Obsidian; this script just adds the claim file the hook reads.
#
# Symlink to ~/.local/bin/cc-claim for quick access:
#   ln -sf ~/projects/hapax-council/scripts/cc-claim ~/.local/bin/cc-claim

set -euo pipefail

# Resolve through symlinks — cc-claim is installed as ~/.local/bin/cc-claim ->
# the deployed worktree, so the real script's sibling agent-role.sh (session-id /
# role-less helpers) must be sourced. Without this, the symlinked install would
# silently fall back to env-only role resolution and never session-key a claim.
_cc_self="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  _cc_self="$(readlink -f "$_cc_self" 2>/dev/null || printf '%s' "$_cc_self")"
fi
SCRIPT_DIR="$(cd "$(dirname "$_cc_self")" && pwd)"
ROLE_HELPER="$SCRIPT_DIR/../hooks/scripts/agent-role.sh"
if [[ -f "$ROLE_HELPER" ]]; then
  # shellcheck source=../hooks/scripts/agent-role.sh
  . "$ROLE_HELPER"
fi

force=false
recover_claim_publications_only=false
# Default mode publishes through the admitted Gate-0B claim-publication path.
# The legacy note/cache writer is available only as an explicit slice-1 fallback.
canon_enforced="1"
usage() {
  cat >&2 <<'USAGE'
usage: cc-claim [--force] <task_id> [--dispatch-* VALUE ...]
       cc-claim [--force] [--dispatch-* VALUE ...] -- <task_id>
       cc-claim --recover-claim-publications [<task_id>]

Omit dispatch flags in default mode for a manual self-witnessed binding.
Every --dispatch-* option requires one VALUE from the dispatcher receipt.
USAGE
}
require_option_value() {
  local flag="$1"
  local value="${2:-}"
  if [[ -z "$value" || "$value" == --* ]]; then
    echo "cc-claim: missing value for $flag. Next action: rerun with '$flag VALUE' from the dispatcher receipt, or omit all dispatch flags for a manual self-witnessed binding." >&2
    usage
    exit 1
  fi
}
if [[ "${HAPAX_GATE0B_CLAIM_PUBLICATION_OFF:-}" == "1" ]]; then
  canon_enforced="0"
  echo "cc-claim: WARNING - HAPAX_GATE0B_CLAIM_PUBLICATION_OFF=1; using legacy claim writer. Next action: use only for an operator-authorized emergency fallback, verify the legacy claim/close result, then unset the killswitch and repair the admitted Gate-0B claim-publication path before normal work resumes." >&2
fi
task_id=""
dispatch_message_id="${HAPAX_CLAIM_DISPATCH_MESSAGE_ID:-}"
dispatch_binding_hash="${HAPAX_CLAIM_DISPATCH_BINDING_HASH:-}"
dispatch_platform="${HAPAX_CLAIM_DISPATCH_PLATFORM:-}"
dispatch_mode="${HAPAX_CLAIM_DISPATCH_MODE:-}"
dispatch_profile="${HAPAX_CLAIM_DISPATCH_PROFILE:-}"
dispatch_authority_case="${HAPAX_CLAIM_DISPATCH_AUTHORITY_CASE:-}"
dispatch_idempotency_key="${HAPAX_CLAIM_DISPATCH_IDEMPOTENCY_KEY:-}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --force) force=true; shift ;;
    --recover-claim-publications) recover_claim_publications_only=true; shift ;;
    --dispatch-message-id) require_option_value "$1" "${2:-}"; dispatch_message_id="$2"; shift 2 ;;
    --dispatch-binding-hash) require_option_value "$1" "${2:-}"; dispatch_binding_hash="$2"; shift 2 ;;
    --dispatch-platform) require_option_value "$1" "${2:-}"; dispatch_platform="$2"; shift 2 ;;
    --dispatch-mode) require_option_value "$1" "${2:-}"; dispatch_mode="$2"; shift 2 ;;
    --dispatch-profile) require_option_value "$1" "${2:-}"; dispatch_profile="$2"; shift 2 ;;
    --dispatch-authority-case) require_option_value "$1" "${2:-}"; dispatch_authority_case="$2"; shift 2 ;;
    --dispatch-idempotency-key) require_option_value "$1" "${2:-}"; dispatch_idempotency_key="$2"; shift 2 ;;
    --) shift; task_id="${1:-}"; shift || true ;;
    -*) echo "cc-claim: unknown flag '$1'. Next action: check the usage below and rerun with only supported cc-claim options." >&2; usage; exit 1 ;;
    *) task_id="$1"; shift ;;
  esac
done
if [[ -z "$task_id" && "$recover_claim_publications_only" != "true" ]]; then
  usage
  exit 1
fi
PROJECT_PYTHON="$SCRIPT_DIR/../.venv/bin/python"
if [[ "$canon_enforced" == "1" && ! -x "$PROJECT_PYTHON" ]]; then
  echo "cc-claim: project_runtime_unprovisioned: expected pinned interpreter at $PROJECT_PYTHON; Next action: run 'uv sync' in this worktree, then rerun cc-claim." >&2
  exit 3
fi
python_runner="$PROJECT_PYTHON"
if [[ "$canon_enforced" == "0" && ! -x "$python_runner" ]]; then
  python_runner="$(command -v python3 || true)"
fi
if [[ ! -x "$python_runner" ]]; then
  echo "cc-claim: python3 missing; cannot rewrite frontmatter. Next action: install python3 or rerun from a provisioned repo virtualenv." >&2
  exit 3
fi
if [[ "$recover_claim_publications_only" == "true" ]]; then
  "$python_runner" -I - "$SCRIPT_DIR/.." "$task_id" <<'PYEOF'
import sys
from pathlib import Path

repo_root = Path(sys.argv[1]).resolve()
task_id = sys.argv[2] or None
if str(repo_root) not in sys.path:
    sys.path.insert(0, str(repo_root))

from shared.gate0b_claim_publication_install import default_claim_publication_roots  # noqa: E402
from shared.sdlc_claim import ClaimPublicationError, recover_claim_publications  # noqa: E402

roots = default_claim_publication_roots(home=Path.home())
try:
    results = recover_claim_publications(
        cache_dir=Path(roots.claim_cache_dir),
        transaction_root=Path(roots.claim_transaction_root),
        receipt_root=Path(roots.claim_receipt_root),
        lock_root=Path(roots.claim_lock_root),
        task_id=task_id,
    )
except ClaimPublicationError as exc:
    print(
        f"cc-claim: HOLD — {exc}. Next action: repair the named recovery root, "
        "then rerun cc-claim --recover-claim-publications"
        + (f" {task_id}" if task_id else "")
        + ".",
        file=sys.stderr,
    )
    sys.exit(8)
if not results:
    scope = task_id or "all tasks"
    print(f"cc-claim: no admitted claim-publication journals required recovery for {scope}")
    sys.exit(0)
holds = [item for item in results if item.state == "hold"]
for item in results:
    suffix = f":{item.reason_code}" if item.reason_code else ""
    print(f"cc-claim: recovery {item.publication_id}:{item.state}{suffix}")
if holds:
    print(
        "cc-claim: HOLD — admitted claim-publication recovery still has held journals. "
        "Next action: repair or quarantine the named journal/projection/receipt path, "
        "then rerun cc-claim --recover-claim-publications"
        + (f" {task_id}" if task_id else "")
        + ".",
        file=sys.stderr,
    )
    sys.exit(8)
sys.exit(0)
PYEOF
  exit $?
fi
dispatch_values=(
  "$dispatch_message_id"
  "$dispatch_binding_hash"
  "$dispatch_platform"
  "$dispatch_mode"
  "$dispatch_profile"
  "$dispatch_authority_case"
  "$dispatch_idempotency_key"
)
dispatch_present=0
dispatch_missing=0
for value in "${dispatch_values[@]}"; do
  [[ -n "$value" ]] && dispatch_present=$((dispatch_present + 1)) || dispatch_missing=$((dispatch_missing + 1))
done
if [[ "$dispatch_present" -gt 0 && "$dispatch_missing" -gt 0 ]]; then
  echo "cc-claim: dispatch binding flags are all-or-none. Next action: rerun with all seven HAPAX_CLAIM_DISPATCH_* variables or all seven --dispatch-* flags from the dispatcher receipt, or omit all seven so cc-claim issues a manual self-witnessed binding." >&2
  exit 1
fi
if [[ "$canon_enforced" == "1" && "$force" == "true" ]]; then
  echo "cc-claim: --force is retired under canon enforcement; release the prior claim through a governed transition. Next action: run cc-close on the current task if terminal, or ask the operator to perform a governed release of the stale claim before retrying." >&2
  exit 2
fi
# Resolve identity from the SAME source of truth as the gate (agent-role.sh):
# explicit env → agent-role recovery → relay presence → role-less fallback. A
# session with no role but a session id resolves to "roleless" so it can always
# claim (FM-1: "no role" never means "no escape").
if declare -F hapax_effective_role >/dev/null 2>&1; then
  role="$(hapax_effective_role 2>/dev/null || true)"
else
  role="${HAPAX_AGENT_ROLE:-${CODEX_ROLE:-${CLAUDE_ROLE:-}}}"
fi
if [[ -z "$role" ]]; then
  echo "cc-claim: cannot determine identity; set HAPAX_AGENT_ROLE/CODEX_ROLE/CLAUDE_ROLE or a session id (HAPAX_SESSION_ID). Next action: launch through scripts/hapax-codex or export a governed lane identity, then rerun cc-claim." >&2
  exit 1
fi
session_id=""
if declare -F hapax_session_id >/dev/null 2>&1; then
  session_id="$(hapax_session_id 2>/dev/null || true)"
fi
# Claim-by-pid unrepresentable (taxonomy-a3-session-identity): only an id with
# per-session entropy may key a claim. The predicate SSOT is
# shared/session_identity.py::is_claim_keyable_session_id; a pid-shaped id —
# the retired `<role>-$$` spawner fallback — degrades to legacy role keying
# instead of minting an ambiguous key.
identity_python="$python_runner"
if [[ -n "$session_id" ]] && ! "$identity_python" -I -c '
import sys
sys.path.insert(0, sys.argv[2])
from shared.session_identity import is_claim_keyable_session_id
sys.exit(0 if is_claim_keyable_session_id(sys.argv[1]) else 1)
' "$session_id" "$SCRIPT_DIR/.." 2>/dev/null; then
  if [[ "$canon_enforced" == "1" ]]; then
    echo "cc-claim: canon enforcement requires a claim-keyable non-PID session id. Next action: relaunch the lane with a UUID-like HAPAX_SESSION_ID; pid-shaped session ids cannot own canonical claims." >&2
    exit 2
  fi
  echo "cc-claim: session id '$session_id' is not claim-keyable (pid-shaped or malformed) — using legacy role-keyed claim only" >&2
  session_id=""
fi
if [[ "$canon_enforced" == "1" && -z "$session_id" ]]; then
  echo "cc-claim: canon enforcement requires a claim-keyable session id. Next action: relaunch through the governed session launcher so HAPAX_SESSION_ID is set, then rerun cc-claim." >&2
  exit 2
fi
if [[ -n "$session_id" ]]; then
  session_claim_file="$HOME/.cache/hapax/cc-active-task-$role-$session_id"
else
  session_claim_file=""
fi
lease_ttl="${HAPAX_CLAIM_LEASE_TTL_SECS:-21600}"

# --- Multi-claim prevention + lease expiry (reform Phase 1, cluster 6) ---
# A role must close its current task before claiming a new one. Without this,
# Codex lanes bulk-claimed dozens of tasks with zero implementation. Scan the
# role's claim files — the legacy cc-active-task-<role> AND every session-keyed
# cc-active-task-<role>-<session_id> (FM-2). Under admitted publication, expiry
# is evidence for a governed release, never permission for this claim attempt to
# delete another lease. The explicit legacy fallback preserves the historical
# reaping behavior for slice-1 compatibility. Vault root comes from the L9
# resolver so the work plane can move.
ROOT_HELPER="$SCRIPT_DIR/../hooks/scripts/cc-task-root.sh"
if [[ ! -f "$ROOT_HELPER" ]]; then
  echo "cc-claim: cc-task-root.sh missing next to the installed scripts. Next: restore hooks/scripts/cc-task-root.sh" >&2
  exit 2
fi
# shellcheck source=../hooks/scripts/cc-task-root.sh
. "$ROOT_HELPER"
cc_task_root_resolve || exit $?
vault_root_check="$CC_TASK_ROOT"
now_epoch="$(date +%s 2>/dev/null || echo 0)"
legacy_claim_file="$HOME/.cache/hapax/cc-active-task-$role"

# Role-release vocabulary. MUST match shared/sdlc_lifecycle.TASK_ROLE_RELEASING_STATUSES
# (pinned by tests/shared/test_sdlc_lifecycle.py::TestRoleReleaseVocabularyDrift).
#
# Two groups release the lane:
#   terminal  — the work is over.
#   resumable — the work is DONE and waiting on the pipeline (pr_open, merge_queue,
#               ready-family). These are pipeline-held, not worker-held; the lane can
#               take other work and re-claim later via TASK_RESUMABLE_STATUSES.
#
# This list previously read `done|completed|closed|withdrawn|superseded` — five of the
# fifteen canonical terminal statuses and none of the resumable ones. Measured
# 2026-08-29, that held 43 lanes hostage to finished work awaiting review, which is a
# feedback loop rather than a capacity limit.
_cc_role_release_status() {
  case "$1" in
    # terminal — fulfilling
    done|completed|complete|closed|fulfilled|resolved) return 0 ;;
    # terminal — non-fulfilling
    withdrawn|withdrawn_stale|superseded|closed_superseded|rejected|refused) return 0 ;;
    not_applicable|deferred|closed_poisoned) return 0 ;;
    # resumable — finished, awaiting the pipeline
    pr_open|merge_queue|ci_green|ready|ready_for_review|review_ready|ready_for_merge) return 0 ;;
    # post-merge and pre-work — declared 2026-08-29 after both were found live in the
    # active corpus while belonging to no status set at all, which held their lanes
    # permanently.
    merged_awaiting_runtime_witness|backlog) return 0 ;;
  esac
  return 1
}

# The resumable subset of the above: statuses a lane can RE-CLAIM without changing them
# (cc-claim's resume path). A task in one of these is free of workers by default — that is
# the whole point of #4611 — but a RESUMED one is worker-held again while its status stays
# exactly here. The status is therefore one value for two states; the `cc-claim-resumed-<key>`
# marker the resume path writes next to the anchor is the discriminator (codex critical on
# #4611: a freshly resumed ready-state task was treated as lane-free).
_cc_role_resumable_status() {
  case "$1" in
    pr_open|merge_queue|ci_green|ready|ready_for_review|review_ready|ready_for_merge) return 0 ;;
    merged_awaiting_runtime_witness|backlog) return 0 ;;
  esac
  return 1
}

shopt -s nullglob
for cf in "$legacy_claim_file" "$HOME/.cache/hapax/cc-active-task-$role-"*; do
  [[ -f "$cf" ]] || continue
  # `cc-active-task-$role-*` has no role boundary: for role `cx-red` it also matches the
  # legitimate role `cx-red-operator-email`'s sidecars (codex critical on #4611, mirrored
  # from the Python scan). Only the bare legacy key and `role-<canonical session uuid>` are
  # this role's; every live sidecar in the estate has that shape (measured 2026-09-02).
  if [[ "$cf" != "$legacy_claim_file" ]]; then
    cf_suffix="${cf##*/cc-active-task-$role-}"
    [[ "$cf_suffix" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || continue
  fi
  existing_task="$(head -n1 "$cf" | tr -d '[:space:]' || true)"
  cf_mtime="$(stat -c %Y "$cf" 2>/dev/null || echo "$now_epoch")"

  # Resolve the prior task's status BEFORE any age-based decision.
  #
  # Release is a property of the TASK, not of the lease's age: a task that is done or
  # pipeline-held is released whether or not its lease also expired. An earlier revision
  # of this change tested expiry first, so in canonical mode every lease older than the
  # TTL took the HOLD path at the top of this loop and the release case below was
  # unreachable for exactly the aged, pre-existing sidecars that most need it. That is
  # the same defect one level deeper — the first revision skipped the role-cap check but
  # left canonical publication blocking, and this one freed fresh leases but left aged
  # ones held.
  # Look in `closed/` as well as `active/`, and in that order — matching
  # `_task_note_path_for_any_state` on the Python side, which this had silently diverged from.
  # A task that reached a terminal status is usually MOVED to closed/, so an active/-only
  # lookup finds no note for exactly the tasks most certain to have released the role: it
  # falls through to the expiry HOLD, and a closed task holds a lane forever. That is the
  # release-vs-expiry ordering defect again, arriving through the note lookup instead.
  existing_note=""
  existing_status="unknown"
  if [[ -n "$existing_task" && "$existing_task" != "$task_id" ]]; then
    # Look in BOTH directories and refuse to pick by order. A task with a note in closed/ AND
    # active/ is a duplicate identity: reading the terminal copy first freed the lane while
    # the active copy still said `claimed` (codex critical on #4611; 41 such twins measured
    # 2026-09-02). The Python resolver HOLDs on the same condition; the two must not diverge.
    existing_closed=""
    existing_active=""
    for c in "$vault_root_check/closed/$existing_task.md" "$vault_root_check/closed/$existing_task-"*.md; do
      [[ -f "$c" ]] && existing_closed="$c" && break
    done
    for c in "$vault_root_check/active/$existing_task.md" "$vault_root_check/active/$existing_task-"*.md; do
      [[ -f "$c" ]] && existing_active="$c" && break
    done
    if [[ -n "$existing_closed" && -n "$existing_active" ]]; then
      echo "cc-claim: HOLD - prior task '$existing_task' (from $cf) has a note in BOTH '$existing_closed' and '$existing_active'. A duplicate identity cannot be resolved by directory order. Next action: decide which copy is authoritative, mark the other 'status: superseded' (or move it out of active/) with operator approval, and rerun." >&2
      exit 8
    fi
    existing_note="${existing_closed:-$existing_active}"
    if [[ -n "$existing_note" ]]; then
      existing_status="$(grep -oP '^status:\s*\K\S+' "$existing_note" 2>/dev/null || echo "unknown")"
    fi
  fi

  # A released prior task does not occupy the role cap. The sidecars themselves are NOT
  # removed here: archival happens on the Python side under the Gate-0B claim-publication
  # lock, where it is transactional, receipted into task lineage, and fails closed. An
  # earlier revision `rm -f`'d them from this loop — unlocked, unreceipted, and a second
  # mitigation for a hazard `_archive_dispatch_only_claim_residue` already owns.
  #
  # A RESUMED task is the exception: its status stays in the resumable set by design while a
  # worker holds the lane again. The resume path stamps `cc-claim-resumed-<key>` naming the
  # task; when that marker names THIS anchor's task and the lease is still live, the lane is
  # busy and falls through to the BLOCKED message below. A marker for another task (a reused
  # key) is inert, and an expired lease releases a resumed lane the same way it releases any
  # other dead session's.
  resumed_marker="$HOME/.cache/hapax/cc-claim-resumed-${cf##*/cc-active-task-}"
  existing_resumed=0
  if [[ -f "$resumed_marker" ]] && [[ "$(head -n1 "$resumed_marker" | tr -d '[:space:]')" == "$existing_task" ]]; then
    existing_resumed=1
  fi
  if [[ -n "$existing_note" ]] && _cc_role_release_status "$existing_status"; then
    if (( existing_resumed == 1 )) && _cc_role_resumable_status "$existing_status" && (( now_epoch - cf_mtime <= lease_ttl )); then
      : # resumed and worker-held: not released; handled below
    else
      continue
    fi
  fi

  if (( now_epoch - cf_mtime > lease_ttl )); then
    if [[ "$canon_enforced" == "1" && "$cf" == "$legacy_claim_file" && -n "$session_claim_file" && -f "$session_claim_file" ]]; then
      session_existing_task="$(head -n1 "$session_claim_file" | tr -d '[:space:]' || true)"
      session_cf_mtime="$(stat -c %Y "$session_claim_file" 2>/dev/null || echo 0)"
      if [[ -n "$existing_task" && "$session_existing_task" == "$existing_task" ]] && (( now_epoch - session_cf_mtime <= lease_ttl )); then
        continue
      fi
    fi
    if [[ "$canon_enforced" == "1" ]]; then
      claim_base="$(basename "$cf")"
      claim_key="${claim_base#cc-active-task-}"
      epoch_file="$HOME/.cache/hapax/cc-claim-epoch-$claim_key"
      dispatch_file="$HOME/.cache/hapax/cc-claim-dispatch-$claim_key.json"
      if [[ -n "$existing_task" ]]; then
        echo "cc-claim: HOLD — expired claim '$cf' requires exact stale-lease release before canonical claim publication. Next action: with operator approval, run the Manual Stale-Lease Release runbook using claim_file='$cf' and task_id='$existing_task'; archive/remove only '$cf', '$epoch_file', and '$dispatch_file', then rerun cc-claim." >&2
      else
        echo "cc-claim: HOLD — expired claim '$cf' requires exact stale-lease release before canonical claim publication. Next action: inspect '$cf' to recover the task id, then with operator approval run the Manual Stale-Lease Release runbook for claim_file='$cf'; archive/remove only '$cf', '$epoch_file', and '$dispatch_file', then rerun cc-claim." >&2
      fi
      shopt -u nullglob
      exit 7
    fi
    # Legacy fallback: reap session-keyed files (a dead session's lease
    # auto-frees); leave the shared legacy file (it is overwritten below and
    # never blocks once expired) for the out-of-scope consumers that still read
    # it.
    [[ "$cf" != "$legacy_claim_file" ]] && rm -f "$cf" 2>/dev/null || true
    continue
  fi
  [[ -n "$existing_task" && "$existing_task" != "$task_id" ]] || continue
  [[ -n "$existing_note" ]] || continue
  if (( existing_resumed == 1 )); then
    echo "cc-claim: BLOCKED — role '$role' already has active task '$existing_task' (status: $existing_status, RESUMED by a live session — worker-held, not pipeline-held)." >&2
    echo "  Next action: let that session finish or close it with cc-close $existing_task; the lane frees when its lease expires or the task reaches a terminal status." >&2
  else
    echo "cc-claim: BLOCKED — role '$role' already has active task '$existing_task' (status: $existing_status)." >&2
    echo "  Next action: close it first with cc-close $existing_task if terminal, or resume that task instead." >&2
  fi
  if [[ "$canon_enforced" == "0" ]]; then
    echo "  Legacy fallback only: cc-claim --force $task_id" >&2
  fi
  if [[ "$canon_enforced" == "1" || "$force" != "true" ]]; then
    shopt -u nullglob
    exit 7
  fi
  echo "cc-claim: --force override — releasing prior claim on '$existing_task'" >&2
done
shopt -u nullglob

vault_root="$CC_TASK_ROOT"
note_path=""
# Match `<task_id>-<descriptor>.md` (most tasks).
for candidate in "$vault_root/active/$task_id-"*.md; do
  if [[ -f "$candidate" ]]; then
    note_path="$candidate"
    break
  fi
done
# Fallback: exact-match `<task_id>.md` for tasks without a descriptor
# suffix (eg. ytb-LEGIBILITY-SMOKE-FOLLOWUP.md, ytb-OBJECTIVES-OVERLAY-
# RENDER-FOLLOWUP.md). The glob above doesn't match these because it
# requires a literal `-` after the task_id.
if [[ -z "$note_path" ]] && [[ -f "$vault_root/active/$task_id.md" ]]; then
  note_path="$vault_root/active/$task_id.md"
fi
if [[ -z "$note_path" ]]; then
  echo "cc-claim: task '$task_id' not found in $vault_root/active/" >&2
  echo "Next action: browse offered tasks at $vault_root/_dashboard/cc-offered.md and rerun with the exact active task id." >&2
  exit 2
fi

# Verify status/ownership, then either claim offered work or resume owned
# ready-state work (PR/merge-queue maintenance).
claim_epoch="$(date +%s)"
"$python_runner" -I - \
  "$note_path" "$role" "$task_id" "$SCRIPT_DIR/.." "$session_id" \
  "$canon_enforced" "$HOME/.cache/hapax" "$claim_epoch" \
  "$dispatch_message_id" "$dispatch_binding_hash" "$dispatch_platform" \
  "$dispatch_mode" "$dispatch_profile" "$dispatch_authority_case" \
  "$dispatch_idempotency_key" <<'PYEOF'
import hashlib
import json
import re
import shutil
import sys
from datetime import datetime, timezone
from pathlib import Path

path, role, task_id, repo_root = (
    Path(sys.argv[1]),
    sys.argv[2],
    sys.argv[3],
    Path(sys.argv[4]).resolve(),
)
# Already validated claim-keyable by the bash caller (empty when not); stamped
# into the session log so vault forensics join on session_id, never on pid.
session_id = sys.argv[5] if len(sys.argv) > 5 else ""
canon_enforced = len(sys.argv) > 6 and sys.argv[6] == "1"
cache_dir = Path(sys.argv[7]) if len(sys.argv) > 7 else Path.home() / ".cache" / "hapax"
claim_epoch = int(sys.argv[8]) if len(sys.argv) > 8 and sys.argv[8] else 0
(
    dispatch_message_id,
    dispatch_binding_hash,
    dispatch_platform,
    dispatch_mode,
    dispatch_profile,
    dispatch_authority_case,
    dispatch_idempotency_key,
) = (sys.argv[9:16] if len(sys.argv) >= 16 else ("", "", "", "", "", "", ""))
if str(repo_root) not in sys.path:
    sys.path.insert(0, str(repo_root))

from shared.sdlc_lifecycle import (  # noqa: E402
    TASK_CLAIMABLE_STATUSES,
    TASK_RESUMABLE_STATUSES,
    TASK_ROLE_RELEASING_STATUSES,
    TASK_TERMINAL_STATUSES,
    blocked_reason_from_frontmatter,
    blocked_witness_from_frontmatter,
    frontmatter_from_text,
    task_closure_validity,
)

note_before = path.read_bytes()
text = note_before.decode("utf-8")


def _frontmatter_scalar(note_text: str, key: str) -> str:
    if not note_text.startswith("---"):
        return ""
    end = note_text.find("\n---", 4)
    if end < 0:
        return ""
    frontmatter_text = note_text[4:end]
    match = re.search(rf"^{re.escape(key)}:[ \t]*(.*)$", frontmatter_text, re.MULTILINE)
    if not match:
        return ""
    value = match.group(1).strip().strip('"').strip("'")
    return "" if value.lower() in {"", "null", "none", "~", "[]"} else value


