    )

    def _safe_lineage_component(value: str) -> str:
        return re.sub(r"[^A-Za-z0-9._:-]+", "_", value).strip("._:-")[:160] or "unknown"

    def _residue_task_ids(residue: tuple[Path, ...] | list[Path]) -> set[str]:
        """The task id each claim sidecar names in its own content.

        `cc-active-task-*`: first line is the task id. `cc-claim-epoch-*`: "<epoch> <task_id>".
        `cc-claim-dispatch-*.json`: the `task_id` field. An unreadable or unparseable sidecar
        contributes nothing — the caller compares what IS named against the receipt, and an
        empty set means nothing could be checked, which is not a mismatch.
        """
        named: set[str] = set()
        for path in residue:
            try:
                text = path.read_text(encoding="utf-8")
            except (OSError, UnicodeDecodeError):
                continue
            name = path.name
            if name.startswith("cc-claim-dispatch-"):
                try:
                    payload = json.loads(text)
                except ValueError:
                    continue
                task = payload.get("task_id") if isinstance(payload, dict) else None
                if isinstance(task, str) and task.strip():
                    named.add(task.strip())
            elif name.startswith("cc-claim-epoch-"):
                parts = text.strip().split(None, 1)
                if len(parts) == 2 and parts[1].strip():
                    named.add(parts[1].strip())
            elif name.startswith("cc-active-task-") or name.startswith("cc-claim-resumed-"):
                # Both are single-line task-id files; the resumed marker is written by the
                # resume path only (see `_write_resumed_marker`) and names the same task.
                first = text.split("\n", 1)[0].strip()
                if first:
                    named.add(first)
        return named

    def _residue_identity(residue: tuple[Path, ...] | list[Path]) -> dict[str, str]:
        """What identifies THIS residue beyond its file names, which lanes reuse.

        `epoch`: the epoch sidecar's first line ("<epoch> <task_id>") — a claim epoch is minted
        per publication, so two publications of the same task by the same lane differ here.
        `dispatch_sha256`: the dispatch sidecar's content hash. Either is `absent` when the
        sidecar is not present or unreadable; absence is recorded, never fabricated.
        """
        identity = {"epoch": "absent", "dispatch_sha256": "absent"}
        for path in residue:
            try:
                data = path.read_bytes()
            except OSError:
                continue
            if path.name.startswith("cc-claim-epoch-"):
                first = data.decode("utf-8", "replace").split("\n", 1)[0].strip()
                if first:
                    identity["epoch"] = first
            elif path.name.startswith("cc-claim-dispatch-"):
                identity["dispatch_sha256"] = hashlib.sha256(data).hexdigest()
        return identity

    def _task_note_paths_by_state(vault_root: Path, observed_task_id: str) -> dict[str, Path]:
        """The task's note in each state directory it appears in — never "the first one".

        A task id is supposed to live in exactly one of ``closed/`` and ``active/``. When it is
        in BOTH — measured 2026-09-02: 41 such twins, the active copies restored from a July
        snapshot beside their closed ``done`` originals — resolving closed-first silently reads
        the terminal copy, archives a live claim and admits another task, while the active copy
        still says ``claimed``. Duplicate identities are reported, so the caller can HOLD.
        """
        found: dict[str, Path] = {}
        for subdir in ("closed", "active"):
            root = vault_root / subdir
            exact = root / f"{observed_task_id}.md"
            if exact.is_file():
                found[subdir] = exact
                continue
            for candidate in sorted(root.glob(f"{observed_task_id}-*.md")):
                if candidate.is_file():
                    found[subdir] = candidate
                    break
        return found

    def _task_note_path_for_any_state(vault_root: Path, observed_task_id: str) -> Path | None:
        found = _task_note_paths_by_state(vault_root, observed_task_id)
        if len(found) > 1:
            return None  # ambiguous; `_task_status_for_any_state` says so and the caller HOLDs
        return next(iter(found.values()), None)

    def _task_status_for_any_state(vault_root: Path, observed_task_id: str) -> str:
        found = _task_note_paths_by_state(vault_root, observed_task_id)
        if not found:
            return "missing"
        if len(found) > 1:
            return "ambiguous"
        task_path = next(iter(found.values()))
        return _frontmatter_scalar(task_path.read_text(encoding="utf-8"), "status") or "unknown"

    _RELEASE_RECEIPT = "README.md"

    def _write_release_receipt(
        lineage_dir: Path,
        prior_task_id: str,
        claim_key: str,
        current_task_id: str,
        observed_at: str,
        residue: "tuple[Path, ...]",
    ) -> None:
        """Write the receipt BEFORE the residue moves, so the archive is self-describing.

        A crash between moves previously left files in lineage with nothing recording which
        task they belonged to — and because the `cc-active-task` anchor had already moved, no
        later run could recover it. Receipt-first makes the archive identify itself from its
        first instant, which is what `_interrupted_release_archivals` reads. Its `archived:` line
        is load-bearing for that: it names the exact sidecars this archival set out to move, and
        without it a receipt could not be tied to the residue actually left behind.
        """
        # **Names are not identities.** Claim keys AND file names are reused across publications
        # of the same task by the same lane, so `archived:` alone cannot tell this residue from
        # the residue a later re-claim of the same task leaves behind (codex critical on #4611,
        # one level deeper than the task-id check). The receipt therefore records what the
        # residue itself carries — the per-publication claim epoch and the dispatch content hash —
        # and `_interrupted_release_archivals` requires them to agree before it will attribute
        # residue to this receipt. Absent sidecars are written as `absent`, not guessed.
        identity = _residue_identity(residue)
        lineage_dir.mkdir(parents=True, exist_ok=True)
        (lineage_dir / _RELEASE_RECEIPT).write_text(
            "Archived claim residue for a task that released this role.\n"
            f"task_id: {prior_task_id}\n"
            f"claim_key: {claim_key}\n"
            f"claimed_next: {current_task_id}\n"
            f"archived_at: {observed_at}\n"
            f"archived: {', '.join(source.name for source in residue)}\n"
            f"epoch: {identity['epoch']}\n"
            f"dispatch_sha256: {identity['dispatch_sha256']}\n"
            "reason: the prior task reached a role-releasing status (terminal, "
            "resumable/pipeline-held, post-merge, or pre-work), so its lease no "
            "longer occupies the role cap.\n",
            encoding="utf-8",
        )

    def _interrupted_release_archivals(
        vault_root: Path, claim_key: str, present: "tuple[Path, ...]"
    ) -> "list[tuple[str, Path]]":
        """Receipts whose archival of exactly THIS residue demonstrably did not finish.

        Replaces a lookup that took the first receipt mentioning `claim_key`. **Claim keys are
        `role` and `role-session`, and both are reused across tasks**, so "first receipt with this
        key" can name a different task entirely: after task A archives, task B can be interrupted
        between its epoch and dispatch moves, and a later claim for task C would then read A's
        receipt, archive B's residue under A's lineage, and proceed while B is still claimed. The
        claim key is not an identifier of the archival — it is an identifier of the LANE.

        Two further conditions make a receipt identify the residue in front of us:

        * the receipt's `archived:` list must COVER the sidecars still sitting in the cache — it
          records exactly which files that archival set out to move; and
        * the receipt's own lineage directory must still be MISSING them. A completed archival has
          the files at the destination. Only an interrupted one leaves them at the source.

        Returns every match rather than the first, so the caller can fail closed on ambiguity
        instead of choosing. Nothing here decides; it reports what the evidence supports.

        **Stale receipts accumulate, and the residual risk is a WEDGE, not a wrong sweep.** A
        receipt whose archival later completed into a different lineage directory (the directory
        name carries `observed_at`) keeps satisfying the destination-missing test forever. Review
        raised this as a stale receipt authorising a sweep of a newer live claim. Two things bound
        it, and both are structural rather than assertions about timing:

        * the caller reaches this only when the `cc-active-task` anchor is GONE, so a live claim —
          which by definition has its anchor — is not on this path at all; and
        * receipts are written BEFORE any file moves, so an interrupted archival always leaves its
          own receipt. A stale receipt plus the current one is two matches, and the caller HOLDs on
          more than one rather than choosing.

        So the reachable failure is a HOLD naming the exact files and asking for operator approval,
        which is the direction a fail-closed guard should err in. Recorded rather than mitigated
        further: a third guard for the same hazard is the design smell, and the honest fix if this
        ever wedges in practice is receipt retirement at completion, not more matching rules here.
        """
        lineage_root = vault_root / "_lineage"
        if not lineage_root.is_dir() or not present:
            return []
        present_names = {path.name for path in present}
        present_identity = _residue_identity(present)
        matches: list[tuple[str, Path]] = []
        for receipt in sorted(lineage_root.glob(f"*/released-claim-residue-*/{_RELEASE_RECEIPT}")):
            try:
                text = receipt.read_text(encoding="utf-8")
            except OSError:
                continue
            fields: dict[str, str] = {}
            for line in text.splitlines():
                key, sep, value = line.partition(": ")
                if sep:
                    fields.setdefault(key.strip(), value.strip())
            if fields.get("claim_key") != claim_key:
                continue
            task_id = fields.get("task_id") or ""
            archived = {name.strip() for name in fields.get("archived", "").split(",") if name.strip()}
            if not task_id or not archived:
                continue
            if not present_names <= archived:
                continue
            # **Bind on what the residue IS, not what it is called.** A receipt that recorded
            # the residue's claim epoch / dispatch hash must match the residue in front of us on
            # every field both sides carry; a receipt for an earlier publication of the SAME
            # task by the SAME lane then fails to match instead of sweeping the newer one.
            # A receipt without these fields (pre-identity format) is matched by names only, as
            # before — it can still be caught by the task-id check downstream, never by this.
            identity_mismatch = False
            for field in ("epoch", "dispatch_sha256"):
                recorded = fields.get(field)
                observed = present_identity[field]
                if recorded and recorded != "absent" and observed != "absent" and recorded != observed:
                    identity_mismatch = True
                    break
            if identity_mismatch:
                continue
            lineage_dir = receipt.parent
            if any((lineage_dir / name).exists() for name in present_names):
                continue  # the move completed; this residue is not from this archival
            matches.append((task_id, lineage_dir))
        return matches

    def _archive_released_task_claim_residue(
        *,
        vault_root: Path,
        cache_dir: Path,
        role: str,
        session_id: str,
        current_task_id: str,
        observed_at: str,
    ) -> None:
        """Archive the lease sidecars of a prior task that has released this role.

        The bash role-cap loop above stops *blocking* on a released prior task; it does
        not remove anything. Removal belongs here for three reasons the earlier revision
        got wrong by doing an unlocked ``rm -f`` in bash:

        * this runs inside the Gate-0B claim-publication section, so it cannot race a
          concurrent resume that is publishing role and session projections;
        * it archives into task lineage with a receipt instead of deleting, so a release
          decision stays reconstructable;
        * it fails closed. A sidecar it cannot read, or a partial set it cannot account
          for, HOLDs rather than being swept away — ``rm -f ... || true`` reported success
          after failure and could not tell a clean retirement from a broken one.

        Without this, the bash loop's ``continue`` is not enough: ``claim_paths`` below
        still finds the stale sidecars and ``resolve_applied_claim_publication`` exits 8
        with ``claim_task_mismatch``, so the lane stays blocked one layer deeper.

        **Reachable only on the admitted Gate-0B path, deliberately.** Under
        ``HAPAX_GATE0B_CLAIM_PUBLICATION_OFF=1`` the legacy writer runs instead and no residue is
        archived — because that path takes no role lock, and an unlocked archival is the race
        three review families rejected here. The killswitch is an operator-authorized emergency
        fallback whose own banner says to repair the admitted path and stop using it; giving it a
        lockless copy of this machinery would make the unsafe path the more capable one.

        **If a fail-closed HOLD wedges a lane**, the escape is in the HOLD message itself: it
        names the exact files to archive and says operator approval is required. That is the
        documented bypass — deliberately per-incident and explicit, rather than a standing
        environment flag that would let the guard be switched off wholesale.
        """
        # Scan EVERY session-keyed sidecar for this role, not just this session's.
        #
        # The bash role-cap loop globs `cc-active-task-<role>-*`, so it stops blocking on a
        # released task claimed by any previous session — but this archival only knew about
        # `{role, role-<this session>}`. The lane therefore came free at the cap and then
        # failed at canonical publication with `claim_task_mismatch`, which is the very
        # one-layer-deeper failure this function exists to prevent. Two scans over the same
        # sidecars must not disagree about which ones exist.
        # (claim key, prior task id, residue, lineage dir of an INTERRUPTED archival to resume or None)
        released: list[tuple[str, str, tuple[Path, ...], Path | None]] = []
        claim_keys = {role, f"{role}-{session_id}"}
        # Collect from ALL THREE sidecar patterns, not just `cc-active-task-*`.
        #
        # Keying collection off the active-task file alone made a partial archival PERMANENT:
        # move that one, crash, and on retry the key is invisible — so the epoch and dispatch
        # sidecars are never archived, never removed, and canonical publication mismatches
        # forever. The recovery path was unreachable from exactly the state it existed to
        # recover. All three review families found it together.
        for prefix, suffix in (
            ("cc-active-task-", ""),
            ("cc-claim-epoch-", ""),
            ("cc-claim-dispatch-", ".json"),
        ):
            for sidecar in cache_dir.glob(f"{prefix}{role}*{suffix}"):
                key = sidecar.name[len(prefix) :]
                if suffix:
                    key = key[: -len(suffix)]
                # **The glob has no role boundary; this is the boundary.** `{role}*` matches any
                # role having this one as a PREFIX — collecting `cx-red` also collects
                # `cx-redwood`'s sidecars, which would then be archived while only the `cx-red`
                # publication lock is held, racing a legitimate `cx-redwood` publish or resume.
                # The bash cap above scans the exact role and `role-*` only, so the glob was
                # strictly wider than the thing it feeds. Found by external review.
                #
                # The valid keys are exactly the two minted at the top of this function: the bare
                # role, and `role-<session>`. Anything else belongs to a different lane.
                #
                # **`role-` as a prefix is not a boundary either.** Role names carry hyphens, so
                # for role `cx-red` the sidecars of the legitimate role `cx-red-operator-email`
                # satisfied `startswith("cx-red-")` and could be archived while only the
                # `cx-red` lock was held, racing that lane's publication (codex critical on
                # #4611). The suffix must be a canonical session id — the UUID every launcher
                # mints — not merely something after a hyphen.
                if key != role:
                    # Its own name: this used to be `suffix`, which is the OUTER loop's
                    # filename-extension variable. Reusing it clobbered the extension after the
                    # first session-keyed sidecar, so every later `cc-claim-dispatch-*.json` had
                    # a UUID-length slice cut off its key instead of `.json` — corrupt keys,
                    # excluded from `claim_keys`, and older sessions' claims left usable while a
                    # new claim proceeded (codex critical on #4611).
                    session_suffix = key[len(role) + 1 :] if key.startswith(f"{role}-") else ""
                    if not re.fullmatch(
                        r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",
                        session_suffix,
                    ):
                        continue
                claim_keys.add(key)
        for claim_key in sorted(claim_keys):
            claim_path = cache_dir / f"cc-active-task-{claim_key}"
            siblings = [
                cache_dir / f"cc-claim-epoch-{claim_key}",
                cache_dir / f"cc-claim-dispatch-{claim_key}.json",
            ]
            if not claim_path.exists():
                epoch_path, dispatch_path = siblings
                orphans = [s for s in siblings if s.exists()]
                if not orphans:
                    continue
                # **A bare dispatch sidecar has THREE possible causes, and this was a boolean.**
                #
                # The previous revision read "epoch gone" as proof of a normal close, whose spent
                # dispatch leg `_archive_dispatch_only_claim_residue` legitimately owns. That is
                # true of a normal close and NOT true in general: release archival moves
                # active -> epoch -> dispatch, so a crash between the second and third moves leaves
                # no anchor, no epoch, and a bare dispatch sidecar — a file state IDENTICAL to a
                # normal close. The dispatch-only archiver then rejects `pr_open` and ready-family
                # tasks as non-terminal, so every retry HOLDs and the work is wedged permanently.
                # Two review families found this independently.
                #
                # The states are distinguished by the RECEIPT, which is written before any file
                # moves precisely so the archive is self-describing:
                #
                #   epoch present                      -> crash mid-archival
                #   epoch absent, receipt claims these -> crash AFTER the epoch move
                #   epoch absent, no such receipt      -> normal close; not ours
                #
                # This is not a second mitigation for the hazard the dispatch-only archiver owns:
                # it is the discriminator that decides WHICH hazard is present, and its precondition
                # is machine-checkable at the moment of use rather than asserted about the past.
                interrupted = _interrupted_release_archivals(vault_root, claim_key, tuple(orphans))
                if not epoch_path.exists() and not interrupted:
                    continue
                if len(interrupted) > 1:
                    print(
                        f"cc-claim: HOLD - claim key '{claim_key}' has residue "
                        f"({', '.join(o.name for o in orphans)}) matching "
                        f"{len(interrupted)} unfinished release archivals "
                        f"({', '.join(task for task, _ in interrupted)}). Claim keys are reused "
                        "across tasks, so this cannot be resolved by picking one. Next action: "
                        "inspect those receipts, decide which archival the residue belongs to, "
                        "and with operator approval complete that move by hand before rerunning.",
                        file=sys.stderr,
                    )
                    sys.exit(8)
                # The anchor is gone but residue remains — the signature of a crash mid-archival.
                # Recover the task id from the receipt the previous attempt left, which is why
                # the receipt is now written BEFORE any file moves.
                recovered = interrupted[0][0] if interrupted else None
                # **Bind the residue's own contents to the receipt.** A release can write receipt
                # A, crash before moving, then complete on retry into a different timestamped
                # lineage directory — leaving A eligible forever. A later Gate-0B publication
                # that crashes after writing its epoch/dispatch sidecars but before activation
                # then has A as its sole match, and the NEWER lane's residue would be archived
                # under the OLD task (codex critical on #4611). The sidecars name their task
                # (epoch: "<epoch> <task_id>"; dispatch: `task_id`); if any disagrees with the
                # receipt, identity is ambiguous and this HOLDs rather than choosing.
                if recovered is not None:
                    named = _residue_task_ids(orphans)
                    if named and named != {recovered}:
                        print(
                            f"cc-claim: HOLD - claim key '{claim_key}' residue "
                            f"({', '.join(o.name for o in orphans)}) names task(s) "
                            f"{sorted(named)} but the only matching release receipt names "
                            f"'{recovered}'. The residue is not this receipt's; a newer "
                            "publication may have crashed before activation. Next action: "
                            "inspect the sidecars and the receipt, decide which task owns the "
                            "residue, and with operator approval archive it under that task's "
                            f"lineage in {vault_root}/_lineage/ before rerunning.",
                            file=sys.stderr,
                        )
                        sys.exit(8)
                if recovered is None:
                    print(
                        f"cc-claim: HOLD - claim key '{claim_key}' has residue "
                        f"({', '.join(o.name for o in orphans)}) but no cc-active-task anchor and "
                        "no release receipt naming its task. Next action: inspect those files to "
                        f"identify the task, then with operator approval archive them under "
                        f"{vault_root}/_lineage/<task_id>/ and rerun.",
                        file=sys.stderr,
                    )
                    sys.exit(8)
                # Carry the receipt's OWN lineage directory so the retry completes THAT archival
                # instead of opening a second timestamped one (codex major on #4611: retries
                # split one archival across directories and accumulated stale receipts).
                released.append((claim_key, recovered, tuple(orphans), interrupted[0][1]))
                continue
            try:
                prior_task_id = claim_path.read_text(encoding="utf-8").split("\n", 1)[0].strip()
            except (OSError, UnicodeDecodeError) as exc:
                print(
                    f"cc-claim: HOLD - unreadable claim sidecar {claim_path} ({exc}). "
                    "Next action: inspect the file to recover its task id, then with "
                    "operator approval run the Manual Stale-Lease Release runbook for "
                    f"claim_file='{claim_path}' before retrying.",
                    file=sys.stderr,
                )
                sys.exit(8)
            if not prior_task_id or prior_task_id == current_task_id:
                continue
            prior_status = _task_status_for_any_state(vault_root, prior_task_id)
            if prior_status == "ambiguous":
                # The task has a note in BOTH closed/ and active/. Resolving by directory order
                # read the terminal copy, archived a live claim and admitted another task while
                # the active copy still said `claimed` (codex critical on #4611; 41 such twins
                # measured 2026-09-02). Duplicate identities HOLD; nothing here can adjudicate.
                notes = _task_note_paths_by_state(vault_root, prior_task_id)
                print(
                    f"cc-claim: HOLD - claim sidecar {claim_path} names task "
                    f"'{prior_task_id}', which has a note in BOTH "
                    f"{notes.get('closed')} and {notes.get('active')}. A duplicate identity "
                    "cannot be resolved by directory order. Next action: decide which copy is "
                    "authoritative, mark the other `status: superseded` (or move it out of "
                    "active/) with operator approval, and rerun.",
                    file=sys.stderr,
                )
                sys.exit(8)
            if prior_status == "missing":
                # A sidecar whose task note cannot be found is not evidence that the task
                # released the role — it is an absence of evidence, and skipping it silently
                # leaves a stale projection for a task nobody can adjudicate. Same fail-closed
                # rule as the unreadable sidecar above: refuse, and name the repair.
                epoch_path = cache_dir / f"cc-claim-epoch-{claim_key}"
                dispatch_path = cache_dir / f"cc-claim-dispatch-{claim_key}.json"
                # Self-contained, because a fail-closed HOLD with no executable exit strands
                # the lane permanently — and pointing at a runbook this change neither ships nor
                # updates is not an exit. Same shape as the expired-claim HOLD above, which
                # names its three files.
                print(
                    f"cc-claim: HOLD - claim sidecar {claim_path} names task "
                    f"'{prior_task_id}', which has no note in active/ or closed/, so there is no "
                    "evidence it released this role. Next action: either restore the note at "
                    f"{vault_root}/active/{prior_task_id}.md, or — with operator approval, once "
                    "you have confirmed the task really is gone — archive exactly these three "
                    f"files and rerun: '{claim_path}', '{epoch_path}', '{dispatch_path}'.",
                    file=sys.stderr,
                )
                sys.exit(8)
            if prior_status not in TASK_ROLE_RELEASING_STATUSES:
                continue
            residue = tuple(
                candidate
                for candidate in (
                    claim_path,
                    cache_dir / f"cc-claim-epoch-{claim_key}",
                    cache_dir / f"cc-claim-dispatch-{claim_key}.json",
                )
                if candidate.exists()
            )
            released.append((claim_key, prior_task_id, residue, None))

        if not released:
            return
        lineage_root = vault_root / "_lineage"
        archived: list[str] = []
        for claim_key, prior_task_id, residue, resume_dir in released:
            if resume_dir is not None:
                # Resuming an interrupted archival: its receipt already exists and already names
                # the FULL residue that archival set out to move. Rewriting it here with only
                # what is left would shrink `archived:` — the reduced-receipt hazard review
                # named — so the original receipt stands and only the moves are completed.
                lineage_dir = resume_dir
            else:
                lineage_dir = (
                    lineage_root
                    / _safe_lineage_component(prior_task_id)
                    / (
                        "released-claim-residue-"
                        f"{_safe_lineage_component(observed_at)}-"
                        f"{_safe_lineage_component(claim_key)}"
                    )
                )
            # Idempotent: `exist_ok=False` made a retry after a partial move crash on the
            # directory it had itself created, so the recovery path was the one path that could
            # not run. Each move is individually skippable for the same reason.
            lineage_dir.mkdir(parents=True, exist_ok=True)
            # Receipt FIRST. A crash between moves used to leave files in lineage with nothing
            # saying which task they belonged to — and since the anchor was already gone, no
            # later run could work it out. Written before anything moves, the archive identifies
            # itself from its first instant.
            if resume_dir is None:
                _write_release_receipt(
                    lineage_dir, prior_task_id, claim_key, current_task_id, observed_at, residue
                )
            for source in residue:
                destination = lineage_dir / source.name
                if destination.exists() and not source.exists():
                    # Resumption, not a collision: a previous attempt moved this one and then
                    # died. Anything else — both present, or neither — falls through to the move
                    # so a genuine name clash surfaces instead of being skipped.
                    continue
                # `shutil.move`, not `Path.replace`. The sidecars live on /home and the vault is
                # an NFS mount, so `os.rename` raises EXDEV on EVERY release on this estate —
                # the archival would crash and permanently hold the lane it exists to free.
                # Three review families caught it; my tests did not, because `tmp_path` puts
                # source and destination on one filesystem, so the fixture could not reach the
                # failure.
                shutil.move(str(source), str(destination))
            archived.extend(str(lineage_dir / source.name) for source in residue)
        print(
            "cc-claim: archived released-task claim residue before fresh admitted claim: "
            + ", ".join(archived),
            file=sys.stderr,
        )

    def _archive_dispatch_only_claim_residue(
        *,
        vault_root: Path,
        cache_dir: Path,
        role: str,
        session_id: str,
        current_task_id: str,
        observed_at: str,
    ) -> None:
        keys_to_check: set[str] = {role, f"{role}-{session_id}"}
        role_dispatch = claim_dispatch_binding_path(cache_dir, role)
        if role_dispatch.exists() and not (
            (cache_dir / f"cc-active-task-{role}").exists()
            or (cache_dir / f"cc-claim-epoch-{role}").exists()
        ):
            try:
                role_binding = load_claim_dispatch_binding(role_dispatch)
            except TaskStoreError:
                role_binding = None
            if role_binding is not None:
                keys_to_check.add(f"{role}-{role_binding.session_id}")

        dispatch_only: list[tuple[str, Path, ClaimDispatchBinding]] = []
        for claim_key in sorted(keys_to_check):
            dispatch_path = claim_dispatch_binding_path(cache_dir, claim_key)
            claim_path = cache_dir / f"cc-active-task-{claim_key}"
            epoch_path = cache_dir / f"cc-claim-epoch-{claim_key}"
            if not dispatch_path.exists():
                continue
            if claim_path.exists() or epoch_path.exists():
                continue
            try:
                binding = load_claim_dispatch_binding(dispatch_path)
            except TaskStoreError as exc:
                print(
                    f"cc-claim: HOLD - {exc}. Next action: restore the matching "
                    f"cc-active-task/cc-claim-epoch sidecars for {dispatch_path}, "
                    "or archive this corrupt dispatch-only residue through the "
                    "task lineage before retrying.",
                    file=sys.stderr,
                )
                sys.exit(8)
            if binding.task_id == current_task_id:
                print(
                    "cc-claim: HOLD - current task has dispatch-only claim residue "
                    f"at {dispatch_path}. Next action: restore the matching "
                    "cc-active-task and cc-claim-epoch sidecars for this admitted "
                    "claim, or run admitted recovery before retrying.",
                    file=sys.stderr,
                )
                sys.exit(8)
            if binding.lane != role:
                print(
                    "cc-claim: HOLD - dispatch-only claim residue is bound to a "
                    f"different lane at {dispatch_path}. Next action: preserve the "
                    "sidecar and ask the owning lane/operator to reconcile its "
                    "claim lineage before retrying.",
                    file=sys.stderr,
                )
                sys.exit(8)
            status = _task_status_for_any_state(vault_root, binding.task_id)
            if status not in TASK_TERMINAL_STATUSES:
                print(
                    "cc-claim: HOLD - dispatch-only claim residue belongs to a "
                    f"non-terminal or missing task (task_id={binding.task_id}, "
                    f"status={status}). Next action: restore the matching "
                    "cc-active-task/cc-claim-epoch sidecars or close/release that "
                    "task through the governed lifecycle before retrying.",
                    file=sys.stderr,
                )
                sys.exit(8)
            dispatch_only.append((claim_key, dispatch_path, binding))

        if not dispatch_only:
            return
        lineage_root = vault_root / "_lineage"
        archived: list[str] = []
        for claim_key, dispatch_path, binding in dispatch_only:
            lineage_dir = (
                lineage_root
                / _safe_lineage_component(binding.task_id)
                / (
                    "closed-claim-dispatch-residue-"
                    f"{_safe_lineage_component(observed_at)}-"
                    f"{_safe_lineage_component(claim_key)}"
                )
            )
            # Same idempotency as the released-residue archival above: `exist_ok=False` made
            # a retry crash on the directory the previous attempt created, so the recovery path
            # was the one path that could not run.
            lineage_dir.mkdir(parents=True, exist_ok=True)
            destination = lineage_dir / dispatch_path.name
            if not (destination.exists() and not dispatch_path.exists()):
                # Cross-device safe, for the same reason as the released-residue archival above.
                shutil.move(str(dispatch_path), str(destination))
            (lineage_dir / "README.md").write_text(
                "Archived dispatch-only claim residue before a fresh admitted claim.\n"
                f"task_id: {binding.task_id}\n"
                f"claim_key: {claim_key}\n"
                f"source: {dispatch_path}\n"
                f"archived_at: {observed_at}\n"
                "reason: normal close removed active/epoch sidecars but preserved "
                "the dispatch binding spent leg.\n",
                encoding="utf-8",
            )
            archived.append(str(destination))
        print(
            "cc-claim: archived terminal dispatch-only claim residue before fresh "
            "admitted claim: "
            + ", ".join(archived),
            file=sys.stderr,
        )

    cache_dir.mkdir(parents=True, exist_ok=True)
    gate0b_roots = default_claim_publication_roots(home=Path.home())
    if not dispatch_message_id:
        manual_authority_case = _frontmatter_scalar(text, "authority_case")
        if not manual_authority_case:
            print(
                "cc-claim: HOLD — manual claim binding requires task authority_case. "
                "Next action: repair the task frontmatter with the governed authority_case "
                "or rerun with a complete dispatch-issued HAPAX_CLAIM_DISPATCH_* binding.",
                file=sys.stderr,
            )
            sys.exit(8)
        manual_body = {
            "authority_case": manual_authority_case,
            "lane": role,
            "producer": "scripts/cc-claim",
            "provenance": "manual",
            "schema": "hapax.cc-claim-manual-binding.v1",
            "session_id": session_id,
            "task_id": task_id,
        }
        manual_digest = hashlib.sha256(
            json.dumps(
                manual_body,
                ensure_ascii=True,
                allow_nan=False,
                separators=(",", ":"),
                sort_keys=True,
            ).encode("ascii")
        ).hexdigest()
        dispatch_message_id = f"manual-cc-claim:{manual_digest[:32]}"
        dispatch_binding_hash = manual_digest
        # The execution descriptor stays the installed Gate-0B carrier route;
        # manual provenance is carried by the self-witnessed binding roots.
        dispatch_platform = "codex"
        dispatch_mode = "headless"
        dispatch_profile = "ultra"
        dispatch_authority_case = manual_authority_case
        dispatch_idempotency_key = f"manual-cc-claim:{manual_digest}"
        manual_binding_issued = True
        print(
            "cc-claim: manual claim binding issued "
            f"(provenance=manual, authority_case={manual_authority_case}, "
            f"role={role}, session={session_id}, binding={manual_digest})",
            file=sys.stderr,
        )
    transaction_root = Path(gate0b_roots.claim_transaction_root)
    receipt_root = Path(gate0b_roots.claim_receipt_root)
    lock_root = Path(gate0b_roots.claim_lock_root)
    inspections = inspect_claim_publications(
        cache_dir=cache_dir,
        transaction_root=transaction_root,
        receipt_root=receipt_root,
        task_id=task_id,
    )
    held = [item for item in inspections if item.disposition == "hold"]
    if held:
        try:
            recovered = recover_claim_publications(
                cache_dir=cache_dir,
                transaction_root=transaction_root,
                receipt_root=receipt_root,
                lock_root=lock_root,
                task_id=task_id,
            )
        except ClaimPublicationError as exc:
            print(
                f"cc-claim: HOLD — {exc}. Next action: repair the named recovery root, "
                f"then rerun `cc-claim --recover-claim-publications {task_id}`.",
                file=sys.stderr,
            )
            sys.exit(8)
        inspections = inspect_claim_publications(
            cache_dir=cache_dir,
            transaction_root=transaction_root,
            receipt_root=receipt_root,
            task_id=task_id,
        )
        held = [item for item in inspections if item.disposition == "hold"]
    if held:
        recovered_summary = ""
        if "recovered" in locals() and recovered:
            recovered_summary = " Recovery results: " + ",".join(
                f"{item.publication_id}:{item.state}"
                + (f":{item.reason_code}" if item.reason_code else "")
                for item in recovered
            )
        print(
            "cc-claim: HOLD — claim publication inspection requires reconciliation: "
            + ",".join(f"{item.publication_id}:{item.reason_code}" for item in held)
            + "."
            + recovered_summary
            + f" Next action: run `cc-claim --recover-claim-publications {task_id}` "
            "after repairing the listed journal/projection/receipt path, then rerun cc-claim.",
            file=sys.stderr,
        )
        sys.exit(8)
    claim_keys = (role, f"{role}-{session_id}")
    claim_paths = tuple(
        candidate
        for key in claim_keys
        for candidate in (
            cache_dir / f"cc-active-task-{key}",
            cache_dir / f"cc-claim-epoch-{key}",
            cache_dir / f"cc-claim-dispatch-{key}.json",
        )
    )
    _observed_at = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    # Under the SAME role lock publication uses. Both archivals mutate this role's claim
    # projections, so running them unlocked let a concurrent resume publish role and session
    # projections while this process moved them out from under it — all three review families
    # named it independently. `claim_publication_role_lock` is an accessor for the existing
    # lock, not a second one; a lock only the publication path could take is a lock every other
    # path silently did without.
    try:
        with claim_publication_role_lock(role, lock_root=lock_root):
            _archive_released_task_claim_residue(
                vault_root=path.parent.parent,
                cache_dir=cache_dir,
                role=role,
                session_id=session_id,
                current_task_id=task_id,
                observed_at=_observed_at,
            )
            # BOTH archivals, not just the one the review named. They mutate the same role's
            # projections and differ only in which residue they collect, so locking one and
            # leaving the other is the sibling omission — the adjacent function, at that.
            _archive_dispatch_only_claim_residue(
                vault_root=path.parent.parent,
                cache_dir=cache_dir,
                role=role,
                session_id=session_id,
                current_task_id=task_id,
                observed_at=_observed_at,
            )
    except ClaimPublicationError as exc:
        print(
            f"cc-claim: HOLD — {exc}. Next action: release the stale role claim-publication "
            "lock or retry once the active publisher exits.",
            file=sys.stderr,
        )
        sys.exit(8)
    claim_paths = tuple(candidate for candidate in claim_paths if candidate.exists())
    if any(candidate.exists() for candidate in claim_paths):
        try:
            applied = resolve_applied_claim_publication(
                vault_root=path.parent.parent,
                cache_dir=cache_dir,
                role=role,
                session_id=session_id,
                task_id=task_id,
                transaction_root=transaction_root,
                receipt_root=receipt_root,
                lock_root=lock_root,
            )
        except ClaimPublicationError as exc:
            print(
                f"cc-claim: HOLD — {exc}. Next action: follow the repair action above, "
                "then rerun cc-claim.",
                file=sys.stderr,
            )
            sys.exit(8)
        binding = applied.intent.binding
        expected_dispatch = {
            "task_id": task_id,
            "lane": role,
            "session_id": session_id,
            "dispatch_message_id": dispatch_message_id,
            "platform": dispatch_platform,
            "mode": dispatch_mode,
            "profile": dispatch_profile,
            "authority_case": dispatch_authority_case,
            "binding_hash": dispatch_binding_hash,
            "coord_dispatch_idempotency_key": dispatch_idempotency_key or None,
        }
        observed_dispatch = {key: getattr(binding, key) for key in expected_dispatch}
        if observed_dispatch != expected_dispatch:
            print(
                "cc-claim: HOLD — existing applied claim belongs to a different dispatch "
                "vector. Next action: rerun with the original dispatch binding for this "
                "applied claim, or close/release the current claim before a new dispatch "
                "claims the task.",
                file=sys.stderr,
            )
            sys.exit(8)
        if (
            applied.admission_consumption is None
            or applied.admission_consumption.to_record().get("schema")
            != "hapax.claim-admission-consumption.v2"
        ):
            print(
                "cc-claim: HOLD — execution_admission_prerequisites_unavailable: "
                "the existing claim is not backed by an active five-proof "
                "ClaimAdmissionConsumption. Next action: recover/re-publish this claim "
                "through the Gate-0B admitted path, or close/release the existing claim "
                "before retrying.",
                file=sys.stderr,
            )
            sys.exit(8)
        print(
            f"cc-claim: applied publication already owns task '{task_id}' for role '{role}' "
            f"(receipt={applied.receipt.receipt_hash})"
        )
        sys.exit(0)

if not text.startswith("---") or text.find("\n---", 4) < 0:
    print(
        f"cc-claim: FATAL — task note {path} has no closing frontmatter "
        "delimiter; next action: repair the note (restore the opening and "
        "closing '---' lines), then re-run cc-claim. No claim caches were written.",
        file=sys.stderr,
    )
    sys.exit(6)
frontmatter = frontmatter_from_text(text)
now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _strip_scalar(value: str) -> str:
    return value.strip().strip('"').strip("'")


_YAML_NULLS = frozenset({"", "null", "none", "~", "[]"})


def _is_claimable_assignee(value: str) -> bool:
    stripped = _strip_scalar(value)
    return stripped == "unassigned" or stripped.lower() in _YAML_NULLS


# Canonical SSOT: a lane may resume an owned task in any merge-ready state, not
# just pr_open/merge_queue (shared/sdlc_lifecycle.py TASK_RESUMABLE_STATUSES).
READY_STATUSES = TASK_RESUMABLE_STATUSES


status_match = re.search(r"^status:\s*(\S+)$", text, flags=re.MULTILINE)
status = status_match.group(1) if status_match else "offered"
assigned_match = re.search(r"^assigned_to:[ \t]*(.*)$", text, flags=re.MULTILINE)
assigned_raw = assigned_match.group(1) if assigned_match else "unassigned"
assigned_to = _strip_scalar(assigned_raw)

if status in TASK_CLAIMABLE_STATUSES:
    if assigned_match and not _is_claimable_assignee(assigned_raw):
        print(
            f"cc-claim: refusing to claim '{task_id}' — already assigned to '{assigned_to}'. "
            "Next action: ask the assigned lane/operator to release it or claim a different "
            "offered task.",
            file=sys.stderr,
        )
        sys.exit(4)
    claim_mode = "claim"
elif status in READY_STATUSES:
    if _is_claimable_assignee(assigned_raw):
        print(
            f"cc-claim: refusing to resume '{task_id}' — ready-state task is not assigned to "
            f"'{role}'. Next action: restore assigned_to: {role} if this lane owns the PR "
            "follow-up, or claim a different offered task.",
            file=sys.stderr,
        )
        sys.exit(4)
    if assigned_to != role:
        print(
            f"cc-claim: refusing to resume '{task_id}' — assigned to '{assigned_to}', not "
            f"'{role}'. Next action: hand off to {assigned_to}, ask the operator to reassign "
            "the task, or claim a task assigned to this lane.",
            file=sys.stderr,
        )
        sys.exit(4)
    claim_mode = "resume"
else:
    detail = ""
    if status == "blocked":
        detail_parts: list[str] = []
        reason = blocked_reason_from_frontmatter(frontmatter)
        witness = blocked_witness_from_frontmatter(frontmatter)
        detail_parts.append(f"blocked_reason: {reason or 'missing'}")
        if witness:
            detail_parts.append(f"blocked_witness: {witness}")
        detail = " (" + "; ".join(detail_parts) + ")"
    print(
        f"cc-claim: refusing to claim '{task_id}' — current status is '{status}'{detail}, "
        "not 'offered' or an assigned ready state. Next action: move the task through "
        "the governed lifecycle to an offered or assigned ready state, then rerun cc-claim.",
        file=sys.stderr,
    )
    sys.exit(4)


def _stamp_resumed_marker(
    cache_dir: Path, role: str, session_id: str, task_id: str, mode: str
) -> None:
    """Record, next to the claim anchor, whether this publication is a RESUME.

    A resumed task keeps its pipeline status (`pr_open`, `merge_queue`, `ready`, …) by design,
    while a worker is again holding the lane. The status alone therefore cannot tell
    "finished, waiting on the pipeline" (lane free) from "resumed and worker-held" (lane busy),
    and the bash role-cap loop had only the status to go on — it released a freshly resumed
    lane to a second session (codex critical on #4611). The marker is the missing third value.

    Shape: `cc-claim-resumed-<claim key>`, single line, the task id — so a stale marker for a
    different task under a reused key is inert (the cap loop compares it to the anchor's task),
    and the anchor stays single-line for the consumers that read its whole content as the id.
    A non-resume claim REMOVES the marker for its keys, so a resume never outlives the claim
    that follows it. Written after publication, so a failed publication leaves no marker.
    """
    keys = (role, f"{role}-{session_id}") if session_id else (role,)
    for key in keys:
        marker = cache_dir / f"cc-claim-resumed-{key}"
        if mode == "resume":
            marker.write_text(f"{task_id}\n", encoding="utf-8")
        else:
            marker.unlink(missing_ok=True)


def _frontmatter_lines(note_text: str) -> list[str]:
    if not note_text.startswith("---"):
        return []
    end = note_text.find("\n---", 4)
    if end < 0:
        return []
    return note_text[4:end].splitlines()


def _parse_inline_list(value: str) -> list[str]:
    value = value.strip()
    if value == "[]":
        return []
    if _strip_scalar(value).lower() in _YAML_NULLS:
        return []
    if not (value.startswith("[") and value.endswith("]")):
        return [_strip_scalar(value)] if value else []
    inner = value[1:-1].strip()
    if not inner:
        return []
    return [_strip_scalar(item) for item in inner.split(",") if _strip_scalar(item)]


def _parse_depends_on(note_text: str) -> list[str]:
    lines = _frontmatter_lines(note_text)
    for idx, line in enumerate(lines):
        stripped = line.strip()
        if not stripped.startswith("depends_on:"):
            continue
        value = stripped.split(":", 1)[1].strip()
        if value:
            return _parse_inline_list(value)

        deps: list[str] = []
        for child in lines[idx + 1 :]:
            child_stripped = child.strip()
            if not child_stripped:
                continue
            if child_stripped.startswith("- "):
                dep_id = _strip_scalar(child_stripped[2:])
                if dep_id:
                    deps.append(dep_id)
                continue
            break
        return deps
    return []


def _parse_frontmatter(note_text: str) -> dict[str, str | list[str]]:
    fields: dict[str, str | list[str]] = {}
    lines = _frontmatter_lines(note_text)
    idx = 0
    while idx < len(lines):
        line = lines[idx]
        stripped = line.strip()
        idx += 1
        if not stripped or stripped.startswith("#") or ":" not in stripped:
            continue
        key, raw_value = stripped.split(":", 1)
        key = key.strip()
        value = raw_value.strip()
        if value:
            if value.startswith("[") and value.endswith("]"):
                fields[key] = _parse_inline_list(value)
            else:
                fields[key] = _strip_scalar(value)
            continue

        items: list[str] = []
        while idx < len(lines):
            child = lines[idx].strip()
            if not child:
                idx += 1
                continue
            if child.startswith("- "):
                item = _strip_scalar(child[2:])
                if item:
                    items.append(item)
                idx += 1
                continue
            break
        fields[key] = items
    return fields


def _field_tokens(value: str | list[str] | None) -> set[str]:
    if value is None:
        return set()
    if isinstance(value, list):
        raw_values = value
    else:
        raw_values = _parse_inline_list(value) if value.startswith("[") else [value]
    tokens: set[str] = set()
    for raw in raw_values:
        token = _strip_scalar(str(raw)).lower().replace("_", "-")
        if token:
            tokens.add(token)
    return tokens


def _is_nullish(value: str | list[str] | None) -> bool:
    if value is None:
        return True
    if isinstance(value, list):
        return len(value) == 0
    return _strip_scalar(value).lower() in ("", "null", "none", "~", "[]")


def _is_authority_exempt(fields: dict[str, str | list[str]]) -> bool:
    tokens: set[str] = set()
    for key in ("kind", "task_type", "work_type", "tier", "tags"):
        tokens.update(_field_tokens(fields.get(key)))

    mutation_tokens = {
        "build",
        "bugfix",
        "code",
        "deploy",
        "feature",
        "fix",
        "implementation",
        "mutation",
        "release",
        "runtime",
        "source",
        "systemd",
    }
    if tokens & mutation_tokens:
        return False

    non_mutating_tokens = {
        "audit",
        "intake",
        "operator_action",
        "planning",
        "plan",
        "read-only",
        "readonly",
        "research",
        "triage",
        "validation",
        "validation-demo",
    }
    return bool(tokens & non_mutating_tokens)


fields = _parse_frontmatter(text)
missing_authority_fields: list[str] = []
if not _is_authority_exempt(fields):
    if _is_nullish(fields.get("authority_case")):
        missing_authority_fields.append("authority_case")
    if all(
        _is_nullish(fields.get(k))
        for k in ("parent_spec", "parent_plan", "parent_request")
    ):
        missing_authority_fields.append("parent_spec (or parent_plan/parent_request)")

if missing_authority_fields:
    print(
        f"cc-claim: BLOCKED — task '{task_id}' is missing required AuthorityCase/ISAP fields: "
        + ", ".join(missing_authority_fields),
        file=sys.stderr,
    )
    print(
        "Implementation/build/runtime tasks must have non-null authority_case and parent_spec before claim.",
        file=sys.stderr,
    )
    print(
        "Next action: add the governed authority_case and parent_spec, or use an explicitly "
        "read-only intake/planning task for pre-authorization work.",
        file=sys.stderr,
    )
    sys.exit(6)


def _locate_task(vault_root: Path, dep_id: str) -> Path | None:
    for subdir in ("closed", "active"):
        root = vault_root / subdir
        exact = root / f"{dep_id}.md"
        if exact.is_file():
            return exact
        for candidate in root.glob(f"{dep_id}-*.md"):
            if candidate.is_file():
                return candidate
    return None


def _frontmatter_status(note_text: str) -> str:
    match = re.search(r"^status:\s*(\S+)$", note_text, flags=re.MULTILINE)
    return match.group(1) if match else "unknown"


vault_root = path.parent.parent
DEFAULT_PR_REPO = "hapax-systems/hapax-council"


def _parse_pr_number(note_text: str) -> str | None:
    """Extract PR number from frontmatter pr: field."""
    match = re.search(r"^pr:\s*(\S+)$", note_text, flags=re.MULTILINE)
    if not match:
        return None
    val = match.group(1).strip().strip("\x27\x22")
    if val.lower() in ("null", "none", "~", ""):
        return None
    # Strip leading # if present
    return val.lstrip("#")


def _parse_pr_repo(note_text: str) -> str:
    """Extract PR repository from frontmatter pr_repo: field."""
    match = re.search(r"^pr_repo:\s*(\S+)$", note_text, flags=re.MULTILINE)
    if not match:
        return DEFAULT_PR_REPO
    val = match.group(1).strip().strip("\x27\x22")
    if val.lower() in ("null", "none", "~", ""):
        return DEFAULT_PR_REPO
    return val


def _check_pr_merged(pr_number: str, repo: str = DEFAULT_PR_REPO) -> str:
    """Check PR merge status via gh CLI. Returns merged|open|closed|unknown."""
    import subprocess
    try:
        cwd = Path.home() / "projects" / "hapax-council"
        run_kwargs = {"cwd": str(cwd)} if cwd.is_dir() else {}
        result = subprocess.run(
            [
                "gh",
                "pr",
                "view",
                pr_number,
                "--repo",
                repo,
                "--json",
                "state,mergedAt",
                "--jq",
                '.state + "," + ((.mergedAt != null and .mergedAt != "") | tostring)',
            ],
            capture_output=True, text=True, timeout=15,
            **run_kwargs,
        )
        if result.returncode != 0:
            return "unknown"
        parts = result.stdout.strip().split(",")
        if len(parts) == 2 and parts[1] == "true":
            return "merged"
        if parts[0] == "OPEN":
            return "open"
        if parts[0] == "CLOSED":
            return "closed_unmerged"
        return "unknown"
    except Exception:
        return "unknown"


def _insert_session_log(note_text: str, log_line: str) -> str:
    heading = re.search(
        r"^## Session [Ll]og[ \t]*(?:\n|$)", note_text, flags=re.MULTILINE
    )
    if heading:
        prefix = note_text[: heading.end()]
        suffix = note_text[heading.end() :]
        if not prefix.endswith("\n"):
            prefix = f"{prefix}\n"
        return f"{prefix}{log_line}{suffix}"
    return f"{note_text.rstrip()}\n\n## Session log\n{log_line}"


unmet: list[str] = []
if claim_mode == "claim":
    for dep_id in _parse_depends_on(text):
        dep_path = _locate_task(vault_root, dep_id)
        if dep_path is None:
            unmet.append(f"{dep_id} (not found in vault)")
            continue
        dep_text = dep_path.read_text(encoding="utf-8")
        dep_pr_repo = _parse_pr_repo(dep_text)
        validity = task_closure_validity(
            dep_text,
            pr_state_lookup=lambda pr_number, repo=dep_pr_repo: _check_pr_merged(
                pr_number,
                repo,
            ),
            require_route_metadata_validity=True,
        )
        if not validity.valid:
            unmet.append(f"{dep_id} ({'; '.join(validity.blockers)})")

if unmet:
    print(f"cc-claim: BLOCKED — task '{task_id}' has unmet dependencies:", file=sys.stderr)
    for item in unmet:
        print(f"  - {item}", file=sys.stderr)
    print("\nNext action: resolve dependencies before claiming this task.", file=sys.stderr)
    sys.exit(5)

if claim_mode == "claim":
    # A note authored without the full claim key set makes plain re.sub
    # stamps silent no-ops: the claim lands as `status: claimed` with
    # claimed_at absent — exactly the cc-hygiene H1 ghost predicate — and H1
    # reverts the fresh claim out from under the live lane (2026-07-01
    # eta/ndcvb-phase1 incident). Stamp, insert, and verify STRICTLY inside
    # the frontmatter slice: a column-0 `claimed_at:`/`status:` line in the
    # note BODY (quoted frontmatter in a session log, an annex) must neither
    # absorb the stamp nor satisfy the verification.
    _fm_end = text.find("\n---", 4)
    if _fm_end < 0:
        print(
            f"cc-claim: FATAL — task note {path} has no closing frontmatter "
            "delimiter; next action: repair the note (restore the closing "
            "'---' line), then re-run cc-claim. No claim caches were written.",
            file=sys.stderr,
        )
        sys.exit(6)
    _front, _rest = text[:_fm_end], text[_fm_end:]
    _front = re.sub(r"^status:.*$", "status: claimed", _front, count=1, flags=re.MULTILINE)
    _front = re.sub(
        r"^assigned_to:.*$", f"assigned_to: {role}", _front, count=1, flags=re.MULTILINE
    )
    _front = re.sub(
        r"^claimed_at:.*$", f"claimed_at: {now}", _front, count=1, flags=re.MULTILINE
    )
    _required_stamp = {
        "status": "claimed",
        "assigned_to": role,
        "claimed_at": now,
    }
    # Duplicate claim keys are fail-closed: re.sub(count=1) stamps only the
    # FIRST occurrence while YAML consumers (cc-hygiene) treat the LAST as
    # authoritative — a later duplicate `claimed_at: null` would pass the
    # verification below yet leave the note effectively ghost-claimable.
    _dupes = [
        _key
        for _key in _required_stamp
        if len(re.findall(rf"^{_key}:", _front, flags=re.MULTILINE)) > 1
    ]
    if _dupes:
        print(
            f"cc-claim: FATAL — duplicate frontmatter keys {_dupes} in {path}; "
            "next action: remove the duplicate lines (one occurrence per key), "
            "then re-run cc-claim. No claim caches were written.",
            file=sys.stderr,
        )
        sys.exit(6)
    for _key, _value in _required_stamp.items():
        if not re.search(rf"^{_key}:", _front, flags=re.MULTILINE):
            _front = f"{_front}\n{_key}: {_value}"
    _unstamped = [
        _key
        for _key, _value in _required_stamp.items()
        if not re.search(
            rf"^{_key}:\s*{re.escape(str(_value))}\s*$", _front, flags=re.MULTILINE
        )
    ]
    if _unstamped:
        print(
            f"cc-claim: FATAL — claim stamp did not land for {_unstamped} in {path}; "
            "refusing to write claim caches over a ghost-claimable note. Next "
            "action: repair the note frontmatter (each key must be a "
            "single-line scalar), then re-run cc-claim. No claim caches were "
            "written; nothing to roll back.",
            file=sys.stderr,
        )
        sys.exit(6)
    text = _front + _rest
    session_suffix = f", session={session_id}" if session_id else ""
    log_line = f"- {now} {role} claimed (cc-claim{session_suffix})\n"
    result_message = f"cc-claim: claimed task '{task_id}' for role '{role}'"
else:
    session_suffix = f", session={session_id}" if session_id else ""
    log_line = f"- {now} {role} resumed ready-state task (cc-claim{session_suffix})\n"
    result_message = f"cc-claim: resumed task '{task_id}' for role '{role}'"

text = re.sub(
    r"^updated_at:.*$", f"updated_at: {now}", text, count=1, flags=re.MULTILINE
)
text = _insert_session_log(text, log_line)

if not canon_enforced:
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    tmp.replace(path)
    cache_dir.mkdir(parents=True, exist_ok=True)
    # The `cc-claim-epoch-*` SIDECAR records the claim time out-of-band:
    # several consumers read the claim file's FULL content as the task id, so
    # the id file must stay single-line.
    (cache_dir / f"cc-claim-epoch-{role}").write_text(
        f"{claim_epoch} {task_id}\n",
        encoding="utf-8",
    )
    # Legacy role-keyed file: read by cc-close, session-context, the
    # coordinator, the coordination TUI, and other consumers outside this
    # slice's scope.
    (cache_dir / f"cc-active-task-{role}").write_text(
        f"{task_id}\n",
        encoding="utf-8",
    )
    if session_id:
        (cache_dir / f"cc-claim-epoch-{role}-{session_id}").write_text(
            f"{claim_epoch} {task_id}\n",
            encoding="utf-8",
        )
        (cache_dir / f"cc-active-task-{role}-{session_id}").write_text(
            f"{task_id}\n",
            encoding="utf-8",
        )
        print(result_message)
        print(
            f"cc-claim: wrote {cache_dir / f'cc-active-task-{role}-{session_id}'} "
            f"(+ legacy cc-active-task-{role})"
        )
    else:
        print(result_message)
        print(f"cc-claim: wrote ~/.cache/hapax/cc-active-task-{role}")
    _stamp_resumed_marker(cache_dir, role, session_id, task_id, claim_mode)
    sys.exit(0)

try:
    snapshot = resolve_task_note(
        path.parent.parent,
        task_id,
        state="active",
        require_no_other_state=True,
    )
    if snapshot.path != path.resolve() or snapshot.content != note_before:
        raise TaskStoreError(
            "claim_publication_task_changed_during_preflight",
            "reload the exact active task and repeat claim eligibility checks",
            task_id,
        )
    binding = ClaimDispatchBinding.create(
        task_id=task_id,
        lane=role,
        session_id=session_id,
        claim_epoch=claim_epoch,
        dispatch_message_id=dispatch_message_id,
        platform=dispatch_platform,
        mode=dispatch_mode,
        profile=dispatch_profile,
        authority_case=dispatch_authority_case,
        binding_hash=dispatch_binding_hash,
        coord_dispatch_idempotency_key=dispatch_idempotency_key or None,
    )
    intent = ClaimPublicationIntent.create(
        task=snapshot,
        cache_dir=cache_dir,
        note_after=text.encode("utf-8"),
        binding=binding,
    )
except (ClaimPublicationError, TaskStoreError) as exc:
    print(
        f"cc-claim: HOLD — {exc}. Next action: follow the repair action above, "
        "then rerun cc-claim.",
        file=sys.stderr,
    )
    sys.exit(8)

try:
    try:
        install = load_claim_publication_composition(Path(gate0b_roots.invocation_store_root))
    except ExecutionAdmissionError as exc:
        if exc.reason_code not in {
            "gate0b_install_receipt_missing",
            "gate0b_install_manifest_missing",
        }:
            raise
        install = install_claim_publication_composition(
            roots=gate0b_roots,
            installed_at=now,
            install_task_ref="cc-task-gate0b-slice1b-cc-claim-reland-20260809",
        )
        print(
            "cc-claim: Gate-0B claim-publication root installed for first use "
            f"(receipt={install.receipt.receipt_ref}). Next action: if a later claim "
            "holds on install mismatch or corrupt receipt state, repair or quarantine "
            "the existing receipt/manifest; cc-claim will not overwrite non-matching "
            "install artifacts.",
            file=sys.stderr,
        )
    receipt = publish_gate0b_claim(intent, root=install.root, now=now)
except (ClaimPublicationError, ExecutionAdmissionError, TaskStoreError, ValueError) as exc:
    print(
        f"cc-claim: HOLD — {exc}; Next action: provision or repair the Gate-0B "
        "claim-publication composition receipt for this HOME through the governed "
        "install step, then rerun cc-claim; do not use HAPAX_GATE0B_CLAIM_PUBLICATION_OFF "
        f"unless the operator authorizes emergency fallback; prepared_intent={intent.intent_ref}",
        file=sys.stderr,
    )
    sys.exit(8)

print(result_message)
if manual_binding_issued:
    print("cc-claim: claim binding provenance=manual")
print(
    "cc-claim: admitted publication applied "
    f"(publication={receipt.publication_id}, receipt={receipt.receipt_hash})"
)
_stamp_resumed_marker(cache_dir, role, session_id, task_id, claim_mode)
PYEOF

exit 0
