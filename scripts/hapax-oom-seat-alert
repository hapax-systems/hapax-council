#!/usr/bin/python3
"""Deliver a failed OOM policy audit to the coordinator seat's existing inbox."""

from __future__ import annotations

import json
import os
import re
import socket
import subprocess
import sys
import uuid
from datetime import UTC, datetime
from pathlib import Path

UNIT = "hapax-oom-policy-audit.service"
AUDIT = Path("/usr/local/sbin/hapax-oom-policy-audit")
BOOT_ID = Path("/proc/sys/kernel/random/boot_id")
INSTALLED = Path("/usr/local/sbin/hapax-oom-seat-alert")
TASK = "cc-task-oom-policy-per-host-parameterization-20260809"


def _short(value: object) -> str:
    return " ".join(str(value).split())[:200]


def _test_inputs() -> tuple[Path, Path]:
    names = ("HAPAX_OOM_SEAT_ALERT_TEST_MODE", "HAPAX_OOM_SEAT_ALERT_BOOT_ID_PATH", "HAPAX_OOM_SEAT_ALERT_AUDIT")
    selected = [name for name in names if name in os.environ]
    installed = Path(__file__).resolve() == INSTALLED
    if installed and selected:
        raise ValueError("installed seat alert refuses test selectors")
    if selected and os.environ.get("HAPAX_OOM_SEAT_ALERT_TEST_MODE") != "1":
        raise ValueError("source seat alert test selectors require TEST_MODE=1")
    if os.environ.get("HAPAX_OOM_SEAT_ALERT_TEST_MODE") == "1":
        return (
            Path(os.environ.get("HAPAX_OOM_SEAT_ALERT_BOOT_ID_PATH", BOOT_ID)),
            Path(os.environ.get("HAPAX_OOM_SEAT_ALERT_AUDIT", AUDIT)),
        )
    return BOOT_ID, AUDIT


def _vault() -> Path:
    raw = os.environ.get("PERSONAL_VAULT_PATH", "").strip()
    value = Path(raw).expanduser() if raw else Path.home() / "Documents" / "Personal"
    if not value.is_absolute() or not value.is_dir():
        raise ValueError(f"personal vault is unavailable: {value}")
    return value


def _failing_checks(audit: Path) -> tuple[int | str, list[str]]:
    try:
        result = subprocess.run(
            [str(audit), "--json"],
            text=True,
            capture_output=True,
            timeout=25,
            check=False,
            env={"PATH": "/usr/local/sbin:/usr/local/bin:/usr/bin:/bin", "HOME": str(Path.home())},
        )
        payload = json.loads(result.stdout)
        checks = payload.get("checks", [])
        if not isinstance(checks, list):
            raise ValueError("checks is not a list")
        failed = [
            f"- {_short(item.get('name'))}: actual={_short(item.get('actual'))}; target={_short(item.get('target'))}"
            for item in checks
            if isinstance(item, dict) and item.get("status") in {"gap", "error"}
        ]
        return result.returncode, failed[:20] or ["- Recheck returned no failing checks; inspect the unit journal."]
    except (OSError, subprocess.TimeoutExpired, ValueError, json.JSONDecodeError) as exc:
        return "unavailable", [f"- Recheck unavailable: {_short(exc)}; inspect the unit journal."]


def main(argv: list[str]) -> int:
    if argv != [UNIT]:
        print(f"refusing unrelated unit: {argv!r}", file=sys.stderr)
        return 2
    try:
        boot_path, audit_path = _test_inputs()
        boot = boot_path.read_text(encoding="ascii").strip()
        if not re.fullmatch(r"[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}", boot):
            raise ValueError("boot ID is absent or invalid")
        host = socket.gethostname()
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,62}", host):
            raise ValueError("canonical hostname is unsafe")
        seat = _vault() / "30-areas" / "hapax" / "lanebus" / "dev1"
        if not seat.is_dir():
            raise ValueError(f"seat inbox is absent: {seat}")
        target = seat / f"oom-policy-audit-failure-{host}-{boot}.md"
        if target.exists():
            print(f"already delivered: {target}")
            return 0
        recheck_exit, failed = _failing_checks(audit_path)
        now = datetime.now(UTC).isoformat()
        body = (
            f"# OOM policy audit failed on {host}\n\n"
            f"Unit: `{UNIT}`  \nBoot: `{boot}`  \nObserved: `{now}`  \n"
            f"Recheck exit: `{recheck_exit}`  \nTask: `{TASK}`\n\n"
            "## Failing checks\n\n" + "\n".join(failed) + "\n\n"
            f"Inspect `journalctl --user -u {UNIT}` on {host}; repair through the governed OOM installer.\n"
        )
        temporary = seat / f".{target.name}.{uuid.uuid4().hex}.tmp"
        try:
            with temporary.open("x", encoding="utf-8") as handle:
                handle.write(body)
                handle.flush()
                os.fsync(handle.fileno())
            try:
                os.link(temporary, target)
            except FileExistsError:
                pass
        finally:
            temporary.unlink(missing_ok=True)
        print(f"delivered: {target}")
        return 0
    except (OSError, ValueError) as exc:
        print(f"OOM seat alert refused: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
