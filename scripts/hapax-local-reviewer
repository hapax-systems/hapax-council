#!/usr/bin/env python3
"""Local-fleet substitute reviewer seat for the review-team registry (read-only, $0).

Sends the dispatcher's prompt to the fleet's OpenAI-compatible endpoint (vLLM on spark-01df,
model qwen3.8-flash-next, 262 k context) as one chat completion, with no tools. An
unreachable or failing endpoint is a route outage, never a reply.

Measured 2026-09-24: reliable, but twice its verdict line contradicted its own text. The
dispatcher does not trust the verdict line alone: a named critical blocks whatever the verdict
says, and synthesize_dossier escalates verdict-contradicts-findings.
"""

from __future__ import annotations

import importlib.util
import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

_local_source = Path(__file__).resolve().parents[1]
SOURCE_ROOT = Path(
    os.environ.get("HAPAX_SOURCE_ACTIVATE_WORKTREE")
    or os.environ.get("HAPAX_COUNCIL_DIR")
    or (
        _local_source
        if (_local_source / "config/agent-instructions/AGENTS.md").is_file()
        else Path.home() / ".cache/hapax/source-activation/worktree"
    )
).resolve()
if str(SOURCE_ROOT) not in sys.path:
    sys.path.insert(0, str(SOURCE_ROOT))

from shared.review_seat_wrapper import SEAT_PREAMBLE, refuse  # noqa: E402

WRAPPER = "hapax-local-reviewer"
DEFAULT_BASE_URL = "http://spark-01df:8000/v1"
DEFAULT_MODEL = "qwen3.8-flash-next"
MAX_OUTPUT_TOKENS = 8192
TIMEOUT_SECONDS = 900


def _canonical_body() -> str:
    path = SOURCE_ROOT / "shared/canonical_instruction_ingestion.py"
    spec = importlib.util.spec_from_file_location("hapax_local_instruction_ingestion", path)
    if spec is None or spec.loader is None:
        raise ValueError("canonical instruction resolver is unavailable")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module.read_canonical_instructions(source_root=SOURCE_ROOT).body.decode("utf-8")


def request_body(prompt: str, model: str, canonical_body: str) -> dict:
    return {
        "model": model,
        "messages": [
            {"role": "system", "content": canonical_body + "\n\n" + SEAT_PREAMBLE},
            {"role": "user", "content": prompt},
        ],
        "temperature": 0,
        "max_tokens": MAX_OUTPUT_TOKENS,
    }


def main() -> int:
    prompt = sys.stdin.read()
    if not prompt.strip():
        return refuse(WRAPPER, "empty prompt on stdin; the dispatcher sends the review prompt")
    try:
        canonical_body = _canonical_body()
    except (OSError, ValueError) as exc:
        return refuse(WRAPPER, f"canonical instruction admission refused ({exc})")
    base_url = os.environ.get("HAPAX_LOCAL_REVIEW_BASE_URL", DEFAULT_BASE_URL).rstrip("/")
    model = os.environ.get("HAPAX_LOCAL_REVIEW_MODEL", DEFAULT_MODEL)
    request = urllib.request.Request(
        f"{base_url}/chat/completions",
        data=json.dumps(request_body(prompt, model, canonical_body)).encode("utf-8"),
        headers={"content-type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT_SECONDS) as response:
            payload = json.loads(response.read().decode("utf-8"))
    except (urllib.error.URLError, TimeoutError, OSError, ValueError) as exc:
        return refuse(
            WRAPPER,
            f"local review endpoint {base_url} unavailable ({type(exc).__name__}); "
            "check the fleet's vLLM service",
        )
    try:
        choice = payload["choices"][0]
        content = choice["message"]["content"] or ""
    except (KeyError, IndexError, TypeError):
        return refuse(WRAPPER, "local review endpoint returned no choices; check the model id")
    if choice.get("finish_reason") == "length":
        return refuse(WRAPPER, f"reply truncated at {MAX_OUTPUT_TOKENS} tokens; not a review")
    sys.stdout.write(content)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
