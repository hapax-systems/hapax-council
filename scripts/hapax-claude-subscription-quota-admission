#!/usr/bin/env python3
"""Write Claude subscription-quota admission receipts from an account-live observation.

The command records a short-lived, sanitized observation that a Claude receipt-bounded route has
fresh account-live subscription quota. It is patterned after
``scripts/hapax-agy-quota-admission`` / ``scripts/hapax-glmcp-quota-admission``: positive receipts
are consumed by ``scripts/hapax-quota-telemetry-writer`` before that route is treated as
quota-fresh.

Account-live subscription quota is NOT mechanically observable yet (Claude Code OTel usage/cost
integration is incomplete — CASE-CAPACITY-ROUTING-001 R2, "use receipts and manual refresh until
observable"). So this writer records an OPERATOR / governed-probe attestation of a bounded
account-live observation (an evidence ref naming what was observed), NEVER a live Claude smoke
(no runtime side effect, no provider spend) and NEVER lane/tmux/session presence. It persists no
secret value and no prompt/response content, and the receipt is short-lived so it cannot stand as
stale evidence. Fail-closed: an unsafe/invalid observation exits non-zero and writes nothing, so the
route stays held.

The account-live probe's own reply does carry the subscription's five-hour and seven-day
utilization. When the scrubbed probe passes those windows, the receipt keeps them as
``<window>_used_percent`` and ``<window>_resets_at`` beside the admission bit. The numbers never
change admission; they are the quantity the quota ledger reads.

A route the registry binds to one subscription pool (``subscription_pool_binding``; today
claude.review.opus -> max-2) mints only from that pool's own chain: the config dir the reading ran
under (CLAUDE_CONFIG_DIR), the receipt dir, the pace traces, marker and durable sink must all be the
pool's. Its receipt then carries ``pool:`` and ``-pool-<pool>-`` in its name, so the ledger's
evidence reference names the pool. Anything else exits 2 and writes nothing.
"""

from __future__ import annotations

import argparse
import math
import os
import re
import sys
import tempfile
from collections.abc import Mapping
from datetime import UTC, datetime
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

DEFAULT_RECEIPT_DIR = Path(
    os.environ.get(
        "HAPAX_RELAY_RECEIPT_DIR",
        str(Path.home() / ".cache/hapax/relay/receipts"),
    )
)

ADMISSION_SCHEMA = "hapax.claude_quota_admission.v1"
PROVIDER = "anthropic-claude-subscription"
DEFAULT_ROUTE_ID = "claude.headless.full"
ALLOWED_ROUTE_IDS = ("claude.headless.full", "claude.review.opus", "claude.interactive.full")
CAPACITY_POOL = "subscription_quota"
AUTH_SURFACE = "subscription"
BILLING_MODE = "operator_session_subscription"
SECRET_SOURCE = "claude:operator-session-subscription"
DEFAULT_STALE_AFTER_SECONDS = 900
MIN_STALE_AFTER_SECONDS = 60
MAX_STALE_AFTER_SECONDS = 3600
PROBE_ENV_SCRUBBED = (
    "ANTHROPIC_BASE_URL",
    "ANTHROPIC_AUTH_TOKEN",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_MODEL",
)
PROBE_ENV_SCRUBBED_RECEIPT_VALUE = ",".join(PROBE_ENV_SCRUBBED)

# The bounded observation kinds this writer will attest. Each names an account-live subscription
# observation that is NOT lane/tmux/session presence: a real Claude invocation completed without a
# subscription quota wall, or an operator confirmed live subscription headroom out-of-band. Keep this
# set small and explicit — a free-form observation string is refused.
ALLOWED_OBSERVATIONS = (
    "subscription_quota_headroom_observed",
    "operator_confirmed_subscription_headroom",
)
# Provider window names the probe reply reports under rate_limit_event.unifiedWindows.
PROBE_WINDOWS = ("five_hour", "seven_day")

#: The pacing governor and the marker that says it is ARMED. Armed comes from the explicit
#: activation marker only — never from the ledger's existence (muse critical, 2026-09-26).
PACE_SCRIPT = Path(__file__).resolve().parent / "hapax-claude-pool-pace"
PACE_ACTIVATION_PATH = Path(
    os.environ.get(
        "HAPAX_CLAUDE_POOL_PACE_ACTIVATION",
        str(Path.home() / ".cache" / "hapax" / "claude-pool-pace" / "activation.json"),
    )
)
PACE_GATE_RECOVERY_HINT = (
    "next action: the Claude 7-day pool is at or over its pace line, or the governor could not "
    "produce a fresh ledgered reading, so the route holds. Wait for the line or the window "
    "reset, then repair the reading with scripts/hapax-claude-pool-pace record. There is "
    "deliberately no bypass flag."
)


def _pace_module() -> object:
    """The governor module, loaded by path (scripts/ carries no package)."""
    from importlib.machinery import SourceFileLoader
    from importlib.util import module_from_spec, spec_from_loader

    loader = SourceFileLoader("hapax_claude_pool_pace_gate", str(PACE_SCRIPT))
    spec = spec_from_loader(loader.name, loader)
    if spec is None:  # pragma: no cover - the loader always provides a spec here
        raise RuntimeError("the pacing governor module could not be loaded")
    module = module_from_spec(spec)
    loader.exec_module(module)
    return module


def _pace_gate(
    receipt_dir: Path, headless_glob: str, *, now: datetime, activation_path: Path
) -> tuple[str, str]:
    """Ask the pacing governor. Only ``armed_allow`` mints.

    ``not_armed`` allows and is emitted visibly by the caller; ``armed_refuse`` and
    ``gate_error`` refuse. With the governor armed, an absent, unreadable or empty ledger
    REFUSES: armed is never inferred from the ledger, and absence of evidence is never
    permission.
    """
    try:
        module = _pace_module()
    except Exception as exc:  # noqa: BLE001 — an unloadable governor refuses, never permits
        return "gate_error", f"pacing governor unloadable: {exc}"
    try:
        is_armed, _marker = module.armed(Path(activation_path))
    except (OSError, ValueError) as exc:
        return "gate_error", f"activation marker unreadable: {exc}"
    if not is_armed:
        return "not_armed", f"no activation marker at {activation_path}: not armed"

    ledger, _rows = module.ledger_state()
    if ledger == "unreadable":
        return "armed_refuse", "pace_ledger_unreadable"
    if ledger == "absent":
        return "armed_refuse", "pace_ledger_absent"
    if ledger == "empty":
        return "armed_refuse", "pace_ledger_empty"
    try:
        state = module.evaluate(
            Path(receipt_dir), headless_glob, now=now, activation_path=Path(activation_path)
        )
    except Exception as exc:  # noqa: BLE001 — an unreadable evaluation refuses
        return "armed_refuse", f"pace_evaluation_unreadable: {exc}"
    if state.get("decision") == "allow":
        return "armed_allow", str(state.get("reason"))
    return "armed_refuse", str(state.get("reason"))


#: The durable sink root the pacing governor's ledger reads (shared/durable_jsonl_sink.py).
DURABLE_SINK_ROOT_ENV = "HAPAX_DURABLE_SINK_ROOT"
POOL_BINDING_RECOVERY_HINT = (
    "next action: mint this route only from its declared pool's own chain — the registry's "
    "subscription_pool_binding names the config dir (CLAUDE_CONFIG_DIR), receipt dir, headless "
    "traces, pace marker and durable sink. A reading from any other pool never admits the route, "
    "and there is deliberately no bypass flag."
)


class PoolBindingRefused(ValueError):
    """The reading is not from the route's declared pool, or the binding is unreadable."""


def _declared_pool_binding(route_id: str) -> object | None:
    """The route's declared subscription pool, or None when the route is unbound.

    An unreadable registry refuses every route: without it, a bound route cannot be told apart
    from an unbound one, and guessing "unbound" would let another pool's reading admit it.
    """
    try:
        from shared.platform_capability_registry import resolve_subscription_pool_binding

        return resolve_subscription_pool_binding(route_id)
    except Exception as exc:  # noqa: BLE001 — an unreadable binding refuses, never permits
        raise PoolBindingRefused(
            f"the route pool binding could not be read ({type(exc).__name__})"
        ) from exc


def _same_path(left: Path | str, right: Path | str) -> bool:
    return Path(left).expanduser().resolve() == Path(right).expanduser().resolve()


def _same_headless_glob(value: str, headless_dir: Path) -> bool:
    path = Path(value).expanduser()
    return path.parts[-2:] == ("*", "output.jsonl") and _same_path(path.parent.parent, headless_dir)


def _pool_binding_mismatches(
    args: argparse.Namespace, binding: object, env: Mapping[str, str]
) -> list[str]:
    """Each surface of this reading that is not the declared pool's own."""
    from shared.platform_capability_registry import claude_config_dir_for_env

    sink_root = (env.get(DURABLE_SINK_ROOT_ENV) or "").strip()
    checks = {
        "config_dir": _same_path(claude_config_dir_for_env(env), binding.config_dir),
        "receipt_dir": _same_path(args.receipt_dir, binding.receipt_dir),
        "pace_receipt_dir": _same_path(args.pace_receipt_dir, binding.receipt_dir),
        "pace_headless_glob": _same_headless_glob(args.pace_headless_glob, binding.headless_dir),
        "pace_activation": _same_path(args.pace_activation, binding.pace_activation),
        "durable_sink_root": bool(sink_root) and _same_path(sink_root, binding.durable_sink_root),
    }
    return [name for name, matches in checks.items() if not matches]


VALIDATION_RECOVERY_HINT = (
    "next action: rerun with --help to confirm bounds, pass a sanitized --evidence-ref that names "
    "the account-live observation (never a lane/tmux name), pick an allowed --observation, then "
    "rerun after a genuine account-live subscription observation"
)

SAFE_REF_RE = re.compile(r"\A[a-z0-9][a-z0-9_.+-]{2,239}\Z")
WITNESS_ALLOWLIST_RE = re.compile(
    r"\Aclaude-(?:subscription-headroom-observed|operator-confirmed-subscription-headroom)-"
    r"\d{8}t\d{4}(?:\d{2})?z\Z"
)
SAFE_RECEIPT_NAME_RE = re.compile(r"\A[a-z0-9_.+-]+\.yaml\Z")
SECRETISH_RE = re.compile(
    r"(?:api[_-]?key|bearer|secret|token|sk-[a-z0-9_-]+|[a-z0-9]{32,})",
    re.IGNORECASE,
)
BILLINGISH_RE = re.compile(
    r"(?:"
    r"(?:^|[-_.+:])(?:billing|customer|account|invoice|payment)[a-z0-9]*(?:$|[-_.+:])|"
    r"(?:^|[-_.+:])subscription[-_.+:]?id[a-z0-9]*(?:$|[-_.+:])|"
    r"(?:^|[-_.+:])(?:cus|sub|acct|in|ch)[0-9][a-z0-9]*(?:$|[-_.+:])|"
    r"(?:^|[-_.+:])(?:cus|sub|acct|in|ch)[-_.+:][a-z0-9]+(?:$|[-_.+:])"
    r")",
    re.IGNORECASE,
)
# Guard against laundering lane/session presence into quota evidence (the exact anti-pattern this
# task closes): an evidence ref that names a tmux/session/lane is refused.
LANE_PRESENCE_RE = re.compile(
    r"(?:"
    r"hapax-claude-[a-z0-9-]+|session-present|lane-present|lane-exists|"
    r"(?:^|[-_.+])"
    r"(?:(?:tmux|sessions?|lanes?|dev)[0-9]*|"
    r"(?:alpha|beta|gamma|delta|epsilon|zeta|eta|theta|iota|kappa|"
    r"lambda|mu|nu|xi|omicron|pi|rho|sigma|tau|upsilon|phi|chi|psi|omega)[0-9]*|"
    r"cx-[a-z0-9-]+|vbe-[0-9]+)"
    r"(?:$|[-_.+])"
    r")",
    re.IGNORECASE,
)


def _parse_utc(value: str) -> datetime | None:
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=UTC)
    return parsed.astimezone(UTC).replace(microsecond=0)


class PaceRefused(RuntimeError):
    """The Claude pool pacing governor refused this receipt; nothing is written."""


def _instant(value: str) -> datetime:
    parsed = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    return parsed.astimezone(UTC) if parsed.tzinfo else parsed.replace(tzinfo=UTC)


def _iso(value: datetime) -> str:
    return value.astimezone(UTC).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def _now(args: argparse.Namespace) -> datetime:
    if args.now:
        parsed = _parse_utc(args.now)
        if parsed is None:
            raise ValueError("invalid --now; expected ISO-8601 UTC timestamp")
        return parsed
    return datetime.now(UTC).replace(microsecond=0)


def _safe_reference(value: str, *, label: str) -> str:
    normalized = " ".join(value.strip().split())
    if SAFE_REF_RE.fullmatch(normalized) is None or SECRETISH_RE.search(normalized) is not None:
        raise ValueError(f"unsafe {label}; expected a 3-240 character sanitized reference")
    if BILLINGISH_RE.search(normalized) is not None:
        raise ValueError(f"unsafe {label}; billing/account identifiers must not be persisted")
    if LANE_PRESENCE_RE.search(normalized) is not None:
        raise ValueError(
            f"unsafe {label}; lane/tmux/session presence must not be used as quota evidence"
        )
    if WITNESS_ALLOWLIST_RE.fullmatch(normalized) is None:
        raise ValueError(
            f"unsafe {label}; expected a claude subscription headroom witness reference"
        )
    return normalized


def _observation(value: str) -> str:
    normalized = " ".join(value.strip().split())
    if normalized not in ALLOWED_OBSERVATIONS:
        raise ValueError(
            "invalid --observation; expected one of: " + ", ".join(ALLOWED_OBSERVATIONS)
        )
    return normalized


def _route_id(value: str) -> str:
    normalized = " ".join(value.strip().split())
    if normalized not in ALLOWED_ROUTE_IDS:
        raise ValueError("invalid --route-id; expected one of: " + ", ".join(ALLOWED_ROUTE_IDS))
    return normalized


def _route_slug(route_id: str) -> str:
    return route_id.replace(".", "-")


def _receipt_name(
    args: argparse.Namespace, *, route_id: str, observed_at: datetime, pool: str | None = None
) -> str:
    stamp = observed_at.strftime("%Y%m%dT%H%M%SZ").lower()
    # A bound route's receipt name carries its pool, so the ledger's evidence reference (which
    # embeds the receipt name) names the pool too.
    pool_part = f"-pool-{pool}" if pool else ""
    default = f"claude-subscription-quota-admission-{_route_slug(route_id)}{pool_part}-{stamp}.yaml"
    name = args.receipt_name or default
    if pool and f"-pool-{pool}-" not in name:
        raise PoolBindingRefused(f"a receipt for a pool-bound route must name it (-pool-{pool}-)")
    if SAFE_RECEIPT_NAME_RE.fullmatch(name) is None or SECRETISH_RE.search(name) is not None:
        raise ValueError("unsafe receipt name")
    name_stem = name.removesuffix(".yaml")
    if BILLINGISH_RE.search(name_stem) is not None:
        raise ValueError("unsafe receipt name; billing/account identifiers must not be persisted")
    if LANE_PRESENCE_RE.search(name_stem) is not None:
        raise ValueError("unsafe receipt name; lane/tmux/session presence must not be persisted")
    if "claude-subscription-quota-admission" not in name:
        raise ValueError("receipt name must contain 'claude-subscription-quota-admission'")
    return name


def _probe_windows(
    args: argparse.Namespace, *, observation: str, observed_at: datetime
) -> list[tuple[str, object]]:
    """Receipt fields for the windows the probe reply reported; none unless the probe sent them."""
    fields: list[tuple[str, object]] = []
    for name in PROBE_WINDOWS:
        flag = name.replace("_", "-")
        used = getattr(args, f"{name}_used_percent")
        reset = getattr(args, f"{name}_resets_at")
        if used is None and reset is None:
            continue
        if not args.probe_environment_scrubbed or observation != ALLOWED_OBSERVATIONS[0]:
            raise ValueError(
                "subscription windows come only from the scrubbed account-live probe's reply; "
                "pass them with --probe-environment-scrubbed and the observed-headroom observation"
            )
        if used is None or reset is None:
            raise ValueError(
                f"--{flag}-used-percent and --{flag}-resets-at must be passed together"
            )
        try:
            percent = float(used)
        except ValueError:
            percent = math.nan
        if not math.isfinite(percent) or percent < 0:
            raise ValueError(f"--{flag}-used-percent must be a finite, non-negative percent")
        resets_at = _parse_utc(reset)
        if resets_at is None or resets_at <= observed_at:
            raise ValueError(
                f"--{flag}-resets-at must be an ISO-8601 UTC time after the observation; "
                "a window that already reset is not the current window"
            )
        fields += [(f"{name}_used_percent", percent), (f"{name}_resets_at", _iso(resets_at))]
    if args.subscription_served:
        if not args.probe_environment_scrubbed or observation != ALLOWED_OBSERVATIONS[0]:
            raise ValueError(
                "--subscription-served comes only from the scrubbed account-live probe's reply"
            )
        # The probe saw an allowed status and an explicit non-overage flag on every rate event.
        fields.append(("subscription_served", True))
    return fields


def _write_flat_yaml_atomic(path: Path, fields: list[tuple[str, object]]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".tmp")
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            for key, value in fields:
                if isinstance(value, bool):
                    rendered = "true" if value else "false"
                else:
                    rendered = str(value)
                handle.write(f"{key}: {rendered}\n")
        os.replace(tmp_name, path)
        os.chmod(path, 0o600)
    except Exception:
        try:
            Path(tmp_name).unlink()
        except OSError:
            # Cleanup is best-effort; preserve and re-raise the original write failure.
            pass
        raise


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--receipt-dir", type=Path, default=DEFAULT_RECEIPT_DIR)
    parser.add_argument("--receipt-name")
    parser.add_argument("--now")
    parser.add_argument(
        "--evidence-ref",
        required=True,
        help=(
            "Sanitized ref naming the account-live observation (never a lane/tmux name), "
            "for example claude-subscription-headroom-observed-20260708t1400z"
        ),
    )
    parser.add_argument(
        "--observation",
        default=ALLOWED_OBSERVATIONS[0],
        help="Account-live observation kind: " + ", ".join(ALLOWED_OBSERVATIONS),
    )
    parser.add_argument(
        "--route-id",
        default=DEFAULT_ROUTE_ID,
        help="Claude receipt-bounded route id: " + ", ".join(ALLOWED_ROUTE_IDS),
    )
    parser.add_argument(
        "--stale-after-seconds",
        type=int,
        default=DEFAULT_STALE_AFTER_SECONDS,
    )
    parser.add_argument(
        "--probe-environment-scrubbed",
        action="store_true",
        help="Record the fixed provider-environment controls removed by the active probe",
    )
    parser.add_argument(
        "--subscription-served",
        action="store_true",
        help="The probe's reply witnessed an allowed, explicitly non-overage serve (probe only)",
    )
    for name in PROBE_WINDOWS:
        flag = name.replace("_", "-")
        parser.add_argument(
            f"--{flag}-used-percent",
            help=f"Probe-reported {name} utilization as a percent (probe-backed receipts only)",
        )
        parser.add_argument(
            f"--{flag}-resets-at",
            help=f"Probe-reported {name} reset, ISO-8601 UTC (with --{flag}-used-percent)",
        )
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--pace-receipt-dir", type=Path, default=DEFAULT_RECEIPT_DIR)
    parser.add_argument(
        "--pace-headless-glob",
        default=str(Path.home() / ".cache" / "hapax" / "claude-headless" / "*" / "output.jsonl"),
    )
    parser.add_argument("--pace-now")
    parser.add_argument("--pace-activation", type=Path, default=PACE_ACTIVATION_PATH)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    try:
        observed_at = _now(args)
        if not MIN_STALE_AFTER_SECONDS <= args.stale_after_seconds <= MAX_STALE_AFTER_SECONDS:
            raise ValueError(
                f"--stale-after-seconds must be between {MIN_STALE_AFTER_SECONDS} and "
                f"{MAX_STALE_AFTER_SECONDS}"
            )
        observation = _observation(args.observation)
        route_id = _route_id(args.route_id)
        evidence_ref = _safe_reference(args.evidence_ref, label="evidence-ref")
        binding = _declared_pool_binding(route_id)
        pool = None if binding is None else binding.pool
        if binding is not None:
            mismatches = _pool_binding_mismatches(args, binding, os.environ)
            if mismatches:
                raise PoolBindingRefused(
                    f"{route_id} is bound to subscription pool {pool}; this reading's "
                    f"{', '.join(mismatches)} is not that pool's"
                )
        receipt_name = _receipt_name(args, route_id=route_id, observed_at=observed_at, pool=pool)
        windows = _probe_windows(args, observation=observation, observed_at=observed_at)
        path = args.receipt_dir / receipt_name
        fields: list[tuple[str, object]] = [
            ("schema", ADMISSION_SCHEMA),
            ("status", "quota_available"),
            ("provider", PROVIDER),
            ("route_id", route_id),
            ("capacity_pool", CAPACITY_POOL),
            *([("pool", pool)] if pool else []),
            ("auth_surface", AUTH_SURFACE),
            ("observation", observation),
            *(
                [("probe_environment_scrubbed", PROBE_ENV_SCRUBBED_RECEIPT_VALUE)]
                if args.probe_environment_scrubbed
                else []
            ),
            ("observed_at", _iso(observed_at)),
            ("stale_after_seconds", args.stale_after_seconds),
            ("evidence_ref", evidence_ref),
            ("secret_source", SECRET_SOURCE),
            ("secret_value_persisted", False),
            ("prompt_or_output_persisted", False),
            ("billing_mode", BILLING_MODE),
            ("account_live_quota_observed", True),
            ("lane_presence_used_as_quota_evidence", False),
            ("positive_admission", True),
            *windows,
        ]
        pace_state, pace_detail = _pace_gate(
            args.pace_receipt_dir,
            args.pace_headless_glob,
            now=_now(args) if args.pace_now is None else _instant(args.pace_now),
            activation_path=args.pace_activation,
        )
        if pace_state in {"armed_refuse", "gate_error"}:
            raise PaceRefused(f"{pace_state}: {pace_detail}")
        _write_flat_yaml_atomic(path, fields)
        # Emitted on the allow path too, never discarded (muse critical): an unarmed gate and
        # its reason are visible to whoever reads this run.
        print(f"pace: {pace_state}: {pace_detail}", file=sys.stderr)
    except PaceRefused as exc:
        print(
            f"hapax-claude-subscription-quota-admission: refused by the Claude pool pacing "
            f"governor ({exc}); {PACE_GATE_RECOVERY_HINT}",
            file=sys.stderr,
        )
        return 3
    except PoolBindingRefused as exc:
        print(
            f"hapax-claude-subscription-quota-admission: {exc}; {POOL_BINDING_RECOVERY_HINT}",
            file=sys.stderr,
        )
        return 2
    except ValueError as exc:
        print(
            f"hapax-claude-subscription-quota-admission: {exc}; {VALIDATION_RECOVERY_HINT}",
            file=sys.stderr,
        )
        return 2
    except OSError as exc:
        print(
            "hapax-claude-subscription-quota-admission: failed to write receipt: "
            f"{exc}; check receipt-dir existence/permissions or rerun with a writable "
            "--receipt-dir under the governed relay receipts path",
            file=sys.stderr,
        )
        return 1

    summary = {
        "receipt_kind": "admission",
        "pace_gate": pace_state,
        "pace_gate_detail": pace_detail,
        "path": str(path),
        "route_id": route_id,
        "capacity_pool": CAPACITY_POOL,
        "auth_surface": AUTH_SURFACE,
        "observation": observation,
        "observed_at": _iso(observed_at),
        "stale_after_seconds": args.stale_after_seconds,
        "fresh_until": _iso(
            datetime.fromtimestamp(observed_at.timestamp() + args.stale_after_seconds, UTC)
        ),
        "account_live_quota_observed": True,
        "lane_presence_used_as_quota_evidence": False,
    }
    if pool:
        summary["pool"] = pool
    if args.probe_environment_scrubbed:
        summary["probe_environment_scrubbed"] = list(PROBE_ENV_SCRUBBED)
    if args.json:
        import json

        print(json.dumps(summary, indent=2, sort_keys=True))
    else:
        print(f"hapax-claude-subscription-quota-admission: wrote admission receipt -> {path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
