#!/usr/bin/env python3
"""Write Claude subscription-quota admission receipts from an account-live observation.

The command records a short-lived, sanitized observation that a Claude receipt-bounded route has
fresh account-live subscription quota. It is patterned after
``scripts/hapax-agy-quota-admission`` / ``scripts/hapax-glmcp-quota-admission``: positive receipts
are consumed by ``scripts/hapax-quota-telemetry-writer`` before that route is treated as
quota-fresh.

Two paths, and the difference between them is the whole point.

**Measured (``--from-transcript``).** Subscription *liveness* IS mechanically observable: a completed
assistant turn in Claude Code's own transcripts is exactly the default observation this writer
names — a real Claude invocation that returned without hitting a quota wall. ``--from-transcript``
reads it and derives both the evidence ref and ``observed_at`` from the turn itself, so nobody types
a claim that was never checked. See ``shared/claude_transcript_quota``. Prefer this path.

**Attested (explicit ``--evidence-ref``).** The original path, retained because liveness is not the
only claim: ``operator_confirmed_subscription_headroom`` is an operator act and cannot be measured
from disk. On this path the writer validates the *shape* of the reference and never that the
observation happened — an evidence ref merely names what was allegedly seen.

CASE-CAPACITY-ROUTING-001 R2 said "use receipts and manual refresh until observable". For liveness
that exit condition is now met. **What remains unobservable is headroom MAGNITUDE**: Claude Code's
``rateLimits`` transcript field is null in every record on this estate and no usage/limit file exists
under ``~/.claude``, so the codex ``--from-rollout`` percentage read has no analogue here.

Both paths: NEVER a live Claude smoke (no runtime side effect, no provider spend) and NEVER
lane/tmux/session presence. No secret value and no prompt/response content is persisted, and the
receipt is short-lived so it cannot stand as stale evidence. Fail-closed: an unsafe or invalid
observation exits non-zero and writes nothing, so the route stays held.
"""

from __future__ import annotations

import argparse
import os
import re
import sys
import tempfile
from datetime import UTC, datetime
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

DEFAULT_RECEIPT_DIR = Path(
    os.environ.get(
        "HAPAX_RELAY_RECEIPT_DIR",
        str(Path.home() / ".cache/hapax/relay/receipts"),
    )
)

ADMISSION_SCHEMA = "hapax.claude_quota_admission.v1"
PROVIDER = "anthropic-claude-subscription"
DEFAULT_ROUTE_ID = "claude.headless.full"
ALLOWED_ROUTE_IDS = ("claude.headless.full", "claude.review.opus")
CAPACITY_POOL = "subscription_quota"
AUTH_SURFACE = "subscription"
BILLING_MODE = "operator_session_subscription"
SECRET_SOURCE = "claude:operator-session-subscription"
DEFAULT_STALE_AFTER_SECONDS = 900
MIN_STALE_AFTER_SECONDS = 60
MAX_STALE_AFTER_SECONDS = 3600
#: With --from-transcript: how old the freshest completed turn may be and still count as
#: a live observation. Matches the receipt's own default TTL -- an observation older than
#: the window it would open is not evidence for that window.
DEFAULT_MAX_OBSERVATION_AGE_SECONDS = 900
#: Clamped for the same reason --stale-after-seconds is, and it matters more. This knob is
#: the one that can silently convert the MEASURED path back into an attestation: a caller
#: (or a future timer unit) passing 999999 would mint from a turn observed yesterday, whose
#: whole premise is that the observation is fresh. The ceiling matches
#: MAX_STALE_AFTER_SECONDS so an observation can never be older than the longest window it
#: could open.
MIN_OBSERVATION_AGE_SECONDS = 60
MAX_OBSERVATION_AGE_SECONDS = MAX_STALE_AFTER_SECONDS

# The bounded observation kinds this writer will attest. Each names an account-live subscription
# observation that is NOT lane/tmux/session presence: a real Claude invocation completed without a
# subscription quota wall, or an operator confirmed live subscription headroom out-of-band. Keep this
# set small and explicit — a free-form observation string is refused.
ALLOWED_OBSERVATIONS = (
    "subscription_quota_headroom_observed",
    "operator_confirmed_subscription_headroom",
)

#: Attested path only. Under --from-transcript the tool DERIVES the evidence-ref and refuses
#: a caller-supplied one, so telling the caller to pass one is advice that cannot be taken.
VALIDATION_RECOVERY_HINT = (
    "next action: rerun with --help to confirm bounds, pass a sanitized --evidence-ref that names "
    "the account-live observation (never a lane/tmux name), pick an allowed --observation, then "
    "rerun after a genuine account-live subscription observation"
)

#: Measured path. Nothing here asks for an evidence-ref: the only way through is a real
#: completed turn inside the window, which is the entire point of the mode.
TRANSCRIPT_RECOVERY_HINT = (
    "next action: this mode mints only from a completed Claude turn observed in the last "
    f"{DEFAULT_MAX_OBSERVATION_AGE_SECONDS}s -- do not supply --evidence-ref (it is derived). "
    "If the estate is idle, that refusal is correct: run a real Claude request and rerun. "
    "Widen with --max-observation-age-seconds only within "
    f"{MIN_OBSERVATION_AGE_SECONDS}-{MAX_OBSERVATION_AGE_SECONDS}s"
)

SAFE_REF_RE = re.compile(r"\A[a-z0-9][a-z0-9_.+-]{2,239}\Z")
WITNESS_ALLOWLIST_RE = re.compile(
    r"\Aclaude-(?:subscription-headroom-observed|operator-confirmed-subscription-headroom)-"
    r"\d{8}t\d{4}(?:\d{2})?z\Z"
)
SAFE_RECEIPT_NAME_RE = re.compile(r"\A[a-z0-9_.+-]+\.yaml\Z")
SECRETISH_RE = re.compile(
    r"(?:api[_-]?key|bearer|secret|token|sk-[a-z0-9_-]+|[a-z0-9]{32,})",
    re.IGNORECASE,
)
BILLINGISH_RE = re.compile(
    r"(?:"
    r"(?:^|[-_.+:])(?:billing|customer|account|invoice|payment)[a-z0-9]*(?:$|[-_.+:])|"
    r"(?:^|[-_.+:])subscription[-_.+:]?id[a-z0-9]*(?:$|[-_.+:])|"
    r"(?:^|[-_.+:])(?:cus|sub|acct|in|ch)[0-9][a-z0-9]*(?:$|[-_.+:])|"
    r"(?:^|[-_.+:])(?:cus|sub|acct|in|ch)[-_.+:][a-z0-9]+(?:$|[-_.+:])"
    r")",
    re.IGNORECASE,
)
# Guard against laundering lane/session presence into quota evidence (the exact anti-pattern this
# task closes): an evidence ref that names a tmux/session/lane is refused.
LANE_PRESENCE_RE = re.compile(
    r"(?:"
    r"hapax-claude-[a-z0-9-]+|session-present|lane-present|lane-exists|"
    r"(?:^|[-_.+])"
    r"(?:(?:tmux|sessions?|lanes?|dev)[0-9]*|"
    r"(?:alpha|beta|gamma|delta|epsilon|zeta|eta|theta|iota|kappa|"
    r"lambda|mu|nu|xi|omicron|pi|rho|sigma|tau|upsilon|phi|chi|psi|omega)[0-9]*|"
    r"cx-[a-z0-9-]+|vbe-[0-9]+)"
    r"(?:$|[-_.+])"
    r")",
    re.IGNORECASE,
)


def _parse_utc(value: str) -> datetime | None:
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=UTC)
    return parsed.astimezone(UTC).replace(microsecond=0)


def _iso(value: datetime) -> str:
    return value.astimezone(UTC).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def _now(args: argparse.Namespace) -> datetime:
    if args.now:
        parsed = _parse_utc(args.now)
        if parsed is None:
            raise ValueError("invalid --now; expected ISO-8601 UTC timestamp")
        return parsed
    return datetime.now(UTC).replace(microsecond=0)


def _safe_reference(value: str, *, label: str) -> str:
    normalized = " ".join(value.strip().split())
    if SAFE_REF_RE.fullmatch(normalized) is None or SECRETISH_RE.search(normalized) is not None:
        raise ValueError(f"unsafe {label}; expected a 3-240 character sanitized reference")
    if BILLINGISH_RE.search(normalized) is not None:
        raise ValueError(f"unsafe {label}; billing/account identifiers must not be persisted")
    if LANE_PRESENCE_RE.search(normalized) is not None:
        raise ValueError(
            f"unsafe {label}; lane/tmux/session presence must not be used as quota evidence"
        )
    if WITNESS_ALLOWLIST_RE.fullmatch(normalized) is None:
        raise ValueError(
            f"unsafe {label}; expected a claude subscription headroom witness reference"
        )
    return normalized


def _observation(value: str) -> str:
    normalized = " ".join(value.strip().split())
    if normalized not in ALLOWED_OBSERVATIONS:
        raise ValueError(
            "invalid --observation; expected one of: " + ", ".join(ALLOWED_OBSERVATIONS)
        )
    return normalized


def _route_id(value: str) -> str:
    normalized = " ".join(value.strip().split())
    if normalized not in ALLOWED_ROUTE_IDS:
        raise ValueError("invalid --route-id; expected one of: " + ", ".join(ALLOWED_ROUTE_IDS))
    return normalized


def _route_slug(route_id: str) -> str:
    return route_id.replace(".", "-")


def _receipt_name(args: argparse.Namespace, *, route_id: str, observed_at: datetime) -> str:
    stamp = observed_at.strftime("%Y%m%dT%H%M%SZ").lower()
    default = f"claude-subscription-quota-admission-{_route_slug(route_id)}-{stamp}.yaml"
    name = args.receipt_name or default
    if SAFE_RECEIPT_NAME_RE.fullmatch(name) is None or SECRETISH_RE.search(name) is not None:
        raise ValueError("unsafe receipt name")
    name_stem = name.removesuffix(".yaml")
    if BILLINGISH_RE.search(name_stem) is not None:
        raise ValueError("unsafe receipt name; billing/account identifiers must not be persisted")
    if LANE_PRESENCE_RE.search(name_stem) is not None:
        raise ValueError("unsafe receipt name; lane/tmux/session presence must not be persisted")
    if "claude-subscription-quota-admission" not in name:
        raise ValueError("receipt name must contain 'claude-subscription-quota-admission'")
    return name


def _write_flat_yaml_atomic(path: Path, fields: list[tuple[str, object]]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".tmp")
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            for key, value in fields:
                if isinstance(value, bool):
                    rendered = "true" if value else "false"
                else:
                    rendered = str(value)
                handle.write(f"{key}: {rendered}\n")
        os.replace(tmp_name, path)
        os.chmod(path, 0o600)
    except Exception:
        try:
            Path(tmp_name).unlink()
        except OSError:
            # Cleanup is best-effort; preserve and re-raise the original write failure.
            pass
        raise


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--receipt-dir", type=Path, default=DEFAULT_RECEIPT_DIR)
    parser.add_argument("--receipt-name")
    parser.add_argument("--now")
    parser.add_argument(
        "--evidence-ref",
        help=(
            "Sanitized ref naming the account-live observation (never a lane/tmux name), "
            "for example claude-subscription-headroom-observed-20260708t1400z. "
            "Required unless --from-transcript supplies it."
        ),
    )
    parser.add_argument(
        "--from-transcript",
        action="store_true",
        help=(
            "MEASURE instead of attest: read the freshest completed Claude turn from "
            "Claude Code's own transcripts and derive --evidence-ref and observed_at "
            "from it. Fails closed when absent, stale, or clock-skewed."
        ),
    )
    parser.add_argument(
        "--max-observation-age-seconds",
        type=int,
        default=DEFAULT_MAX_OBSERVATION_AGE_SECONDS,
        help="With --from-transcript: refuse if the freshest turn is older than this.",
    )
    parser.add_argument(
        "--observation",
        default=ALLOWED_OBSERVATIONS[0],
        help="Account-live observation kind: " + ", ".join(ALLOWED_OBSERVATIONS),
    )
    parser.add_argument(
        "--route-id",
        default=DEFAULT_ROUTE_ID,
        help="Claude receipt-bounded route id: " + ", ".join(ALLOWED_ROUTE_IDS),
    )
    parser.add_argument(
        "--stale-after-seconds",
        type=int,
        default=DEFAULT_STALE_AFTER_SECONDS,
    )
    parser.add_argument("--json", action="store_true")
    return parser


def _observe_from_transcript(args: argparse.Namespace) -> tuple[datetime, str]:
    """Derive (observed_at, evidence_ref) from a real completed Claude turn.

    Stamps ``observed_at`` with the **turn's own** timestamp rather than ``now``: a later
    stamp would hand the receipt a freshness window its evidence does not support. Any
    failure raises and nothing is written -- the route stays held, which is the correct
    outcome when the estate is idle.
    """

    from shared.claude_transcript_quota import (
        TranscriptQuotaUnavailable,
        latest_transcript_observation,
    )

    try:
        observation = latest_transcript_observation(
            now=_parse_utc(args.now) if args.now else None,
            max_age_seconds=args.max_observation_age_seconds,
        )
    except TranscriptQuotaUnavailable as exc:
        raise ValueError(f"no live transcript observation: {exc}") from exc
    return observation.observed_at, observation.witness


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    try:
        if args.from_transcript:
            if args.evidence_ref:
                raise ValueError("--evidence-ref is derived by --from-transcript; do not pass both")
            if args.observation != ALLOWED_OBSERVATIONS[0]:
                raise ValueError(
                    "--from-transcript measures liveness and can only support "
                    f"--observation {ALLOWED_OBSERVATIONS[0]}"
                )
            if (
                not MIN_OBSERVATION_AGE_SECONDS
                <= args.max_observation_age_seconds
                <= MAX_OBSERVATION_AGE_SECONDS
            ):
                raise ValueError(
                    "--max-observation-age-seconds must be between "
                    f"{MIN_OBSERVATION_AGE_SECONDS} and {MAX_OBSERVATION_AGE_SECONDS}; a wider "
                    "window turns the measured path back into an attestation"
                )
            observed_at, args.evidence_ref = _observe_from_transcript(args)
        else:
            if not args.evidence_ref:
                raise ValueError("--evidence-ref is required unless --from-transcript is given")
            observed_at = _now(args)
        if not MIN_STALE_AFTER_SECONDS <= args.stale_after_seconds <= MAX_STALE_AFTER_SECONDS:
            raise ValueError(
                f"--stale-after-seconds must be between {MIN_STALE_AFTER_SECONDS} and "
                f"{MAX_STALE_AFTER_SECONDS}"
            )
        observation = _observation(args.observation)
        route_id = _route_id(args.route_id)
        evidence_ref = _safe_reference(args.evidence_ref, label="evidence-ref")
        receipt_name = _receipt_name(args, route_id=route_id, observed_at=observed_at)
        path = args.receipt_dir / receipt_name
        fields: list[tuple[str, object]] = [
            ("schema", ADMISSION_SCHEMA),
            ("status", "quota_available"),
            ("provider", PROVIDER),
            ("route_id", route_id),
            ("capacity_pool", CAPACITY_POOL),
            ("auth_surface", AUTH_SURFACE),
            ("observation", observation),
            ("observed_at", _iso(observed_at)),
            ("stale_after_seconds", args.stale_after_seconds),
            ("evidence_ref", evidence_ref),
            ("secret_source", SECRET_SOURCE),
            ("secret_value_persisted", False),
            ("prompt_or_output_persisted", False),
            ("billing_mode", BILLING_MODE),
            ("account_live_quota_observed", True),
            ("lane_presence_used_as_quota_evidence", False),
            ("positive_admission", True),
        ]
        _write_flat_yaml_atomic(path, fields)
    except ValueError as exc:
        hint = TRANSCRIPT_RECOVERY_HINT if args.from_transcript else VALIDATION_RECOVERY_HINT
        print(
            f"hapax-claude-subscription-quota-admission: {exc}; {hint}",
            file=sys.stderr,
        )
        return 2
    except OSError as exc:
        print(
            "hapax-claude-subscription-quota-admission: failed to write receipt: "
            f"{exc}; check receipt-dir existence/permissions or rerun with a writable "
            "--receipt-dir under the governed relay receipts path",
            file=sys.stderr,
        )
        return 1

    summary = {
        "receipt_kind": "admission",
        "path": str(path),
        "route_id": route_id,
        "capacity_pool": CAPACITY_POOL,
        "auth_surface": AUTH_SURFACE,
        "observation": observation,
        "observed_at": _iso(observed_at),
        "stale_after_seconds": args.stale_after_seconds,
        "fresh_until": _iso(
            datetime.fromtimestamp(observed_at.timestamp() + args.stale_after_seconds, UTC)
        ),
        "account_live_quota_observed": True,
        "lane_presence_used_as_quota_evidence": False,
    }
    if args.json:
        import json

        print(json.dumps(summary, indent=2, sort_keys=True))
    else:
        print(f"hapax-claude-subscription-quota-admission: wrote admission receipt -> {path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
