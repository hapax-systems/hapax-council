#!/usr/bin/env python3
"""Observe account-live Claude subscription quota MECHANICALLY, from real invocations.

WHY THIS EXISTS

``scripts/hapax-claude-subscription-quota-admission`` writes the receipt that makes a
Claude review route quota-fresh, and its two allowed observations are:

    subscription_quota_headroom_observed        <- "a real Claude invocation completed
                                                   without a subscription quota wall"
    operator_confirmed_subscription_headroom    <- an operator attestation

The first is an OBSERVATION, not an attestation — the writer's own comment says so. But
nothing in the estate ever produced it, so in practice every receipt came from a human
saying "yes, there is headroom", on a cadence nothing scheduled. Measured 2026-08-19:
receipts appeared every 55 minutes from 05:15z to 14:25z and then simply stopped. The
15:20z one never happened, both Claude and GLM review seats went stale at 15:25:02z, and
the next review dispatch found ZERO available families and could not review a PR. The
only symptom was a PR that silently could not be reviewed.

Account-live is a property of a capability. A property that only a human can report is a
property the system cannot measure, and a measurement that lapses silently is worse than
no measurement — the review floor drops without anything saying so.

WHAT IS ACTUALLY OBSERVABLE

A Claude invocation that returns token usage IS the subscription serving a request. That
is a direct observation of account-live quota, and the estate already produces these
constantly:

  - ``~/.cache/hapax/claude-headless/*/output.jsonl``  headless lane results
    (``is_error`` / ``api_error_status`` / ``usage``)
  - ``~/.claude/projects/*/*.jsonl``                   session transcripts
    (``assistant`` records with ``message.usage``)

The comparable case is codex, whose quota state is read straight off its CLI
("You've hit your usage limit ... try again at 10:29 PM") and whose ``reviewer_command``
is literally ``codex exec``. Nobody attests codex. Claude is no less observable; it just
had no observer.

WHAT THIS IS NOT

This reads METADATA ONLY — record type, timestamp, token counts, model id, error status.
It never reads or persists prompt or response content, and it never uses lane, tmux, or
session PRESENCE as evidence. Presence is exactly the defect the receipt validator's
``LANE_PRESENCE_RE`` exists to reject, and this observer must not launder it: the
evidence is a request that was SERVED, not a process that exists. A session sitting idle
against an exhausted quota produces no recent usage record and therefore no receipt.

Fail-closed. A wall observation newer than the newest served observation refuses to mint
and exits non-zero, so the route stays held. No evidence in the window also refuses.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from collections.abc import Mapping
from datetime import UTC, datetime, timedelta
from pathlib import Path
from typing import Final

REPO_ROOT = Path(__file__).resolve().parents[1]
ADMISSION_WRITER = REPO_ROOT / "scripts" / "hapax-claude-subscription-quota-admission"

#: The witness name the receipt validator's allowlist requires for this observation.
WITNESS_PREFIX = "claude-subscription-headroom-observed"
OBSERVATION = "subscription_quota_headroom_observed"
DEFAULT_ROUTE_IDS = ("claude.review.opus", "claude.headless.full")

DEFAULT_HEADLESS_GLOB = "~/.cache/hapax/claude-headless/*/output.jsonl"
DEFAULT_TRANSCRIPT_GLOB = "~/.claude/projects/*/*.jsonl"

#: How recent a served observation must be to stand as account-live evidence.
DEFAULT_MAX_AGE_SECONDS = 1800
#: Receipt lifetime. Deliberately short: an observation of "served at T" cannot vouch
#: for a quota wall that appears at T+1h.
DEFAULT_STALE_AFTER_SECONDS = 3600

#: Markers that mean the SUBSCRIPTION refused for quota reasons. Kept narrow and
#: anchored to provider wording: a generic "error" must never read as a quota wall,
#: and (per the codex lesson) an AUTH failure must never be classified as one either.
WALL_MARKERS = (
    re.compile(r"usage limit", re.IGNORECASE),
    re.compile(r"rate[_ -]?limit", re.IGNORECASE),
    re.compile(r"\bquota\b.{0,40}\b(exceeded|exhausted)\b", re.IGNORECASE),
    re.compile(r"resource[_ ]exhausted", re.IGNORECASE),
)


#: A served response only witnesses the ANTHROPIC subscription if an Anthropic model served
#: it. Measured 2026-08-19 across the live transcript corpus: 1299 `fugu-ultra` and 167
#: `glm-4.7` served records are present — other providers speaking the Claude Code wire
#: format, from the same inherited-env redirect this observer now refuses. Without this
#: filter each of those mints an `anthropic-claude-subscription` receipt.
CLAUDE_MODEL_RE = re.compile(r"\Aclaude-[a-z0-9.-]+\Z")

#: Which route each model family may witness. `claude.review.opus` must not be vouched for
#: by a Haiku serve: when the Opus entitlement is exhausted, cheap models keep answering,
#: and that is precisely when a fanned-out receipt would be most wrong.
ROUTE_MODEL_PREFIXES: Final[dict[str, tuple[str, ...]]] = {
    "claude.review.opus": ("claude-opus",),
    "claude.headless.full": ("claude-",),
}


class Observation:
    __slots__ = ("kind", "at", "source", "detail", "model", "scrubbed_env")

    def __init__(
        self,
        kind: str,
        at: datetime,
        source: str,
        detail: str = "",
        model: str | None = None,
        scrubbed_env: tuple[str, ...] = (),
    ) -> None:
        self.kind = kind  # "served" | "wall"
        self.at = at
        self.source = source
        self.detail = detail
        self.model = model
        self.scrubbed_env = scrubbed_env


def _anthropic_model(record: Mapping[str, object]) -> str | None:
    """The Anthropic model that served a record, or None if it was not one.

    Also drops `<synthetic>` and any non-Claude id. A record whose model cannot be
    identified is NOT evidence — an unnamed serve could be from any provider.
    """
    model = record.get("model")
    if isinstance(model, str) and CLAUDE_MODEL_RE.fullmatch(model):
        return model
    usage = record.get("modelUsage")
    if isinstance(usage, dict):
        named = [m for m in usage if isinstance(m, str) and CLAUDE_MODEL_RE.fullmatch(m)]
        if named and len(named) == len(usage):
            return sorted(named)[0]
    return None


def _parse_ts(value: object) -> datetime | None:
    if not isinstance(value, str) or not value:
        return None
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=UTC)
    return parsed.astimezone(UTC)


def _served_tokens(usage: object) -> int:
    """Total tokens a record proves were actually served."""
    if not isinstance(usage, dict):
        return 0
    total = 0
    for key in (
        "input_tokens",
        "output_tokens",
        "cache_read_input_tokens",
        "cache_creation_input_tokens",
    ):
        value = usage.get(key)
        if isinstance(value, int) and value > 0:
            total += value
    return total


#: Every field a provider refusal can arrive in. The raw-line PREFILTERS are derived from
#: this set rather than hardcoded, because they had already drifted apart: the filters
#: admitted only lines containing "usage"/"error"/"is_error" while this function also reads
#: api_error_status, subtype, terminal_reason and stop_reason. A live wall reported through
#: one of those alone was discarded before it was ever parsed, and an older served record
#: then minted availability over the top of it. One constant makes the drift unrepresentable.
WALL_BEARING_KEYS: Final[tuple[str, ...]] = (
    "api_error_status",
    "error",
    "subtype",
    "terminal_reason",
    "stop_reason",
    "is_error",
)
#: Substrings that make a raw line worth parsing at all.
_LINE_HINTS: Final[tuple[str, ...]] = ("usage", *WALL_BEARING_KEYS)


def _line_may_carry_evidence(line: str) -> bool:
    """Cheap prefilter over a raw JSONL line, kept in sync with WALL_BEARING_KEYS."""
    return any(f'"{hint}"' in line for hint in _LINE_HINTS)


def _wall_text(record: dict) -> str:
    """Only the narrow fields that can legitimately carry a provider refusal.

    Deliberately NOT the whole record: scanning arbitrary content would read model
    output, which this observer must never do (and which would false-positive the
    moment anyone discusses rate limits).
    """
    parts: list[str] = []
    for key in WALL_BEARING_KEYS:
        if key == "is_error":
            continue  # handled below, paired with `result`
        value = record.get(key)
        if isinstance(value, str):
            parts.append(value)
        elif isinstance(value, dict):
            # Transcripts report the refusal as a structured payload
            # ({"type": "rate_limit_error", "message": ...}), not a bare string.
            # Read only the two naming fields — never arbitrary nested content.
            parts.extend(
                str(value[k]) for k in ("type", "message") if isinstance(value.get(k), str)
            )
    result = record.get("result")
    if record.get("is_error") and isinstance(result, str):
        parts.append(result[:400])
    return " ".join(parts)


def _classify(record: Mapping[str, object], at: datetime, source: str) -> Observation | None:
    """One record -> wall / served / nothing. Wall is checked FIRST and needs no model."""
    if any(marker.search(_wall_text(record)) for marker in WALL_MARKERS):
        return Observation("wall", at, source, "provider-quota-refusal")
    if record.get("is_error") or _served_tokens(record.get("usage")) <= 0:
        return None
    model = _anthropic_model(record)
    if model is None:
        return None  # served, but not by Anthropic — witnesses nothing about this subscription
    return Observation("served", at, source, model=model)


def _scan_headless(path: Path, floor: datetime) -> list[Observation]:
    """Headless lane results: is_error / api_error_status / usage.

    Many of these records carry no per-record ``timestamp``, so the file mtime is the only
    clock available. Stamping EVERY undated record with mtime turns one append into a whole
    file of same-instant observations, and ``max()`` returns the first maximal element — so a
    lane whose first record is a success would report "served" forever, no matter what was
    appended after it. Measured across the 14 live lane files: one lane (alpha) fails open
    exactly that way, six others would hold a permanent false wall.

    A lane log is a STREAM, not a bag: when records are undated, only the LAST classified
    record represents the file's current state.
    """
    out: list[Observation] = []
    undated_last: Observation | None = None
    try:
        with path.open("r", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line or not _line_may_carry_evidence(line):
                    continue
                try:
                    record = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(record, dict):
                    continue
                dated = _parse_ts(record.get("timestamp"))
                if dated is not None:
                    if dated >= floor:
                        obs = _classify(record, dated, "headless-result")
                        if obs is not None:
                            out.append(obs)
                    continue
                mtime = _mtime(path)
                if mtime is None or mtime < floor:
                    continue
                obs = _classify(record, mtime, "headless-result")
                if obs is None:
                    continue
                if obs.kind == "served":
                    # mtime is a FILE fact, not a record fact. Dating a serve with it
                    # fabricates freshness: a 30-day-old success in a file appended to a
                    # minute ago would read as a serve a minute ago. Undated serves are
                    # therefore not evidence at all. Dating a WALL with mtime is merely
                    # conservative (it can only withhold availability), so walls are kept.
                    continue
                undated_last = obs
    except OSError:
        return []
    if undated_last is not None:
        out.append(undated_last)
    return out


def _scan_transcript(path: Path, floor: datetime) -> list[Observation]:
    """Session transcripts: assistant records carry message.usage per served response.

    Transcripts carry a real per-record timestamp, so ordering here is trustworthy — but the
    first version had NO wall branch at all, so a 429 one minute ago lost to a success nine
    minutes ago. There are ~1093 wall-shaped records in the live corpus; this is the ordinary
    case, not an edge one. The line prefilter must therefore admit records with no usage
    field, or a wall gets dropped before it is ever parsed.
    """
    out: list[Observation] = []
    try:
        with path.open("r", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line or not _line_may_carry_evidence(line):
                    continue
                try:
                    record = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(record, dict) or record.get("type") != "assistant":
                    continue
                at = _parse_ts(record.get("timestamp"))
                if at is None or at < floor:
                    continue
                message = record.get("message")
                if not isinstance(message, dict):
                    continue
                # The wall may be reported on the envelope or inside the message.
                merged = {**record, **message}
                obs = _classify(merged, at, "session-transcript")
                if obs is not None:
                    out.append(obs)
    except OSError:
        return []
    return out


#: Bounded active probe, used when any requested route lacks recent in-family passive evidence,
#: so either a quiet estate or a busy session in another family cannot silently drop the review
#: floor. Measured 2026-08-19: ~$0.02 once the prompt cache is warm. A FRESH PROCESS taking the
#: same path a reviewer would is better evidence than this process's own liveness and is not
#: presence.
#: The probe must request a model whose family can witness EVERY route it intends to mint.
#: An earlier revision probed with Haiku, which cannot witness claude.review.opus — the one
#: route the review floor depends on — so the probe could only ever have covered the route
#: that mattered least. An Opus serve satisfies both `claude-opus*` and `claude-*`, so one
#: probe covers both routes; probing per family would double the spend for nothing.
PROBE_MODEL = "claude-opus-5"

PROBE_ARGV = (
    "claude",
    "-p",
    "ok",
    "--model",
    PROBE_MODEL,
    "--output-format",
    "json",
    "--strict-mcp-config",
    "--mcp-config",
    '{"mcpServers":{}}',
)
PROBE_TIMEOUT_SECONDS = 180

#: Known provider controls that the operator-subscription probe deliberately removes. Only names,
#: never values, are persisted in a probe-backed admission receipt so the measurement discloses
#: which ambient controls could not affect it.
PROBE_ENV_SCRUBBED = (
    "ANTHROPIC_BASE_URL",
    "ANTHROPIC_AUTH_TOKEN",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_MODEL",
)

#: Env vars that can redirect the Claude CLI away from the operator's subscription. Known exact
#: controls above are scrubbed in the child process; any other redirect control still refuses the
#: probe. This keeps the guard fail-closed as new provider controls appear.
PROVIDER_REDIRECT_ENV_PREFIXES = ("ANTHROPIC_", "CLAUDE_CODE_USE_")


def provider_redirect_env(env: Mapping[str, str] | None = None) -> list[str]:
    """Names of set env vars that would point the probe at a non-subscription endpoint."""
    source = os.environ if env is None else env
    return sorted(
        name
        for name, value in source.items()
        if value and name.startswith(PROVIDER_REDIRECT_ENV_PREFIXES)
    )


def probe(now: datetime, *, cwd: str = "/") -> Observation | None:
    """Actively observe account-live by making one bounded real request.

    Known provider controls are removed from the subprocess environment. Any redirecting
    variable not in that explicit scrub list still refuses the probe. Returning ``None`` means
    "no evidence", which holds the route; it never mints.
    """
    probe_env = dict(os.environ)
    for name in PROBE_ENV_SCRUBBED:
        probe_env.pop(name, None)
    redirected = provider_redirect_env(probe_env)
    if redirected:
        print(
            "probe refused: environment would redirect the Claude CLI off the operator "
            f"subscription ({', '.join(redirected)} set). A receipt minted here would "
            "assert auth_surface=subscription for an endpoint that is not the subscription.",
            file=sys.stderr,
        )
        return None
    try:
        proc = subprocess.run(
            list(PROBE_ARGV),
            capture_output=True,
            text=True,
            timeout=PROBE_TIMEOUT_SECONDS,
            cwd=cwd,
            env=probe_env,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        # A probe that could not RUN is a broken instrument, not an absence of evidence.
        # Collapsing the two made a missing `claude` binary or a timed-out request exit 4,
        # which SuccessExitStatus accepts — so the unit would stay green forever while
        # never observing anything. This is the same declined-vs-failed distinction the
        # determination spine enforces; it belongs here too.
        return Observation("probe_failed", now, "active-probe", f"{type(exc).__name__}: {exc}")
    blob = (proc.stdout or "").strip()
    try:
        record = json.loads(blob)
    except ValueError:
        # A non-JSON failure still carries the provider's refusal wording — this is exactly
        # how codex reports its wall — so classify it rather than discarding it.
        combined = f"{blob} {proc.stderr or ''}"
        if any(marker.search(combined) for marker in WALL_MARKERS):
            return Observation("wall", now, "active-probe", "provider-quota-refusal")
        return None
    if not isinstance(record, dict):
        return None
    if any(marker.search(_wall_text(record)) for marker in WALL_MARKERS):
        return Observation("wall", now, "active-probe", "provider-quota-refusal")
    if not record.get("is_error") and _served_tokens(record.get("usage")) > 0:
        # Record the model the response ACTUALLY reports, never the one requested. The
        # request is an intention; only the response is evidence, and a serve with no
        # identifiable Anthropic model witnesses nothing (same rule as the passive path).
        model = _anthropic_model(record)
        if model is None:
            return None
        return Observation(
            "served",
            now,
            "active-probe",
            model=model,
            scrubbed_env=PROBE_ENV_SCRUBBED,
        )
    return None


def _mtime(path: Path) -> datetime | None:
    try:
        return datetime.fromtimestamp(path.stat().st_mtime, tz=UTC)
    except OSError:
        return None


def _recent_files(pattern: str, floor: datetime) -> list[Path]:
    """Only files touched since the floor — avoids reading years of stale lane logs."""
    expanded = Path(os.path.expanduser(pattern))
    root = Path(expanded.anchor or "/")
    try:
        candidates = sorted(root.glob(str(expanded.relative_to(root))))
    except (ValueError, OSError):
        return []
    keep: list[Path] = []
    for candidate in candidates:
        mtime = _mtime(candidate)
        if mtime is not None and mtime >= floor:
            keep.append(candidate)
    return keep


def observe(
    *,
    now: datetime,
    max_age_seconds: int,
    headless_glob: str,
    transcript_glob: str,
) -> tuple[str, Observation | None]:
    """Return (verdict, evidence). verdict: served | walled | no_evidence."""
    floor = now - timedelta(seconds=max_age_seconds)
    found: list[Observation] = []
    for path in _recent_files(headless_glob, floor):
        found.extend(_scan_headless(path, floor))
    for path in _recent_files(transcript_glob, floor):
        found.extend(_scan_transcript(path, floor))
    verdict, newest, _found = _verdict(found)
    return verdict, newest


def observe_all(
    *,
    now: datetime,
    max_age_seconds: int,
    headless_glob: str,
    transcript_glob: str,
) -> tuple[str, Observation | None, list[Observation]]:
    """``observe`` plus every observation inside the window, so routes can pick their own.

    The account-level verdict (served / walled / no_evidence) is a property of the NEWEST
    observation. Which observation may vouch for a given ROUTE is not: measured 2026-09-02,
    every 10-minute cycle for ~24h logged ``claude.review.opus: skipped model-family-mismatch,
    observed_model: claude-fable-5-1`` — the newest serve was a Fable run, so the opus review
    route was never minted although opus serves sat minutes older inside the same window.
    A new model family arriving had silently starved a route. The per-route choice lives in
    ``evidence_by_route``; this function only stops discarding the evidence it needs.
    """
    floor = now - timedelta(seconds=max_age_seconds)
    found: list[Observation] = []
    for path in _recent_files(headless_glob, floor):
        found.extend(_scan_headless(path, floor))
    for path in _recent_files(transcript_glob, floor):
        found.extend(_scan_transcript(path, floor))
    return _verdict(found)


def _verdict(found: list[Observation]) -> tuple[str, Observation | None, list[Observation]]:
    if not found:
        return "no_evidence", None, []
    # A wall that is NEWER than the newest served response is the live state: a served
    # response from 20 minutes ago does not survive a wall 2 minutes ago. On an exact tie
    # the wall wins — `max` returns the FIRST maximal element, so without the second key a
    # tie silently resolves to whichever the scan happened to emit first.
    newest = max(found, key=lambda o: (o.at, o.kind == "wall"))
    if newest.kind == "wall":
        return "walled", newest, found
    return "served", newest, found


def evidence_by_route(
    found: list[Observation],
    route_ids: tuple[str, ...],
) -> dict[str, Observation | None]:
    """For each route, the newest SERVED observation in that route's own model family.

    A wall still wins for the whole account — callers only reach this after ``_verdict`` said
    ``served`` — but inside a served window each route is vouched for by the freshest serve
    that could actually witness it, never by a serve from another family and never by nothing
    because a different family happened to answer last. Ties resolve to the first scanned,
    which is immaterial: same family, same instant, same evidence.
    """
    # A wall is an account-level refusal. A serve that PRECEDES the newest wall cannot witness
    # availability after it, whatever family answered later: opus serve at t0, wall at t1, fable
    # serve at t2 makes the account "served" (t2 is newest) but must not resurrect the t0 opus
    # serve as evidence for the opus review route (review finding on #4615, three families).
    walls = [o.at for o in found if o.kind == "wall"]
    newest_wall = max(walls) if walls else None
    by_route: dict[str, Observation | None] = {}
    for route_id in route_ids:
        prefixes = ROUTE_MODEL_PREFIXES.get(route_id)
        eligible = [
            o
            for o in found
            if o.kind == "served"
            and (not prefixes or (o.model or "").startswith(prefixes))
            and (newest_wall is None or o.at > newest_wall)
        ]
        by_route[route_id] = max(eligible, key=lambda o: o.at) if eligible else None
    return by_route


def mint(
    evidence: Observation,
    *,
    now: datetime,
    route_ids: tuple[str, ...],
    stale_after_seconds: int,
    receipt_dir: Path | None,
    dry_run: bool,
    evidence_by_route: Mapping[str, Observation | None] | None = None,
) -> list[dict]:
    """Hand the observation to the existing admission writer — never bypass its validation.

    ``evidence_by_route`` (from ``evidence_by_route()``) lets each route be minted from the
    freshest serve in its OWN family. Without it every route is judged against the single
    ``evidence`` observation, which is how a Fable serve starved the opus review route.

    The receipt is anchored to the OBSERVATION time, not the mint time. The writer computes
    ``fresh_until = observed_at + stale_after``, so passing mint time would let a stale
    observation buy a full fresh window: evidence up to ``max_age`` old plus a full TTL,
    compounding into a receipt that vouches far past what was actually seen. Anchoring here
    means a 14-minute-old observation yields 14 fewer minutes of freshness, automatically.
    """
    results: list[dict] = []
    for route_id in route_ids:
        route_evidence = evidence
        if evidence_by_route is not None:
            route_evidence = evidence_by_route.get(route_id)
            if route_evidence is None:
                # No serve in this route's family inside the window. Distinct from a family
                # mismatch: nothing was seen that could vouch, rather than the wrong thing.
                results.append(
                    {
                        "route_id": route_id,
                        "skipped": "no-serve-in-model-family",
                        "observed_model": evidence.model,
                    }
                )
                continue
        # Mint a route ONLY from evidence in its own model family. A Haiku serve does not
        # witness claude.review.opus — and the moment the Opus entitlement is exhausted is
        # exactly when cheap models keep answering, so fanning one observation across both
        # routes is wrong precisely when it matters most. Kept as a guard even when
        # ``evidence_by_route`` already selected by family: the receipt must never depend on
        # the selector and the guard agreeing by accident.
        prefixes = ROUTE_MODEL_PREFIXES.get(route_id)
        if prefixes and not (route_evidence.model or "").startswith(prefixes):
            results.append(
                {
                    "route_id": route_id,
                    "skipped": "model-family-mismatch",
                    "observed_model": route_evidence.model,
                }
            )
            continue
        observed_at = route_evidence.at.replace(microsecond=0)
        stamp = observed_at.strftime("%Y%m%dt%H%M%Sz")
        evidence_ref = f"{WITNESS_PREFIX}-{stamp}"
        argv = [
            sys.executable,
            str(ADMISSION_WRITER),
            "--observation",
            OBSERVATION,
            "--evidence-ref",
            evidence_ref,
            "--route-id",
            route_id,
            "--stale-after-seconds",
            str(stale_after_seconds),
            "--now",
            observed_at.isoformat().replace("+00:00", "Z"),
            "--json",
        ]
        if receipt_dir is not None:
            argv += ["--receipt-dir", str(receipt_dir)]
        if route_evidence.scrubbed_env:
            argv.append("--probe-environment-scrubbed")
        if dry_run:
            results.append({"route_id": route_id, "would_run": argv[2:]})
            continue
        try:
            proc = subprocess.run(argv, capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.TimeoutExpired) as exc:
            results.append(
                {"route_id": route_id, "returncode": -1, "stderr": f"{type(exc).__name__}: {exc}"}
            )
            continue
        results.append(
            {
                "route_id": route_id,
                "returncode": proc.returncode,
                "stdout": proc.stdout.strip()[:600],
                "stderr": proc.stderr.strip()[:600],
            }
        )
    return results


def mint_failed(receipts: list[dict]) -> bool:
    """True if any route was attempted and its write did not succeed.

    A skipped route (model-family mismatch) is not a failure — it is the filter working.
    A route whose writer exited non-zero IS: the observer would otherwise print
    ``verdict: served`` and exit 0 having written nothing, which is the exact silent lapse
    this unit exists to end. Reproduced with an invalid --route-id: writer exits 2, receipt
    dir empty, observer previously reported success.
    """
    return any(r.get("returncode") not in (0, None) for r in receipts)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--max-age-seconds", type=int, default=DEFAULT_MAX_AGE_SECONDS)
    parser.add_argument("--stale-after-seconds", type=int, default=DEFAULT_STALE_AFTER_SECONDS)
    parser.add_argument("--headless-glob", default=DEFAULT_HEADLESS_GLOB)
    parser.add_argument("--transcript-glob", default=DEFAULT_TRANSCRIPT_GLOB)
    parser.add_argument("--receipt-dir", type=Path, default=None)
    parser.add_argument("--route-id", action="append", dest="route_ids")
    parser.add_argument("--now")
    parser.add_argument(
        "--probe",
        action=argparse.BooleanOptionalAction,
        default=True,
        help="When any requested route lacks passive in-family evidence, make ONE bounded real "
        "request to observe account-live directly (~$0.02). --no-probe restricts to passive "
        "observation.",
    )
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)

    now = _parse_ts(args.now) if args.now else datetime.now(UTC)
    if now is None:
        print("invalid --now; expected ISO-8601 UTC", file=sys.stderr)
        return 2
    route_ids = tuple(args.route_ids or DEFAULT_ROUTE_IDS)

    verdict, evidence, found = observe_all(
        now=now,
        max_age_seconds=args.max_age_seconds,
        headless_glob=args.headless_glob,
        transcript_glob=args.transcript_glob,
    )

    # Probe for ROUTE evidence, not merely for account-level evidence. A Fable serve witnesses
    # headless.full but says nothing about review.opus; treating that as "the account was served"
    # and suppressing the probe starves the review route indefinitely. Preserve every passive
    # route witness already found and let one probe fill only the missing families.
    # NOT used to override a wall: a detected wall is the live state and must stand.
    by_route = (
        evidence_by_route(found, route_ids) if verdict == "served" else dict.fromkeys(route_ids)
    )
    routes_missing_passive_evidence = [
        route_id for route_id, route_evidence in by_route.items() if route_evidence is None
    ]
    probe_report: dict | None = None
    if verdict != "walled" and routes_missing_passive_evidence and args.probe and not args.dry_run:
        probe_report = {
            "attempted": True,
            "requested_for_routes": routes_missing_passive_evidence,
            "reason": "requested route lacked in-model-family served evidence inside the window",
            "model": PROBE_MODEL,
            "environment_variables_scrubbed": list(PROBE_ENV_SCRUBBED),
        }
        probed = probe(now)
        if probed is not None:
            probe_report["outcome"] = probed.kind
            if probed.kind == "served":
                witnessed = evidence_by_route([probed], tuple(routes_missing_passive_evidence))
                for route_id, route_evidence in witnessed.items():
                    if route_evidence is not None:
                        by_route[route_id] = route_evidence
                probe_report["witnessed_routes"] = [
                    route_id for route_id, route_evidence in witnessed.items() if route_evidence
                ]
                found.append(probed)
                verdict, evidence, _ = _verdict(found)
            else:
                verdict, evidence = probed.kind, probed
        else:
            probe_report["outcome"] = "no_evidence"
            probe_report["witnessed_routes"] = []
    payload: dict = {
        "verdict": verdict,
        "observed_at": evidence.at.isoformat().replace("+00:00", "Z") if evidence else None,
        "source": evidence.source if evidence else None,
        "route_ids": list(route_ids),
    }
    if probe_report is not None:
        payload["probe"] = probe_report

    if verdict == "served":
        payload["receipts"] = mint(
            evidence,
            now=now,
            route_ids=route_ids,
            stale_after_seconds=args.stale_after_seconds,
            receipt_dir=args.receipt_dir,
            dry_run=args.dry_run,
            evidence_by_route=by_route,
        )
        payload["observed_model"] = evidence.model
        payload["observed_model_by_route"] = {
            route_id: (o.model if o else None) for route_id, o in by_route.items()
        }
        if not args.dry_run and mint_failed(payload["receipts"]):
            payload["hint"] = (
                "observation succeeded but at least one receipt write FAILED — the route is "
                "not vouched for. Exit 5 is deliberately outside SuccessExitStatus so this "
                "surfaces instead of leaving systemd green with no receipts."
            )
            rc = 5
        elif not args.dry_run and not any(r.get("returncode") == 0 for r in payload["receipts"]):
            payload["hint"] = "every route was skipped; no receipt was written"
            rc = 5
        else:
            rc = 0
    elif verdict == "walled":
        payload["hint"] = (
            "subscription refused for quota reasons more recently than it served; "
            "holding the route rather than minting availability"
        )
        rc = 3
    elif verdict == "probe_failed":
        # NOT exit 4. The instrument broke; nothing was observed either way. Exit 7 is
        # outside SuccessExitStatus so a missing binary or a hung request surfaces instead
        # of leaving the unit green while it silently observes nothing.
        payload["hint"] = (
            f"the active probe could not run ({evidence.detail if evidence else 'unknown'}); "
            "this is a broken instrument, not an absence of evidence"
        )
        rc = 7
    else:
        payload["hint"] = (
            f"no served Claude response within {args.max_age_seconds}s; nothing exercised "
            "the subscription, so account-live cannot be observed (this is not evidence of "
            "exhaustion — it is absence of evidence, and the route stays held)"
        )
        rc = 4

    if args.json:
        print(json.dumps(payload, indent=1))
    else:
        print(f"account-live: {verdict}" + (f" (at {payload['observed_at']})" if evidence else ""))
        if payload.get("hint"):
            print(f"  {payload['hint']}", file=sys.stderr)
    return rc


if __name__ == "__main__":
    raise SystemExit(main())
