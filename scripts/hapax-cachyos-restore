# ─── Phase 11: Canonical backup storage roots ──────────────────────────────
log "=== Phase 11: Canonical backup storage setup ==="

load_backup_storage_roots "$HOST_STORAGE_REGISTRY"
if ! STORE_ROOT=$(policy_storage_roots "b2-restic-offsite" "$HOST_STORAGE_REGISTRY"); then
    fail "Could not resolve the B2 staging root from $HOST_STORAGE_REGISTRY; repair its backup policy, then rerun Phase 11" >&2
    exit 1
fi
if [[ "$STORE_ROOT" == *$'\n'* ]]; then
    fail "B2 staging policy resolved more than one storage root; repair b2-restic-offsite in $HOST_STORAGE_REGISTRY, then rerun Phase 11" >&2
    exit 1
fi
if ! TIER1_STORAGE_ROOTS=$(policy_storage_roots "local-nas-restic" "$HOST_STORAGE_REGISTRY"); then
    fail "Could not resolve Tier 1 storage roots from $HOST_STORAGE_REGISTRY; repair its backup policy, then rerun Phase 11" >&2
    exit 1
fi
TIER1_STORAGE_ROOT=""
while IFS= read -r canonical_root; do
    [[ "$canonical_root" == "$STORE_ROOT" ]] && continue
    if [[ -n "$TIER1_STORAGE_ROOT" ]]; then
        fail "Tier 1 policy resolved multiple non-staging roots; repair local-nas-restic in $HOST_STORAGE_REGISTRY, then rerun Phase 11" >&2
        exit 1
    fi
    TIER1_STORAGE_ROOT="$canonical_root"
done <<< "$TIER1_STORAGE_ROOTS"
if [[ -z "$TIER1_STORAGE_ROOT" ]]; then
    fail "Tier 1 policy has no repository mount root distinct from $STORE_ROOT; repair local-nas-restic in $HOST_STORAGE_REGISTRY, then rerun Phase 11" >&2
    exit 1
fi

# Provision the canonical B2 staging root from the registry's identity — never from a guessed
# kernel name. Podium carries two identical SATA disks at /dev/sda and /dev/sdb, and the second
# holds a whole-disk filesystem with no partition table: the old rule "first unmounted disk with
# no partitions → mklabel + mkfs" would have formatted it. Nothing is formatted unless the operator
# names the replacement disk in RESTORE_STORE_DEVICE and it carries no signature (#4623, round 5).
if ! provision_store_root "$STORE_ROOT" "$HOST_STORAGE_REGISTRY" "${RESTORE_STORE_DEVICE:-}" /etc/fstab ""; then
    exit 1
fi

# Phase 5 saved the restored fstab beside the live one. Network filesystems (the NAS root) carry
# no host-local UUID, so their lines are valid as restored; carry them before mounting the roots.
carry_network_mount_entries /etc/fstab.restored /etc/fstab

ensure_backup_storage_roots

# The restored tree lives under /var/tmp, so installing tmpfs on /tmp cannot
# hide the snapshot before database recovery.
ensure_tmpfs_tmp

# ─── Phase 12: Docker stack ────────────────────────────────────────────────
log "=== Phase 12: Start Docker stack + restore PostgreSQL, Qdrant, and n8n workflows ==="

# Phase 2 resolved DUMP before identity and council recovery; retain it for database and git recovery.
restore_database_services "$DUMP"

# ─── Phase 12b: Ollama models ────────────────────────────────────────────
log "=== Phase 12b: Pull Ollama models ==="

if command -v ollama &>/dev/null || pacman -Q ollama-cuda &>/dev/null 2>&1; then
    sudo systemctl enable --now ollama 2>/dev/null || true
    sleep 3
    OLLAMA_MODELS=(nomic-embed-text nomic-embed-cpu qwen3:4b qwen3:8b gemma3:4b phi4-mini)
    for model in "${OLLAMA_MODELS[@]}"; do
        log "Pulling $model..."
        ollama pull "$model" 2>&1 | tail -1 && ok "Ollama: $model" || warn "Ollama: $model failed"
    done
else
    warn "Ollama not installed — install ollama-cuda and pull models manually"
fi

# ─── Phase 13: Git repos ───────────────────────────────────────────────────
log "=== Phase 13: Clone git repositories ==="

mkdir -p ~/projects

# Repos with remotes (clone from GitHub)
# Try SSH first, fall back to gh (uses OAuth token from gh auth login)
declare -A REPOS=(
    [hapax-constitution]="ryanklee/hapax-constitution"
    [hapax-officium]="ryanklee/hapax-officium"
    [hapax-watch]="ryanklee/hapax-watch"
    [hapax-mcp]="ryanklee/hapax-mcp"
    [hapax-phone]="ryanklee/hapax-phone"
)

for repo in "${!REPOS[@]}"; do
    if [[ ! -d "$HOME/projects/$repo" ]]; then
        if git clone "git@github.com:${REPOS[$repo]}.git" "$HOME/projects/$repo" > /dev/null 2>&1; then
            ok "Cloned $repo (SSH)"
        elif gh repo clone "${REPOS[$repo]}" "$HOME/projects/$repo" > /dev/null 2>&1; then
            ok "Cloned $repo (gh)"
        else
            warn "Failed to clone $repo"
        fi
    else
        ok "$repo already exists"
    fi
done

# Public repos (no auth needed)
if [[ ! -d "$HOME/projects/tabbyAPI" ]]; then
    git clone https://github.com/theroyallab/tabbyAPI "$HOME/projects/tabbyAPI" > /dev/null 2>&1 && \
        ok "Cloned tabbyAPI" || warn "Failed to clone tabbyAPI"
fi

# Repos without remotes — restore from git bundles
BUNDLES="$DUMP/git-bundles"
for repo in obsidian-hapax sample-search hapax-system; do
    if [[ ! -d "$HOME/projects/$repo" ]]; then
        if [[ -f "$BUNDLES/${repo}.bundle" ]]; then
            git clone "$BUNDLES/${repo}.bundle" "$HOME/projects/$repo" > /dev/null 2>&1 && \
                ok "Restored $repo from bundle" || warn "Failed to restore $repo"
        else
            warn "$repo has no remote and no bundle — manual recovery needed"
        fi
    fi
done

# Restore git dirty state (uncommitted work)
for repo in ~/projects/*/; do
    name=$(basename "$repo")
    patch="$DUMP/git-diff-${name}.patch"
    if [[ -f "$patch" && -s "$patch" ]]; then
        git -C "$repo" apply "$patch" > /dev/null 2>&1 && \
            log "Applied uncommitted changes to $name" || true
    fi
done

# Documents/Work vault (git repo, no remote — restore from bundle)
if [[ ! -d ~/Documents/Work ]]; then
    mkdir -p ~/Documents
    if [[ -f "$BUNDLES/Work.bundle" ]]; then
        git clone "$BUNDLES/Work.bundle" ~/Documents/Work > /dev/null 2>&1 && ok "Documents/Work"
    else
        warn "Documents/Work has no bundle — sync via Obsidian Sync"
    fi
fi

# ─── Phase 14: Local backup repo ───────────────────────────────────────────
log "=== Phase 14: Initialize local backup repo ==="

LOCAL_RESTIC_REPO="$TIER1_STORAGE_ROOT/backups/restic"
if ! mountpoint -q "$TIER1_STORAGE_ROOT"; then
    fail "Required backup storage root $TIER1_STORAGE_ROOT is not mounted; rerun Phase 11 before initializing Tier 1" >&2
    exit 1
fi
if ! mkdir -p "$LOCAL_RESTIC_REPO"; then
    fail "Could not create Tier 1 repository at $LOCAL_RESTIC_REPO; repair the $TIER1_STORAGE_ROOT mount, then rerun Phase 14" >&2
    exit 1
fi
if ! NAS_RESTIC_PASSWORD=$(pass show backups/restic-password 2>/dev/null) || [[ -z "$NAS_RESTIC_PASSWORD" ]]; then
    fail "Could not read independent NAS credential backups/restic-password; repair pass, then rerun Phase 14" >&2
    exit 1
fi
if ! RESTIC_PASSWORD="$NAS_RESTIC_PASSWORD" restic -r "$LOCAL_RESTIC_REPO" snapshots --no-lock > /dev/null 2>&1; then
    if ! RESTIC_PASSWORD="$NAS_RESTIC_PASSWORD" restic -r "$LOCAL_RESTIC_REPO" init; then
        fail "Could not initialize Tier 1 repository at $LOCAL_RESTIC_REPO; inspect restic and the $TIER1_STORAGE_ROOT mount, then rerun Phase 14" >&2
        exit 1
    fi
fi
ok "Local backup repo ready at $LOCAL_RESTIC_REPO"

# ─── Phase 15: Enable user services & timers ───────────────────────────────
log "=== Phase 15: Enable systemd user services & timers ==="

enable_systemd_user_unit() {
    local unit="$1" unit_kind="$2" label="$3"
    local enabled_state

    if ! systemctl --user enable "$unit"; then
        fail "Could not enable systemd user $unit_kind $unit; verify the unit is installed and 'systemctl --user status' works, then rerun Phase 15" >&2
        return 1
    fi
    if ! enabled_state=$(systemctl --user is-enabled "$unit"); then
        fail "Systemd could not determine whether user $unit_kind $unit is enabled; inspect 'systemctl --user is-enabled $unit', then rerun Phase 15" >&2
        return 1
    fi
    if [[ "$enabled_state" != "enabled" ]]; then
        fail "Systemd reports user $unit_kind $unit as ${enabled_state:-unknown}, not enabled; repair its install link, then rerun Phase 15" >&2
        return 1
    fi
    ok "$unit_kind: $label"
}

# Core services
SERVICES=(
    hapax-secrets
    logos-api officium-api
    hapax-daimonion hapax-watch-receiver
    studio-compositor studio-fx-output visual-layer-aggregator
    audio-recorder rag-ingest
    keychron-keepalive ydotool
    llm-stack llm-stack-analytics
)
# Timers
TIMERS=(
    hapax-backup-local hapax-backup-remote hapax-backup-watchdog
    health-monitor stack-maintenance
    daily-briefing digest profile-update
    audio-processor av-correlator
    drift-detector knowledge-maint scout
    llm-backup llm-cost-alert log-anomaly-alert manifest-snapshot
    chrome-sync claude-code-sync gcalendar-sync gdrive-sync gmail-sync
    git-sync langfuse-sync stimmung-sync weather-sync
    health-connect-parse obsidian-sync youtube-sync
    cache-cleanup dev-story-index disk-space-check flow-journal
    gpg-keyboxd-watchdog mixer-keepalive
    screen-context storage-arbiter tmp-monitor
    video-processor video-retention vram-watchdog
)
# Reconcile only from the proved activation source; archived overrides cannot
# supply a runnable command. Resolve timer services after publishing timer units.
for svc in "${SERVICES[@]}"; do
    reconcile_systemd_user_unit "$svc.service"
done
for timer in "${TIMERS[@]}"; do
    reconcile_systemd_user_unit "$timer.timer"
done
if ! systemctl --user daemon-reload; then
    fail "Could not reload the systemd user manager; verify 'systemctl --user status', then rerun Phase 15" >&2
    exit 1
fi

for timer in "${TIMERS[@]}"; do
    triggered_services=$(restore_timer_services "$timer.timer")
    for svc in $triggered_services; do
        reconcile_systemd_user_unit "$svc"
    done
done
if ! systemctl --user daemon-reload; then
    fail "Could not reload the systemd user manager; verify 'systemctl --user status', then rerun Phase 15" >&2
    exit 1
fi

# Validate the entire recovered user-unit set before publishing any enable link.
for svc in "${SERVICES[@]}"; do
    verify_systemd_user_target "$svc.service"
done
for timer in "${TIMERS[@]}"; do
    verify_systemd_user_target "$timer.timer"
done
for svc in "${SERVICES[@]}"; do
    enable_systemd_user_unit "$svc.service" service "$svc"
done
for timer in "${TIMERS[@]}"; do
    enable_systemd_user_unit "$timer.timer" timer "$timer"
done

# Set Yeti capture gain to 73% (+8dB) — persisted by WirePlumber state after first set
wpctl set-volume alsa_input.usb-Blue_Microphones_Yeti_Stereo_Microphone_REV8-00.analog-stereo 0.73 2>/dev/null && \
    ok "Yeti capture gain: 73%" || true

# ─── Phase 16: Arch-specific adjustments ───────────────────────────────────
log "=== Phase 16: CachyOS-specific tweaks ==="

# Verify fish config was restored
if [[ -f ~/.config/fish/config.fish ]]; then
    ok "Fish config present"
else
    warn "Fish config missing — may need manual setup"
fi

# Pacman parallel downloads + colors
sudo sed -i 's/#ParallelDownloads/ParallelDownloads/' /etc/pacman.conf 2>/dev/null
sudo sed -i 's/#Color/Color/' /etc/pacman.conf 2>/dev/null
ok "Pacman optimized (parallel downloads, color)"

# ─── Summary ────────────────────────────────────────────────────────────────
echo ""
log "=========================================="
log "  CachyOS Restore Complete"
log "=========================================="
echo ""
log "Manual steps:"
echo "  1. Log out and back in (docker group activation)"
echo "  2. Select Hyprland session at login screen"
