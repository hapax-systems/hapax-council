#!/usr/bin/env bash
# Refresh the GLM review seat: one real sanctioned reviewer round-trip, a witness (schema v1:
# no prompt, output or secret persisted), the passive admission receipt, the telemetry writer.
# Prints states only. Exit non-zero if the round-trip fails — no receipt is minted then.
set -euo pipefail
# The scripts this calls come from the activation worktree (main, activated by the governed loop),
# never from a mutable development checkout (review finding on #4624).
H="${HAPAX_COUNCIL:-$HOME/.cache/hapax/source-activation/worktree}"
ACTIVATION_ROOT="$HOME/.cache/hapax/source-activation/worktree"
# An inherited HAPAX_COUNCIL must not redirect governance-sensitive receipt minting to a mutable
# tree (review finding on #4624, round 2): refuse any other root unless a test says so explicitly.
if [[ "$H" != "$ACTIVATION_ROOT" && "${HAPAX_GLMCP_SEAT_ROOT_OVERRIDE:-0}" != "1" ]]; then
  echo "glm seat refresh REFUSED: HAPAX_COUNCIL=$H is not the activation worktree ($ACTIVATION_ROOT); the receipt chain must not run from a mutable tree. Next: unset HAPAX_COUNCIL for this unit, or set HAPAX_GLMCP_SEAT_ROOT_OVERRIDE=1 in a test harness." >&2
  exit 4
fi
WDIR="$HOME/.cache/hapax/glmcp-admission-witness"
mkdir -p "$WDIR"
ts="$(date -u +%Y%m%dT%H%M%SZ)"
ref="glmcp-reviewer-roundtrip-ok-$(echo "$ts" | tr 'A-Z' 'a-z')"
# The probe measures the Coding Plan seat and nothing else, so the endpoint is the Coding Plan
# endpoint, pinned — an inherited HAPAX_GLMCP_REVIEW_BASE_URL must not redirect the sanctioned
# probe and mint a receipt for a call that never reached the plan (review finding on #4624).
endpoint="https://api.z.ai/api/coding/paas/v4"
export HAPAX_GLMCP_REVIEW_BASE_URL="$endpoint"
# Likewise the credential: the seat belongs to the Coding Plan's own entry. An inherited
# HAPAX_GLMCP_REVIEW_SECRET_ENTRY (or the override that permits alternates) could mint this
# receipt for another credential (review finding on #4624, round 4).
export HAPAX_GLMCP_REVIEW_SECRET_ENTRY="glmcp/api-key"  # pragma: allowlist secret
unset HAPAX_GLMCP_REVIEW_ALLOW_SECRET_ENTRY_OVERRIDE  # pragma: allowlist secret
# The admission CLI on main accepts exactly glm-5.2 (#4568, unmerged, moves the seat to glm-5.3).
# The systemd user environment may carry a different HAPAX_GLMCP_REVIEW_MODEL; pin the round-trip
# to the model the receipt will name, so witness and receipt describe the call that was made.
model="glm-5.2"
export HAPAX_GLMCP_REVIEW_MODEL="$model"

# 0. freshness guard — reads the dispatcher's OWN artifact: the glmcp platform-capability receipt
#    that hapax-platform-capability-receipts writes only when a fresh relay receipt AND the ledger's
#    fail-closed validator both vouch for glmcp.review.direct (#4616). Neither the raw relay receipt
#    nor the ledger's raw fields are consulted here: both have looked "fresh" while the validator
#    (and therefore the dispatcher) said otherwise (review findings on #4624, rounds 2 and 4). The
#    receipt's stale_after is what is LEFT of the seat's lifetime at generation; it is regenerated
#    every ten minutes, so this guard can only over-refresh, never under-refresh. Refreshing whenever
#    fewer than 10 minutes remain keeps the seat from lapsing between two autoqueue cycles (measured
#    2026-08-04: a receipt that lapsed mid-queue dequeued a green PR); the threshold is derived below.
#    The receipt is read through the dispatcher's own loader (`--show`: schema, platform, skew,
#    duration syntax and freshness are validated there), never by picking fields out of the JSON —
#    a document the dispatcher rejects must not make this guard skip (review finding on #4624,
#    round 8). `seat_remaining_seconds` prints the seconds left on the accepted receipt's quota
#    surface, or nothing when the dispatcher would not accept it.
seat_remaining_seconds() {
  local shown q_status q_observed q_stale stale_s show_err
  # The loader's own refusal is the diagnosis when the seat is not visible; one sanitised line of
  # it reaches the journal instead of being swallowed (measured 2026-09-03 18:49Z: the check said
  # "(none)" and nothing said why).
  show_err="$(mktemp -p "${TMPDIR:-/tmp}" glm-seat-show.XXXXXX)"
  if ! command -v jq >/dev/null 2>&1; then
    echo "  --show: jq is not on PATH, so the dispatcher's receipt cannot be read; install jq (the refresh below runs blind and its result cannot be confirmed)" >&2
    return 1
  fi
  if ! shown="$(timeout "${SHOW_TIMEOUT_S:-30}" "$H/scripts/hapax-platform-capability-receipts" --show --platform glmcp --json 2>"$show_err")"; then
    sed -E 's/(api[_-]?key|token|secret|password|bearer)([[:space:]]*[:=]?[[:space:]]*)[^[:space:]]*/\1<redacted>/Ig' "$show_err" \
      | grep -vE '^\s*$' | tail -1 | cut -c1-200 | sed 's/^/  --show: /' >&2 || true
    rm -f "$show_err"
    return 1
  fi
  rm -f "$show_err"
  local parsed
  if ! parsed="$(printf '%s' "$shown" | jq -r '
    (.receipts[] | select(.platform == "glmcp")) as $r
    | if $r.accepted != true then empty else
        [($r.quota.status // "?"), ($r.quota.observed_at // "?"), ($r.quota.stale_after // "?")] | join(" ")
      end' 2>"$show_err")"; then
    # A broken parser is not a stale seat (review finding on #4624, round 9): name it, sanitised.
    sed -E 's/(api[_-]?key|token|secret|password|bearer)([[:space:]]*[:=]?[[:space:]]*)[^[:space:]]*/\1<redacted>/Ig' "$show_err" \
      | grep -vE '^\s*$' | head -1 | cut -c1-200 | sed 's/^/  --show parse: /' >&2 || true
    rm -f "$show_err"
    return 1
  fi
  rm -f "$show_err"
  read -r q_status q_observed q_stale <<<"$parsed"
  [[ "${q_status:-}" == "observed" && -n "${q_observed:-}" && "$q_observed" != "?" ]] || return 1
  case "$q_stale" in
    *s) stale_s="${q_stale%s}" ;;
    *m) stale_s=$(( ${q_stale%m} * 60 )) ;;
    *h) stale_s=$(( ${q_stale%h} * 3600 )) ;;
    *) stale_s=0 ;;
  esac
  echo $(( $(date -u -d "$q_observed" +%s 2>/dev/null || echo 0) + stale_s - $(date -u +%s) ))
}
# The guard's threshold is DERIVED from every stage a replacement receipt passes through before the
# dispatcher can see it (review finding on #4624, round 9: the hand-written 870 covered the timer
# period and the reviewer retries only, so a routine tick that starts with ~600 s left could lapse
# during a refresh whose admission, ledger and receipt stages take up to 240 s more). OnUnitActiveSec
# counts from the previous ACTIVATION, so after a skip the next refresh can start one period later;
# AccuracySec can delay that activation; then the reviewer attempts, the admission mint, the ledger
# writer, the receipt refresh and the visibility read-back must all finish before the old receipt
# lapses. Two invariants, both checked at run time rather than promised in prose:
#   skip is safe      only when  remaining > period + chain envelope
#   a tick never lapses only when  chain envelope <= seat life - period
# If a stage timeout below is ever raised until the sums no longer fit, the script refuses to run.
TIMER_PERIOD_S=300              # hapax-glmcp-seat-refresh.timer OnUnitActiveSec=5min
TIMER_ACCURACY_S=30             # hapax-glmcp-seat-refresh.timer AccuracySec=30s
REVIEW_ATTEMPTS=2
REVIEW_ATTEMPT_TIMEOUT_S=105    # outer `timeout` around the reviewer; measured round-trips take ~4 s
REVIEW_INNER_TIMEOUT_S=90       # the reviewer's own HTTP budget, inside the outer timeout
REVIEW_RETRY_SLEEP_S=30
ADMISSION_TIMEOUT_S=60
WRITER_TIMEOUT_S=120
RECEIPTS_TIMEOUT_S=60
SHOW_TIMEOUT_S=30
SEAT_LIFE_S=900                 # DEFAULT_STALE_AFTER_SECONDS of hapax-glmcp-quota-admission
REVIEW_ENVELOPE_S=$(( REVIEW_ATTEMPTS * REVIEW_ATTEMPT_TIMEOUT_S + (REVIEW_ATTEMPTS - 1) * REVIEW_RETRY_SLEEP_S ))
CHAIN_ENVELOPE_S=$(( TIMER_ACCURACY_S + REVIEW_ENVELOPE_S + ADMISSION_TIMEOUT_S + WRITER_TIMEOUT_S + RECEIPTS_TIMEOUT_S + SHOW_TIMEOUT_S ))
SEAT_REFRESH_THRESHOLD_S=$(( TIMER_PERIOD_S + CHAIN_ENVELOPE_S ))
# After a refresh the seat is "visible" when the dispatcher's loader accepts the receipt and it
# outlives one timer period, so the next tick cannot find it lapsed.
SEAT_VISIBLE_MIN_S=$TIMER_PERIOD_S
if (( CHAIN_ENVELOPE_S > SEAT_LIFE_S - TIMER_PERIOD_S )); then
  echo "glm seat refresh REFUSED: the chain envelope (${CHAIN_ENVELOPE_S}s) exceeds seat life minus the timer period ($(( SEAT_LIFE_S - TIMER_PERIOD_S ))s), so a routine tick could lapse the seat mid-refresh. Next: shorten a stage timeout or the timer period in this script and its unit, then retry." >&2
  exit 7
fi
if [[ "${1:-}" == "--envelope" ]]; then
  printf '{"timer_period_s":%d,"timer_accuracy_s":%d,"review_attempts":%d,"review_attempt_timeout_s":%d,"review_inner_timeout_s":%d,"review_retry_sleep_s":%d,"admission_timeout_s":%d,"writer_timeout_s":%d,"receipts_timeout_s":%d,"show_timeout_s":%d,"seat_life_s":%d,"review_envelope_s":%d,"chain_envelope_s":%d,"seat_refresh_threshold_s":%d,"seat_visible_min_s":%d}\n' \
    "$TIMER_PERIOD_S" "$TIMER_ACCURACY_S" "$REVIEW_ATTEMPTS" "$REVIEW_ATTEMPT_TIMEOUT_S" "$REVIEW_INNER_TIMEOUT_S" "$REVIEW_RETRY_SLEEP_S" \
    "$ADMISSION_TIMEOUT_S" "$WRITER_TIMEOUT_S" "$RECEIPTS_TIMEOUT_S" "$SHOW_TIMEOUT_S" "$SEAT_LIFE_S" \
    "$REVIEW_ENVELOPE_S" "$CHAIN_ENVELOPE_S" "$SEAT_REFRESH_THRESHOLD_S" "$SEAT_VISIBLE_MIN_S"
  exit 0
fi
if remaining="$(seat_remaining_seconds)" && (( remaining > SEAT_REFRESH_THRESHOLD_S )); then
  echo "glm seat fresh per the dispatcher's receipt (${remaining}s remain); no round-trip"
  exit 0
fi

# 1. round-trip: a fixed one-line blind-review probe; output is counted, never stored. Three
#    attempts apart (REVIEW_RETRY_SLEEP_S): transient provider errors (measured 2026-09-02 15:36 and 16:03 — exit 1,
#    0 bytes, then exit 0 a minute later) must not leave the seat to lapse.
rc=1; bytes=0
ERR="$(mktemp -p "${TMPDIR:-/tmp}" glm-seat-err.XXXXXX)"
WOUT="$(mktemp -p "${TMPDIR:-/tmp}" glm-seat-writer.XXXXXX)"
trap 'rm -f "$ERR" "$WOUT"' EXIT
# Tests set this to 0; the unit's budget (TimeoutStartSec) is sized for the default.
retry_sleep="${HAPAX_GLMCP_SEAT_RETRY_SLEEP:-$REVIEW_RETRY_SLEEP_S}"
if ! [[ "$retry_sleep" =~ ^[0-9]+$ ]] || (( retry_sleep > REVIEW_RETRY_SLEEP_S )); then
  echo "glm seat refresh REFUSED: HAPAX_GLMCP_SEAT_RETRY_SLEEP='${retry_sleep}' is not an integer in 0..${REVIEW_RETRY_SLEEP_S}; it is a test-only override the production unit unsets. Next: unset it in the caller's environment." >&2
  exit 7
fi
for (( attempt = 1; attempt <= REVIEW_ATTEMPTS; attempt++ )); do
  set +e
  # PAYG fallback OFF: this probe measures the Coding Plan seat and nothing else. With the
  # reviewer's default fallback on, an exhausted plan answered by API credit would exit 0 and
  # mint a Coding Plan receipt for quota that does not exist (review finding on #4624).
  bytes="$(printf 'Blind review smoke. Reply with exactly: OK\n' \
    | HAPAX_GLMCP_REVIEW_TIMEOUT_SECONDS="$REVIEW_INNER_TIMEOUT_S" HAPAX_GLMCP_REVIEW_MAX_TOKENS=16 \
      HAPAX_GLMCP_REVIEW_PAYG_FALLBACK=0 \
      timeout "$REVIEW_ATTEMPT_TIMEOUT_S" "$H/scripts/hapax-glmcp-reviewer" 2>"$ERR" | wc -c)"
  rc=${PIPESTATUS[1]:-$?}
  set -e
  echo "roundtrip attempt $attempt: exit=$rc output_bytes=$bytes endpoint=$endpoint model=$model"
  if [[ "$rc" -eq 0 && "$bytes" -gt 0 ]]; then break; fi
  # Why it failed, sanitised (a guard's error text is a disclosure channel): first two lines,
  # anything key/token/secret/bearer-shaped redacted. Measured 2026-09-02 16:05: two consecutive
  # failures lapsed the seat for five minutes and the autoqueue dequeued a green PR inside them.
  # The redaction also swallows a value separated by whitespace or `:`/`=` ("Bearer abc",
  # "api_key = abc"), and an empty stderr must not end the retry loop under pipefail.
  sed -E 's/(api[_-]?key|token|secret|password|bearer)([[:space:]]*[:=]?[[:space:]]*)[^[:space:]]*/\1<redacted>/Ig' "$ERR" \
    | grep -vE '^\s*$' | head -2 | cut -c1-200 | sed 's/^/  reviewer stderr: /' || true
  [[ "$attempt" -lt "$REVIEW_ATTEMPTS" ]] && sleep "$retry_sleep"
done
if [[ "$rc" -ne 0 || "$bytes" -eq 0 ]]; then
  echo "glm seat NOT refreshed: reviewer round-trip failed (exit $rc, $bytes bytes). Next: read the reviewer's stderr by hand; do not mint." >&2
  exit 2
fi

# 2. witness (schema v1), same shape as the 2026-08-04 witnesses.
cat > "$WDIR/$ref.yaml" <<EOF
schema: hapax.glmcp_admission_witness.v1
witness_ref: $ref
host: $(hostname)
observed_at: $(date -u +%Y-%m-%dT%H:%M:%SZ)
supported_tool: hapax-glmcp-reviewer
endpoint: $endpoint
model: $model
invocation_exit_code: $rc
prompt_or_output_persisted: false
secret_value_persisted: false
EOF
echo "witness: $WDIR/$ref.yaml"

# 3. passive admission receipt, 4. telemetry writer.
# A failed admission write must say so and name the next action, never die silently under errexit
# (review finding on #4624, round 5): the witness is already on disk, so the operator can re-run
# observe-success by hand with the same evidence ref.
set +e
timeout "$ADMISSION_TIMEOUT_S" "$H/scripts/hapax-glmcp-quota-admission" observe-success \
  --evidence-ref "$ref" --supported-tool hapax-glmcp-reviewer --endpoint "$endpoint" --model "$model" \
  >"$WOUT" 2>&1
admission_rc=$?
set -e
sed 's/\x1b\[[0-9;]*m//g' "$WOUT" | grep -vE '^\s*$' | tail -3 | cut -c1-200 || true
if [[ "$admission_rc" -ne 0 ]]; then
  echo "glm seat NOT admitted: hapax-glmcp-quota-admission exited $admission_rc after a successful round-trip (witness $WDIR/$ref.yaml). Next: run $H/scripts/hapax-glmcp-quota-admission observe-success --evidence-ref $ref --supported-tool hapax-glmcp-reviewer --endpoint $endpoint --model $model by hand and read its output." >&2
  exit 5
fi
# The writer rebuilds the live ledger from the relay receipts — LEDGER ONLY. Its default run
# refreshes every platform's capability receipt first (against the ledger it has not yet rebuilt,
# so a glmcp receipt minted there carries the PREVIOUS seat's remaining lifetime) and spends a
# real Codex exec-auth sentinel on every call; neither belongs in a five-minute GLM timer (review
# finding on #4624, round 8). The glmcp receipt is derived from the fresh ledger below instead.
# The writer's own diagnostics are printed, never filtered away. The admission receipt is already
# minted at this point; a writer failure is fatal and names its next action.
set +e
timeout "$WRITER_TIMEOUT_S" "$H/scripts/hapax-quota-telemetry-writer" --skip-receipts >"$WOUT" 2>&1
writer_rc=$?
set -e
sed 's/\x1b\[[0-9;]*m//g' "$WOUT" | grep -vE '^\s*$' | tail -4 | cut -c1-200 || true
case "$writer_rc" in
  0) ;;
  3)
    # Since round 6 the dispatcher's glmcp platform receipt IS what this script (and the
    # dispatcher) read for freshness. Exit 3 means that receipt refresh degraded, so the seat is
    # NOT visible even though the ledger was written: a failure with its next action, never a
    # success (review finding on #4624, round 6).
    echo "glm seat NOT visible: the telemetry writer wrote the live ledger but the capability-receipt refresh degraded (exit 3), so the dispatcher's glmcp receipt was not renewed. Next: run $H/scripts/hapax-platform-capability-receipts --platform glmcp by hand and read why." >&2
    exit 6
    ;;
  *)
    echo "telemetry writer failed (exit $writer_rc) AFTER the admission receipt was minted: the seat is refreshed but the live ledger may be stale. Next: run $H/scripts/hapax-quota-telemetry-writer by hand and read its output." >&2
    exit 3
    ;;
esac

# 5. the dispatcher's glmcp receipt, derived from the ledger that now carries the new admission,
#    then read back through the dispatcher's loader. A writer exit of zero proves the ledger was
#    written, not that the seat became visible; only the accepted receipt does (review finding on
#    #4624, round 8).
set +e
timeout "$RECEIPTS_TIMEOUT_S" "$H/scripts/hapax-platform-capability-receipts" --platform glmcp >"$WOUT" 2>&1
receipts_rc=$?
set -e
sed 's/\x1b\[[0-9;]*m//g' "$WOUT" | grep -vE '^\s*$' | tail -2 | cut -c1-200 || true
if [[ "$receipts_rc" -ne 0 ]]; then
  echo "glm seat NOT visible: the glmcp capability receipt could not be refreshed from the new ledger (exit $receipts_rc) after the admission was minted. Next: run $H/scripts/hapax-platform-capability-receipts --platform glmcp by hand and read why." >&2
  exit 6
fi
if ! remaining="$(seat_remaining_seconds)" || (( remaining <= SEAT_VISIBLE_MIN_S )); then
  echo "glm seat NOT visible: the dispatcher's glmcp receipt does not carry an accepted, observed quota surface with more than ${SEAT_VISIBLE_MIN_S} s left (${remaining:-none}) after the admission was minted and the ledger rebuilt. Next: run $H/scripts/hapax-platform-capability-receipts --show --platform glmcp and compare its reason with the relay receipt in \$HOME/.cache/hapax/relay/receipts." >&2
  exit 6
fi
echo "glm seat visible to the dispatcher: ${remaining}s remain on the accepted glmcp receipt"
