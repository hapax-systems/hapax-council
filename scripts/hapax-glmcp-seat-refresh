#!/usr/bin/env bash
# Refresh the GLM review seat: one real sanctioned reviewer round-trip, a witness (schema v1:
# no prompt, output or secret persisted), the passive admission receipt, the telemetry writer.
# Prints states only. Exit non-zero if the round-trip fails — no receipt is minted then.
set -euo pipefail
# The scripts this calls come from the activation worktree (main, activated by the governed loop),
# never from a mutable development checkout (review finding on #4624).
H="${HAPAX_COUNCIL:-$HOME/.cache/hapax/source-activation/worktree}"
ACTIVATION_ROOT="$HOME/.cache/hapax/source-activation/worktree"
# An inherited HAPAX_COUNCIL must not redirect governance-sensitive receipt minting to a mutable
# tree (review finding on #4624, round 2): refuse any other root unless a test says so explicitly.
if [[ "$H" != "$ACTIVATION_ROOT" && "${HAPAX_GLMCP_SEAT_ROOT_OVERRIDE:-0}" != "1" ]]; then
  echo "glm seat refresh REFUSED: HAPAX_COUNCIL=$H is not the activation worktree ($ACTIVATION_ROOT); the receipt chain must not run from a mutable tree. Next: unset HAPAX_COUNCIL for this unit, or set HAPAX_GLMCP_SEAT_ROOT_OVERRIDE=1 in a test harness." >&2
  exit 4
fi
WDIR="$HOME/.cache/hapax/glmcp-admission-witness"
mkdir -p "$WDIR"
ts="$(date -u +%Y%m%dT%H%M%SZ)"
ref="glmcp-reviewer-roundtrip-ok-$(echo "$ts" | tr 'A-Z' 'a-z')"
# The probe measures the Coding Plan seat and nothing else, so the endpoint is the Coding Plan
# endpoint, pinned — an inherited HAPAX_GLMCP_REVIEW_BASE_URL must not redirect the sanctioned
# probe and mint a receipt for a call that never reached the plan (review finding on #4624).
endpoint="https://api.z.ai/api/coding/paas/v4"
export HAPAX_GLMCP_REVIEW_BASE_URL="$endpoint"
# Likewise the credential: the seat belongs to the Coding Plan's own entry. An inherited
# HAPAX_GLMCP_REVIEW_SECRET_ENTRY (or the override that permits alternates) could mint this
# receipt for another credential (review finding on #4624, round 4).
export HAPAX_GLMCP_REVIEW_SECRET_ENTRY="glmcp/api-key"  # pragma: allowlist secret
unset HAPAX_GLMCP_REVIEW_ALLOW_SECRET_ENTRY_OVERRIDE  # pragma: allowlist secret
# The admission CLI on main accepts exactly glm-5.2 (#4568, unmerged, moves the seat to glm-5.3).
# The systemd user environment may carry a different HAPAX_GLMCP_REVIEW_MODEL; pin the round-trip
# to the model the receipt will name, so witness and receipt describe the call that was made.
model="glm-5.2"
export HAPAX_GLMCP_REVIEW_MODEL="$model"

# 0. freshness guard — reads the dispatcher's OWN artifact: the glmcp platform-capability receipt
#    that hapax-platform-capability-receipts writes only when a fresh relay receipt AND the ledger's
#    fail-closed validator both vouch for glmcp.review.direct (#4616). Neither the raw relay receipt
#    nor the ledger's raw fields are consulted here: both have looked "fresh" while the validator
#    (and therefore the dispatcher) said otherwise (review findings on #4624, rounds 2 and 4). The
#    receipt's stale_after is what is LEFT of the seat's lifetime at generation; it is regenerated
#    every ten minutes, so this guard can only over-refresh, never under-refresh. Refreshing whenever
#    fewer than 10 minutes remain keeps the seat from lapsing between two autoqueue cycles (measured
#    2026-08-04: a receipt that lapsed mid-queue dequeued a green PR).
R="$HOME/.cache/hapax/platform-capability-receipts/glmcp.json"
if [[ -f "$R" ]] && command -v jq >/dev/null; then
  read -r q_status q_generated q_stale < <(jq -r '[(.quota.status // "?"), (.generated_at // "?"), (.quota.stale_after // "?")] | join(" ")' "$R" 2>/dev/null || echo "? ? ?")
  if [[ "$q_status" == "observed" && "$q_generated" != "?" ]]; then
    case "$q_stale" in
      *s) stale_s="${q_stale%s}" ;;
      *m) stale_s=$(( ${q_stale%m} * 60 )) ;;
      *h) stale_s=$(( ${q_stale%h} * 3600 )) ;;
      *) stale_s=0 ;;
    esac
    remaining=$(( $(date -u -d "$q_generated" +%s 2>/dev/null || echo 0) + stale_s - $(date -u +%s) ))
    if (( remaining > 600 )); then
      echo "glm seat fresh per the dispatcher's receipt (${remaining}s remain); no round-trip"
      exit 0
    fi
  fi
fi

# 1. round-trip: a fixed one-line blind-review probe; output is counted, never stored. Three
#    attempts 15 s apart: transient provider errors (measured 2026-09-02 15:36 and 16:03 — exit 1,
#    0 bytes, then exit 0 a minute later) must not leave the seat to lapse.
rc=1; bytes=0
ERR="$(mktemp -p "${TMPDIR:-/tmp}" glm-seat-err.XXXXXX)"
WOUT="$(mktemp -p "${TMPDIR:-/tmp}" glm-seat-writer.XXXXXX)"
trap 'rm -f "$ERR" "$WOUT"' EXIT
# Tests set this to 0; the unit's budget (TimeoutStartSec) is sized for the default.
retry_sleep="${HAPAX_GLMCP_SEAT_RETRY_SLEEP:-15}"
for attempt in 1 2 3; do
  set +e
  # PAYG fallback OFF: this probe measures the Coding Plan seat and nothing else. With the
  # reviewer's default fallback on, an exhausted plan answered by API credit would exit 0 and
  # mint a Coding Plan receipt for quota that does not exist (review finding on #4624).
  bytes="$(printf 'Blind review smoke. Reply with exactly: OK\n' \
    | HAPAX_GLMCP_REVIEW_TIMEOUT_SECONDS=120 HAPAX_GLMCP_REVIEW_MAX_TOKENS=16 \
      HAPAX_GLMCP_REVIEW_PAYG_FALLBACK=0 \
      timeout 180 "$H/scripts/hapax-glmcp-reviewer" 2>"$ERR" | wc -c)"
  rc=${PIPESTATUS[1]:-$?}
  set -e
  echo "roundtrip attempt $attempt: exit=$rc output_bytes=$bytes endpoint=$endpoint model=$model"
  if [[ "$rc" -eq 0 && "$bytes" -gt 0 ]]; then break; fi
  # Why it failed, sanitised (a guard's error text is a disclosure channel): first two lines,
  # anything key/token/secret/bearer-shaped redacted. Measured 2026-09-02 16:05: two consecutive
  # failures lapsed the seat for five minutes and the autoqueue dequeued a green PR inside them.
  # The redaction also swallows a value separated by whitespace or `:`/`=` ("Bearer abc",
  # "api_key = abc"), and an empty stderr must not end the retry loop under pipefail.
  sed -E 's/(api[_-]?key|token|secret|password|bearer)([[:space:]]*[:=]?[[:space:]]*)[^[:space:]]*/\1<redacted>/Ig' "$ERR" \
    | grep -vE '^\s*$' | head -2 | cut -c1-200 | sed 's/^/  reviewer stderr: /' || true
  [[ "$attempt" -lt 3 ]] && sleep "$retry_sleep"
done
if [[ "$rc" -ne 0 || "$bytes" -eq 0 ]]; then
  echo "glm seat NOT refreshed: reviewer round-trip failed (exit $rc, $bytes bytes). Next: read the reviewer's stderr by hand; do not mint." >&2
  exit 2
fi

# 2. witness (schema v1), same shape as the 2026-08-04 witnesses.
cat > "$WDIR/$ref.yaml" <<EOF
schema: hapax.glmcp_admission_witness.v1
witness_ref: $ref
host: $(hostname)
observed_at: $(date -u +%Y-%m-%dT%H:%M:%SZ)
supported_tool: hapax-glmcp-reviewer
endpoint: $endpoint
model: $model
invocation_exit_code: $rc
prompt_or_output_persisted: false
secret_value_persisted: false
EOF
echo "witness: $WDIR/$ref.yaml"

# 3. passive admission receipt, 4. telemetry writer.
timeout 60 "$H/scripts/hapax-glmcp-quota-admission" observe-success \
  --evidence-ref "$ref" --supported-tool hapax-glmcp-reviewer --endpoint "$endpoint" --model "$model" \
  | sed 's/\x1b\[[0-9;]*m//g' | tail -3
# The writer's own diagnostics are printed, never filtered away: exit 3 means the live ledger was
# written but the ancillary capability-receipt refresh degraded, which the journal must show
# (review finding on #4624). The admission receipt is already minted at this point, so the seat
# IS refreshed; only an outright writer failure is fatal, and it names its next action.
set +e
timeout 120 "$H/scripts/hapax-quota-telemetry-writer" >"$WOUT" 2>&1
writer_rc=$?
set -e
sed 's/\x1b\[[0-9;]*m//g' "$WOUT" | grep -vE '^\s*$' | tail -4 | cut -c1-200 || true
case "$writer_rc" in
  0) ;;
  3) echo "telemetry writer: live ledger written, capability receipts degraded (exit 3); the seat is refreshed" ;;
  *)
    echo "telemetry writer failed (exit $writer_rc) AFTER the admission receipt was minted: the seat is refreshed but the live ledger may be stale. Next: run $H/scripts/hapax-quota-telemetry-writer by hand and read its output." >&2
    exit 3
    ;;
esac

# 5. what the dispatcher will now see.
L="$HOME/.cache/hapax/orchestration/quota-spend-ledger-live.json"
if [[ -f "$L" ]] && command -v jq >/dev/null; then
  jq -r '.. | objects | select(has("platform") and (.platform|tostring|test("glm"))) | "\(.platform): \(.status // .state // .admission // "?") \(.observed_at // .checked_at // "")"' "$L" 2>/dev/null | head -3
  jq -r '(.platforms // .providers // {}) | to_entries[]? | select(.key|test("glm")) | "\(.key): \((.value.status // .value.state // .value.admission // .value) | tostring | .[0:140])"' "$L" 2>/dev/null | head -3
fi
