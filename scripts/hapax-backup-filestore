#!/usr/bin/env bash
set -euo pipefail

# hapax-backup-filestore — back up this host's hapax-secret FileStore into the tier-1 NAS restic repository, then
# verify the new snapshot by path listing: it must hold the store's .key and at least as many .bin entries as the
# store has now. Names only: no secret value is ever read or printed.
#
# Row filestore-secrets-backup-custody-all-hosts-20260927 (seat design ruling 2026-09-27 14:21Z). Since the
# 2026-09-16 migration the FileStore (~/.config/reins/secrets: the .key and one .bin per entry) holds the estate's
# secrets. Podium's tier-1 job backs it up (#4813); this unit covers every other host that runs a store, starting with
# appendix. It reuses tier-1: the same repository and password, tag tier1-filestore, and podium's tier-1 forget
# (--group-by host,tags) applies the normal retention. Secrets are superseded, not accumulated, so they are not kept
# forever. The unit is systemd/units/hapax-backup-filestore.service.

# The installed entry points may be ~/.local/bin symlinks into the release tree, so the lib is resolved beside the
# target, as in scripts/hapax-backup-watchdog.
_hapax_self="$(/usr/bin/readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
. "${_hapax_self%/*}/lib/secret.sh"

STORE="${REINS_SECRET_STORE:-$HOME/.config/reins/secrets}"
REPO="${RESTIC_REPOSITORY:-/mnt/nas/backups/restic}"
REQUIRED_MOUNT="${HAPAX_FILESTORE_REPOSITORY_MOUNT:-/mnt/nas/backups}"
PASSWORD_ENTRY="${HAPAX_TIER1_RESTIC_PASSWORD_ENTRY:-backups/restic-password}"
TAG="tier1-filestore"
HOST="$(hostname)"
REMEDY="next action: check the store (ls $STORE, names only), the NAS mount (findmnt $REQUIRED_MOUNT) and \`hapax-secret --where $PASSWORD_ENTRY\`; then rerun \`systemctl --user start hapax-backup-filestore.service\` and read its journal"

die() {
    echo "hapax-backup-filestore: FATAL: $1; $REMEDY" >&2
    exit 1
}

[[ -f "$STORE/.key" ]] || die "no FileStore at $STORE (no .key)"
[[ -f "$REPO/config" ]] || die "no restic repository at $REPO (is the NAS mounted?)"
# An unmounted NAS path falls through to another filesystem; the repository must sit on the named mount.
mount="$(findmnt -n -o TARGET --target "$REPO" 2>/dev/null | tail -1)"
[[ "$mount" == "$REQUIRED_MOUNT" ]] || die "$REPO is on '${mount:-?}', not on the required mount $REQUIRED_MOUNT"

RESTIC_PASSWORD="$(hapax_secret_read "$PASSWORD_ENTRY")" || die "cannot read the restic password '$PASSWORD_ENTRY' from the FileStore"
[[ -n "$RESTIC_PASSWORD" ]] || die "the restic password '$PASSWORD_ENTRY' is empty"
export RESTIC_PASSWORD RESTIC_REPOSITORY="$REPO"

expected="$(find "$STORE" -maxdepth 1 -type f -name '*.bin' | wc -l)"

snapshot="$(restic backup --json --tag "$TAG" --host "$HOST" "$STORE" \
    | jq -r 'select(.message_type == "summary") | .snapshot_id')" \
    || die "restic backup of $STORE failed"
[[ -n "$snapshot" ]] || die "restic backup of $STORE reported no snapshot"

# The verify reads the snapshot's path listing only.
listing="$(restic ls --json "$snapshot" | jq -r 'select(.struct_type == "node" and .type == "file") | .path')" \
    || die "cannot list snapshot ${snapshot:0:8}"
has_key="$(grep -cxF "$STORE/.key" <<<"$listing" || true)"
bins="$(grep -cE "^${STORE//./\\.}/[^/]+\.bin$" <<<"$listing" || true)"

if [[ "$has_key" -ne 1 ]]; then
    die "snapshot ${snapshot:0:8} does not hold $STORE/.key"
fi
if (( bins < expected )); then
    die "snapshot ${snapshot:0:8} holds $bins entries, fewer than the store's $expected"
fi
echo "hapax-backup-filestore: snapshot ${snapshot:0:8} ($TAG, host $HOST) holds $STORE/.key and $bins of $expected entries (names only)"
