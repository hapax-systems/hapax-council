#!/usr/bin/env bash
# experiment-check — validate all workstation optimizations before a SCED session
# (bash port of experiment-check.fish, fish-to-bash estate migration 2026-08-10)

pass_count=0
fail_count=0

check() {
    local label="$1" result="$2" expected="$3"
    if [ "$result" = "$expected" ]; then
        echo "  [PASS] $label"
        pass_count=$((pass_count + 1))
    else
        echo "  [FAIL] $label (got: $result, expected: $expected)"
        fail_count=$((fail_count + 1))
    fi
}

echo "=== Experiment Readiness Check ==="
echo ""

# Python runtime
echo "Python Runtime:"
uvloop_ok=$(uv run python -c "import uvloop; print('ok')" 2>/dev/null)
check "uvloop importable" "$uvloop_ok" "ok"

# GPU
echo "GPU:"
gpu_clock=$(nvidia-smi --query-gpu=clocks.gr --format=csv,noheader,nounits 2>/dev/null | tr -d '[:space:]')
check "GPU clock locked at 1800 MHz" "$gpu_clock" "1800"

power_limit=$(nvidia-smi --query-gpu=power.limit --format=csv,noheader,nounits 2>/dev/null | tr -d '[:space:]')
check "Power limit 350W" "$power_limit" "350.00"

# Ollama
echo "Ollama:"
ollama_parallel=$(systemctl show ollama --property=Environment 2>/dev/null | grep -oP 'OLLAMA_NUM_PARALLEL=\K[^ "]*')
check "OLLAMA_NUM_PARALLEL=1" "$ollama_parallel" "1"

ollama_keepalive=$(systemctl show ollama --property=Environment 2>/dev/null | grep -oP 'OLLAMA_KEEP_ALIVE=\K[^ "]*')
check "OLLAMA_KEEP_ALIVE=24h" "$ollama_keepalive" "24h"

ollama_ctx=$(systemctl show ollama --property=Environment 2>/dev/null | grep -oP 'OLLAMA_CONTEXT_LENGTH=\K[^ "]*')
check "OLLAMA_CONTEXT_LENGTH=4096" "$ollama_ctx" "4096"

# PipeWire
echo "PipeWire:"
pw_quantum=$(pw-cli info 0 2>/dev/null | grep 'default.clock.quantum =' | sed -r 's/.*"([0-9]+)".*/\1/')
check "PipeWire quantum=128" "$pw_quantum" "128"

# Sysctl
echo "Sysctl:"
dirty_bytes=$(sysctl -n vm.dirty_bytes 2>/dev/null)
check "vm.dirty_bytes=134217728" "$dirty_bytes" "134217728"

dirty_bg=$(sysctl -n vm.dirty_background_bytes 2>/dev/null)
check "vm.dirty_background_bytes=33554432" "$dirty_bg" "33554432"

# Redis
echo "Redis:"
# password read from the running container's own args — never committed here
redis_pw=$(docker inspect --format '{{range .Args}}{{println .}}{{end}}' redis 2>/dev/null | grep -A1 '^--requirepass$' | tail -1)
redis_policy=$(docker exec redis redis-cli --no-auth-warning -a "$redis_pw" CONFIG GET maxmemory-policy 2>/dev/null | tail -1)
check "Redis maxmemory-policy=noeviction" "$redis_policy" "noeviction"

# Qdrant
echo "Qdrant:"
qdrant_healthy=$(docker inspect --format='{{.State.Health.Status}}' qdrant 2>/dev/null)
check "Qdrant healthy" "$qdrant_healthy" "healthy"

# IRQ affinity
echo "IRQ Affinity:"
irq_banned=$(systemctl show irqbalance --property=Environment 2>/dev/null | grep -oP 'IRQBALANCE_BANNED_CPUS=\K[^ "]*')
check "IRQ CPUs 14-15 banned" "$irq_banned" "0000c000"

echo ""
echo "=== Results: $pass_count passed, $fail_count failed ==="

if [ "$fail_count" -gt 0 ]; then
    echo "EXPERIMENT NOT READY — fix failures above before starting a session."
    exit 1
else
    echo "All checks passed. Workstation ready for experiment."
    exit 0
fi
