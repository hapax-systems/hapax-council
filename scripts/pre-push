#!/usr/bin/env bash
# git pre-push hook — scan-before-push (operator-accepted rule, 2026-09-02).
#
# This file is named for git's hook protocol and lives in scripts/ so that it is REPO-VERSIONED
# (uniform scope of effect, every clone that opts in gets the same rule). A clone opts in with:
#     git config core.hooksPath scripts
# which git resolves relative to each worktree's top level, so one setting covers all worktrees.
# No push leaves an opted-in clone without a detect-secrets + home-path scan of the new commits.
# Exemptions only by `git config --add hapax.prepushScan.skipRemote <remote-name>` (private mirrors).
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
scan="$root/scripts/hapax-prepush-secret-scan"
if [ ! -f "$scan" ]; then
  # A worktree checked out at a commit without the scanner: use the main checkout's copy, and
  # refuse (not pass) if neither exists — the absence of the scanner is not a clean scan.
  scan="$(git rev-parse --path-format=absolute --git-common-dir)/../scripts/hapax-prepush-secret-scan"
  [ -f "$scan" ] || { echo "pre-push: scanner missing at $root/scripts/hapax-prepush-secret-scan — refusing" >&2; exit 3; }
fi
exec python3 "$scan" "$@"
