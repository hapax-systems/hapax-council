#!/usr/bin/env bash
# hapax-kimi ROLE [--continue] — launch a kimi lane the coordinator can see.
#
# WHY: the coordinator discovers lanes by tmux session prefix (SESSION_PREFIXES), and until
# this launcher there was no ("hapax-kimi-", "kimi") entry — a kimi session was structurally
# invisible to reins: no row, no claim, no freshness. This launcher gives a kimi lane the same
# estate surface as a claude lane: tmux name hapax-kimi-<role>, the session-role marker, the
# relay-retire EXIT trap, and the kimi transcript replay (-c) so resume is one command.
#
# Usage:
#   hapax-kimi <role>              new session for <role> (tmux hapax-kimi-<role>)
#   hapax-kimi <role> --continue   replay the last session for this cwd (kimi -c)
#   hapax-kimi <role> --terminal none   run in the current terminal instead of tmux
set -euo pipefail

ROLE="${1:?usage: hapax-kimi <role> [--continue] [--terminal none]}"
shift || true

CONTINUE=0
TERMINAL="tmux"
while [ $# -gt 0 ]; do
  case "$1" in
    --continue|-c) CONTINUE=1 ;;
    --terminal) TERMINAL="${2:?--terminal needs a value}"; shift ;;
    *) echo "hapax-kimi: unknown arg $1" >&2; exit 2 ;;
  esac
  shift || true
done

KIMI_BIN="${KIMI_BIN:-$HOME/.kimi-code/bin/kimi}"
SESSION="hapax-kimi-$ROLE"
COUNCIL_DIR="${HAPAX_COUNCIL_DIR:-$HOME/projects/hapax-council}"
# This script's own tree first; COUNCIL_DIR's default does not exist under every HOME.
_hk_self="${BASH_SOURCE[0]:-$0}"
if command -v readlink >/dev/null 2>&1; then
  _hk_self="$(readlink -f "$_hk_self" 2>/dev/null || printf '%s' "$_hk_self")"
fi
ROLE_HELPER="$(cd "$(dirname "$_hk_self")/.." 2>/dev/null && pwd)/hooks/scripts/agent-role.sh"
[ -f "$ROLE_HELPER" ] || ROLE_HELPER="$COUNCIL_DIR/hooks/scripts/agent-role.sh"
if [ -f "$ROLE_HELPER" ]; then
  # shellcheck source=../hooks/scripts/agent-role.sh
  # shellcheck disable=SC1091
  . "$ROLE_HELPER"
fi
if ! declare -F hapax_launch_session_id >/dev/null 2>&1; then
  echo "hapax-kimi: identity helper not found (looked for $ROLE_HELPER); next action: run from a complete council checkout or set HAPAX_COUNCIL_DIR" >&2
  exit 9
fi
# Already minted unconditionally before this change; routed through the shared
# helper so all six launchers carry ONE implementation of the contract. This
# launcher's runner execs $KIMI_BIN directly, so there is no pinned-propagation
# case (claims-ontology-correction).
SESSION_UUID="$(hapax_launch_session_id)"
WORKDIR="${HAPAX_KIMI_WORKDIR:-$HOME}"

if tmux has-session -t "$SESSION" 2>/dev/null; then
  echo "hapax-kimi: session $SESSION already exists — attach with: tmux attach -t $SESSION" >&2
  exit 12
fi

printf '%s\n' "$ROLE" >"$HOME/.cache/hapax/session-role-$SESSION_UUID" 2>/dev/null || true

KIMI_ARGS=(--add-dir "$HOME/Documents/Personal/20-projects/hapax-cc-tasks" --add-dir "$HOME/.cache/hapax")
if [ "$CONTINUE" = "1" ]; then
  KIMI_ARGS=(--continue --auto "${KIMI_ARGS[@]}")
fi

RELAY_RETIRE="$COUNCIL_DIR/scripts/hapax-relay-retire"

if [ "$TERMINAL" = "none" ]; then
  trap '"$RELAY_RETIRE" "$ROLE" --reason "clean exit (terminal=none)" 2>/dev/null || true' EXIT
  cd "$WORKDIR"
  export HAPAX_AGENT_INTERFACE=kimi HAPAX_AGENT_ROLE="$ROLE" HAPAX_SESSION_ID="$SESSION_UUID"
  exec "$KIMI_BIN" "${KIMI_ARGS[@]}"
fi

SPAWN_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/hapax/kimi-spawns"
mkdir -p "$SPAWN_DIR"
RUNNER="$SPAWN_DIR/run-$(date -u +%Y%m%dT%H%M%SZ)-$ROLE.sh"
{
  printf '%s\n' '#!/usr/bin/env bash'
  printf '%s\n' 'set -euo pipefail'
  printf 'trap '\''%q %q --reason "clean exit (tmux)" 2>/dev/null || true'\'' EXIT\n' "$RELAY_RETIRE" "$ROLE"
  printf 'cd %q\n' "$WORKDIR"
  printf 'export HAPAX_AGENT_INTERFACE=kimi\n'
  printf 'export HAPAX_AGENT_ROLE=%q\n' "$ROLE"
  printf 'export HAPAX_SESSION_ID=%q\n' "$SESSION_UUID"
  printf 'exec %q' "$KIMI_BIN"
  for arg in "${KIMI_ARGS[@]}"; do
    printf ' %q' "$arg"
  done
  printf '\n'
} >"$RUNNER"
chmod 700 "$RUNNER"

tmux new-session -d -s "$SESSION" "$RUNNER"
echo "hapax-kimi: lane $ROLE up at tmux session $SESSION"
