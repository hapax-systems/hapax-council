#!/usr/bin/env python3
"""Query the plan/analysis corpus so a search returns the archipelago, not an island.

The failure this exists to stop, observed repeatedly: a search finds one document about a
topic, the reader treats it as the topic, and writes something wrong because three sibling
documents -- a predecessor it supersedes, a parallel analysis of equal weight, a later
refresh that retired it -- were never seen. Ripgrep answers "where does this string
appear"; it does not answer "what is the full set of documents about this, in what order,
and which of them are dead."

Design commitments, each one a direct response to that failure:

* **Never return one result.** The default is a cluster. A single-document answer to a
  corpus question is the bug, so the tool refuses to present one.
* **Rank by density, not presence.** A document that mentions a term twice is not about it.
  Hit-density separates the topic documents from the passing mentions.
* **Surface supersession loudly.** ``status: retired`` / ``superseded`` and
  ``supersedes_refs`` are printed with the result, not left for the reader to discover
  after quoting a dead position.
* **Show the neighbours.** ``--related`` takes a document and returns the others that share
  its vocabulary, which is how you find the sibling nobody linked.

This is deliberately an ad-hoc instrument. It is a flat index over markdown, not a
knowledge graph, and it should be replaced by something with real provenance edges once the
inflection/plan layer has a schema. It is committed rather than kept in a scratch directory
because the failure it prevents recurs every session, and an instrument that is not to hand
is an instrument that is not used.
"""

from __future__ import annotations

import argparse
import json
import math
import os
import re
import sys
from collections import Counter
from dataclasses import dataclass, field
from pathlib import Path

DEFAULT_ROOTS = [
    Path.home() / "Documents" / "Personal" / "30-areas" / "hapax",
    Path.home() / "Documents" / "Personal" / "20-projects" / "hapax-requests",
]

CACHE_PATH = Path(
    os.environ.get(
        "HAPAX_CORPUS_INDEX",
        str(Path.home() / ".cache" / "hapax" / "corpus" / "corpus-index.json"),
    )
)

#: Directories that are transcript dumps or message logs rather than plans. They swamp the
#: ranking with incidental term matches and answer a different question.
SKIP_DIR_PARTS = {"lanebus", "_archive-complete", "operator-corpus", "recovered-transcript-index"}

TOKEN_RE = re.compile(r"[a-z][a-z0-9_-]{2,}")

STOPWORDS = frozenset(
    [
        "the",
        "and",
        "for",
        "that",
        "this",
        "with",
        "from",
        "have",
        "has",
        "not",
        "are",
        "was",
        "were",
        "will",
        "would",
        "should",
        "could",
        "can",
        "may",
        "might",
        "must",
        "shall",
        "into",
        "onto",
        "over",
        "under",
        "above",
        "below",
        "when",
        "where",
        "which",
        "who",
        "whom",
        "what",
        "why",
        "how",
        "all",
        "any",
        "both",
        "each",
        "few",
        "more",
        "most",
        "other",
        "some",
        "such",
        "only",
        "own",
        "same",
        "than",
        "too",
        "very",
        "just",
        "also",
        "then",
        "once",
        "here",
        "there",
        "its",
        "it's",
        "about",
        "against",
        "between",
        "through",
        "during",
        "before",
        "after",
        "because",
        "while",
        "until",
        "they",
        "them",
        "their",
        "there's",
        "you",
        "your",
        "our",
        "ours",
        "out",
        "off",
        "per",
        "via",
        "etc",
        "ie",
        "eg",
        "one",
        "two",
        "three",
        "new",
        "now",
        "still",
        "yet",
        "been",
        "being",
        "does",
        "did",
        "done",
        "make",
        "made",
        "use",
        "used",
        "using",
        "uses",
        "like",
        "well",
        "much",
        "many",
        "way",
        "ways",
        "thing",
        "things",
        "time",
        "times",
        "case",
        "cases",
        "doc",
        "docs",
        "file",
        "files",
        "line",
        "lines",
        "note",
        "notes",
        "page",
        "pages",
        "part",
        "parts",
    ]
)

RETIRED_STATUSES = {"retired", "superseded", "withdrawn", "obsolete", "dead", "replaced"}


@dataclass
class Doc:
    path: str
    name: str
    title: str = ""
    doc_type: str = ""
    status: str = ""
    created: str = ""
    mtime: str = ""
    supersedes: list[str] = field(default_factory=list)
    tags: list[str] = field(default_factory=list)
    size: int = 0
    counts: dict[str, int] = field(default_factory=dict)
    total_tokens: int = 0

    @property
    def is_dead(self) -> bool:
        return self.status.strip().lower() in RETIRED_STATUSES


def _frontmatter(text: str) -> dict[str, str]:
    """Flat scalar frontmatter only. A real YAML parse is not worth the dependency here."""
    if not text.startswith("---"):
        return {}
    end = text.find("\n---", 3)
    if end == -1:
        return {}
    out: dict[str, str] = {}
    for line in text[3:end].splitlines():
        if not line or line[0].isspace() or ":" not in line:
            continue
        key, _, value = line.partition(":")
        out[key.strip()] = value.strip().strip("\"'")
    return out


def _first_heading(text: str) -> str:
    for line in text.splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    return ""


def _supersedes(text: str) -> list[str]:
    block = re.search(r"^supersedes_refs:\s*$((?:\n\s+-\s*.+)+)", text, re.M)
    if not block:
        return []
    return [m.strip().strip("\"'") for m in re.findall(r"-\s*(.+)", block.group(1))]


def build_index(roots: list[Path]) -> list[Doc]:
    docs: list[Doc] = []
    for root in roots:
        if not root.is_dir():
            continue
        for path in root.rglob("*.md"):
            if SKIP_DIR_PARTS & set(path.parts):
                continue
            try:
                text = path.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
            fm = _frontmatter(text)
            tokens = [t for t in TOKEN_RE.findall(text.lower()) if t not in STOPWORDS]
            counts = Counter(tokens)
            try:
                mtime = path.stat().st_mtime
            except OSError:
                mtime = 0.0
            docs.append(
                Doc(
                    path=str(path),
                    name=path.name,
                    title=fm.get("title") or _first_heading(text),
                    doc_type=fm.get("type", ""),
                    status=fm.get("status", ""),
                    created=fm.get("created_at", fm.get("created", "")),
                    mtime=__import__("datetime").datetime.fromtimestamp(mtime).strftime("%Y-%m-%d"),
                    supersedes=_supersedes(text),
                    tags=[
                        t.strip() for t in fm.get("tags", "").strip("[]").split(",") if t.strip()
                    ],
                    size=len(text),
                    counts={w: c for w, c in counts.most_common(600)},
                    total_tokens=max(len(tokens), 1),
                )
            )
    return docs


def save(docs: list[Doc]) -> None:
    CACHE_PATH.parent.mkdir(parents=True, exist_ok=True)
    CACHE_PATH.write_text(
        json.dumps([d.__dict__ for d in docs], ensure_ascii=False), encoding="utf-8"
    )


def load() -> list[Doc]:
    if not CACHE_PATH.is_file():
        return []
    try:
        raw = json.loads(CACHE_PATH.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []
    return [Doc(**item) for item in raw]


def score(doc: Doc, terms: list[str]) -> float:
    """Density, not presence: hits per thousand tokens, summed over matched terms.

    Length-normalised so a 50 KB survey does not outrank a 5 KB document that is entirely
    about the query.
    """
    total = 0
    for term in terms:
        for word, count in doc.counts.items():
            if term in word:
                total += count
    return 1000.0 * total / doc.total_tokens if total else 0.0


def related(doc: Doc, docs: list[Doc], limit: int) -> list[tuple[float, Doc]]:
    """Cosine-ish overlap on distinctive vocabulary — finds the sibling nobody linked."""
    mine = {w: c for w, c in doc.counts.items() if len(w) > 4}
    if not mine:
        return []
    norm_a = math.sqrt(sum(c * c for c in mine.values()))
    out = []
    for other in docs:
        if other.path == doc.path:
            continue
        theirs = {w: c for w, c in other.counts.items() if len(w) > 4}
        shared = set(mine) & set(theirs)
        if not shared:
            continue
        dot = sum(mine[w] * theirs[w] for w in shared)
        norm_b = math.sqrt(sum(c * c for c in theirs.values()))
        if norm_a and norm_b:
            out.append((dot / (norm_a * norm_b), other))
    out.sort(key=lambda pair: pair[0], reverse=True)
    return out[:limit]


def render(rows: list[tuple[float, Doc]], *, header: str) -> None:
    if not rows:
        print("no matches — try broader terms, or rebuild with --reindex", file=sys.stderr)
        return
    print(header)
    print("=" * len(header))
    dead = 0
    for rank, (value, doc) in enumerate(rows, 1):
        flag = ""
        if doc.is_dead:
            flag = f"  ** {doc.status.upper()} **"
            dead += 1
        stamp = doc.created[:10] if doc.created else doc.mtime
        print(f"\n{rank:2}. [{value:7.2f}] {stamp}  {doc.name}{flag}")
        if doc.title:
            print(f"      {doc.title[:96]}")
        meta = [p for p in (doc.doc_type, doc.status, f"{doc.size // 1024}KB") if p]
        if meta:
            print(f"      {' · '.join(meta)}")
        for ref in doc.supersedes:
            print(f"      supersedes → {ref}")
    print(f"\n{len(rows)} documents. Read the top {min(3, len(rows))} before concluding anything.")
    if dead:
        print(f"{dead} carry a retired/superseded status — do not quote them as current.")


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("terms", nargs="*", help="query terms (substring-matched against tokens)")
    ap.add_argument("--reindex", action="store_true", help="rebuild the index before querying")
    ap.add_argument(
        "--related", metavar="FILENAME", help="find documents sharing this one's vocabulary"
    )
    ap.add_argument("--limit", type=int, default=12)
    ap.add_argument("--all", action="store_true", help="include zero-score documents")
    args = ap.parse_args(argv)

    docs = load()
    if args.reindex or not docs:
        docs = build_index(DEFAULT_ROOTS)
        save(docs)
        print(f"indexed {len(docs)} documents -> {CACHE_PATH}", file=sys.stderr)

    if args.related:
        match = next((d for d in docs if args.related in d.name), None)
        if match is None:
            print(f"no indexed document matching {args.related!r}", file=sys.stderr)
            return 2
        render(related(match, docs, args.limit), header=f"Neighbours of {match.name}")
        return 0

    if not args.terms:
        ap.error("give query terms, or --related FILENAME")

    terms = [t.lower() for t in args.terms]
    rows = [(score(d, terms), d) for d in docs]
    rows = [r for r in rows if r[0] > 0 or args.all]
    rows.sort(key=lambda pair: pair[0], reverse=True)
    render(rows[: args.limit], header=f"Corpus cluster for: {' '.join(terms)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
