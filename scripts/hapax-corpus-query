#!/usr/bin/env python3
"""Query the plan/analysis corpus so a search returns the archipelago, not an island.

The failure this exists to stop, observed repeatedly: a search finds one document about a
topic, the reader treats it as the topic, and writes something wrong because three sibling
documents -- a predecessor it supersedes, a parallel analysis of equal weight, a later
refresh that retired it -- were never seen. Ripgrep answers "where does this string
appear"; it does not answer "what is the full set of documents about this, in what order,
and which of them are dead."

Design commitments, each one a direct response to that failure:

* **Never SILENTLY return one result.** A single-document answer to a corpus question is the
  bug, so a result set below ``MIN_CLUSTER`` is backfilled from the vocabulary-neighbours of
  what matched, labelled as such. Three cases cannot be backfilled and are therefore
  *announced with their cause* rather than padded: zero matches, a corpus smaller than the
  floor, and a match that shares no distinctive vocabulary with anything. The absolute form of
  this claim ("never return one result") was shipped twice and reviewed as a critical both
  times -- an undeclared exception to a headline commitment is worse than a declared limit.
  See ``cluster()``, where it is enforced rather than described.
* **Rank by density, not presence.** A document that mentions a term twice is not about it.
  Hit-density separates the topic documents from the passing mentions.
* **Surface supersession loudly.** ``status: retired`` / ``superseded`` and
  ``supersedes_refs`` are printed with the result, not left for the reader to discover
  after quoting a dead position.
* **Show the neighbours.** ``--related`` takes a document and returns the others that share
  its vocabulary, which is how you find the sibling nobody linked.

This is deliberately an ad-hoc instrument. It is a flat index over markdown, not a
knowledge graph, and it should be replaced by something with real provenance edges once the
inflection/plan layer has a schema. It is committed rather than kept in a scratch directory
because the failure it prevents recurs every session, and an instrument that is not to hand
is an instrument that is not used.
"""

from __future__ import annotations

import argparse
import json
import math
import os
import re
import sys
from collections import Counter
from dataclasses import dataclass, field
from datetime import UTC, datetime
from pathlib import Path

#: Where the plan/analysis corpus lives when nothing says otherwise. Overridable by
#: ``HAPAX_CORPUS_ROOTS`` (os.pathsep-separated) or repeated ``--root``, so the tool is not
#: welded to one operator's home directory: the vault path is this estate's convention, not
#: a property of the instrument.
DEFAULT_ROOTS = [
    Path.home() / "Documents" / "Personal" / "30-areas" / "hapax",
    Path.home() / "Documents" / "Personal" / "20-projects" / "hapax-requests",
]

CACHE_PATH = Path(
    os.environ.get(
        "HAPAX_CORPUS_INDEX",
        str(Path.home() / ".cache" / "hapax" / "corpus" / "corpus-index.json"),
    )
)

#: A corpus question answered with one document is the failure this tool exists to prevent,
#: so the floor is a property of the output rather than advice in the docstring.
MIN_CLUSTER = 3

#: Below this length a term is matched only at a token boundary. "api" is a substring of
#: "rapid" and "therapist"; counting those as topic hits inflates density for exactly the
#: short acronym queries most likely to be typed.
MIN_INTERIOR_SUBSTRING_LEN = 5

#: How stale the index may be before the tool says so. Silence here is the failure mode:
#: a stale index answers confidently about a corpus that has moved on.
INDEX_STALE_AFTER_SECONDS = 6 * 3600

#: Directories that are raw dumps rather than plans. They swamp the ranking with incidental
#: term matches and answer a different question.
#:
#: `operator-corpus` was here until 2026-08-12, which meant this tool -- built specifically to
#: stop research landing on one island -- excluded the island holding the operator's own
#: verbatim stipulations. Only the bulk-raw subdirectories are skipped now; the curated
#: records are indexed by ``_operator_records`` below.
SKIP_DIR_PARTS = {
    "lanebus",
    "_archive-complete",
    "prompt-histories",
    "paste-cache",
}

TOKEN_RE = re.compile(r"[a-z][a-z0-9_-]{2,}")

STOPWORDS = frozenset(
