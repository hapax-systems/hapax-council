#!/usr/bin/env python3
"""Require the installed native global before a substitute reviewer child starts."""

from __future__ import annotations

import importlib.util
import os
import sys
from pathlib import Path

NATIVE = {
    "muse": ("muse", ".config/muse/AGENTS.md", "XDG_CONFIG_HOME", ".config"),
    "vibe": ("vibe", ".vibe/AGENTS.md", "VIBE_HOME", ".vibe"),
}


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] not in NATIVE:
        print("usage: hapax-review-native-instruction-preflight muse|vibe", file=sys.stderr)
        return 2
    client = sys.argv[1]
    binding, relative, home_var, default_home = NATIVE[client]
    local_root = Path(__file__).resolve().parents[1]
    root = Path(
        os.environ.get("HAPAX_SOURCE_ACTIVATE_WORKTREE")
        or os.environ.get("HAPAX_COUNCIL_DIR")
        or (
            local_root
            if (local_root / "config/agent-instructions/AGENTS.md").is_file()
            else Path.home() / ".cache/hapax/source-activation/worktree"
        )
    ).resolve()
    home = Path(os.environ["HOME"]).resolve()
    configured = os.environ.get(home_var)
    if configured and Path(configured).expanduser().resolve() != (home / default_home).resolve():
        print(f"{client}: {home_var} selects an undeclared instruction home", file=sys.stderr)
        return 3
    path = root / "shared/canonical_instruction_ingestion.py"
    spec = importlib.util.spec_from_file_location("hapax_review_native_ingestion", path)
    if spec is None or spec.loader is None:
        print(f"{client}: canonical instruction resolver unavailable", file=sys.stderr)
        return 3
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    try:
        spec.loader.exec_module(module)
        module.read_canonical_instructions(
            source_root=root, operator_home=home, native_binding=(binding, relative)
        )
    except (OSError, ValueError) as exc:
        print(f"{client}: canonical instruction admission refused: {exc}", file=sys.stderr)
        return 3
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
