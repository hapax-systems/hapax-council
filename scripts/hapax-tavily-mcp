#!/usr/bin/env bash
# Launch the Hapax-governed Tavily MCP surface.

set -euo pipefail

# Secrets come from the FileStore through the one shared helper, never from pass.
# Operator ruling 2026-09-16: pass and gopass are not used to manage secrets going forward.
# The installed entry points are ~/.local/bin symlinks into the release tree, and BASH_SOURCE is
# the symlink path — so the lib lives beside the TARGET and must be resolved first (measured:
# invoked through the symlink, `${BASH_SOURCE[0]%/*}/lib` was ~/.local/bin/lib, absent, rc=1).
# /usr/bin/readlink by absolute path keeps this independent of PATH; the fallback keeps a host
# without coreutils on the direct-invocation behaviour rather than dying here.
_hapax_self="$(/usr/bin/readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
. "${_hapax_self%/*}/lib/secret.sh"

LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/hapax/mcp-logs"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/tavily-mcp.log"
COUNCIL_DIR="${HAPAX_COUNCIL_DIR:-/home/hapax/projects/hapax-council}"
UV_BIN="${UV_BIN:-/home/hapax/.local/bin/uv}"

load_tavily_token_for_upstream() {
  hapax_secret_into TAVILY_API_KEY tavily/api-key api/tavily || true
  if [ -z "${TAVILY_API_KEY:-}" ]; then
    echo "hapax-tavily-mcp: no token found. Next action: put one with \`hapax-secret tavily/api-key\`, or export TAVILY_API_KEY." >&2
    exit 2
  fi
}

require_upstream_override() {
  if [ "${HAPAX_TAVILY_ALLOW_UPSTREAM_MCP:-0}" != "1" ]; then
    echo "hapax-tavily-mcp: direct upstream mode bypasses Hapax budget/cache/ledger guardrails; use proxy mode or set HAPAX_TAVILY_ALLOW_UPSTREAM_MCP=1 explicitly" >&2
    exit 2
  fi
}

case "${HAPAX_TAVILY_MCP_MODE:-proxy}" in
  proxy)
    exec "$UV_BIN" --directory "$COUNCIL_DIR" run \
      python "$COUNCIL_DIR/scripts/hapax_tavily_mcp_server.py" \
      2>>"$LOG_FILE"
    ;;
  upstream-local|local)
    require_upstream_override
    load_tavily_token_for_upstream
    exec npx -y tavily-mcp@latest 2>>"$LOG_FILE"
    ;;
  upstream-remote|remote)
    echo "hapax-tavily-mcp: remote upstream mode is disabled because mcp-remote requires Tavily bearer material in process arguments; use proxy mode" >&2
    exit 2
    ;;
  *)
    echo "hapax-tavily-mcp: unsupported HAPAX_TAVILY_MCP_MODE=${HAPAX_TAVILY_MCP_MODE}" >&2
    exit 2
    ;;
esac
