#!/usr/bin/env bash
# Keep the GLM review seat admitted from ACCEPTED-RELEASE code only.
#
# Chain: one plan-first, receipt-bound reviewer round trip -> a passive admission receipt ->
# a live-ledger fold with the RELEASE telemetry writer -> the dispatcher's glmcp receipt refresh.
# This replaces the frozen job-tree refresher (~/.claude/jobs/81e6afab/tmp/wt-seat, Sept-5), whose
# schema-incompatible writer rebuilt the ledger/receipts with stale claude handling and flipped every
# claude route to blocked every five minutes (measured 2026-10-03T01:22-01:25Z). The release writer
# folds all three claude.* routes and preserves their account-live evidence, measured across two
# cycles: see 30-areas/hapax/frame/GLM-ADMISSION-PRODUCER-20261003.md. Prints states only; mints
# nothing unless a real round trip succeeds. A user timer runs it every five minutes (seat lives 900 s).
set -euo pipefail

# The scripts this calls come from the activation worktree (the governed loop's accepted release),
# never a mutable development checkout (review finding on #4624, round 2). An inherited HAPAX_COUNCIL
# must not redirect the governance-sensitive mint to another tree: refuse any other root unless a
# test harness says so explicitly.
ACTIVATION_ROOT="$HOME/.cache/hapax/source-activation/worktree"
W="${HAPAX_COUNCIL:-$ACTIVATION_ROOT}"
if [ "$W" != "$ACTIVATION_ROOT" ] && [ "${HAPAX_GLMCP_SEAT_ROOT_OVERRIDE:-0}" != "1" ]; then
  echo "glm seat refresh REFUSED: HAPAX_COUNCIL=$W is not the activation worktree ($ACTIVATION_ROOT); the mint chain must not run from a mutable tree. Next: unset HAPAX_COUNCIL for this unit, or set HAPAX_GLMCP_SEAT_ROOT_OVERRIDE=1 in a test harness." >&2
  exit 4
fi
PY="$W/.venv/bin/python"
export PYTHONPATH="$W"

RELAY="${HAPAX_RELAY_RECEIPT_DIR:-$HOME/.cache/hapax/relay/receipts}"
WDIR="$HOME/.cache/hapax/glmcp-admission-witness"
LOG="$HOME/.cache/hapax/relay/glmcp-review-seat-refresh.log"
mkdir -p "$WDIR" "$RELAY" "$(dirname "$LOG")"
log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG"; }

# Crow ruling 20261013T224102Z supersedes the 10-03 PAYG-OFF pin. The reviewer
# takes PAYG only after THIS call's Coding Plan quota wall and its existing locked spend gate.
# Pin both endpoints, credential, task, budget and authority: ambient values cannot choose billing.
endpoint="https://api.z.ai/api/coding/paas/v4"
model="glm-5.2"
export HAPAX_GLMCP_REVIEW_BASE_URL="$endpoint"
export HAPAX_GLMCP_REVIEW_SECRET_ENTRY="glmcp/api-key"  # pragma: allowlist secret
unset HAPAX_GLMCP_REVIEW_ALLOW_SECRET_ENTRY_OVERRIDE    # pragma: allowlist secret
export HAPAX_GLMCP_REVIEW_MODEL="$model"
export HAPAX_GLMCP_REVIEW_THINKING=disabled
export HAPAX_GLMCP_REVIEW_PAYG_BASE_URL="https://api.z.ai/api/paas/v4"
export HAPAX_GLMCP_REVIEW_PAYG_FALLBACK=1
export HAPAX_GLMCP_REVIEW_TASK_ID=glmcp-review-seat-payg-producer-20261013
export HAPAX_REVIEW_SEAT_ID=glm-review-seat-refresh
export HAPAX_GLMCP_REVIEW_REQUIRED_BUDGET_ID=tb-20260924-zai-glm-payg-balance-burn
export HAPAX_GLMCP_REVIEW_REQUIRED_AUTHORITY_CASE=CASE-CAPACITY-ROUTING-GLMCP-PAYG-20260706
unset HAPAX_GLMCP_REVIEW_ALLOW_BASE_URL_OVERRIDE HAPAX_GLMCP_REVIEW_ALLOW_PAYG_BASE_URL_OVERRIDE

# Freshness skip: while the relay admission still has more than SKIP_MIN_REMAINING_S of its 900 s life
# left, the seat is fresh — do no round trip (bounds Coding Plan spend to roughly when needed).
# Fail closed on anything but a trustworthy positive admission for THIS route (refresh instead):
#   - status must be quota_available and route_id must be glmcp.review.direct, so a hold/wall receipt
#     or another route's receipt can never authorize a skip (review finding codex-1, major 2);
#   - the TTL reaches bash arithmetic, so it must be digits-only — an unvalidated relay value is a
#     shell-arithmetic injection surface (review finding codex-1, major 1). obs_s is likewise pinned
#     to digits before it is used in arithmetic.
SKIP_MIN_REMAINING_S="${HAPAX_GLMCP_SEAT_SKIP_MIN_REMAINING_S:-450}"
rel="$RELAY/glmcp-quota-admission.yaml"
if [ -f "$rel" ]; then
  st="$(awk '/^status:/{sub(/^status:[[:space:]]*/, ""); print; exit}' "$rel")"
  rid="$(awk '/^route_id:/{sub(/^route_id:[[:space:]]*/, ""); print; exit}' "$rel")"
  obs="$(awk '/^observed_at:/{sub(/^observed_at:[[:space:]]*/, ""); print; exit}' "$rel")"
  ttl="$(awk '/^stale_after_seconds:/{sub(/^stale_after_seconds:[[:space:]]*/, ""); print; exit}' "$rel")"
  if [ "$st" = "quota_available" ] && [ "$rid" = "glmcp.review.direct" ] \
     && [ -n "$obs" ] && [[ "$ttl" =~ ^[0-9]+$ ]] \
     && obs_s="$(date -u -d "$obs" +%s 2>/dev/null)" && [[ "$obs_s" =~ ^[0-9]+$ ]]; then
    now_s="$(date -u +%s)"
    left=$(( obs_s + ttl - now_s ))
    if [ "$left" -gt "$SKIP_MIN_REMAINING_S" ]; then
      log "seat fresh per relay admission (${left}s remain, status=$st route=$rid); no round trip"
      echo "glm seat fresh (${left}s remain); no round trip"
      exit 0
    fi
  fi
fi

# 1. one bounded round trip; output is counted, never stored. Up to three tries for transient empty
#    replies (measured 2026-09-02 and 2026-10-03: attempt 1 empty, attempt 2 ok).
ts="$(date -u +%Y%m%dt%H%M%Sz)"
# Private per-invocation diagnostics prevent a historical success line from authorizing a mint.
diag="$(mktemp "$WDIR/reviewer-$ts-XXXXXXXX.log")"
trap 'rm -f "$diag"' EXIT
ref="glmcp-reviewer-roundtrip-ok-$ts-${diag##*-}"
ref="${ref%.log}"
ref="${ref,,}"
rc=1
bytes=0
for attempt in 1 2 3; do
  started="$(date -u +%s)"
  # Bind the spend witness to this attempt; a previous retry's receipt cannot admit it.
  HAPAX_GLMCP_REVIEW_TASK_HASH="sha256:$(printf '%s:%s' "$diag" "$attempt" | sha256sum | cut -d' ' -f1)"
  export HAPAX_GLMCP_REVIEW_TASK_HASH
  out="$(printf 'Blind review smoke. Reply with exactly: OK\n' \
    | HAPAX_GLMCP_REVIEW_TIMEOUT_SECONDS=40 HAPAX_GLMCP_REVIEW_MAX_TOKENS=16 \
      timeout 60 "$PY" "$W/scripts/hapax-glmcp-reviewer" 2>"$diag")" && rc=0 || rc=$?
  cat "$diag" >>"$LOG"
  bytes=${#out}
  echo "roundtrip attempt $attempt: exit=$rc output_bytes=$bytes"
  if [ "$rc" -eq 0 ] && [ "$bytes" -gt 0 ]; then break; fi
  [ "$attempt" -lt 3 ] && sleep "${HAPAX_GLMCP_SEAT_RETRY_SLEEP:-10}"
done

# UNSAFE-CASE GUARD: mint ONLY after a real successful reviewer round trip. On failure, leave the
# seat to lapse (narrows action) rather than minting an admission for a call that did not happen.
if [ "$rc" -ne 0 ] || [ "$bytes" -eq 0 ]; then
  log "round trip FAILED (exit $rc, $bytes bytes); minted nothing"
  echo "glm seat NOT refreshed: reviewer round trip failed (exit $rc, $bytes bytes); minted nothing." >&2
  exit 2
fi

# Only native reviewer success metadata may select the admission form. The PAYG spend file
# also carries the fresh primary quota-wall class; require its reconciled, same-attempt witness.
if ! metadata="$("$PY" - "$diag" "$RELAY" "$started" <<'PYVERIFY'
import os
import re
import sys
from datetime import UTC, datetime
from decimal import Decimal
from pathlib import Path

plan = "https://api.z.ai/api/coding/paas/v4"
paid = "https://api.z.ai/api/paas/v4"
prefixes = ("hapax-glmcp-reviewer: Coding Plan reply ", "hapax-glmcp-reviewer: PAYG fallback used ")
try:
    lines = Path(sys.argv[1]).read_text().splitlines()
    successes = [(i, line[len(prefix):]) for line in lines
                 for i, prefix in enumerate(prefixes) if line.startswith(prefix)]
    if len(successes) != 1:
        raise ValueError("expected one native reviewer success")
    kind, line = successes[0]
    fields = dict(item.split("=", 1) for item in line.split())
    endpoint, model = fields["endpoint"], fields["model"]
    if kind == 0:
        if (endpoint, model) != (plan, "glm-5.2"):
            raise ValueError("unexpected plan identity")
        print(endpoint, model, sep="\n")
    else:
        name = fields["spend_receipt"]
        error = fields["primary_error_class"]
        if ((endpoint, model) != (paid, "glm-5.3")
                or error not in {"quota_exhausted", "daily_limit_exhausted"}
                or fields["spend_gate"] != "eligible_active_budget"
                or fields["budget_id"] != os.environ["HAPAX_GLMCP_REVIEW_REQUIRED_BUDGET_ID"]
                or not re.fullmatch(r"glmcp-payg-spend-[a-z0-9-]+\.yaml", name)):
            raise ValueError("unexpected PAYG identity or quota wall")
        receipt = {}
        for row in (Path(sys.argv[2]) / name).read_text().splitlines():
            key, separator, value = row.partition(":")
            if not separator or key in receipt:
                raise ValueError("invalid spend witness")
            receipt[key] = value.strip()
        expected = {
            "schema": "hapax.glmcp_payg_spend.v1", "status": "spend_reconciled",
            "reconciliation_state": "reconciled", "route_id": "glmcp.review.direct",
            "task_id": os.environ["HAPAX_GLMCP_REVIEW_TASK_ID"],
            "task_hash": os.environ["HAPAX_GLMCP_REVIEW_TASK_HASH"],
            "authority_case": os.environ["HAPAX_GLMCP_REVIEW_REQUIRED_AUTHORITY_CASE"],
            "budget_id": os.environ["HAPAX_GLMCP_REVIEW_REQUIRED_BUDGET_ID"],
            "capacity_pool": "api_paid_spend", "billing_mode": "api_credit_payg",
            "endpoint": paid, "model_or_engine": model, "served_model": model,
            "supported_tool": "hapax-glmcp-reviewer", "primary_error_class": error,
        }
        if any(receipt.get(key) != value for key, value in expected.items()):
            raise ValueError("spend witness does not match this successful attempt")
        created = datetime.fromisoformat(receipt["created_at"].replace("Z", "+00:00")).timestamp()
        reconciled = datetime.fromisoformat(receipt["reconciled_at"].replace("Z", "+00:00")).timestamp()
        if not int(sys.argv[3]) <= created <= reconciled <= datetime.now(UTC).timestamp():
            raise ValueError("spend witness is not fresh")
        actual = Decimal(receipt["actual_cost_usd"])
        if not actual.is_finite() or actual < 0:
            raise ValueError("invalid reconciled spend")
        print(endpoint, model, error, name, sep="\n")
except (OSError, ValueError, KeyError, ArithmeticError) as exc:
    print(f"review-seat witness refused: {exc}", file=sys.stderr)
    sys.exit(1)
PYVERIFY
)"; then
  log "reviewer success witness invalid; minted nothing"
  exit 2
fi
mapfile -t observed <<<"$metadata"
endpoint="${observed[0]}"
model="${observed[1]}"
admission_args=()
if [ "${#observed[@]}" -eq 4 ]; then
  admission_args=(--primary-error-class "${observed[2]}" --quota-wall-evidence-ref "${observed[3]}")
fi

# 2. witness (schema v1): no prompt, output or secret persisted.
cat >"$WDIR/$ref.yaml" <<EOF
schema: hapax.glmcp_admission_witness.v1
witness_ref: $ref
host: $(hostname)
observed_at: $(date -u +%Y-%m-%dT%H:%M:%SZ)
supported_tool: hapax-glmcp-reviewer
endpoint: $endpoint
model: $model
invocation_exit_code: 0
prompt_or_output_persisted: false
secret_value_persisted: false
EOF

# 3. passive admission receipt (relay witness, 900 s).
if ! "$PY" "$W/scripts/hapax-glmcp-quota-admission" observe-success --evidence-ref "$ref" \
    --supported-tool hapax-glmcp-reviewer --endpoint "$endpoint" --model "$model" "${admission_args[@]}" >>"$LOG" 2>&1; then
  log "admission FAILED after a successful round trip (witness $WDIR/$ref.yaml)"
  echo "glm seat NOT admitted: hapax-glmcp-quota-admission failed after a successful round trip; see $LOG." >&2
  exit 5
fi

# 4. fold the live ledger with the RELEASE writer (--skip-receipts: ledger only, no Codex exec-auth
#    probe). The release writer preserves claude account-live evidence; the frozen writer did not.
if ! "$PY" "$W/scripts/hapax-quota-telemetry-writer" --json --skip-receipts >>"$LOG" 2>&1; then
  log "ledger fold FAILED after the admission was minted"
  echo "glm seat admitted but NOT folded: hapax-quota-telemetry-writer failed; see $LOG." >&2
  exit 3
fi

# 5. regenerate the dispatcher's glmcp receipt from the folded ledger (glmcp-scoped: no Codex spend).
if ! "$PY" "$W/scripts/hapax-platform-capability-receipts" --platform glmcp >>"$LOG" 2>&1; then
  log "glmcp receipt refresh FAILED after the ledger was folded"
  echo "glm seat folded but receipt NOT refreshed: hapax-platform-capability-receipts --platform glmcp failed; see $LOG." >&2
  exit 6
fi

log "glm seat refreshed from release code (ref=$ref)"
echo "glm seat refreshed from release code (ref=$ref)"
