#!/usr/bin/bash -p
# Retirement sentinel for the former root-to-user OOM score bridge.
set -euo pipefail
IFS=$' \t\n'
PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/bin
export PATH
unset ENV BASH_ENV CDPATH

readonly RETIREMENT_MESSAGE="root negative OOM scoring for delegated user services is retired; no process state was changed; next action: keep user services at OOMScoreAdjust=100 with cgroup memory protection, or move a workload requiring a negative score to a root-owned non-delegated system unit"

usage() {
    printf 'usage: hapax-oom-score-enforce --apply | --apply-unit UNIT\n' >&2
    printf 'next action: invoke only the retained compatibility surface, or remove the stale caller instead of restoring root mutation\n' >&2
}

case "${1:-}" in
    --apply)
        [ "$#" -eq 1 ] || {
            usage
            exit 2
        }
        ;;
    --apply-unit)
        [ "$#" -eq 2 ] || {
            usage
            exit 2
        }
        case "$2" in
            pipewire.service|pipewire-pulse.service|wireplumber.service|\
            hapax-daimonion.service|studio-compositor.service|hapax-imagination.service)
                ;;
            *)
                printf 'refusing non-retired OOM unit: %s\n' "$2" >&2
                printf 'next action: keep delegated user services at OOMScoreAdjust=100 and remove this stale caller\n' >&2
                exit 2
                ;;
        esac
        ;;
    *)
        usage
        exit 2
        ;;
esac

printf 'info: %s\n' "$RETIREMENT_MESSAGE"
