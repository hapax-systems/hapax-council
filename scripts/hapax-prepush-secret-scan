#!/usr/bin/env python3
"""Scan-before-push: refuse a `git push` whose new commits carry secret-shaped strings or home paths.

Installed as a git pre-push hook (`<git-common-dir>/hooks/pre-push`), so one install covers every
worktree of the clone. Git feeds the hook one line per ref on stdin:

    <local ref> <local sha> <remote ref> <remote sha>

For each ref we scan the DIFF CONTENT between the remote's tip and the local tip. When the remote
does not have the ref yet (all-zero remote sha), the base is the remote's default branch tip if
we have it locally, else the empty tree — i.e. everything is scanned, never nothing.

Two detectors, both report TYPES AND COUNTS ONLY, never values:
  1. `detect-secrets scan` over the files as they exist at the local tip (via `uvx`);
  2. an added-line grep for absolute home paths (`/home/<user>/`), the estate's pii-guard class.

Any finding → exit 1 with a message naming the remedy. There is no in-script bypass; git's own
`--no-verify` is the only override and it leaves a line in the reflog, not a silent path.

A remote may be exempted ONLY by explicit local config — a private mirror whose whole purpose is
to hold unscanned refs off-disk:

    git config --add hapax.prepushScan.skipRemote mirror

The exemption is checked against the remote NAME git passes as argv[1]; that is machine-checkable
at the moment of use, which is the condition for a fallback to exist at all.

Usage outside git (for tests): hapax-prepush-secret-scan <remote-name> <remote-url> < refs.txt
"""
from __future__ import annotations

import json
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ZERO = "0" * 40
HOME_PATH = re.compile(r"^\+.*(/home/[A-Za-z0-9_.-]+/)")
VENDOR_PREFIX_RE = re.compile(
    r"(?<![A-Za-z0-9_-])("
    r"sk-ant-[A-Za-z0-9_-]{20,}"          # Anthropic
    r"|sk-(?:proj-|svcacct-)?[A-Za-z0-9_-]{20,}"  # OpenAI
    r"|xai-[A-Za-z0-9]{20,}"             # xAI
    r"|AIza[0-9A-Za-z_-]{30,}"           # Google API
    r"|ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}"  # GitHub
    r"|glpat-[A-Za-z0-9_-]{15,}"         # GitLab
    r"|hf_[A-Za-z0-9]{25,}"              # Hugging Face
    r"|xox[bpa]-[A-Za-z0-9-]{20,}"       # Slack
    r")"
)


def git(*args: str, cwd: str | None = None) -> str:
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True, check=True).stdout


def default_base(remote: str) -> str | None:
    """Tip of the remote's default branch as we know it locally, else None."""
    for cand in (f"refs/remotes/{remote}/HEAD", f"refs/remotes/{remote}/main", "refs/remotes/origin/main"):
        try:
            return git("rev-parse", "--verify", "--quiet", cand).strip()
        except subprocess.CalledProcessError:
            continue
    return None


def changed_files(base: str | None, tip: str) -> list[str]:
    if base is None:
        # empty tree: everything at tip is "added"
        base = git("hash-object", "-t", "tree", "/dev/null").strip()
    names = git("diff", "--name-only", "--diff-filter=AMR", base, tip).split()
    return names, base


def added_lines(base: str, tip: str) -> dict[str, list[tuple[int, str]]]:
    """{file: [(line number at tip, text)]} for every line the push ADDS.

    Everything this hook judges is judged on added lines only. A file that already carried a
    keyword-shaped string on the remote (test fixtures, a `changeme` placeholder) must not make
    an unrelated edit to that file unpushable — that is not new exposure, and refusing it would
    teach people `--no-verify` (measured 2026-09-02 on the first real push through this hook).
    """
    diff = git("diff", "--unified=0", base, tip)
    out: dict[str, list[tuple[int, str]]] = {}
    current = "?"
    lineno = 0
    for line in diff.splitlines():
        if line.startswith("+++ "):
            current = line[4:].removeprefix("b/")
            continue
        if line.startswith("@@"):
            # @@ -a[,b] +c[,d] @@ — c is the first line number of the added run at the tip
            plus = line.split("+", 1)[1].split(" ", 1)[0]
            lineno = int(plus.split(",", 1)[0])
            continue
        if line.startswith("+") and not line.startswith("+++"):
            out.setdefault(current, []).append((lineno, line[1:]))
            lineno += 1
    return out


def scan_with_detector(
    tip: str, names: list[str], added: dict[str, list[tuple[int, str]]]
) -> dict[str, list[str]]:
    """Return {file: [types]} for detect-secrets findings on ADDED lines of files at `tip`."""
    if not names:
        return {}
    tmp = Path(tempfile.mkdtemp(prefix="hapax-prepush-"))
    try:
        staged = 0
        for p in names:
            blob = subprocess.run(["git", "show", f"{tip}:{p}"], capture_output=True)
            if blob.returncode != 0:
                continue
            (tmp / p.replace("/", "__")).write_bytes(blob.stdout)
            staged += 1
        if staged == 0:
            return {}
        # --all-files is load-bearing: without it detect-secrets enumerates files via `git ls-files`,
        # which fails silently in a non-git scratch directory and reports ZERO findings on ANY input.
        # (Measured 2026-09-02: the flagless form scanned nothing and returned a clean result.)
        exe = shutil.which("detect-secrets")
        cmd = [exe, "scan", "--all-files", "."] if exe else ["uvx", "detect-secrets", "scan", "--all-files", "."]
        try:
            run = subprocess.run(cmd, cwd=tmp, capture_output=True, text=True, timeout=600)
        except (FileNotFoundError, subprocess.TimeoutExpired) as e:
            # No scanner means no scan: refuse loudly rather than pass silently.
            sys.stderr.write(f"hapax-prepush-secret-scan: detect-secrets unavailable ({type(e).__name__}); "
                             "install it (`uv tool install detect-secrets`) or push with --no-verify on your own authority\n")
            sys.exit(3)
        try:
            results = json.loads(run.stdout).get("results", {})
        except json.JSONDecodeError:
            sys.stderr.write(f"hapax-prepush-secret-scan: detect-secrets produced no JSON: {run.stderr[:300]}\n")
            sys.exit(3)
        original = {p.replace("/", "__"): p for p in names}
        flagged: dict[str, list[str]] = {}
        for temp_name, hits in results.items():
            path = original.get(temp_name.removeprefix("./"), temp_name)
            new_lines = {ln for ln, _ in added.get(path, [])}
            kinds = sorted({h["type"] for h in hits if h.get("line_number") in new_lines})
            if kinds:
                flagged[path] = kinds
        return flagged
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def scan_added_lines(
    added: dict[str, list[tuple[int, str]]],
) -> tuple[dict[str, int], dict[str, int]]:
    """Over ADDED lines only: ({file: home-path line count}, {file: vendor-key-shaped line count}).

    The vendor-key regex covers prefixes detect-secrets 1.5.0 does not know (Anthropic `sk-ant-`,
    xAI `xai-`, Hugging Face `hf_`, GitLab `glpat-`) alongside ones it does; a second detector that
    only ever ADDS refusals narrows the failure path, it does not widen it.
    """
    homes: dict[str, int] = {}
    vendor: dict[str, int] = {}
    for path, lines in added.items():
        for _lineno, text in lines:
            if HOME_PATH.match("+" + text):
                homes[path] = homes.get(path, 0) + 1
            if VENDOR_PREFIX_RE.search(text) and "pragma: allowlist secret" not in text:
                vendor[path] = vendor.get(path, 0) + 1
    return homes, vendor


def main(argv: list[str]) -> int:
    remote = argv[1] if len(argv) > 1 else "?"
    skip = subprocess.run(["git", "config", "--get-all", "hapax.prepushScan.skipRemote"],
                          capture_output=True, text=True).stdout.split()
    if remote in skip:
        sys.stderr.write(f"hapax-prepush-secret-scan: remote '{remote}' exempt by local config hapax.prepushScan.skipRemote\n")
        return 0
    refs = [l.split() for l in sys.stdin.read().splitlines() if l.strip()]
    if not refs:
        return 0
    failed = False
    for local_ref, local_sha, remote_ref, remote_sha in refs:
        if local_sha == ZERO:
            continue  # deletion: nothing new leaves the machine
        base = remote_sha if remote_sha != ZERO else default_base(remote)
        names, base_used = changed_files(base, local_sha)
        # `ds_findings` maps file -> detect-secrets FINDING TYPE NAMES (e.g. "AWS Access Key");
        # no value from the scanned content is ever held here or written anywhere.
        added = added_lines(base_used, local_sha)
        ds_findings = scan_with_detector(local_sha, names, added)
        homes, vendor = scan_added_lines(added)
        if ds_findings or homes or vendor:
            failed = True
            sys.stderr.write(f"\nREFUSED push of {local_ref} -> {remote}/{remote_ref} "
                             f"({len(names)} files changed vs {base_used[:10]}):\n")
            for f, finding_types in ds_findings.items():
                sys.stderr.write(f"  secret-shaped: {f}  {finding_types}\n")
            for f, n in vendor.items():
                sys.stderr.write(f"  vendor-key-shaped in {n} added line(s): {f}\n")
            for f, n in homes.items():
                sys.stderr.write(f"  home path in {n} added line(s): {f}\n")
    if failed:
        sys.stderr.write("\nRemedy: remove or redact the flagged content and amend/rebase, or if a finding is a "
                         "false positive add a `# pragma: allowlist secret` on that line. Types and counts only "
                         "are printed; values never are.\n")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
