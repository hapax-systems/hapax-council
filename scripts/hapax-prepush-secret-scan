#!/usr/bin/env python3
"""Scan-before-push: refuse a `git push` whose new commits carry secret-shaped strings or home paths.

Installed as a git pre-push hook (`<git-common-dir>/hooks/pre-push`), so one install covers every
worktree of the clone. Git feeds the hook one line per ref on stdin:

    <local ref> <local sha> <remote ref> <remote sha>

For each ref we scan every commit reachable from the local tip but not from any verified ref
on the push destination. Cached tracking refs alone are not evidence of publication. A new ref
with no verified remote history scans everything. Each commit is judged against all its parents
(or the empty tree for a root): only lines added relative to every parent are new in a merge.

Three detectors, all report TYPES AND COUNTS ONLY, never values:
  1. `detect-secrets scan` over the files as they exist at each new commit (via `uvx`);
  2. an added-line vendor-key prefix regex for providers detect-secrets may not recognize;
  3. an added-line grep for absolute home paths (`/home/<user>/`), the estate's pii-guard class.

Git-binary changes have no added-line content for those detectors to classify. They are refused
closed with the affected paths instead of being silently treated as clean.

Any finding → exit 1 with a message naming the remedy. The installed policy allows explicit
inline secret pragmas, entropy on generated digest paths, and home paths in systemd unit files.

A remote may be exempted ONLY by explicit local config — a private mirror whose whole purpose is
to hold unscanned refs off-disk:

    git config --add hapax.prepushScan.skipRemote mirror

The exemption is checked against the remote NAME git passes as argv[1]; that is machine-checkable
at the moment of use, which is the condition for a fallback to exist at all.

Usage outside git (for tests): hapax-prepush-secret-scan <remote-name> <remote-url> < refs.txt
"""

from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import NoReturn

ZERO = "0" * 40
HOME_PATH = re.compile(r"^\+.*(/home/[A-Za-z0-9_.-]+/)")
# Codebase-derived artifacts that carry content digests by construction. On these paths, and
# ONLY these, the two entropy detectors are not evidence of a secret: every re-materialization
# adds fresh hex digests (measured 2026-09-02: 4 files refused on a routine map refresh). The
# keyword, vendor-prefix and home-path detectors still apply to them unchanged.
GENERATED_HASH_BEARING = (
    "docs/architecture/system-dynamics-map",
    "config/capability-inventory-baseline.json",
)
# Reconcile the installed hook's systemd policy: unit files require absolute paths.
# Only the home-path detector is exempt; secret detectors continue to apply.
UNIT_ABSOLUTE_PATH_DIRS = ("systemd/units/",)
ENTROPY_TYPES = {"Hex High Entropy String", "Base64 High Entropy String"}
# --all-files controls enumeration, not these implicit exemptions. Inspect all
# UTF-8 files and added lines regardless of filename, apparent references, or
# candidate shape. Only explicit pragmas and GENERATED_HASH_BEARING may suppress
# secret findings. Verification must not suppress a shape (or send it off-host).
DISABLED_DETECTOR_FILTERS = (
    "detect_secrets.filters.heuristic.is_non_text_file",
    "detect_secrets.filters.heuristic.is_lock_file",
    "detect_secrets.filters.heuristic.is_swagger_file",
    "detect_secrets.filters.heuristic.is_indirect_reference",
    "detect_secrets.filters.heuristic.is_sequential_string",
    "detect_secrets.filters.heuristic.is_potential_uuid",
    "detect_secrets.filters.heuristic.is_likely_id_string",
    "detect_secrets.filters.heuristic.is_templated_secret",
    "detect_secrets.filters.heuristic.is_prefixed_with_dollar_sign",
    "detect_secrets.filters.heuristic.is_not_alphanumeric_string",
    "detect_secrets.filters.common.is_ignored_due_to_verification_policies",
)
VENDOR_PREFIX_RE = re.compile(
    r"(?<![A-Za-z0-9_-])("
    r"sk-ant-[A-Za-z0-9_-]{20,}"  # Anthropic
    r"|sk-(?:proj-|svcacct-)?[A-Za-z0-9_-]{20,}"  # OpenAI
    r"|xai-[A-Za-z0-9]{20,}"  # xAI
    r"|AIza[0-9A-Za-z_-]{30,}"  # Google API
    r"|ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}"  # GitHub
    r"|glpat-[A-Za-z0-9_-]{15,}"  # GitLab
    r"|hf_[A-Za-z0-9]{25,}"  # Hugging Face
    r"|xox[bpa]-[A-Za-z0-9-]{20,}"  # Slack
    r")"
)


def git(*args: str, cwd: str | None = None) -> str:
    # `--` stops option parsing but still permits pathspec magic and glob expansion.
    return subprocess.run(
        ["git", "--literal-pathspecs", *args], cwd=cwd, capture_output=True, check=True
    ).stdout.decode("utf-8", errors="surrogateescape")


def remote_commits(destination: str) -> list[str]:
    """Locally available commits advertised by the actual push URL, never cached refs.

    An unavailable advertisement or object can only enlarge the scan. In particular, changing
    a remote URL or pushing with a separate pushurl cannot borrow the old repository's history.
    """
    if not destination:
        return []
    try:
        advertised = subprocess.run(
            ["git", "ls-remote", "--", destination],
            capture_output=True,
            check=True,
            timeout=30,
        ).stdout
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired):
        sys.stderr.write(
            "hapax-prepush-secret-scan: could not verify destination refs; "
            "scanning without cached exclusions. Fetch the destination and retry if refused.\n"
        )
        return []
    oids = sorted({row.split(b"\t", 1)[0] for row in advertised.split(b"\n") if row})
    # Peeling also includes annotated tags whose target is a commit. Missing local objects
    # and tags pointing to trees/blobs cannot provide a commit exclusion.
    checked = subprocess.run(
        ["git", "cat-file", "--batch-check=%(objectname) %(objecttype)"],
        input=b"".join(oid + b"^{commit}\n" for oid in oids),
        capture_output=True,
        check=True,
    ).stdout
    return [
        row.split()[0].decode("ascii") for row in checked.splitlines() if row.endswith(b" commit")
    ]


def empty_tree() -> str:
    return git("hash-object", "-t", "tree", "/dev/null").strip()


def pushed_commits(bases: list[str], tip: str) -> list[str]:
    """Oldest-first commits not already reachable on the destination, including side parents."""
    revisions = tip + "\n" + "".join(f"^{base}\n" for base in sorted(set(bases)))
    result = subprocess.run(
        ["git", "rev-list", "--reverse", "--stdin"],
        input=revisions.encode("ascii"),
        capture_output=True,
        check=True,
    )
    return result.stdout.decode("ascii").splitlines()


def parents_or_empty(commit: str) -> list[str]:
    row = git("rev-list", "--parents", "-n", "1", commit).rstrip("\n").split(" ")
    return row[1:] or [empty_tree()]


def changed_files(base: str, tip: str) -> list[str]:
    """Changed paths at `tip`, transported losslessly with git's NUL-delimited format."""
    # T includes symlink/regular-file replacements. D adds no content at the tip. With
    # --no-renames, renames and copies are additions; retain R/C explicitly as well.
    raw = subprocess.run(
        [
            "git",
            "diff",
            "--name-only",
            "-z",
            "--no-renames",
            "--diff-filter=ACMRT",
            base,
            tip,
        ],
        capture_output=True,
        check=True,
    ).stdout
    return [os.fsdecode(name) for name in raw.split(b"\0") if name]


def binary_files(base: str, tip: str) -> set[str]:
    """Paths whose changed content Git cannot express as added and deleted lines."""
    raw = subprocess.run(
        [
            "git",
            "diff",
            "--numstat",
            "-z",
            "--no-ext-diff",
            "--no-textconv",
            "--no-renames",
            "--diff-filter=ACMRT",
            base,
            tip,
        ],
        capture_output=True,
        check=True,
    ).stdout
    binary: set[str] = set()
    for record in raw.split(b"\0"):
        if not record:
            continue
        added, deleted, path = record.split(b"\t", 2)
        if added == b"-" and deleted == b"-":
            binary.add(os.fsdecode(path))
    return binary


def added_lines(base: str, tip: str, names: list[str]) -> dict[str, list[tuple[int, str]]]:
    """{file: [(line number at tip, text)]} for every line the commit ADDS.

    Everything this hook judges is judged on added lines only. A file that already carried a
    keyword-shaped string on the remote (test fixtures, a `changeme` placeholder) must not make
    an unrelated edit to that file unpushable — that is not new exposure, and refusing it would
    teach people `--no-verify` (measured 2026-09-02 on the first real push through this hook).
    """
    out: dict[str, list[tuple[int, str]]] = {}
    for path in names:
        # Supplying one exact path at a time means patch header quoting can never alter the key.
        diff = git(
            "diff",
            "--no-color",
            "--no-ext-diff",
            "--no-textconv",
            "--no-renames",
            "--unified=0",
            base,
            tip,
            "--",
            path,
        )
        lineno = 0
        in_hunk = False
        # Git separates patch lines with LF only. CR and Unicode/control separators are
        # content, including when a finding follows them on the same added line.
        for line in diff.split("\n"):
            if line.startswith("@@"):
                # @@ -a[,b] +c[,d] @@ — c is the first line number of the added run at the tip
                plus = line.split("+", 1)[1].split(" ", 1)[0]
                lineno = int(plus.split(",", 1)[0])
                in_hunk = True
            elif in_hunk and line.startswith("+"):
                out.setdefault(path, []).append((lineno, line[1:]))
                lineno += 1
            elif in_hunk and line.startswith(" "):
                lineno += 1
    return out


def commit_additions(commit: str) -> tuple[list[str], set[str], dict[str, list[tuple[int, str]]]]:
    """Intersect added tip positions across parents, preserving new merge resolutions.

    A line inherited from any parent was either already remote or is scanned at that parent's
    introducing commit. Diffing only the first parent would misclassify merged remote fixtures.
    Skipping merges would miss secrets created during conflict resolution.
    """
    parents = parents_or_empty(commit)
    base = parents[0]
    names = set(changed_files(base, commit))
    binary = binary_files(base, commit)
    added = added_lines(base, commit, sorted(names - binary))
    for parent in parents[1:]:
        names.intersection_update(changed_files(parent, commit))
        binary.update(binary_files(parent, commit))
        other = added_lines(parent, commit, sorted(names - binary))
        positions = {path: {number for number, _ in lines} for path, lines in other.items()}
        added = {
            path: [line for line in lines if line[0] in positions.get(path, set())]
            for path, lines in added.items()
            if path in names and path not in binary
        }
    binary.intersection_update(names)
    added = {path: lines for path, lines in added.items() if lines}
    return sorted(set(added) | binary), binary, added


def refuse_unscanned(names: list[str], reason: str, remedy: str) -> NoReturn:
    sys.stderr.write(f"hapax-prepush-secret-scan: {reason}\n")
    for path in names:
        sys.stderr.write(f"  unscanned content: {path}\n")
    sys.stderr.write(f"Remedy: {remedy}\n")
    sys.exit(3)


def scan_with_detector(
    tip: str, names: list[str], added: dict[str, list[tuple[int, str]]]
) -> dict[str, list[str]]:
    """Return {file: [types]} for detect-secrets findings on ADDED lines of files at `tip`."""
    if not names:
        return {}
    # detect-secrets 1.5.0 rewrites backslashes as separators in its single-file
    # branch and silently skips the resulting missing path. Reject them even for
    # multi-file scans. Canonical relative components also keep staging one-to-one:
    # no absolute paths, empty components, or dot/parent aliases through pathlib.
    unsupported = [
        p for p in names if "\\" in p or any(part in {"", ".", ".."} for part in p.split("/"))
    ]
    if unsupported:
        refuse_unscanned(
            [ascii(p) for p in unsupported],
            "REFUSED [unsupported-filename]: path cannot be staged and scanned by its literal name",
            "rename these files to relative paths without backslashes or empty/dot/parent "
            "components, then amend/rebase the affected commits and retry the push.",
        )
    # --all-files is load-bearing: without it detect-secrets enumerates files via `git ls-files`,
    # which fails silently in a non-git scratch directory and reports ZERO findings on ANY input.
    # (Measured 2026-09-02: the flagless form scanned nothing and returned a clean result.)
    exe = shutil.which("detect-secrets")
    cmd = [exe] if exe else ["uvx", "detect-secrets==1.5.0"]
    cmd += ["scan", "--all-files", "."]
    for filter_path in DISABLED_DETECTOR_FILTERS:
        cmd += ["--disable-filter", filter_path]
    tmp = Path(tempfile.mkdtemp(prefix="hapax-prepush-"))
    try:
        flagged: dict[str, list[str]] = {}
        for p in names:
            blob = subprocess.run(
                ["git", "--literal-pathspecs", "show", f"{tip}:{p}"], capture_output=True
            )
            if blob.returncode != 0:
                refuse_unscanned(
                    names,
                    f"could not read committed content; refusing because it was not scanned: {p}",
                    "repair or fetch the missing Git object and retry the push.",
                )
            try:
                blob.stdout.decode("utf-8")
            except UnicodeDecodeError:
                # detect-secrets silently skips undecodable files, even if the added
                # lines are UTF-8 and only the unchanged content has invalid bytes.
                refuse_unscanned(
                    [p],
                    "committed content is not valid UTF-8; refusing because it cannot be scanned",
                    "convert the file to UTF-8 or remove it, then amend/rebase the affected "
                    "commits and retry the push.",
                )
            # detect-secrets opens files with universal newlines; Git counts only LF.
            # Keep the bytes intact and map each detector line to its containing Git
            # line. CRLF advances both counters once; a bare CR advances only the detector.
            git_line = 1
            positions = {1: git_line}
            for detector_line, separator in enumerate(re.finditer(rb"\r\n?|\n", blob.stdout), 2):
                git_line += b"\n" in separator.group()
                positions[detector_line] = git_line
            target = tmp / p
            target.parent.mkdir(parents=True, exist_ok=True)
            # Keep exactly one file in the scratch tree for every invocation. In
            # 1.5.0, scan_files uses a Pool for multiple files; its initializer
            # configure_filters restores DEFAULT_FILTERS (including is_non_text_file)
            # even when the CLI disabled them. num_processors=1 still uses a Pool.
            # A successful scan is followed by unlink before staging the next file.
            # 1.5.0's YAML and INI transformers drop comments/keys. Retain the
            # normal scan, then add a raw view of the same filename and bytes.
            # The first-line @ marker is invalid YAML and INI (also after the
            # eager INI parser adds a section), forcing their ParsingError ->
            # raw-lines route. It adds exactly one detector line, mapped below.
            # Keep the extension so language-specific pragmas remain unchanged.
            for prefix, offset in ((b"", 0), (b"@hapax-prepush-raw@\n", 1)):
                target.write_bytes(prefix + blob.stdout)
                try:
                    run = subprocess.run(cmd, cwd=tmp, capture_output=True, timeout=600)
                except (FileNotFoundError, subprocess.TimeoutExpired) as e:
                    # No scanner means no scan: refuse loudly rather than pass silently.
                    refuse_unscanned(
                        names,
                        f"REFUSED [detector-unavailable]: detect-secrets unavailable ({type(e).__name__}); refusing because the scan did not complete",
                        "install it (`uv tool install detect-secrets`) and retry; for a timeout, "
                        "repair the detector before retrying.",
                    )
                if run.returncode != 0:
                    refuse_unscanned(
                        names,
                        f"REFUSED [detector-failed]: detect-secrets failed with exit status {run.returncode}; refusing because the scan did not complete",
                        "repair or reinstall detect-secrets and retry the push.",
                    )
                try:
                    payload = json.loads(run.stdout)
                except (json.JSONDecodeError, UnicodeDecodeError):
                    refuse_unscanned(
                        names,
                        "REFUSED [detector-result]: detect-secrets produced invalid JSON; refusing because the scan result is unknown",
                        "repair or reinstall detect-secrets and retry the push.",
                    )
                results = payload.get("results") if isinstance(payload, dict) else None
                if not isinstance(results, dict):
                    refuse_unscanned(
                        names,
                        "REFUSED [detector-result]: detect-secrets response has no results object; refusing because the scan result is unknown",
                        "repair or reinstall detect-secrets and retry the push.",
                    )
                if payload.get("version") != "1.5.0":
                    refuse_unscanned(
                        [p],
                        "REFUSED [detector-version]: scan guarantees require detect-secrets 1.5.0",
                        "install the inspected version (`uv tool install detect-secrets==1.5.0`) "
                        "and retry the push; review scan behavior before changing versions.",
                    )
                for temp_name, hits in results.items():
                    path = temp_name.removeprefix("./")
                    new_lines = {ln for ln, _ in added.get(path, [])}
                    hash_bearing = path.startswith(GENERATED_HASH_BEARING)
                    kinds = sorted(
                        {
                            h["type"]
                            for h in hits
                            if positions.get(h.get("line_number", 0) - offset) in new_lines
                            and not (hash_bearing and h["type"] in ENTROPY_TYPES)
                        }
                    )
                    if kinds:
                        flagged[path] = sorted(set(flagged.get(path, [])) | set(kinds))
            target.unlink()
        return flagged
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def scan_added_lines(
    added: dict[str, list[tuple[int, str]]],
) -> tuple[dict[str, int], dict[str, int]]:
    """Over ADDED lines only: ({file: home-path line count}, {file: vendor-key-shaped line count}).

    The vendor-key regex covers prefixes detect-secrets 1.5.0 does not know (Anthropic `sk-ant-`,
    xAI `xai-`, Hugging Face `hf_`, GitLab `glpat-`) alongside ones it does; a second detector that
    only ever ADDS refusals narrows the failure path, it does not widen it.
    """
    homes: dict[str, int] = {}
    vendor: dict[str, int] = {}
    for path, lines in added.items():
        unit_file = path.startswith(UNIT_ABSOLUTE_PATH_DIRS)
        for _lineno, text in lines:
            if not unit_file and HOME_PATH.match("+" + text):
                homes[path] = homes.get(path, 0) + 1
            if VENDOR_PREFIX_RE.search(text) and "pragma: allowlist secret" not in text:
                vendor[path] = vendor.get(path, 0) + 1
    return homes, vendor


def main(argv: list[str]) -> int:
    remote = argv[1] if len(argv) > 1 else "?"
    skip = (
        subprocess.run(
            ["git", "config", "--get-all", "hapax.prepushScan.skipRemote"],
            capture_output=True,
        )
        .stdout.decode("utf-8", errors="surrogateescape")
        .split("\n")
    )
    if remote in skip:
        sys.stderr.write(
            f"hapax-prepush-secret-scan: remote '{remote}' exempt by local config hapax.prepushScan.skipRemote\n"
        )
        return 0
    refs = [
        line.split(" ")
        for line in sys.stdin.buffer.read().decode("utf-8", errors="surrogateescape").split("\n")
        if line
    ]
    if not refs:
        return 0
    if all(local_sha == ZERO for _local_ref, local_sha, _remote_ref, _remote_sha in refs):
        return 0
    destination = argv[2] if len(argv) > 2 else ""
    # Protocol tips are advertised by this push's destination too, even if ls-remote fails.
    bases = remote_commits(destination) + [row[3] for row in refs if row[3] != ZERO]
    failed = False
    for local_ref, local_sha, remote_ref, _remote_sha in refs:
        if local_sha == ZERO:
            continue  # deletion: nothing new leaves the machine
        try:
            commits = pushed_commits(bases, local_sha)
        except subprocess.CalledProcessError:
            refuse_unscanned(
                [],
                "could not resolve pushed history; refusing because the scan did not complete",
                "fetch the destination's missing history and retry the push.",
            )
        for commit in commits:
            names, binary, added = commit_additions(commit)
            scannable_names = [path for path in names if path not in binary]
            # `ds_findings` maps file -> detect-secrets FINDING TYPE NAMES (e.g. "AWS Access Key");
            # no value from the scanned content is ever held here or written anywhere.
            ds_findings = scan_with_detector(commit, scannable_names, added)
            homes, vendor = scan_added_lines(added)
            if binary or ds_findings or homes or vendor:
                failed = True
                sys.stderr.write(
                    f"\nREFUSED push of {local_ref} -> {remote}/{remote_ref}; "
                    f"commit {commit[:10]} ({len(names)} files add content vs every parent):\n"
                )
                for f, finding_types in ds_findings.items():
                    sys.stderr.write(f"  secret-shaped: {f}  {finding_types}\n")
                for f, n in vendor.items():
                    sys.stderr.write(f"  vendor-key-shaped in {n} added line(s): {f}\n")
                for f, n in homes.items():
                    sys.stderr.write(f"  home path in {n} added line(s): {f}\n")
                for f in sorted(binary):
                    sys.stderr.write(f"  unscannable binary content: {f}\n")
    if failed:
        sys.stderr.write(
            "\nRemedy: remove or redact the flagged content and amend/rebase. For a false-positive "
            "secret finding, add `# pragma: allowlist secret` on that line. Binary-classified "
            "content cannot be scanned; remove it from the pushed commits and obtain independent "
            "review. Types and counts only are printed; values never are.\n"
        )
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
