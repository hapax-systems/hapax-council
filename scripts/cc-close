#!/usr/bin/env bash
# cc-close <task_id> [--pr N] [--status done|withdrawn|superseded]
#
# Close out a vault cc-task: rewrite frontmatter (status: done by
# default; completed_at: now), move the note from active/ to closed/,
# and clear the session's claim file.
#
# Active blocked-with-evidence work is not a cc-close outcome. Keep the note in
# active/ with status: blocked, blocked_reason: <machine-code>, and
# blocked_witness: <current-witness-path>; cc-claim/cascade preserve that state.
#
# Symlink to ~/.local/bin/cc-close for quick access:
#   ln -sf ~/projects/hapax-council/scripts/cc-close ~/.local/bin/cc-close

set -euo pipefail

# Resolve through symlinks — cc-close is installed as ~/.local/bin/cc-close -> the
# deployed worktree, and bash does NOT resolve symlinks for BASH_SOURCE. Without
# this, SCRIPT_DIR was ~/.local/bin, ROLE_HELPER pointed at the nonexistent
# ~/.local/hooks/scripts/agent-role.sh, and the helper was never sourced — so
# through the entrypoint the operator actually invokes, NEITHER role resolver
# existed and the claim-release block below could never run. cc-claim carries this
# same resolution with a comment naming this exact hazard; cc-close did not, which
# is why the release was dead through the installed path regardless of which
# resolver it named.
# No `command -v readlink` guard. A missing readlink makes the substitution exit
# non-zero, so `|| printf` yields the same VALUE the guard's else-branch produced —
# the unresolved BASH_SOURCE — with the shell's diagnostic suppressed by 2>/dev/null.
# Equivalent in result, not in mechanism. The guard added a branch reachable only by
# removing /usr/bin from PATH, which also removes dirname, so every test of it died
# of something else. One path, reachable and covered, beats two where one is not.
_cc_self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$_cc_self")" && pwd)"
ROLE_HELPER="$SCRIPT_DIR/../hooks/scripts/agent-role.sh"
if [[ ! -f "$ROLE_HELPER" ]]; then
  # Refuse rather than degrade. The previous behaviour — carry on with env-only
  # role resolution — is precisely how the claim leaked: a close that cannot
  # resolve its own role silently releases nothing and strands the session behind
  # the task it just closed. A missing helper means a broken install, and saying
  # so beats completing a close that only appears to have worked.
  echo "cc-close: agent-role.sh not found next to the installed script (looked in $ROLE_HELPER). Without it the claim lease cannot be released and this close would strand the session. Next: repair the install (hapax-source-activate) or invoke scripts/cc-close from a complete checkout." >&2
  exit 2
fi
# shellcheck source=../hooks/scripts/agent-role.sh
. "$ROLE_HELPER"

if [[ $# -lt 1 ]]; then
  echo "usage: cc-close <task_id> [--pr N] [--status done|withdrawn|superseded]" >&2
  echo "       active blocked evidence stays in active/: status=blocked, blocked_reason, blocked_witness" >&2
  exit 1
fi

task_id="$1"; shift
pr=""
final_status="done"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --pr) pr="$2"; shift 2 ;;
    --status) final_status="$2"; shift 2 ;;
    --debt) debt_reason="$2"; shift 2 ;;
    --retroactive) retroactive=1; shift ;;
    *) echo "cc-close: unknown arg '$1'" >&2; exit 1 ;;
  esac
done

case "$final_status" in
  done|withdrawn|superseded) ;;
  *) echo "cc-close: --status must be done, withdrawn, or superseded (got '$final_status')" >&2; exit 1 ;;
esac

# Resolve the claiming role with hapax_effective_role — the SAME resolver the
# WRITER (cc-claim) and the READER (cc-task-gate.impl.sh) both use. A roleless
# session has no explicit identity but does have a session id, so
# hapax_agent_identity returns EMPTY exactly where hapax_effective_role returns
# `roleless`. Binding here with hapax_agent_identity left $role empty, which
# skipped the claim-release block below entirely (its `[[ -n "$role" ]]` guard)
# and stranded the session behind the task it had just closed: the gate,
# resolving through the OTHER function, still found the lease and blocked every
# subsequent mutation. Measured twice on 2026-08-21, both times after a clean
# close, each needing an operator rescue.
# Sourcing agent-role.sh is now mandatory above, so this is the only role binding
# in the file. The env cascade that used to sit here (HAPAX_AGENT_NAME,
# CODEX_THREAD_NAME, ... CLAUDE_ROLE) is deleted rather than guarded: it read the
# exact names hapax_agent_identity reads, in the exact order, so it never changed
# an outcome — it only kept a second copy of the resolver's precedence list in a
# file obliged to agree with it, which is how a releaser drifts from its writer.
role="$(hapax_effective_role 2>/dev/null || true)"
if [[ -z "$role" ]]; then
  # The resolver loaded but could not answer — a session with neither a role signal
  # nor a session id. Proceeding here is the silent close all over again: the
  # release block below is guarded on $role, so it would be skipped and any lease
  # naming this task would survive into the strand.
  #
  # This refuses UNCONDITIONALLY, and does not inspect the claim cache at all.
  #
  # Earlier revisions scanned the cache to refuse only when a lease actually named
  # this task. Review found a race in the classification, then — once the deletion
  # was removed — the same race on the read: cc-claim publishes an epoch sidecar and
  # a claim file as two steps, so ANY point-in-time look at the cache can observe a
  # half-published claim, and "no lease names this task" can go stale between the
  # check and the close. Closing that gap needs a locking protocol the claim plane
  # does not have; inventing half of one inside cc-close would be worse than naming
  # the gap, which is filed separately.
  #
  # So the guard asks a question it can answer without reading shared state: can
  # this process know which lease is ITS OWN? Without a role it cannot, and a close
  # that cannot identify its own lease cannot correctly release it. Refusing is not
  # a heuristic here — it is the honest report of an unanswerable question.
  #
  # The cost is that a session with neither a role signal nor a session id cannot
  # close even when no lease exists. Every supported runtime exports one or the
  # other (Claude Code CLAUDE_CODE_SESSION_ID, Codex CODEX_SESSION/CODEX_THREAD_ID,
  # spawners HAPAX_AGENT_NAME), so this is a bare shell, and its remedy is one word.
  # The remedy resolves the CONDITION rather than any artifact. Earlier drafts named
  # a reap tool, and each time some case fell outside what it can touch
  # (sweep_stale_claims globs cc-active-task-* and skips unreadable files) — the
  # sealed-exit failure this row exists to stop reproducing.
  #
  # Naming the role cures the cause: with a role resolved, cc-close clears its own
  # keys through the normal release path and this check does not run at all. It needs
  # no other tool, no privileges, and no operator — which is also why no env
  # killswitch is offered. A switch read from this process's own environment would be
  # unreachable from the session being refused, exactly the defect filed separately
  # about the gate's own bypass line.
  # BOTH identifiers are named, because a role alone does not cover the canonical
  # lease shape. cc-claim writes cc-active-task-<role>-<session_id> when a session id
  # exists and the legacy cc-active-task-<role> when it does not, and the release loop
  # below can only clear the session-keyed form when it knows the session id. Naming
  # only the role would clear the legacy file and leave the canonical one — a remedy
  # that half-works, which is the failure this row keeps meeting.
  echo "cc-close: cannot resolve this session's role, so it cannot tell which claim lease is its own, and a close that cannot release its own lease would strand this session behind the task it just closed. Next: re-run naming the identity that holds the claim — HAPAX_AGENT_ROLE=<role> HAPAX_SESSION_ID=<session_id> cc-close $task_id --status $final_status. The session id is the suffix of the lease file in ${HAPAX_CC_CLAIMS_DIR:-\$HOME/.cache/hapax} (cc-active-task-<role>-<session_id>); omit it only for a legacy cc-active-task-<role> lease, which has none." >&2
  exit 2
fi

ROOT_HELPER="$SCRIPT_DIR/../hooks/scripts/cc-task-root.sh"
if [[ ! -f "$ROOT_HELPER" ]]; then
  echo "cc-close: cc-task-root.sh missing next to the installed scripts. Next: restore hooks/scripts/cc-task-root.sh" >&2
  exit 2
fi
# shellcheck source=../hooks/scripts/cc-task-root.sh
. "$ROOT_HELPER"
cc_task_root_resolve || exit $?
vault_root="$CC_TASK_ROOT"
note_path=""
# Match `<task_id>-<descriptor>.md` (most tasks).
for candidate in "$vault_root/active/$task_id-"*.md; do
  if [[ -f "$candidate" ]]; then
    note_path="$candidate"
    break
  fi
done
# Fallback: exact-match `<task_id>.md` for tasks without a descriptor
# suffix. Mirrors the cc-claim glob; same root-cause (the literal `-`
# in the original glob misses descriptor-less filenames).
if [[ -z "$note_path" ]] && [[ -f "$vault_root/active/$task_id.md" ]]; then
  note_path="$vault_root/active/$task_id.md"
fi
if [[ -z "$note_path" ]]; then
  echo "cc-close: task '$task_id' not in $vault_root/active/ (already closed?)" >&2
  exit 2
fi

if ! command -v python3 &>/dev/null; then
  echo "cc-close: python3 missing; cannot rewrite frontmatter" >&2
  exit 3
fi

frontmatter_task_id() {
  local file="$1"
  python3 - "$file" <<'PYEOF'
import re
import sys
from pathlib import Path

text = Path(sys.argv[1]).read_text(encoding="utf-8")
frontmatter = ""
if text.startswith("---"):
    end = text.find("\n---", 3)
    if end != -1:
        frontmatter = text[3:end]

for line in frontmatter.splitlines():
    match = re.match(r"\s*task_id\s*:\s*['\"]?([^'\"#\s]+)", line)
    if match:
        print(match.group(1).strip())
        break
PYEOF
}

closed_duplicate=""
for candidate in "$vault_root/closed/$task_id-"*.md "$vault_root/closed/$task_id.md"; do
  [[ -f "$candidate" ]] || continue
  candidate_task_id="$(frontmatter_task_id "$candidate" || true)"
  if [[ "$candidate_task_id" == "$task_id" ]]; then
    closed_duplicate="$candidate"
    break
  fi
done
if [[ -n "$closed_duplicate" ]]; then
  echo "cc-close: BLOCKED - closed task duplicate has task_id '$task_id': $closed_duplicate" >&2
  exit 8
fi

# Rapid-closure flag — require --retroactive for tasks closed <5min after claim.
# Prevents the 22-second paperwork closure pattern found by CCTV disconfirmation.
if [[ "$final_status" == "done" && -z "${retroactive:-}" && "${HAPAX_RAPID_CLOSE_OFF:-0}" != "1" ]]; then
  claimed_at="$(python3 -c "
import re, sys
from pathlib import Path
text = Path('$note_path').read_text()
m = re.search(r'^claimed_at:\s*(.+)$', text, re.MULTILINE)
if m: print(m.group(1).strip().strip(\"'\").strip('\"'))
" 2>/dev/null || true)"
  if [[ -n "$claimed_at" ]]; then
    elapsed="$(python3 -c "
from datetime import datetime, timezone
try:
    claimed = datetime.fromisoformat('$claimed_at'.replace('Z','+00:00'))
    now = datetime.now(timezone.utc)
    print(int((now - claimed).total_seconds()))
except: print('999')
" 2>/dev/null || echo "999")"
    if [[ "$elapsed" -lt 300 ]]; then
      echo "cc-close: BLOCKED — task closed ${elapsed}s after claim (< 5min threshold)." >&2
      echo "  If this is a retroactive close of already-completed work, re-run with --retroactive." >&2
      echo "  Bypass: HAPAX_RAPID_CLOSE_OFF=1" >&2
      exit 2
    fi
  fi
fi

# Closure-discipline gate (cc-task cc-task-closure-hook-acceptance-criteria-gate):
# refuse the move when any `## Acceptance criteria` checkbox is unchecked.
# The Bash PreToolUse hook catches manual mv / git mv; this call catches
# the cc-close path (which uses python rename, invisible to the Bash hook).
# Both surfaces share the same checker. Bypass via HAPAX_CC_TASK_CLOSURE_GATE_OFF=1.
# Skip the gate for non-`done` outcomes (withdrawn / superseded close paths
# are operator-marked terminal states where the AC-completeness contract
# does not apply).
if [[ "$final_status" == "done" ]]; then
  CHECKER="$SCRIPT_DIR/cc-task-closure-check.py"
  if [[ -f "$CHECKER" ]]; then
    set +e
    python3 "$CHECKER" "$note_path"
    gate_rc=$?
    set -e
    if [[ "$gate_rc" -ne 0 ]]; then
      exit "$gate_rc"
    fi
  fi

  # Acceptance-receipt gate (routing Phase 0.2) — review-floor
  # (frontier_review_required) tasks close only with a signed acceptance
  # receipt (<task_id>.acceptance.yaml beside the note). The checker honors
  # HAPAX_ACCEPTANCE_RECEIPT_GATE_OFF=1 directly; non-review-floor tasks
  # pass through untouched.
  RECEIPT_CHECKER="$SCRIPT_DIR/cc-close-acceptance-receipt-check.py"
  if [[ -f "$RECEIPT_CHECKER" ]]; then
    set +e
    python3 "$RECEIPT_CHECKER" "$note_path"
    receipt_rc=$?
    set -e
    if [[ "$receipt_rc" -ne 0 ]]; then
      exit "$receipt_rc"
    fi
  fi

  # PR-merge evidence gate — verify PR is merged before allowing done status.
  # Prevents "status: done but PR is open" false-completion pattern.
  # Bypass: HAPAX_PR_MERGE_GATE_OFF=1
  if [[ "${HAPAX_PR_MERGE_GATE_OFF:-0}" != "1" ]]; then
    PR_MERGE_CHECKER="$SCRIPT_DIR/cc-close-pr-merge-check.py"
    if [[ -f "$PR_MERGE_CHECKER" ]]; then
      set +e
      python3 "$PR_MERGE_CHECKER" "$note_path" ${pr:+--pr "$pr"}
      merge_rc=$?
      set -e
      if [[ "$merge_rc" -ne 0 ]]; then
        exit "$merge_rc"
      fi
    fi
  fi

  # Artifact disposition gate
  DISP_CHECKER="$SCRIPT_DIR/cc-task-artifact-disposition-check.py"
  if [[ -f "$DISP_CHECKER" ]]; then
    set +e
    if [[ -n "${debt_reason:-}" ]]; then
      python3 "$DISP_CHECKER" "$note_path" "$task_id" --debt "$debt_reason"
    else
      python3 "$DISP_CHECKER" "$note_path" "$task_id"
    fi
    disp_rc=$?
    set -e
    if [[ "$disp_rc" -ne 0 ]]; then
      exit "$disp_rc"
    fi
  fi

  # Sibling-task advisory check — warns about stalled siblings under the same
  # parent request. Advisory only (exit 0), prevents the remediation execution
  # gap found by CCTV disconfirmation (PR #3659).
  SIBLING_CHECKER="$SCRIPT_DIR/cc-close-sibling-check.py"
  if [[ -f "$SIBLING_CHECKER" ]]; then
    python3 "$SIBLING_CHECKER" "$note_path" || true
  fi
fi

python3 - "$note_path" "$task_id" "$final_status" "$pr" "$role" <<'PYEOF'
import re
import sys
from datetime import datetime, timezone
from pathlib import Path

path, task_id, final_status, pr, role = (Path(sys.argv[1]), *sys.argv[2:])
text = path.read_text(encoding="utf-8")
now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

text = re.sub(r"^status:.*$", f"status: {final_status}", text, count=1, flags=re.MULTILINE)
text = re.sub(
    r"^completed_at:.*$", f"completed_at: {now}", text, count=1, flags=re.MULTILINE
)
text = re.sub(
    r"^updated_at:.*$", f"updated_at: {now}", text, count=1, flags=re.MULTILINE
)
if pr:
    text = re.sub(r"^pr:.*$", f"pr: {pr}", text, count=1, flags=re.MULTILINE)
log_line = f"- {now} {role or 'session'} closed as {final_status}"
if pr:
    log_line += f" (PR #{pr})"
log_line += " (cc-close)\n"
text = text.replace("## Session log\n", f"## Session log\n{log_line}", 1)

# Move from active/ to closed/.
new_path = path.parent.parent / "closed" / path.name
new_path.parent.mkdir(parents=True, exist_ok=True)
tmp = new_path.with_suffix(new_path.suffix + ".tmp")
tmp.write_text(text, encoding="utf-8")
tmp.replace(new_path)
path.unlink()
print(f"cc-close: moved '{task_id}' to closed/, status={final_status}")

# The acceptance receipt (routing Phase 0.2) lives ALONGSIDE the note —
# keep that invariant across the move so closed review-floor tasks stay
# closure-valid for the autoqueue and audits.
receipt = path.parent / f"{task_id}.acceptance.yaml"
if receipt.is_file():
    receipt.replace(new_path.parent / receipt.name)
    print(f"cc-close: moved acceptance receipt '{receipt.name}' to closed/")
PYEOF

# Clear the claim file(s) that still name this task. cc-claim writes BOTH a
# legacy cc-active-task-<role> AND a session-keyed cc-active-task-<role>-<sid>
# (agent-role.sh hapax_session_id, reform Phase 1 FM-2). Clearing only the
# legacy file leaked the session-keyed lease until its 6h TTL — and the gate
# reads the session-keyed file FIRST, so it kept seeing the just-closed task
# (reform finding #12/#13). Clear this session's lease forms, each only when its
# head still names the closed task (never clobber a lease for other work).
if [[ -n "$role" ]]; then
  session_id=""
  if declare -F hapax_session_id >/dev/null 2>&1; then
    session_id="$(hapax_session_id 2>/dev/null || true)"
  fi
  cleared_claim=0
  for claim_key in \
    "$role" \
    ${session_id:+"$role-$session_id"}; do
    claim_file="$HOME/.cache/hapax/cc-active-task-$claim_key"
    if [[ -f "$claim_file" ]] &&
       [[ "$(head -n1 "$claim_file" | tr -d '[:space:]')" == "$task_id" ]]; then
      # The cc-claim-epoch sidecar carries the claim age for task_is_terminal;
      # clear it with its claim file so a stale epoch can never mis-age a
      # future claim. Explicit path construction — substring substitution on
      # the full path would rewrite a parent-directory occurrence instead.
      rm -f "$claim_file" "$HOME/.cache/hapax/cc-claim-epoch-$claim_key"
      echo "cc-close: cleared claim file '$claim_file' (role '$role')"
      cleared_claim=1
    fi
  done
  if [[ "$cleared_claim" == 1 ]]; then
    systemctl --user start hapax-cc-hygiene.service 2>/dev/null || true
  fi
fi

# Best-effort request lifecycle reconciliation. `request-intake-consumer`
# remains read-only; this writer is explicit and conservative, and only runs
# after a successful fulfilling cc-task close.
if [[ "$final_status" == "done" && "${HAPAX_REQUEST_RECONCILER_OFF:-0}" != "1" && "${HAPAX_CC_HYGIENE_OFF:-0}" != "1" ]]; then
  reconciler="$SCRIPT_DIR/request-fulfillment-reconciler"
  if [[ -x "$reconciler" ]]; then
    set +e
    "$reconciler" --apply --task-id "$task_id" --write-report --quiet
    reconcile_rc=$?
    set -e
    if [[ "$reconcile_rc" -ne 0 ]]; then
      echo "cc-close: request fulfillment reconciler failed rc=$reconcile_rc" >&2
    fi
  fi

  # Phase-advance: if this task is Phase N, create Phase N+1 if the request has more phases.
  phase_advance="$SCRIPT_DIR/cc-phase-advance.py"
  if [[ -f "$phase_advance" ]]; then
    set +e
    python3 "$phase_advance" "$vault_root/closed/$(basename "$note_path")" "$task_id"
    set -e
  fi

  # Cascade-unblock: transition blocked tasks whose depends_on are now all satisfied.
  cascade="$SCRIPT_DIR/cc-cascade-unblock"
  if [[ -x "$cascade" ]]; then
    set +e
    "$cascade" "$task_id"
    set -e
  fi
fi
