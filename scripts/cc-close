#!/usr/bin/env bash
# cc-close <task_id> [--pr N] [--status done|withdrawn|superseded]
#
# This wrapper has no independent mutation path. Every operational close enters
# the shared claim-bound close transaction; admission failures leave task and
# claim state byte-identical.
# Rec 1 (#4586): --retroactive skips AC/receipt/disposition; merge is evidence.
# Gate 0B killswitch (HAPAX_GATE0B_CLAIM_PUBLICATION_OFF=1) HOLDs close.
# Killswitch release: unset HAPAX_GATE0B_CLAIM_PUBLICATION_OFF, cc-claim the
# same task so an admitted publication exists, then cc-close.
# Recheck: uv run pytest tests/shared/test_sdlc_close.py tests/shared/test_coord_projection.py tests/scripts/test_hapax_fsm_smoke.py tests/scripts/test_cc_close_isolated_runner.py
#
# Dispatch-staleness markers (must remain literal substrings of this file):
#   frontmatter_task_id
#   closed_duplicate
#   closed task duplicate has task_id

set -euo pipefail

_cc_self="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  _cc_self="$(readlink -f "$_cc_self" 2>/dev/null || printf '%s' "$_cc_self")"
fi
SCRIPT_DIR="$(cd "$(dirname "$_cc_self")" && pwd)"
ROLE_HELPER="$SCRIPT_DIR/../hooks/scripts/agent-role.sh"
if [[ -f "$ROLE_HELPER" ]]; then
  # shellcheck source=../hooks/scripts/agent-role.sh
  . "$ROLE_HELPER"
fi

if [[ $# -lt 1 ]]; then
  echo "usage: cc-close <task_id> [--pr N] [--status done|withdrawn|superseded]" >&2
  echo "       active blocked evidence stays active with a reason and witness" >&2
  exit 1
fi

task_id="$1"
shift
pr=""
final_status="done"
debt_reason=""
retroactive=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --pr)
      if [[ $# -lt 2 ]]; then
        echo "cc-close: --pr requires a merged PR number" >&2
        echo "Next action: pass --pr N from the merged pull request, then retry." >&2
        exit 1
      fi
      pr="$2"
      shift 2
      ;;
    --status)
      if [[ $# -lt 2 ]]; then
        echo "cc-close: --status requires done, withdrawn, or superseded" >&2
        echo "Next action: pass --status done (or withdrawn/superseded), then retry." >&2
        exit 1
      fi
      final_status="$2"
      shift 2
      ;;
    --debt)
      if [[ $# -lt 2 ]]; then
        echo "cc-close: --debt requires a reason string" >&2
        echo "Next action: pass --debt \"reason\", then retry." >&2
        exit 1
      fi
      debt_reason="$2"
      shift 2
      ;;
    # Threaded through to shared.sdlc_close (which declares --retroactive) rather
    # than refused here. cc-pr-merge-watcher builds automatic closes as
    #   cc-close <task> --pr <n> --retroactive
    --retroactive) retroactive=true; shift ;;
    *) echo "cc-close: unknown arg '$1'" >&2; exit 1 ;;
  esac
done

case "$final_status" in
  done|withdrawn|superseded) ;;
  *) echo "cc-close: --status must be done, withdrawn, or superseded (got '$final_status')" >&2; exit 1 ;;
esac

if declare -F hapax_effective_role >/dev/null 2>&1; then
  role="$(hapax_effective_role 2>/dev/null || true)"
else
  role="${HAPAX_AGENT_ROLE:-${CODEX_ROLE:-${CLAUDE_ROLE:-}}}"
fi
if [[ -z "$role" ]]; then
  echo "cc-close: cannot determine the claim-bound role" >&2
  echo "Next action: export HAPAX_AGENT_ROLE to the claim lane, or rerun from the governed launcher, then retry." >&2
  exit 2
fi

PROJECT_PYTHON="$SCRIPT_DIR/../.venv/bin/python"
if [[ ! -x "$PROJECT_PYTHON" ]]; then
  echo "cc-close: project_runtime_unprovisioned: expected pinned interpreter at $PROJECT_PYTHON" >&2
  echo "Next action: uv sync in this worktree, then rerun cc-close." >&2
  exit 3
fi

session_id=""
if declare -F hapax_session_id >/dev/null 2>&1; then
  session_id="$(hapax_session_id 2>/dev/null || true)"
else
  session_id="${HAPAX_SESSION_ID:-}"
fi

close_args=("$task_id" --status "$final_status")
if [[ -n "$pr" ]]; then
  close_args+=(--pr "$pr")
fi
if [[ -n "$debt_reason" ]]; then
  close_args+=(--debt "$debt_reason")
fi
if [[ "$retroactive" == "true" ]]; then
  close_args+=(--retroactive)
fi

set +e
(
  cd "$SCRIPT_DIR/.."
  HAPAX_AGENT_ROLE="$role" HAPAX_SESSION_ID="$session_id" \
    "$PROJECT_PYTHON" -I - "$SCRIPT_DIR/.." "${close_args[@]}" <<'PYEOF'
import sys
from pathlib import Path

repo_root = Path(sys.argv[1]).resolve()
if str(repo_root) not in sys.path:
    sys.path.insert(0, str(repo_root))

from shared.sdlc_close import main

raise SystemExit(main(sys.argv[2:]))
PYEOF
)
close_rc=$?
set -e
if [[ "$close_rc" -eq 0 && "$final_status" == "done" ]]; then
  echo "cc-close: HOLD - request reconciliation, phase advance, and cascade require a governed post-close transaction" >&2
fi
exit "$close_rc"
