#!/usr/bin/env bash
# cc-close <task_id> [--pr N] [--status done|withdrawn|superseded]
#
# Close out a vault cc-task: rewrite frontmatter (status: done by
# default; completed_at: now), move the note from active/ to closed/,
# and clear the session's claim file.
#
# Active blocked-with-evidence work is not a cc-close outcome. Keep the note in
# active/ with status: blocked, blocked_reason: <machine-code>, and
# blocked_witness: <current-witness-path>; cc-claim/cascade preserve that state.
#
# Symlink to ~/.local/bin/cc-close for quick access:
#   ln -sf ~/projects/hapax-council/scripts/cc-close ~/.local/bin/cc-close

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROLE_HELPER="$SCRIPT_DIR/../hooks/scripts/agent-role.sh"
if [[ -f "$ROLE_HELPER" ]]; then
  # shellcheck source=../hooks/scripts/agent-role.sh
  . "$ROLE_HELPER"
fi

if [[ $# -lt 1 ]]; then
  echo "usage: cc-close <task_id> [--pr N] [--status done|withdrawn|superseded]" >&2
  echo "       active blocked evidence stays in active/: status=blocked, blocked_reason, blocked_witness" >&2
  exit 1
fi

task_id="$1"; shift
pr=""
final_status="done"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --pr) pr="$2"; shift 2 ;;
    --status) final_status="$2"; shift 2 ;;
    --debt) debt_reason="$2"; shift 2 ;;
    --retroactive) retroactive=1; shift ;;
    *) echo "cc-close: unknown arg '$1'" >&2; exit 1 ;;
  esac
done

case "$final_status" in
  done|withdrawn|superseded) ;;
  *) echo "cc-close: --status must be done, withdrawn, or superseded (got '$final_status')" >&2; exit 1 ;;
esac

role="${HAPAX_AGENT_NAME:-${CODEX_THREAD_NAME:-${CODEX_SESSION_NAME:-${CODEX_SESSION:-${CODEX_ROLE:-${HAPAX_AGENT_ROLE:-${CLAUDE_ROLE:-}}}}}}}"
if [[ -z "$role" ]] && declare -F hapax_agent_identity >/dev/null 2>&1; then
  role="$(hapax_agent_identity 2>/dev/null || true)"
fi

ROOT_HELPER="$SCRIPT_DIR/../hooks/scripts/cc-task-root.sh"
if [[ ! -f "$ROOT_HELPER" ]]; then
  echo "cc-close: cc-task-root.sh missing next to the installed scripts. Next: restore hooks/scripts/cc-task-root.sh" >&2
  exit 2
fi
# shellcheck source=../hooks/scripts/cc-task-root.sh
. "$ROOT_HELPER"
cc_task_root_resolve || exit $?
vault_root="$CC_TASK_ROOT"
note_path=""
# EVERY candidate that DECLARES this id must be considered, and more than one is
# fatal. Selecting the "first" match — by any ordering — is what let
# `cc-close t1` withdraw live work: first t1-next.md by prefix, then t1-a.md when
# two notes declared t1 and the caller had only seen one of them. A caller cannot
# make this safe, because a checker reasons about a FILTERED view of the vault
# (parse_task_note drops notes missing `type: cc-task`) while cc-close mutates the
# unfiltered filesystem. Revalidating here, at the point of mutation, is the only
# place the whole truth is available.
shopt -s nullglob
_cc_candidates=("$vault_root/active/$task_id.md" "$vault_root/active/$task_id-"*.md)
shopt -u nullglob
_cc_matching=()
for _cc_candidate in "${_cc_candidates[@]}"; do
  [[ -f "$_cc_candidate" ]] || continue
  _cc_declared="$(python3 -I - "$SCRIPT_DIR/.." "$_cc_candidate" <<'PYEOF' || true
import sys

sys.path.insert(0, sys.argv[1])
from pathlib import Path

from shared.frontmatter import parse_frontmatter

fm, _body = parse_frontmatter(Path(sys.argv[2]))
value = (fm or {}).get("task_id")
print(str(value).strip() if value is not None else "")
PYEOF
  )"
  if [[ "$_cc_declared" == "$task_id" ]]; then
    _cc_matching+=("$_cc_candidate")
  fi
done
if [[ "${#_cc_matching[@]}" -gt 1 ]]; then
  printf "cc-close: refusing — %d notes in %s/active/ declare task_id '%s':\n" \
    "${#_cc_matching[@]}" "$vault_root" "$task_id" >&2
  printf '  %s\n' "${_cc_matching[@]}" >&2
  echo "Next action: resolve the duplicate identity (one note per task_id), then re-run. Nothing was modified." >&2
  exit 2
fi
if [[ "${#_cc_matching[@]}" -eq 1 ]]; then
  note_path="${_cc_matching[0]}"
fi
# Then `<task_id>-<descriptor>.md` (most tasks carry a descriptor suffix).
if [[ -z "$note_path" ]]; then
  for candidate in "$vault_root/active/$task_id-"*.md; do
    if [[ -f "$candidate" ]]; then
      note_path="$candidate"
      break
    fi
  done
fi
# Whatever was selected must actually BE the task asked for. The glob can only
# ever match a prefix, so a descriptor-suffixed neighbour of a longer id
# (`t1-next` when asked for `t1`) is reachable; comparing the note's own
# `task_id:` closes that without depending on filename conventions.
if [[ -n "$note_path" ]]; then
  # Canonical frontmatter parser, not sed. The first cut matched only an unquoted
  # `task_id:` at column zero and ADMITTED an empty result, so `"task_id": t1-next`
  # passed a request for t1 and a missing value passed everything — while a valid
  # `task_id: t1 # comment` was rejected. A guard whose failure mode is "admit" is
  # not a guard.
  selected_task_id="$(python3 -I - "$SCRIPT_DIR/.." "$note_path" <<'PYEOF' || true
import sys

sys.path.insert(0, sys.argv[1])
from pathlib import Path

from shared.frontmatter import parse_frontmatter

fm, _body = parse_frontmatter(Path(sys.argv[2]))
value = (fm or {}).get("task_id")
print(str(value).strip() if value is not None else "")
PYEOF
  )"
  if [[ -z "$selected_task_id" ]]; then
    echo "cc-close: refusing — '$note_path' declares no readable task_id. Next action: repair the note's frontmatter (a single-line 'task_id: <id>' scalar), then re-run. Nothing was modified." >&2
    exit 2
  fi
  if [[ "$selected_task_id" != "$task_id" ]]; then
    echo "cc-close: refusing — '$note_path' declares task_id '$selected_task_id', not '$task_id'. Next action: pass the exact task id, or repair the note's filename/frontmatter so they agree. Nothing was modified." >&2
    exit 2
  fi
fi
if [[ -z "$note_path" ]]; then
  echo "cc-close: task '$task_id' not in $vault_root/active/ (already closed?)" >&2
  exit 2
fi

if ! command -v python3 &>/dev/null; then
  echo "cc-close: python3 missing; cannot rewrite frontmatter" >&2
  exit 3
fi

frontmatter_task_id() {
  local file="$1"
  python3 - "$file" <<'PYEOF'
import re
import sys
from pathlib import Path

text = Path(sys.argv[1]).read_text(encoding="utf-8")
frontmatter = ""
if text.startswith("---"):
    end = text.find("\n---", 3)
    if end != -1:
        frontmatter = text[3:end]

for line in frontmatter.splitlines():
    match = re.match(r"\s*task_id\s*:\s*['\"]?([^'\"#\s]+)", line)
    if match:
        print(match.group(1).strip())
        break
PYEOF
}

closed_duplicate=""
for candidate in "$vault_root/closed/$task_id-"*.md "$vault_root/closed/$task_id.md"; do
  [[ -f "$candidate" ]] || continue
  candidate_task_id="$(frontmatter_task_id "$candidate" || true)"
  if [[ "$candidate_task_id" == "$task_id" ]]; then
    closed_duplicate="$candidate"
    break
  fi
done
if [[ -n "$closed_duplicate" ]]; then
  echo "cc-close: BLOCKED - closed task duplicate has task_id '$task_id': $closed_duplicate" >&2
  exit 8
fi

# Rapid-closure flag — require --retroactive for tasks closed <5min after claim.
# Prevents the 22-second paperwork closure pattern found by CCTV disconfirmation.
if [[ "$final_status" == "done" && -z "${retroactive:-}" && "${HAPAX_RAPID_CLOSE_OFF:-0}" != "1" ]]; then
  claimed_at="$(python3 -c "
import re, sys
from pathlib import Path
text = Path('$note_path').read_text()
m = re.search(r'^claimed_at:\s*(.+)$', text, re.MULTILINE)
if m: print(m.group(1).strip().strip(\"'\").strip('\"'))
" 2>/dev/null || true)"
  if [[ -n "$claimed_at" ]]; then
    elapsed="$(python3 -c "
from datetime import datetime, timezone
try:
    claimed = datetime.fromisoformat('$claimed_at'.replace('Z','+00:00'))
    now = datetime.now(timezone.utc)
    print(int((now - claimed).total_seconds()))
except: print('999')
" 2>/dev/null || echo "999")"
    if [[ "$elapsed" -lt 300 ]]; then
      echo "cc-close: BLOCKED — task closed ${elapsed}s after claim (< 5min threshold)." >&2
      echo "  If this is a retroactive close of already-completed work, re-run with --retroactive." >&2
      echo "  Bypass: HAPAX_RAPID_CLOSE_OFF=1" >&2
      exit 2
    fi
  fi
fi

# Closure-discipline gate (cc-task cc-task-closure-hook-acceptance-criteria-gate):
# refuse the move when any `## Acceptance criteria` checkbox is unchecked.
# The Bash PreToolUse hook catches manual mv / git mv; this call catches
# the cc-close path (which uses python rename, invisible to the Bash hook).
# Both surfaces share the same checker. Bypass via HAPAX_CC_TASK_CLOSURE_GATE_OFF=1.
# Skip the gate for non-`done` outcomes (withdrawn / superseded close paths
# are operator-marked terminal states where the AC-completeness contract
# does not apply).
if [[ "$final_status" == "done" ]]; then
  CHECKER="$SCRIPT_DIR/cc-task-closure-check.py"
  if [[ -f "$CHECKER" ]]; then
    set +e
    python3 "$CHECKER" "$note_path"
    gate_rc=$?
    set -e
    if [[ "$gate_rc" -ne 0 ]]; then
      exit "$gate_rc"
    fi
  fi

  # Acceptance-receipt gate (routing Phase 0.2) — review-floor
  # (frontier_review_required) tasks close only with a signed acceptance
  # receipt (<task_id>.acceptance.yaml beside the note). The checker honors
  # HAPAX_ACCEPTANCE_RECEIPT_GATE_OFF=1 directly; non-review-floor tasks
  # pass through untouched.
  RECEIPT_CHECKER="$SCRIPT_DIR/cc-close-acceptance-receipt-check.py"
  if [[ -f "$RECEIPT_CHECKER" ]]; then
    set +e
    python3 "$RECEIPT_CHECKER" "$note_path"
    receipt_rc=$?
    set -e
    if [[ "$receipt_rc" -ne 0 ]]; then
      exit "$receipt_rc"
    fi
  fi

  # PR-merge evidence gate — verify PR is merged before allowing done status.
  # Prevents "status: done but PR is open" false-completion pattern.
  # Bypass: HAPAX_PR_MERGE_GATE_OFF=1
  if [[ "${HAPAX_PR_MERGE_GATE_OFF:-0}" != "1" ]]; then
    PR_MERGE_CHECKER="$SCRIPT_DIR/cc-close-pr-merge-check.py"
    if [[ -f "$PR_MERGE_CHECKER" ]]; then
      set +e
      python3 "$PR_MERGE_CHECKER" "$note_path" ${pr:+--pr "$pr"}
      merge_rc=$?
      set -e
      if [[ "$merge_rc" -ne 0 ]]; then
        exit "$merge_rc"
      fi
    fi
  fi

  # Artifact disposition gate
  DISP_CHECKER="$SCRIPT_DIR/cc-task-artifact-disposition-check.py"
  if [[ -f "$DISP_CHECKER" ]]; then
    set +e
    if [[ -n "${debt_reason:-}" ]]; then
      python3 "$DISP_CHECKER" "$note_path" "$task_id" --debt "$debt_reason"
    else
      python3 "$DISP_CHECKER" "$note_path" "$task_id"
    fi
    disp_rc=$?
    set -e
    if [[ "$disp_rc" -ne 0 ]]; then
      exit "$disp_rc"
    fi
  fi

  # Sibling-task advisory check — warns about stalled siblings under the same
  # parent request. Advisory only (exit 0), prevents the remediation execution
  # gap found by CCTV disconfirmation (PR #3659).
  SIBLING_CHECKER="$SCRIPT_DIR/cc-close-sibling-check.py"
  if [[ -f "$SIBLING_CHECKER" ]]; then
    python3 "$SIBLING_CHECKER" "$note_path" || true
  fi
fi

python3 - "$note_path" "$task_id" "$final_status" "$pr" "$role" <<'PYEOF'
import re
import sys
from datetime import datetime, timezone
from pathlib import Path

path, task_id, final_status, pr, role = (Path(sys.argv[1]), *sys.argv[2:])
text = path.read_text(encoding="utf-8")
now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

text = re.sub(r"^status:.*$", f"status: {final_status}", text, count=1, flags=re.MULTILINE)
text = re.sub(
    r"^completed_at:.*$", f"completed_at: {now}", text, count=1, flags=re.MULTILINE
)
text = re.sub(
    r"^updated_at:.*$", f"updated_at: {now}", text, count=1, flags=re.MULTILINE
)
if pr:
    text = re.sub(r"^pr:.*$", f"pr: {pr}", text, count=1, flags=re.MULTILINE)
log_line = f"- {now} {role or 'session'} closed as {final_status}"
if pr:
    log_line += f" (PR #{pr})"
log_line += " (cc-close)\n"
text = text.replace("## Session log\n", f"## Session log\n{log_line}", 1)

# Move from active/ to closed/.
new_path = path.parent.parent / "closed" / path.name
new_path.parent.mkdir(parents=True, exist_ok=True)
tmp = new_path.with_suffix(new_path.suffix + ".tmp")
tmp.write_text(text, encoding="utf-8")
tmp.replace(new_path)
path.unlink()
print(f"cc-close: moved '{task_id}' to closed/, status={final_status}")

# The acceptance receipt (routing Phase 0.2) lives ALONGSIDE the note —
# keep that invariant across the move so closed review-floor tasks stay
# closure-valid for the autoqueue and audits.
receipt = path.parent / f"{task_id}.acceptance.yaml"
if receipt.is_file():
    receipt.replace(new_path.parent / receipt.name)
    print(f"cc-close: moved acceptance receipt '{receipt.name}' to closed/")
PYEOF

# Clear the claim file(s) that still name this task. cc-claim writes BOTH a
# legacy cc-active-task-<role> AND a session-keyed cc-active-task-<role>-<sid>
# (agent-role.sh hapax_session_id, reform Phase 1 FM-2). Clearing only the
# legacy file leaked the session-keyed lease until its 6h TTL — and the gate
# reads the session-keyed file FIRST, so it kept seeing the just-closed task
# (reform finding #12/#13). Clear this session's lease forms, each only when its
# head still names the closed task (never clobber a lease for other work).
if [[ -n "$role" ]]; then
  cleared_claim=0
  # Sweep the ROLE's lease forms, not just the closing session's: the legacy
  # shared file plus EVERY session-keyed lease this role holds. The writer
  # already globs the role (cc-claim:99 scans cc-active-task-<role>-* for its
  # multi-claim check); the closer swept only "$role" and the id the CLOSING
  # session happens to carry. So a lease written by session A and closed by
  # session B survived to its 6h TTL, and the live marker set drifted away from
  # the vault with nothing to reconcile it — measured 2026-09-13 as
  # cc-active-task-cx-crit naming a task the vault recorded CLOSED_DONE.
  #
  # A lane that restarts mid-task is the ordinary way A != B. That was rare only
  # because sibling lanes used to INHERIT one session id; now that every launch
  # mints its own (claims-ontology-correction), it is the common case — which is
  # why the two changes ship together.
  session_id=""
  if declare -F hapax_session_id >/dev/null 2>&1; then
    session_id="$(hapax_session_id 2>/dev/null || true)"
  fi
  shopt -s nullglob
  claim_files=(
    "$HOME/.cache/hapax/cc-active-task-$role"
    ${session_id:+"$HOME/.cache/hapax/cc-active-task-$role-$session_id"}
    "$HOME/.cache/hapax/cc-active-task-$role-"*
  )
  shopt -u nullglob
  for claim_file in "${claim_files[@]}"; do
    [[ -f "$claim_file" ]] || continue
    # Only leases naming THIS task. A lease for other work is another session's
    # live claim and is never ours to retire.
    [[ "$(head -n1 "$claim_file" | tr -d '[:space:]')" == "$task_id" ]] || continue
    claim_base="$(basename "$claim_file")"
    claim_key="${claim_base#cc-active-task-}"
    # The glob is prefix-based, so closing as `cx` would also match
    # `cc-active-task-cx-crit-<sid>` and closing as `cx-blue` would match
    # `cc-active-task-cx-blue-shadow-<sid>`. Deleting those erases ANOTHER role's
    # claim — and, worse, erases the contention evidence in exactly the state the
    # hygiene check routes to operator-adjudication rather than silent deletion.
    # The task-id guard above does not save us: two roles holding one task id is
    # precisely the contested case.
    #
    # A foreign-session key is retired only when its remainder is a real session
    # id AND names no further role. The predicate is the Python SSOT —
    # shared.session_identity.split_claim_marker_key, the same authority the
    # hygiene check uses — never a second hand-rolled copy here. An earlier cut
    # matched two hardcoded id shapes with a bash regex, which would drift from
    # the minter the first time the minter changed: exactly the "five divergent
    # copies" failure this task exists to repair, re-introduced in the closer.
    # The closing session's own key and the legacy file skip the check: they are
    # this role's by construction, whatever id shape they carry.
    if [[ "$claim_key" != "$role" && "$claim_key" != "$role-$session_id" ]]; then
      # Bare python3 is correct here: shared/session_identity.py is stdlib-only by
      # contract precisely so it imports under the system interpreter on every
      # dispatch host (appendix has no PyYAML outside the uv venv).
      # Three outcomes, not two. The predicate exits 0 (retire), 1 (not this
      # role's — leave it), or something else entirely when it could not be
      # EVALUATED (no python3, import failure). The first cut folded every
      # non-zero into `continue`, so an unevaluable guard left a same-role lease
      # behind while cc-close still reported success — and the note has already
      # moved to closed/, so a rerun cannot reach cleanup again. Uncertainty still
      # preserves the lease, but it is now reported rather than silent.
      guard_rc=0
      python3 -I - "$SCRIPT_DIR/.." "$claim_key" "$role" <<'PYEOF' || guard_rc=$?
import sys

sys.path.insert(0, sys.argv[1])
from shared.session_identity import is_minted_session_id

key, role = sys.argv[2], sys.argv[3]
# Retire only `<this role>-<an id this system minted>`. The remainder must be a
# MINTED shape, not merely a claim-keyable one: `cx-blue-shadow-<uuid>` leaves the
# keyable remainder `shadow-<uuid>`, so a keyable test would delete another role's
# lease and destroy the contention evidence the hygiene check routes to
# operator-adjudication. split_claim_marker_key resolves that correctly only when
# given every role that exists, which a closing lane does not know.
remainder = key[len(role) + 1 :] if key.startswith(f"{role}-") else ""
# 0 = retire, 3 = definitely-not-ours. NOT 1: an ImportError or any other uncaught
# exception also exits 1, and folding that into "not ours" meant an unevaluable
# guard silently skipped cleanup while cc-close reported success — with the note
# already moved to closed/, so a rerun could never reach it again. A distinct
# negative code keeps "the predicate said no" separable from "the predicate did
# not run".
sys.exit(0 if is_minted_session_id(remainder) else 3)
PYEOF
      if [[ "$guard_rc" -eq 3 ]]; then
        # The predicate ran and said no. Leave the lease alone; nothing to report.
        continue
      fi
      if [[ "$guard_rc" -ne 0 ]]; then
        # Could not EVALUATE. Preserve the lease (uncertainty never deletes) and
        # say so with an exact remedy, because the note is about to move to
        # closed/ and a rerun of cc-close can no longer reach this cleanup.
        echo "cc-close: WARNING — cleanup incomplete: could not evaluate the foreign-lease guard for '$claim_file' (python3 exited $guard_rc). The lease was PRESERVED. Next action: repair python3/PYTHONPATH for this checkout, then retire it by hand once you have confirmed the closure: rm -f '$claim_file' '$HOME/.cache/hapax/cc-claim-epoch-$claim_key'" >&2
        cleanup_incomplete=1
        continue
      fi
    fi
    # The cc-claim-epoch sidecar carries the claim age for task_is_terminal;
    # clear it with its claim file so a stale epoch can never mis-age a future
    # claim. claim_key came from the BASENAME above with a non-greedy prefix strip
    # — `${path##*/cc-active-task-}` over the full path would strip through a
    # parent directory that happened to contain the same substring.
    rm -f "$claim_file" "$HOME/.cache/hapax/cc-claim-epoch-$claim_key"
    echo "cc-close: cleared claim file '$claim_file' (role '$role')"
    cleared_claim=1
  done
  if [[ "$cleared_claim" == 1 ]]; then
    systemctl --user start hapax-cc-hygiene.service 2>/dev/null || true
  fi
fi

# Best-effort request lifecycle reconciliation. `request-intake-consumer`
# remains read-only; this writer is explicit and conservative, and only runs
# after a successful fulfilling cc-task close.
if [[ "$final_status" == "done" && "${HAPAX_REQUEST_RECONCILER_OFF:-0}" != "1" && "${HAPAX_CC_HYGIENE_OFF:-0}" != "1" ]]; then
  reconciler="$SCRIPT_DIR/request-fulfillment-reconciler"
  if [[ -x "$reconciler" ]]; then
    set +e
    "$reconciler" --apply --task-id "$task_id" --write-report --quiet
    reconcile_rc=$?
    set -e
    if [[ "$reconcile_rc" -ne 0 ]]; then
      echo "cc-close: request fulfillment reconciler failed rc=$reconcile_rc" >&2
    fi
  fi

  # Phase-advance: if this task is Phase N, create Phase N+1 if the request has more phases.
  phase_advance="$SCRIPT_DIR/cc-phase-advance.py"
  if [[ -f "$phase_advance" ]]; then
    set +e
    python3 "$phase_advance" "$vault_root/closed/$(basename "$note_path")" "$task_id"
    set -e
  fi

  # Cascade-unblock: transition blocked tasks whose depends_on are now all satisfied.
  cascade="$SCRIPT_DIR/cc-cascade-unblock"
  if [[ -x "$cascade" ]]; then
    set +e
    "$cascade" "$task_id"
    set -e
  fi
fi
