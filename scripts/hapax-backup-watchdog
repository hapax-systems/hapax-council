#!/usr/bin/env bash
set -euo pipefail

# hapax-backup-watchdog — Verify Tier 1, B2, and critical-offsite backup health
#
# Checks:
#   1. Tier 1 (local/NAS): last restic snapshot < 36 hours old
#   2. Tier 2 (B2): last restic snapshot < 36 hours old
#   3. GDrive critical offsite: last restic snapshot < 48 hours old
#   4. Qdrant snapshot dir on NAS: non-empty, collections present
#   5. Restic repo integrity and PostgreSQL dump presence for all three podium lanes
#   6. Monocle B2 freshness, with an explicitly configured threshold
#
# Notifications via ntfy (localhost:8090) and desktop notify-send.
# Exit code: 0 = all healthy, 1 = at least one check failed.

NTFY_URL="${HAPAX_NTFY_URL:-http://localhost:8090/hapax-backup}"
TIER1_REPO="${HAPAX_TIER1_REPO:-/mnt/nas/backups/restic}"
TIER2_B2_REPO="${HAPAX_TIER2_B2_REPO:-rclone:b2:hapax-backups/restic}"
GDRIVE_CRITICAL_REPO="${HAPAX_GDRIVE_CRITICAL_REPO:-rclone:gdrive:hapax-backups/restic-critical}"
QDRANT_SNAP_DIR="${HAPAX_QDRANT_SNAP_DIR:-/mnt/nas/backups/qdrant-snapshots}"
HAPAX_ALERT_BIN="${HAPAX_ALERT_BIN:-$(dirname "$(readlink -f "$0")")/hapax-alert}"
TIER1_MAX_AGE_HOURS="${HAPAX_TIER1_MAX_AGE_HOURS:-36}"
TIER2_B2_MAX_AGE_HOURS="${HAPAX_TIER2_B2_MAX_AGE_HOURS:-36}"
GDRIVE_CRITICAL_MAX_AGE_HOURS="${HAPAX_GDRIVE_CRITICAL_MAX_AGE_HOURS:-48}"
TIER1_PASSWORD_ENTRY="${HAPAX_TIER1_RESTIC_PASSWORD_ENTRY:-backups/restic-password}"
TIER2_B2_PASSWORD_ENTRY="${HAPAX_TIER2_B2_RESTIC_PASSWORD_ENTRY:-backblaze/restic-password}"
GDRIVE_CRITICAL_PASSWORD_ENTRY="${HAPAX_GDRIVE_CRITICAL_RESTIC_PASSWORD_ENTRY:-backblaze/restic-password}"

# Monocle shares the B2 repository but has its own schedule and health verdict.
# The operator must configure its threshold; absence must never silently mean healthy.
MONOCLE_MAX_AGE_HOURS="${HAPAX_MONOCLE_MAX_AGE_HOURS:-}"
FAILURES=()
RESULTS=()
declare -A LATEST_SNAPSHOTS=()
CHECK_TMP=$(mktemp -d)
trap 'rm -rf -- "$CHECK_TMP"' EXIT

log() { echo "[$(date -Iseconds)] $1"; }

record_failure() {
    FAILURES+=("$1")
    RESULTS+=("$1")
}

record_success() {
    RESULTS+=("$1")
    log "  $1"
}

restic_password() {
    local entry="$1" label="$2" value
    # Set the caller's local password in this shell: subshells lose failure records.
    if ! value=$(pass show "$entry" 2>/dev/null); then
        record_failure "$label: cannot read restic password from pass entry '$entry'; next action: run pass show '$entry' >/dev/null, repair GPG/pass access, then rerun the configured watchdog unit"
        return 1
    fi
    value="${value%%$'\n'*}"
    if [[ -z "$value" ]]; then
        record_failure "$label: restic password entry '$entry' is empty; next action: repair it with pass insert '$entry', verify with pass show '$entry' >/dev/null, then rerun the configured watchdog unit"
        return 1
    fi
    password="$value"
}

stderr_summary() {
    local detail secret
    detail=$(<"$CHECK_TMP/stderr")
    # Never echo credentials even when an underlying tool includes them in stderr.
    for secret in "${password:-}" "${RESTIC_PASSWORD:-}" "${B2_KEY_ID:-}" "${B2_APP_KEY:-}"; do
        [[ -z "$secret" ]] || detail="${detail//"$secret"/[redacted]}"
    done
    detail=$(printf '%s' "$detail" | tr '\n\r\t' '   ' | tr -cd '[:print:]' |
        sed -E 's#([[:alnum:]+.-]+://)[^ ]+#\1[redacted]#g; s/([Pp]assword|[Tt]oken|[Kk]ey|[Ss]ecret)([=:] *)[^ ]+/\1\2[redacted]/g')
    printf '%s' "${detail:0:240}"
    [[ -n "$detail" ]] || printf '%s' 'no stderr output'
}

check_snapshot_age() {
    local repo="$1" label="$2" max_hours="$3" password_entry="$4" host="$5" tag="$6"
    log "Checking $label snapshot age (max ${max_hours}h, $host/$tag)..."
    if [[ ! "$max_hours" =~ ^[1-9][0-9]{0,5}$ ]]; then
        record_failure "$label: configuration failure: ${7:-maximum snapshot age} must be a positive integer number of hours"
        return
    fi

    local password
    restic_password "$password_entry" "$label freshness" || return 0

    local snapshots latest latest_id latest_time status
    if snapshots=$(RESTIC_PASSWORD="$password" RESTIC_REPOSITORY="$repo" restic snapshots --no-lock --json \
        --host "$host" --tag "$tag" 2>"$CHECK_TMP/stderr"); then
        if ! latest=$(printf '%s' "$snapshots" | jq -er '
            if type != "array" then error("expected snapshots array") else
                max_by(.time) | if . == null then "" else [.id, .time] | @tsv end
            end' 2>"$CHECK_TMP/stderr"); then
            record_failure "$label: cannot read snapshots: invalid snapshot metadata: $(stderr_summary)"
            return
        fi
    else
        status=$?
        record_failure "$label: cannot read snapshots (restic exit $status): $(stderr_summary)"
        return
    fi
    if [[ -z "$latest" ]]; then
        record_failure "$label: no snapshots found for $host/$tag; next action: inspect restic -r '$repo' snapshots --host $host --tag $tag, repair that producer's failed backup, then rerun the configured watchdog unit"
        return
    fi
    IFS=$'\t' read -r latest_id latest_time <<< "$latest"
    if [[ ! "$latest_id" =~ ^[[:xdigit:]]{8,64}$ ]]; then
        record_failure "$label: cannot prove snapshot ID for $host/$tag"
        return
    fi

    local latest_epoch now_epoch age_hours
    latest_epoch=$(date -d "$latest_time" +%s 2>/dev/null) || {
        record_failure "$label: cannot parse snapshot time '$latest_time'"
        return
    }
    LATEST_SNAPSHOTS["$label"]="$latest_id"
    now_epoch=$(date +%s)
    age_hours=$(( (now_epoch - latest_epoch) / 3600 ))

    if (( age_hours > max_hours )); then
        record_failure "$label: latest snapshot is ${age_hours}h old (max ${max_hours}h) [$host/$tag, $latest_id]"
    else
        record_success "$label: OK — latest snapshot ${age_hours}h old [$host/$tag, $latest_id]"
    fi
}

check_qdrant_snapshots() {
    log "Checking Qdrant snapshot directory..."
    if [[ ! -d "$QDRANT_SNAP_DIR" ]]; then
        record_failure "Qdrant: snapshot dir $QDRANT_SNAP_DIR does not exist"
        return
    fi

    local collection_count
    collection_count=$(find "$QDRANT_SNAP_DIR" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
    if (( collection_count < 5 )); then
        record_failure "Qdrant: only $collection_count collections in snapshot dir (expected >=5)"
    else
        record_success "Qdrant: OK — $collection_count collections present"
    fi
}

check_restic_integrity() {
    local repo="$1" label="$2" password_entry="$3" no_lock="${4:-false}" producer_unit="$5"
    log "Checking $label restic integrity..."

    local password
    restic_password "$password_entry" "$label integrity" || return 0

    local args=(check) status detail
    if [[ "$no_lock" == "true" ]]; then
        args+=(--no-lock)
    fi

    if RESTIC_PASSWORD="$password" RESTIC_REPOSITORY="$repo" restic "${args[@]}" > /dev/null 2>"$CHECK_TMP/stderr"; then
        record_success "$label: OK — restic check passed"
    else
        status=$?
        detail=$(stderr_summary)
        if (( status == 11 )) || grep -Eqi 'repository is already locked|unable to (create|acquire) lock|could not (create|acquire).*lock|failed to (create|acquire).*lock' "$CHECK_TMP/stderr"; then
            record_failure "$label: locked / could not acquire the lock (restic exit $status): $detail; check $producer_unit and the reported restic PID; only the operator may run restic unlock after proving the lock is stale"
        else
            record_failure "$label: restic check failed — possible repo corruption (restic exit $status): $detail; next action: inspect restic -r '$repo' check --read-data with its configured credential, preserve the damaged repository and recover from a verified independent backup"
        fi
    fi
}

check_postgres_dump_in_snapshot() {
    local repo="$1" label="$2" entry="$3" password
    restic_password "$entry" "$label PostgreSQL" || return 0
    local snapshot="${LATEST_SNAPSHOTS[$label]:-}"
    if [[ -z "$snapshot" ]]; then
        record_failure "$label: PostgreSQL listing not attempted: could not prove the producer's latest snapshot ID; next action: inspect restic -r '$repo' snapshots --json and repair the preceding producer freshness failure, then rerun the configured watchdog unit"
        return
    fi
    local listing status dump_line size
    if listing=$(RESTIC_REPOSITORY="$repo" RESTIC_PASSWORD="$password" restic ls --long "$snapshot" 2>"$CHECK_TMP/stderr"); then
        :
    else
        status=$?
        record_failure "$label: PostgreSQL listing failed (restic exit $status): $(stderr_summary); next action: inspect restic -r '$repo' ls --long $snapshot with its configured credential, repair repository access, then rerun the configured watchdog unit"
        return
    fi
    dump_line=$(printf '%s\n' "$listing" | awk '$NF ~ /(^|\/)postgres-all[.]sql$/ { print; exit }')
    if [[ -z "$dump_line" ]]; then
        record_failure "$label: newest snapshot contains NO postgres-all.sql (successfully listed $snapshot)"
        return
    fi
    size=$(printf '%s\n' "$dump_line" | awk '{ print $4 }')
    case "$size" in
        ""|*[!0-9]*) record_failure "$label: could not parse dump size"; return ;;
    esac
    local min_bytes="${HAPAX_POSTGRES_DUMP_MIN_BYTES:-1000000000}"
    (( size < min_bytes )) && { record_failure "$label: postgres dump implausibly small: ${size} bytes"; return; }
    record_success "$label: postgres dump present, ${size} bytes (snapshot $snapshot)"
}

# Select each producer's snapshot once. Dump checks use that immutable ID even if
# a different producer publishes a newer snapshot while the watchdog is running.
check_snapshot_age "$TIER1_REPO" "Tier1-NAS" "$TIER1_MAX_AGE_HOURS" "$TIER1_PASSWORD_ENTRY" hapax-podium tier1-local HAPAX_TIER1_MAX_AGE_HOURS
check_snapshot_age "$TIER2_B2_REPO" "Tier2-B2" "$TIER2_B2_MAX_AGE_HOURS" "$TIER2_B2_PASSWORD_ENTRY" hapax-podium tier2-remote HAPAX_TIER2_B2_MAX_AGE_HOURS
check_snapshot_age "$GDRIVE_CRITICAL_REPO" "GDrive-Critical" "$GDRIVE_CRITICAL_MAX_AGE_HOURS" "$GDRIVE_CRITICAL_PASSWORD_ENTRY" hapax-podium gdrive-critical HAPAX_GDRIVE_CRITICAL_MAX_AGE_HOURS
check_snapshot_age "$TIER2_B2_REPO" "Monocle-B2" "$MONOCLE_MAX_AGE_HOURS" "$TIER2_B2_PASSWORD_ENTRY" hapax-monocle monocle-daily HAPAX_MONOCLE_MAX_AGE_HOURS
check_qdrant_snapshots
check_restic_integrity "$TIER1_REPO" "Tier1-NAS" "$TIER1_PASSWORD_ENTRY" false hapax-backup-local.service
check_restic_integrity "$TIER2_B2_REPO" "Tier2-B2" "$TIER2_B2_PASSWORD_ENTRY" true 'hapax-backup-remote.service / Monocle backup process'
check_restic_integrity "$GDRIVE_CRITICAL_REPO" "GDrive-Critical" "$GDRIVE_CRITICAL_PASSWORD_ENTRY" true hapax-backup-gdrive-critical.service
check_postgres_dump_in_snapshot "$TIER1_REPO" "Tier1-NAS" "$TIER1_PASSWORD_ENTRY"
check_postgres_dump_in_snapshot "$TIER2_B2_REPO" "Tier2-B2" "$TIER2_B2_PASSWORD_ENTRY"
check_postgres_dump_in_snapshot "$GDRIVE_CRITICAL_REPO" "GDrive-Critical" "$GDRIVE_CRITICAL_PASSWORD_ENTRY"

# Report: preserve every verdict, including healthy producers, in the receipt.
msg="Backup watchdog results:"$'\n'
for result in "${RESULTS[@]}"; do
    msg+="- $result"$'\n'
done
if (( ${#FAILURES[@]} > 0 )); then
    log "BACKUP HEALTH: ${#FAILURES[@]} FAILURE(S)"
    for f in "${FAILURES[@]}"; do
        log "  x $f"
    done

    curl -sf \
        -H "Title: Backup Watchdog ALERT" \
        -H "Priority: high" \
        -H "Tags: warning,floppy_disk" \
        -d "$msg" \
        "$NTFY_URL" >/dev/null 2>&1 || log "WARN: ntfy notification failed"

    # Governed incident record + ONE replace_id-coalesced desktop pointer via
    # intake (NOT a raw notify-send, which stacks un-coalesced in the mako queue
    # on every failed run). Full hapax-alert (no --record-only) so intake emits
    # the bounded desktop pointer.
    "$HAPAX_ALERT_BIN" high "Backup Health FAIL" "$msg" --tag backup

    exit 1
else
    log "BACKUP HEALTH: ALL CHECKS PASSED"
    notify-send --urgency=low --app-name="Backup Watchdog" \
        "Backup Health OK" "$msg" 2>/dev/null || true
    exit 0
fi
