#!/usr/bin/env python3
"""Meta Muse substitute reviewer seat for the review-team registry (read-only).

Runs `muse exec` on the dispatcher's prompt in an empty temporary workspace, with web tools,
shell and writes disabled and no session log. Measured reliable up to 96 KB prompts
(2026-09-24 review panels); a larger prompt is refused as a route outage rather than
risking a partial review.

Muse runs inside the declared capability envelope (``shared.capability_envelope``): the release
binary, a fresh home holding only ``~/.config/muse/auth.json`` (bound read-only), the prompt file,
an empty workspace and a cleared environment. Measured 2026-09-25 on this wrapper's argv, an
inherited HOME put the estate's ``~/.config/muse/AGENTS.md`` into every review. A host without a
usable envelope is a route outage, never an unenveloped run.
"""

from __future__ import annotations

import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from shared.capability_envelope import (  # noqa: E402
    CredentialBind,
    DeclaredFile,
    EnvelopeCarrierError,
    EnvelopeDeclaration,
    EnvelopeRefusal,
    execute,
    render,
)
from shared.review_seat_wrapper import SEAT_PREAMBLE, refuse  # noqa: E402

WRAPPER = "hapax-muse-reviewer"
MAX_PROMPT_BYTES = 96_000
REASONING_EFFORT = "high"


def muse_bin() -> str | None:
    return os.environ.get("HAPAX_MUSE_BIN") or shutil.which("muse")


def command(binary: str, prompt_file: Path, workspace: Path) -> list[str]:
    return [
        binary,
        "exec",
        "--prompt-file",
        str(prompt_file),
        "--reasoning-effort",
        REASONING_EFFORT,
        "--workspace",
        str(workspace),
        "--disable-web-tools",
        "--disable-shell",
        "--disable-write",
        "--no-session-log",
        "--no-foreign-personal-context",
    ]


def release_binary(launcher: Path) -> Path:
    """The binary the muse launcher would exec, so the envelope never runs the self-updater.

    The launcher keeps ``.muse-version`` and ``muse-bin-<version>`` beside itself. Anything else
    (a relocated install, a test double) runs as given.
    """

    directory = launcher.resolve().parent
    try:
        version = (directory / ".muse-version").read_text(encoding="utf-8").strip()
    except OSError:
        return launcher
    candidate = directory / f"muse-bin-{version}"
    return candidate if version and candidate.is_file() else launcher


def runtime_dirs(binary: Path) -> tuple[Path, ...]:
    """Host paths muse needs inside the envelope, bound read-only: the release binary.
    HAPAX_MUSE_RUNTIME_DIRS (colon-separated) replaces the default, for a relocated install."""

    declared = os.environ.get("HAPAX_MUSE_RUNTIME_DIRS", "")
    candidates = [Path(p) for p in declared.split(":") if p] if declared else [binary]
    return tuple(p for p in candidates if p.exists())


def run_enveloped(
    binary: Path, text: str, auth: Path, scratch: Path
) -> subprocess.CompletedProcess:
    """Render and run muse inside the declared envelope. Raises EnvelopeRefusal."""

    workspace = scratch / "workspace"
    workspace.mkdir()
    prompt_file = scratch / "review-prompt.md"
    prompt_file.write_text(text, encoding="utf-8")
    declaration = EnvelopeDeclaration(
        harness="muse",
        argv=tuple(command(str(binary), Path("/home/job/review-prompt.md"), Path("/work"))),
        binaries=runtime_dirs(binary),
        workdir=workspace,
        home_files=(DeclaredFile(source=prompt_file, target="review-prompt.md"),),
        credentials=(CredentialBind(source=auth, target=".config/muse/auth.json"),),
        env={"MUSE_NO_AUTO_UPDATE": "1"},
    )
    rendered = render(declaration, run_root=scratch / "run")
    return execute(rendered, timeout=1800)


def main() -> int:
    prompt = sys.stdin.read()
    if not prompt.strip():
        return refuse(WRAPPER, "empty prompt on stdin; the dispatcher sends the review prompt")
    text = f"{SEAT_PREAMBLE}\n\n{prompt.strip()}\n"
    size = len(text.encode("utf-8"))
    if size > MAX_PROMPT_BYTES:
        return refuse(
            WRAPPER,
            f"prompt of {size} bytes exceeds the measured muse ceiling of {MAX_PROMPT_BYTES}; "
            "the constitution substitutes another family",
        )
    binary = muse_bin()
    if not binary:
        return refuse(WRAPPER, "muse binary not found; install muse or set HAPAX_MUSE_BIN")
    auth = Path.home() / ".config" / "muse" / "auth.json"
    if not auth.is_file():
        return refuse(
            WRAPPER,
            "no ~/.config/muse/auth.json: the envelope carries muse's credential only as that "
            "file, bound read-only; next action (coordinator): sign muse in on this host",
        )
    with tempfile.TemporaryDirectory(prefix="hapax-muse-review-") as tmp:
        try:
            result = run_enveloped(release_binary(Path(binary)), text, auth, Path(tmp))
        except EnvelopeRefusal as exc:
            return refuse(WRAPPER, f"envelope refused: {exc}")
        except EnvelopeCarrierError as exc:
            # The seat runs only inside the declared envelope; the constitution substitutes
            # another family rather than running muse unenveloped.
            return refuse(WRAPPER, f"{exc} (coordinator)")
        except (OSError, subprocess.TimeoutExpired) as exc:
            return refuse(WRAPPER, f"failed to launch muse ({type(exc).__name__})")
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    return result.returncode


if __name__ == "__main__":
    raise SystemExit(main())
