#!/usr/bin/env python3
"""Log-only SdlcRouter shadow-compare vs frontier/WSJF incumbent (N2).

Never mutates live dispatch. Default: append one JSON line to the shadow-compare ledger.

Examples::

  # Minimal demo with built-in two-candidate set (frontier + alternative)
  hapax-sdlc-router-shadow-compare --task-id demo --json

  # Explicit requirement vector + candidates JSON
  hapax-sdlc-router-shadow-compare \\
    --task-id t1 --routing-class source_python \\
    --requirement-vector '{"quality_floor":2,...}' \\
    --candidates-file /tmp/cands.json --json
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from shared.sdlc_router import (  # noqa: E402
    DEFAULT_FRONTIER_INCUMBENT_ROUTE_ID,
    REQUIREMENT_VECTOR_DIMENSIONS,
    SdlcRouteCandidate,
    SdlcRoutingRequest,
)
from shared.sdlc_router_shadow_compare import (  # noqa: E402
    DEFAULT_SHADOW_COMPARE_LOG,
    shadow_compare,
)


def _default_requirement_vector() -> dict[str, int]:
    return {dim: 2 for dim in REQUIREMENT_VECTOR_DIMENSIONS}


def _demo_candidates(frontier_id: str) -> tuple[SdlcRouteCandidate, ...]:
    """Two synthetic candidates: strong local alternative + weaker frontier."""

    def _cand(route_id: str, score: int) -> SdlcRouteCandidate:
        dims = [d for d in REQUIREMENT_VECTOR_DIMENSIONS if d != "quality_floor"]
        return SdlcRouteCandidate.model_validate(
            {
                "route_id": route_id,
                "supported_quality_floors": (
                    "frontier_required",
                    "deterministic_ok",
                    "deterministic",
                ),
                "supported_mutation_surfaces": ("source", "vault_docs"),
                "authority_ceiling": "authoritative",
                "capability_scores": {d: score for d in dims},
                "capability_confidence": {
                    "information_scope": 4,
                    "context_length": 4,
                },
                "evidence_refs": (f"demo:{route_id}",),
            }
        )

    return (
        _cand("local_tool.local.worker", 5),
        _cand(frontier_id, 3),
    )


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="hapax-sdlc-router-shadow-compare",
        description=(
            "Log-only compare of SdlcRouter preference vs frontier/WSJF incumbent. "
            "Does not change live route selection."
        ),
    )
    parser.add_argument("--task-id", default="shadow-compare-adhoc", help="Task id for the record")
    parser.add_argument("--routing-class", default="source_python")
    parser.add_argument(
        "--frontier-incumbent",
        default=DEFAULT_FRONTIER_INCUMBENT_ROUTE_ID,
        help="Live path / WSJF incumbent route id",
    )
    parser.add_argument(
        "--requirement-vector",
        default=None,
        help="JSON object with all 8 requirement dimensions (default: all 2s)",
    )
    parser.add_argument(
        "--candidates-file",
        default=None,
        help="JSON list of SdlcRouteCandidate payloads (default: built-in demo pair)",
    )
    parser.add_argument(
        "--router-state",
        default=None,
        help="Path to router-state.json (default: HAPAX_SDLC_ROUTER_STATE / cache)",
    )
    parser.add_argument(
        "--log",
        default=None,
        help=f"Shadow-compare jsonl (default: {DEFAULT_SHADOW_COMPARE_LOG})",
    )
    parser.add_argument(
        "--no-write",
        action="store_true",
        help="Report only; do not append to the compare log",
    )
    parser.add_argument("--json", action="store_true", help="Machine-readable JSON on stdout")
    args = parser.parse_args(argv)

    if args.requirement_vector:
        requirement_vector = json.loads(args.requirement_vector)
    else:
        requirement_vector = _default_requirement_vector()

    request = SdlcRoutingRequest.model_validate(
        {
            "task_id": args.task_id,
            "routing_class": args.routing_class,
            "requirement_vector": requirement_vector,
            "quality_floor": "frontier_required",
            "mutation_surface": "source",
            "authority_level": "authoritative",
            "frontier_incumbent_route_id": args.frontier_incumbent,
        }
    )

    if args.candidates_file:
        raw = json.loads(Path(args.candidates_file).read_text(encoding="utf-8"))
        if not isinstance(raw, list):
            print(
                "candidates-file must be a JSON list of SdlcRouteCandidate objects; "
                "next action: pass a file like "
                '[{"route_id":"...","capability_scores":{...},...}] '
                "or omit --candidates-file to use the built-in demo pair "
                "(see docs/runbooks/sdlc-router-shadow-compare.md)",
                file=sys.stderr,
            )
            return 2
        candidates = tuple(SdlcRouteCandidate.model_validate(item) for item in raw)
    else:
        candidates = _demo_candidates(args.frontier_incumbent)

    record = shadow_compare(
        request,
        candidates,
        router_state=args.router_state,
        log_path=args.log,
        write_log=not args.no_write,
    )
    payload = record.as_dict()
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print(
            f"action={payload['action']} live={payload['live_selected_route_id']} "
            f"prefer={payload['router_would_prefer']} agree={payload['agree']} "
            f"dispatch_mutated={payload['dispatch_mutated']}"
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
