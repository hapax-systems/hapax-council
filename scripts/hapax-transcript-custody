#!/usr/bin/env python3
"""hapax-transcript-custody — back up every harness transcript store by its real path, and verify the snapshot.

Subcommands:
  inventory [--json]   the transcript paths on this host: declared path, real path, kind, file count and bytes
  backup [--dry-run]   restic backup of every real path, tagged tier1-transcripts, credential files excluded
  verify               open this host's newest tier1-transcripts snapshot and count the files under every path; exit 1,
                       with a remedy, on a missing, symlinked, empty or dropped path, a dropped harness path, a
                       credential file, or a snapshot older than --max-age-hours (default 26)

Windows hosts: on the host that HAPAX_TRANSCRIPT_WINDOWS_PULLER names, backup also pulls each host in
HAPAX_TRANSCRIPT_WINDOWS_HOSTS over SSH, as a tar stream of its table paths (credentials excluded by name), into a
snapshot under that host's name. verify checks those snapshots the same way, and fails one older than 72h.

The repository is RESTIC_REPOSITORY (default: the tier-1 NAS repository /mnt/nas/backups/restic). The password is
the FileStore entry backups/restic-password (HAPAX_TRANSCRIPT_RESTIC_PASSWORD_ENTRY overrides it). The unit is
systemd/units/hapax-backup-transcripts.service. The row is transcript-backup-custody-all-harnesses-20260927 (M174:
a green backup job once hid an empty ~/.claude for months, so the check opens the snapshot).
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import socket
import sqlite3
import subprocess
import sys
import tarfile
import tempfile
from collections.abc import Iterator
from datetime import UTC, datetime
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from scripts import transcript_custody as tc  # noqa: E402

DEFAULT_REPOSITORY = "/mnt/nas/backups/restic"


def _remedy() -> str:
    service = os.environ.get("HAPAX_TRANSCRIPT_SERVICE", "hapax-backup-transcripts.service")
    return tc.REMEDY.replace("hapax-backup-transcripts.service", service)


def _local_host() -> str:
    return os.environ.get("HAPAX_TRANSCRIPT_HOST") or socket.gethostname()


def _mount_point(path: str) -> str:
    cur = os.path.abspath(path)
    while not os.path.ismount(cur):
        cur = os.path.dirname(cur)
    return cur


def _require_repository(repo: str) -> None:
    """A local repository must exist and sit on its own mount: an unmounted NAS path falls through to the root
    filesystem, where restic would find no repository or a stale one. The unit's RequiresMountsFor= gives only
    After= on the NAS mount in the user manager, with no Requires=, so this check is the guard.

    HAPAX_TRANSCRIPT_REPOSITORY_MOUNT (the unit sets /mnt/nas/backups) names the mount the repository must sit on:
    with the NAS absent, a repository under another mount (/mnt, say) would otherwise pass."""

    if ":" in repo.split("/", 1)[0]:  # rclone:, sftp:, s3: ... a remote repository
        return
    if not os.path.isfile(os.path.join(repo, "config")):
        raise SystemExit(
            f"hapax-transcript-custody: no restic repository at {repo} (is the NAS mounted?); {_remedy()}"
        )
    mount = _mount_point(repo)
    if mount == "/":
        raise SystemExit(
            f"hapax-transcript-custody: {repo} is on the root filesystem, not a mount; refusing; {_remedy()}"
        )
    required = os.environ.get("HAPAX_TRANSCRIPT_REPOSITORY_MOUNT")
    if required and mount != os.path.abspath(required):
        raise SystemExit(
            f"hapax-transcript-custody: {repo} is on {mount}, not on the required mount {required} (is the NAS "
            f"mounted? check `findmnt {required}`); refusing; {_remedy()}"
        )


def _restic_env() -> dict[str, str]:
    from shared.secrets import get_secret

    if shutil.which("restic") is None:
        raise SystemExit(
            "hapax-transcript-custody: restic is not installed on this host; install the packaged binary "
            "(Ubuntu: sudo apt-get install restic; other hosts: use their supported package method), then rerun"
        )
    env = dict(os.environ)
    env.setdefault("RESTIC_REPOSITORY", DEFAULT_REPOSITORY)
    _require_repository(env["RESTIC_REPOSITORY"])
    entry = os.environ.get("HAPAX_TRANSCRIPT_RESTIC_PASSWORD_ENTRY", "backups/restic-password")
    # RESTIC_PASSWORD in the environment is used first (a manual run or a test); the unit sets none, so the
    # FileStore entry is the production path.
    env["RESTIC_PASSWORD"] = get_secret(entry, env="RESTIC_PASSWORD", required=False) or ""
    if not env["RESTIC_PASSWORD"]:
        raise SystemExit(
            f"hapax-transcript-custody: the restic password '{entry}' is empty or missing; put it with hapax-secret"
        )
    return env


def _count(real: str, kind: str) -> tuple[int, int, list[str]]:
    """Files, bytes and nested symlinks under ``real``. os.walk lists a symlink to a directory among the
    directories and does not descend it, so both lists are checked for links."""

    if kind == "file":
        return 1, os.lstat(real).st_size, []
    files = size = 0
    links: list[str] = []
    for root, dirs, names in os.walk(real, followlinks=False):
        links += [os.path.join(root, d) for d in dirs if os.path.islink(os.path.join(root, d))]
        for name in names:
            full = os.path.join(root, name)
            try:
                st = os.lstat(full)
            except OSError:
                continue
            if os.path.islink(full):
                links.append(full)
                continue
            files += 1
            size += st.st_size
    return files, size, links


def cmd_inventory(args: argparse.Namespace) -> int:
    res = tc.resolve_paths(Path.home())
    rows = []
    problems = list(res.problems)
    for p in res.paths:
        files, size, links = _count(p.real, p.kind)
        if links:
            problems.append(
                f"nested symlink: {p.real} holds {len(links)} symlink(s) {sorted(links)[:3]}; the backup would "
                "record the links, not their targets. Add each target's real path to the path table"
            )
        rows.append(
            {
                "harness": p.harness,
                "declared": p.declared,
                "real": p.real,
                "kind": p.kind,
                "via_symlink": p.via_symlink,
                "files": files,
                "bytes": size,
                "nested_symlinks": len(links),
            }
        )
    # Windows hosts, asked over SSH: those named with --windows, or the unit's pull list on the puller.
    windows = []
    for host in args.windows or _windows_hosts():
        inv = _windows_inventory(host)
        if inv is None:
            problems.append(f"unreachable: {host} did not answer over SSH")
            continue
        problems += inv.problems
        windows += [
            {"host": host, "harness": p.harness, "declared": p.declared, "kind": p.kind}
            for p in inv.paths
        ]
    if args.json:
        print(
            json.dumps(
                {
                    "host": socket.gethostname(),
                    "paths": rows,
                    "windows": windows,
                    "problems": problems,
                }
            )
        )
    else:
        for r in rows:
            link = " (via symlink)" if r["via_symlink"] else ""
            print(
                f"{r['harness']:<12} {r['files']:>9} files {r['bytes'] / 1e6:>10.1f} MB  {r['real']}{link}"
            )
        for w in windows:
            print(f"{w['harness']:<12} {w['kind']:>15}  {w['declared']}")
        for problem in problems:
            print(f"PROBLEM {problem}", file=sys.stderr)
    return 1 if problems else 0


def _windows_all_hosts() -> list[str]:
    """Every Windows host the unit covers (HAPAX_TRANSCRIPT_WINDOWS_HOSTS), on whichever host runs it."""

    return os.environ.get("HAPAX_TRANSCRIPT_WINDOWS_HOSTS", "").split()


def _windows_hosts() -> list[str]:
    """The Windows hosts this machine pulls: HAPAX_TRANSCRIPT_WINDOWS_HOSTS, but only on the host that
    HAPAX_TRANSCRIPT_WINDOWS_PULLER names. The unit is the same file on every host, and exactly one of them pulls."""

    puller = os.environ.get("HAPAX_TRANSCRIPT_WINDOWS_PULLER", "")
    if not puller or puller != socket.gethostname():
        return []
    return _windows_all_hosts()


def _windows_inventory(host: str) -> tc.Resolution | None:
    """The host's transcript paths, or None when SSH cannot reach it (asleep, off, or off the tailnet)."""

    cmd = [
        "ssh",
        *tc.WINDOWS_SSH_OPTIONS,
        host,
        *tc.encoded_powershell(tc.windows_inventory_script()),
    ]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=300, check=False)
    except subprocess.TimeoutExpired:
        return None
    if proc.returncode == 255:  # ssh's own failure: asleep and unreachable, or refused
        refusal = [m for m in tc.SSH_REFUSAL_MARKERS if m in proc.stderr]
        if refusal:
            return tc.Resolution(problems=[f"ssh: {host} refused the connection ({refusal[0]})"])
        return None
    if proc.returncode != 0:
        tail = proc.stderr.strip().splitlines()[-1:] or [""]
        return tc.Resolution(problems=[f"inventory: {host} exited {proc.returncode} ({tail[0]})"])
    try:
        return tc.parse_windows_inventory(host, proc.stdout.strip())
    except (ValueError, KeyError, TypeError) as exc:
        return tc.Resolution(
            problems=[f"inventory: {host} printed an unreadable inventory ({exc})"]
        )


def _backup_windows(dry_run: bool) -> int:
    """Pull each Windows host's transcripts; the number of failures. An unreachable host is reported, and is not a
    failure here: verify fails it once its newest snapshot is older than the staleness bound."""

    failed = 0
    env = None
    for host in _windows_hosts():
        inv = _windows_inventory(host)
        if inv is None:
            print(
                f"hapax-transcript-custody: {host} is unreachable over SSH (asleep?); no snapshot this run. "
                f"verify fails once its newest snapshot is older than {tc.WINDOWS_MAX_AGE_HOURS:g}h",
                file=sys.stderr,
            )
            continue
        for problem in inv.problems:
            print(f"hapax-transcript-custody: {problem}; {tc.WINDOWS_REMEDY}", file=sys.stderr)
            failed += 1
        rels = [p.real.lstrip("/") for p in inv.paths]
        if not rels:
            if not inv.problems:
                # Reachable, and every transcript path is gone: no snapshot would be taken, and verify would keep
                # passing on the last one. That is a custody event, so it fails now.
                print(
                    f"hapax-transcript-custody: {host} is reachable but holds no transcript path; "
                    f"{tc.WINDOWS_REMEDY}",
                    file=sys.stderr,
                )
                failed += 1
            continue
        restic_args = tc.windows_backup_args(host, rels)
        if dry_run:
            print(json.dumps(["restic", *restic_args]))
            continue
        env = env or _restic_env()
        proc = subprocess.run(["restic", *restic_args], env=env, check=False)
        if proc.returncode != 0:
            # --stdin-from-command: a failed or cut SSH stream fails the backup, never a short snapshot.
            print(
                f"hapax-transcript-custody: restic backup of {host} exited {proc.returncode}; {tc.WINDOWS_REMEDY}",
                file=sys.stderr,
            )
            failed += 1
    return failed


def cmd_backup(args: argparse.Namespace) -> int:
    res = tc.resolve_paths(Path.home())
    if res.problems and args.capture:
        for problem in res.problems:
            print(f"hapax-transcript-custody: {problem}; {_remedy()}", file=sys.stderr)
        return 1
    if args.capture:
        if args.dry_run:
            print(
                json.dumps(
                    {"host": _local_host(), "consistent_capture": [p.real for p in res.paths]}
                )
            )
            return 0
        with tempfile.TemporaryDirectory(prefix="hapax-transcript-capture-") as directory:
            archive = Path(directory) / tc.CAPTURE_FILENAME
            try:
                tc.capture_tar(res.paths, archive)
            except (OSError, ValueError, sqlite3.Error, tarfile.TarError) as exc:
                print(
                    f"hapax-transcript-custody: capture failed: {exc}; {_remedy()}", file=sys.stderr
                )
                return 1
            with archive.open("rb") as source:
                proc = subprocess.run(
                    [
                        "restic",
                        "backup",
                        "--stdin",
                        "--stdin-filename",
                        tc.CAPTURE_FILENAME,
                        "--host",
                        _local_host(),
                        "--tag",
                        tc.SNAPSHOT_TAG,
                    ],
                    stdin=source,
                    env=_restic_env(),
                    check=False,
                )
        if proc.returncode != 0:
            print(
                f"hapax-transcript-custody: restic capture backup exited {proc.returncode}; {_remedy()}",
                file=sys.stderr,
            )
            return 1
        return 0
    restic_args = tc.backup_args(res.paths)
    if args.dry_run:
        print(json.dumps(["restic", *restic_args]))
        return 1 if _backup_windows(dry_run=True) else 0
    proc = subprocess.run(["restic", *restic_args], env=_restic_env(), check=False)
    # restic exits 3 when some files could not be read: the snapshot is incomplete, and that is a failure.
    for problem in res.problems:
        print(f"hapax-transcript-custody: {problem}; {_remedy()}", file=sys.stderr)
    if proc.returncode != 0:
        print(
            f"hapax-transcript-custody: restic backup exited {proc.returncode}; {_remedy()}",
            file=sys.stderr,
        )
    windows_failed = _backup_windows(dry_run=False)
    return 0 if proc.returncode == 0 and not res.problems and not windows_failed else 1


def _restic_json(env: dict[str, str], *cmd: str) -> str:
    return subprocess.run(
        ["restic", *cmd, "--json", "--no-lock"], env=env, capture_output=True, text=True, check=True
    ).stdout


def _nodes(env: dict[str, str], snapshot_id: str) -> Iterator[dict]:
    for line in _restic_json(env, "ls", snapshot_id).splitlines():
        try:
            yield json.loads(line)
        except ValueError:
            continue


def cmd_verify(args: argparse.Namespace) -> int:
    host = _local_host()
    env = _restic_env()
    res = tc.resolve_paths(Path.home())
    snapshots = sorted(
        json.loads(_restic_json(env, "snapshots", "--tag", tc.SNAPSHOT_TAG, "--host", host)) or [],
        key=lambda s: s["time"],
    )
    if not snapshots:
        print(
            f"hapax-transcript-custody: no {tc.SNAPSHOT_TAG} snapshot for {host}; {_remedy()}",
            file=sys.stderr,
        )
        return 1
    cur, prev = snapshots[-1], (snapshots[-2] if len(snapshots) > 1 else None)
    try:
        targets, nodes = _local_listing(env, cur)
        prev_targets, prev_nodes = _local_listing(env, prev) if prev else ([], [])
    except (subprocess.CalledProcessError, OSError, ValueError, tarfile.TarError) as exc:
        print(
            f"hapax-transcript-custody: snapshot read failed: {exc}; {_remedy()}", file=sys.stderr
        )
        return 1
    expected = tc.capture_paths(res.paths) if _is_capture(cur) else res.paths
    paths = sorted(set(targets) | set(prev_targets) | {p.real for p in expected})
    current = tc.count_snapshot(nodes, paths)
    previous = tc.count_snapshot(prev_nodes, paths) if prev else None
    failures = tc.verify(
        expected,
        current,
        snapshot_targets=targets,
        previous=previous,
        previous_targets=prev_targets,
        snapshot_credentials=tc.credential_nodes(nodes),
    ) + list(res.problems)
    # Bind verify to this run's snapshot: the unit runs verify right after backup, so the newest snapshot for this
    # host must be fresh. An old one means no snapshot was taken this run, and verifying the last one would pass.
    age_hours = (datetime.now(UTC) - datetime.fromisoformat(cur["time"])).total_seconds() / 3600
    if age_hours > args.max_age_hours:
        failures.append(
            f"stale: the newest {tc.SNAPSHOT_TAG} snapshot {cur.get('short_id')} is {age_hours:.1f}h old "
            f"(max {args.max_age_hours:g}h), so no snapshot was taken this run"
        )
    print(
        json.dumps(
            {
                "host": host,
                "snapshot": cur.get("short_id"),
                "time": cur.get("time"),
                "previous": (prev or {}).get("short_id"),
                "failures": failures,
                "paths": {p: {"type": c.node_type, "files": c.files} for p, c in current.items()},
            }
        )
    )
    for p, c in sorted(current.items()):
        print(f"  {c.files:>9} files  {c.node_type or 'ABSENT':<8} {p}")
    # Every host checks that each Windows host has a present, fresh snapshot, so a puller that silently pulls nothing
    # (its hostname differs from the unit's puller name, say) still fails somewhere. The puller also checks contents.
    pulled = set(_windows_hosts())
    windows_failed = sum(
        _verify_windows(env, h, args.max_age_hours, contents=h in pulled)
        for h in _windows_all_hosts()
    )
    if failures:
        for failure in failures:
            print(f"FAIL {failure}", file=sys.stderr)
        print(
            f"hapax-transcript-custody: {len(failures)} failure(s) in snapshot {cur.get('short_id')}; {_remedy()}",
            file=sys.stderr,
        )
        return 1
    print(
        f"hapax-transcript-custody: snapshot {cur.get('short_id')} holds every transcript path, none empty or "
        "dropped, no credential"
    )
    return 1 if windows_failed else 0


def _is_capture(snapshot: dict) -> bool:
    return snapshot.get("paths") == ["/" + tc.CAPTURE_FILENAME]


def _local_listing(env: dict[str, str], snapshot: dict) -> tuple[list[str], list[dict]]:
    if not _is_capture(snapshot):
        return list(snapshot.get("paths") or []), list(_nodes(env, snapshot["id"]))
    proc = subprocess.Popen(
        ["restic", "dump", "--no-lock", snapshot["id"], "/" + tc.CAPTURE_FILENAME],
        env=env,
        stdout=subprocess.PIPE,
    )
    assert proc.stdout is not None
    try:
        with tarfile.open(fileobj=proc.stdout, mode="r|") as archive:
            paths, nodes = tc.read_capture(archive)
        while proc.stdout.read(1 << 16):
            pass
    finally:
        proc.stdout.close()
        proc.wait()
    if proc.returncode != 0:
        raise subprocess.CalledProcessError(proc.returncode, ["restic", "dump", snapshot["id"]])
    return [p.real for p in paths], nodes


def _tar_listing(env: dict[str, str], snapshot: dict) -> list[dict]:
    """The node stream of a Windows snapshot: its one stdin file is a tar, read from ``restic dump`` as a stream."""

    (path,) = snapshot.get("paths") or ["?"]
    proc = subprocess.Popen(
        ["restic", "dump", "--no-lock", snapshot["id"], path], env=env, stdout=subprocess.PIPE
    )
    assert proc.stdout is not None
    try:
        nodes = tc.tar_nodes(tarfile.open(fileobj=proc.stdout, mode="r|"))
        # tarfile stops at the end-of-archive marker; a tar is padded past it to its record size. Drain the rest, so
        # restic finishes its write instead of dying of SIGPIPE, which would fail verify spuriously.
        while proc.stdout.read(1 << 16):
            pass
    finally:
        proc.stdout.close()
    if proc.wait() != 0:
        raise subprocess.CalledProcessError(
            proc.returncode, ["restic", "dump", snapshot["id"], path]
        )
    return nodes


def _verify_windows(
    env: dict[str, str], host: str, fresh_hours: float, *, contents: bool = True
) -> int:
    """Verify a Windows host's newest snapshot; 1 on failure. It fails when there is no snapshot, or when the newest
    is older than the staleness bound. With ``contents`` (on the puller) it also applies the same floor, drop,
    symlink and credential checks as a local snapshot. The expected paths are the host's live inventory when the
    snapshot is from this run and the host answers; otherwise they are read from the snapshot's own listing."""

    snapshots = sorted(
        json.loads(_restic_json(env, "snapshots", "--tag", tc.SNAPSHOT_TAG, "--host", host)) or [],
        key=lambda s: s["time"],
    )
    if not snapshots:
        print(
            f"FAIL missing: no {tc.SNAPSHOT_TAG} snapshot for Windows host {host}; {tc.WINDOWS_REMEDY}",
            file=sys.stderr,
        )
        return 1
    cur, prev = snapshots[-1], (snapshots[-2] if len(snapshots) > 1 else None)
    failures: list[str] = []
    age_hours = (datetime.now(UTC) - datetime.fromisoformat(cur["time"])).total_seconds() / 3600
    if age_hours > tc.WINDOWS_MAX_AGE_HOURS:
        failures.append(
            f"stale: {host}'s newest {tc.SNAPSHOT_TAG} snapshot {cur.get('short_id')} is {age_hours:.1f}h old "
            f"(max {tc.WINDOWS_MAX_AGE_HOURS:g}h): the host has not been reachable at backup time"
        )
    if not contents:
        for failure in failures:
            print(f"FAIL {host}: {failure}; {tc.WINDOWS_REMEDY}", file=sys.stderr)
        if not failures:
            print(
                f"hapax-transcript-custody: {host} has a fresh {tc.SNAPSHOT_TAG} snapshot {cur.get('short_id')} "
                f"({age_hours:.1f}h old); its contents are verified on the puller"
            )
        return 1 if failures else 0
    try:
        nodes = _tar_listing(env, cur)
        prev_nodes = _tar_listing(env, prev) if prev else []
    except (subprocess.CalledProcessError, tarfile.TarError, OSError) as exc:
        print(
            f"FAIL {host}: unreadable: the tar in snapshot {cur.get('short_id')} could not be listed ({exc}); "
            f"run `restic check` on the repository, then {tc.WINDOWS_REMEDY}",
            file=sys.stderr,
        )
        return 1
    inv = _windows_inventory(host) if age_hours <= fresh_hours else None
    if inv is None:
        expected = tc.listing_expected(host, nodes)
    else:
        expected = inv.paths
        failures += inv.problems
    targets, prev_targets = tc.listing_targets(nodes), tc.listing_targets(prev_nodes)
    paths = sorted(set(targets) | set(prev_targets) | {p.real for p in expected})
    current = tc.count_snapshot(nodes, paths)
    failures += tc.verify(
        expected,
        current,
        snapshot_targets=targets,
        previous=tc.count_snapshot(prev_nodes, paths) if prev else None,
        previous_targets=prev_targets,
        snapshot_credentials=tc.credential_nodes(nodes),
    )
    source = "live inventory" if inv is not None else "the snapshot's own listing"
    print(
        json.dumps(
            {
                "host": host,
                "snapshot": cur.get("short_id"),
                "time": cur.get("time"),
                "failures": failures,
            }
        )
    )
    for p, c in sorted(current.items()):
        print(f"  {c.files:>9} files  {c.node_type or 'ABSENT':<8} {host}:~{p}")
    if failures:
        for failure in failures:
            print(f"FAIL {host}: {failure}", file=sys.stderr)
        print(
            f"hapax-transcript-custody: {len(failures)} failure(s) for {host}; {tc.WINDOWS_REMEDY}",
            file=sys.stderr,
        )
        return 1
    print(
        f"hapax-transcript-custody: {host} snapshot {cur.get('short_id')} ({age_hours:.1f}h old; expected paths "
        f"from {source}) holds every transcript path, none empty or dropped, no credential"
    )
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="hapax-transcript-custody", description=__doc__.splitlines()[0]
    )
    sub = parser.add_subparsers(dest="cmd", required=True)
    inv = sub.add_parser("inventory")
    inv.add_argument("--json", action="store_true")
    inv.add_argument(
        "--windows",
        nargs="+",
        metavar="HOST",
        help="also ask these Windows hosts over SSH (default on the puller: HAPAX_TRANSCRIPT_WINDOWS_HOSTS)",
    )
    bak = sub.add_parser("backup")
    bak.add_argument("--dry-run", action="store_true")
    bak.add_argument(
        "--capture",
        action="store_true",
        help="capture SQLite consistently and verify every file hash before and after backup",
    )
    ver = sub.add_parser("verify")
    ver.add_argument(
        "--max-age-hours",
        type=float,
        default=26.0,
        help="fail if the newest snapshot is older than this (default 26: one nightly cycle plus margin)",
    )
    args = parser.parse_args(argv)
    return {"inventory": cmd_inventory, "backup": cmd_backup, "verify": cmd_verify}[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
