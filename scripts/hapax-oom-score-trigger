#!/usr/bin/bash -p
# Compatibility sentinel for stale user-unit drop-ins during governed cutover.
set -euo pipefail
IFS=$' \t\n'
PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/bin
export PATH
unset ENV BASH_ENV CDPATH

[ "$#" -eq 1 ] || {
    printf 'usage: hapax-oom-score-trigger UNIT\n' >&2
    exit 2
}

case "$1" in
    pipewire.service|pipewire-pulse.service|wireplumber.service|\
    hapax-daimonion.service|studio-compositor.service|hapax-imagination.service)
        ;;
    *)
        printf 'refusing non-retired OOM trigger unit: %s\n' "$1" >&2
        exit 2
        ;;
esac

printf 'info: root negative OOM trigger is retired; no process state was changed\n'
