#!/usr/bin/env python3
"""Ask one fresh, read-only challenge through an admitted subscription route.

Input is one JSON object on stdin with exactly act, evidence, governing_rule.
This helper is a witness, not authority to perform the proposed act. Only the
declared Codex full route has an adapter here; other routes fail closed.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from datetime import UTC, datetime
from pathlib import Path
from typing import Any

REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from shared.capability_execution import codex_execution_args  # noqa: E402
from shared.codex_execution_receipt import observe_codex_run_identity  # noqa: E402
from shared.dispatcher_policy import load_dispatch_policy_sources  # noqa: E402
from shared.platform_capability_receipts import (  # noqa: E402
    DEFAULT_PLATFORM_CAPABILITY_RECEIPT_DIR,
    load_platform_capability_receipts,
)
from shared.platform_capability_registry import (  # noqa: E402
    CapacityPool,
    ExecutionDescriptor,
    Mode,
    Platform,
    QualityFloor,
    RouteState,
    check_route_freshness,
)
from shared.quota_spend_ledger import (  # noqa: E402
    SubscriptionQuotaState,
    subscription_quota_state_for_route,
)

DEFAULT_ROUTE = "codex.headless.full"
MAX_INPUT_BYTES = 12_000
SCHEMA = {
    "type": "object",
    "properties": {
        "verdict": {"type": "string", "enum": ["clean", "gap"]},
        "gap": {"type": "string"},
    },
    "required": ["verdict", "gap"],
    "additionalProperties": False,
}


class ChallengeHold(ValueError):
    """A challenged act cannot be treated as cleared."""


@dataclass(frozen=True)
class Admission:
    route_id: str
    binary: str
    model: str
    effort: str
    receipt_id: str
    quota_refs: tuple[str, ...]
    descriptor: ExecutionDescriptor


def _value(value: Any) -> str:
    return str(getattr(value, "value", value))


def admit_route(
    route_id: str = DEFAULT_ROUTE,
    quality_floor: str = "frontier_review_required",
) -> Admission:
    """Consume the existing route, freshness, quota and CLI receipts without fallback."""
    if route_id != DEFAULT_ROUTE:
        raise ChallengeHold(f"unsupported_route:{route_id}")
    try:
        sources = load_dispatch_policy_sources()
        if (
            sources.registry is None
            or sources.registry_error
            or sources.non_supply_observation_errors
            or sources.surface_delta_blockers_by_route.get(route_id)
        ):
            raise ChallengeHold("registry_or_surface_hold")
        route = sources.registry.require(route_id)
        freshness = check_route_freshness(route)
        if (
            route.route_state != RouteState.ACTIVE
            or route.blocked_reasons
            or not freshness.ok
            or freshness.blocked_reasons
        ):
            raise ChallengeHold("route_not_active_or_fresh")
        if route.platform != Platform.CODEX or route.mode != Mode.HEADLESS:
            raise ChallengeHold("route_backend_mismatch")
        if (
            route.paid_provider is not None
            or route.mutability.provider_spend
            or route.capacity_pool != CapacityPool.SUBSCRIPTION_QUOTA
        ):
            raise ChallengeHold("paid_route_forbidden")
        floor = QualityFloor(quality_floor)
        if floor not in route.quality_envelope.eligible_quality_floors:
            raise ChallengeHold("quality_floor_not_admitted")
        descriptor = route.execution_descriptor
        model, effort = _value(descriptor.model_id), _value(descriptor.effort)
        if (
            model in {"", "unknown"}
            or effort in {"", "none"}
            or _value(descriptor.context_mode) != "standard"
            or _value(descriptor.fast_mode) != "off"
            or _value(descriptor.quantization) != "none"
        ):
            raise ChallengeHold("unsupported_execution_descriptor")
        if (
            sources.quota_ledger is None
            or sources.quota_error
            or sources.quota_ledger_source != "live"
            or sources.quota_live_error
        ):
            raise ChallengeHold("quota_ledger_not_live")
        quota_state, quota_refs = subscription_quota_state_for_route(sources.quota_ledger, route_id)
        if quota_state != SubscriptionQuotaState.FRESH or not quota_refs:
            raise ChallengeHold("quota_not_fresh")
        receipt = load_platform_capability_receipts(DEFAULT_PLATFORM_CAPABILITY_RECEIPT_DIR).get(
            "codex"
        )
        if (
            receipt is None
            or route_id not in receipt.routes
            or not receipt.cli.available
            or not receipt.cli.version
        ):
            raise ChallengeHold("cli_receipt_missing")
        binary = shutil.which("codex")
        if binary is None:
            raise ChallengeHold("codex_binary_missing")
        version = subprocess.run(
            [binary, "--version"], capture_output=True, text=True, timeout=5, check=False
        )
        if version.returncode or version.stdout.strip() != receipt.cli.version:
            raise ChallengeHold("cli_version_mismatch")
        return Admission(
            route_id, binary, model, effort, receipt.receipt_id, tuple(quota_refs), descriptor
        )
    except ChallengeHold:
        raise
    except (OSError, ValueError, KeyError, subprocess.TimeoutExpired) as exc:
        raise ChallengeHold(f"admission_unobserved:{type(exc).__name__}") from exc


def build_prompt(act: str, evidence: str, governing_rule: str) -> str:
    values = {"act": act, "evidence": evidence, "governing_rule": governing_rule}
    if any(not isinstance(value, str) or not value.strip() for value in values.values()):
        raise ChallengeHold("input_missing")
    if len(json.dumps(values, ensure_ascii=False).encode()) > MAX_INPUT_BYTES:
        raise ChallengeHold("input_exceeds_small_context")
    return (
        "Fresh independent challenge. Consider only the three supplied fields. "
        "What does the evidence not support under the governing rule? "
        "Do not use tools or perform the act. Return JSON: verdict is gap when a "
        "material gap remains, otherwise clean; gap is a short explanation or empty.\n"
        + json.dumps(values, ensure_ascii=False, sort_keys=True)
    )


def challenge_environment(codex_home: Path, source: dict[str, str]) -> dict[str, str]:
    """Do not pass API/provider credentials or inherited route knobs to Codex."""
    allowed = ("PATH", "LANG", "LC_ALL", "SSL_CERT_FILE", "SSL_CERT_DIR", "TERM")
    env = {key: source[key] for key in allowed if source.get(key)}
    env.update({"HOME": str(codex_home.parent), "CODEX_HOME": str(codex_home), "NO_COLOR": "1"})
    return env


def parse_verdict(raw: str) -> tuple[str, str]:
    try:
        result = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise ChallengeHold("invalid_verdict") from exc
    if (
        not isinstance(result, dict)
        or set(result) != {"verdict", "gap"}
        or not isinstance(result["verdict"], str)
        or result["verdict"] not in {"clean", "gap"}
        or not isinstance(result["gap"], str)
        or (result["verdict"] == "gap" and not result["gap"].strip())
        or (result["verdict"] == "clean" and result["gap"].strip())
    ):
        raise ChallengeHold("invalid_verdict")
    return result["verdict"], result["gap"]


def _thread_id(stream: str) -> str:
    ids: list[str] = []
    started = completed = 0
    for line in stream.splitlines():
        try:
            row = json.loads(line)
        except json.JSONDecodeError as exc:
            raise ChallengeHold("native_stream_malformed") from exc
        if not isinstance(row, dict):
            raise ChallengeHold("native_stream_malformed")
        if row.get("type") == "thread.started":
            ids.append(row.get("thread_id"))
        if row.get("type") == "turn.started":
            started += 1
        if row.get("type") == "turn.completed":
            completed += 1
        if row.get("type") in {"error", "turn.failed"}:
            raise ChallengeHold("native_turn_failed")
        item = row.get("item")
        if row.get("type", "").startswith("item."):
            if not isinstance(item, dict) or item.get("type") not in {
                "agent_message",
                "reasoning",
            }:
                raise ChallengeHold("challenge_used_tools")
    if len(ids) != 1 or not isinstance(ids[0], str) or started != 1 or completed != 1:
        raise ChallengeHold("native_turn_incomplete")
    return ids[0]


def run_challenge(act: str, evidence: str, governing_rule: str, route_id: str) -> dict[str, Any]:
    prompt = build_prompt(act, evidence, governing_rule)
    admitted = admit_route(route_id)
    auth = Path.home() / ".codex/auth.json"
    if not auth.is_file() or auth.is_symlink():
        raise ChallengeHold("saved_login_missing")
    with tempfile.TemporaryDirectory(prefix="hapax-fresh-challenge-") as root_name:
        root = Path(root_name)
        codex_home = root / "codex-home"
        codex_home.mkdir(mode=0o700)
        (root / "work").mkdir(mode=0o700)
        (codex_home / "auth.json").symlink_to(auth)
        schema = root / "response-schema.json"
        schema.write_text(json.dumps(SCHEMA))
        answer = root / "answer.json"
        command = [
            admitted.binary,
            "exec",
            "--json",
            "--skip-git-repo-check",
            "--sandbox",
            "read-only",
            "--cd",
            str(root / "work"),
            *codex_execution_args(admitted.descriptor),
            "-c",
            "check_for_update_on_startup=false",
            "--output-schema",
            str(schema),
            "--output-last-message",
            str(answer),
            "-",
        ]
        launch_started_at = datetime.now(UTC).isoformat()
        try:
            result = subprocess.run(
                command,
                input=prompt,
                capture_output=True,
                text=True,
                timeout=180,
                check=False,
                env=challenge_environment(codex_home, os.environ),
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            raise ChallengeHold(f"native_launch_unobserved:{type(exc).__name__}") from exc
        if result.returncode:
            raise ChallengeHold(f"native_turn_failed:{result.returncode}")
        thread_id = _thread_id(result.stdout)
        identity = observe_codex_run_identity(
            admitted.descriptor,
            route_id=admitted.route_id,
            session_id=thread_id,
            native_home=codex_home,
            workdir=root / "work",
            launch_started_at=launch_started_at,
        )
        if identity["status"] != "matched":
            raise ChallengeHold(
                "execution_identity_unverified:" + ",".join(identity["reason_codes"])
            )
        observed_model = identity["turns"][-1]["observed"]["model"]
        observed_effort = identity["turns"][-1]["observed"]["effort"]
        if not answer.is_file():
            raise ChallengeHold("answer_missing")
        verdict, gap = parse_verdict(answer.read_text())
        return {
            "route_id": admitted.route_id,
            "observed_model": observed_model,
            "observed_effort": observed_effort,
            "identity_boundary": "codex_native_rollout_client_observation",
            "platform_receipt_id": admitted.receipt_id,
            "quota_evidence_refs": admitted.quota_refs,
            "verdict": verdict,
            "gap": gap,
            "authority": "advisory_only",
        }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--route", default=DEFAULT_ROUTE)
    args = parser.parse_args(argv)
    try:
        payload = json.load(sys.stdin)
        if not isinstance(payload, dict) or set(payload) != {
            "act",
            "evidence",
            "governing_rule",
        }:
            raise ChallengeHold("input_shape_invalid")
        result = run_challenge(
            payload["act"], payload["evidence"], payload["governing_rule"], args.route
        )
    except (ChallengeHold, json.JSONDecodeError, OSError) as exc:
        print(f"HOLD: {exc}", file=sys.stderr)
        return 8
    print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
