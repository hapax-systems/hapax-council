RELAY_RECEIPT_DIR = Path(
    os.environ.get(
        "HAPAX_RELAY_RECEIPT_DIR",
        str(Path.home() / ".cache/hapax/relay/receipts"),
    )
)

# Producers whose receipts the quota surfaces embed, run-if-due BEFORE the
# capability-receipt refresh reads them (see module docstring, step 0).
# claude-account-live is deliberately absent: its 1800s TTL leaves 1200s
# remaining at the same 600s phase, comfortably above the write cadence, so it
# has no freshness flap to repair.
QUOTA_SURFACE_PULL_FORWARD_PRODUCER_IDS = ("agy-review-quota",)
# Route-id prefixes of the producers above, derived — not hand-listed — so
# adding a producer to the pull-forward automatically widens the continuity
# witness to its routes: "agy-review-quota" -> "agy." (routes are
# dot-namespaced, e.g. "agy.review.direct"). A hand-listed "agy." here is
# exactly how a second producer's flap would ride green while the docstring
# spoke of the quota surface generally (claude-1 minor, #4665 round 6).
# CONTRACT: the derivation only holds because every producer id in
# QUOTA_SURFACE_PULL_FORWARD_PRODUCER_IDS leads with its route dot-namespace as
# the first hyphen token ("<namespace>-…", e.g. a claude producer would be
# "claude-…" so its routes "claude.*" stay witnessed). The pinned test
# test_pull_forward_route_prefix_derivation_is_the_producer_naming_contract
# fails if a producer id is added whose first token is not its route
# namespace (claude-1 minor, #4665 round 8).
QUOTA_SURFACE_PULL_FORWARD_ROUTE_PREFIXES = tuple(
    pid.split("-", 1)[0] + "." for pid in QUOTA_SURFACE_PULL_FORWARD_PRODUCER_IDS
)
# The telemetry timer's OnUnitActiveSec (10min) and the quota surface's
# stale_after (15m) — the two cadences the pull-forward arithmetic sits between.
# The timer's AccuracySec=1min means the writer's fire phase walks up to +60s
# against the nominal cycle, which is why the pull decision is derived from the
# freshness the NEXT publication needs (below), never from a measured phase.
WRITER_CYCLE_S = 600.0
TIMER_ACCURACY_S = 60.0
# Bounded budgets for the pull's child, pinned relative to PULL_FORWARD_TIMEOUT_S
# by TestPullForwardBudgetPins: the lock wait covers a colliding determine-timer
# winner finishing a typical run (measured 2026-09-12: agy-review-quota completes
# in ~27s), and the producer timeout bounds the smoke inside the pull context
# (the determine timer's own invocation keeps the harness default of 300s).
PULL_FORWARD_LOCK_WAIT_S = 90.0
PULL_FORWARD_PRODUCER_TIMEOUT_S = 90.0
# Worst-case serial child: lock wait + producer run + spawn overhead. With the
# 360s refresh outer budget this stays under the 600s write cadence, so a tick
# can no longer defer the next fire by duration alone.
PULL_FORWARD_TIMEOUT_S = PULL_FORWARD_LOCK_WAIT_S + PULL_FORWARD_PRODUCER_TIMEOUT_S + 30.0
# Bound on the work between a mint's run anchor and this tick's first ledger
# write: receipt re-scan, ledger build, atomic write. The round-4 value of 60
# was below its own cited measurement (2026-09-12: 33s mint + 32s write-side
# = 65s anchor-to-write — glm-1 minor), so the horizon undercounted by ~5s.
# 65 covers the measured anchor-to-write; the worst observed LIVE tick spent
# 81s here on a receipt-spam-inflated scan (3,586 agy + 8,370 claude expired
# receipts each emitting a stderr line per scan) — receipt retention/GC is a
# separate follow-up claim, deliberately not folded into this repair. At B=65
# the steady-state bound is L <= 900 - 819 = 81s, so the inflated 81s tick
# still publishes non-degraded — exactly at the bound, with zero margin; any
# worse tick degrades, which is the honest signal (glm-1 minor, #4665 round
# 6: the earlier "4s of margin" wording was PRE_MINT_SCAN_BOUND_S bleeding
# into this sentence).
PRE_WRITE_WORK_BOUND_S = 65.0
# Bound on the pre-mint force-decision scan (`pull_forward_force_needed`), the
# one piece of pre-publication work round 5 still left outside both the
# measurement window and the derivation: it runs BEFORE the mint, so neither
# the mint's run anchor (B above) nor the publication instant (measured from
# `publish_mono_started`) can see its duration (critical finding on #4665,
# round 5, C2). Measured 2026-09-12 against the live receipt dir (3,590
# expired + 1 active agy admission receipt): 0.06-0.07s across three runs, so
# 4s is a ~57x margin; the scan is dominated by directory iteration, and
# receipt-accumulation growth beyond the bound degrades the tick outright
# (`pre_mint_scan_elapsed_s` vs this bound in the summary), which is the
# honest signal for the receipt-retention/GC follow-up claim. 4 keeps the
# horizon at 819 so the receipt-spam-inflated 81s anchor-to-write tick still
# publishes non-degraded (900-819 = 81).
PRE_MINT_SCAN_BOUND_S = 4.0
# The freshness horizon: what the admission embedded by THIS write must outlive
# to guarantee the published surface never cites a dead admission. Derived from
# the next publication deadline (critical finding on #4665, round 3: 600+15
# accepted a 620s-remaining admission that a +640s slipped fire plus a 27s
# publish overran, a 47s flap):
#
#     WRITER_CYCLE_S            — the next fire is one cycle out
#   + TIMER_ACCURACY_S          — the fire may slip by the timer's accuracy
#   + max(LOCK_WAIT, PRODUCER)  — the next tick's pre-write work: it either
#                                  waits on a colliding winner's lock OR runs
#                                  the producer itself, never both serially —
#                                  --force-justified-at revalidation in the
#                                  lock makes the waiter defer to the winner
#   + PRE_MINT_SCAN_BOUND_S     — the next tick's pre-mint force-decision
#                                  scan, which runs before the mint's anchor
#   + PRE_WRITE_WORK_BOUND_S    — scan + build + first write after the mint
#
# Steady state: a forced mint leaves 900s - (anchor→write measured 65s) ≈ 835s
# at the publication instant, comfortably above the horizon; a degraded tick is
# one whose pre-write work consumed the budget the derivation promised.
FRESHNESS_HORIZON_S = (
    WRITER_CYCLE_S
    + TIMER_ACCURACY_S
    + max(PULL_FORWARD_LOCK_WAIT_S, PULL_FORWARD_PRODUCER_TIMEOUT_S)
    + PRE_MINT_SCAN_BOUND_S
    + PRE_WRITE_WORK_BOUND_S
)

# Bounded wait to acquire the live-ledger lock: the last previously-unbounded
# wait in the tick (review finding on #4665, round 4). A colliding holder is
# another writer instance (timer + manual); the measured write-side pass is
# ~32s typical, 81s on the receipt-spam-inflated tick, so 120s bounds the wait
# with margin, and expiry is a clean nonzero exit instead of a hang the unit's
# TimeoutStartSec has to kill.
LIVE_LEDGER_LOCK_WAIT_S = 120.0
# Retry cadence while the live-ledger lock is contended; a module constant so
# tests can shrink it instead of sleeping real intervals.
LIVE_LEDGER_LOCK_RETRY_INTERVAL_S = 0.5

# Injectable monotonic clock: the exit predicate derives the actual
# publication instant from elapsed monotonic time added to the tick's `now`
# (major finding on #4665, round 4 — freshness measured at `captured_at`,
# which is sampled BEFORE the scans and the write, cannot see pre-write work
# overruns between sampling and publication). Tests replace this to advance
# the publication instant without sleeping.
monotonic_clock = time.monotonic

