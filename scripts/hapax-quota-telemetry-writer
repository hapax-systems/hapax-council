# A wall receipt without resets_at stays authoritative this long after
# detection; afterwards it is treated as recovered rather than pinning the
# platform exhausted forever.
WALL_WITHOUT_RESET_TTL = timedelta(hours=24)

VRAM_RED_FRACTION = 0.99
VRAM_YELLOW_FRACTION = 0.90
LOAD_RED_PER_CPU = 8.0
LOAD_YELLOW_PER_CPU = 4.0


def role_platform(role: str) -> str:
    """Map a lane role (relay receipt filename stem) to its platform."""

    normalized = role.lower().replace("_", "-")
    if (
        normalized in {"cx-glmcp", "codex-glmcp", "glmcp"}
        or normalized.startswith("cx-glmcp")
        or normalized.startswith("codex-glmcp")
        or normalized.startswith("glm-")
        or normalized.startswith("glmcp-")
    ):
        return "glmcp"
    if normalized.startswith("cx-") or normalized.startswith("codex"):
        return "codex"
    if normalized.startswith("gemini") or normalized.startswith("gm-"):
        return "retired-gemini"
    if normalized.startswith("agy"):
        return "agy"
    if normalized.startswith("antigrav"):
        return "antigrav"
    if normalized.startswith("vbe-") or normalized.startswith("vibe"):
        return "vibe"
    return "claude"


def claude_wall_route_id_for_role(role: str) -> str | None:
    normalized = role.lower().replace("_", "-")
    if normalized in CLAUDE_HEADLESS_ROLES:
        return SUBSCRIPTION_ROUTES["claude"]
    return None


def _parse_flat_yaml(text: str) -> dict[str, str]:
    """Parse the flat ``key: value`` quota-wall receipts without a YAML dep."""

    fields: dict[str, str] = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or ":" not in line:
            continue
        key, _, value = line.partition(":")
        fields[key.strip()] = value.strip().strip("'\"")
    return fields


def _parse_flat_yaml_strict(
    text: str,
    *,
    allowed_fields: frozenset[str] = GLMCP_ADMISSION_FIELDS,
) -> tuple[dict[str, str], str | None]:
    """Parse flat admission receipts and reject ambiguous YAML-shaped input."""

    fields: dict[str, str] = {}
    for line_no, raw_line in enumerate(text.splitlines(), start=1):
        stripped = raw_line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if raw_line[:1].isspace() or stripped.startswith("-"):
            return {}, f"non-flat line {line_no}"
        if ":" not in raw_line:
            return {}, f"non key-value line {line_no}"
        key, _, value = raw_line.partition(":")
        normalized_key = key.strip()
        if not normalized_key:
            return {}, f"empty key on line {line_no}"
        if normalized_key not in allowed_fields:
            return {}, f"unsupported key on line {line_no}"
        if normalized_key in fields:
            return {}, f"duplicate key on line {line_no}"
        fields[normalized_key] = value.strip().strip("'\"")
    return fields, None


def _parse_utc(value: str) -> datetime | None:
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=UTC)
    return parsed.astimezone(UTC)


def _utc_seconds(value: datetime) -> datetime:
    return value.astimezone(UTC).replace(microsecond=0)


def _iso_z_seconds(value: datetime) -> str:
    return _utc_seconds(value).isoformat().replace("+00:00", "Z")


def _reason_code(reason: str) -> str:
    code = re.sub(r"[^a-z0-9]+", "-", reason.lower()).strip("-")
    return code[:80] or "ignored"


def _warn_ignored_glmcp_admission(path: Path, reason: str) -> str:
    receipt_label = _receipt_label(path)
    print(
        f"hapax-quota-telemetry-writer: ignoring GLMCP admission receipt {receipt_label}: "
        f"{reason}; recheck: {GLMCP_ADMISSION_RECHECK_COMMAND}; "
        f"{GLMCP_ADMISSION_RECOVERY_HINT}",
        file=sys.stderr,
    )
    return f"relay-receipt:{receipt_label}:ignored:{_reason_code(reason)}"


def _warn_frozen_glmcp_payg_spend(path: Path, reasons: list[str], spend_id: str) -> None:
    print(
        f"hapax-quota-telemetry-writer: freezing GLMCP PAYG spend receipt {_receipt_label(path)} "
        f"as spend_id {spend_id}: {'; '.join(_reason_code(reason) for reason in reasons)}; its "
        "spend counts and paid GLMCP spend is refused until a reviewed governance SpendReceipt "
        f"with spend_id {spend_id} lands in config/quota-spend-ledger-fixtures.json",
        file=sys.stderr,
    )


def _warn_ignored_glmcp_payg_spend(path: Path, reason: str) -> str:
    receipt_label = _receipt_label(path)
    print(
        f"hapax-quota-telemetry-writer: ignoring GLMCP PAYG spend receipt {receipt_label}: "
        f"{reason}; recheck: find ~/.cache/hapax/relay/receipts -maxdepth 1 "
        f"-name '{GLMCP_PAYG_SPEND_RECEIPT_GLOB}' -print",
        file=sys.stderr,
    )
    return f"relay-receipt:{receipt_label}:ignored:{_reason_code(reason)}"


def _warn_stripped_glmcp_payg_spend_task_hash(path: Path, task_hash: str) -> None:
    receipt_label = _receipt_label(path)
    print(
        "hapax-quota-telemetry-writer: stripped malformed optional task_hash from "
        f"GLMCP PAYG spend receipt {receipt_label}; spend still counts against cap; "
        f"task_hash={task_hash!r}",
        file=sys.stderr,
    )


def _glmcp_payg_spend_field_is_nullish(key: str, value: str) -> bool:
    return (
        key in GLMCP_PAYG_SPEND_NULLABLE_FIELDS
        and value.strip().strip("'\"").lower() in GLMCP_PAYG_SPEND_NULL_LITERALS
    )


def _glmcp_payg_budget_request(task_id: str) -> PaidRouteRequest:
    return PaidRouteRequest.model_validate(
        {
            "route_id": "glmcp.review.direct",
            "task_id": task_id,
            "provider": GLMCP_PAYG_BUDGET_PROVIDER,
            "profile": GLMCP_PAYG_BUDGET_PROFILE,
            "task_class": GLMCP_PAYG_BUDGET_TASK_CLASS,
            "quality_floor": GLMCP_PAYG_BUDGET_QUALITY_FLOOR,
            "estimated_cost_usd": GLMCP_PAYG_ESTIMATED_COST_USD,
            "capacity_pool": GLMCP_ADMISSION_PAYG_CAPACITY_POOL,
        }
    )


def _glmcp_payg_spend_gate_ledger(base: QuotaSpendLedger, *, now: datetime) -> QuotaSpendLedger:
    payload = base.model_dump(mode="json")
    payload["captured_at"] = now.isoformat().replace("+00:00", "Z")
    payload["generated_from"] = list(
        dict.fromkeys([*payload["generated_from"], "scripts/hapax-quota-telemetry-writer"])
    )
    return QuotaSpendLedger.model_validate(payload)


def _glmcp_payg_budget_decision(
    base: QuotaSpendLedger,
    *,
    now: datetime,
    task_id: str,
) -> PaidRouteEligibility:
    return evaluate_paid_route_eligibility(
        _glmcp_payg_spend_gate_ledger(base, now=now),
        _glmcp_payg_budget_request(task_id),
        now=now,
    )


def _glmcp_payg_budget_evidence(decision: PaidRouteEligibility) -> list[str]:
    evidence = [f"spend-gate:glmcp.review.direct:{decision.state}"]
    for ref in decision.evidence_refs:
        evidence.append(f"spend-gate-budget:{ref}")
    if decision.budget_id:
        evidence.append(f"spend-gate-budget:{decision.budget_id}")
    for reason in decision.blocking_reasons:
        evidence.append(f"spend-gate-blocker:{_reason_code(reason)}")
    return list(dict.fromkeys(evidence))


def _glmcp_payg_budget_reason(decision: PaidRouteEligibility) -> str:
    if decision.eligible:
        return (
            f"PAYG fallback passed paid-spend gate budget {decision.budget_id}; "
            "GLMCP remains receipt-bounded and budget-bounded"
        )
    blockers = "; ".join(decision.blocking_reasons) or decision.state
    return f"PAYG fallback refused by paid-spend gate: {blockers}"


def _payg_admission_matches_active_wall(
    admission: GlmcpAdmission,
    platform_walls: list[QuotaWall],
) -> bool:
    if (
        admission.endpoint != GLMCP_PAYG_ENDPOINT
        or not admission.quota_wall_evidence_ref
        or not admission.primary_error_class
    ):
        return False
    return any(
        wall.receipt_label == admission.quota_wall_evidence_ref
        and admission.primary_error_class in {wall.failure_class, wall.rate_limit_type}
        for wall in platform_walls
    )


def _payg_spend_receipt_witness_refs(receipt: SpendReceipt) -> set[str]:
    refs = {receipt.spend_id}
    match = re.fullmatch(r"spend-([0-9]{8}T[0-9]{6}Z)-glmcp-payg-review-(.+)", receipt.spend_id)
    if match is not None:
        stamp, suffix = match.groups()
        refs.add(f"glmcp-payg-spend-{stamp.lower()}-{suffix}.yaml")
    return refs


def _payg_admission_matching_spend_receipt(
    admission: GlmcpAdmission,
    receipts: list[SpendReceipt],
) -> SpendReceipt | None:
    if admission.endpoint != GLMCP_PAYG_ENDPOINT:
        return None
    return next(
        (
            receipt
            for receipt in receipts
            if admission.witness_ref in _payg_spend_receipt_witness_refs(receipt)
        ),
        None,
    )


def _payg_admission_has_validated_spend_receipt(
    admission: GlmcpAdmission,
    receipts: list[SpendReceipt],
) -> bool:
    return _payg_admission_matching_spend_receipt(admission, receipts) is not None


def _receipt_label(path: Path) -> str:
    name = path.name
    if CLAUDE_ADMISSION_SAFE_RECEIPT_NAME_RE.fullmatch(name) is not None:
        name_stem = name.removesuffix(".yaml")
        if (
            CLAUDE_ADMISSION_SECRETISH_RE.search(name_stem) is None
            and CLAUDE_ADMISSION_BILLINGISH_RE.search(name_stem) is None
            and CLAUDE_ADMISSION_LANE_PRESENCE_RE.search(name_stem) is None
        ):
            return name
        digest = hashlib.sha256(name.encode("utf-8", errors="replace")).hexdigest()[:16]
        return f"unsafe-receipt-name-sha256:{digest}"
    if (
        AGY_ADMISSION_SAFE_RECEIPT_NAME_RE.fullmatch(name)
        and AGY_ADMISSION_SECRETISH_RE.search(name) is None
    ):
        return name
    if (
        KIMI_ADMISSION_SAFE_RECEIPT_NAME_RE.fullmatch(name)
        and KIMI_ADMISSION_SECRETISH_RE.search(name) is None
    ):
        return name
    if (
        GLMCP_ADMISSION_SAFE_RECEIPT_NAME_RE.fullmatch(name)
        or GLMCP_PAYG_SPEND_SAFE_RECEIPT_NAME_RE.fullmatch(name)
    ) and GLMCP_ADMISSION_SECRETISH_RE.search(name) is None:
        return name
    digest = hashlib.sha256(name.encode("utf-8", errors="replace")).hexdigest()[:16]
    return f"unsafe-receipt-name-sha256:{digest}"


def active_quota_walls(
    receipt_dir: Path,
    *,
    now: datetime,
) -> dict[str, list[QuotaWall]]:
    """Return platform -> wall evidence refs for unexpired quota-wall receipts."""

    walls: dict[str, list[QuotaWall]] = {}
    if not receipt_dir.is_dir():
        return walls
    for path in sorted(receipt_dir.glob("*-quota-wall.yaml")):
        fields = _parse_flat_yaml(path.read_text(encoding="utf-8"))
        if fields.get("status") != "quota_blocked":
            continue
        role = fields.get("role") or path.name.removesuffix("-quota-wall.yaml")
        resets_at = _parse_utc(fields.get("resets_at", ""))
        detected_at = _parse_utc(fields.get("detected_at", ""))
        if resets_at is not None:
            if resets_at <= now:
                continue
        else:
            if detected_at is None or now - detected_at > WALL_WITHOUT_RESET_TTL:
                continue
        platform = role_platform(role)
        if platform == "retired-gemini":
            print(
                "hapax-quota-telemetry-writer: WARNING ignoring retired Gemini "
                f"quota-wall receipt {path.name}; legacy Gemini CLI lanes are retired",
                file=sys.stderr,
            )
            continue
        failure_class = fields.get("failure_class") or "unknown"
        rate_limit_type = fields.get("rate_limit_type") or "unknown"
        route_id = fields.get("route_id") or None
        if platform == "claude":
            derived_route_id = claude_wall_route_id_for_role(role)
            if derived_route_id is not None:
                route_id = derived_route_id
            elif route_id and route_id not in CLAUDE_SUBSCRIPTION_ROUTES:
                route_id = None
        elif route_id and route_id != SUBSCRIPTION_ROUTES.get(platform):
            route_id = None
        route_ref = f":route_id:{route_id}" if route_id else ""
        walls.setdefault(platform, []).append(
            QuotaWall(
                evidence_ref=(
                    f"relay-receipt:{path.name}:failure_class:{failure_class}:"
                    f"rate_limit_type:{rate_limit_type}{route_ref}:resets_at:"
                    f"{fields.get('resets_at') or 'unknown'}"
                ),
                receipt_label=path.name,
                failure_class=failure_class,
                rate_limit_type=rate_limit_type,
                detected_at=detected_at,
                resets_at=resets_at,
                route_id=route_id,
            )
        )
    return walls


def codex_saved_login_blocker(
    receipt_dir: Path,
    *,
    now: datetime,
) -> CodexAuthBlocker | None:
    """Return fail-closed Codex auth blockers from platform capability receipts."""

    try:
        receipt = load_platform_capability_receipts(receipt_dir, now=now).get("codex")
    except PlatformCapabilityReceiptError as exc:
        return CodexAuthBlocker(
            reason_codes=["codex_platform_capability_receipt_invalid"],
            evidence_refs=[
                f"platform-capability-receipt:codex:invalid:{_reason_code(str(exc))}",
            ],
        )
    if receipt is None:
        return stale_codex_platform_receipt_blocker(receipt_dir, now=now)
    return codex_auth_blocker_from_receipt(receipt)


def stale_codex_platform_receipt_blocker(
    receipt_dir: Path,
    *,
    now: datetime,
) -> CodexAuthBlocker | None:
    """Return a fail-closed blocker when the newest Codex receipt aged out."""

    if not receipt_dir.exists():
        return CodexAuthBlocker(
            reason_codes=["codex_platform_capability_receipt_absent"],
            evidence_refs=["platform-capability-receipt:codex:absent:receipt-dir-missing"],
        )
    codex_receipts = []
    for path in sorted(receipt_dir.glob("*.json")):
        receipt = load_platform_capability_receipt(path)
        if receipt.platform == "codex":
            codex_receipts.append(receipt)
    if not codex_receipts:
        return CodexAuthBlocker(
            reason_codes=["codex_platform_capability_receipt_absent"],
            evidence_refs=["platform-capability-receipt:codex:absent:no-codex-receipt"],
        )
    latest = max(codex_receipts, key=lambda item: item.observed_at)
    if receipt_is_fresh(latest, now=now):
        return None
    blocker = codex_auth_blocker_from_receipt(latest)
    reason_codes = ["codex_platform_capability_receipt_stale"]
    if blocker is not None:
        reason_codes.extend(blocker.reason_codes)
    return CodexAuthBlocker(
        reason_codes=list(dict.fromkeys(reason_codes)),
        evidence_refs=[
            f"platform-capability-receipt:codex:stale:{_reason_code(latest.receipt_id)}",
            receipt_reference(latest),
            *(
                blocker.evidence_refs
                if blocker is not None
                else [*latest.capability.evidence_refs, *latest.resource.evidence_refs]
            ),
        ],
    )


def codex_auth_blocker_from_receipt(receipt: Any) -> CodexAuthBlocker | None:
    reason_codes = list(
        dict.fromkeys(
            [
                *receipt.capability.reason_codes,
                *receipt.resource.reason_codes,
            ]
        )
    )
    auth_reasons = [
        reason
        for reason in reason_codes
        if reason in CODEX_EXEC_AUTH_HOLD_REASONS or reason.startswith("codex_exec_auth_")
    ]
    if not auth_reasons:
        evidence_refs = [
            *receipt.capability.evidence_refs,
            *receipt.resource.evidence_refs,
        ]
        if codex_exec_auth_witness_observed(evidence_refs):
            return None
        return CodexAuthBlocker(
            reason_codes=["codex_exec_auth_witness_absent"],
            evidence_refs=[
                receipt_reference(receipt),
                *evidence_refs,
            ],
        )
    return CodexAuthBlocker(
        reason_codes=auth_reasons,
        evidence_refs=[
            receipt_reference(receipt),
            *receipt.capability.evidence_refs,
            *receipt.resource.evidence_refs,
        ],
    )


def codex_exec_auth_witness_observed(evidence_refs: Iterable[str]) -> bool:
    expected_hosts = expected_codex_exec_auth_hosts()
    return any(
        codex_exec_auth_ref_attested(ref, expected_hosts=expected_hosts) for ref in evidence_refs
    )


def codex_exec_auth_ref_attested(
    evidence_ref: str,
    *,
    expected_hosts: frozenset[tuple[str, ...]],
) -> bool:
    ref = _ref_tokens(evidence_ref)
    if any(token in CODEX_EXEC_AUTH_NEGATIVE_REF_TOKENS for token in ref):
        return False
    if not (
        len(ref) >= 8
        and ref[0] == "host"
        and ref[-6:] == ("codex", "exec", "auth", "saved", "login", "observed")
    ):
        return False
    return ref[1:-6] in expected_hosts


def expected_codex_exec_auth_hosts() -> frozenset[tuple[str, ...]]:
    dispatch_host = (
        os.environ.get("HAPAX_CODEX_EXEC_AUTH_HOST")
        or os.environ.get("HAPAX_DISPATCH_HOST")
        or os.environ.get("HAPAX_DEFAULT_DISPATCH_HOST")
        or ""
    ).strip()
    if dispatch_host:
        return host_token_variants(dispatch_host)
    return host_token_variants("appendix")


def host_token_variants(host: str) -> frozenset[tuple[str, ...]]:
    tokens = _ref_tokens(host)
    variants = {tokens} if tokens else set()
    if len(tokens) == 1 and tokens[0] not in {"local", "localhost"}:
        variants.add(("hapax", tokens[0]))
    if len(tokens) == 2 and tokens[0] == "hapax":
        variants.add((tokens[1],))
    return frozenset(variants)


def _ref_tokens(evidence_ref: str) -> tuple[str, ...]:
    normalized = re.sub(r"[\s_:]+", "-", evidence_ref.strip().lower())
    if not normalized:
        return ()
    return tuple(token for token in normalized.split("-") if token)


def _active_quota_wall(wall: QuotaWall, *, now: datetime) -> bool:
    if wall.resets_at is not None:
        return wall.resets_at > now
    return wall.detected_at is not None and now - wall.detected_at <= WALL_WITHOUT_RESET_TTL


def _claude_shared_pool_quota_walls(
    walls: list[QuotaWall],
    *,
    now: datetime,
) -> list[QuotaWall]:
    """Return active Claude subscription walls that inhibit the shared Claude pool.

    A wall's ``route_id`` remains in the evidence ref to preserve where it was
    observed, but the Anthropic subscription quota pool is account-level: a live
    wall on one Claude subscription route inhibits every route in that provider
    pool until the wall expires or a new account-live headroom receipt is minted
    after the wall.
    """

    return [wall for wall in walls if _active_quota_wall(wall, now=now)]


def _claude_after_wall_admissions(
    admissions: list[ClaudeAdmission],
    walls: list[QuotaWall],
) -> list[ClaudeAdmission]:
    """Return admissions observed after every active shared-pool wall."""

    if not admissions or not walls:
        return []
    wall_recovery_times: list[datetime] = []
    for wall in walls:
        if wall.resets_at is not None:
            wall_recovery_times.append(wall.resets_at)
        elif wall.detected_at is not None:
            wall_recovery_times.append(wall.detected_at)
        else:
            return []
    latest_wall_recovery_at = max(wall_recovery_times)
    return [
        admission for admission in admissions if admission.observed_at > latest_wall_recovery_at
    ]


def _claude_ignored_receipts_for_route(ignored_refs: list[str], route_id: str) -> list[str]:
    route_token = f":route_id:{route_id}"
    return [ref for ref in ignored_refs if ":route_id:" not in ref or route_token in ref]


def _warn_ignored_agy_admission(path: Path, reason: str) -> str:
    receipt_label = _receipt_label(path)
    reason_code = _reason_code(reason)
    print(
        "hapax-quota-telemetry-writer: ignoring agy admission receipt: "
        f"reason={reason_code}; recheck: {AGY_ADMISSION_RECHECK_COMMAND}; "
        f"{AGY_ADMISSION_RECOVERY_HINT}",
        file=sys.stderr,
    )
    return f"relay-receipt:{receipt_label}:ignored:{reason_code}"


def _warn_ignored_kimi_admission(path: Path, reason: str) -> str:
    receipt_label = _receipt_label(path)
    reason_code = _reason_code(reason)
    print(
        "hapax-quota-telemetry-writer: ignoring kimi admission receipt: "
        f"reason={reason_code}; recheck: {KIMI_ADMISSION_RECHECK_COMMAND}; "
        f"{KIMI_ADMISSION_RECOVERY_HINT}",
        file=sys.stderr,
    )
    return f"relay-receipt:{receipt_label}:ignored:{reason_code}"


def _warn_ignored_claude_admission(path: Path, reason: str, route_id: str | None = None) -> str:
    # Emit the same sanitized reason code stored in evidence. Never print raw rejected field values.
    receipt_label = _receipt_label(path)
    reason_code = _reason_code(reason)
    print(
        "hapax-quota-telemetry-writer: ignoring claude admission receipt: "
        f"reason={reason_code}; recheck: {CLAUDE_ADMISSION_RECHECK_COMMAND}; "
        f"{CLAUDE_ADMISSION_RECOVERY_HINT}",
        file=sys.stderr,
    )
    route_ref = f":route_id:{route_id}" if route_id in CLAUDE_SUBSCRIPTION_ROUTES else ""
    return f"relay-receipt:{receipt_label}:ignored:{reason_code}{route_ref}"


def active_agy_admission_receipts(
    receipt_dir: Path,
    *,
    now: datetime,
) -> AgyAdmissionScan:
    """Return fresh positive agy route-specific admission evidence refs."""

    if not receipt_dir.is_dir():
        return AgyAdmissionScan(admissions=[], ignored_evidence_refs=[])
    refs: list[AgyAdmission] = []
    ignored_refs: list[str] = []

    def reject(path: Path, reason: str) -> None:
        ignored_refs.append(_warn_ignored_agy_admission(path, reason))

    for path in sorted(receipt_dir.glob(AGY_ADMISSION_RECEIPT_GLOB)):
        if AGY_ADMISSION_SAFE_RECEIPT_NAME_RE.fullmatch(path.name) is None:
            reject(path, "unsafe receipt name")
            continue
        try:
            raw_receipt = path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError) as exc:
            reject(path, f"unreadable receipt {type(exc).__name__}")
            continue
        fields, parse_error = _parse_flat_yaml_strict(
            raw_receipt,
            allowed_fields=AGY_ADMISSION_FIELDS,
        )
        if parse_error is not None:
            reject(path, parse_error)
            continue
        expected = {
            "schema": AGY_ADMISSION_SCHEMA,
            "status": "quota_available",
            "provider": AGY_ADMISSION_PROVIDER,
            "route_id": SUBSCRIPTION_ROUTES["agy"],
            "capacity_pool": AGY_ADMISSION_CAPACITY_POOL,
            "supported_tool": AGY_ADMISSION_SUPPORTED_TOOL,
            "secret_source": AGY_ADMISSION_SECRET_SOURCE,
            "secret_value_persisted": "false",
            "prompt_or_output_persisted": "false",
            "billing_mode": AGY_ADMISSION_BILLING_MODE,
            "smoke_command": AGY_ADMISSION_SMOKE_COMMAND,
            "smoke_returncode": "0",
            "smoke_stdout_validated": "true",
            "positive_admission": "true",
        }
        failed = False
        for key, value in expected.items():
            if fields.get(key, "") != value:
                reject(path, f"{key} missing or unsupported; expected {value}")
                failed = True
                break
        # Same first-failure-only contract as the loop above: one bad receipt
        # must count once, not once per broken field.
        if not failed and fields.get("model", "") not in AGY_ADMISSION_MODELS:
            reject(
                path,
                f"model missing or unsupported; expected {sorted(AGY_ADMISSION_MODELS)}",
            )
            failed = True
        if failed:
            continue
        receipt_evidence_ref = " ".join(fields.get("evidence_ref", "").strip().split())
        if (
            AGY_ADMISSION_EVIDENCE_REF_RE.fullmatch(receipt_evidence_ref) is None
            or AGY_ADMISSION_SECRETISH_RE.search(receipt_evidence_ref) is not None
        ):
            reject(path, "evidence_ref unsafe; expected sanitized agy smoke witness reference")
            continue
        observed_at = _parse_utc(fields.get("observed_at", "").strip())
        if observed_at is None:
            reject(path, "missing or malformed observed_at")
            continue
        if observed_at > now:
            reject(path, "observed_at is in the future")
            continue
        try:
            stale_after_seconds = int(fields.get("stale_after_seconds", "").strip())
        except ValueError:
            reject(path, "malformed stale_after_seconds")
            continue
        if stale_after_seconds <= 0:
            reject(path, "non-positive stale_after_seconds")
            continue
        if stale_after_seconds > AGY_ADMISSION_MAX_STALE_AFTER_SECONDS:
            reject(
                path,
                f"stale_after_seconds exceeds maximum {AGY_ADMISSION_MAX_STALE_AFTER_SECONDS}",
            )
            continue
        fresh_until = observed_at + timedelta(seconds=stale_after_seconds)
        if now >= fresh_until:
            reject(path, "receipt expired")
            continue
        refs.append(
            AgyAdmission(
                evidence_ref=(
                    "relay-receipt:"
                    f"{_receipt_label(path)}:witness:{receipt_evidence_ref}:"
                    f"supported_tool:{AGY_ADMISSION_SUPPORTED_TOOL}:"
                    # The observed model, not the pinned constant: two ids name
                    # this seat, and an evidence ref that renames what the
                    # receipt witnessed is not evidence.
                    f"model:{fields.get('model', '')}:"
                    f"observed_at:{observed_at.isoformat().replace('+00:00', 'Z')}:"
                    f"fresh_until:{fresh_until.isoformat().replace('+00:00', 'Z')}"
                ),
                fresh_until=fresh_until,
            )
        )
    return AgyAdmissionScan(admissions=refs, ignored_evidence_refs=ignored_refs)


def active_kimi_admission_receipts(
    receipt_dir: Path,
    *,
    now: datetime,
) -> AgyAdmissionScan:
    """Return fresh positive kimi interactive-lane admission evidence refs."""

    if not receipt_dir.is_dir():
        return AgyAdmissionScan(admissions=[], ignored_evidence_refs=[])
    refs: list[AgyAdmission] = []
    ignored_refs: list[str] = []

    def reject(path: Path, reason: str) -> None:
        ignored_refs.append(_warn_ignored_kimi_admission(path, reason))

    for path in sorted(receipt_dir.glob(KIMI_ADMISSION_RECEIPT_GLOB)):
        if KIMI_ADMISSION_SAFE_RECEIPT_NAME_RE.fullmatch(path.name) is None:
            reject(path, "unsafe receipt name")
            continue
        try:
            raw_receipt = path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError) as exc:
            reject(path, f"unreadable receipt {type(exc).__name__}")
            continue
        fields, parse_error = _parse_flat_yaml_strict(
            raw_receipt,
            allowed_fields=KIMI_ADMISSION_FIELDS,
        )
        if parse_error is not None:
            reject(path, parse_error)
            continue
        expected = {
            "schema": KIMI_ADMISSION_SCHEMA,
            "status": "quota_available",
            "provider": KIMI_ADMISSION_PROVIDER,
            "route_id": SUBSCRIPTION_ROUTES["kimi"],
            "capacity_pool": KIMI_ADMISSION_CAPACITY_POOL,
            "supported_tool": KIMI_ADMISSION_SUPPORTED_TOOL,
            "secret_source": KIMI_ADMISSION_SECRET_SOURCE,
            "secret_value_persisted": "false",  # pragma: allowlist secret
            "prompt_or_output_persisted": "false",
            "billing_mode": KIMI_ADMISSION_BILLING_MODE,
            "smoke_command": KIMI_ADMISSION_SMOKE_COMMAND,
            "smoke_returncode": "0",
            "smoke_stdout_validated": "true",
            "positive_admission": "true",
        }
        failed = False
        for key, value in expected.items():
            if fields.get(key, "") != value:
                reject(path, f"{key} missing or unsupported; expected {value}")
                failed = True
                break
        if not failed and fields.get("model", "") not in KIMI_ADMISSION_MODELS:
            reject(
                path,
                f"model missing or unsupported; expected {sorted(KIMI_ADMISSION_MODELS)}",
            )
            failed = True
        if failed:
            continue
        # The kimi receipt carries these four fields beyond the agy contract;
        # their VALUES must be pinned, or a malformed claim (e.g. a fabricated
        # quota fraction) would fold unchecked (GLM review finding, 2026-09-11).
        if fields.get("measurement", "") != "minimal_round_trip_liveness":
            reject(path, "measurement missing or unsupported; expected minimal_round_trip_liveness")
            continue
        digest = fields.get("output_digest_sha256", "")
        if not re.fullmatch(r"[0-9a-f]{64}", digest):
            reject(path, "output_digest_sha256 missing or malformed")
            continue
        if fields.get("quota_fraction", "") != "unobservable":
            reject(path, "quota_fraction missing or unsupported; expected unobservable")
            continue
        limits = fields.get("limits", "").strip()
        if not limits or KIMI_ADMISSION_SECRETISH_RE.search(limits) is not None:
            reject(path, "limits missing or unsafe")
            continue
        receipt_evidence_ref = " ".join(fields.get("evidence_ref", "").strip().split())
        if (
            KIMI_ADMISSION_EVIDENCE_REF_RE.fullmatch(receipt_evidence_ref) is None
            or KIMI_ADMISSION_SECRETISH_RE.search(receipt_evidence_ref) is not None
        ):
            reject(path, "evidence_ref unsafe; expected sanitized kimi smoke witness reference")
            continue
        observed_at = _parse_utc(fields.get("observed_at", "").strip())
        if observed_at is None:
            reject(path, "missing or malformed observed_at")
            continue
        if observed_at > now:
            reject(path, "observed_at is in the future")
            continue
        try:
            stale_after_seconds = int(fields.get("stale_after_seconds", "").strip())
        except ValueError:
            reject(path, "malformed stale_after_seconds")
            continue
        if stale_after_seconds <= 0:
            reject(path, "non-positive stale_after_seconds")
            continue
        if stale_after_seconds > KIMI_ADMISSION_MAX_STALE_AFTER_SECONDS:
            reject(
                path,
                f"stale_after_seconds exceeds maximum {KIMI_ADMISSION_MAX_STALE_AFTER_SECONDS}",
            )
            continue
        fresh_until = observed_at + timedelta(seconds=stale_after_seconds)
        if now >= fresh_until:
            reject(path, "receipt expired")
            continue
        refs.append(
            AgyAdmission(
                evidence_ref=(
                    "relay-receipt:"
                    f"{_receipt_label(path)}:witness:{receipt_evidence_ref}:"
                    f"supported_tool:{KIMI_ADMISSION_SUPPORTED_TOOL}:"
                    f"model:{fields.get('model', '')}:"
                    f"observed_at:{observed_at.isoformat().replace('+00:00', 'Z')}:"
                    f"fresh_until:{fresh_until.isoformat().replace('+00:00', 'Z')}"
                ),
                fresh_until=fresh_until,
            )
        )
    return AgyAdmissionScan(admissions=refs, ignored_evidence_refs=ignored_refs)


def active_claude_admission_receipts(
    receipt_dir: Path,
    *,
    now: datetime,
) -> ClaudeAdmissionScan:
    """Return fresh positive claude subscription-quota admission evidence refs.

    Account-live subscription quota is proven ONLY by a short-lived sanitized admission receipt
    (scripts/hapax-claude-subscription-quota-admission), NEVER by lane/tmux/session presence. Each
    fresh receipt yields a composite evidence ref ending in :account-live-quota:observed so the
    availability guarantor attests; a secretish or lane/session-shaped witness is refused.
    """

    if not receipt_dir.is_dir():
        return ClaudeAdmissionScan(admissions=[], ignored_evidence_refs=[])
    refs: list[ClaudeAdmission] = []
    ignored_refs: list[str] = []

    def reject(path: Path, reason: str, route_id: str | None = None) -> None:
        ignored_refs.append(_warn_ignored_claude_admission(path, reason, route_id))

    for path in sorted(receipt_dir.glob(CLAUDE_ADMISSION_RECEIPT_GLOB)):
        if CLAUDE_ADMISSION_SAFE_RECEIPT_NAME_RE.fullmatch(path.name) is None:
            reject(path, "unsafe receipt name")
            continue
        receipt_name_stem = path.name.removesuffix(".yaml")
        if CLAUDE_ADMISSION_SECRETISH_RE.search(receipt_name_stem) is not None:
            reject(path, "receipt name names secretish value")
            continue
        if CLAUDE_ADMISSION_BILLINGISH_RE.search(receipt_name_stem) is not None:
            reject(path, "receipt name names billing or account identifier")
            continue
        if CLAUDE_ADMISSION_LANE_PRESENCE_RE.search(receipt_name_stem) is not None:
            reject(path, "receipt name names lane/session presence")
            continue
        try:
            raw_receipt = path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError) as exc:
            reject(path, f"unreadable receipt {type(exc).__name__}")
            continue
        fields, parse_error = _parse_flat_yaml_strict(
            raw_receipt,
            allowed_fields=CLAUDE_ADMISSION_FIELDS,
        )
        if parse_error is not None:
            reject(path, parse_error)
            continue
        expected = {
            "schema": CLAUDE_ADMISSION_SCHEMA,
            "status": "quota_available",
            "provider": CLAUDE_ADMISSION_PROVIDER,
            "capacity_pool": CLAUDE_ADMISSION_CAPACITY_POOL,
            "auth_surface": CLAUDE_ADMISSION_AUTH_SURFACE,
            "secret_source": CLAUDE_ADMISSION_SECRET_SOURCE,
            "secret_value_persisted": "false",
            "prompt_or_output_persisted": "false",
            "billing_mode": CLAUDE_ADMISSION_BILLING_MODE,
            "account_live_quota_observed": "true",
            "lane_presence_used_as_quota_evidence": "false",
            "positive_admission": "true",
        }
        failed = False
        for key, value in expected.items():
            if fields.get(key, "") != value:
                reject(
                    path,
                    f"{key} missing or unsupported; expected {value}",
                    fields.get("route_id", "").strip(),
                )
                failed = True
                break
        if failed:
            continue
        route_id = fields.get("route_id", "").strip()
        if route_id not in CLAUDE_SUBSCRIPTION_ROUTES:
            reject(
                path,
                "route_id missing or unsupported; expected one of "
                + ", ".join(CLAUDE_SUBSCRIPTION_ROUTES),
                route_id,
            )
            continue
        observation = fields.get("observation", "").strip()
        if observation not in CLAUDE_ADMISSION_OBSERVATIONS:
            reject(path, "observation missing or unsupported", route_id)
            continue
        probe_environment_scrubbed = fields.get("probe_environment_scrubbed", "").strip()
        if (
            probe_environment_scrubbed
            and probe_environment_scrubbed != CLAUDE_ADMISSION_PROBE_ENV_SCRUBBED
        ):
            reject(path, "probe environment scrub disclosure missing or unsupported", route_id)
            continue
        receipt_evidence_ref = " ".join(fields.get("evidence_ref", "").strip().split())
        if (
            CLAUDE_ADMISSION_EVIDENCE_REF_RE.fullmatch(receipt_evidence_ref) is None
            or CLAUDE_ADMISSION_SECRETISH_RE.search(receipt_evidence_ref) is not None
        ):
            reject(
                path,
                "evidence_ref unsafe; expected sanitized account-live observation reference",
                route_id,
            )
            continue
        if CLAUDE_ADMISSION_BILLINGISH_RE.search(receipt_evidence_ref) is not None:
            reject(path, "evidence_ref names billing or account identifier", route_id)
            continue
        if CLAUDE_ADMISSION_LANE_PRESENCE_RE.search(receipt_evidence_ref) is not None:
            reject(
                path,
                "evidence_ref names lane/session presence; not account-live quota evidence",
                route_id,
            )
            continue
        if CLAUDE_ADMISSION_WITNESS_ALLOWLIST_RE.fullmatch(receipt_evidence_ref) is None:
            reject(
                path,
                "evidence_ref unsupported; expected claude subscription headroom witness reference",
                route_id,
            )
            continue
        observed_at = _parse_utc(fields.get("observed_at", "").strip())
        if observed_at is None:
            reject(path, "missing or malformed observed_at", route_id)
            continue
        if observed_at > now:
            reject(path, "observed_at is in the future", route_id)
            continue
        observed_at = _utc_seconds(observed_at)
        try:
            stale_after_seconds = int(fields.get("stale_after_seconds", "").strip())
        except ValueError:
            reject(path, "malformed stale_after_seconds", route_id)
            continue
        if stale_after_seconds <= 0:
            reject(path, "non-positive stale_after_seconds", route_id)
            continue
        if stale_after_seconds > CLAUDE_ADMISSION_MAX_STALE_AFTER_SECONDS:
            reject(
                path,
                f"stale_after_seconds exceeds maximum {CLAUDE_ADMISSION_MAX_STALE_AFTER_SECONDS}",
                route_id,
            )
            continue
        fresh_until = observed_at + timedelta(seconds=stale_after_seconds)
        if now >= fresh_until:
            reject(path, "receipt expired", route_id)
            continue
        refs.append(
            ClaudeAdmission(
                route_id=route_id,
                evidence_ref=(
                    "relay-receipt:"
                    f"{_receipt_label(path)}:witness:{receipt_evidence_ref}:"
                    f"observation:{observation}:"
                    f"observed_at:{_iso_z_seconds(observed_at)}:"
                    f"fresh_until:{_iso_z_seconds(fresh_until)}:"
                    f"{CLAUDE_ADMISSION_ACCOUNT_LIVE_QUOTA_SUFFIX}"
                ),
                observed_at=observed_at,
                fresh_until=fresh_until,
            )
        )
    return ClaudeAdmissionScan(admissions=refs, ignored_evidence_refs=ignored_refs)


def active_glmcp_admission_receipts(
    receipt_dir: Path,
    *,
    now: datetime,
) -> GlmcpAdmissionScan:
    """Return fresh positive GLMCP quota/admission receipt evidence refs.

    GLM Coding Plan Max is finite quota. Unlike wall-absence-fresh subscription
    snapshots, absence of a wall is not enough to call GLMCP fresh:
    a bakeoff or dispatcher must leave an explicit, time-bounded admission
    witness first. This keeps GLMCP fail-closed until a supported-tool witness
    exists, without making provider calls from this writer.
    """

    if not receipt_dir.is_dir():
        return GlmcpAdmissionScan(admissions=[], ignored_evidence_refs=[])
    refs: list[GlmcpAdmission] = []
    ignored_refs: list[str] = []

    def reject(path: Path, reason: str) -> None:
        ignored_refs.append(_warn_ignored_glmcp_admission(path, reason))

    for path in sorted(receipt_dir.glob(GLMCP_ADMISSION_RECEIPT_GLOB)):
        try:
            raw_receipt = path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError) as exc:
            reject(
                path,
                f"unreadable receipt {type(exc).__name__}",
            )
            continue
        fields, parse_error = _parse_flat_yaml_strict(raw_receipt)
        if parse_error is not None:
            reject(path, parse_error)
            continue
        status = fields.get("status", "")
        if status != "quota_available":
            reject(
                path,
                "status missing or unsupported; expected quota_available",
            )
            continue
        provider = fields.get("provider", "")
        if provider != GLMCP_ADMISSION_PROVIDER:
            if provider in {"z_ai", "z.ai", "zai"}:
                reject(
                    path,
                    f"provider ambiguous alias; expected {GLMCP_ADMISSION_PROVIDER}",
                )
            else:
                reject(
                    path,
                    f"provider missing or unsupported; expected {GLMCP_ADMISSION_PROVIDER}",
                )
            continue
        route_id = fields.get("route_id", "")
        if route_id != SUBSCRIPTION_ROUTES["glmcp"]:
            reject(
                path,
                f"route_id missing or unsupported; expected {SUBSCRIPTION_ROUTES['glmcp']}",
            )
            continue
        supported_tool = fields.get("supported_tool", "")
        if supported_tool not in GLMCP_ADMISSION_SUPPORTED_TOOLS:
            reject(
                path,
                "supported_tool missing or unsupported; expected supported Coding Plan tool",
            )
            continue
        endpoint = fields.get("endpoint", "")
        if endpoint not in GLMCP_ADMISSION_ENDPOINTS:
            reject(
                path,
                "endpoint missing or unsupported; expected official Z.ai Coding Plan or PAYG endpoint",
            )
            continue
        if endpoint not in GLMCP_ADMISSION_TOOL_ENDPOINTS[supported_tool]:
            reject(
                path,
                "supported_tool/endpoint mismatch; expected official endpoint for supported tool",
            )
            continue
        endpoint_contract = GLMCP_ADMISSION_CONTRACT_BY_ENDPOINT[endpoint]
        capacity_pool = fields.get("capacity_pool", "")
        if capacity_pool != endpoint_contract["capacity_pool"]:
            reject(
                path,
                "capacity_pool missing or unsupported for endpoint",
            )
            continue
        model = fields.get("model", "")
        if model not in GLMCP_ADMISSION_MODELS:
            reject(
                path,
                "model missing or unsupported; expected documented GLM review model id "
                "glm-5.3 or glm-5.2",
            )
            continue
        receipt_evidence_ref = fields.get("evidence_ref", "").strip()
        if not receipt_evidence_ref:
            reject(path, "evidence_ref missing")
            continue
        receipt_evidence_ref = " ".join(receipt_evidence_ref.split())
        if len(receipt_evidence_ref) > 240:
            reject(
                path,
                "evidence_ref unsafe; expected a sanitized witness reference, not raw secret material",
            )
            continue
        if (
            GLMCP_ADMISSION_EVIDENCE_REF_RE.fullmatch(receipt_evidence_ref) is None
            or GLMCP_ADMISSION_SECRETISH_RE.search(receipt_evidence_ref) is not None
        ):
            reject(
                path,
                "evidence_ref unsafe; expected a sanitized witness reference, not raw secret material",
            )
            continue
        if "captured_at" in fields or "detected_at" in fields:
            reject(
                path,
                "unsupported timestamp field; expected observed_at only",
            )
            continue
        observed_raw = fields.get("observed_at", "").strip()
        if not observed_raw:
            reject(path, "missing or malformed observed_at")
            continue
        observed_at = _parse_utc(observed_raw)
        if observed_at is None:
            reject(path, "missing or malformed observed_at")
            continue
        if observed_at > now:
            reject(path, "observed_at is in the future")
            continue
        stale_after_raw = fields.get("stale_after_seconds", "").strip()
        if not stale_after_raw:
            reject(path, "stale_after_seconds missing")
            continue
        try:
            stale_after_seconds = int(stale_after_raw)
        except ValueError:
            reject(
                path,
                "malformed stale_after_seconds",
            )
            continue
        if stale_after_seconds <= 0:
            reject(
                path,
                "non-positive stale_after_seconds",
            )
            continue
        if stale_after_seconds > GLMCP_ADMISSION_MAX_STALE_AFTER_SECONDS:
            reject(
                path,
                f"stale_after_seconds exceeds maximum {GLMCP_ADMISSION_MAX_STALE_AFTER_SECONDS}",
            )
            continue
        fresh_until = observed_at + timedelta(seconds=stale_after_seconds)
        if now >= fresh_until:
            reject(
                path,
                "receipt expired",
            )
            continue
        schema = fields.get("schema", "")
        if schema != GLMCP_ADMISSION_SCHEMA:
            reject(
                path,
                f"schema missing or unsupported; expected {GLMCP_ADMISSION_SCHEMA}",
            )
            continue
        if fields.get("secret_source", "") not in GLMCP_ADMISSION_SECRET_SOURCES:
            reject(path, "secret_source missing or unsupported")
            continue
        if fields.get("secret_value_persisted", "") != "false":
            reject(path, "secret_value_persisted must be false")
            continue
        if fields.get("prompt_or_output_persisted", "") != "false":
            reject(path, "prompt_or_output_persisted must be false")
            continue
        if fields.get("billing_mode", "") != endpoint_contract["billing_mode"]:
            reject(path, "billing_mode missing or unsupported for endpoint")
            continue
        if fields.get("payg_fallback", "") != endpoint_contract["payg_fallback"]:
            reject(path, "payg_fallback missing or unsupported for endpoint")
            continue
        primary_error_class = fields.get("primary_error_class", "").strip()
        quota_wall_evidence_ref = fields.get("quota_wall_evidence_ref", "").strip()
        if endpoint == GLMCP_PAYG_ENDPOINT:
            if primary_error_class not in GLMCP_PAYG_PRIMARY_ERROR_CLASSES:
                reject(
                    path,
                    "PAYG admission missing supported primary Coding Plan quota-wall class",
                )
                continue
            if (
                GLMCP_ADMISSION_EVIDENCE_REF_RE.fullmatch(quota_wall_evidence_ref) is None
                or GLMCP_ADMISSION_SECRETISH_RE.search(quota_wall_evidence_ref) is not None
            ):
                reject(
                    path,
                    "PAYG admission missing sanitized quota-wall evidence reference",
                )
                continue
        elif primary_error_class or quota_wall_evidence_ref:
            reject(path, "Coding Plan admission carried PAYG-only witness fields")
            continue
        refs.append(
            GlmcpAdmission(
                evidence_ref=(
                    "relay-receipt:"
                    f"{_receipt_label(path)}:witness:{receipt_evidence_ref}:"
                    f"supported_tool:{supported_tool}:endpoint:{endpoint}:model:{model}:"
                    + (
                        f"primary_error_class:{primary_error_class}:"
                        f"quota_wall_evidence_ref:{quota_wall_evidence_ref}:"
                        if endpoint == GLMCP_PAYG_ENDPOINT
                        else ""
                    )
                    + f"observed_at:{observed_at.isoformat().replace('+00:00', 'Z')}:"
                    f"fresh_until:{fresh_until.isoformat().replace('+00:00', 'Z')}"
                ),
                fresh_until=fresh_until,
                endpoint=endpoint,
                witness_ref=receipt_evidence_ref,
                primary_error_class=primary_error_class or None,
                quota_wall_evidence_ref=quota_wall_evidence_ref or None,
            )
        )
    return GlmcpAdmissionScan(admissions=refs, ignored_evidence_refs=ignored_refs)


def active_glmcp_payg_spend_receipts(
    receipt_dir: Path,
    *,
    base: QuotaSpendLedger,
    now: datetime,
) -> GlmcpPaygSpendScan:
    """Fold every GLMCP PAYG spend receipt file into budget accounting. Nothing is dropped.

    A receipt meeting the whole contract folds as written, or frozen when its identity is
    unverified (checked first; an unverified actual is never trusted), its reservation exceeds
    the task cap, or its actual exceeds the reservation. Any other file where a spend receipt
    belongs may still stand for a billed call: it folds as a normalized frozen placeholder
    (_untrusted_glmcp_payg_placeholder). A frozen receipt counts against the caps and refuses
    paid spend until a reviewed governance receipt of the same spend_id supersedes it.
    """

    if not receipt_dir.is_dir():
        return GlmcpPaygSpendScan(receipts=[], ignored_evidence_refs=[])
    receipts: list[SpendReceipt] = []
    ignored_refs: list[str] = []
    budget_by_id = {budget.budget_id: budget for budget in base.transition_budgets}
    glmcp_budgets = [
        budget
        for budget in base.transition_budgets
        if GLMCP_PAYG_BUDGET_PROFILE in budget.profiles_allowed
        and GLMCP_PAYG_BUDGET_PROVIDER in budget.providers_allowed
    ]
    frozen_at = _iso_z_seconds(now)
    seen_spend_ids: set[str] = set()

    def fold_untrusted(path: Path, raw: bytes, fields: dict[str, str], reasons: list[str]) -> None:
        placeholder = _untrusted_glmcp_payg_placeholder(
            path, raw, fields, reasons, glmcp_budgets=glmcp_budgets, now=now
        )
        _warn_frozen_glmcp_payg_spend(path, reasons, placeholder["spend_id"])
        receipts.append(SpendReceipt.model_validate(placeholder))

    for path in sorted(receipt_dir.glob(GLMCP_PAYG_SPEND_RECEIPT_GLOB)):
        try:
            raw = path.read_bytes()
        except OSError as exc:
            fold_untrusted(path, b"", {}, [f"unreadable receipt {type(exc).__name__}"])
            continue
        try:
            text = raw.decode("utf-8")
        except UnicodeDecodeError:
            fold_untrusted(path, raw, {}, ["receipt is not UTF-8 text"])
            continue
        fields, parse_error = _parse_flat_yaml_strict(
            text,
            allowed_fields=GLMCP_PAYG_SPEND_FIELDS,
        )
        if parse_error is not None:
            fold_untrusted(path, raw, {}, [parse_error])
            continue
        problems = _glmcp_payg_spend_contract_problems(fields, budget_by_id, now=now)
        spend_id = fields.get("spend_id", "")
        if not problems and spend_id in seen_spend_ids:
            problems.append("duplicate spend_id in another receipt file")
        if problems:
            fold_untrusted(path, raw, fields, problems)
            continue
        seen_spend_ids.add(spend_id)
        model = fields["model_or_engine"]
        budget = budget_by_id[fields["budget_id"]]
        estimated = Decimal(fields["estimated_cost_usd"])
        freeze_reasons: list[str] = []
        held = estimated
        actual = fields.get("actual_cost_usd", "")
        actual_is_countable = not _glmcp_payg_spend_field_is_nullish("actual_cost_usd", actual)
        model_id = fields.get("model_id", "")
        expected_model_id = GLMCP_MODEL_IDS.get(model)
        if expected_model_id is None or model_id != expected_model_id:
            # Identity first: an actual priced for an unknown model is not trusted at all.
            freeze_reasons.append(
                f"identity unverified: model_id {model_id or 'absent'} does not name {model}"
            )
            held = max(held, _glmcp_payg_usage_ceiling_from_fields(fields))
            if actual_is_countable:
                freeze_reasons.append("unverified actual not counted")
            actual_is_countable = False
        elif actual_is_countable and not GLMCP_PAYG_SPEND_COST_RE.fullmatch(actual):
            freeze_reasons.append("actual_cost_usd malformed")
            actual_is_countable = False
        elif actual_is_countable and Decimal(actual) > held:
            freeze_reasons.append(f"provider-reported actual {actual} exceeds the reservation")
            held = Decimal(actual)
        if estimated > budget.per_task_cap_usd:
            freeze_reasons.append("reservation exceeds the budget task cap")
        receipt_payload = {
            key: value
            for key, value in fields.items()
            if key
            in {
                "auth_surface",
                "authority_case",
                "budget_id",
                "capacity_pool",
                "cap_remaining_usd",
                "created_at",
                "effort",
                "estimated_cost_usd",
                "actual_cost_usd",
                "model_id",
                "model_or_engine",
                "provider",
                "quality_floor",
                "quality_preservation_reason",
                "quantization",
                "reconcile_by",
                "reconciliation_state",
                "reconciled_at",
                "reconciliation_reason",
                "route_id",
                "spend_id",
                "spend_reason",
                "support_artifact_authority",
                "task_hash",
                "task_id",
            }
            and not _glmcp_payg_spend_field_is_nullish(key, value)
        }
        task_hash = receipt_payload.get("task_hash")
        if isinstance(task_hash, str) and not GLMCP_PAYG_SPEND_TASK_HASH_RE.fullmatch(task_hash):
            _warn_stripped_glmcp_payg_spend_task_hash(path, task_hash)
            receipt_payload.pop("task_hash", None)
        if freeze_reasons:
            if not actual_is_countable:
                receipt_payload.pop("actual_cost_usd", None)
            receipt_payload = frozen_spend_receipt_payload(
                receipt_payload,
                count_usd=held,
                frozen_at=frozen_at,
                reason=(
                    "writer froze: "
                    + "; ".join(freeze_reasons)
                    + "; the higher figure counts against the caps; resolve with a reviewed "
                    "governance receipt of the same spend_id"
                ),
            )
            _warn_frozen_glmcp_payg_spend(path, freeze_reasons, spend_id)
        receipt_payload["spend_receipt_schema"] = 1
        try:
            receipts.append(SpendReceipt.model_validate(receipt_payload))
        except (ValueError, TypeError) as exc:
            seen_spend_ids.discard(spend_id)
            fold_untrusted(
                path, raw, fields, [f"invalid SpendReceipt contract {type(exc).__name__}"]
            )
    return GlmcpPaygSpendScan(receipts=receipts, ignored_evidence_refs=ignored_refs)


GLMCP_PAYG_SPEND_STATUSES = frozenset(
    {"spend_estimated", "spend_reconciled", "spend_frozen", "spend_failed"}
)
GLMCP_PAYG_SPEND_TASK_ID_RE = re.compile(r"\A[a-z0-9][a-z0-9_.:-]{0,199}\Z")
GLMCP_PAYG_UNATTRIBUTED_TASK_ID = "unattributed-glmcp-payg-spend"
GLMCP_PAYG_UNBUDGETED_BUDGET_ID = "tb-19700101-glmcp-payg-unbudgeted-spend"


def _unbudgeted_glmcp_payg_budget() -> TransitionBudget:
    """A retired, zero-cap GLMCP budget that holds spend found when no GLMCP budget existed.

    It admits nothing, but it matches the GLMCP PAYG route. A frozen receipt held on it refuses
    paid GLMCP spend on any budget added later until a reviewed receipt resolves that spend.
    """

    return TransitionBudget.model_validate(
        {
            "budget_schema": 1,
            "budget_id": GLMCP_PAYG_UNBUDGETED_BUDGET_ID,
            "authority_case": "unbudgeted-glmcp-payg-spend",
            "approved_by": "later_authority_packet",
            "created_at": "1970-01-01T00:00:00Z",
            "expires_at": "1970-01-02T00:00:00Z",
            "capacity_pool": GLMCP_ADMISSION_PAYG_CAPACITY_POOL,
            "providers_allowed": [GLMCP_PAYG_BUDGET_PROVIDER],
            "profiles_allowed": [GLMCP_PAYG_BUDGET_PROFILE],
            "task_classes_allowed": [GLMCP_PAYG_BUDGET_TASK_CLASS],
            "quality_floors_allowed": [GLMCP_PAYG_BUDGET_QUALITY_FLOOR],
            "total_cap_usd": "0",
            "per_task_cap_usd": "0",
            "daily_cap_usd": "0",
            "reason_subscription_path_not_used": (
                "synthetic: holds GLMCP PAYG spend receipts found when no GLMCP budget existed"
            ),
            "ledger_owner": "hapax-quota-telemetry-writer",
            "lifecycle_state": "retired",
        }
    )


def _glmcp_payg_spend_contract_problems(
    fields: dict[str, str],
    budget_by_id: dict[str, Any],
    *,
    now: datetime,
) -> list[str]:
    """Every way a receipt departs from the reviewer's spend-receipt contract (empty = trusted)."""

    expected = {
        "schema": GLMCP_PAYG_SPEND_RECEIPT_SCHEMA,
        "supported_tool": "hapax-glmcp-reviewer",
        "endpoint": GLMCP_PAYG_ENDPOINT,
        "billing_mode": "api_credit_payg",
        "payg_fallback": "true",
        "secret_value_persisted": "false",
        "prompt_or_output_persisted": "false",
        "route_id": "glmcp.review.direct",
        "capacity_pool": GLMCP_ADMISSION_PAYG_CAPACITY_POOL,
        "provider": GLMCP_PAYG_BUDGET_PROVIDER,
    }
    problems = [
        f"{key} missing or unsupported"
        for key, value in expected.items()
        if fields.get(key, "") != value
    ]
    if fields.get("status", "") not in GLMCP_PAYG_SPEND_STATUSES:
        problems.append("status missing or unsupported")
    if fields.get("secret_source", "") not in {"pass:glmcp/api-key", "filestore:glmcp/api-key"}:
        problems.append("secret_source missing or unsupported")
    if fields.get("primary_error_class", "") not in GLMCP_PAYG_PRIMARY_ERROR_CLASSES:
        problems.append("primary_error_class missing or unsupported")
    if fields.get("model_or_engine", "") not in GLMCP_ADMISSION_MODELS:
        problems.append("model_or_engine missing or unsupported")
    budget = budget_by_id.get(fields.get("budget_id", ""))
    if budget is None:
        problems.append("budget_id missing or unknown")
    elif fields.get("authority_case", "") != budget.authority_case:
        problems.append("authority_case does not match budget")
    estimated = fields.get("estimated_cost_usd", "")
    if not GLMCP_PAYG_SPEND_COST_RE.fullmatch(estimated) or Decimal(estimated) <= 0:
        problems.append("estimated_cost_usd missing or not a positive decimal")
    created_at = _parse_utc(fields.get("created_at", ""))
    if created_at is None:
        problems.append("created_at missing or malformed")
    elif created_at > now:
        problems.append("created_at is in the future")
    reconcile_by = _parse_utc(fields.get("reconcile_by", ""))
    if reconcile_by is None or (created_at is not None and reconcile_by <= created_at):
        problems.append("reconcile_by missing, malformed or not after created_at")
    if not GLMCP_PAYG_SPEND_TASK_ID_RE.fullmatch(fields.get("task_id", "")):
        problems.append("task_id missing or unsafe")
    spend_id = fields.get("spend_id", "")
    if re.fullmatch(r"spend-\d{8}T\d{6}Z-[a-z0-9_.:-]+", spend_id) is None:
        problems.append("spend_id missing or malformed")
    return problems


def _glmcp_payg_usage_ceiling_from_fields(fields: dict[str, str]) -> Decimal:
    prompt = fields.get("usage_prompt_tokens", "")
    completion = fields.get("usage_completion_tokens", "")
    if not (prompt.isdigit() and completion.isdigit()):
        return Decimal("0")
    return glmcp_payg_usage_ceiling_usd(
        prompt_tokens=int(prompt), completion_tokens=int(completion)
    )


def _untrusted_glmcp_payg_placeholder(
    path: Path,
    raw: bytes,
    fields: dict[str, str],
    reasons: list[str],
    *,
    glmcp_budgets: list[Any],
    now: datetime,
) -> dict[str, Any]:
    """A normalized frozen SpendReceipt payload for a receipt file that cannot be trusted.

    Only what can be vouched for is carried: an admitted model name, a safe task id, a
    countable reservation and a creation time no later than now. Everything else is fixed to
    the GLMCP PAYG route. The spend is attributed to the GLMCP budget named in the file, else
    the one whose window holds the creation time, else the latest, else (no GLMCP budget at
    all) the synthetic unbudgeted block, which refuses the route. It holds the largest of the
    file's reservation, the dearest-rate ceiling of its reported usage and, when nothing is
    countable, that budget's per-task cap. The id derives from the file's hash, so the same
    bytes map to the same record every tick. The writer prints it, and a governance receipt
    of that id supersedes it.
    """

    digest = hashlib.sha256(raw).hexdigest()
    created = _parse_utc(fields.get("created_at", ""))
    if created is None or created > now:
        try:
            created = min(datetime.fromtimestamp(path.stat().st_mtime, UTC), now)
        except OSError:
            created = now
    created = _utc_seconds(created)
    named = {budget.budget_id: budget for budget in glmcp_budgets}.get(fields.get("budget_id", ""))
    in_window = [b for b in glmcp_budgets if b.created_at <= created < b.expires_at]
    budget = named or (in_window[0] if in_window else None)
    if budget is None and glmcp_budgets:
        budget = max(glmcp_budgets, key=lambda b: b.created_at)
    if budget is None:
        budget = _unbudgeted_glmcp_payg_budget()
    candidates = [_glmcp_payg_usage_ceiling_from_fields(fields)]
    estimated = fields.get("estimated_cost_usd", "")
    if GLMCP_PAYG_SPEND_COST_RE.fullmatch(estimated) and Decimal(estimated) > 0:
        candidates.append(Decimal(estimated))
        basis = "its reservation or usage ceiling"
    elif budget.budget_id == GLMCP_PAYG_UNBUDGETED_BUDGET_ID:
        basis = "nothing countable and no budget; the unbudgeted block refuses the route"
    else:
        candidates.append(budget.per_task_cap_usd)
        basis = "no countable reservation, so the budget's per-task cap"
    held = max(candidates)
    model = fields.get("model_or_engine", "")
    task_id = fields.get("task_id", "")
    return {
        "spend_receipt_schema": 1,
        "spend_id": f"spend-{created:%Y%m%dT%H%M%SZ}-glmcp-payg-untrusted-{digest[:16]}",
        "task_id": task_id
        if GLMCP_PAYG_SPEND_TASK_ID_RE.fullmatch(task_id)
        else GLMCP_PAYG_UNATTRIBUTED_TASK_ID,
        "authority_case": budget.authority_case,
        "route_id": "glmcp.review.direct",
        "capacity_pool": GLMCP_ADMISSION_PAYG_CAPACITY_POOL,
        "budget_id": budget.budget_id,
        "provider": GLMCP_PAYG_BUDGET_PROVIDER,
        "model_or_engine": model if model in GLMCP_ADMISSION_MODELS else None,
        "model_id": None,
        "effort": "none",
        "quantization": "not_applicable",
        "auth_surface": "api_key",
        "quality_floor": GLMCP_PAYG_BUDGET_QUALITY_FLOOR,
        "quality_preservation_reason": "untrusted GLMCP PAYG spend receipt held frozen",
        "spend_reason": "quota_exhaustion",
        "estimated_cost_usd": str(held),
        "created_at": _iso_z_seconds(created),
        "reconcile_by": _iso_z_seconds(created + timedelta(days=1)),
        "reconciliation_state": "frozen_refused",
        "reconciled_at": _iso_z_seconds(now),
        "reconciliation_reason": (
            "writer froze untrusted receipt: "
            + "; ".join(_reason_code(reason) for reason in reasons)
            + f"; holds {held} ({basis}); resolve with a reviewed governance receipt of this "
            "spend_id"
        ),
        "artifact_refs": [f"relay-receipt:{_receipt_label(path)}:sha256:{digest}"],
        "support_artifact_authority": "none",
    }


def _ledger_with_glmcp_payg_spend_receipts(
    base: QuotaSpendLedger,
    receipts: list[SpendReceipt],
) -> QuotaSpendLedger:
    """Fold relay receipts into the governance base, then settle what a balance covers.

    A base governance receipt with the same spend_id supersedes the relay receipt: that is the
    reviewed resolution act for frozen spend. Settlement against provider balance evidence is
    the other resolution act, recorded on each receipt it applies to.
    """

    if not receipts:
        return settle_spend_covered_by_provider_balance(base)
    payload = base.model_dump(mode="json")
    existing_ids = {receipt["spend_id"] for receipt in payload["spend_receipts"]}
    new_receipts: list[dict[str, Any]] = []
    for receipt in receipts:
        if receipt.spend_id in existing_ids:
            continue
        existing_ids.add(receipt.spend_id)
        new_receipts.append(receipt.model_dump(mode="json"))
    payload["spend_receipts"] = [
        *payload["spend_receipts"],
        *new_receipts,
    ]
    budget_ids = {budget["budget_id"] for budget in payload["transition_budgets"]}
    if GLMCP_PAYG_UNBUDGETED_BUDGET_ID not in budget_ids and any(
        receipt["budget_id"] == GLMCP_PAYG_UNBUDGETED_BUDGET_ID for receipt in new_receipts
    ):
        payload["transition_budgets"].append(
            _unbudgeted_glmcp_payg_budget().model_dump(mode="json")
        )
    return settle_spend_covered_by_provider_balance(QuotaSpendLedger.model_validate(payload))


def probe_local_resource_state(*, nvidia_smi: str = "nvidia-smi") -> tuple[str, list[str]]:
    """Probe VRAM + load pressure; fail closed to unknown when unprobeable."""

    evidence: list[str] = []
    try:
        output = subprocess.run(
            [
                nvidia_smi,
                "--query-gpu=memory.used,memory.total",
                "--format=csv,noheader,nounits",
            ],
            capture_output=True,
            text=True,
            timeout=10,
            check=True,
        ).stdout
    except (OSError, subprocess.SubprocessError) as exc:
        return "unknown", [f"local:nvidia-smi:unavailable:{type(exc).__name__}"]

    worst_fraction = 0.0
    for line in output.strip().splitlines():
        parts = [part.strip() for part in line.split(",")]
        if len(parts) != 2:
            continue
        try:
            used, total = float(parts[0]), float(parts[1])
        except ValueError:
            continue
        if total > 0:
            worst_fraction = max(worst_fraction, used / total)
    evidence.append(f"local:nvidia-smi:vram-worst-fraction:{worst_fraction:.3f}")

    state = "green"
    if worst_fraction >= VRAM_RED_FRACTION:
        state = "red"
    elif worst_fraction >= VRAM_YELLOW_FRACTION:
        state = "yellow"

    try:
        load1 = os.getloadavg()[0]
        cpus = os.cpu_count() or 1
        load_per_cpu = load1 / cpus
        evidence.append(f"local:loadavg:per-cpu:{load_per_cpu:.2f}")
        if load_per_cpu >= LOAD_RED_PER_CPU:
            state = "red"
        elif load_per_cpu >= LOAD_YELLOW_PER_CPU and state == "green":
            state = "yellow"
    except OSError:
        evidence.append("local:loadavg:unavailable")

    return state, evidence


def build_live_ledger(
    base: QuotaSpendLedger,
    *,
    now: datetime,
    walls: dict[str, list[QuotaWall]],
    agy_admissions: list[AgyAdmission],
    agy_ignored_receipts: list[str],
    kimi_admissions: list[AgyAdmission],
    kimi_ignored_receipts: list[str],
    claude_admissions: list[ClaudeAdmission],
    claude_ignored_receipts: list[str],
    glmcp_admissions: list[GlmcpAdmission],
    glmcp_ignored_receipts: list[str],
    glmcp_payg_spend_receipts: list[SpendReceipt],
    glmcp_ignored_payg_spend_receipts: list[str],
    codex_auth_blocker: CodexAuthBlocker | None,
    local_resource_state: str,
    local_resource_evidence: list[str],
) -> QuotaSpendLedger:
    """Carry governance records over from base; re-derive telemetry live."""

    spend_base = _ledger_with_glmcp_payg_spend_receipts(base, glmcp_payg_spend_receipts)
    stamp = now.strftime("%Y%m%dT%H%M%SZ")
    # QuotaSnapshot ids must match ^quota-[a-z0-9_.:-]+$ — lowercase the stamp.
    snapshot_stamp = stamp.lower()
    writer_ref = "scripts/hapax-quota-telemetry-writer"

    snapshots: list[dict[str, Any]] = []
    for platform, route_id in sorted(SUBSCRIPTION_ROUTES.items()):
        platform_walls = walls.get(platform, [])
        platform_wall_evidence = [wall.evidence_ref for wall in platform_walls]
        agy_platform_admissions = [admission for admission in agy_admissions if platform == "agy"]
        kimi_platform_admissions = [
            admission for admission in kimi_admissions if platform == "kimi"
        ]
        claude_platform_admissions = [
            admission for admission in claude_admissions if platform == "claude"
        ]
        glmcp_payg_admissions = [
            admission
            for admission in glmcp_admissions
            if platform == "glmcp" and admission.endpoint == GLMCP_PAYG_ENDPOINT
        ]
        glmcp_wall_matched_payg_admissions = [
            admission
            for admission in glmcp_payg_admissions
            if _payg_admission_matches_active_wall(admission, platform_walls)
        ]
        glmcp_spend_bound_payg_admissions: list[tuple[GlmcpAdmission, SpendReceipt]] = []
        for admission in glmcp_wall_matched_payg_admissions:
            receipt = _payg_admission_matching_spend_receipt(
                admission,
                glmcp_payg_spend_receipts,
            )
            if receipt is not None:
                glmcp_spend_bound_payg_admissions.append((admission, receipt))
        glmcp_coding_plan_admissions = [
            admission
            for admission in glmcp_admissions
            if platform == "glmcp" and admission.endpoint == GLMCP_CODING_PLAN_ENDPOINT
        ]
        glmcp_payg_budget_decisions = [
            (
                admission,
                receipt,
                _glmcp_payg_budget_decision(spend_base, now=now, task_id=receipt.task_id),
            )
            for admission, receipt in glmcp_spend_bound_payg_admissions
        ]
        glmcp_eligible_payg_budget_decisions = [
            (admission, receipt, decision)
            for admission, receipt, decision in glmcp_payg_budget_decisions
            if decision.eligible
        ]
        glmcp_payg_budget_evidence = list(
            dict.fromkeys(
                evidence
                for _, _, decision in glmcp_payg_budget_decisions
                for evidence in _glmcp_payg_budget_evidence(decision)
            )
        )
        glmcp_payg_budget_reason = "; ".join(
            dict.fromkeys(
                _glmcp_payg_budget_reason(decision)
                for _, _, decision in glmcp_payg_budget_decisions
            )
        )
        if not glmcp_payg_budget_reason:
            glmcp_payg_budget_reason = (
                "PAYG fallback did not reach paid-spend gate because no matching "
                "task-bound spend receipt witness was available"
            )
        if platform == "agy":
            if agy_platform_admissions:
                state = "fresh"
                evidence = [
                    *(admission.evidence_ref for admission in agy_platform_admissions),
                    writer_ref,
                ]
                fresh_until = max(admission.fresh_until for admission in agy_platform_admissions)
                reason = (
                    "fresh agy supported-tool route admission receipt present; "
                    "agy.review.direct remains receipt-bounded and reviewer-only"
                )
            else:
                state = "unknown"
                evidence = (
                    [*agy_ignored_receipts, writer_ref]
                    if agy_ignored_receipts
                    else ["relay-receipt:agy:quota-admission:absent", writer_ref]
                )
                fresh_until = None
                reason = (
                    "no fresh agy route-specific quota admission receipt; agy.review.direct "
                    "must hold/backoff rather than dispatch blind"
                )
        elif platform == "kimi":
            if kimi_platform_admissions:
                state = "fresh"
                evidence = [
                    *(admission.evidence_ref for admission in kimi_platform_admissions),
                    writer_ref,
                ]
                fresh_until = max(admission.fresh_until for admission in kimi_platform_admissions)
                reason = (
                    "fresh kimi interactive-lane admission receipt present; "
                    "kimi.interactive.lane is availability-measured, not quota-fraction-measured"
                )
            else:
                state = "unknown"
                evidence = (
                    [*kimi_ignored_receipts, writer_ref]
                    if kimi_ignored_receipts
                    else ["relay-receipt:kimi:quota-admission:absent", writer_ref]
                )
                fresh_until = None
                reason = (
                    "no fresh kimi interactive-lane quota admission receipt; kimi exposes no "
                    "client-side quota fraction, so availability is the only measurable signal"
                )
        elif platform == "claude":
            for claude_route_id in CLAUDE_SUBSCRIPTION_ROUTES:
                route_walls = _claude_shared_pool_quota_walls(platform_walls, now=now)
                route_wall_evidence = [wall.evidence_ref for wall in route_walls]
                route_admissions = [
                    admission
                    for admission in claude_platform_admissions
                    if admission.route_id == claude_route_id
                ]
                after_wall_admissions = _claude_after_wall_admissions(
                    route_admissions,
                    route_walls,
                )
                route_ignored = _claude_ignored_receipts_for_route(
                    claude_ignored_receipts,
                    claude_route_id,
                )
                if route_walls and not after_wall_admissions:
                    state = "exhausted"
                    evidence = [*route_wall_evidence, writer_ref]
                    fresh_until = None
                    reason = (
                        f"{claude_route_id} is inhibited by an unexpired Claude subscription "
                        "quota wall on the shared account-level capacity pool; negative wall "
                        "evidence outranks stale or earlier positive headroom receipts"
                    )
                elif route_admissions:
                    accepted_admissions = after_wall_admissions or route_admissions
                    state = "fresh"
                    evidence = [
                        *(admission.evidence_ref for admission in accepted_admissions),
                        writer_ref,
                    ]
                    fresh_until = max(admission.fresh_until for admission in accepted_admissions)
                    if after_wall_admissions:
                        evidence.extend(route_wall_evidence)
                        reason = (
                            "fresh claude subscription-quota admission receipt observed after "
                            "the active shared-pool wall; "
                            f"{claude_route_id} account-live quota is receipt-bounded, "
                            "not lane/session presence"
                        )
                    else:
                        reason = (
                            "fresh claude subscription-quota admission receipt present; "
                            f"{claude_route_id} account-live quota is receipt-bounded, "
                            "not lane/session presence"
                        )
                else:
                    state = "unknown"
                    evidence = (
                        [*route_ignored, writer_ref]
                        if route_ignored
                        else [
                            f"relay-receipt:claude:quota-admission:{claude_route_id}:absent",
                            writer_ref,
                        ]
                    )
                    fresh_until = None
                    reason = (
                        "no fresh claude subscription-quota admission receipt; "
                        f"{claude_route_id} must hold rather than infer availability from "
                        "lane/session presence"
                    )
                snapshot = {
                    "quota_snapshot_schema": 1,
                    "snapshot_id": (
                        f"quota-{claude_route_id.replace('.', '-')}-live-{snapshot_stamp}"
                    ),
                    "captured_at": now.isoformat().replace("+00:00", "Z"),
                    "route_id": claude_route_id,
                    "provider": SUBSCRIPTION_PROVIDERS["claude"],
                    "capacity_pool": "subscription_quota",
                    "subscription_quota_state": state,
                    "evidence_refs": evidence,
                    "operator_visible_reason": reason,
                }
                if fresh_until is not None:
                    snapshot["fresh_until"] = _iso_z_seconds(fresh_until)
                snapshots.append(snapshot)
            continue
        elif platform_walls and glmcp_eligible_payg_budget_decisions:
            state = "fresh"
            eligible_admissions = [
                admission for admission, _, _ in glmcp_eligible_payg_budget_decisions
            ]
            evidence = [
                *platform_wall_evidence,
                *(admission.evidence_ref for admission in eligible_admissions),
                *(
                    f"spend-gate-payg-receipt:{admission.witness_ref}"
                    for admission in eligible_admissions
                ),
                *glmcp_payg_budget_evidence,
                writer_ref,
            ]
            fresh_until = max(admission.fresh_until for admission in eligible_admissions)
            reason = (
                "GLMCP Coding Plan quota wall is present, but a fresh API-credit PAYG "
                "supported-tool admission receipt, validated spend receipt reservation, and "
                "paid-spend gate keep the review route available. " + glmcp_payg_budget_reason
            )
        elif platform_walls and glmcp_payg_admissions:
            spend_receipt_blocker = []
            if glmcp_wall_matched_payg_admissions and not glmcp_spend_bound_payg_admissions:
                spend_receipt_blocker.append(
                    "spend-gate-blocker:validated-payg-spend-receipt-absent"
                )
            state = "exhausted"
            evidence = [
                *platform_wall_evidence,
                *(admission.evidence_ref for admission in glmcp_payg_admissions),
                *glmcp_payg_budget_evidence,
                *spend_receipt_blocker,
                writer_ref,
            ]
            fresh_until = None
            reason = (
                "GLMCP Coding Plan quota wall is present, and PAYG admission cannot supersede "
                "it without a matching active quota-wall witness, validated PAYG spend receipt "
                "reservation, and active paid-spend gate. " + glmcp_payg_budget_reason
            )
        elif platform_walls:
            state = "exhausted"
            evidence = [*platform_wall_evidence, writer_ref]
            fresh_until = None
            reason = (
                f"{platform} subscription lane hit an unexpired quota wall; "
                "state from quota-wall relay receipt(s)"
            )
        elif platform == "glmcp":
            if glmcp_coding_plan_admissions:
                state = "fresh"
                evidence = [
                    *(admission.evidence_ref for admission in glmcp_coding_plan_admissions),
                    writer_ref,
                ]
                fresh_until = max(
                    admission.fresh_until for admission in glmcp_coding_plan_admissions
                )
                reason = (
                    "fresh GLMCP supported-tool quota admission receipt present; "
                    "GLM Coding Plan Max remains finite and receipt-bounded"
                )
            elif glmcp_payg_admissions:
                state = "unknown"
                evidence = [
                    *(admission.evidence_ref for admission in glmcp_payg_admissions),
                    *glmcp_payg_budget_evidence,
                    writer_ref,
                ]
                reason = (
                    "GLMCP PAYG admission receipt was present without an active Coding Plan "
                    "quota-wall witness; PAYG cannot be treated as the primary rail and "
                    "unknown quota must hold/backoff. " + glmcp_payg_budget_reason
                )
                fresh_until = None
            else:
                state = "unknown"
                if glmcp_ignored_receipts:
                    evidence = [
                        *glmcp_ignored_receipts,
                        *glmcp_ignored_payg_spend_receipts,
                        writer_ref,
                    ]
                    reason = (
                        "GLMCP quota admission receipt(s) were present but rejected; "
                        "GLM Coding Plan Max is finite and rejected evidence must "
                        "hold/backoff rather than dispatch blind"
                    )
                else:
                    evidence = [
                        "relay-receipt:glmcp:quota-admission:absent",
                        *glmcp_ignored_payg_spend_receipts,
                        writer_ref,
                    ]
                    reason = (
                        "no fresh GLMCP quota admission receipt; GLM Coding Plan Max is finite "
                        "and unknown quota must hold/backoff rather than dispatch blind"
                    )
                fresh_until = None
        elif platform == "codex" and codex_auth_blocker is not None:
            state = "unknown"
            evidence = [
                *codex_auth_blocker.evidence_refs,
                *(f"codex-auth-blocker:{reason}" for reason in codex_auth_blocker.reason_codes),
                writer_ref,
            ]
            fresh_until = None
            reason = (
                "Codex saved-login exec auth receipt is blocked "
                f"({', '.join(codex_auth_blocker.reason_codes)}); "
                "repair saved Codex login on the dispatch host via codex login or the "
                "documented auth-cache transfer fallback, then rerun platform capability "
                "receipts before dispatching Codex lanes"
            )
        else:
            state = "fresh"
            evidence = [f"relay-receipt:{platform}:quota-wall:absent", writer_ref]
            fresh_until = None
            reason = (
                f"no unexpired quota-wall relay receipt for {platform}; "
                "subscription lanes observed dispatchable"
            )
        snapshot = {
            "quota_snapshot_schema": 1,
            "snapshot_id": f"quota-{platform}-subscription-live-{snapshot_stamp}",
            "captured_at": now.isoformat().replace("+00:00", "Z"),
            "route_id": route_id,
            "provider": SUBSCRIPTION_PROVIDERS.get(platform, f"{platform}-subscription"),
            "capacity_pool": "subscription_quota",
            "subscription_quota_state": state,
            "evidence_refs": evidence,
            "operator_visible_reason": reason,
        }
        if fresh_until is not None:
            snapshot["fresh_until"] = _iso_z_seconds(fresh_until)
        snapshots.append(snapshot)

    snapshots.append(
        {
            "quota_snapshot_schema": 1,
            "snapshot_id": f"quota-local-compute-live-{snapshot_stamp}",
            "captured_at": now.isoformat().replace("+00:00", "Z"),
            "route_id": LOCAL_COMPUTE_ROUTE,
            "provider": LOCAL_COMPUTE_PROVIDER,
            "capacity_pool": "local_compute",
            "subscription_quota_state": "fresh" if local_resource_state != "unknown" else "unknown",
            "evidence_refs": [*local_resource_evidence, writer_ref],
            "operator_visible_reason": (
                f"local compute resource probe -> {local_resource_state}; "
                "local routes are resource-bound, not quota-bound"
            ),
        }
    )

    base_payload = spend_base.model_dump(mode="json")
    generated_from = list(dict.fromkeys([*base_payload["generated_from"], writer_ref]))
    evidence_refs = list(dict.fromkeys([*base_payload["evidence_refs"], writer_ref]))
    payload = {
        **base_payload,
        "ledger_id": f"quota-spend-ledger-live-{stamp}",
        "captured_at": now.isoformat().replace("+00:00", "Z"),
        "generated_from": generated_from,
        "evidence_refs": evidence_refs,
        "local_resource_state": local_resource_state,
        "quota_snapshots": snapshots,
    }
    return QuotaSpendLedger.model_validate(payload)


def write_ledger_atomic(ledger: QuotaSpendLedger, path: Path, *, schema_version: int = 1) -> None:
    """Replace ``path`` atomically. The default is the strict-v1 projection every live reader
    accepts; schema 2 is written only when a caller asks for it."""
    path.parent.mkdir(parents=True, exist_ok=True)
    data = ledger.schema_v1_payload() if schema_version == 1 else ledger.model_dump(mode="json")
    payload = json.dumps(data, indent=1, sort_keys=True) + "\n"
    fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(payload)
        os.chmod(tmp_name, 0o600)
        os.replace(tmp_name, path)
    except BaseException:
        Path(tmp_name).unlink(missing_ok=True)
        raise


class LiveLedgerLockTimeout(RuntimeError):
    """The live-ledger lock stayed held past the bounded wait (round 4, claude-3)."""


@contextmanager
def quota_spend_live_lock(path: Path, *, wait_s: float = LIVE_LEDGER_LOCK_WAIT_S) -> Any:
    lock_path = path.with_name(f"{path.name}.lock")
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with lock_path.open("a", encoding="utf-8") as lock_file:
        # LOCK_NB with a bounded retry, mirroring determine's producer lock:
        # this was the last unbounded wait in the tick. A holder that outlives
        # the wait raises LiveLedgerLockTimeout — the caller exits nonzero
        # with next actions instead of hanging into the unit's kill timeout.
        # The retry interval is read from the module global at call time so
        # tests can shrink it.
        interval = LIVE_LEDGER_LOCK_RETRY_INTERVAL_S
        deadline = monotonic_clock() + wait_s
        while True:
            try:
                fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                remaining = deadline - monotonic_clock()
                if remaining <= 0:
                    raise LiveLedgerLockTimeout(
                        f"live ledger lock {lock_path} held longer than the {wait_s:.0f}s wait"
                    ) from None
                time.sleep(min(interval, remaining))
        try:
            yield
        finally:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)


def _previous_agy_promise(out_path: Path) -> datetime | None:
    """The max pull-forward ``fresh_until`` the currently published ledger promises.

    Scans the route-id prefixes DERIVED from
    ``QUOTA_SURFACE_PULL_FORWARD_PRODUCER_IDS`` (agy today), so the continuity
    witness always covers exactly the producers the pull-forward can mint
    for — widening the constant widens this scan with it (claude-1 minor,
    #4665 round 6).

    Continuity is judged against what the PREVIOUS publication actually
    promised, not against what this tick re-derives: a tick may spend
    arbitrarily long before publication while every per-tick predicate stays
    green, and only the previously published admission's expiry can witness
    the coverage gap (critical finding on #4665, round 5, C2). Read once,
    before the reading publication's write replaces the file;
    unreadable/absent/pull-forward-less ledgers return None (cold start — no
    promise was made, so no gap is asserted).
    """
    try:
        ledger = json.loads(out_path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    if not isinstance(ledger, dict):
        return None
    best: datetime | None = None
    for snap in ledger.get("quota_snapshots") or []:
        if not isinstance(snap, dict):
            continue
        if not str(snap.get("route_id") or "").startswith(
            QUOTA_SURFACE_PULL_FORWARD_ROUTE_PREFIXES
        ):
            continue
        fresh = _parse_utc(str(snap.get("fresh_until") or ""))
        if fresh is not None and (best is None or fresh > best):
            best = fresh
    return best


def pull_forward_force_needed(receipt_dir: Path, *, now: datetime) -> bool:
    """Would the agy admission embedded by this tick lapse before the NEXT publication?

    The exit predicate the whole pull-forward exists to enforce: the ledger
    written now must stay fresh until the next write lands — one cycle out,
    slipped by the timer's accuracy, plus the next tick's bounded pre-write
    work (see ``FRESHNESS_HORIZON_S``). Derived from the receipt's own
    ``fresh_until``, never from a measured timer phase, which ``AccuracySec``
    walks across (critical findings on #4665, rounds 2 and 3: first a fixed
    30s due-window left a 560s-old admission unpulled, then a 615s horizon
    accepted 620s-remaining against a +640s slipped fire and a 27s publish —
    a 47s flap).
    """

    scan = active_agy_admission_receipts(receipt_dir, now=now)
    if not scan.admissions:
        return True
    horizon = now + timedelta(seconds=FRESHNESS_HORIZON_S)
    return max(a.fresh_until for a in scan.admissions) < horizon


def pull_forward_due_producers(
    *,
    repo_root: Path,
    receipt_dir: Path,
    now: datetime,
    timeout: float = PULL_FORWARD_TIMEOUT_S,
) -> dict[str, Any]:
    """Run the determination producers feeding the quota surfaces before reading them.

    Invokes the same harness and per-producer lock as the determine timer. The
    cadence gate stays in charge of HOW MANY runs happen per window (the run
    ledger's ``ran_at`` aging); ``--force`` is added only when the freshness
    predicate above says the embedded receipt will not survive the next write,
    which shifts WHEN a needed run happens, never the count — a determine-timer
    fire later in the same window re-reads the fresh ``ran_at`` and skips.

    Degrades, never aborts: on timeout or failure the tick proceeds with
    whatever receipts exist — exactly the pre-repair behavior, never worse,
    sometimes stale — and the returned skip reasons let the caller report the
    degradation instead of presenting it as success (major finding on #4665,
    round 2).
    """

    script = repo_root / "scripts" / "hapax-determine"
    info: dict[str, Any] = {
        "invoked": True,
        "forced": False,
        "ran": [],
        "skipped": [],
        "ok": True,
        "scan_elapsed_s": None,
        "scan_bound_s": PRE_MINT_SCAN_BOUND_S,
    }
    # The force-decision scan runs BEFORE the mint, so neither the mint's run
    # anchor nor the publication measurement can see its duration; it is timed
    # here against its own bound and reported, and the bound is part of
    # FRESHNESS_HORIZON_S for the next tick (critical finding on #4665, round
    # 5, C2: an unbudgeted 110s scan let a tick publish 30s past the previous
    # admission's expiry while both freshness predicates read green).
    scan_mono_started = monotonic_clock()
    force = pull_forward_force_needed(receipt_dir, now=now)
    info["scan_elapsed_s"] = round(monotonic_clock() - scan_mono_started, 2)
    info["forced"] = force
    for producer_id in QUOTA_SURFACE_PULL_FORWARD_PRODUCER_IDS:
        argv = [
            sys.executable,
            str(script),
            "--producer",
            producer_id,
            "--lock-wait",
            str(PULL_FORWARD_LOCK_WAIT_S),
            "--timeout",
            str(int(PULL_FORWARD_PRODUCER_TIMEOUT_S)),
        ]
        if force:
            argv.append("--force")
            # The decision moment travels with the force so the producer lock
            # can revalidate it: a winner run that completed after this instant
            # cannot have been counted by the pre-lock scan, so the in-lock
            # read skips the forced run as superseded instead of duplicating
            # it (major finding on #4665, round 3).
            argv.extend(("--force-justified-at", now.isoformat().replace("+00:00", "Z")))
        argv.append("--json")
        try:
            result = subprocess.run(
                argv,
                capture_output=True,
                text=True,
                timeout=timeout,
            )
        except subprocess.TimeoutExpired:
            print(
                "hapax-quota-telemetry-writer: producer pull-forward timed out "
                f"({producer_id}) after {timeout:.0f}s; continuing with existing receipts. "
                f"Next: scripts/hapax-determine --producer {producer_id} --check --json "
                "to see whether the producer is wedged mid-run, and journalctl --user -u "
                "hapax-determine.service for the concurrent fire.",
                file=sys.stderr,
            )
            info["ok"] = False
            continue
        except (OSError, subprocess.SubprocessError) as exc:
            print(
                "hapax-quota-telemetry-writer: producer pull-forward could not run "
                f"({producer_id}): {exc}; continuing with existing receipts. "
                f"Next: verify {script} is present and executable in this checkout "
                "(`ls -l scripts/hapax-determine`) — no provider state was touched.",
                file=sys.stderr,
            )
            info["ok"] = False
            continue
        if result.returncode != 0:
            print(
                "hapax-quota-telemetry-writer: producer pull-forward failed "
                f"({producer_id}) rc={result.returncode}: "
                f"{(result.stderr or result.stdout).strip()[:400]}; "
                "continuing with existing receipts. "
                f"Next: scripts/hapax-determine --producer {producer_id} --json to "
                "reproduce the producer failure outside the telemetry tick.",
                file=sys.stderr,
            )
            info["ok"] = False
            continue
        try:
            determine_payload = json.loads(result.stdout)
        except ValueError:
            determine_payload = None
        if not isinstance(determine_payload, dict):
            # rc=0 but unparseable — or parseable-but-not-an-object (a bare
            # list or string parses as JSON yet carries no ran/skipped
            # structure) — is a degraded pull, not a green one: the child ran,
            # said nothing usable, and the tick continues on existing
            # receipts — silently keeping ok=True here hid the harness
            # breakage entirely (round 4 codex-2 test finding; round 5
            # claude-1 minor closed the parsed-but-not-dict gap).
            print(
                "hapax-quota-telemetry-writer: producer pull-forward output was "
                f"not a JSON object ({producer_id}); continuing with existing "
                "receipts. Next: scripts/hapax-determine --producer "
                f"{producer_id} --json to reproduce and inspect the harness output.",
                file=sys.stderr,
            )
            info["ok"] = False
        if isinstance(determine_payload, dict):
            info["ran"].extend(
                entry.get("producer_id", producer_id)
                for entry in determine_payload.get("ran", [])
                if isinstance(entry, dict)
            )
            for entry in determine_payload.get("skipped", []):
                if not isinstance(entry, dict):
                    continue
                reason = entry.get("reason", "unknown")
                info["skipped"].append(
                    {"producer_id": entry.get("producer_id", producer_id), "reason": reason}
                )
                if reason == "lock_timeout":
                    # A healthy concurrent winner holding the lock is the expected
                    # collision when the pull and the determine timer cross phases;
                    # whether it MATTERED is decided by the post-write freshness
                    # check, not by this skip alone (major finding on #4665, round 2).
                    print(
                        "hapax-quota-telemetry-writer: producer pull-forward deferred — "
                        f"lock held by a concurrent determine fire ({producer_id}, waited "
                        f"{entry.get('waited_s', PULL_FORWARD_LOCK_WAIT_S):.0f}s). The "
                        "freshness check after the ledger write reports whether this "
                        "tick's embedded receipt still covers the next write. Next: "
                        "journalctl --user -u hapax-determine.service for the holder.",
                        file=sys.stderr,
                    )
    return info


def refresh_capability_receipts(*, timeout: float, receipt_dir: Path) -> bool:
    """Refresh per-provider capability receipts; failure degrades, not aborts."""

    script = REPO_ROOT / "scripts" / "hapax-platform-capability-receipts"
    outer_timeout = max(timeout * 3, timeout + 15)
    try:
        result = subprocess.run(
            [
                sys.executable,
                str(script),
                "--all",
                "--codex-exec-auth-probe",
                "--timeout",
                str(timeout),
                "--receipt-dir",
                str(receipt_dir),
            ],
            capture_output=True,
            text=True,
            timeout=outer_timeout,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        print(
            f"hapax-quota-telemetry-writer: receipt refresh failed: {exc}. "
            "Next: rerun scripts/hapax-platform-capability-receipts --all "
            f"--receipt-dir {receipt_dir} by hand to surface the spawn failure; "
            "the live ledger below is built from existing receipts.",
            file=sys.stderr,
        )
        return False
    if result.returncode != 0:
        print(
            f"hapax-quota-telemetry-writer: receipt refresh failed rc={result.returncode}: "
            f"{(result.stderr or result.stdout).strip()[:400]}. "
            "Next: scripts/hapax-platform-capability-receipts --all "
            f"--receipt-dir {receipt_dir} to reproduce the failure outside the "
            "telemetry tick.",
            file=sys.stderr,
        )
        return False
    return True


_static_registry_route_pools_cache: dict[str, tuple[CapacityPool, QuotaSource]] | None = None
_static_registry_route_pools_state = "unloaded"


def static_registry_route_pools_loaded() -> bool:
    """Did the static registry load? The fail-closed {} is otherwise invisible.

    A registry load failure degrades every expiry to the quota TTL with only a
    stderr note (claude-1 minor, #4665 round 10): the --json summary reports
    this flag beside the gap witnesses so the machine-checkable surface can
    tell "fail-closed because the registry did not load" from "pools loaded,
    receipts genuinely bound at the quota TTL".
    """
    return _static_registry_route_pools_state == "loaded"


def static_registry_route_pools() -> dict[str, tuple[CapacityPool, QuotaSource]]:
    """route_id -> (capacity_pool, telemetry quota source) from the static registry.

    Loaded once per process with apply_receipts=False: pools and telemetry
    sources are static registry facts, deliberately not receipt-applied state.
    A registry that fails to load yields {} — every receipt then fails closed
    to the quota TTL, which can only tighten the witness, never loosen it.
    """
    global _static_registry_route_pools_cache, _static_registry_route_pools_state
    if _static_registry_route_pools_cache is None:
        try:
            registry = PlatformCapabilityRegistry.model_validate(
                json.loads(PLATFORM_CAPABILITY_REGISTRY.read_text(encoding="utf-8"))
            )
            _static_registry_route_pools_cache = {
                route.route_id: (route.capacity_pool, route.telemetry.quota_source)
                for route in registry.routes
            }
            _static_registry_route_pools_state = "loaded"
        except (OSError, json.JSONDecodeError, PlatformCapabilityRegistryError) as exc:
            print(
                "hapax-quota-telemetry-writer: static capability registry unavailable "
                f"({exc}); receipt-surface expiries fail closed to the quota TTL. "
                "Next: validate config/platform-capability-registry.json with "
                "scripts/hapax-platform-capability-receipts --all.",
                file=sys.stderr,
            )
            _static_registry_route_pools_cache = {}
            _static_registry_route_pools_state = "failed"
    return _static_registry_route_pools_cache


def receipt_surface_effective_expiry(
    receipt: PlatformCapabilityReceipt,
    route_pools: dict[str, tuple[CapacityPool, QuotaSource]],
) -> datetime:
    """The instant quota routing stops vouching for this receipt's quota surface.

    Mirrors the routing consumer (_apply_receipt_to_route_payload +
    _quota_unobservable_nonblocking in shared.platform_capability_registry)
    by CALLING it: the quota surface a route consumes from this receipt
    expires at observed_at + quota.stale_after, except when the receipt's
    quota is UNOBSERVABLE for exactly the nonblocking reasons with capability
    and resource OBSERVED — then routes whose pool carries quota authority
    without a local probe (subscription_quota, or the gateway pools under the
    ledger quota source) vouch for the full outer stale_after. The status
    inputs to that decision are the PER-ROUTE statuses routing recomputes
    from the receipt's route_wrappers (codex-1 major M1, #4665 round 14:
    with observed platform statuses, eligible unobservable quota, and an
    unreadable named route wrapper, routing recomputes the capability status
    to blocked, fails the nonblocking test, and applies the quota TTL — while
    receipt-level statuses granted the 24h envelope and read a fictitious
    −85440s green gap across a real 60s hole). Receipts without route
    wrappers pass their receipt-level reasons through unchanged, exactly as
    routing does. Receipts bind only the routes they name; the earliest
    per-route expiry binds the platform, so one non-qualifying named route
    holds the whole platform at the shorter TTL. Named routes absent from
    the registry are ignored; a receipt naming no registry route fails
    closed to the quota TTL. Every quota-TTL branch is capped at the OUTER
    stale_after: routing's loader rejects an expired envelope before applying
    any quota evidence, so the quota surface can never outlive the receipt
    it rides in (codex-1 critical C1, #4665 round 12; found independently by
    glm-1 and claude-1 — live shapes are envelope-longer, so the cap only
    tightens pathological ones).
    """
    observed_at = ensure_utc(receipt.observed_at)
    quota_ttl = parse_duration_spec(receipt.quota.stale_after)
    outer_ttl = parse_duration_spec(receipt.stale_after)
    if receipt.quota.status is not EvidenceStatus.UNOBSERVABLE:
        return observed_at + min(quota_ttl, outer_ttl)
    route_expiries = [
        _route_quota_surface_expiry(
            receipt,
            route_id,
            pool,
            source,
            observed_at=observed_at,
            quota_ttl=quota_ttl,
            outer_ttl=outer_ttl,
        )
        for route_id, (pool, source) in route_pools.items()
        if route_id in receipt.routes
    ]
    if not route_expiries:
        return observed_at + min(quota_ttl, outer_ttl)
    return min(route_expiries)


def _route_quota_surface_expiry(
    receipt: PlatformCapabilityReceipt,
    route_id: str,
    pool: CapacityPool,
    source: QuotaSource,
    *,
    observed_at: datetime,
    quota_ttl: timedelta,
    outer_ttl: timedelta,
) -> datetime:
    """One named route's expiry under routing's own recomputation.

    Builds the minimal route payload _quota_unobservable_nonblocking and
    _route_wrapper_for_receipt actually read (route_id, capacity_pool,
    telemetry.quota_source) from the registry pool fact, recomputes the
    per-route capability/resource statuses exactly as
    _apply_receipt_to_route_payload does, and applies the same envelope
    decision with them. Calling the consumer's own helpers — not a re-derivation
    — is what makes the mirror drift-proof.
    """
    route_payload: dict[str, Any] = {
        "route_id": route_id,
        "capacity_pool": pool.value,
        "telemetry": {"quota_source": source.value},
    }
    wrapper = _route_wrapper_for_receipt(route_payload, receipt)
    capability_status = _surface_status_from_reasons(
        receipt.capability.status,
        _route_receipt_capability_reason_codes(receipt, wrapper),
    )
    resource_status = _surface_status_from_reasons(
        receipt.resource.status,
        _route_receipt_resource_reason_codes(receipt, wrapper),
    )
    if _quota_unobservable_nonblocking(
        route_payload,
        receipt,
        capability_status=capability_status,
        resource_status=resource_status,
    ):
        return observed_at + outer_ttl
    return observed_at + min(quota_ttl, outer_ttl)


#: The future-dating window receipt_is_fresh applies (shared/platform_capability_receipts.py:
#: a receipt observed further ahead than this is rejected as evidence). The scan
#: reuses the window for fallback admissibility and for the instant a selected
#: receipt becomes routable; a consistency pin against receipt_is_fresh itself
#: lives in tests/scripts/test_hapax_quota_telemetry_writer.py.
FUTURE_DATING_TOLERANCE = timedelta(minutes=1)


class _ReceiptSurfaceEvidence(NamedTuple):
    """One parseable receipt's quota interval plus routing's outer eligibility.

    ``expiry`` is the quota surface death (receipt_surface_effective_expiry).
    ``eligible_until`` is observed_at + outer stale_after — the closed bound
    receipt_is_fresh uses. Routing selects among currently eligible receipts
    by greatest observed_at; a shadowed sibling's longer quota TTL is not
    coverage while it is not selected (codex-1 critical C1, #4665 round 18).
    """

    observed_at: datetime
    expiry: datetime
    routable_from: datetime
    path: Path
    eligible_until: datetime


def _mtime_utc(path: Path) -> datetime:
    """File mtime as UTC datetime, keeping microsecond precision.

    ``st_mtime`` is a float and can drop sub-seconds; ``st_mtime_ns`` is the
    stamp the scan compares against the scan clock (codex-1 critical C2,
    #4665 round 18).
    """
    ns = path.stat().st_mtime_ns
    return datetime(1970, 1, 1, tzinfo=UTC) + timedelta(microseconds=ns // 1_000)


def _receipt_routable_from(
    observed_at: datetime,
    path: Path,
    checked_now: datetime,
) -> datetime:
    """Instant this receipt file starts vouching at ``checked_now``.

    Later of the file mtime and observed_at minus FUTURE_DATING_TOLERANCE.
    An mtime beyond the scan clock is not a vouchable landing: far-future
    stamps (fixture residue, severe skew) fall back to the admissibility
    bound, but a landing only slightly past the scan — same-second
    truncation, NFS sub-second skew — keeps the file's own mtime so dropping
    it cannot manufacture earlier coverage (codex-1 critical C2, #4665
    round 18: a T+60.7 landing against a truncated T+60 scan became T+0).
    """
    landing = _mtime_utc(path)
    admitted_at = observed_at - FUTURE_DATING_TOLERANCE
    if landing <= checked_now:
        return max(landing, admitted_at)
    if landing - checked_now <= FUTURE_DATING_TOLERANCE:
        return max(landing, admitted_at)
    return admitted_at


def _receipt_is_fresh_at(
    observed_at: datetime,
    eligible_until: datetime,
    instant: datetime,
) -> bool:
    """receipt_is_fresh inequalities without reloading the receipt."""
    if observed_at > instant + FUTURE_DATING_TOLERANCE:
        return False
    return instant <= eligible_until


def _routing_selected_receipt(
    entries: Sequence[_ReceiptSurfaceEvidence],
    instant: datetime,
) -> _ReceiptSurfaceEvidence | None:
    """Newest receipt routing would consume at ``instant``.

    Mirrors load_platform_capability_receipts: receipt_is_fresh, then
    greatest observed_at, ties keep the first file in name order.
    """
    eligible = [
        entry
        for entry in entries
        if _receipt_is_fresh_at(entry.observed_at, entry.eligible_until, instant)
    ]
    if not eligible:
        return None
    eligible = sorted(eligible, key=lambda entry: entry.path.name)
    selected = eligible[0]
    for candidate in eligible[1:]:
        if candidate.observed_at > selected.observed_at:
            selected = candidate
    return selected


def _scan_receipt_surface_detailed(
    receipt_dir: Path,
    route_pools: dict[str, tuple[CapacityPool, QuotaSource]] | None = None,
    *,
    now: datetime | None = None,
) -> tuple[
    dict[str, tuple[datetime, datetime, datetime]],
    dict[str, list[_ReceiptSurfaceEvidence]],
    set[Path],
    list[str],
]:
    """Per-platform selected surface states, the FULL readable evidence set,
    the admissible pool paths, and the platforms whose receipt names no
    registry route.

    Returns ``(states, readable_by_platform, admissible_paths,
    no_named_route)``: `states` is the selected per-platform
    ``(observed_at, effective expiry, routable-from instant)`` exactly as
    routing's loader would consume; `readable_by_platform` carries every
    parseable receipt — the continuity predicate reconstructs routing's
    selected receipt at each instant from this set, including selection
    transitions, and must not union shadowed lifetimes as coverage
    (codex-1 critical C1, #4665 round 18); and `admissible_paths` are the
    paths in the selected pool (eligible, else the non-future-dated
    fallback).

    When one platform has several receipt files in the directory, the SELECTED
    receipt is the one routing's loader would consume — the greatest
    observed_at among receipts passing routing's freshness eligibility
    (receipt_is_fresh: future-dated beyond one minute is rejected, and so is
    anything past its own stale_after), with exact ties keeping the first file
    in name order. When NO receipt for a platform is eligible, the scan falls
    back to the newest observed among the readable ones that are not
    future-dated: routing then holds nothing for the platform — exactly the
    dead-surface condition the continuity witness must measure, so the expired
    predecessor's evidence is retained rather than dropped, while receipts
    routing rejects as future-dated are excluded from that fallback too — they
    are not predecessor evidence at any clock, and letting one win fabricated
    coverage past a hole it could not see (codex-1 criticals C1, #4665 rounds
    13-15: round 13's plain newest-observed selection let a future-dated backup
    that routing REJECTS win both scans and mask a real 60s gap, and let an
    already-expired newer backup that routing RETAINS nothing from win and
    fabricate a 50s gap across a surface the consumer still accepted; round 14
    kept those receipts out of the ELIGIBLE pool but the historical fallback
    still restored the future-dated one whenever nothing was eligible).

    The routable-from instant is the later of the receipt FILE's own mtime and
    observed_at minus the future-dating tolerance: the refresh writes each
    platform's receipt separately, so a refresh-written file's mtime is that
    platform's actual replacement landing instant (codex-1 major, #4665 round
    11, M1: the refresh's single completion instant charged every platform
    for the whole refresh's tail — a platform replaced 40s into a 260s
    refresh, well inside its predecessor's lifetime, read as a 60s hole and
    flapped rc=4 on uninterrupted coverage). A pre-existing file that an
    eligibility transition just SELECTED cannot credit its old mtime either:
    routing rejects the receipt as future-dated until observed_at minus the
    tolerance, so before that instant the file vouches for nothing, and the
    gap witness must charge the coverage start there (codex-1 critical C1,
    #4665 round 16: an untouched backup observed at T+200 with mtime T-60 won
    the post-refresh scan once it stopped being future-dated, and its old
    mtime fabricated gap=-140 rc=0 across a real T+80..T+140 hole). One skew
    guard: production guarantees observed_at <= mtime <= scan clock, so an
    mtime BEYOND the scan clock is not a landing instant this scan can
    vouch for. Far-future stamps (fixture residue) fall back to
    observed_at minus the tolerance; a landing only slightly past the scan
    keeps the file stamp so dropping it cannot manufacture earlier
    coverage (codex-1 critical C2, #4665 round 18).

    The second element names platforms whose receipt binds NO registry route
    (empty routes, or every named route absent from the registry): their
    expiry fails closed to the quota TTL — invisible in the gap witnesses,
    which is exactly why it gets its own summary key (claude-1 minor, #4665
    round 12: a route-id rename in the registry would silently flip every
    platform onto the fail-closed leg with no counter to read).
    """
    if route_pools is None:
        route_pools = static_registry_route_pools()
    states: dict[str, tuple[datetime, datetime, datetime]] = {}
    readable_by_platform: dict[str, list[_ReceiptSurfaceEvidence]] = {}
    admissible_paths: set[Path] = set()
    no_named_route: set[str] = set()
    if not receipt_dir.is_dir():
        return states, readable_by_platform, admissible_paths, sorted(no_named_route)
    candidates: dict[str, list[tuple[datetime, Path, PlatformCapabilityReceipt]]] = {}
    for path in sorted(receipt_dir.glob("*.json")):
        try:
            receipt = load_platform_capability_receipt(path)
        except PlatformCapabilityReceiptError:
            continue
        candidates.setdefault(receipt.platform, []).append(
            (ensure_utc(receipt.observed_at), path, receipt)
        )
    # The future-dating window mirrors receipt_is_fresh's own rejection clause
    # (observed more than one minute ahead of the clock is not evidence).
    checked_now = ensure_utc(now or datetime.now(UTC))

    for platform, platform_candidates in candidates.items():
        # Routing's temporal eligibility first; the expired fallback below
        # exists ONLY to keep predecessor evidence measurable when routing
        # holds nothing (the historical-gap case).
        eligible = [
            candidate
            for candidate in platform_candidates
            if receipt_is_fresh(candidate[2], now=now)
        ]
        # The fallback keeps EXPIRED evidence — routing vouched for it once —
        # but never future-dated receipts: routing rejects those at any clock,
        # so they are not predecessor evidence, and letting one win fabricated
        # coverage past a hole it could not see (codex-1 critical C1, #4665
        # round 15: at a 00:00 tick whose canonical expired at 23:59, a 00:10
        # backup credited a 00:25 expiry and the replacement read gap=-1500
        # rc=0 across a real 60s hole).
        admissible_fallback = [
            candidate
            for candidate in platform_candidates
            if candidate[0] <= checked_now + FUTURE_DATING_TOLERANCE
        ]
        pool = eligible or admissible_fallback
        # Full readable evidence set: EVERY parseable receipt keeps an
        # interval, selected or not, because the continuity predicate
        # reconstructs routing's selected receipt at each instant — a
        # currently-shadowed sibling may become selected later, but its
        # lifetime is not coverage while it is not selected (codex-1
        # critical C1, #4665 round 18).
        readable_by_platform[platform] = [
            _ReceiptSurfaceEvidence(
                observed_at,
                receipt_surface_effective_expiry(receipt, route_pools),
                _receipt_routable_from(observed_at, path, checked_now),
                path,
                observed_at + parse_duration_spec(receipt.stale_after),
            )
            for observed_at, path, receipt in platform_candidates
        ]
        if not pool:
            # Every candidate is future-dated: routing holds nothing AND no
            # expired predecessor exists — there is no honest evidence for
            # this platform, so the scan reports none rather than letting a
            # clock-skewed stamp fabricate a coverage window.
            continue
        # Greatest observed_at wins; exact ties keep the first file in name
        # order — the same strict-> comparison over a sorted walk that
        # load_platform_capability_receipts uses.
        observed_at, path, receipt = pool[0]
        for candidate in pool[1:]:
            if candidate[0] > observed_at:
                observed_at, path, receipt = candidate
        admissible_paths.add(path)
        # Route coverage is judged on the SELECTED receipt — the one routing
        # would actually consume for this platform — not on a shadowed
        # sibling's routes.
        if not any(route_id in route_pools for route_id in receipt.routes):
            no_named_route.add(platform)
        # The selected receipt starts vouching for the platform only once it is
        # both on disk and not future-dated: observed_at minus the tolerance is
        # the earliest clock that admits it, so an eligibility transition onto a
        # pre-existing file cannot credit that file's old mtime as coverage
        # across the hole before the transition (see the docstring above).
        states[platform] = (
            observed_at,
            receipt_surface_effective_expiry(receipt, route_pools),
            _receipt_routable_from(observed_at, path, checked_now),
        )
    return states, readable_by_platform, admissible_paths, sorted(no_named_route)


def _scan_receipt_surface(
    receipt_dir: Path,
    route_pools: dict[str, tuple[CapacityPool, QuotaSource]] | None = None,
    *,
    now: datetime | None = None,
) -> tuple[dict[str, tuple[datetime, datetime, datetime]], list[str]]:
    """Selected per-platform receipt-surface states (the detailed scan's
    first and last elements) — the shape every pre-round-17 consumer uses."""
    states, _readable, _admissible, no_named_route = _scan_receipt_surface_detailed(
        receipt_dir, route_pools, now=now
    )
    return states, no_named_route


def _merge_half_open_intervals(
    intervals: Iterable[tuple[datetime, datetime]],
) -> list[tuple[datetime, datetime]]:
    """Merge half-open [start, end) intervals into a sorted disjoint cover.

    Zero-or-negative-width entries cover no instant and are dropped here;
    callers that need their ends as candidate witness endpoints read the RAW
    intervals directly instead."""
    ordered = sorted((start, end) for start, end in intervals if start < end)
    merged: list[list[datetime]] = []
    for start, end in ordered:
        if merged and start <= merged[-1][1]:
            if end > merged[-1][1]:
                merged[-1][1] = end
        else:
            merged.append([start, end])
    return [(start, end) for start, end in merged]


def _interval_covering_end(
    intervals: Iterable[tuple[datetime, datetime]], instant: datetime
) -> datetime | None:
    """Greatest end among the RAW (unmerged) intervals containing `instant`."""
    ends = [end for start, end in intervals if start <= instant < end]
    return max(ends) if ends else None


def _first_uncovered_run_s(
    intervals: Iterable[tuple[datetime, datetime]], start: datetime, end: datetime
) -> float | None:
    """Seconds of the first uncovered run in [start, end), or None when the
    whole window is covered."""
    if end <= start:
        return None
    cursor = start
    for iv_start, iv_end in sorted(intervals):
        if iv_end <= cursor:
            continue
        if iv_start > cursor:
            return (min(iv_start, end) - cursor).total_seconds()
        cursor = max(cursor, iv_end)
        if cursor >= end:
            return None
    return (end - cursor).total_seconds()


def _selected_receipt_coverage_intervals(
    entries: Sequence[_ReceiptSurfaceEvidence],
) -> list[tuple[datetime, datetime]]:
    """Half-open [start, end) windows where routing's selected quota is live.

    At each instant the newest eligible receipt is selected, matching
    load_platform_capability_receipts. Coverage exists only while THAT
    receipt's quota surface is live. Selection transitions that keep a live
    quota concatenate; a shadowed sibling's longer TTL never contributes
    while it is not selected (codex-1 critical C1, #4665 round 18).
    """
    if not entries:
        return []
    events: set[datetime] = set()
    for entry in entries:
        events.add(entry.observed_at - FUTURE_DATING_TOLERANCE)
        events.add(entry.eligible_until)
        events.add(entry.routable_from)
        events.add(entry.expiry)
    ordered = sorted(events)
    coverage: list[tuple[datetime, datetime]] = []
    for start, end in zip(ordered, ordered[1:], strict=False):
        if end <= start:
            continue
        mid = start + (end - start) / 2
        selected = _routing_selected_receipt(entries, mid)
        if selected is None:
            continue
        if selected.routable_from <= mid < selected.expiry:
            slice_start = max(start, selected.routable_from)
            slice_end = min(end, selected.expiry)
            if slice_start < slice_end:
                coverage.append((slice_start, slice_end))
    return _merge_half_open_intervals(coverage)


def _receipt_surface_continuity(
    tick_start: datetime,
    tick_scan: tuple[
        dict[str, tuple[datetime, datetime, datetime]],
        dict[str, list[_ReceiptSurfaceEvidence]],
        set[Path],
        list[str],
    ],
    final_scan: tuple[
        dict[str, tuple[datetime, datetime, datetime]],
        dict[str, list[_ReceiptSurfaceEvidence]],
        set[Path],
        list[str],
    ],
) -> dict[str, tuple[float, datetime | None, datetime | None, datetime]]:
    """Receipt-surface continuity: routing's selected receipt over time.

    For every platform the final scan selected whose observed_at MOVED since
    the tick-start scan, charge the coverage hole (if any) between the
    predecessor-era evidence and the replacement's routable-from instant.
    Returns platform -> (gap_seconds, witness_end, tick_observed_at,
    successor_routable); gap is successor_routable minus the covering end
    (negative = margin), holes are positive run lengths, and witness_end is
    the predecessor endpoint the gap is charged against (None only when the
    platform had no tick evidence at all — a cold surface asserting nothing).

    Coverage is the selected-receipt timeline of the TICK-START readable
    set, not the union of every readable lifetime: routing selects only the
    newest eligible receipt, so a shadowed older backup with a longer TTL
    cannot establish continuity while the canonical receipt is still
    selected and already lapsed (codex-1 critical C1, #4665 round 18).
    Selection transitions ARE coverage: when the selected receipt changes
    and the newly selected quota surface is live, the windows concatenate.
    The predecessor evidence is the tick-start snapshot (T0 clock,
    pre-pull), not a post-ledger rescan (round 17 C1). The successor
    landing is the minimum routable-from over MOVED paths — the refresh
    rewrites receipt files, so a path whose observed_at differs between
    the two scans is that platform's replacement landing, and the earliest
    one binds (a later landing would charge the platform for the refresh's
    tail, round 11 M1).
    """
    tick_states, tick_readable, _tick_admissible, _tick_no_named = tick_scan
    final_states, final_readable, _final_admissible, _final_no_named = final_scan
    results: dict[str, tuple[float, datetime | None, datetime | None, datetime]] = {}
    for platform, (final_obs, _final_expiry, final_routable) in final_states.items():
        tick_entries = tick_readable.get(platform, [])
        tick_obs: datetime | None
        if platform in tick_states:
            tick_obs = tick_states[platform][0]
            if final_obs == tick_obs:
                # Not republished this tick: a lingering dead receipt is a
                # maintenance defect, not a replacement hole.
                continue
        elif not tick_entries:
            # No tick evidence at all: cold surface, asserts nothing.
            continue
        else:
            tick_obs = None
        tick_obs_by_path = {entry.path: entry.observed_at for entry in tick_entries}
        moved_landings = [
            entry.routable_from
            for entry in final_readable.get(platform, [])
            if entry.path in tick_obs_by_path and tick_obs_by_path[entry.path] != entry.observed_at
        ]
        successor_routable = min(moved_landings) if moved_landings else final_routable
        selected_tick = _selected_receipt_coverage_intervals(tick_entries)
        anchor_end = next(
            (end for start, end in selected_tick if start <= tick_start < end),
            None,
        )
        gap_s: float
        witness_end: datetime | None
        if anchor_end is not None:
            # Sign convention: gap is successor_routable minus the covering end
            # (negative = margin); a HOLE is its positive uncovered run length,
            # which can be shorter than successor minus anchor when later
            # selected evidence covers part of the window.
            if successor_routable <= anchor_end:
                # Replacement landed inside the coverage in force at tick
                # begin: pure margin, never a hole.
                witness_end = anchor_end
                gap_s = (successor_routable - anchor_end).total_seconds()
            else:
                hole = _first_uncovered_run_s(selected_tick, anchor_end, successor_routable)
                if hole is not None:
                    witness_end = anchor_end
                    gap_s = hole
                else:
                    witness_end = _interval_covering_end(
                        selected_tick, successor_routable - timedelta(microseconds=1)
                    )
                    if witness_end is None:
                        witness_end = anchor_end
                    gap_s = (successor_routable - witness_end).total_seconds()
        else:
            # No selected coverage in force at tick begin: charge against
            # the selected predecessor evidence nearest (and no later than)
            # the successor landing — a covering interval means pure margin,
            # an earlier end means a hole, and neither means the platform
            # is fresh.
            witness_end = _interval_covering_end(
                selected_tick, successor_routable - timedelta(microseconds=1)
            )
            if witness_end is None:
                prior_ends = [end for _start, end in selected_tick if end <= successor_routable]
                witness_end = max(prior_ends) if prior_ends else None
            gap_s = (
                (successor_routable - witness_end).total_seconds()
                if witness_end is not None
                else 0.0
            )
        results[platform] = (gap_s, witness_end, tick_obs, successor_routable)
    return results


def quota_receipt_surface_expiries(
    receipt_dir: Path,
    route_pools: dict[str, tuple[CapacityPool, QuotaSource]] | None = None,
    *,
    now: datetime | None = None,
) -> dict[str, tuple[datetime, datetime]]:
    """Per-platform (observed_at, effective expiry) of the published capability receipts.

    expiry is the instant quota routing stops vouching for that platform's
    surface — the routing consumer's effective expiry
    (receipt_surface_effective_expiry), never the raw outer receipt TTL: a
    900s admission inside a 24h outer envelope dies at 900s no matter what the
    envelope says. The publication predicate below compares, per platform the
    refresh REPLACED, that platform's OWN routable-from instant (the later of
    its receipt file's mtime and the clock its evidence stops being
    future-dated, see _scan_receipt_surface) against its OWN
    predecessor effective expiry (critical finding on #4665, rounds 8, 10,
    11 and 16, C1/M1). Replacement is detected by observed_at change: the refresh
    restamps every receipt it covers, so an unchanged observed_at means the
    refresh did not republish that platform — a lingering dead receipt it
    never touches is a MAINTENANCE defect (measured live 2026-09-12: retired
    gemini/antigrav/grok receipts dead since July sit in the real receipt
    dir), not a replacement hole, and must not flap this tick red forever.
    Unreadable receipts are skipped; a directory with nothing readable
    yields {} and the tick asserts no receipt-surface witness rather than
    guessing.
    """
    return {
        platform: (observed_at, expiry)
        for platform, (observed_at, expiry, _published_at) in _scan_receipt_surface(
            receipt_dir, route_pools, now=now
        )[0].items()
    }


#: The live file stays at schema 1 until every reader takes schema 2. Measured 2026-09-24:
#: reins reads it through the separately released `hapax-spine` 0.1.3, whose ledger model is
#: `schema_version: Literal[1]` with `extra="forbid"`. Set 2 only after that reader accepts it.
LIVE_SCHEMA_ENV = "HAPAX_QUOTA_LEDGER_LIVE_SCHEMA"


def live_schema_version() -> int:
    return 2 if os.environ.get(LIVE_SCHEMA_ENV, "1").strip() == "2" else 1


def append_operator_report(argv: list[str]) -> int:
    """Append to the same locked ledger; no receipt or separate report store."""
    from shared.quota_headroom import operator_report

    if live_schema_version() != 2:
        print(
            "operator report refused: the live ledger is schema 1 and reports need schema 2. "
            f"Next action: set {LIVE_SCHEMA_ENV}=2 once every live-ledger reader accepts schema 2",
            file=sys.stderr,
        )
        return 1

    parser = argparse.ArgumentParser(prog="hapax-quota-telemetry-writer operator-report")
    parser.add_argument("--family", required=True)
    parser.add_argument(
        "--reset", required=True, help="Preserve ambiguous local time without inventing a timezone"
    )
    parser.add_argument("--quote", required=True)
    parser.add_argument("--at", help="Original operator report time (ISO-8601 with timezone)")
    parser.add_argument(
        "--out",
        type=Path,
        default=Path(
            os.environ.get(QUOTA_SPEND_LEDGER_LIVE_ENV, str(DEFAULT_QUOTA_SPEND_LEDGER_LIVE))
        ),
    )
    args = parser.parse_args(argv)
    from shared.quota_headroom import instant

    at = instant(args.at) if args.at else datetime.now(UTC)
    if at is None:
        parser.error("--at requires a timezone")
    try:
        report = operator_report(family=args.family, reset=args.reset, quote=args.quote, at=at)
        with quota_spend_live_lock(args.out):
            ledger = load_quota_spend_ledger(args.out)
            payload = ledger.model_dump(mode="json")
            payload["schema_version"] = 2
            payload["operator_reports"].append(report.model_dump(mode="json"))
            write_ledger_atomic(
                QuotaSpendLedger.model_validate(payload), args.out, schema_version=2
            )
    except (ValueError, OSError, QuotaSpendLedgerError, LiveLedgerLockTimeout):
        print(
            "operator report rejected; check family, timestamp and quote; ledger preserved",
            file=sys.stderr,
        )
        return 1
    print("Operator report appended; no admission issued")
    return 0


def main(argv: list[str] | None = None) -> int:
    if (argv or sys.argv[1:])[:1] == ["operator-report"]:
        return append_operator_report((argv or sys.argv[1:])[1:])
    parser = argparse.ArgumentParser(
        prog="hapax-quota-telemetry-writer",
        description="Write live per-provider quota/resource telemetry for the dispatcher.",
    )
    parser.add_argument(
        "--base",
        type=Path,
        default=QUOTA_SPEND_LEDGER_FIXTURES,
        help="Checked-in ledger supplying governance records (default: repo fixtures)",
    )
    parser.add_argument(
        "--out",
        type=Path,
        default=None,
        help="Live ledger output path (default: $HAPAX_QUOTA_SPEND_LEDGER_LIVE or cache path)",
    )
    parser.add_argument(
        "--relay-receipt-dir",
        type=Path,
        default=RELAY_RECEIPT_DIR,
        help="Quota-wall relay receipt directory",
    )
    parser.add_argument(
        "--platform-capability-receipt-dir",
        type=Path,
        default=Path(
            os.environ.get(
                PLATFORM_CAPABILITY_RECEIPT_DIR_ENV,
                str(DEFAULT_PLATFORM_CAPABILITY_RECEIPT_DIR),
            )
        ),
        help="Platform capability receipt directory",
    )
    parser.add_argument("--now", help="Override observation time as ISO-8601 UTC (tests)")
    parser.add_argument(
        "--skip-receipts",
        action="store_true",
        help="Skip the platform capability receipt refresh (tests)",
    )
    parser.add_argument(
        "--nvidia-smi",
        default="nvidia-smi",
        help="nvidia-smi binary for the local resource probe (tests)",
    )
    parser.add_argument("--receipt-timeout", type=float, default=120.0)
    parser.add_argument("--json", action="store_true", help="Print a JSON summary to stdout")
    parser.add_argument(
        "--check",
        action="store_true",
        help="Print the enriched ledger; read local files only and write nothing",
    )
    parser.add_argument(
        "--schema-version",
        type=int,
        choices=(1, 2),
        default=2,
        help="Output schema; v1 is an explicit compatibility projection",
    )
    parser.add_argument(
        "--trace-home",
        type=Path,
        default=Path(os.environ.get("HAPAX_QUOTA_TRACE_HOME", str(Path.home()))),
        help="Root of local CLI traces",
    )
    parser.add_argument(
        "--live-schema-version",
        type=int,
        choices=(1, 2),
        default=live_schema_version(),
        help=f"Schema of the live file; defaults to ${LIVE_SCHEMA_ENV} or 1 (see its comment)",
    )
    args = parser.parse_args(argv)

    now = _parse_utc(args.now) if args.now else datetime.now(UTC).replace(microsecond=0)
    if args.schema_version == 1 and not args.check:
        parser.error("--schema-version 1 is a read-only --check projection")
    if now is None:
        parser.error(f"invalid --now value: {args.now!r}")

    # Immutable invocation wall anchor. `now` is re-sampled after the pull
    # (below) so the receipt scans judge post-pull freshness, but the
    # publication instant must anchor HERE: elapsed-since-invocation already
    # carries the pull, so anchoring publication at the re-sampled clock
    # counts the pull twice — a 60s pull with publication at T+80 reported
    # T+140, shaving 60s of honest freshness and manufacturing a phantom
    # continuity gap into rc=4 on a healthy tick (major finding on #4665,
    # round 7, M1).
    invocation_wall_started = now

    # Invocation-wide monotonic anchor paired with `now` above (the same
    # pattern as the determine harness's completion witness, round-5 C1): the
    # publication instant below is `now` + elapsed-since-here, so it includes
    # the pull's force-decision scan and subprocess, the base-ledger load, the
    # lock wait, and the whole scan→build→write pass. Anchoring at the write
    # pass alone reported only its last leg: a tick whose 110s scan and 60s
    # producer preceded a 20s write published 170s after its own anchor while
    # `published_at` read 20s — and the continuity predicate, which exists to
    # catch exactly that gap, would have been blind to it (critical finding
    # on #4665, round 5, C2).
    invocation_mono_started = monotonic_clock()

    # Tick-start receipt snapshot (round 17): the surface AS THE TICK BEGAN —
    # predecessor-era files only, judged with the T0 clock (fixed under
    # --now), sampled BEFORE the pull/ledger/refresh legs touch anything.
    # The continuity predicate below anchors replacement gaps on THIS scan;
    # the post-ledger predecessor scan further down keeps only its
    # no-named-route role, because as a gap witness it samples the surface
    # after the ledger pass's real seconds have already flipped successor
    # evidence's eligibility — masking exactly the mid-pass holes the tick
    # must charge (codex-1 critical C1, #4665 round 17).
    tick_start_receipt_scan = None
    if not args.skip_receipts and not args.check:
        tick_start_receipt_scan = _scan_receipt_surface_detailed(
            args.platform_capability_receipt_dir, now=now
        )

    from shared.quota_headroom import TraceReadError, collect_measurements, enrich_ledger

    # Measurements only add evidence. When they cannot be read, the admission ledger is still
    # written, unenriched: a measurement failure narrows evidence, it never stalls admission.
    measurements = None
    try:
        measurements = collect_measurements(args.trace_home, args.relay_receipt_dir, now=now)
    except (TraceReadError, ValueError, OSError):
        print(
            "hapax-quota-telemetry-writer: local measurements unavailable; admission ledger "
            "written without them. Next action: run with --check to see the failing source",
            file=sys.stderr,
        )
    # Declarations only: which routes exist, their pools and paid profiles. Route freshness for
    # the stage comes from this tick's own admission snapshots (enrich_ledger), never from a
    # second strict receipt-applied read, which the agentic-trust boundary confines to reporting.
    registry = None
    try:
        registry = PlatformCapabilityRegistry.model_validate(
            json.loads(PLATFORM_CAPABILITY_REGISTRY.read_text(encoding="utf-8"))
        )
    except (OSError, ValueError):
        print(
            "hapax-quota-telemetry-writer: static capability registry unavailable; admission "
            "ledger written without measurements. Next action: validate "
            "config/platform-capability-registry.json",
            file=sys.stderr,
        )
    if args.check and (measurements is None or registry is None):
        return 1
    if args.check:
        configured = os.environ.get(QUOTA_SPEND_LEDGER_LIVE_ENV)
        live_path = args.out or (
            Path(configured).expanduser() if configured else DEFAULT_QUOTA_SPEND_LEDGER_LIVE
        )
        try:
            base = load_quota_spend_ledger(live_path if live_path.exists() else args.base)
            checked = enrich_ledger(
                base, measurements, registry=registry, now=now if args.now else datetime.now(UTC)
            )
        except (ValueError, QuotaSpendLedgerError):
            print(
                "hapax-quota-telemetry-writer: invalid local ledger; no write performed",
                file=sys.stderr,
            )
            return 1
        payload = (
            checked.schema_v1_payload()
            if args.schema_version == 1
            else checked.model_dump(mode="json")
        )
        print(json.dumps(payload, indent=2))
        return 0

    receipts_ok = True
    pull_forward: dict[str, Any] = {
        "invoked": False,
        "forced": False,
        "ran": [],
        "skipped": [],
        "ok": True,
        "scan_elapsed_s": None,
        "scan_bound_s": PRE_MINT_SCAN_BOUND_S,
    }
    if not args.skip_receipts:
        pull_forward = pull_forward_due_producers(
            repo_root=REPO_ROOT,
            receipt_dir=args.relay_receipt_dir,
            now=now,
        )
        # The pull child runs for real seconds; every scan below must judge
        # receipt freshness against what exists AFTER the pull, or the mint the
        # pull just produced is rejected as future-dated (major finding on
        # #4665). --now keeps tests deterministic.
        if not args.now:
            now = datetime.now(UTC).replace(microsecond=0)

    # Anchor for the per-pass pre-write diagnostic (claude-1 minor, #4665
    # round 12): the monotonic instant the pull (and its mint) finished, so
    # the scan→build→write spans the PRE_WRITE_WORK_BOUND_S budget bounds are
    # measurable per pass instead of only inferable from the freshness
    # witnesses. Purely diagnostic — no predicate reads these spans.
    mint_anchor = monotonic_clock()
    pre_write_rebuild_elapsed_s: float | None = None

    try:
        base = load_quota_spend_ledger(args.base)
    except QuotaSpendLedgerError as exc:
        print(f"hapax-quota-telemetry-writer: base ledger unusable: {exc}", file=sys.stderr)
        return 1

    if args.out is not None:
        out_path = args.out
    else:
        configured = os.environ.get(QUOTA_SPEND_LEDGER_LIVE_ENV)
        out_path = Path(configured).expanduser() if configured else DEFAULT_QUOTA_SPEND_LEDGER_LIVE

    # Captured BEFORE the first write replaces the ledger: the continuity
    # predicate below compares this tick's publication instant against the
    # promise the previous tick actually published.
    previous_promise = _previous_agy_promise(out_path)

    def _scan_build_write(
        current_now: datetime,
    ) -> tuple[
        QuotaSpendLedger,
        dict[str, list[QuotaWall]],
        object,
        object,
        object,
        object,
        GlmcpPaygSpendScan,
        str,
        CodexAuthBlocker | None,
    ]:
        """One full scan→build→atomic-write pass under the live-ledger lock."""
        with quota_spend_live_lock(out_path):
            walls = active_quota_walls(args.relay_receipt_dir, now=current_now)
            agy_scan = active_agy_admission_receipts(args.relay_receipt_dir, now=current_now)
            kimi_scan = active_kimi_admission_receipts(args.relay_receipt_dir, now=current_now)
            claude_scan = active_claude_admission_receipts(args.relay_receipt_dir, now=current_now)
            glmcp_scan = active_glmcp_admission_receipts(args.relay_receipt_dir, now=current_now)
            glmcp_payg_spend_scan = active_glmcp_payg_spend_receipts(
                args.relay_receipt_dir,
                base=base,
                now=current_now,
            )
            codex_blocker = codex_saved_login_blocker(
                args.platform_capability_receipt_dir,
                now=current_now,
            )
            resource_state, resource_evidence = probe_local_resource_state(
                nvidia_smi=args.nvidia_smi
            )
            ledger = build_live_ledger(
                base,
                now=current_now,
                walls=walls,
                agy_admissions=agy_scan.admissions,
                agy_ignored_receipts=agy_scan.ignored_evidence_refs,
                kimi_admissions=kimi_scan.admissions,
                kimi_ignored_receipts=kimi_scan.ignored_evidence_refs,
                claude_admissions=claude_scan.admissions,
                claude_ignored_receipts=claude_scan.ignored_evidence_refs,
                glmcp_admissions=glmcp_scan.admissions,
                glmcp_ignored_receipts=glmcp_scan.ignored_evidence_refs,
                glmcp_payg_spend_receipts=glmcp_payg_spend_scan.receipts,
                glmcp_ignored_payg_spend_receipts=glmcp_payg_spend_scan.ignored_evidence_refs,
                codex_auth_blocker=codex_blocker,
                local_resource_state=resource_state,
                local_resource_evidence=resource_evidence,
            )
            if out_path.exists():
                try:
                    previous = load_quota_spend_ledger(out_path)
                except (QuotaSpendLedgerError, OSError, ValueError):
                    # A damaged previous file must not block every later tick.
                    print(
                        "hapax-quota-telemetry-writer: previous live ledger unreadable; "
                        "operator reports not carried forward",
                        file=sys.stderr,
                    )
                else:
                    ledger = ledger.model_copy(
                        update={"operator_reports": previous.operator_reports}
                    )
            if measurements is not None and registry is not None:
                ledger = enrich_ledger(ledger, measurements, registry=registry, now=current_now)
            write_ledger_atomic(ledger, out_path, schema_version=args.live_schema_version)
        return (
            ledger,
            walls,
            agy_scan,
            kimi_scan,
            claude_scan,
            glmcp_scan,
            glmcp_payg_spend_scan,
            resource_state,
            codex_blocker,
        )

    try:
        (
            ledger,
            walls,
            agy_scan,
            kimi_scan,
            claude_scan,
            glmcp_scan,
            glmcp_payg_spend_scan,
            resource_state,
            codex_blocker,
        ) = _scan_build_write(now)
    except LiveLedgerLockTimeout as exc:
        print(
            f"hapax-quota-telemetry-writer: {exc}; this tick wrote no ledger. "
            "Next: check for a concurrent writer holding the live ledger "
            "(ps -ef | grep hapax-quota-telemetry-writer) and rerun with "
            "--json; the on-disk ledger keeps its previous fresh_until.",
            file=sys.stderr,
        )
        return 2
    except (ValueError, QuotaSpendLedgerError) as exc:
        print(f"hapax-quota-telemetry-writer: live ledger invalid: {exc}", file=sys.stderr)
        return 1
    # The actual publication instant: the IMMUTABLE invocation wall anchor
    # plus the invocation-wide monotonic elapsed at write completion — the
    # pull's scan and subprocess, the base load, the lock wait, the receipt
    # scans, the probe, the build, and the atomic write all included, because
    # the ledger lands on disk at the end of ALL of them (round-4 codex-1
    # major: a 900s admission with 120s of publication work reported 870s
    # remaining at write while the surface actually published at 750s; round-5
    # C2: anchoring at the write pass left the pre-mint scan's elapsed outside
    # the measurement entirely; round-7 M1: anchoring at `now` — re-sampled
    # post-pull under a real clock — counted the pull inside both terms).
    published_at = (
        invocation_wall_started + timedelta(seconds=monotonic_clock() - invocation_mono_started)
    ).replace(microsecond=0)
    pass1_published_at = published_at
    # Pass 1's pre-write span: mint-anchor → this write. The B bound's
    # measured counterpart (claude-1 minor, #4665 round 12) — the 81s
    # receipt-spam tick this budget last reasoned about was read out of
    # journalctl archaeology; now every tick reports its own span.
    pre_write_elapsed_s = round(monotonic_clock() - mint_anchor, 2)
    # The promise pass 1 just published, read from the ledger now on disk: if
    # the refresh below forces a rebuild, pass 2's continuity is judged
    # against THIS promise — its immediate predecessor — never against the
    # pre-tick promise pass 1 already covered (major finding on #4665, round
    # 7, M2).
    pass1_promise = _previous_agy_promise(out_path)

    # The refresh runs AFTER the pass-1 write, on purpose (critical finding on #4665):
    # its observe_quota consumer validates routes against the live ledger on disk and
    # caps each capability receipt's stale_after by that ledger's fresh_until. Refreshing
    # before the write made it consume the PREVIOUS cycle's ledger, so a fresh 900s
    # admission was clamped to whatever freshness the stale ledger had left (~300s) or,
    # once that expired, made the surface unobservable despite fresh producer input.
    ledger_rebuilt_after_refresh = False
    ledger_rebuild_after_refresh_error: str | None = None
    # Captured BEFORE the refresh replaces them: the receipt surface quota
    # routing consumes lives in the platform capability receipts, so the
    # predecessor surface's per-platform vouching expiries are read here,
    # pre-replacement. The publication witness below compares the
    # replacement's landing instant against the predecessor expiry of every
    # platform the refresh actually republished (critical finding on #4665,
    # round 8, C1). --skip-receipts asserts nothing. The same scan names the
    # platforms whose receipt binds no registry route — the fail-closed
    # fallback the gap witnesses cannot see (claude-1 minor, #4665 round 12);
    # post-refresh state overrides this below when the refresh ran.
    receipt_surface_no_named_route: list[str] | None = None
    if not args.skip_receipts:
        # Each receipt scan judges eligibility with the clock routing itself
        # would sample AT THAT STAGE, never the post-pull instant shared `now`
        # still carries: the ledger pass before this scan and the refresh
        # between the scans each run for real seconds, and a successor
        # observed mid-refresh is future-dated only against a clock that
        # stopped before it landed (codex-1 critical C2, #4665 round 15: a
        # 65s ledger pass plus a 75s refresh made the successor scan judge a
        # T+65 successor against T, reject it as future-dated, and keep a
        # stale backup selected, so the platform read as unreplaced and the
        # tick exited rc=0 across a real 60s hole). --now keeps the synthetic
        # clock fixed and the tests deterministic.
        predecessor_scan_now = now if args.now else datetime.now(UTC)
        (
            _predecessor_surface_states,
            receipt_surface_no_named_route,
        ) = _scan_receipt_surface(args.platform_capability_receipt_dir, now=predecessor_scan_now)
    receipt_publication_at: datetime | None = None
    receipt_surface_replacements: dict[str, tuple[datetime, datetime | None, datetime]] = {}
    receipt_surface_gaps: dict[str, tuple[float, datetime | None, datetime | None, datetime]] = {}
    if not args.skip_receipts:
        receipts_ok = refresh_capability_receipts(
            timeout=args.receipt_timeout,
            receipt_dir=args.platform_capability_receipt_dir,
        )
        if receipts_ok:
            # The refresh's COMPLETION instant, from the immutable invocation
            # clock pair — never a mid-invocation wall re-sample, which is how
            # publication instants went missing before (round-4 codex-1). It
            # gates the witness below (a refresh that completed republished
            # something worth judging); the per-platform LANDING instants the
            # gap compares come from each receipt file's own mtime, so this
            # completion instant is never charged to any platform's coverage
            # (round-11 M1). A failed refresh published nothing: the witness
            # stays empty and the rc=3 path below reports the failure.
            receipt_publication_at = (
                invocation_wall_started
                + timedelta(seconds=monotonic_clock() - invocation_mono_started)
            ).replace(microsecond=0)
            # Which platforms the refresh actually republished, charged by the
            # round-17 continuity predicate against the TICK-START snapshot
            # above: the gap each replaced platform owes is measured from the
            # predecessor-era evidence in force when the tick began, across
            # everything the ledger pass and the refresh did in between, to
            # this platform's replacement landing (the earliest routable-from
            # over the paths the refresh rewrote — codex-1 criticals C1/M1,
            # #4665 rounds 11, 16, 17). Sampled AFTER the refresh: the
            # successor is judged with the clock routing samples once the
            # refresh has landed (codex-1 critical C2, #4665 round 15).
            # Keep sub-second precision: truncating to whole seconds made a
            # same-second landing look future and backdated it 60s
            # (codex-1 critical C2, #4665 round 18).
            successor_scan_now = now if args.now else datetime.now(UTC)
            final_receipt_scan = _scan_receipt_surface_detailed(
                args.platform_capability_receipt_dir, now=successor_scan_now
            )
            receipt_surface_no_named_route = final_receipt_scan[3]
            if tick_start_receipt_scan is not None:
                receipt_surface_gaps = _receipt_surface_continuity(
                    invocation_wall_started, tick_start_receipt_scan, final_receipt_scan
                )
                receipt_surface_replacements = {
                    platform: (tick_obs, witness_end, successor_routable)
                    for platform, (
                        _gap_s,
                        witness_end,
                        tick_obs,
                        successor_routable,
                    ) in receipt_surface_gaps.items()
                }
        blocker_now = now if args.now else datetime.now(UTC).replace(microsecond=0)
        # Only the codex blocker reads what the refresh rewrote; recompute it and
        # rebuild only when it actually changed, so the common tick writes once.
        # blocker_now feeds only the blocker record's own timestamp.
        if (
            codex_saved_login_blocker(args.platform_capability_receipt_dir, now=blocker_now)
            != codex_blocker
        ):
            try:
                # Re-pair the clocks AFTER the blocker rescan, on adjacent
                # lines, so the rescan's real seconds land inside pass2_now's
                # wall value and the rebuild's monotonic anchor. Sampling
                # pass2_now before the rescan left those seconds outside
                # published_at entirely — the reviewer's round-8 M1 repro: a
                # 120s rescan published at T+160 while reporting T+40, keeping
                # the tick green against a horizon it had already blown
                # through (major finding on #4665, round 8, M1).
                rebuild_mono_started = monotonic_clock()
                pass2_now = now if args.now else datetime.now(UTC).replace(microsecond=0)
                (
                    ledger,
                    walls,
                    agy_scan,
                    kimi_scan,
                    claude_scan,
                    glmcp_scan,
                    glmcp_payg_spend_scan,
                    resource_state,
                    codex_blocker,
                ) = _scan_build_write(pass2_now)
                ledger_rebuilt_after_refresh = True
                # The rebuild REPLACED the published ledger: the publication
                # instant moves to this pass's completion, or the predicate
                # below would judge the earlier write it just replaced. The
                # anchor mirrors pass 1: invocation-wide under --now (time is
                # synthetic-fixed, so elapsed-since-invocation is the honest
                # synthetic instant); anchored at the rebuild under a real
                # clock, because pass2_now was just re-sampled from the wall
                # and already carries every pre-rebuild second — anchoring at
                # the invocation there would double-count them.
                rebuild_anchor = invocation_mono_started if args.now else rebuild_mono_started
                published_at = (
                    pass2_now + timedelta(seconds=monotonic_clock() - rebuild_anchor)
                ).replace(microsecond=0)
                # Pass 2's pre-write span: rebuild start → this write — the
                # refresh-aware rebuild leg B bounds (claude-1 minor, #4665
                # round 12). Diagnostic only.
                pre_write_rebuild_elapsed_s = round(monotonic_clock() - rebuild_mono_started, 2)
            except LiveLedgerLockTimeout as exc:
                # Same contract as the rebuild-failure branch below: the
                # pass-1 ledger stays on disk, but this tick FAILED its
                # reconciliation and must not exit green.
                ledger_rebuild_after_refresh_error = str(exc)
                print(
                    "hapax-quota-telemetry-writer: reconciliation pass could not "
                    f"acquire the live ledger lock: {exc}; the pass-1 ledger "
                    "remains on disk. Next: check for a concurrent writer and "
                    "rerun this writer with --json.",
                    file=sys.stderr,
                )
            except (ValueError, QuotaSpendLedgerError) as exc:
                # The pass-1 ledger stays on disk (the atomic write never
                # replaced it), but this tick FAILED its reconciliation: the
                # refreshed receipts and the published ledger now disagree
                # about Codex. Exit nonzero so the unit's OnFailure surfaces
                # it, and record the error distinctly from the healthy
                # "blocker unchanged, no rebuild needed" case (major findings
                # on #4665, round 2).
                ledger_rebuild_after_refresh_error = str(exc)
                print(
                    "hapax-quota-telemetry-writer: live ledger invalid after receipt "
                    f"refresh: {exc}; the pass-1 ledger remains on disk. Next: rerun this "
                    "writer with --json after inspecting the platform capability receipts.",
                    file=sys.stderr,
                )

    # The exit predicate, measured at the PUBLICATION instant, not at
    # `captured_at`: whatever this tick embedded must outlive the next
    # publication deadline (one cycle, slipped by the timer's accuracy, plus
    # the next tick's bounded pre-write work — FRESHNESS_HORIZON_S), or the
    # quota surface cites a dead admission for the difference (the defect
    # this PR repairs). `captured_at` is sampled before the scans and the
    # write, so freshness measured there was blind to pre-write work
    # overruns (round-4 codex-1 major); `published_at` above is the actual
    # write instant derived from measured monotonic elapsed. A degraded tick
    # still writes its honest ledger — consumers see the true fresh_until,
    # never an overclaim — but the degradation is reported here, in the
    # summary, on stderr, and in the exit code (4), so a systemd
    # OnFailure/monitoring consumer cannot miss a tick that published a
    # surface it knows will flap (minor findings on #4665, round 3:
    # advisory-only degraded was not machine-checkable).
    admission_freshness_at_publication_s: float | None = None
    admission_freshness_degraded = False
    if agy_scan.admissions:
        admission_freshness_at_publication_s = round(
            (max(a.fresh_until for a in agy_scan.admissions) - published_at).total_seconds(),
            1,
        )
        admission_freshness_degraded = admission_freshness_at_publication_s < FRESHNESS_HORIZON_S
    else:
        admission_freshness_degraded = True
    # Continuity against the previously published admission: per-tick
    # remaining-lifetime predicates cannot see work that happened before this
    # tick's mint, because the mint re-anchors the admission after that work;
    # only the previous publication's own expiry can witness the coverage gap
    # (critical finding on #4665, round 5, C2). Publishing exactly at the
    # promise is continuous; a cold start (no previous promise) asserts
    # nothing. Each PUBLICATION is checked against its own immediate
    # predecessor — pass 1 against the pre-tick promise, a pass-2 rebuild
    # against the promise pass 1 just published — and the reported gap is the
    # worst per-pass gap, so coverage pass 1 provided is never misread as a
    # pass-2 gap, while an actual pass-1 gap is retained (major finding on
    # #4665, round 7, M2).
    admission_continuity_gap_s: float | None = None
    admission_continuity_degraded = False
    continuity_gap_predecessor: datetime | None = None
    per_pass_gaps: list[tuple[float, datetime]] = []
    if previous_promise is not None:
        per_pass_gaps.append(
            (max((pass1_published_at - previous_promise).total_seconds(), 0.0), previous_promise)
        )
    if ledger_rebuilt_after_refresh and pass1_promise is not None:
        per_pass_gaps.append(
            (max((published_at - pass1_promise).total_seconds(), 0.0), pass1_promise)
        )
    if per_pass_gaps:
        worst_gap, continuity_gap_predecessor = max(per_pass_gaps)
        admission_continuity_gap_s = round(worst_gap, 1)
        admission_continuity_degraded = admission_continuity_gap_s > 0.0
    pre_mint_scan_elapsed_s = pull_forward.get("scan_elapsed_s")
    pre_mint_scan_overrun = (
        pre_mint_scan_elapsed_s is not None and pre_mint_scan_elapsed_s > PRE_MINT_SCAN_BOUND_S
    )
    # Receipt-surface continuity: the refresh above replaces the capability
    # receipts quota routing actually consumes, and a replaced platform's
    # surface is dead from the instant its predecessor receipt's expiry passes
    # until the replacement lands. The ledger witnesses above cannot see this
    # stage — the ledger can be continuous while the receipt surface routing
    # cites has a hole in it (critical finding on #4665, round 8, C1: the
    # reviewer's two-tick repro had both ticks rc=0 across a 40s receipt
    # hole). Scoped to platforms the refresh REPLACED (observed_at moved); a
    # cold start (no readable predecessor surface), a failed refresh (rc=3
    # below), or a refresh that republished nothing asserts nothing here.
    receipt_continuity_gap_s: float | None = None
    receipt_continuity_degraded = False
    receipt_surface_predecessor_expiry: datetime | None = None
    if receipt_publication_at is not None and receipt_surface_replacements:
        # Round 17: the worst platform's gap and the MINIMUM witness endpoint
        # come from the continuity predicate's per-platform verdicts — each
        # platform's OWN successor landing against its OWN predecessor
        # evidence chain (tick-start anchor, mid-pass coverage, successor
        # routable-from). A platform whose witness end is None had no tick
        # evidence at all (cold surface) and asserts nothing.
        witness_ends = [
            expiry
            for _observed, expiry, _published in receipt_surface_replacements.values()
            if expiry is not None
        ]
        if witness_ends:
            receipt_surface_predecessor_expiry = min(witness_ends)
        receipt_continuity_gap_s = round(
            max(gap_s for gap_s, _end, _obs, _succ in receipt_surface_gaps.values()),
            1,
        )
        receipt_continuity_degraded = receipt_continuity_gap_s > 0.0
    if admission_freshness_degraded and not args.skip_receipts:
        detail = (
            f"{admission_freshness_at_publication_s:.0f}s remaining at publication"
            if admission_freshness_at_publication_s is not None
            else "no active admission receipt"
        )
        print(
            "hapax-quota-telemetry-writer: DEGRADED — the embedded agy admission will "
            f"not cover the next publication deadline ({detail} against a "
            f"{FRESHNESS_HORIZON_S:.0f}s horizon: {WRITER_CYCLE_S:.0f}s cycle + "
            f"{TIMER_ACCURACY_S:.0f}s timer accuracy + bounded pre-write work); the "
            "quota surface will be stale for the difference. Next: "
            "scripts/hapax-determine --producer agy-review-quota --check --json to see "
            "the producer state, and journalctl --user -u hapax-determine.service for "
            "the mint history.",
            file=sys.stderr,
        )
    if admission_continuity_degraded and not args.skip_receipts:
        print(
            "hapax-quota-telemetry-writer: DEGRADED — coverage gap: published at "
            f"{published_at.isoformat().replace('+00:00', 'Z')} but the immediately "
            "preceding published agy admission expired at "
            f"{continuity_gap_predecessor.isoformat().replace('+00:00', 'Z')} "
            f"({admission_continuity_gap_s:.1f}s gap); the quota surface was dead "
            "for the difference even though this tick's own freshness predicate "
            "passed. Next: journalctl --user -u hapax-quota-telemetry.service "
            "--since -2h to see the intervening tick's pre-publication work, and "
            "scripts/hapax-determine --producer agy-review-quota --check --json to "
            "confirm the mint cadence.",
            file=sys.stderr,
        )
    if receipt_continuity_degraded and not args.skip_receipts:
        worst_platform = max(
            receipt_surface_replacements,
            key=lambda p: (
                receipt_surface_replacements[p][2]
                - (
                    receipt_surface_replacements[p][1]
                    if receipt_surface_replacements[p][1] is not None
                    else receipt_surface_replacements[p][2]
                )
            ).total_seconds(),
        )
        print(
            "hapax-quota-telemetry-writer: DEGRADED — receipt-surface coverage gap: "
            f"{len(receipt_surface_replacements)} refreshed platform receipt(s); worst "
            f"platform {worst_platform} republished at "
            f"{receipt_surface_replacements[worst_platform][2].isoformat().replace('+00:00', 'Z')} "
            "but its predecessor stopped vouching at "
            f"{receipt_surface_replacements[worst_platform][1].isoformat().replace('+00:00', 'Z')} "
            f"({receipt_continuity_gap_s:.1f}s gap); quota routing consumed a dead "
            "capability-receipt surface for the difference even though every ledger "
            "witness passed. Next: journalctl --user -u hapax-quota-telemetry.service "
            "--since -2h to see this tick's per-platform refresh timing, and "
            "scripts/hapax-platform-capability-receipts --all to reproduce the "
            "per-platform refresh cost outside the tick.",
            file=sys.stderr,
        )
    if pre_mint_scan_overrun and not args.skip_receipts:
        print(
            "hapax-quota-telemetry-writer: DEGRADED — pre-mint force-decision scan "
            f"took {pre_mint_scan_elapsed_s:.1f}s against a "
            f"{PRE_MINT_SCAN_BOUND_S:.0f}s bound; the horizon derivation for the "
            "next tick no longer holds. Next: count the accumulated admission "
            "receipts (find ~/.cache/hapax/relay/receipts -maxdepth 1 -name "
            "'*agy-quota-admission*.yaml' | wc -l) — retention/GC is the "
            "follow-up claim this signal exists to justify.",
            file=sys.stderr,
        )

    summary = {
        "ledger_id": ledger.ledger_id,
        "captured_at": ledger.captured_at.isoformat().replace("+00:00", "Z"),
        "published_at": published_at.isoformat().replace("+00:00", "Z"),
        "out": str(out_path),
        "receipts_refreshed": receipts_ok,
        "pull_forward": pull_forward,
        "admission_freshness_at_publication_s": admission_freshness_at_publication_s,
        "admission_freshness_degraded": admission_freshness_degraded,
        "admission_continuity_gap_s": admission_continuity_gap_s,
        "admission_continuity_degraded": admission_continuity_degraded,
        "receipt_continuity_gap_s": receipt_continuity_gap_s,
        "receipt_continuity_degraded": receipt_continuity_degraded,
        "receipt_publication_at": (
            receipt_publication_at.isoformat().replace("+00:00", "Z")
            if receipt_publication_at is not None
            else None
        ),
        "receipt_surface_replaced_platforms": sorted(receipt_surface_replacements),
        "receipt_surface_publication_instants": {
            platform: published.isoformat().replace("+00:00", "Z")
            for platform, (_observed, _expiry, published) in sorted(
                receipt_surface_replacements.items()
            )
        },
        "registry_pools_loaded": (
            static_registry_route_pools_loaded() if not args.skip_receipts else None
        ),
        "receipt_surface_no_named_route_platforms": receipt_surface_no_named_route,
        "receipt_surface_predecessor_expiry": (
            receipt_surface_predecessor_expiry.isoformat().replace("+00:00", "Z")
            if receipt_surface_predecessor_expiry is not None
            else None
        ),
        "previous_promise_fresh_until": (
            previous_promise.isoformat().replace("+00:00", "Z")
            if previous_promise is not None
            else None
        ),
        "pre_mint_scan_elapsed_s": pre_mint_scan_elapsed_s,
        "pre_mint_scan_bound_s": PRE_MINT_SCAN_BOUND_S,
        "pre_mint_scan_overrun": pre_mint_scan_overrun,
        "pre_write_elapsed_s": pre_write_elapsed_s,
        "pre_write_rebuild_elapsed_s": pre_write_rebuild_elapsed_s,
        "pre_write_bound_s": PRE_WRITE_WORK_BOUND_S,
        "freshness_horizon_s": FRESHNESS_HORIZON_S,
        "ledger_rebuilt_after_refresh": ledger_rebuilt_after_refresh,
        "ledger_rebuild_after_refresh_error": ledger_rebuild_after_refresh_error,
        "local_resource_state": resource_state,
        "agy_admissions": len(agy_scan.admissions),
        "agy_ignored_admissions": len(agy_scan.ignored_evidence_refs),
        "kimi_admissions": len(kimi_scan.admissions),
        "kimi_ignored_admissions": len(kimi_scan.ignored_evidence_refs),
        "claude_admissions": len(claude_scan.admissions),
        "claude_ignored_admissions": len(claude_scan.ignored_evidence_refs),
        "glmcp_admissions": len(glmcp_scan.admissions),
        "glmcp_ignored_admissions": len(glmcp_scan.ignored_evidence_refs),
        "glmcp_payg_spend_receipts": len(glmcp_payg_spend_scan.receipts),
        "glmcp_ignored_payg_spend_receipts": len(glmcp_payg_spend_scan.ignored_evidence_refs),
        "quota_walls": {platform: len(refs) for platform, refs in sorted(walls.items())},
        "snapshot_count": len(ledger.quota_snapshots),
    }
    if args.json:
        print(json.dumps(summary, sort_keys=True))
    else:
        print(
            "hapax-quota-telemetry-writer: wrote "
            f"{summary['ledger_id']} -> {out_path} "
            f"(resource={resource_state}, walls={summary['quota_walls'] or 'none'}, "
            f"receipts_refreshed={receipts_ok})"
        )
    if ledger_rebuild_after_refresh_error is not None:
        return 1
    if (
        admission_freshness_degraded
        or admission_continuity_degraded
        or receipt_continuity_degraded
        or pre_mint_scan_overrun
    ) and not args.skip_receipts:
        # Distinct from 1 (pass-2 rebuild error) and 3 (receipt refresh
        # failure): the tick published a surface it knows will flap — the exact
        # condition this PR exists to make machine-checkable. Covers all four
        # flap witnesses: remaining lifetime below the horizon, a continuity
        # gap against the previously published admission, a receipt-surface
        # hole between the predecessor receipts' expiry and the refresh's
        # replacement landing, and a pre-mint scan overrun that invalidates
        # the horizon derivation itself. Gated on the stderr messages' own
        # condition: --skip-receipts is the tests' diagnostic mode (no pull,
        # no refresh — production never passes it), and a skip-receipts run
        # must not fail on freshness it declined to enforce, silently or
        # otherwise.
        return 4
    return 0 if receipts_ok else 3


if __name__ == "__main__":
    raise SystemExit(main())
