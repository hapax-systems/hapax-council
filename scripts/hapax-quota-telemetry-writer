@dataclass(frozen=True)
class GlmcpAdmission:
    evidence_ref: str
    fresh_until: datetime
    endpoint: str
    witness_ref: str
    primary_error_class: str | None = None
    quota_wall_evidence_ref: str | None = None


@dataclass(frozen=True)
class GlmcpAdmissionScan:
    admissions: list[GlmcpAdmission]
    ignored_evidence_refs: list[str]


@dataclass(frozen=True)
class AgyAdmission:
    evidence_ref: str
    fresh_until: datetime


@dataclass(frozen=True)
class AgyAdmissionScan:
    admissions: list[AgyAdmission]
    ignored_evidence_refs: list[str]


@dataclass(frozen=True)
class ClaudeAdmission:
    route_id: str
    evidence_ref: str
    observed_at: datetime
    fresh_until: datetime


@dataclass(frozen=True)
