#!/usr/bin/python3 -I
"""Prepare or stop the durable local-judge container by its bound Docker ID."""

from __future__ import annotations

import argparse
import json
import os
import pwd
import re
import stat
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path

DEFAULT_DOCKER = Path("/usr/bin/docker")
DOCKER_HOST = "unix:///var/run/docker.sock"
EXPECTED_NAME = "hapax-local-judge"
ID_RE = re.compile(r"[0-9a-f]{64}")
SHA_RE = re.compile(rb"[0-9a-f]{40}\n\Z")
IMAGE_RE = re.compile(r"[a-z0-9./_-]+@sha256:[0-9a-f]{64}")
DEFAULT_MODEL_ROOT = Path("/store-fast/hapax-models/sha256")
TEST_MODE_ENV = "HAPAX_LOCAL_JUDGE_CONTAINER_ID_TEST_MODE"
CAP_RECEIPT_MAX_BYTES = 2048


class LifecycleError(RuntimeError):
    pass


@dataclass(frozen=True)
class Cidfile:
    path: Path
    container_id: str
    device: int
    inode: int


@dataclass(frozen=True)
class ModelIdentity:
    device: int
    inode: int
    ctime_ns: int
    size_bytes: int

    def receipt_value(self) -> str:
        return f"{self.device}:{self.inode}:{self.ctime_ns}"


def _refuse(reason: str, action: str) -> LifecycleError:
    return LifecycleError(f"{reason}; next action: {action}")


def _docker_env() -> dict[str, str]:
    account = pwd.getpwuid(os.getuid())
    return {
        "DOCKER_HOST": DOCKER_HOST,
        "HOME": account.pw_dir,
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "LOGNAME": account.pw_name,
        "PATH": "/usr/bin:/bin",
        "USER": account.pw_name,
    }


def _run_docker(docker: Path, *args: str) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            [str(docker), *args],
            capture_output=True,
            text=True,
            check=False,
            env=_docker_env(),
            timeout=20,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess(
            [str(docker), *args], 127, "", f"docker invocation failed: {exc}"
        )


def _safe_model_inode(path: Path, *, owner_uid: int, directory: bool) -> os.stat_result:
    try:
        inode = path.lstat()
    except OSError as exc:
        raise _refuse(
            f"cannot inspect local-judge model path {path}: {exc}",
            "rerun the authorized model-staging canary for this exact release",
        ) from exc
    expected_type = stat.S_ISDIR if directory else stat.S_ISREG
    if (
        not expected_type(inode.st_mode)
        or path.is_symlink()
        or inode.st_uid != owner_uid
        or inode.st_mode & 0o022
        or (not directory and (inode.st_nlink != 1 or stat.S_IMODE(inode.st_mode) != 0o444))
    ):
        kind = "directory" if directory else "mode-0444 single-link file"
        raise _refuse(
            f"local-judge model path is not a trusted owner-{owner_uid} {kind}: {path}",
            "quarantine the drifted path and rerun the authorized model-staging canary",
        )
    return inode


def _production_state_root() -> Path:
    account = pwd.getpwuid(os.getuid())
    return Path(account.pw_dir) / ".local/state/hapax/root-required"


def _safe_state_directory(
    path: Path, *, label: str, owner_uid: int, exact_mode: int | None = None
) -> None:
    try:
        inode = path.lstat()
        resolved = path.resolve(strict=True)
    except OSError as exc:
        raise _refuse(
            f"cannot inspect {label} {path}: {exc}",
            "restore the caller-owned root-required state and rerun the cap canary",
        ) from exc
    if (
        not path.is_absolute()
        or resolved != path
        or not stat.S_ISDIR(inode.st_mode)
        or inode.st_uid != owner_uid
        or inode.st_mode & 0o022
        or (exact_mode is not None and stat.S_IMODE(inode.st_mode) != exact_mode)
    ):
        expected_mode = f" mode-{exact_mode:04o}" if exact_mode is not None else ""
        raise _refuse(
            f"{label} is not a canonical owner-{owner_uid}{expected_mode} directory: {path}",
            "quarantine the drifted state path and rerun the authorized cap canary",
        )


def _read_state_file(
    path: Path,
    *,
    label: str,
    owner_uid: int,
    max_bytes: int,
    exact_size: int | None = None,
    exact_mode: int | None = None,
) -> bytes:
    try:
        before = path.lstat()
    except OSError as exc:
        raise _refuse(
            f"cannot inspect {label} {path}: {exc}",
            "restore the installed receipt and rerun the authorized cap canary",
        ) from exc

    def trusted(inode: os.stat_result) -> bool:
        return (
            stat.S_ISREG(inode.st_mode)
            and inode.st_uid == owner_uid
            and inode.st_nlink == 1
            and not inode.st_mode & 0o022
            and inode.st_size <= max_bytes
            and (exact_size is None or inode.st_size == exact_size)
            and (exact_mode is None or stat.S_IMODE(inode.st_mode) == exact_mode)
        )

    if not trusted(before):
        raise _refuse(
            f"{label} is not a trusted caller-owned regular file: {path}",
            "restore its governed ownership, mode, and bounded contents, then rerun the cap canary",
        )
    flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(path, flags)
        try:
            opened_before = os.fstat(fd)
            chunks: list[bytes] = []
            size = 0
            while True:
                chunk = os.read(fd, min(65536, max_bytes + 1 - size))
                if not chunk:
                    break
                chunks.append(chunk)
                size += len(chunk)
                if size > max_bytes:
                    raise OSError(f"{label} exceeds {max_bytes} bytes")
            opened_after = os.fstat(fd)
        finally:
            os.close(fd)
        after = path.lstat()
    except OSError as exc:
        raise _refuse(
            f"cannot read {label} safely: {exc}",
            "restore the governed state file and rerun the authorized cap canary",
        ) from exc
    identity = (opened_before.st_dev, opened_before.st_ino)
    stable_sizes = (
        before.st_size,
        opened_before.st_size,
        opened_after.st_size,
        after.st_size,
    )
    stable_ctimes = (
        before.st_ctime_ns,
        opened_before.st_ctime_ns,
        opened_after.st_ctime_ns,
        after.st_ctime_ns,
    )
    if (
        not trusted(opened_before)
        or not trusted(opened_after)
        or not trusted(after)
        or identity != (before.st_dev, before.st_ino)
        or identity != (opened_after.st_dev, opened_after.st_ino)
        or identity != (after.st_dev, after.st_ino)
        or len(set(stable_sizes)) != 1
        or len(set(stable_ctimes)) != 1
        or len(b"".join(chunks)) != opened_after.st_size
    ):
        raise _refuse(
            f"{label} changed while it was read",
            "let state publication settle and rerun preflight",
        )
    return b"".join(chunks)


def _model_identity(
    model_root: Path,
    model_host: Path,
    *,
    model_size_bytes: int,
    owner_uid: int,
) -> ModelIdentity:
    _safe_model_inode(model_root, owner_uid=owner_uid, directory=True)
    _safe_model_inode(model_host.parent, owner_uid=owner_uid, directory=True)
    before = _safe_model_inode(model_host, owner_uid=owner_uid, directory=False)
    flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(model_host, flags)
        try:
            opened = os.fstat(fd)
        finally:
            os.close(fd)
        after = model_host.lstat()
    except OSError as exc:
        raise _refuse(
            f"cannot open the staged local-judge model safely: {exc}",
            "rerun the authorized model-staging canary",
        ) from exc
    identity = (opened.st_dev, opened.st_ino)
    if (
        identity != (before.st_dev, before.st_ino)
        or identity != (after.st_dev, after.st_ino)
        or opened.st_size != model_size_bytes
        or before.st_size != model_size_bytes
        or after.st_size != model_size_bytes
        or opened.st_ctime_ns != before.st_ctime_ns
        or opened.st_ctime_ns != after.st_ctime_ns
    ):
        raise _refuse(
            "local-judge model identity or measured size changed",
            "stop activation, quarantine the model path, and rerun the authorized canary",
        )
    return ModelIdentity(opened.st_dev, opened.st_ino, opened.st_ctime_ns, opened.st_size)


def _verify_cap_attestation(
    state_root: Path,
    *,
    image: str,
    model_host: Path,
    model_sha256: str,
    model_size_bytes: int,
    model_identity: ModelIdentity,
) -> str:
    owner_uid = os.getuid()
    _safe_state_directory(state_root, label="root-required state root", owner_uid=owner_uid)
    installed_root = state_root / "installed-receipts"
    _safe_state_directory(installed_root, label="installed-receipt directory", owner_uid=owner_uid)
    installed = installed_root / "oom-containment.sha"
    installed_bytes = _read_state_file(
        installed,
        label="installed OOM receipt",
        owner_uid=owner_uid,
        max_bytes=41,
        exact_size=41,
    )
    if SHA_RE.fullmatch(installed_bytes) is None:
        raise _refuse(
            "installed OOM receipt does not contain one exact lowercase commit SHA",
            "restore the installed receipt through the authenticated OOM package",
        )
    installed_sha = installed_bytes[:-1].decode("ascii")
    cap_root = state_root / "local-judge-cap-canary"
    _safe_state_directory(
        cap_root,
        label="local-judge cap receipt directory",
        owner_uid=owner_uid,
        exact_mode=0o700,
    )
    cap_receipt = cap_root / f"{installed_sha}.env"
    receipt_bytes = _read_state_file(
        cap_receipt,
        label="local-judge cap receipt",
        owner_uid=owner_uid,
        max_bytes=CAP_RECEIPT_MAX_BYTES,
        exact_mode=0o600,
    )
    try:
        receipt_text = receipt_bytes.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise _refuse(
            "local-judge cap receipt is not UTF-8",
            "discard the malformed receipt and rerun the authorized cap canary",
        ) from exc
    if not receipt_text.endswith("\n"):
        raise _refuse(
            "local-judge cap receipt is not newline-terminated",
            "discard the malformed receipt and rerun the authorized cap canary",
        )
    fields: dict[str, str] = {}
    for line in receipt_text.splitlines():
        key, separator, value = line.partition("=")
        if not separator or not key or not value or key in fields:
            raise _refuse(
                "local-judge cap receipt contains a malformed or duplicate field",
                "discard the malformed receipt and rerun the authorized cap canary",
            )
        fields[key] = value
    expected_fields = {
        "schema": "1",
        "candidate_sha": installed_sha,
        "image_ref": image,
        "model_sha256": model_sha256,
        "model_size_bytes": str(model_size_bytes),
        "model_host_dir": str(model_host.parent),
        "model_identity": model_identity.receipt_value(),
    }
    for key, expected in expected_fields.items():
        if fields.get(key) != expected:
            raise _refuse(
                f"local-judge cap receipt {key} does not match the installed unit or model",
                "stop activation and rerun the authorized exact-SHA cap canary",
            )
    return installed_sha


def preflight(
    docker: Path,
    *,
    image: str,
    model_host: Path,
    model_sha256: str,
    model_size_bytes: int,
    model_root: Path,
    state_root: Path,
    test_mode: bool,
) -> None:
    if IMAGE_RE.fullmatch(image) is None:
        raise _refuse(
            f"local-judge image is not pinned by registry digest: {image or 'empty'}",
            "restore JUDGE_IMAGE to the canary-accepted digest",
        )
    if ID_RE.fullmatch(model_sha256) is None or model_size_bytes <= 0:
        raise _refuse(
            "local-judge model digest or size is malformed",
            "restore the canary-measured JUDGE_MODEL_SHA256 and JUDGE_MODEL_SIZE_BYTES",
        )
    if not model_root.is_absolute() or not model_host.is_absolute():
        raise _refuse(
            "local-judge model paths must be absolute",
            "restore the governed content-addressed model path",
        )
    expected = model_root / model_sha256 / model_host.name
    if model_host != expected or model_host.resolve(strict=False) != expected:
        raise _refuse(
            f"local-judge model is outside its exact content address: {model_host}",
            f"stage it under {model_root / model_sha256} through the authorized canary",
        )
    owner_uid = os.getuid() if test_mode else 0
    identity = _model_identity(
        model_root,
        expected,
        model_size_bytes=model_size_bytes,
        owner_uid=owner_uid,
    )
    attested_sha = _verify_cap_attestation(
        state_root,
        image=image,
        model_host=expected,
        model_sha256=model_sha256,
        model_size_bytes=model_size_bytes,
        model_identity=identity,
    )
    result = _run_docker(docker, "image", "inspect", "--format", "{{json .RepoDigests}}", image)
    if result.returncode != 0:
        raise _refuse(
            f"pinned local-judge image is not staged: {(result.stderr or result.stdout).strip() or image}",
            "restore Docker access and pre-pull this exact digest through the authorized canary",
        )
    try:
        repo_digests = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise _refuse(
            "Docker image inspection returned malformed RepoDigests",
            "restore canonical Docker image metadata and rerun the canary",
        ) from exc
    if not isinstance(repo_digests, list) or image not in repo_digests:
        raise _refuse(
            f"staged Docker image does not advertise the governed digest {image}",
            "remove the ambiguous image and pre-pull the exact digest through the authorized canary",
        )
    final_identity = _model_identity(
        model_root,
        expected,
        model_size_bytes=model_size_bytes,
        owner_uid=owner_uid,
    )
    final_attested_sha = _verify_cap_attestation(
        state_root,
        image=image,
        model_host=expected,
        model_sha256=model_sha256,
        model_size_bytes=model_size_bytes,
        model_identity=final_identity,
    )
    if final_identity != identity or final_attested_sha != attested_sha:
        raise _refuse(
            "local-judge model or cap attestation changed during preflight",
            "let state publication settle and rerun preflight",
        )
    print(
        f"local-judge preflight accepted image={image} model={model_sha256} "
        f"size={model_size_bytes} attestation_sha={attested_sha}"
    )


def _canonical_cidfile(path: Path, *, test_mode: bool) -> Path:
    if not path.is_absolute():
        raise _refuse(
            f"cidfile path is not absolute: {path}",
            "restore the unit's %t/hapax-local-judge/container.cid argument",
        )
    expected = Path(f"/run/user/{os.getuid()}/hapax-local-judge/container.cid")
    resolved = path.resolve(strict=False)
    if not test_mode and resolved != expected:
        raise _refuse(
            f"cidfile path is not the canonical user-runtime path: {resolved}",
            f"restore the unit argument to {expected}",
        )
    return resolved


def _read_cidfile(path: Path) -> Cidfile | None:
    try:
        before = path.lstat()
    except FileNotFoundError:
        return None
    except OSError as exc:
        raise _refuse(
            f"cannot inspect local-judge cidfile {path}: {exc}",
            "repair the user runtime directory and retry the unit operation",
        ) from exc
    if (
        not stat.S_ISREG(before.st_mode)
        or before.st_uid != os.getuid()
        or before.st_nlink != 1
        or before.st_mode & 0o022
        or before.st_size != 64
    ):
        raise _refuse(
            f"local-judge cidfile is not a safe caller-owned 64-byte regular file: {path}",
            "inspect the runtime directory without deleting an unknown container, then restore the unit-owned cidfile",
        )
    try:
        fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
        try:
            opened = os.fstat(fd)
            data = os.read(fd, 65)
        finally:
            os.close(fd)
        after = path.lstat()
    except OSError as exc:
        raise _refuse(
            f"cannot read local-judge cidfile safely: {exc}",
            "inspect the runtime directory and retry without acting on a container name",
        ) from exc
    identity = (opened.st_dev, opened.st_ino)
    if identity != (before.st_dev, before.st_ino) or identity != (after.st_dev, after.st_ino):
        raise _refuse(
            "local-judge cidfile changed while it was read",
            "let container churn settle and retry the unit operation",
        )
    try:
        text = data.decode("ascii")
    except UnicodeDecodeError as exc:
        raise _refuse(
            "local-judge cidfile is not ASCII",
            "inspect the runtime directory and restore the Docker-written cidfile",
        ) from exc
    if ID_RE.fullmatch(text) is None:
        raise _refuse(
            "local-judge cidfile does not contain exactly one full Docker ID",
            "inspect the runtime directory and restore the Docker-written cidfile",
        )
    return Cidfile(path, text, before.st_dev, before.st_ino)


def _inspect_identity(docker: Path, container_id: str) -> tuple[str, str] | None:
    result = _run_docker(docker, "inspect", "--format", "{{.Id}}|{{.Name}}", container_id)
    if result.returncode != 0:
        return None
    output = result.stdout.strip()
    if "\n" in output or output.count("|") != 1:
        raise _refuse(
            f"Docker inspect returned an ambiguous identity for {container_id}",
            "restore Docker inspection and inspect the immutable ID manually",
        )
    inspected_id, name = output.split("|", 1)
    name = name.removeprefix("/")
    if inspected_id != container_id or name != EXPECTED_NAME:
        raise _refuse(
            f"cidfile identity mismatch: id={inspected_id or 'empty'} name={name or 'empty'}",
            f"inspect {container_id}; do not stop it unless both the ID and reserved name {EXPECTED_NAME} are reconciled",
        )
    return inspected_id, name


def _id_absent(docker: Path, container_id: str) -> bool:
    result = _run_docker(
        docker,
        "ps",
        "-aq",
        "--no-trunc",
        "--filter",
        f"id={container_id}",
    )
    if result.returncode != 0:
        raise _refuse(
            f"cannot prove Docker ID absence: {(result.stderr or result.stdout).strip() or 'no diagnostic'}",
            "restore access to the pinned Docker daemon and retry without restoring or replacing the unit container",
        )
    ids = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    if any(ID_RE.fullmatch(item) is None for item in ids):
        raise _refuse(
            "Docker absence query returned a malformed ID",
            "restore canonical docker ps output and retry",
        )
    return not ids


def _remove_cidfile(cidfile: Cidfile) -> None:
    try:
        current = cidfile.path.lstat()
    except OSError as exc:
        raise _refuse(
            f"cannot recheck cidfile before cleanup: {exc}",
            "inspect the runtime path and remove only the stale, unit-owned cidfile",
        ) from exc
    if (current.st_dev, current.st_ino) != (cidfile.device, cidfile.inode):
        raise _refuse(
            "cidfile identity changed before cleanup",
            "inspect the replacement cidfile and its immutable Docker ID before retrying",
        )
    try:
        cidfile.path.unlink()
    except OSError as exc:
        raise _refuse(
            f"cannot remove proven-stale cidfile: {exc}",
            f"remove only {cidfile.path} after confirming ID {cidfile.container_id} is absent",
        ) from exc


def prepare(cidfile_path: Path, docker: Path, *, test_mode: bool) -> None:
    cidfile = _read_cidfile(_canonical_cidfile(cidfile_path, test_mode=test_mode))
    if cidfile is None:
        return
    identity = _inspect_identity(docker, cidfile.container_id)
    if identity is not None or not _id_absent(docker, cidfile.container_id):
        raise _refuse(
            f"unit-owned local-judge container still exists: {cidfile.container_id}",
            f"stop and inspect immutable ID {cidfile.container_id}, then rerun the unit start",
        )
    _remove_cidfile(cidfile)
    print(f"removed stale local-judge cidfile for absent ID {cidfile.container_id}")


def stop(cidfile_path: Path, docker: Path, *, test_mode: bool) -> None:
    cidfile = _read_cidfile(_canonical_cidfile(cidfile_path, test_mode=test_mode))
    if cidfile is None:
        print("local-judge cidfile absent; no unit-owned container to stop")
        return
    if _inspect_identity(docker, cidfile.container_id) is not None:
        result = _run_docker(docker, "stop", cidfile.container_id)
        if result.returncode != 0 and not _id_absent(docker, cidfile.container_id):
            raise _refuse(
                f"Docker stop failed for immutable ID {cidfile.container_id}: "
                f"{(result.stderr or result.stdout).strip() or 'no diagnostic'}",
                "inspect and stop that exact ID manually; do not act on the mutable container name",
            )
    for _ in range(50):
        if _id_absent(docker, cidfile.container_id):
            _remove_cidfile(cidfile)
            print(f"stopped local-judge immutable ID {cidfile.container_id}")
            return
        time.sleep(0.1)
    raise _refuse(
        f"local-judge immutable ID remains after stop: {cidfile.container_id}",
        "inspect that exact ID and keep the cidfile until absence is proven",
    )


def main(argv: list[str] | None = None) -> int:
    production_state_root = _production_state_root()
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("preflight", "prepare", "stop"))
    parser.add_argument("--cidfile", type=Path, required=True)
    parser.add_argument("--docker", type=Path, default=DEFAULT_DOCKER, help=argparse.SUPPRESS)
    parser.add_argument("--image")
    parser.add_argument("--model-host", type=Path)
    parser.add_argument("--model-sha256")
    parser.add_argument("--model-size-bytes", type=int)
    parser.add_argument(
        "--model-root", type=Path, default=DEFAULT_MODEL_ROOT, help=argparse.SUPPRESS
    )
    parser.add_argument(
        "--state-root", type=Path, default=production_state_root, help=argparse.SUPPRESS
    )
    args = parser.parse_args(argv)
    test_mode = os.environ.get(TEST_MODE_ENV) == "1"
    if (
        args.docker != DEFAULT_DOCKER
        or args.model_root != DEFAULT_MODEL_ROOT
        or args.state_root != production_state_root
    ) and not test_mode:
        parser.error(
            "--docker, --model-root, and --state-root overrides are test-only; next action: use the pinned production paths"
        )
    try:
        if args.action == "preflight":
            if (
                args.image is None
                or args.model_host is None
                or args.model_sha256 is None
                or args.model_size_bytes is None
            ):
                parser.error(
                    "preflight requires --image, --model-host, --model-sha256, and --model-size-bytes; next action: restore the governed unit arguments"
                )
            if test_mode:
                test_state_root = args.state_root.resolve(strict=False)
                canonical_production_root = production_state_root.resolve(strict=False)
                if (
                    test_state_root == canonical_production_root
                    or test_state_root.is_relative_to(canonical_production_root)
                    or canonical_production_root.is_relative_to(test_state_root)
                ):
                    parser.error(
                        "preflight test mode requires an isolated --state-root; next action: use a test-owned temporary directory"
                    )
            preflight(
                args.docker,
                image=args.image,
                model_host=args.model_host,
                model_sha256=args.model_sha256,
                model_size_bytes=args.model_size_bytes,
                model_root=args.model_root,
                state_root=args.state_root,
                test_mode=test_mode,
            )
        elif args.action == "prepare":
            prepare(args.cidfile, args.docker, test_mode=test_mode)
        else:
            stop(args.cidfile, args.docker, test_mode=test_mode)
    except LifecycleError as exc:
        print(f"hapax-local-judge-container-id: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
