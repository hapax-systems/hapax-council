#!/usr/bin/env bash
# hapax-glmcp-claude - run Claude Code through the Z.ai GLM Coding Plan lane.
#
# This wrapper is intentionally session-scoped. It does not edit
# ~/.claude/settings.json and it never writes the Z.ai key to disk.
# It is separate from the glmcp.review.direct review route, whose admission
# receipts are bound to scripts/hapax-glmcp-reviewer and its Coding Plan model id.

set -euo pipefail

usage() {
  cat <<'EOF'
usage: hapax-glmcp-claude [--check] [claude args...]

Runs Claude Code with GLM Coding Plan environment variables for this invocation.
The Z.ai API key is read from pass at runtime.

Defaults:
  pass entry: glmcp/api-key
  base URL:   https://api.z.ai/api/anthropic
  model:      glm-5.2[1m]

Environment overrides:
  HAPAX_GLMCP_SECRET_ENTRY       pass entry name (default: glmcp/api-key)
  HAPAX_GLMCP_MODEL              primary GLM model (default: glm-5.2[1m])
  HAPAX_GLMCP_HAIKU_MODEL        Haiku/default-light mapping (default: glm-4.5-air)
  HAPAX_GLMCP_ANTHROPIC_BASE_URL endpoint override, gated to the Z.ai API host
  HAPAX_GLMCP_ALLOW_NON_CODING_PLAN_MODEL=1 allow a non-docs-pinned primary model
  HAPAX_GLMCP_ALLOW_SECRET_ENTRY_OVERRIDE=1 allow a reviewed glmcp/* pass entry
  HAPAX_GLMCP_ALLOW_BASE_URL_OVERRIDE=1 allow a reviewed endpoint override

Recheck:
  hapax-glmcp-claude --check
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

check_only=false
if [[ "${1:-}" == "--check" ]]; then
  check_only=true
  shift
fi

default_secret_entry="glmcp/api-key"
secret_entry="${HAPAX_GLMCP_SECRET_ENTRY:-$default_secret_entry}"
official_base_url="https://api.z.ai/api/anthropic"
base_url="${HAPAX_GLMCP_ANTHROPIC_BASE_URL:-$official_base_url}"
primary_model="${HAPAX_GLMCP_MODEL:-glm-5.2[1m]}"
haiku_model="${HAPAX_GLMCP_HAIKU_MODEL:-glm-4.5-air}"
pass_error_file=""

cleanup() {
  if [[ -n "${pass_error_file:-}" ]]; then
    rm -f "$pass_error_file"
  fi
}

exit_after_signal() {
  status="$1"
  cleanup
  trap - EXIT HUP INT TERM
  exit "$status"
}

valid_glmcp_secret_entry() {
  local candidate="$1"
  local segment
  local -a segments
  [[ "$candidate" == glmcp/* ]] || return 1
  [[ "$candidate" != */ ]] || return 1
  [[ "$candidate" != *[[:space:]]* ]] || return 1
  IFS=/ read -r -a segments <<<"$candidate"
  for segment in "${segments[@]}"; do
    [[ -n "$segment" && "$segment" != "." && "$segment" != ".." ]] || return 1
  done
  return 0
}

trap cleanup EXIT
trap 'exit_after_signal 129' HUP
trap 'exit_after_signal 130' INT
trap 'exit_after_signal 143' TERM

case "$primary_model" in
  "glm-5.2[1m]") ;;
  *)
    if [[ "${HAPAX_GLMCP_ALLOW_NON_CODING_PLAN_MODEL:-0}" != "1" ]]; then
      echo "hapax-glmcp-claude: refusing primary model '$primary_model'; expected documented GLM Coding Plan model id glm-5.2[1m]" >&2
      echo "hapax-glmcp-claude: next action: unset HAPAX_GLMCP_MODEL or set it to glm-5.2[1m] for the sanctioned Claude Code GLMCP lane." >&2
      echo "Set HAPAX_GLMCP_ALLOW_NON_CODING_PLAN_MODEL=1 only for explicit experiments after rechecking Z.ai Coding Plan docs." >&2
      exit 2
    fi
    ;;
esac

if [[ "$secret_entry" != "$default_secret_entry" ]]; then
  if [[ "${HAPAX_GLMCP_ALLOW_SECRET_ENTRY_OVERRIDE:-0}" != "1" ]]; then
    echo "hapax-glmcp-claude: refusing pass entry '$secret_entry'; expected $default_secret_entry" >&2
    echo "Set HAPAX_GLMCP_ALLOW_SECRET_ENTRY_OVERRIDE=1 only after reviewing the GLMCP-specific pass entry." >&2
    exit 8
  fi
  if ! valid_glmcp_secret_entry "$secret_entry"; then
    echo "hapax-glmcp-claude: refused pass entry '$secret_entry'; this launcher only reads non-traversing glmcp/* secrets." >&2
    echo "For other providers or experiments, use a separate launcher and secret entry." >&2
    exit 8
  fi
fi

case "$base_url" in
  "$official_base_url"|"$official_base_url/") ;;
  *)
    if [[ "${HAPAX_GLMCP_ALLOW_BASE_URL_OVERRIDE:-0}" != "1" ]]; then
      echo "hapax-glmcp-claude: refusing base URL '$base_url'; expected $official_base_url" >&2
      echo "Set HAPAX_GLMCP_ALLOW_BASE_URL_OVERRIDE=1 only after reviewing the endpoint that will receive the pass-backed token." >&2
      exit 7
    fi
    case "$base_url" in
      https://api.z.ai/*) ;;
      *)
        echo "hapax-glmcp-claude: refused base URL '$base_url'; this launcher only sends the pass-backed token to https://api.z.ai/" >&2
        echo "For non-Z.ai experiments, use a separate launcher and secret entry instead of this GLM Coding Plan lane." >&2
        exit 7
        ;;
    esac
    ;;
esac

# The Z.ai key has TWO possible homes and the launcher must survive it moving between them.
# Measured 2026-08-26: appendix's `pass` held NO glmcp entry while podium's did, and the FileStore
# behind `hapax-secret` held `glmcp-api-key` on both. This launcher demanded `pass` and so refused
# to start on appendix — which silently retired the estate's sanctioned GLM harness on this host
# and led to GLM being re-harnessed onto opencode instead of the lookup being repaired.
#
# `hapax-secret` is the SSOT the estate is migrating to (#4604); `pass` is the legacy per-host
# store. This is a lookup across two known stores, not a widening fallback: both branches read one
# secret and nothing else, each precondition is checkable at the moment of use (does this store
# return a non-empty first line), and if neither yields the launcher refuses naming both.
if ! command -v hapax-secret >/dev/null 2>&1 && ! command -v pass >/dev/null 2>&1; then
  echo "hapax-glmcp-claude: neither 'hapax-secret' nor 'pass' is on PATH; one must hold the Z.ai API key." >&2
  exit 3
fi
command -v claude >/dev/null 2>&1 || {
  echo "hapax-glmcp-claude: claude is not on PATH; install Claude Code or add the claude binary to PATH." >&2
  exit 4
}

case "$-" in
  *x*)
    # Once the pass-backed token enters the environment, keep shell tracing off
    # for this process. The wrapper execs Claude Code, so there is no caller
    # shell state to restore.
    set +x
    ;;
esac

# FileStore first, then pass. Both are read into a subshell whose stderr is discarded: a
# secret-store diagnostic can echo the value or its neighbourhood, and this process is about to
# exec Claude Code, so a leaked line would outlive the launcher.
filestore_entry="${HAPAX_GLMCP_FILESTORE_ENTRY:-glmcp-api-key}"
auth_token=""
token_source=""

if command -v hapax-secret >/dev/null 2>&1; then
  auth_token="$(hapax-secret "$filestore_entry" 2>/dev/null | sed -n '1p')"
  [[ -n "$auth_token" ]] && token_source="hapax-secret:$filestore_entry"
fi

if [[ -z "$auth_token" ]] && command -v pass >/dev/null 2>&1; then
  auth_token="$(pass show "$secret_entry" 2>/dev/null | sed -n '1p')"
  [[ -n "$auth_token" ]] && token_source="pass:$secret_entry"
fi

if [[ -z "$auth_token" ]]; then
  echo "hapax-glmcp-claude: no Z.ai API key found." >&2
  echo "hapax-glmcp-claude: tried FileStore entry '$filestore_entry' (hapax-secret --list) and pass entry '$secret_entry' (pass ls)." >&2
  echo "hapax-glmcp-claude: store stderr was suppressed to avoid replaying secret-adjacent diagnostics." >&2
  echo "hapax-glmcp-claude: next action: hapax-secret put '$filestore_entry' at a TTY on the FileStore host." >&2
  exit 5
fi

export ANTHROPIC_BASE_URL="$base_url"
export API_TIMEOUT_MS="${API_TIMEOUT_MS:-3000000}"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="${CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC:-1}"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="${CLAUDE_CODE_AUTO_COMPACT_WINDOW:-1000000}"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$primary_model"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$primary_model"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$haiku_model"
export HAPAX_LLM_PROVIDER="zai-glm-coding-plan"

if [[ "$check_only" == true ]]; then
  unset auth_token
  if ! claude_version="$(env -u ANTHROPIC_AUTH_TOKEN claude --version)"; then
    echo "hapax-glmcp-claude: claude --version failed; verify Claude Code runs before using the GLMCP lane." >&2
    exit 9
  fi
  printf 'hapax-glmcp-claude: ok secret=available base_url=%s primary_model=%s compact_window=%s\n' \
    "$base_url" "$primary_model" "$CLAUDE_CODE_AUTO_COMPACT_WINDOW"
  printf '%s\n' "$claude_version"
  exit 0
fi

export ANTHROPIC_AUTH_TOKEN="$auth_token"
unset auth_token

exec claude "$@"
