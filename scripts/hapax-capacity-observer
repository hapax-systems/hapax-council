#!/usr/bin/env bash
# hapax-capacity-observer — append one JSON line of estate capacity state (read-only).
#
# Brought into council source and extended for the resource-state producer
# (estate-resource-state-determinative-projection-20261004): per-card VRAM (total/used/free/util),
# loaded models from /v1/models per endpoint, per-host fleet memory, with hearth hosts classed
# separately. It records only ALREADY-OBSERVABLE state and never invokes a paid model, so running it
# costs nothing. shared/resource_state_producer.py reduces its output to reins_context facts.
set -uo pipefail
OUT="${HAPAX_CAPACITY_OBS:-$HOME/.cache/hapax/capacity-observations.jsonl}"
mkdir -p "$(dirname "$OUT")"
python3 - "$OUT" <<'PY'
import datetime
import glob
import json
import os
import subprocess
import sys
import time

out = sys.argv[1]
now = datetime.datetime.now(datetime.UTC).replace(microsecond=0).isoformat().replace("+00:00", "Z")

HEARTH_HOSTS = {"beelink1"}
FLEET = ("gx10-b941", "spark-01df", "beelink1", "evo-x2", "evo-x2-2", "hapax-podium")
ENDPOINTS = (5000, 5001, 8000, 11434)


def sh(c, t=25):
    try:
        return subprocess.run(c, shell=True, capture_output=True, text=True, timeout=t).stdout.strip()
    except Exception:
        return ""


rec = {"ts": now}
# The host that actually ran the observer, so the producer attributes local GPUs/endpoints to it
# rather than a hard-coded 'appendix' (review #5027 major 4).
rec["host"] = (sh("hostname -s 2>/dev/null") or os.uname().nodename or "localhost").strip()

# admission receipt freshness per route (free)
rr = os.path.expanduser("~/.cache/hapax/relay/receipts")
fresh = {}
for pat, key in (
    ("claude-subscription-quota-admission-*", "claude"),
    ("agy-quota-admission-*", "agy"),
    ("glmcp-quota-admission-*", "glm"),
    ("codex-*admission*", "codex"),
):
    fs = sorted(glob.glob(os.path.join(rr, pat)), key=os.path.getmtime, reverse=True)
    fresh[key] = {"newest_age_s": int(time.time() - os.path.getmtime(fs[0])) if fs else None, "count": len(fs)}
rec["admission_receipts"] = fresh

# lanes + claude procs
rec["lanes"] = [s for s in sh("tmux ls -F '#{session_name}' 2>/dev/null").splitlines() if s]
rec["claude_procs"] = len([_ for _ in sh("pgrep -af 'npm-global/bin/claude' || true").splitlines() if _])

# local GPUs: name,total,used (back-compat line) PLUS per-card detail (the per-card-VRAM fix)
rec["gpus"] = [
    line for line in sh(
        "nvidia-smi --query-gpu=name,memory.total,memory.used --format=csv,noheader 2>/dev/null"
    ).splitlines() if line
]
rec["gpus_percard"] = [
    line for line in sh(
        "nvidia-smi --query-gpu=index,name,memory.total,memory.used,memory.free,utilization.gpu "
        "--format=csv,noheader 2>/dev/null"
    ).splitlines() if line
]

# fleet memory (hearth classed separately)
fleet = {}
for h in FLEET:
    o = sh(
        f"timeout 8 ssh -o BatchMode=yes -o ConnectTimeout=5 {h} "
        f"\"free -m | awk '/Mem:/{{print \\$2\\\",\\\"\\$7}}'\" 2>/dev/null", 12
    )
    entry = {"owner": "hearth" if h in HEARTH_HOSTS else "hapax"}
    if o and "," in o:
        t, a = o.split(",")[:2]
        try:
            entry.update(total_mb=int(t), avail_mb=int(a))
        except ValueError:
            entry["raw"] = o
        fleet[h] = entry
    else:
        fleet[h] = None  # unreachable -> DARK in the producer
rec["fleet_memory"] = fleet

# local serving endpoints: alive flag + loaded model ids (the WHY join reads these)
endpoints = {}
http_statuses = {}
loaded = {}
metadata = {}


def scalar(value):
    # Malformed composite values may contain unrelated bodies. Retain an unsupported-type marker
    # rather than persist those bodies; the producer refuses that field instead of guessing.
    return value if value is None or isinstance(value, (str, int, float, bool)) else []


for p in ENDPOINTS:
    # Keep HTTP refusal distinct from transport failure. Never retain error bodies or stderr.
    # A completed 2xx transfer still needs a valid model listing before it is called alive.
    status = None
    body = ""
    complete = False
    endpoints[str(p)] = None
    try:
        response = subprocess.run(
            ["curl", "--silent", "--max-time", "4", "--write-out", "\n%{http_code}",
             f"http://localhost:{p}/v1/models"],
            capture_output=True, text=True, timeout=8,
        )
        body, _, code = response.stdout.rpartition("\n")
        status = int(code) if code.isdigit() and 100 <= int(code) <= 599 else None
        complete = response.returncode == 0 and status is not None and 200 <= status < 300
        if response.returncode != 0 and status is None:
            endpoints[str(p)] = False
    except subprocess.TimeoutExpired:
        endpoints[str(p)] = False
    except OSError:
        pass  # unavailable local probe is unknown, not evidence of a dead endpoint
    http_statuses[str(p)] = status
    observed_at = datetime.datetime.now(datetime.UTC).isoformat().replace("+00:00", "Z")
    loaded[str(p)] = []
    if not complete:
        continue
    try:
        payload = json.loads(body) if body else None
        data = payload.get("data") if isinstance(payload, dict) else None
        if not isinstance(data, list) or any(
            not isinstance(m, dict) or not isinstance(m.get("id"), str) or not m["id"].strip()
            for m in data
        ):
            continue
        endpoints[str(p)] = True
        loaded[str(p)] = list(dict.fromkeys(m["id"] for m in data))
        # Preserve only resource metadata, never arbitrary endpoint response bodies. Keep duplicate
        # model records here so the producer can surface conflicting fields rather than choose one.
        records = []
        for model in data:
            record = {k: scalar(model[k]) for k in ("id", "owned_by", "max_model_len") if k in model}
            meta = model.get("meta")
            if isinstance(meta, dict):
                record["meta"] = {k: scalar(meta[k]) for k in (
                    "n_ctx", "n_ctx_train", "ftype", "n_embd", "n_params", "size"
                ) if k in meta}
            elif meta is not None:
                record["meta"] = []  # unsupported format remains explicit, without arbitrary bodies
            records.append(record)
        metadata[str(p)] = {"observed_at": observed_at, "data": records}
    except (ValueError, TypeError):
        pass
rec["local_endpoints"] = endpoints
rec["endpoint_http_status"] = http_statuses
rec["loaded_models"] = loaded
rec["model_metadata"] = metadata

# process inspection: serving stacks actually running (the producer pairs these with /v1/models ids
# so "loaded" is an observed model + process, never a RAM-occupancy inference).
rec["serving_procs"] = [
    line for line in sh(
        "pgrep -af 'vllm|tabbyapi|tabbyAPI|llama-server|llama.cpp|ollama|sglang|text-generation' || true"
    ).splitlines() if line
]

with open(out, "a", encoding="utf-8") as f:
    f.write(json.dumps(rec) + "\n")
print(f"capacity-observer: appended {now}")
PY
