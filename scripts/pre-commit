#!/usr/bin/env bash
# git pre-commit hook: delegate to the pre-commit framework under the shared hooksPath.
#
# Setting core.hooksPath to the activation scripts directory replaces Git's hook lookup, so the
# framework-generated .git/hooks/pre-commit is not consulted. This tracked hook
# keeps the runbook's commit-time gates working under that one setting by
# invoking the framework's own hook implementation.
set -euo pipefail
hook_dir="$(dirname "$(readlink -f "$0")")"
activation_root="$(dirname "$hook_dir")"
config="$activation_root/.pre-commit-config.yaml"

if [ ! -f "$config" ]; then
  echo "pre-commit: missing activation .pre-commit-config.yaml; refusing" >&2
  echo "Remedy: restore the activation worktree config at $config, or point core.hooksPath at a valid activation scripts directory." >&2
  exit 1
fi

if [ -x "$activation_root/.venv/bin/pre-commit" ]; then
  framework="$activation_root/.venv/bin/pre-commit"
elif command -v pre-commit >/dev/null 2>&1; then
  framework="$(command -v pre-commit)"
else
  echo "pre-commit: the pre-commit CLI is not on PATH; refusing" >&2
  echo "Remedy: restore the activation environment or install the CLI (see docs/runbooks/pre-commit-bootstrap.md)." >&2
  exit 1
fi

exec "$framework" hook-impl \
  --config="$config" \
  --hook-type=pre-commit \
  -- "$@"
