os.environ["PATH"] = SAFE_PATH

BYTES_1G = 1024**3
BYTES_2G = 2 * 1024**3
BYTES_12G = 12 * 1024**3
BYTES_24G = 24 * 1024**3
BYTES_16G = 16 * 1024**3
BYTES_8G = 8 * 1024**3
BYTES_10G = 10 * 1024**3
BYTES_20G = 20 * 1024**3
BYTES_512M = 512 * 1024**2
BYTES_768M = 768 * 1024**2
NEXT_OOM_ACTION = (
    "next action: preserve the drift evidence and dispatch separately runtime-authorized "
    "root-broker work; this source revision has no production install or authoritative "
    "live-verification mode"
)
PROC_ROOT = Path(os.environ.get("HAPAX_OOM_AUDIT_PROC_ROOT", "/proc"))
