        target_text = "infinity" if target is None else str(target)
        status = "pass" if actual == target_text else "gap"
        detail = (
            ""
            if status == "pass"
            else f"user.slice ancestor reservation drifted; {NEXT_OOM_INSTALL}"
        )
        checks.append(Check(f"user_slice_{key}", status, target_text, actual, detail))
    return checks


def _proc_oom_score(pid: str) -> int | None:
    try:
        return int((PROC_ROOT / pid / "oom_score_adj").read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return None


def _proc_cgroups(pid: str) -> list[str]:
    try:
        lines = (PROC_ROOT / pid / "cgroup").read_text(encoding="utf-8").splitlines()
    except OSError:
        return []
    paths: list[str] = []
    for line in lines:
        parts = line.split(":", 2)
        if len(parts) == 3 and parts[2].startswith("/"):
            paths.append(parts[2])
    return paths


def _pid_matches_cgroup(pid: str, cgroup: str) -> bool:
    if not cgroup.startswith("/"):
        return False
    prefix = f"{cgroup.rstrip('/')}/"
    return any(path == cgroup or path.startswith(prefix) for path in _proc_cgroups(pid))


def _cgroup_pids(cgroup: str) -> list[str]:
    if not cgroup:
        return []
    root = CGROUP_ROOT / cgroup.lstrip("/")
    if not root.is_dir():
        return []
    pids: set[str] = set()
    for procs in root.rglob("cgroup.procs"):
        try:
            for line in procs.read_text(encoding="utf-8").splitlines():
                if line.isdigit():
                    pids.add(line)
        except OSError:
            continue
    return sorted(pids, key=int)


def _user_unit_search_paths() -> tuple[list[Path], bool, str]:
    override = os.environ.get("HAPAX_OOM_AUDIT_USER_UNIT_PATHS", "").strip()
    if override:
        if os.environ.get("HAPAX_OOM_AUDIT_TEST_MODE") != "1":
            return [], False, "HAPAX_OOM_AUDIT_USER_UNIT_PATHS is test-only"
        paths = [Path(item) for item in override.split(":") if item]
        return paths, True, "test-authoritative override"
    proc = _run([_systemd_analyze(), "--user", "unit-paths"])
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip() or f"rc={proc.returncode}"
        return [], False, detail
    paths = [Path(line.strip()) for line in proc.stdout.splitlines() if line.strip()]
    if not paths:
        return [], False, "systemd-analyze returned no user unit paths"
    return paths, True, "systemd-analyze --user unit-paths"


def _user_unit_file(paths: list[Path], unit: str) -> Path | None:
    for directory in paths:
        candidate = directory / unit
        if candidate.exists() or candidate.is_symlink():
            return candidate
    return None


def _protected_user_unit_memberships(policy: HostMemoryPolicy) -> dict[str, set[str]]:
    protected: dict[str, set[str]] = {}
    for unit in PROTECTED_USER_UNITS:
        values = _show(
            unit,
            [
                "LoadState",
                "OOMScoreAdjust",
                "MainPID",
                "ControlGroup",
                "MemoryLow",
                "MemoryMin",
                "Slice",
            ],
            user=True,
        )
        load_state = values.get("LoadState", "")
        if load_state == "not-found" and unit in policy.optional_user_units:
            continue
        if load_state != "loaded":
            continue
        cgroup = values.get("ControlGroup", "")
        main_pid = values.get("MainPID", "0")
        candidates = set(_cgroup_pids(cgroup))
        if main_pid.isdigit() and main_pid != "0":
            candidates.add(main_pid)
        if cgroup.startswith("/"):
            for pid in candidates:
                protected.setdefault(pid, set()).add(cgroup)
    return protected


def audit_protected_user_units(policy: HostMemoryPolicy) -> list[Check]:
    checks: list[Check] = []
    unit_paths: list[Path] | None = None
    unit_paths_authoritative = False
    unit_paths_detail = "not queried"
    for unit, expected in PROTECTED_USER_UNITS.items():
        values = _show(
            unit,
            [
                "LoadState",
                "OOMScoreAdjust",
                "MainPID",
                "ControlGroup",
                "MemoryLow",
                "MemoryMin",
                "Slice",
                "NoNewPrivileges",
            ],
            user=True,
        )
        if "_error" in values:
            checks.append(
                Check(
                    f"user_unit_{unit}_OOMScoreAdjust",
                    "gap",
                    str(expected),
                    "N/A",
                    f"{values['_error']}; {NEXT_OOM_INSTALL}",
                )
            )
            continue
        load_state = values.get("LoadState", "")
        if load_state == "not-found" and unit in policy.optional_user_units:
            if unit_paths is None:
                unit_paths, unit_paths_authoritative, unit_paths_detail = _user_unit_search_paths()
            unit_file = _user_unit_file(unit_paths, unit)
            if unit_file is not None:
                checks.append(
                    Check(
                        f"user_unit_{unit}_LoadState",
                        "gap",
                        "host-optional unit absent with no unit file",
                        str(unit_file),
                        "unit file exists but the manager reports not-found; this is a load "
                        f"failure, not host absence; {NEXT_OOM_INSTALL}",
                    )
                )
            elif not unit_paths_authoritative:
                checks.append(
                    Check(
                        f"user_unit_{unit}_LoadState",
                        "error",
                        "authoritatively proven host absence",
                        load_state,
                        "cannot prove absence from the user manager's complete unit search "
                        f"path: {unit_paths_detail}; {NEXT_OOM_INSTALL}",
                    )
                )
            else:
                checks.append(
                    Check(
                        f"user_unit_{unit}_LoadState",
                        "pass",
                        "host-optional-absent",
                        load_state,
                        f"{unit} has no file in the authoritative user unit search path; "
                        "systemd defaults for the nonexistent unit were not audited",
                    )
                )
            continue
        if load_state != "loaded":
            checks.append(
                Check(
                    f"user_unit_{unit}_LoadState",
                    "gap",
                    "loaded",
                    load_state or "N/A",
                    f"required protected user unit is unavailable; {NEXT_OOM_INSTALL}",
                )
            )
            continue
        checks.append(Check(f"user_unit_{unit}_LoadState", "pass", "loaded", load_state))
        actual = values.get("OOMScoreAdjust", "")
        parsed = _int_value(actual)
        status = "pass" if parsed == 100 else "gap"
        detail = (
            ""
            if status == "pass"
            else (
                "broadcast-critical user unit must start at the user manager's valid score 100; "
                f"root applies live score {expected} after startup; {NEXT_OOM_INSTALL}"
            )
        )
        checks.append(Check(f"user_unit_{unit}_OOMScoreAdjust", status, "100", actual, detail))
        slice_target = PROTECTED_USER_UNIT_SLICES[unit]
        slice_actual = values.get("Slice", "")
        slice_status = "pass" if slice_actual == slice_target else "gap"
        slice_detail = (
            ""
            if slice_status == "pass"
            else (
                f"broadcast-critical reservation must remain below {slice_target} so its checked "
                f"ancestor protection is effective; {NEXT_OOM_INSTALL}"
            )
        )
        checks.append(
            Check(
                f"user_unit_{unit}_Slice",
                slice_status,
                slice_target,
                slice_actual,
                slice_detail,
            )
        )
        if unit in AUDIO_USER_UNITS:
            sandbox_actual = values.get("NoNewPrivileges", "")
            sandbox_status = "pass" if sandbox_actual == "yes" else "gap"
            sandbox_detail = (
                ""
                if sandbox_status == "pass"
                else f"audio service must retain its distro privilege boundary; {NEXT_OOM_INSTALL}"
            )
            checks.append(
                Check(
                    f"user_unit_{unit}_NoNewPrivileges",
                    sandbox_status,
                    "yes",
                    sandbox_actual,
                    sandbox_detail,
                )
            )
        for key, memory_expected in PROTECTED_USER_UNIT_MEMORY[unit].items():
            memory_actual = values.get(key, "")
            memory_status = "pass" if _int_value(memory_actual) == memory_expected else "gap"
            memory_detail = (
                ""
                if memory_status == "pass"
                else f"broadcast-critical user unit memory reservation drifted; {NEXT_OOM_INSTALL}"
            )
            checks.append(
                Check(
                    f"user_unit_{unit}_{key}",
                    memory_status,
                    str(memory_expected),
                    memory_actual,
                    memory_detail,
                )
            )
        control_group = values.get("ControlGroup", "")
        live_pids = _cgroup_pids(control_group)
        main_pid = values.get("MainPID", "0")
        if main_pid.isdigit() and main_pid != "0":
            live_pids = sorted({*live_pids, main_pid}, key=int)
        for pid in live_pids:
            if not _pid_matches_cgroup(pid, control_group):
                actual_cgroups = _proc_cgroups(pid)
                checks.append(
                    Check(
                        f"user_unit_{unit}_pid_{pid}_cgroup_membership",
                        "gap",
                        f"{control_group} or descendant",
                        ",".join(actual_cgroups) if actual_cgroups else "N/A",
                        f"protected PID left or was reused outside its authoritative cgroup; {NEXT_OOM_INSTALL}",
                    )
                )
                continue
            live = _proc_oom_score(pid)
            if not _pid_matches_cgroup(pid, control_group):
                actual_cgroups = _proc_cgroups(pid)
                checks.append(
                    Check(
                        f"user_unit_{unit}_pid_{pid}_cgroup_membership",
                        "gap",
                        f"{control_group} or descendant",
                        ",".join(actual_cgroups) if actual_cgroups else "N/A",
                        f"protected PID moved during live-score readback; {NEXT_OOM_INSTALL}",
                    )
                )
                continue
            live_actual = "N/A" if live is None else str(live)
            live_status = "pass" if live == expected else "gap"
            live_detail = (
                ""
                if live_status == "pass"
                else f"live broadcast-critical user unit OOM score drifted; {NEXT_OOM_INSTALL}"
            )
            checks.append(
                Check(
                    f"user_unit_{unit}_pid_{pid}_live_oom_score_adj",
                    live_status,
                    str(expected),
                    live_actual,
                    live_detail,
                )
            )
    return checks


def audit_tmux_scopes() -> list[Check]:
    proc = _run([_systemctl(), "--user", "list-units", "--type=scope", "--all", "--no-legend"])
    if proc.returncode != 0:
        return [
            Check(
                "tmux_scope_scan",
                "error",
                "observable",
                "N/A",
                f"{(proc.stderr or proc.stdout).strip()}; {NEXT_OOM_INSTALL}",
            )
        ]
    scopes = [line.split()[0] for line in proc.stdout.splitlines() if "tmux-spawn-" in line]
    checks: list[Check] = [Check("tmux_scope_count", "pass", ">=0", str(len(scopes)))]
    for scope in scopes:
        values = _show(scope, ["MemoryHigh", "MemoryMax", "MemorySwapMax", "Slice"], user=True)
        if "_error" in values:
            checks.append(
                Check(
                    f"tmux_scope_{scope}",
                    "error",
                    "bounded-or-app-slice-backed",
                    "N/A",
                    f"{values['_error']}; {NEXT_OOM_INSTALL}",
                )
            )
            continue
        unbounded = [
            key
            for key in ("MemoryHigh", "MemoryMax", "MemorySwapMax")
            if values.get(key) == "infinity"
        ]
        slice_name = values.get("Slice", "")
        outside_app_slice = slice_name != "app.slice"
        status = "gap" if unbounded and outside_app_slice else "pass"
        detail_parts = []
        if unbounded:
            detail_parts.append(f"unbounded properties: {', '.join(unbounded)}")
        if outside_app_slice:
            detail_parts.append(f"Slice={slice_name}")
        detail = ""
        if status == "gap" and detail_parts:
            detail = f"tmux scope not bounded-or-app-slice-backed: {'; '.join(detail_parts)}; {NEXT_OOM_INSTALL}"
        actual = ",".join(
            f"{key}={values.get(key, '')}"
            for key in ("MemoryHigh", "MemoryMax", "MemorySwapMax", "Slice")
        )
        checks.append(
            Check(f"tmux_scope_{scope}", status, "bounded-or-app-slice-backed", actual, detail)
        )
    return checks


_ALLOWED_USER_PROTECTED_NAMES = {
    "pipewire",
    "pipewire-pulse",
    "wireplumber",
    "dbus-broker",
    "dbus-daemon",
    "systemd",
}


def _status_field(status: Path, key: str) -> str:
    try:
        for line in status.read_text(encoding="utf-8", errors="replace").splitlines():
            parts = line.split()
            if parts and parts[0] == f"{key}:" and len(parts) > 1:
                return parts[1]
    except OSError:
        return ""
    return ""


def audit_residual_user_process_protection(uid: int, policy: HostMemoryPolicy) -> Check:
    proc_root = PROC_ROOT
    if not proc_root.is_dir():
        return Check(
            "user_process_residual_oom_protection",
            "error",
            "observable",
            "N/A",
            f"proc root unavailable; {NEXT_OOM_INSTALL}",
        )
    protected_memberships = _protected_user_unit_memberships(policy)
    offenders: list[str] = []
    for adj in proc_root.glob("[0-9]*/oom_score_adj"):
        pid_dir = adj.parent
        status = pid_dir / "status"
        if _status_field(status, "Uid") != str(uid):
            continue
        try:
            score = int(adj.read_text(encoding="utf-8").strip())
        except (OSError, ValueError):
            continue
        if score > -800:
            continue
        if any(
            _pid_matches_cgroup(pid_dir.name, cgroup)
            for cgroup in protected_memberships.get(pid_dir.name, set())
        ):
            continue
        name = _status_field(status, "Name")
        if name in _ALLOWED_USER_PROTECTED_NAMES:
            continue
        offenders.append(f"{pid_dir.name}:{name}={score}")
    if offenders:
        shown = ",".join(offenders[:8])
        extra = "" if len(offenders) <= 8 else f",+{len(offenders) - 8} more"
        return Check(
            "user_process_residual_oom_protection",
            "gap",
            "no uid processes <= -800 outside allowlist",
            shown + extra,
            f"stale inherited OOMScoreAdjust; {NEXT_OOM_INSTALL}",
        )
    return Check(
        "user_process_residual_oom_protection",
        "pass",
        "no uid processes <= -800 outside allowlist",
        "none",
    )


def format_human(checks: list[Check]) -> str:
    lines = []
    for check in checks:
        suffix = f" ({check.detail})" if check.detail else ""
        lines.append(
            f"{check.status.upper():5} {check.name}: actual={check.actual} target={check.target}{suffix}"
        )
    return "\n".join(lines)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    parser.add_argument("--uid", type=int, default=os.getuid(), help="user manager UID to audit")
    parser.add_argument(
        "--host-policy-lines",
        action="store_true",
        help="emit the derived host policy as KEY=VALUE lines and exit",
    )
    args = parser.parse_args(argv)
    policy_authority = "unresolved"

    try:
        if _sealed_package_profile_table() is not None and not args.host_policy_lines:
            raise HostPolicyError(
                f"{SEALED_SOURCE_ENV} is limited to internal host-policy derivation; "
                "next action: run the installed recurring audit without sealed package selectors"
            )
        _reject_installed_test_selectors()
        policy_authority = _policy_authority_label(_profile_table_path())
        policy = derive_host_policy()
    except HostPolicyError as exc:
        checks = [
            Check(
                "host_memory_policy",
                "error",
                "supported physical-memory sizing table",
                "N/A",
                f"{exc}; {NEXT_OOM_INSTALL}",
            )
        ]
    else:
        if args.host_policy_lines:
            print(_policy_lines(policy, policy_authority))
            return 0
        try:
            with shared_root_required_lock():
                checks = [
                    Check(
                        "root_required_package_lock",
                        "pass",
                        "shared package lock held during readback",
                        str(ROOT_REQUIRED_LOCK_FILE),
                    ),
                    Check(
                        "host_memory_policy",
                        "pass",
                        "derived ceilings below physical RAM",
                        f"{policy.profile}:{policy.physical_bytes}",
                    ),
                    *audit_zram(policy),
                    *audit_docker_limits(),
                    audit_user_manager(args.uid),
                    audit_user_manager_policy(args.uid),
                    audit_user_manager_live_score(args.uid),
                    *audit_recovery_system_units(),
                    *audit_sshd_policy(),
                    *audit_system_slice_reservation(),
                    *audit_user_slice_reservation(),
                    *audit_loaded_memory_dropin_ownership(args.uid),
                    *audit_system_memory_unit(f"user-{args.uid}.slice", policy),
                    *audit_system_memory_unit(f"user@{args.uid}.service", policy),
                    *audit_app_slice(policy),
                    *audit_session_slice(),
                    *audit_user_child_floor_composition(args.uid),
                    *audit_protected_user_units(policy),
                    audit_residual_user_process_protection(args.uid, policy),
                    *audit_tmux_scopes(),
                ]
        except AuditLockError as exc:
            checks = [
                Check(
                    "root_required_package_lock",
                    "error",
                    "shared package lock held during readback",
                    str(ROOT_REQUIRED_LOCK_FILE),
                    f"{exc}; {NEXT_OOM_INSTALL}",
                )
            ]
    checks = [*_source_checkout_authority_checks(), *checks]
    if args.json:
        print(
            json.dumps(
                {
                    "checks": [asdict(check) for check in checks],
                    "policy_authority": policy_authority,
                },
                indent=2,
                sort_keys=True,
            )
        )
    else:
        print(f"POLICY_AUTHORITY {policy_authority}\n{format_human(checks)}")
    return 1 if any(check.status in {"gap", "error"} for check in checks) else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
