        "HAPAX_OOM_AUDIT_MEMTOTAL_KIB",
        "HAPAX_OOM_AUDIT_HOSTNAME",
        "HAPAX_OOM_AUDIT_PROFILE_TABLE",
        "HAPAX_OOM_AUDIT_DOCKER",
        "HAPAX_SYSTEMCTL",
    }
)
