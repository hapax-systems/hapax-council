        return [
            Check(
                f"{unit}_memory",
                "error",
                "bounded",
                "N/A",
                f"{values['_error']}; {NEXT_OOM_ACTION}",
            )
        ]
    checks: list[Check] = []
    for key, target in expected.items():
        actual = values.get(key, "")
        parsed = _int_value(actual)
        status = "pass" if parsed == target else "gap"
        detail = (
            "" if status == "pass" else f"{unit} aggregate memory policy drifted; {NEXT_OOM_ACTION}"
        )
        checks.append(Check(f"{unit}_{key}", status, str(target), actual, detail))
    return checks


