)
SOURCE_CHECKOUT_WARNINGS: list[str] = []


@dataclass
class Check:
    name: str
    status: str
    target: str
    actual: str
    detail: str = ""


@dataclass(frozen=True)
class HostMemoryPolicy:
    hostname: str
    profile: str
    physical_bytes: int
    app_memory_high: int
    app_memory_max: int
    uid_memory_high: int
    uid_memory_max: int
    zram_size: int
    optional_user_units: frozenset[str]


class AuditLockError(RuntimeError):
    pass


class HostPolicyError(RuntimeError):
    pass


def _source_checkout_warning(detail: str) -> None:
    action = (
        "next action: restore the repository Git metadata and rerun the source audit, "
        "or invoke the canonical installed audit with its receipt-owned profile table"
    )
    message = (
        f"source checkout verification failed: {detail}; continuing installed-mode diagnostics "
        f"with a fail-closed result; {action}"
    )
    if message not in SOURCE_CHECKOUT_WARNINGS:
        SOURCE_CHECKOUT_WARNINGS.append(message)
    print(f"WARNING hapax-oom-policy-audit {message}", file=sys.stderr)


def _source_checkout_authority_checks() -> list[Check]:
    return [
        Check(
            "source_checkout_authority",
            "fail",
            "verified source checkout or canonical installed snapshot",
            "unverified source checkout; installed-mode diagnostics only",
            detail,
        )
        for detail in SOURCE_CHECKOUT_WARNINGS
    ]


@functools.cache
def _source_checkout_root() -> Path | None:
    if SCRIPT_INVOKED_PATH != SCRIPT_PATH:
        return None
    if SOURCE_ROOT is None:
        return None
    root = SOURCE_ROOT
    if root / "scripts" / "hapax-oom-policy-audit" != SCRIPT_PATH:
        return None
    marker = root / ".git"
    try:
        inode = marker.lstat()
    except FileNotFoundError:
        return None
    except OSError as exc:
        _source_checkout_warning(f"cannot inspect {marker}: {exc}")
        return None
    if not (stat.S_ISDIR(inode.st_mode) or stat.S_ISREG(inode.st_mode)):
        _source_checkout_warning(f"unsupported Git marker type at {marker}")
        return None
    try:
        result = subprocess.run(
            ["/usr/bin/git", "-C", str(root), "rev-parse", "--show-toplevel"],
            text=True,
            capture_output=True,
            check=False,
            env={
                "GIT_CONFIG_GLOBAL": "/dev/null",
                "GIT_CONFIG_NOSYSTEM": "1",
                "GIT_NO_REPLACE_OBJECTS": "1",
                "GIT_OPTIONAL_LOCKS": "0",
                "HOME": "/nonexistent",
                "LANG": "C.UTF-8",
                "LC_ALL": "C.UTF-8",
                "PATH": "/usr/bin:/bin",
            },
        )
    except OSError as exc:
        _source_checkout_warning(f"cannot execute isolated Git probe for {root}: {exc}")
        return None
    if result.returncode != 0:
        first_line = next(iter(result.stderr.strip().splitlines()), "no Git diagnostic")
        excerpt = "".join(character if character.isprintable() else "?" for character in first_line)
        _source_checkout_warning(
            f"isolated Git probe for {root} exited with status {result.returncode}: {excerpt[:240]}"
        )
        return None
    try:
        top = Path(result.stdout.strip()).resolve(strict=True)
    except OSError as exc:
        _source_checkout_warning(f"cannot resolve Git root reported for {root}: {exc}")
        return None
    if top != root:
        _source_checkout_warning(f"Git reported {top}, expected {root}")
        return None
    return root


def _sealed_memfd_holder(path: Path) -> str | None:
    match = re.fullmatch(r"/proc/([1-9][0-9]*)/fd/([0-9]+)", str(path))
    if match is None:
        return None
    required = fcntl.F_SEAL_SEAL | fcntl.F_SEAL_SHRINK | fcntl.F_SEAL_GROW | fcntl.F_SEAL_WRITE
    try:
        target = os.readlink(path)
        fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC)
        try:
            inode = os.fstat(fd)
            seals = fcntl.fcntl(fd, fcntl.F_GET_SEALS)
        finally:
            os.close(fd)
    except OSError:
        return None
    if (
        not target.startswith("/memfd:hapax-")
        or not stat.S_ISREG(inode.st_mode)
        or inode.st_uid != os.geteuid()
        or seals & required != required
    ):
        return None
    return match.group(1)


def _sealed_package_profile_table() -> Path | None:
    if os.environ.get(SEALED_SOURCE_ENV) != "1":
        return None
    raw_profile = os.environ.get("HAPAX_OOM_AUDIT_PROFILE_TABLE", "")
    if not raw_profile:
        return None
    profile = Path(raw_profile)
    script_holder = _sealed_memfd_holder(SCRIPT_INVOKED_PATH)
    profile_holder = _sealed_memfd_holder(profile)
    if script_holder is None or script_holder != profile_holder:
        return None
    return profile


def _is_installed_audit() -> bool:
    return _source_checkout_root() is None and _sealed_package_profile_table() is None


def _reject_installed_test_selectors() -> None:
    if not _is_installed_audit():
        return
    present = sorted(name for name in TEST_ONLY_SELECTORS if name in os.environ)
    if present:
        raise HostPolicyError(
            f"{', '.join(present)} refused by an installed audit; next action: remove all "
            "test selectors and rerun /usr/local/sbin/hapax-oom-policy-audit"
        )


def _require_test_override(name: str) -> None:
    if os.environ.get("HAPAX_OOM_AUDIT_TEST_MODE") != "1":
        raise HostPolicyError(
            f"{name} is test-only; next action: remove the override and use canonical host state"
        )
    if _is_installed_audit():
        raise HostPolicyError(
            f"{name} is refused by an installed audit; next action: remove all test selectors "
            "and rerun /usr/local/sbin/hapax-oom-policy-audit"
        )


def _memtotal_kib() -> int:
    override = os.environ.get("HAPAX_OOM_AUDIT_MEMTOTAL_KIB", "").strip()
    if override:
        _require_test_override("HAPAX_OOM_AUDIT_MEMTOTAL_KIB")
        try:
            value = int(override)
        except ValueError as exc:
            raise HostPolicyError("test MemTotal override is not an integer") from exc
        if value <= 0:
            raise HostPolicyError("test MemTotal override must be positive")
        return value

    try:
        lines = (PROC_ROOT / "meminfo").read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise HostPolicyError(
            f"cannot read physical memory from {PROC_ROOT / 'meminfo'}: {exc}"
        ) from exc
    for line in lines:
        fields = line.split()
        if len(fields) >= 2 and fields[0] == "MemTotal:":
            try:
                value = int(fields[1])
            except ValueError as exc:
                raise HostPolicyError(f"invalid MemTotal line: {line}") from exc
            if value > 0:
                return value
    raise HostPolicyError(f"MemTotal is absent or invalid in {PROC_ROOT / 'meminfo'}")


def _hostname() -> str:
    override = os.environ.get("HAPAX_OOM_AUDIT_HOSTNAME", "").strip()
    if override:
        _require_test_override("HAPAX_OOM_AUDIT_HOSTNAME")
        return override
    return socket.gethostname()


def _profile_table_path() -> Path:
    override = os.environ.get("HAPAX_OOM_AUDIT_PROFILE_TABLE", "").strip()
    sealed = _sealed_package_profile_table()
    if sealed is not None:
        return sealed
    if override:
        _require_test_override("HAPAX_OOM_AUDIT_PROFILE_TABLE")
        return Path(override)
    if _source_checkout_root() is not None and SOURCE_PROFILE_TABLE.is_file():
        return SOURCE_PROFILE_TABLE
    return INSTALLED_PROFILE_TABLE


def _profile_table_context(table_path: Path) -> str:
    if _sealed_package_profile_table() == table_path:
        mode = "sealed package-source"
    elif os.environ.get("HAPAX_OOM_AUDIT_PROFILE_TABLE", "").strip():
        mode = "test-override"
    elif table_path == SOURCE_PROFILE_TABLE:
        mode = "source-tree"
    elif _is_canonical_installed_path():
        mode = "installed snapshot"
    else:
        mode = "unrecognized-executable installed-table"
    return f"{mode} host profile table {table_path}"


def _is_canonical_installed_path() -> bool:
    return SCRIPT_INVOKED_PATH == INSTALLED_AUDIT_PATH and SCRIPT_PATH == INSTALLED_AUDIT_PATH


def _policy_authority_label(table_path: Path) -> str:
    if _sealed_package_profile_table() == table_path:
        return "internal-sealed-package-source"
    if os.environ.get("HAPAX_OOM_AUDIT_PROFILE_TABLE", "").strip():
        return "non-authoritative-test-override"
    if table_path == SOURCE_PROFILE_TABLE:
        return "non-authoritative-source-tree"
    if _is_canonical_installed_path():
        return "installed-path-requires-root-receipt-audit"
    return "non-authoritative-unrecognized-executable"


def _memory_bytes(value: str, *, field: str, table_context: str) -> int:
    match = re.fullmatch(r"([1-9][0-9]*)([GM])", value)
    if not match:
        raise HostPolicyError(f"invalid {field} value in {table_context}: {value}")
    number, suffix = match.groups()
    scale = BYTES_1G if suffix == "G" else 1024**2
    return int(number) * scale


def derive_host_policy(
    memtotal_kib: int | None = None, hostname: str | None = None
) -> HostMemoryPolicy:
    physical_bytes = (memtotal_kib if memtotal_kib is not None else _memtotal_kib()) * 1024
    physical_gib = physical_bytes // BYTES_1G
    canonical_hostname = hostname if hostname is not None else _hostname()
    table_path = _profile_table_path()
    table_context = _profile_table_context(table_path)
    try:
        rows = table_path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise HostPolicyError(f"cannot read selected {table_context}: {exc}") from exc

    matched: tuple[str, int, int, int, int, int] | None = None
    known_host = False
    host_ranges: dict[str, list[tuple[int, int]]] = {}
    for line_number, line in enumerate(rows, start=1):
        if not line or line.startswith("#"):
            continue
        fields = line.split("\t")
        if len(fields) != 9:
            raise HostPolicyError(
                f"invalid host profile table row {table_path}:{line_number}: expected 9 fields"
            )
        (
            row_hostname,
            min_gib_text,
            max_gib_text,
            profile,
            app_high,
            app_max,
            uid_high,
            uid_max,
            zram_mib,
        ) = fields
        try:
            min_gib = int(min_gib_text)
            max_gib = int(max_gib_text)
        except ValueError as exc:
            raise HostPolicyError(
                f"invalid MemTotal GiB interval in {table_context} at line {line_number}: "
                f"{min_gib_text}..{max_gib_text}"
            ) from exc
        if min_gib <= 0 or max_gib < min_gib:
            raise HostPolicyError(
                f"invalid MemTotal GiB interval in {table_context} at line {line_number}: "
                f"{min_gib}..{max_gib}"
            )
        if profile not in {"appendix", "podium"}:
            raise HostPolicyError(
                f"invalid profile name in {table_context} at line {line_number}: {profile}"
            )
        expected_profile = HOST_PROFILE_BY_HOSTNAME.get(row_hostname)
        if expected_profile is None:
            raise HostPolicyError(
                f"invalid hostname in {table_context} at line {line_number}: "
                f"{row_hostname or 'empty'}"
            )
        if profile != expected_profile:
            raise HostPolicyError(
                f"hostname/profile mismatch in {table_context} at line {line_number}: "
                f"{row_hostname} requires profile {expected_profile}, got {profile or 'empty'}"
            )
        row_context = f"{table_context} line {line_number}"
        app_high_bytes = _memory_bytes(app_high, field="app_memory_high", table_context=row_context)
        app_max_bytes = _memory_bytes(app_max, field="app_memory_max", table_context=row_context)
        uid_high_bytes = _memory_bytes(uid_high, field="uid_memory_high", table_context=row_context)
        uid_max_bytes = _memory_bytes(uid_max, field="uid_memory_max", table_context=row_context)
        try:
            zram_size = int(zram_mib) * 1024**2
        except ValueError as exc:
            raise HostPolicyError(f"invalid zram_mib value in {row_context}: {zram_mib}") from exc
        reviewed_floor_bytes = min_gib * BYTES_1G
        if not (
            0 < app_high_bytes < app_max_bytes < reviewed_floor_bytes
            and 0 < uid_high_bytes < uid_max_bytes < reviewed_floor_bytes
            and app_max_bytes < uid_max_bytes
            and zram_size >= BYTES_8G
            and zram_size * 2 <= reviewed_floor_bytes
        ):
            raise HostPolicyError(
                f"derived {profile} memory ceilings from {row_context} are not safely ordered "
                f"below the reviewed {min_gib} GiB interval floor, or zram does not cover "
                "the 8 GiB slice swap ceiling while retaining at least half the physical "
                "floor as recovery headroom"
            )
        ranges = host_ranges.setdefault(row_hostname, [])
        if any(min_gib <= prior_max and prior_min <= max_gib for prior_min, prior_max in ranges):
            raise HostPolicyError(
                f"overlapping MemTotal GiB intervals in {table_context} for {row_hostname}: "
                f"{min_gib}..{max_gib}"
            )
        ranges.append((min_gib, max_gib))
        if row_hostname == canonical_hostname:
            known_host = True
        if row_hostname == canonical_hostname and min_gib <= physical_gib <= max_gib:
            if matched is not None:
                raise HostPolicyError(
                    f"duplicate entry in {table_context} for {canonical_hostname}/{physical_gib} GiB"
                )
            matched = (
                profile,
                app_high_bytes,
                app_max_bytes,
                uid_high_bytes,
                uid_max_bytes,
                zram_size,
            )
    if matched is None and not known_host:
        raise HostPolicyError(
            f"unsupported host identity in selected {table_context}: "
            f"{canonical_hostname or 'empty'}; next action: add a "
            "governed hostname and memory-band entry before installing or auditing OOM policy"
        )
    if matched is None:
        raise HostPolicyError(
            f"host/profile memory mismatch: {canonical_hostname} has unlisted MemTotal floor "
            f"{physical_gib} GiB in selected {table_context}; next action: repair the hardware "
            "inventory or add a separately reviewed non-overlapping sizing interval"
        )
    profile, app_high, app_max, uid_high, uid_max, zram_size = matched

    policy = HostMemoryPolicy(
        hostname=canonical_hostname,
        profile=profile,
        physical_bytes=physical_bytes,
        app_memory_high=app_high,
        app_memory_max=app_max,
        uid_memory_high=uid_high,
        uid_memory_max=uid_max,
        zram_size=zram_size,
        optional_user_units=(
            APPENDIX_OPTIONAL_USER_UNITS if profile == "appendix" else frozenset()
        ),
    )
    return policy


def _policy_lines(policy: HostMemoryPolicy, policy_authority: str) -> str:
    def gib(value: int) -> str:
        return f"{value // BYTES_1G}G"

    values = {
        "POLICY_AUTHORITY": policy_authority,
        "HOSTNAME": policy.hostname,
        "PROFILE": policy.profile,
        "PHYSICAL_BYTES": str(policy.physical_bytes),
        "APP_MEMORY_HIGH": gib(policy.app_memory_high),
        "APP_MEMORY_MAX": gib(policy.app_memory_max),
        "UID_MEMORY_HIGH": gib(policy.uid_memory_high),
        "UID_MEMORY_MAX": gib(policy.uid_memory_max),
        "ZRAM_SIZE_MIB": str(policy.zram_size // (1024**2)),
    }
    return "\n".join(f"{key}={value}" for key, value in values.items())


def _validate_lock_fd(fd: int) -> None:
    try:
        inode = os.fstat(fd)
        path_inode = os.lstat(ROOT_REQUIRED_LOCK_FILE)
    except OSError as exc:
        raise AuditLockError(f"cannot inspect {ROOT_REQUIRED_LOCK_FILE}: {exc}") from exc
    if (
        not stat.S_ISREG(inode.st_mode)
        or not stat.S_ISREG(path_inode.st_mode)
        or (inode.st_dev, inode.st_ino) != (path_inode.st_dev, path_inode.st_ino)
        or inode.st_uid != os.geteuid()
        or inode.st_nlink != 1
        or inode.st_mode & 0o022
    ):
        raise AuditLockError(
            f"unsafe package lock {ROOT_REQUIRED_LOCK_FILE}; expected the caller-owned, "
            "single-link, non-group-writable regular path inode"
        )


@contextmanager
def shared_root_required_lock() -> Iterator[None]:
    inherited = os.environ.get("HAPAX_ROOT_REQUIRED_LOCK_FD", "")
    owns_fd = not inherited
    if inherited:
        try:
            fd = int(inherited)
        except ValueError as exc:
            raise AuditLockError("invalid inherited package lock descriptor") from exc
        if fd < 3:
            raise AuditLockError("invalid inherited package lock descriptor")
        lock_mode = os.environ.get("HAPAX_ROOT_REQUIRED_LOCK_MODE", "shared")
        if lock_mode not in {"shared", "exclusive"}:
            raise AuditLockError(f"invalid inherited package lock mode: {lock_mode}")
    else:
        try:
            fd = os.open(
                ROOT_REQUIRED_LOCK_FILE,
                os.O_CLOEXEC | os.O_NOFOLLOW | os.O_RDONLY,
            )
        except OSError as exc:
            raise AuditLockError(
                f"cannot open existing safe package lock {ROOT_REQUIRED_LOCK_FILE}: {exc}; "
                "run the governed OOM installer to create package state"
            ) from exc
        lock_mode = "shared"
    try:
        _validate_lock_fd(fd)
        fcntl.flock(fd, fcntl.LOCK_EX if lock_mode == "exclusive" else fcntl.LOCK_SH)
        yield
    finally:
        if owns_fd:
            os.close(fd)


def _systemctl() -> str:
    return os.environ.get("HAPAX_SYSTEMCTL", "/usr/bin/systemctl")


def _systemd_analyze() -> str:
    return os.environ.get("HAPAX_SYSTEMD_ANALYZE", "/usr/bin/systemd-analyze")


def _docker() -> str:
    return os.environ.get("HAPAX_OOM_AUDIT_DOCKER", "/usr/bin/docker")


def _systemd_policy_dir(name: str, default: Path) -> Path:
    override = os.environ.get(name, "").strip()
    if not override:
        return default
    _require_test_override(name)
    return Path(override)


def _systemd_system_dir() -> Path:
    return _systemd_policy_dir("HAPAX_OOM_AUDIT_SYSTEMD_SYSTEM_DIR", Path("/etc/systemd/system"))


def _systemd_user_dir() -> Path:
    return _systemd_policy_dir(
        "HAPAX_OOM_AUDIT_SYSTEMD_USER_DIR", Path.home() / ".config/systemd/user"
    )


def _run(args: list[str], *, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            args, capture_output=True, text=True, timeout=10, check=False, env=env
        )
    except (FileNotFoundError, subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess(args=args, returncode=127, stdout="", stderr=str(exc))


def _run_local_docker(args: list[str]) -> subprocess.CompletedProcess[str]:
    env = os.environ.copy()
    for selector in DOCKER_SELECTOR_ENV:
        env.pop(selector, None)
    env["DOCKER_HOST"] = LOCAL_DOCKER_HOST
    env["DOCKER_CONFIG"] = LOCAL_DOCKER_CONFIG
    return _run(
        [
            _docker(),
            "--config",
            LOCAL_DOCKER_CONFIG,
            "--host",
            LOCAL_DOCKER_HOST,
            *args,
        ],
        env=env,
    )


def _show(unit: str, properties: list[str], *, user: bool = False) -> dict[str, str]:
    args = [_systemctl()]
    if user:
        args.append("--user")
    args.extend(["show", unit, "--no-pager"])
    for prop in properties:
        args.extend(["-p", prop])
    proc = _run(args)
    if proc.returncode != 0:
        return {"_error": (proc.stderr or proc.stdout).strip() or f"rc={proc.returncode}"}
    values: dict[str, str] = {}
    for line in proc.stdout.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key] = value
    return values


def _int_value(value: str | None) -> int | None:
    if value is None or value == "" or value == "infinity":
        return None
    try:
        return int(value)
    except ValueError:
        return None


def _audit_loaded_governed_unit_dropins(unit: str, canonical: Path, *, user: bool = False) -> Check:
    values = _show(unit, ["NeedDaemonReload", "FragmentPath", "DropInPaths"], user=user)
    check_name = f"{unit.replace('-', '_').replace('@', '_at_')}_memory_dropin_ownership"
    if "_error" in values:
        return Check(
            check_name,
            "error",
            str(canonical),
            "N/A",
            f"cannot query authoritative NeedDaemonReload/FragmentPath/DropInPaths: "
            f"{values['_error']}; "
            f"{NEXT_OOM_INSTALL}",
        )
    need_reload = values.get("NeedDaemonReload", "").strip()
    if need_reload != "no":
        return Check(
            check_name,
            "gap",
            "NeedDaemonReload=no",
            need_reload or "missing",
            f"authoritative manager state is stale or unprovable; {NEXT_OOM_INSTALL}",
        )
    fragment_raw = values.get("FragmentPath", "").strip()
    if fragment_raw:
        fragment = Path(fragment_raw)
        if not fragment.is_file() or fragment.is_symlink():
            return Check(
                check_name,
                "gap",
                "empty or readable regular governed-key-free FragmentPath",
                fragment_raw,
                f"authoritative FragmentPath is missing, non-regular, or symlinked; "
                f"{NEXT_OOM_INSTALL}",
            )
        try:
            fragment_body = fragment.read_text(encoding="utf-8")
        except OSError as exc:
            return Check(
                check_name,
                "error",
                "empty or readable regular governed-key-free FragmentPath",
                fragment_raw,
                f"cannot inspect authoritative FragmentPath: {exc}; {NEXT_OOM_INSTALL}",
            )
        if GOVERNED_MEMORY_ASSIGNMENT.search(fragment_body):
            return Check(
                check_name,
                "gap",
                "no governed memory assignment in FragmentPath",
                fragment_raw,
                f"authoritative FragmentPath reports an unowned memory assignment; "
                f"{NEXT_OOM_INSTALL}",
            )
    paths = [Path(item) for item in values.get("DropInPaths", "").split() if item]
    canonical_count = paths.count(canonical)
    if canonical_count != 1:
        return Check(
            check_name,
            "gap",
            str(canonical),
            " ".join(map(str, paths)) or "none",
            "authoritative DropInPaths does not contain exactly one receipt-owned memory source; "
            f"{NEXT_OOM_INSTALL}",
        )
    if not canonical.is_file() or canonical.is_symlink():
        return Check(
            check_name,
            "gap",
            f"regular receipt-owned {canonical}",
            str(canonical),
            f"canonical memory source is missing, non-regular, or symlinked; {NEXT_OOM_INSTALL}",
        )
    for path in paths:
        if path == canonical:
            continue
        try:
            body = path.read_text(encoding="utf-8")
        except OSError as exc:
            return Check(
                check_name,
                "error",
                "all non-receipt DropInPaths readable and free of governed memory assignments",
                str(path),
                f"cannot inspect authoritative DropInPath: {exc}; {NEXT_OOM_INSTALL}",
            )
        if GOVERNED_MEMORY_ASSIGNMENT.search(body):
            return Check(
                check_name,
                "gap",
                "no governed memory assignment outside the receipt-owned source",
                str(path),
                f"authoritative DropInPaths reports an unowned memory assignment; {NEXT_OOM_INSTALL}",
            )
    return Check(
        check_name,
        "pass",
        str(canonical),
        f"need_daemon_reload={need_reload} fragment={fragment_raw or 'none'} "
        f"dropins={' '.join(map(str, paths))}",
    )


def audit_loaded_memory_dropin_ownership(uid: int) -> list[Check]:
    system_dir = _systemd_system_dir()
    user_dir = _systemd_user_dir()
    return [
        _audit_loaded_governed_unit_dropins(
            "system.slice", system_dir / "system.slice.d/oom-containment.conf"
        ),
        _audit_loaded_governed_unit_dropins(
            "user.slice", system_dir / "user.slice.d/oom-containment.conf"
        ),
        _audit_loaded_governed_unit_dropins(
            f"user-{uid}.slice", system_dir / f"user-{uid}.slice.d/oom-containment.conf"
        ),
        _audit_loaded_governed_unit_dropins(
            f"user@{uid}.service", system_dir / f"user@{uid}.service.d/oom.conf"
        ),
        _audit_loaded_governed_unit_dropins(
            "app.slice", user_dir / "app.slice.d/oom-containment.conf", user=True
        ),
        _audit_loaded_governed_unit_dropins(
            "session.slice", user_dir / "session.slice.d/oom-containment.conf", user=True
        ),
    ]


def audit_user_manager(uid: int) -> Check:
    unit = f"user@{uid}.service"
    values = _show(unit, ["OOMScoreAdjust", "DropInPaths"])
    if "_error" in values:
        return Check(
            "user_manager_oom_score_adjust",
            "error",
            "100",
            "N/A",
            f"{values['_error']}; {NEXT_OOM_INSTALL}",
        )
    actual = values.get("OOMScoreAdjust", "")
    parsed = _int_value(actual)
    if parsed is None:
        return Check(
            "user_manager_oom_score_adjust",
            "error",
            "100",
            actual,
            f"unparseable; {NEXT_OOM_INSTALL}",
        )
    if parsed != 100:
        return Check(
            "user_manager_oom_score_adjust",
            "gap",
            "100",
            actual,
            f"effective user@ score must match the packaged kill ordering exactly; {NEXT_OOM_INSTALL}",
        )
    return Check("user_manager_oom_score_adjust", "pass", "100", actual)


def audit_user_manager_live_score(uid: int) -> Check:
    unit = f"user@{uid}.service"
    values = _show(unit, ["MainPID"])
    if "_error" in values:
        return Check(
            "user_manager_live_oom_score_adj",
            "error",
            "100",
            "N/A",
            f"{values['_error']}; {NEXT_OOM_INSTALL}",
        )
    pid = values.get("MainPID", "0")
    if not pid or pid == "0":
        return Check(
            "user_manager_live_oom_score_adj",
            "gap",
            "100",
            pid,
            f"user@ has no live MainPID to verify; {NEXT_OOM_INSTALL}",
        )
    actual = _proc_oom_score(pid)
    actual_text = "N/A" if actual is None else str(actual)
    status = "pass" if actual == 100 else "gap"
    detail = "" if status == "pass" else f"live user@ OOM score drifted; {NEXT_OOM_INSTALL}"
    return Check("user_manager_live_oom_score_adj", status, "100", actual_text, detail)


def audit_user_manager_policy(uid: int) -> Check:
    unit = f"user@{uid}.service"
    values = _show(unit, ["OOMPolicy"])
    if "_error" in values:
        return Check(
            "user_manager_OOMPolicy",
            "error",
            "continue",
            "N/A",
            f"{values['_error']}; {NEXT_OOM_INSTALL}",
        )
    actual = values.get("OOMPolicy", "")
    status = "pass" if actual == "continue" else "gap"
    detail = (
        ""
        if status == "pass"
        else f"user manager must survive descendant OOM kills; {NEXT_OOM_INSTALL}"
    )
    return Check("user_manager_OOMPolicy", status, "continue", actual, detail)


def audit_recovery_system_units() -> list[Check]:
    checks: list[Check] = []
    for unit, expected in RECOVERY_SYSTEM_UNITS.items():
        values = _show(unit, ["OOMScoreAdjust", "MainPID"])
        if "_error" in values:
            detail = f"{values['_error']}; {NEXT_OOM_INSTALL}"
            checks.extend(
                [
                    Check(
                        f"system_unit_{unit}_OOMScoreAdjust",
                        "error",
                        str(expected),
                        "N/A",
                        detail,
                    ),
                    Check(
                        f"system_unit_{unit}_live_oom_score_adj",
                        "error",
                        str(expected),
                        "N/A",
                        detail,
                    ),
                ]
            )
            continue

        configured = values.get("OOMScoreAdjust", "")
        configured_status = "pass" if _int_value(configured) == expected else "gap"
        configured_detail = (
            ""
            if configured_status == "pass"
            else f"effective recovery-daemon OOM policy drifted; {NEXT_OOM_INSTALL}"
        )
        checks.append(
            Check(
                f"system_unit_{unit}_OOMScoreAdjust",
                configured_status,
                str(expected),
                configured,
                configured_detail,
            )
        )

        pid = values.get("MainPID", "0")
        if pid == "0":
            checks.append(
                Check(
                    f"system_unit_{unit}_live_oom_score_adj",
                    "gap",
                    str(expected),
                    "inactive",
                    f"recovery daemon has no live main process; {NEXT_OOM_INSTALL}",
                )
            )
            continue
        if not pid.isdigit():
            checks.append(
                Check(
                    f"system_unit_{unit}_live_oom_score_adj",
                    "error",
                    str(expected),
                    pid,
                    f"unparseable recovery-daemon MainPID; {NEXT_OOM_INSTALL}",
                )
            )
            continue
        live = _proc_oom_score(pid)
        live_actual = "N/A" if live is None else str(live)
        live_status = "pass" if live == expected else "gap"
        live_detail = (
            ""
            if live_status == "pass"
            else f"live recovery-daemon OOM score drifted; {NEXT_OOM_INSTALL}"
        )
        checks.append(
            Check(
                f"system_unit_{unit}_live_oom_score_adj",
                live_status,
                str(expected),
                live_actual,
                live_detail,
            )
        )
    return checks


def audit_sshd_policy() -> list[Check]:
    values = _show("sshd.service", ["OOMScoreAdjust", "OOMPolicy", "MainPID"])
    if "_error" in values:
        detail = f"{values['_error']}; {NEXT_OOM_INSTALL}"
        return [
            Check("sshd_effective_OOMScoreAdjust", "error", "0", "N/A", detail),
            Check("sshd_effective_OOMPolicy", "error", "continue", "N/A", detail),
            Check("sshd_live_oom_score_adj", "error", "0", "N/A", detail),
        ]

    score = values.get("OOMScoreAdjust", "")
    score_status = "pass" if _int_value(score) == 0 else "gap"
    score_detail = (
        ""
        if score_status == "pass"
        else f"effective sshd policy would be inherited by future sessions; {NEXT_OOM_INSTALL}"
    )
    policy = values.get("OOMPolicy", "")
    policy_status = "pass" if policy == "continue" else "gap"
    policy_detail = (
        ""
        if policy_status == "pass"
        else f"sshd must remain available after a session OOM; {NEXT_OOM_INSTALL}"
    )

    pid = values.get("MainPID", "0")
    live = _proc_oom_score(pid) if pid.isdigit() and pid != "0" else None
    live_actual = "N/A" if live is None else str(live)
    live_status = "pass" if live == 0 else "gap"
    live_detail = (
        ""
        if live_status == "pass"
        else f"sshd has no live neutral-score main process; {NEXT_OOM_INSTALL}"
    )
    return [
        Check("sshd_effective_OOMScoreAdjust", score_status, "0", score, score_detail),
        Check("sshd_effective_OOMPolicy", policy_status, "continue", policy, policy_detail),
        Check("sshd_live_oom_score_adj", live_status, "0", live_actual, live_detail),
    ]


def audit_app_slice(policy: HostMemoryPolicy) -> list[Check]:
    expected = {
        "MemoryHigh": policy.app_memory_high,
        "MemoryMax": policy.app_memory_max,
        "MemorySwapMax": BYTES_8G,
        "MemoryLow": BYTES_16G,
        "MemoryMin": BYTES_8G,
    }
    values = _show("app.slice", list(expected), user=True)
    if "_error" in values:
        return [
            Check("app_slice", "error", "bounded", "N/A", f"{values['_error']}; {NEXT_OOM_INSTALL}")
        ]
    checks: list[Check] = []
    for key, target in expected.items():
        actual = values.get(key, "")
        parsed = _int_value(actual)
        status = "pass" if parsed == target else "gap"
        detail = (
            ""
            if status == "pass"
            else f"app.slice aggregate RAM/swap backstop drifted; {NEXT_OOM_INSTALL}"
        )
        checks.append(Check(f"app_slice_{key}", status, str(target), actual, detail))
    return checks


def audit_session_slice() -> list[Check]:
    expected: dict[str, int | None] = {
        "MemoryHigh": None,
        "MemoryMax": None,
        "MemorySwapMax": None,
        "MemoryLow": BYTES_2G,
        "MemoryMin": BYTES_1G,
    }
    values = _show("session.slice", list(expected), user=True)
    if "_error" in values:
        return [
            Check(
                "session_slice",
                "error",
                "protected",
                "N/A",
                f"{values['_error']}; {NEXT_OOM_INSTALL}",
            )
        ]
    checks: list[Check] = []
    for key, target in expected.items():
        actual = values.get(key, "")
        target_text = "infinity" if target is None else str(target)
        status = "pass" if actual == target_text else "gap"
        detail = (
            ""
            if status == "pass"
            else f"session.slice audio ancestor reservation drifted; {NEXT_OOM_INSTALL}"
        )
        checks.append(Check(f"session_slice_{key}", status, target_text, actual, detail))
    return checks


def _direct_child_floor_sum(control_group: str, key: str) -> tuple[int | None, str]:
    parent = CGROUP_ROOT / control_group.lstrip("/")
    filename = {"MemoryLow": "memory.low", "MemoryMin": "memory.min"}[key]
    try:
        children = sorted((child for child in parent.iterdir() if child.is_dir()), key=str)
    except OSError as exc:
        return None, f"cannot enumerate direct children of {control_group}: {exc}"
    values: list[tuple[str, int]] = []
    for child in children:
        try:
            raw = (child / filename).read_text(encoding="utf-8").strip()
            value = int(raw)
        except (OSError, ValueError) as exc:
            return None, f"cannot read {filename} for direct child {child.name}: {exc}"
        if value < 0:
            return None, f"invalid negative {filename} for direct child {child.name}: {value}"
        values.append((child.name, value))
    detail = ",".join(f"{name}:{value}" for name, value in values) or "none"
    return sum(value for _, value in values), detail


def _audit_direct_child_floor_composition(
    unit: str, check_prefix: str, *, user: bool = False
) -> list[Check]:
    parent = _show(unit, ["MemoryLow", "MemoryMin", "ControlGroup"], user=user)
    if "_error" in parent:
        return [
            Check(
                f"{check_prefix}_composition",
                "error",
                "parent >= all direct children",
                "N/A",
                f"{parent['_error']}; {NEXT_OOM_INSTALL}",
            )
        ]
    control_group = parent.get("ControlGroup", "")
    if not control_group:
        return [
            Check(
                f"{check_prefix}_composition",
                "error",
                "parent >= all direct children",
                "N/A",
                f"{unit} ControlGroup is empty; {NEXT_OOM_INSTALL}",
            )
        ]
    checks: list[Check] = []
    for key in ("MemoryLow", "MemoryMin"):
        parent_value = _int_value(parent.get(key, ""))
        child_sum, child_detail = _direct_child_floor_sum(control_group, key)
        status = (
            "pass"
            if parent_value is not None and child_sum is not None and parent_value >= child_sum
            else "gap"
        )
        actual = f"parent={parent_value};children={child_sum};direct={child_detail}"
        detail = (
            ""
            if status == "pass"
            else (
                f"cgroup-v2 would proportionally dilute direct-child {key} floors or their "
                f"effective cgroup values are unreadable; {NEXT_OOM_INSTALL}"
            )
        )
        checks.append(
            Check(
                f"{check_prefix}_{key}",
                status,
                "parent >= all direct children",
                actual,
                detail,
            )
        )
    return checks


def audit_user_child_floor_composition(uid: int) -> list[Check]:
    checks: list[Check] = []
    for unit, prefix, user in (
        ("user.slice", "user_slice_child_floor", False),
        (f"user-{uid}.slice", f"user_{uid}_slice_child_floor", False),
        (f"user@{uid}.service", "user_manager_child_floor", False),
        ("app.slice", "app_slice_child_floor", True),
        ("session.slice", "session_slice_child_floor", True),
    ):
        checks.extend(_audit_direct_child_floor_composition(unit, prefix, user=user))
    return checks


