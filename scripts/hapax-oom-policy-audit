@dataclass
class Check:
    name: str
    status: str
    target: str
    actual: str
    detail: str = ""


@dataclass(frozen=True)
class HostMemoryPolicy:
    hostname: str
    profile: str
    physical_bytes: int
    app_memory_high: int
    app_memory_max: int
    uid_memory_high: int
    uid_memory_max: int
    zram_size: int
    optional_user_units: frozenset[str]


class HostPolicyError(RuntimeError):
    pass


def _is_canonical_installed_audit() -> bool:
    return SCRIPT_PATH == INSTALLED_AUDIT_PATH


def _validate_test_mode_admission() -> None:
    selected = sorted(name for name in TEST_ONLY_SELECTORS if name in os.environ)
    test_mode = os.environ.get("HAPAX_OOM_AUDIT_TEST_MODE", "")
    if _is_canonical_installed_audit() and selected:
        raise HostPolicyError(
            "canonical installed audit refuses every test selector; remove " + ", ".join(selected)
        )
    if test_mode not in {"", "1"}:
        raise HostPolicyError("HAPAX_OOM_AUDIT_TEST_MODE must be exactly 1 when present")
    if test_mode != "1":
        selected = [name for name in selected if name != "HAPAX_OOM_AUDIT_TEST_MODE"]
        if selected:
            raise HostPolicyError(
                "audit test selectors require source-only HAPAX_OOM_AUDIT_TEST_MODE=1: "
                + ", ".join(selected)
            )


def _profile_table_path() -> Path:
    override = os.environ.get("HAPAX_OOM_AUDIT_PROFILE_TABLE", "").strip()
    if override:
        return Path(override)
    if _is_canonical_installed_audit():
        return INSTALLED_PROFILE_TABLE
    return SOURCE_PROFILE_TABLE


def _hostname() -> str:
    override = os.environ.get("HAPAX_OOM_AUDIT_HOSTNAME", "").strip()
    return (override or socket.gethostname()).split(".", 1)[0]


def _memtotal_kib() -> int:
    override = os.environ.get("HAPAX_OOM_AUDIT_MEMTOTAL_KIB", "").strip()
    if override:
        try:
            value = int(override)
        except ValueError as exc:
            raise HostPolicyError("test MemTotal override must be an integer") from exc
        if value <= 0:
            raise HostPolicyError("test MemTotal override must be positive")
        return value
    try:
        lines = (PROC_ROOT / "meminfo").read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise HostPolicyError(f"cannot read {PROC_ROOT / 'meminfo'}: {exc}") from exc
    for line in lines:
        fields = line.split()
        if len(fields) >= 2 and fields[0] == "MemTotal:":
            try:
                value = int(fields[1])
            except ValueError as exc:
                raise HostPolicyError(f"invalid MemTotal line: {line}") from exc
            if value > 0:
                return value
    raise HostPolicyError(f"positive MemTotal is absent from {PROC_ROOT / 'meminfo'}")


def _memory_bytes(value: str, field: str) -> int:
    match = re.fullmatch(r"([1-9][0-9]*)G", value)
    if match is None:
        raise HostPolicyError(f"invalid {field} value {value!r}; expected positive whole GiB")
    return int(match.group(1)) * BYTES_1G


def derive_host_policy() -> HostMemoryPolicy:
    table = _profile_table_path()
    try:
        lines = table.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise HostPolicyError(f"cannot read host profile table {table}: {exc}") from exc

    parsed: dict[str, tuple[int, int, HostMemoryPolicy]] = {}
    profiles: set[str] = set()
    intervals: list[tuple[int, int, str]] = []
    for line_number, raw_line in enumerate(lines, 1):
        if not raw_line or raw_line.startswith("#"):
            continue
        fields = raw_line.split("\t")
        if len(fields) != 9:
            raise HostPolicyError(f"{table}:{line_number}: expected exactly 9 fields")
        hostname, minimum, maximum, profile, app_high, app_max, uid_high, uid_max, zram = fields
        if hostname in parsed:
            raise HostPolicyError(f"{table}:{line_number}: duplicate hostname {hostname}")
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", profile) or profile in profiles:
            raise HostPolicyError(f"{table}:{line_number}: unsafe or duplicate profile {profile!r}")
        try:
            min_gib = int(minimum)
            max_gib = int(maximum)
            zram_mib = int(zram)
        except ValueError as exc:
            raise HostPolicyError(
                f"{table}:{line_number}: interval and zram fields must be integers"
            ) from exc
        if min_gib <= 0 or max_gib < min_gib:
            raise HostPolicyError(f"{table}:{line_number}: invalid inclusive MemTotal interval")
        app_high_bytes = _memory_bytes(app_high, "app_high")
        app_max_bytes = _memory_bytes(app_max, "app_max")
        uid_high_bytes = _memory_bytes(uid_high, "uid_high")
        uid_max_bytes = _memory_bytes(uid_max, "uid_max")
        if not (app_high_bytes < app_max_bytes < min_gib * BYTES_1G):
            raise HostPolicyError(
                f"{table}:{line_number}: app ceilings must be ordered below interval floor"
            )
        if not (uid_high_bytes < uid_max_bytes < min_gib * BYTES_1G):
            raise HostPolicyError(
                f"{table}:{line_number}: UID ceilings must be ordered below interval floor"
            )
        if app_high_bytes > uid_high_bytes or app_max_bytes > uid_max_bytes:
            raise HostPolicyError(
                f"{table}:{line_number}: app ceilings must not exceed UID ceilings"
            )
        if zram_mib < 8192 or zram_mib * 2 > min_gib * 1024:
            raise HostPolicyError(
                f"{table}:{line_number}: zram must be at least 8192 MiB and no more than half the interval floor"
            )
        policy = HostMemoryPolicy(
            hostname=hostname,
            profile=profile,
            physical_bytes=0,
            app_memory_high=app_high_bytes,
            app_memory_max=app_max_bytes,
            uid_memory_high=uid_high_bytes,
            uid_memory_max=uid_max_bytes,
            zram_size=zram_mib * 1024**2,
            optional_user_units=(
                APPENDIX_OPTIONAL_USER_UNITS if profile == "appendix" else frozenset()
            ),
        )
        parsed[hostname] = (min_gib, max_gib, policy)
        profiles.add(profile)
        intervals.append((min_gib, max_gib, hostname))

    actual_mapping = {hostname: policy.profile for hostname, (_, _, policy) in parsed.items()}
    if actual_mapping != EXPECTED_HOST_PROFILES:
        raise HostPolicyError(
            f"host profile set must be exactly {EXPECTED_HOST_PROFILES}, got {actual_mapping}"
        )
    for left, right in zip(sorted(intervals), sorted(intervals)[1:], strict=False):
        if left[1] >= right[0]:
            raise HostPolicyError(
                f"host profile intervals overlap: {left[2]}={left[0]}..{left[1]} and "
                f"{right[2]}={right[0]}..{right[1]}"
            )

    hostname = _hostname()
    if hostname not in parsed:
        raise HostPolicyError(f"unsupported canonical hostname {hostname!r}")
    minimum, maximum, selected = parsed[hostname]
    memtotal_kib = _memtotal_kib()
    physical_gib = memtotal_kib // (1024**2)
    if not minimum <= physical_gib <= maximum:
        raise HostPolicyError(
            f"{hostname} MemTotal={memtotal_kib} KiB floors to {physical_gib} GiB, outside "
            f"admitted interval {minimum}..{maximum} GiB"
        )
    return HostMemoryPolicy(
        hostname=selected.hostname,
        profile=selected.profile,
        physical_bytes=memtotal_kib * 1024,
        app_memory_high=selected.app_memory_high,
        app_memory_max=selected.app_memory_max,
        uid_memory_high=selected.uid_memory_high,
        uid_memory_max=selected.uid_memory_max,
        zram_size=selected.zram_size,
        optional_user_units=selected.optional_user_units,
    )


def _systemctl() -> str:
    return os.environ.get("HAPAX_SYSTEMCTL", "/usr/bin/systemctl")


def _docker() -> str:
    return os.environ.get("HAPAX_OOM_AUDIT_DOCKER", "/usr/bin/docker")


def _run(args: list[str], *, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    try:
        process = subprocess.Popen(
            args,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env,
            start_new_session=True,
        )
    except FileNotFoundError as exc:
        return subprocess.CompletedProcess(args=args, returncode=127, stdout="", stderr=str(exc))
    assert process.stdout is not None
    assert process.stderr is not None
    selector = selectors.DefaultSelector()
    selector.register(process.stdout, selectors.EVENT_READ, "stdout")
    selector.register(process.stderr, selectors.EVENT_READ, "stderr")
    buffers = {"stdout": bytearray(), "stderr": bytearray()}
    total = 0
    deadline = time.monotonic() + COMMAND_TIMEOUT_SECONDS
    failure = ""
    failure_rc = 0
    try:
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                failure = f"command timed out after {COMMAND_TIMEOUT_SECONDS:g}s"
                failure_rc = 124
                break
            events = selector.select(remaining)
            if not events:
                continue
            for key, _mask in events:
                chunk = os.read(key.fd, min(8192, COMMAND_OUTPUT_LIMIT - total + 1))
                if not chunk:
                    selector.unregister(key.fileobj)
                    continue
                available = COMMAND_OUTPUT_LIMIT - total
                if available > 0:
                    buffers[key.data].extend(chunk[:available])
                    total += min(len(chunk), available)
                if len(chunk) > available:
                    failure = f"command output exceeded {COMMAND_OUTPUT_LIMIT} bytes"
                    failure_rc = 125
                    break
            if failure:
                break
    finally:
        selector.close()

    returncode = 0
    if not failure:
        remaining = max(0.0, deadline - time.monotonic())
        try:
            returncode = process.wait(timeout=remaining)
        except subprocess.TimeoutExpired:
            failure = f"command timed out after {COMMAND_TIMEOUT_SECONDS:g}s"
            failure_rc = 124

    if failure:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        try:
            process.wait(timeout=1.0)
        except subprocess.TimeoutExpired:
            failure += "; killed process group did not reap within 1s"
        for stream in (process.stdout, process.stderr):
            stream.close()
        stderr = buffers["stderr"].decode("utf-8", errors="replace")
        if stderr and not stderr.endswith("\n"):
            stderr += "\n"
        stderr += failure
        return subprocess.CompletedProcess(
            args=args,
            returncode=failure_rc,
            stdout=buffers["stdout"].decode("utf-8", errors="replace"),
            stderr=stderr,
        )

    try:
        return subprocess.CompletedProcess(
            args=args,
            returncode=returncode,
            stdout=buffers["stdout"].decode("utf-8", errors="replace"),
            stderr=buffers["stderr"].decode("utf-8", errors="replace"),
        )
    finally:
        process.stdout.close()
        process.stderr.close()


def _run_local_docker(args: list[str]) -> subprocess.CompletedProcess[str]:
    env = {
        "HOME": "/nonexistent",
        "PATH": SAFE_PATH,
        "LANG": "C",
        "LC_ALL": "C",
    }
    return _run(
        [
            _docker(),
            "--host",
            LOCAL_DOCKER_HOST,
            "--config",
            LOCAL_DOCKER_CONFIG,
            *args,
        ],
        env=env,
    )


def _docker_failure_summary(result: subprocess.CompletedProcess[str]) -> str:
    if result.returncode == 124:
        return f"timed out after {COMMAND_TIMEOUT_SECONDS:g}s"
    if result.returncode == 125:
        return f"output exceeded {COMMAND_OUTPUT_LIMIT} bytes"
    return f"rc={result.returncode}"


def _show(unit: str, properties: list[str], *, user: bool = False) -> dict[str, str]:
    args = [_systemctl()]
    if user:
        args.append("--user")
    args.extend(["show", unit, "--no-pager"])
    for prop in properties:
        args.extend(["-p", prop])
    proc = _run(args)
    if proc.returncode != 0:
        return {"_error": (proc.stderr or proc.stdout).strip() or f"rc={proc.returncode}"}
    values: dict[str, str] = {}
    for line in proc.stdout.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key] = value
    return values


def _int_value(value: str | None) -> int | None:
    if value is None or value == "" or value == "infinity":
        return None
    try:
        return int(value)
    except ValueError:
        return None


def audit_user_manager(uid: int) -> Check:
    unit = f"user@{uid}.service"
    values = _show(unit, ["OOMScoreAdjust", "DropInPaths"])
    if "_error" in values:
        return Check(
            "user_manager_oom_score_adjust",
            "error",
            "100",
            "N/A",
            f"{values['_error']}; {NEXT_OOM_ACTION}",
        )
    actual = values.get("OOMScoreAdjust", "")
    parsed = _int_value(actual)
    if parsed is None:
        return Check(
            "user_manager_oom_score_adjust",
            "error",
            "100",
            actual,
            f"unparseable; {NEXT_OOM_ACTION}",
        )
    if parsed != 100:
        return Check(
            "user_manager_oom_score_adjust",
            "gap",
            "100",
            actual,
            f"effective user@ score must match the packaged kill ordering exactly; {NEXT_OOM_ACTION}",
        )
    return Check("user_manager_oom_score_adjust", "pass", "100", actual)


def audit_user_manager_live_score(uid: int) -> Check:
    unit = f"user@{uid}.service"
    values = _show(unit, ["MainPID"])
    if "_error" in values:
        return Check(
            "user_manager_live_oom_score_adj",
            "error",
            "100",
            "N/A",
            f"{values['_error']}; {NEXT_OOM_ACTION}",
        )
    pid = values.get("MainPID", "0")
    if not pid or pid == "0":
        return Check(
            "user_manager_live_oom_score_adj",
            "gap",
            "100",
            pid,
            f"user@ has no live MainPID to verify; {NEXT_OOM_ACTION}",
        )
    actual = _proc_oom_score(pid)
    actual_text = "N/A" if actual is None else str(actual)
    status = "pass" if actual == 100 else "gap"
    detail = "" if status == "pass" else f"live user@ OOM score drifted; {NEXT_OOM_ACTION}"
    return Check("user_manager_live_oom_score_adj", status, "100", actual_text, detail)


def audit_user_manager_policy(uid: int) -> Check:
    unit = f"user@{uid}.service"
    values = _show(unit, ["OOMPolicy"])
    if "_error" in values:
        return Check(
            "user_manager_OOMPolicy",
            "error",
            "continue",
            "N/A",
            f"{values['_error']}; {NEXT_OOM_ACTION}",
        )
    actual = values.get("OOMPolicy", "")
    status = "pass" if actual == "continue" else "gap"
    detail = (
        ""
        if status == "pass"
        else f"user manager must survive descendant OOM kills; {NEXT_OOM_ACTION}"
    )
    return Check("user_manager_OOMPolicy", status, "continue", actual, detail)


def audit_recovery_system_units() -> list[Check]:
    checks: list[Check] = []
    for unit, expected in RECOVERY_SYSTEM_UNITS.items():
        values = _show(unit, ["OOMScoreAdjust", "MainPID"])
        if "_error" in values:
            detail = f"{values['_error']}; {NEXT_OOM_ACTION}"
            checks.extend(
                [
                    Check(
                        f"system_unit_{unit}_OOMScoreAdjust",
                        "error",
                        str(expected),
                        "N/A",
                        detail,
                    ),
                    Check(
                        f"system_unit_{unit}_live_oom_score_adj",
                        "error",
                        str(expected),
                        "N/A",
                        detail,
                    ),
                ]
            )
            continue

        configured = values.get("OOMScoreAdjust", "")
        configured_status = "pass" if _int_value(configured) == expected else "gap"
        configured_detail = (
            ""
            if configured_status == "pass"
            else f"effective recovery-daemon OOM policy drifted; {NEXT_OOM_ACTION}"
        )
        checks.append(
            Check(
                f"system_unit_{unit}_OOMScoreAdjust",
                configured_status,
                str(expected),
                configured,
                configured_detail,
            )
        )

        pid = values.get("MainPID", "0")
        if pid == "0":
            checks.append(
                Check(
                    f"system_unit_{unit}_live_oom_score_adj",
                    "gap",
                    str(expected),
                    "inactive",
                    f"recovery daemon has no live main process; {NEXT_OOM_ACTION}",
                )
            )
            continue
        if not pid.isdigit():
            checks.append(
                Check(
                    f"system_unit_{unit}_live_oom_score_adj",
                    "error",
                    str(expected),
                    pid,
                    f"unparseable recovery-daemon MainPID; {NEXT_OOM_ACTION}",
                )
            )
            continue
        live = _proc_oom_score(pid)
        live_actual = "N/A" if live is None else str(live)
        live_status = "pass" if live == expected else "gap"
        live_detail = (
            ""
            if live_status == "pass"
            else f"live recovery-daemon OOM score drifted; {NEXT_OOM_ACTION}"
        )
        checks.append(
            Check(
                f"system_unit_{unit}_live_oom_score_adj",
                live_status,
                str(expected),
                live_actual,
                live_detail,
            )
        )
    return checks


def audit_sshd_policy() -> list[Check]:
    values = _show("sshd.service", ["OOMScoreAdjust", "OOMPolicy", "MainPID"])
    if "_error" in values:
        detail = f"{values['_error']}; {NEXT_OOM_ACTION}"
        return [
            Check("sshd_effective_OOMScoreAdjust", "error", "0", "N/A", detail),
            Check("sshd_effective_OOMPolicy", "error", "continue", "N/A", detail),
            Check("sshd_live_oom_score_adj", "error", "0", "N/A", detail),
        ]

    score = values.get("OOMScoreAdjust", "")
    score_status = "pass" if _int_value(score) == 0 else "gap"
    score_detail = (
        ""
        if score_status == "pass"
        else f"effective sshd policy would be inherited by future sessions; {NEXT_OOM_ACTION}"
    )
    policy = values.get("OOMPolicy", "")
    policy_status = "pass" if policy == "continue" else "gap"
    policy_detail = (
        ""
        if policy_status == "pass"
        else f"sshd must remain available after a session OOM; {NEXT_OOM_ACTION}"
    )

    pid = values.get("MainPID", "0")
    live = _proc_oom_score(pid) if pid.isdigit() and pid != "0" else None
    live_actual = "N/A" if live is None else str(live)
    live_status = "pass" if live == 0 else "gap"
    live_detail = (
        ""
        if live_status == "pass"
        else f"sshd has no live neutral-score main process; {NEXT_OOM_ACTION}"
    )
    return [
        Check("sshd_effective_OOMScoreAdjust", score_status, "0", score, score_detail),
        Check("sshd_effective_OOMPolicy", policy_status, "continue", policy, policy_detail),
        Check("sshd_live_oom_score_adj", live_status, "0", live_actual, live_detail),
    ]


def audit_app_slice(policy: HostMemoryPolicy) -> list[Check]:
    expected = {
        "MemoryHigh": policy.app_memory_high,
        "MemoryMax": policy.app_memory_max,
        "MemorySwapMax": BYTES_8G,
        "MemoryLow": BYTES_16G,
        "MemoryMin": BYTES_8G,
    }
    values = _show("app.slice", list(expected), user=True)
    if "_error" in values:
        return [
            Check("app_slice", "error", "bounded", "N/A", f"{values['_error']}; {NEXT_OOM_ACTION}")
        ]
    checks: list[Check] = []
    for key, target in expected.items():
        actual = values.get(key, "")
        parsed = _int_value(actual)
        status = "pass" if parsed == target else "gap"
        detail = (
            ""
            if status == "pass"
            else f"app.slice aggregate RAM/swap backstop drifted; {NEXT_OOM_ACTION}"
        )
        checks.append(Check(f"app_slice_{key}", status, str(target), actual, detail))
    return checks


