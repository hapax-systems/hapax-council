@dataclass
class Check:
    name: str
    status: str
    target: str
    actual: str
    detail: str = ""


@dataclass(frozen=True)
class HostPolicy:
    hostname: str
    profile: str
    minimum_gib: int
    maximum_gib: int
    app_high: int
    app_max: int
    uid_high: int
    uid_max: int
    system_high: int
    system_max: int
    system_low: int
    zram_mib: int
    swappiness: int


class HostPolicyError(RuntimeError):
    pass


def _policy_integer(value: str, field: str, line: int) -> int:
    if not re.fullmatch(r"[1-9][0-9]*|0", value):
        raise HostPolicyError(f"line {line}: {field} must be a canonical nonnegative integer")
    return int(value)


def _policy_gib(value: str, field: str, line: int) -> int:
    if not re.fullmatch(r"[1-9][0-9]*G", value):
        raise HostPolicyError(f"line {line}: {field} must be positive whole GiB")
    return int(value[:-1]) * BYTES_1G


def load_host_policy(table: Path, hostname: str, memtotal_kib: int) -> HostPolicy:
    """Select one reviewed host and RAM interval; reject all malformed peer rows too."""
    try:
        lines = table.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise HostPolicyError(f"cannot read host profile table {table}: {exc}") from exc
    expected = {"hapax-appendix": "appendix", "hapax-podium": "podium"}
    policies: dict[str, HostPolicy] = {}
    intervals: list[tuple[int, int, str]] = []
    for number, raw in enumerate(lines, 1):
        if not raw or raw.startswith("#"):
            continue
        fields = raw.split("\t")
        if len(fields) != 13:
            raise HostPolicyError(f"line {number}: expected exactly 13 tab-separated fields")
        (
            host,
            low,
            high,
            profile,
            app_hi,
            app_max,
            uid_hi,
            uid_max,
            sys_hi,
            sys_max,
            sys_low,
            zram,
            swap,
        ) = fields
        if host in policies:
            raise HostPolicyError(f"line {number}: duplicate hostname {host}")
        if expected.get(host) != profile:
            raise HostPolicyError(f"line {number}: unsupported hostname/profile {host}/{profile}")
        floor = _policy_integer(low, "min_memtotal_gib", number)
        ceiling = _policy_integer(high, "max_memtotal_gib", number)
        if floor == 0 or ceiling < floor:
            raise HostPolicyError(f"line {number}: invalid RAM interval")
        sizes = [
            _policy_gib(value, name, number)
            for value, name in zip(
                (app_hi, app_max, uid_hi, uid_max, sys_hi, sys_max, sys_low),
                ("app_high", "app_max", "uid_high", "uid_max", "system_high", "system_max", "system_low"),
                strict=True,
            )
        ]
        app_hi_b, app_max_b, uid_hi_b, uid_max_b, sys_hi_b, sys_max_b, sys_low_b = sizes
        if not (app_hi_b < app_max_b <= uid_max_b and app_hi_b <= uid_hi_b < uid_max_b):
            raise HostPolicyError(f"line {number}: app and UID ceilings are unordered")
        if not (12 * BYTES_1G <= sys_hi_b < sys_max_b):
            raise HostPolicyError(f"line {number}: system ceiling is below its 12G floor")
        if not (12 * BYTES_1G <= sys_low_b <= sys_hi_b):
            raise HostPolicyError(f"line {number}: system low must be 12G..system high")
        if uid_max_b + sys_max_b > (floor - 2) * BYTES_1G:
            raise HostPolicyError(
                f"line {number}: aggregate ceiling leaves less than 2G kernel margin"
            )
        zram_mib = _policy_integer(zram, "zram_mib", number)
        if zram_mib < 8192 or zram_mib * 2 > floor * 1024:
            raise HostPolicyError(f"line {number}: zram must be 8G..half the RAM interval floor")
        swappiness = _policy_integer(swap, "swappiness", number)
        if swappiness > 200:
            raise HostPolicyError(f"line {number}: swappiness exceeds kernel range")
        policies[host] = HostPolicy(
            host,
            profile,
            floor,
            ceiling,
            app_hi_b,
            app_max_b,
            uid_hi_b,
            uid_max_b,
            sys_hi_b,
            sys_max_b,
            sys_low_b,
            zram_mib,
            swappiness,
        )
        intervals.append((floor, ceiling, host))
    if {host: item.profile for host, item in policies.items()} != expected:
        raise HostPolicyError("host profile table must name appendix and podium exactly")
    intervals.sort()
    for left, right in zip(intervals, intervals[1:], strict=False):
        if left[1] >= right[0]:
            raise HostPolicyError(f"host RAM intervals overlap: {left[2]} and {right[2]}")
    selected = policies.get(hostname)
    if selected is None:
        raise HostPolicyError(f"unsupported canonical hostname {hostname!r}")
    actual_gib = memtotal_kib // (1024**2)
    if not selected.minimum_gib <= actual_gib <= selected.maximum_gib:
        raise HostPolicyError(
            f"{hostname} RAM {actual_gib} GiB outside admitted interval "
            f"{selected.minimum_gib}..{selected.maximum_gib} GiB"
        )
    return selected


def current_host_policy() -> HostPolicy:
    script = Path(__file__).resolve()
    installed = script == Path("/usr/local/sbin/hapax-oom-policy-audit")
    test_keys = (
        "HAPAX_OOM_AUDIT_TEST_MODE",
        "HAPAX_OOM_AUDIT_TEST_HOSTNAME",
        "HAPAX_OOM_AUDIT_TEST_MEMTOTAL_KIB",
        "HAPAX_OOM_AUDIT_PROC_ROOT",
        "HAPAX_OOM_AUDIT_TEST_UDEV_RULE",
    )
    selected = [key for key in test_keys if key in os.environ]
    if installed and selected:
        raise HostPolicyError("installed audit refuses test selectors: " + ", ".join(selected))
    if selected and os.environ.get("HAPAX_OOM_AUDIT_TEST_MODE") != "1":
        raise HostPolicyError("source audit test selectors require HAPAX_OOM_AUDIT_TEST_MODE=1")
    table = (
        Path("/usr/local/share/hapax/root-required/oom-host-profiles.tsv")
        if installed
        else script.parents[1] / "config/root-required/oom-host-profiles.tsv"
    )
    override = os.environ.get("HAPAX_OOM_AUDIT_TEST_MEMTOTAL_KIB")
    if override is not None:
        memtotal = _policy_integer(override, "test MemTotal", 0)
        if memtotal == 0:
            raise HostPolicyError("test MemTotal must be positive")
        return load_host_policy(
            table, os.environ.get("HAPAX_OOM_AUDIT_TEST_HOSTNAME", socket.gethostname()), memtotal
        )
    try:
        lines = (PROC_ROOT / "meminfo").read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise HostPolicyError(f"cannot read MemTotal: {exc}") from exc
    matches = [line.split() for line in lines if line.startswith("MemTotal:")]
    if len(matches) != 1 or len(matches[0]) < 3 or matches[0][2] != "kB":
        raise HostPolicyError("MemTotal must occur once in kB")
    memtotal = _policy_integer(matches[0][1], "MemTotal", 0)
    if memtotal == 0:
        raise HostPolicyError("MemTotal must be positive")
    return load_host_policy(
        table, os.environ.get("HAPAX_OOM_AUDIT_TEST_HOSTNAME", socket.gethostname()), memtotal
    )


class AuditLockError(RuntimeError):
    pass


def _validate_lock_fd(fd: int) -> None:
    try:
        inode = os.fstat(fd)
        path_inode = os.lstat(ROOT_REQUIRED_LOCK_FILE)
    except OSError as exc:
        raise AuditLockError(f"cannot inspect {ROOT_REQUIRED_LOCK_FILE}: {exc}") from exc
    if (
        not stat.S_ISREG(inode.st_mode)
        or not stat.S_ISREG(path_inode.st_mode)
        or (inode.st_dev, inode.st_ino) != (path_inode.st_dev, path_inode.st_ino)
        or inode.st_uid != os.geteuid()
        or inode.st_nlink != 1
        or inode.st_mode & 0o022
    ):
        raise AuditLockError(
            f"unsafe package lock {ROOT_REQUIRED_LOCK_FILE}; expected the caller-owned, "
            "single-link, non-group-writable regular path inode"
        )
    os.fchmod(fd, 0o600)


@contextmanager
def shared_root_required_lock() -> Iterator[None]:
    inherited = os.environ.get("HAPAX_ROOT_REQUIRED_LOCK_FD", "")
    owns_fd = not inherited
    if inherited:
        try:
            fd = int(inherited)
        except ValueError as exc:
            raise AuditLockError("invalid inherited package lock descriptor") from exc
        if fd < 3:
            raise AuditLockError("invalid inherited package lock descriptor")
        lock_mode = os.environ.get("HAPAX_ROOT_REQUIRED_LOCK_MODE", "shared")
        if lock_mode not in {"shared", "exclusive"}:
            raise AuditLockError(f"invalid inherited package lock mode: {lock_mode}")
    else:
        ROOT_REQUIRED_LOCK_FILE.parent.mkdir(parents=True, exist_ok=True)
        try:
            fd = os.open(
                ROOT_REQUIRED_LOCK_FILE,
                os.O_CLOEXEC | os.O_CREAT | os.O_NOFOLLOW | os.O_RDWR,
                0o600,
            )
        except OSError as exc:
            raise AuditLockError(
                f"cannot open safe package lock {ROOT_REQUIRED_LOCK_FILE}: {exc}"
            ) from exc
        lock_mode = "shared"
    try:
        _validate_lock_fd(fd)
        fcntl.flock(fd, fcntl.LOCK_EX if lock_mode == "exclusive" else fcntl.LOCK_SH)
        yield
    finally:
        if owns_fd:
            os.close(fd)


def _systemctl() -> str:
    return os.environ.get("HAPAX_SYSTEMCTL", "/usr/bin/systemctl")


def _run(args: list[str]) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=10, check=False)
    except (FileNotFoundError, subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess(args=args, returncode=127, stdout="", stderr=str(exc))


def _show(unit: str, properties: list[str], *, user: bool = False) -> dict[str, str]:
    args = [_systemctl()]
    if user:
        args.append("--user")
    args.extend(["show", unit, "--no-pager"])
    for prop in properties:
        args.extend(["-p", prop])
    proc = _run(args)
    if proc.returncode != 0:
        return {"_error": (proc.stderr or proc.stdout).strip() or f"rc={proc.returncode}"}
    values: dict[str, str] = {}
    for line in proc.stdout.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key] = value
    return values


def _int_value(value: str | None) -> int | None:
    if value is None or value == "" or value == "infinity":
        return None
    try:
        return int(value)
    except ValueError:
        return None


def audit_user_manager(uid: int) -> Check:
    unit = f"user@{uid}.service"
    values = _show(unit, ["OOMScoreAdjust", "DropInPaths"])
    if "_error" in values:
        return Check(
            "user_manager_oom_score_adjust",
            "error",
            "100",
            "N/A",
            f"{values['_error']}; {NEXT_OOM_INSTALL}",
        )
    actual = values.get("OOMScoreAdjust", "")
    parsed = _int_value(actual)
    if parsed is None:
        return Check(
            "user_manager_oom_score_adjust",
            "error",
            "100",
            actual,
            f"unparseable; {NEXT_OOM_INSTALL}",
        )
    if parsed != 100:
        return Check(
            "user_manager_oom_score_adjust",
            "gap",
            "100",
            actual,
            f"effective user@ score must match the packaged kill ordering exactly; {NEXT_OOM_INSTALL}",
        )
    return Check("user_manager_oom_score_adjust", "pass", "100", actual)


def audit_user_manager_live_score(uid: int) -> Check:
    unit = f"user@{uid}.service"
    values = _show(unit, ["MainPID"])
    if "_error" in values:
        return Check(
            "user_manager_live_oom_score_adj",
            "error",
            "100",
            "N/A",
            f"{values['_error']}; {NEXT_OOM_INSTALL}",
        )
    pid = values.get("MainPID", "0")
    if not pid or pid == "0":
        return Check(
            "user_manager_live_oom_score_adj",
            "gap",
            "100",
            pid,
            f"user@ has no live MainPID to verify; {NEXT_OOM_INSTALL}",
        )
    actual = _proc_oom_score(pid)
    actual_text = "N/A" if actual is None else str(actual)
    status = "pass" if actual == 100 else "gap"
    detail = "" if status == "pass" else f"live user@ OOM score drifted; {NEXT_OOM_INSTALL}"
    return Check("user_manager_live_oom_score_adj", status, "100", actual_text, detail)


def audit_user_manager_policy(uid: int) -> Check:
    unit = f"user@{uid}.service"
    values = _show(unit, ["OOMPolicy"])
    if "_error" in values:
        return Check(
            "user_manager_OOMPolicy",
            "error",
            "continue",
            "N/A",
            f"{values['_error']}; {NEXT_OOM_INSTALL}",
        )
    actual = values.get("OOMPolicy", "")
    status = "pass" if actual == "continue" else "gap"
    detail = (
        ""
        if status == "pass"
        else f"user manager must survive descendant OOM kills; {NEXT_OOM_INSTALL}"
    )
    return Check("user_manager_OOMPolicy", status, "continue", actual, detail)


def audit_recovery_system_units() -> list[Check]:
    checks: list[Check] = []
    for unit, expected in RECOVERY_SYSTEM_UNITS.items():
        values = _show(unit, ["OOMScoreAdjust", "MainPID"])
        if "_error" in values:
            detail = f"{values['_error']}; {NEXT_OOM_INSTALL}"
            checks.extend(
                [
                    Check(
                        f"system_unit_{unit}_OOMScoreAdjust",
                        "error",
                        str(expected),
                        "N/A",
                        detail,
                    ),
                    Check(
                        f"system_unit_{unit}_live_oom_score_adj",
                        "error",
                        str(expected),
                        "N/A",
                        detail,
                    ),
                ]
            )
            continue

        configured = values.get("OOMScoreAdjust", "")
        configured_status = "pass" if _int_value(configured) == expected else "gap"
        configured_detail = (
            ""
            if configured_status == "pass"
            else f"effective recovery-daemon OOM policy drifted; {NEXT_OOM_INSTALL}"
        )
        checks.append(
            Check(
                f"system_unit_{unit}_OOMScoreAdjust",
                configured_status,
                str(expected),
                configured,
                configured_detail,
            )
        )

        pid = values.get("MainPID", "0")
        if pid == "0":
            checks.append(
                Check(
                    f"system_unit_{unit}_live_oom_score_adj",
                    "gap",
                    str(expected),
                    "inactive",
                    f"recovery daemon has no live main process; {NEXT_OOM_INSTALL}",
                )
            )
            continue
        if not pid.isdigit():
            checks.append(
                Check(
                    f"system_unit_{unit}_live_oom_score_adj",
                    "error",
                    str(expected),
                    pid,
                    f"unparseable recovery-daemon MainPID; {NEXT_OOM_INSTALL}",
                )
            )
            continue
        live = _proc_oom_score(pid)
        live_actual = "N/A" if live is None else str(live)
        live_status = "pass" if live == expected else "gap"
        live_detail = (
            ""
            if live_status == "pass"
            else f"live recovery-daemon OOM score drifted; {NEXT_OOM_INSTALL}"
        )
        checks.append(
            Check(
                f"system_unit_{unit}_live_oom_score_adj",
                live_status,
                str(expected),
                live_actual,
                live_detail,
            )
        )
    return checks


def audit_sshd_policy() -> list[Check]:
    values = _show("sshd.service", ["OOMScoreAdjust", "OOMPolicy", "MainPID"])
    if "_error" in values:
        detail = f"{values['_error']}; {NEXT_OOM_INSTALL}"
        return [
            Check("sshd_effective_OOMScoreAdjust", "error", "0", "N/A", detail),
            Check("sshd_effective_OOMPolicy", "error", "continue", "N/A", detail),
            Check("sshd_live_oom_score_adj", "error", "0", "N/A", detail),
        ]

    score = values.get("OOMScoreAdjust", "")
    score_status = "pass" if _int_value(score) == 0 else "gap"
    score_detail = (
        ""
        if score_status == "pass"
        else f"effective sshd policy would be inherited by future sessions; {NEXT_OOM_INSTALL}"
    )
    policy = values.get("OOMPolicy", "")
    policy_status = "pass" if policy == "continue" else "gap"
    policy_detail = (
        ""
        if policy_status == "pass"
        else f"sshd must remain available after a session OOM; {NEXT_OOM_INSTALL}"
    )

    pid = values.get("MainPID", "0")
    live = _proc_oom_score(pid) if pid.isdigit() and pid != "0" else None
    live_actual = "N/A" if live is None else str(live)
    live_status = "pass" if live == 0 else "gap"
    live_detail = (
        ""
        if live_status == "pass"
        else f"sshd has no live neutral-score main process; {NEXT_OOM_INSTALL}"
    )
    return [
        Check("sshd_effective_OOMScoreAdjust", score_status, "0", score, score_detail),
        Check("sshd_effective_OOMPolicy", policy_status, "continue", policy, policy_detail),
        Check("sshd_live_oom_score_adj", live_status, "0", live_actual, live_detail),
    ]


def audit_app_slice(policy: HostPolicy | None = None) -> list[Check]:
    expected = {
        "MemoryHigh": policy.app_high if policy else BYTES_72G,
        "MemoryMax": policy.app_max if policy else BYTES_88G,
        "MemorySwapMax": BYTES_8G,
        "MemoryLow": BYTES_16G,
        "MemoryMin": BYTES_8G,
    }
    values = _show("app.slice", list(expected), user=True)
    if "_error" in values:
        return [
            Check("app_slice", "error", "bounded", "N/A", f"{values['_error']}; {NEXT_OOM_INSTALL}")
        ]
    checks: list[Check] = []
    for key, target in expected.items():
        actual = values.get(key, "")
        parsed = _int_value(actual)
        status = "pass" if parsed == target else "gap"
        detail = (
            ""
            if status == "pass"
            else f"app.slice aggregate RAM/swap backstop drifted; {NEXT_OOM_INSTALL}"
        )
        checks.append(Check(f"app_slice_{key}", status, str(target), actual, detail))
    return checks


def audit_session_slice() -> list[Check]:
    expected: dict[str, int | None] = {
        "MemoryHigh": None,
        "MemoryMax": None,
        "MemorySwapMax": None,
        "MemoryLow": BYTES_2G,
        "MemoryMin": BYTES_1G,
    }
    values = _show("session.slice", list(expected), user=True)
    if "_error" in values:
        return [
            Check(
                "session_slice",
                "error",
                "protected",
                "N/A",
                f"{values['_error']}; {NEXT_OOM_INSTALL}",
            )
        ]
    checks: list[Check] = []
    for key, target in expected.items():
        actual = values.get(key, "")
        target_text = "infinity" if target is None else str(target)
        status = "pass" if actual == target_text else "gap"
        detail = (
            ""
            if status == "pass"
            else f"session.slice audio ancestor reservation drifted; {NEXT_OOM_INSTALL}"
        )
        checks.append(Check(f"session_slice_{key}", status, target_text, actual, detail))
    return checks


def _direct_child_floor_sum(control_group: str, key: str) -> tuple[int | None, str]:
    parent = CGROUP_ROOT / control_group.lstrip("/")
    filename = {"MemoryLow": "memory.low", "MemoryMin": "memory.min"}[key]
    try:
        children = sorted((child for child in parent.iterdir() if child.is_dir()), key=str)
    except OSError as exc:
        return None, f"cannot enumerate direct children of {control_group}: {exc}"
    values: list[tuple[str, int]] = []
    for child in children:
        try:
            raw = (child / filename).read_text(encoding="utf-8").strip()
            value = int(raw)
        except (OSError, ValueError) as exc:
            return None, f"cannot read {filename} for direct child {child.name}: {exc}"
        if value < 0:
            return None, f"invalid negative {filename} for direct child {child.name}: {value}"
        values.append((child.name, value))
    detail = ",".join(f"{name}:{value}" for name, value in values) or "none"
    return sum(value for _, value in values), detail


def _audit_direct_child_floor_composition(
    unit: str, check_prefix: str, *, user: bool = False
) -> list[Check]:
    parent = _show(unit, ["MemoryLow", "MemoryMin", "ControlGroup"], user=user)
    if "_error" in parent:
        return [
            Check(
                f"{check_prefix}_composition",
                "error",
                "parent >= all direct children",
                "N/A",
                f"{parent['_error']}; {NEXT_OOM_INSTALL}",
            )
        ]
    control_group = parent.get("ControlGroup", "")
    if not control_group:
        return [
            Check(
                f"{check_prefix}_composition",
                "error",
                "parent >= all direct children",
                "N/A",
                f"{unit} ControlGroup is empty; {NEXT_OOM_INSTALL}",
            )
        ]
    checks: list[Check] = []
    for key in ("MemoryLow", "MemoryMin"):
        parent_value = _int_value(parent.get(key, ""))
        child_sum, child_detail = _direct_child_floor_sum(control_group, key)
        status = (
            "pass"
            if parent_value is not None and child_sum is not None and parent_value >= child_sum
            else "gap"
        )
        actual = f"parent={parent_value};children={child_sum};direct={child_detail}"
        detail = (
            ""
            if status == "pass"
            else (
                f"cgroup-v2 would proportionally dilute direct-child {key} floors or their "
                f"effective cgroup values are unreadable; {NEXT_OOM_INSTALL}"
            )
        )
        checks.append(
            Check(
                f"{check_prefix}_{key}",
                status,
                "parent >= all direct children",
                actual,
                detail,
            )
        )
    return checks


def audit_user_child_floor_composition(uid: int) -> list[Check]:
    checks: list[Check] = []
    for unit, prefix, user in (
        ("user.slice", "user_slice_child_floor", False),
        (f"user-{uid}.slice", f"user_{uid}_slice_child_floor", False),
        (f"user@{uid}.service", "user_manager_child_floor", False),
        ("app.slice", "app_slice_child_floor", True),
        ("session.slice", "session_slice_child_floor", True),
    ):
        checks.extend(_audit_direct_child_floor_composition(unit, prefix, user=user))
    return checks


def audit_system_memory_unit(unit: str, policy: HostPolicy | None = None) -> list[Check]:
    expected = {
        "MemoryHigh": policy.uid_high if policy else BYTES_80G,
        "MemoryMax": policy.uid_max if policy else BYTES_96G,
        "MemorySwapMax": BYTES_8G,
        "MemoryLow": BYTES_20G,
        "MemoryMin": BYTES_10G,
    }
    values = _show(unit, list(expected))
    if "_error" in values:
        return [
            Check(
                f"{unit}_memory",
                "error",
                "bounded",
                "N/A",
                f"{values['_error']}; {NEXT_OOM_INSTALL}",
            )
        ]
    checks: list[Check] = []
    for key, target in expected.items():
        actual = values.get(key, "")
        parsed = _int_value(actual)
        status = "pass" if parsed == target else "gap"
        detail = (
            ""
            if status == "pass"
            else f"{unit} aggregate memory policy drifted; {NEXT_OOM_INSTALL}"
        )
        checks.append(Check(f"{unit}_{key}", status, str(target), actual, detail))
    return checks


def audit_system_slice_reservation(policy: HostPolicy | None = None) -> list[Check]:
    expected: dict[str, int | None] = {
        "MemoryHigh": policy.system_high if policy else None,
        "MemoryMax": policy.system_max if policy else None,
        "MemorySwapMax": None,
        "MemoryLow": policy.system_low if policy else BYTES_24G,
        "MemoryMin": BYTES_12G,
    }
    values = _show("system.slice", list(expected))
    if "_error" in values:
        return [
            Check(
                "system_slice_reservation",
                "error",
                "protected",
                "N/A",
                f"{values['_error']}; {NEXT_OOM_INSTALL}",
            )
        ]
    checks: list[Check] = []
    for key, target in expected.items():
        actual = values.get(key, "")
        target_text = "infinity" if target is None else str(target)
        status = "pass" if actual == target_text else "gap"
        detail = (
            ""
            if status == "pass"
            else f"system.slice recovery-plane reservation drifted; {NEXT_OOM_INSTALL}"
        )
        checks.append(Check(f"system_slice_{key}", status, target_text, actual, detail))
    return checks


def audit_swappiness(
    policy: HostPolicy, live_path: Path | None = None, rule_path: Path | None = None
) -> list[Check]:
    live = live_path or PROC_ROOT / "sys/vm/swappiness"
    rule = rule_path or Path(
        os.environ.get(
            "HAPAX_OOM_AUDIT_TEST_UDEV_RULE", "/etc/udev/rules.d/99-hapax-zram-swappiness.rules"
        )
    )
    expected_rule = (
        'ACTION=="change", KERNEL=="zram0", ATTR{initstate}=="1", '
        f'SYSCTL{{vm.swappiness}}="{policy.swappiness}"'
    )
    try:
        live_value = live.read_text(encoding="ascii").strip()
    except OSError as exc:
        live_value = f"unreadable: {exc}"
    try:
        rule_lines = rule.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        rule_lines = [f"unreadable: {exc}"]
    live_ok = live_value == str(policy.swappiness)
    rule_ok = (
        rule_lines.count(expected_rule) == 1
        and sum(
            line.startswith('ACTION=="change"') and "SYSCTL{vm.swappiness}" in line
            for line in rule_lines
        )
        == 1
    )
    return [
        Check(
            "vm_swappiness",
            "pass" if live_ok else "gap",
            str(policy.swappiness),
            live_value,
            "" if live_ok else "zram device event or live sysctl restored another value",
        ),
        Check(
            "zram_swappiness_rule",
            "pass" if rule_ok else "gap",
            expected_rule,
            str(rule),
            "" if rule_ok else "later /etc/udev rule is absent or differs from host policy",
        ),
    ]


def audit_user_slice_reservation() -> list[Check]:
    expected: dict[str, int | None] = {
        "MemoryHigh": None,
        "MemoryMax": None,
        "MemorySwapMax": None,
        "MemoryLow": BYTES_20G,
        "MemoryMin": BYTES_10G,
    }
    values = _show("user.slice", list(expected))
    if "_error" in values:
        return [
            Check(
                "user_slice_reservation",
                "error",
                "protected",
                "N/A",
                f"{values['_error']}; {NEXT_OOM_INSTALL}",
            )
        ]
    checks: list[Check] = []
    for key, target in expected.items():
        actual = values.get(key, "")
        target_text = "infinity" if target is None else str(target)
        status = "pass" if actual == target_text else "gap"
        detail = (
            ""
            if status == "pass"
            else f"user.slice ancestor reservation drifted; {NEXT_OOM_INSTALL}"
        )
        checks.append(Check(f"user_slice_{key}", status, target_text, actual, detail))
    return checks


def _proc_oom_score(pid: str) -> int | None:
    try:
        return int((PROC_ROOT / pid / "oom_score_adj").read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return None


def _proc_cgroups(pid: str) -> list[str]:
    try:
        lines = (PROC_ROOT / pid / "cgroup").read_text(encoding="utf-8").splitlines()
    except OSError:
        return []
    paths: list[str] = []
    for line in lines:
        parts = line.split(":", 2)
        if len(parts) == 3 and parts[2].startswith("/"):
            paths.append(parts[2])
    return paths


def _pid_matches_cgroup(pid: str, cgroup: str) -> bool:
    if not cgroup.startswith("/"):
        return False
    prefix = f"{cgroup.rstrip('/')}/"
    return any(path == cgroup or path.startswith(prefix) for path in _proc_cgroups(pid))


def _cgroup_pids(cgroup: str) -> list[str]:
    if not cgroup:
        return []
    root = CGROUP_ROOT / cgroup.lstrip("/")
    if not root.is_dir():
        return []
    pids: set[str] = set()
    for procs in root.rglob("cgroup.procs"):
        try:
            for line in procs.read_text(encoding="utf-8").splitlines():
                if line.isdigit():
                    pids.add(line)
        except OSError:
            continue
    return sorted(pids, key=int)


def _protected_user_unit_memberships() -> dict[str, set[str]]:
    protected: dict[str, set[str]] = {}
    for unit in PROTECTED_USER_UNITS:
        values = _show(
            unit,
            ["OOMScoreAdjust", "MainPID", "ControlGroup", "MemoryLow", "MemoryMin", "Slice"],
            user=True,
        )
        cgroup = values.get("ControlGroup", "")
        main_pid = values.get("MainPID", "0")
        candidates = set(_cgroup_pids(cgroup))
        if main_pid.isdigit() and main_pid != "0":
            candidates.add(main_pid)
        if cgroup.startswith("/"):
            for pid in candidates:
                protected.setdefault(pid, set()).add(cgroup)
    return protected


def audit_protected_user_units() -> list[Check]:
    checks: list[Check] = []
    enforcer_attempted = False
    for unit, expected in PROTECTED_USER_UNITS.items():
        values = _show(
            unit,
            [
                "OOMScoreAdjust",
                "MainPID",
                "ControlGroup",
                "MemoryLow",
                "MemoryMin",
                "Slice",
                "NoNewPrivileges",
            ],
            user=True,
        )
        if "_error" in values:
            checks.append(
                Check(
                    f"user_unit_{unit}_OOMScoreAdjust",
                    "gap",
                    str(expected),
                    "N/A",
                    f"{values['_error']}; {NEXT_OOM_INSTALL}",
                )
            )
            continue
        actual = values.get("OOMScoreAdjust", "")
        parsed = _int_value(actual)
        status = "pass" if parsed == 100 else "gap"
        detail = (
            ""
            if status == "pass"
            else (
                "broadcast-critical user unit must start at the user manager's valid score 100; "
                f"root applies live score {expected} after startup; {NEXT_OOM_INSTALL}"
            )
        )
        checks.append(Check(f"user_unit_{unit}_OOMScoreAdjust", status, "100", actual, detail))
        slice_target = PROTECTED_USER_UNIT_SLICES[unit]
        slice_actual = values.get("Slice", "")
        slice_status = "pass" if slice_actual == slice_target else "gap"
        slice_detail = (
            ""
            if slice_status == "pass"
            else (
                f"broadcast-critical reservation must remain below {slice_target} so its checked "
                f"ancestor protection is effective; {NEXT_OOM_INSTALL}"
            )
        )
        checks.append(
            Check(
                f"user_unit_{unit}_Slice",
                slice_status,
                slice_target,
                slice_actual,
                slice_detail,
            )
        )
        if unit in AUDIO_USER_UNITS:
            sandbox_actual = values.get("NoNewPrivileges", "")
            sandbox_status = "pass" if sandbox_actual == "yes" else "gap"
            sandbox_detail = (
                ""
                if sandbox_status == "pass"
                else f"audio service must retain its distro privilege boundary; {NEXT_OOM_INSTALL}"
            )
            checks.append(
                Check(
                    f"user_unit_{unit}_NoNewPrivileges",
                    sandbox_status,
                    "yes",
                    sandbox_actual,
                    sandbox_detail,
                )
            )
        for key, memory_expected in PROTECTED_USER_UNIT_MEMORY[unit].items():
            memory_actual = values.get(key, "")
            memory_status = "pass" if _int_value(memory_actual) == memory_expected else "gap"
            memory_detail = (
                ""
                if memory_status == "pass"
                else f"broadcast-critical user unit memory reservation drifted; {NEXT_OOM_INSTALL}"
            )
            checks.append(
                Check(
                    f"user_unit_{unit}_{key}",
                    memory_status,
                    str(memory_expected),
                    memory_actual,
                    memory_detail,
                )
            )
        control_group = values.get("ControlGroup", "")
        live_pids = _cgroup_pids(control_group)
        main_pid = values.get("MainPID", "0")
        if main_pid.isdigit() and main_pid != "0":
            live_pids = sorted({*live_pids, main_pid}, key=int)
        for pid in live_pids:
            if not _pid_matches_cgroup(pid, control_group):
                actual_cgroups = _proc_cgroups(pid)
                checks.append(
                    Check(
                        f"user_unit_{unit}_pid_{pid}_cgroup_membership",
                        "gap",
                        f"{control_group} or descendant",
                        ",".join(actual_cgroups) if actual_cgroups else "N/A",
                        f"protected PID left or was reused outside its authoritative cgroup; {NEXT_OOM_INSTALL}",
                    )
                )
                continue
            live = _proc_oom_score(pid)
            if live != expected and not enforcer_attempted:
                enforcer_attempted = True
                _run([_systemctl(), "start", "hapax-oom-score-enforce.service"])
                live = _proc_oom_score(pid)
            if not _pid_matches_cgroup(pid, control_group):
                actual_cgroups = _proc_cgroups(pid)
                checks.append(
                    Check(
                        f"user_unit_{unit}_pid_{pid}_cgroup_membership",
                        "gap",
                        f"{control_group} or descendant",
                        ",".join(actual_cgroups) if actual_cgroups else "N/A",
                        f"protected PID moved during live-score readback; {NEXT_OOM_INSTALL}",
                    )
                )
                continue
            live_actual = "N/A" if live is None else str(live)
            live_status = "pass" if live == expected else "gap"
            live_detail = (
                ""
                if live_status == "pass"
                else f"live broadcast-critical user unit OOM score drifted after enforcer retry; {NEXT_OOM_INSTALL}"
            )
            checks.append(
                Check(
                    f"user_unit_{unit}_pid_{pid}_live_oom_score_adj",
                    live_status,
                    str(expected),
                    live_actual,
                    live_detail,
                )
            )
    return checks


def audit_tmux_scopes() -> list[Check]:
    proc = _run([_systemctl(), "--user", "list-units", "--type=scope", "--all", "--no-legend"])
    if proc.returncode != 0:
        return [
            Check(
                "tmux_scope_scan",
                "error",
                "observable",
                "N/A",
                f"{(proc.stderr or proc.stdout).strip()}; {NEXT_OOM_INSTALL}",
            )
        ]
    scopes = [line.split()[0] for line in proc.stdout.splitlines() if "tmux-spawn-" in line]
    checks: list[Check] = [Check("tmux_scope_count", "pass", ">=0", str(len(scopes)))]
    for scope in scopes:
        values = _show(scope, ["MemoryHigh", "MemoryMax", "MemorySwapMax", "Slice"], user=True)
        if "_error" in values:
            checks.append(
                Check(
                    f"tmux_scope_{scope}",
                    "error",
                    "bounded-or-app-slice-backed",
                    "N/A",
                    f"{values['_error']}; {NEXT_OOM_INSTALL}",
                )
            )
            continue
        unbounded = [
            key
            for key in ("MemoryHigh", "MemoryMax", "MemorySwapMax")
            if values.get(key) == "infinity"
        ]
        slice_name = values.get("Slice", "")
        outside_app_slice = slice_name != "app.slice"
        status = "gap" if unbounded and outside_app_slice else "pass"
        detail_parts = []
        if unbounded:
            detail_parts.append(f"unbounded properties: {', '.join(unbounded)}")
        if outside_app_slice:
            detail_parts.append(f"Slice={slice_name}")
        detail = ""
        if status == "gap" and detail_parts:
            detail = f"tmux scope not bounded-or-app-slice-backed: {'; '.join(detail_parts)}; {NEXT_OOM_INSTALL}"
        actual = ",".join(
            f"{key}={values.get(key, '')}"
            for key in ("MemoryHigh", "MemoryMax", "MemorySwapMax", "Slice")
        )
        checks.append(
            Check(f"tmux_scope_{scope}", status, "bounded-or-app-slice-backed", actual, detail)
        )
    return checks


_ALLOWED_USER_PROTECTED_NAMES = {
    "pipewire",
    "pipewire-pulse",
    "wireplumber",
    "dbus-broker",
    "dbus-daemon",
    "systemd",
}


def _status_field(status: Path, key: str) -> str:
    try:
        for line in status.read_text(encoding="utf-8", errors="replace").splitlines():
            parts = line.split()
            if parts and parts[0] == f"{key}:" and len(parts) > 1:
                return parts[1]
    except OSError:
        return ""
    return ""


def audit_residual_user_process_protection(uid: int) -> Check:
    proc_root = PROC_ROOT
    if not proc_root.is_dir():
        return Check(
            "user_process_residual_oom_protection",
            "error",
            "observable",
            "N/A",
            f"proc root unavailable; {NEXT_OOM_INSTALL}",
        )
    protected_memberships = _protected_user_unit_memberships()
    offenders: list[str] = []
    for adj in proc_root.glob("[0-9]*/oom_score_adj"):
        pid_dir = adj.parent
        status = pid_dir / "status"
        if _status_field(status, "Uid") != str(uid):
            continue
        try:
            score = int(adj.read_text(encoding="utf-8").strip())
        except (OSError, ValueError):
            continue
        if score > -800:
            continue
        if any(
            _pid_matches_cgroup(pid_dir.name, cgroup)
            for cgroup in protected_memberships.get(pid_dir.name, set())
        ):
            continue
        name = _status_field(status, "Name")
        if name in _ALLOWED_USER_PROTECTED_NAMES:
            continue
        offenders.append(f"{pid_dir.name}:{name}={score}")
    if offenders:
        shown = ",".join(offenders[:8])
        extra = "" if len(offenders) <= 8 else f",+{len(offenders) - 8} more"
        return Check(
            "user_process_residual_oom_protection",
            "gap",
            "no uid processes <= -800 outside allowlist",
            shown + extra,
            f"stale inherited OOMScoreAdjust; {NEXT_OOM_INSTALL}",
        )
    return Check(
        "user_process_residual_oom_protection",
        "pass",
        "no uid processes <= -800 outside allowlist",
        "none",
    )


def format_human(checks: list[Check]) -> str:
    lines = []
    for check in checks:
        suffix = f" ({check.detail})" if check.detail else ""
        lines.append(
            f"{check.status.upper():5} {check.name}: actual={check.actual} target={check.target}{suffix}"
        )
    return "\n".join(lines)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    output = parser.add_mutually_exclusive_group()
    output.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    output.add_argument(
        "--print-host-policy", action="store_true", help="emit selected profile fields"
    )
    parser.add_argument("--uid", type=int, default=os.getuid(), help="user manager UID to audit")
    args = parser.parse_args(argv)

    try:
        policy = current_host_policy()
    except HostPolicyError as exc:
        checks = [Check("host_policy", "error", "admitted exact host profile", "N/A", str(exc))]
        if args.json:
            print(
                json.dumps(
                    {"checks": [asdict(check) for check in checks]}, indent=2, sort_keys=True
                )
            )
        else:
            print(format_human(checks))
        return 1
    if args.print_host_policy:
        ceilings = (
            policy.app_high,
            policy.app_max,
            policy.uid_high,
            policy.uid_max,
            policy.system_high,
            policy.system_max,
            policy.system_low,
        )
        print(
            "\t".join(
                (
                    policy.profile,
                    *(f"{n // BYTES_1G}G" for n in ceilings),
                    str(policy.zram_mib),
                    str(policy.swappiness),
                )
            )
        )
        return 0

    try:
        with shared_root_required_lock():
            checks = [
                Check(
                    "root_required_package_lock",
                    "pass",
                    "shared package lock held during readback",
                    str(ROOT_REQUIRED_LOCK_FILE),
                ),
                audit_user_manager(args.uid),
                audit_user_manager_policy(args.uid),
                audit_user_manager_live_score(args.uid),
                *audit_recovery_system_units(),
                *audit_sshd_policy(),
                *audit_system_slice_reservation(policy),
                *audit_swappiness(policy),
                *audit_user_slice_reservation(),
                *audit_system_memory_unit(f"user-{args.uid}.slice", policy),
                *audit_system_memory_unit(f"user@{args.uid}.service", policy),
                *audit_app_slice(policy),
                *audit_session_slice(),
                *audit_user_child_floor_composition(args.uid),
                *audit_protected_user_units(),
                audit_residual_user_process_protection(args.uid),
                *audit_tmux_scopes(),
            ]
    except AuditLockError as exc:
        checks = [
            Check(
                "root_required_package_lock",
                "error",
                "shared package lock held during readback",
                str(ROOT_REQUIRED_LOCK_FILE),
                f"{exc}; {NEXT_OOM_INSTALL}",
            )
        ]
    if args.json:
        print(json.dumps({"checks": [asdict(check) for check in checks]}, indent=2, sort_keys=True))
    else:
        print(format_human(checks))
    return 1 if any(check.status in {"gap", "error"} for check in checks) else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
