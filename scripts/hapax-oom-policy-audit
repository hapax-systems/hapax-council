LOCAL_DOCKER_CONFIG = "/nonexistent/hapax-oom-policy-audit-docker"
COMMAND_OUTPUT_LIMIT = 16 * 1024
COMMAND_TIMEOUT_SECONDS = 10.0
DOCKER_INVENTORY_MAX_ROWS = 512
DOCKER_TARGET_MAX = 64
DOCKER_INVENTORY_LINE_MAX = 512
DOCKER_INSPECT_LINE_MAX = 2048
