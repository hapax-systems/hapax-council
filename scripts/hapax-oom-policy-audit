from pathlib import Path

SAFE_PATH = "/usr/local/sbin:/usr/local/bin:/usr/bin:/bin"
os.environ["PATH"] = SAFE_PATH

BYTES_1G = 1024**3
BYTES_2G = 2 * 1024**3
BYTES_12G = 12 * 1024**3
BYTES_24G = 24 * 1024**3
BYTES_72G = 72 * 1024**3
BYTES_80G = 80 * 1024**3
BYTES_88G = 88 * 1024**3
BYTES_96G = 96 * 1024**3
BYTES_16G = 16 * 1024**3
BYTES_8G = 8 * 1024**3
BYTES_10G = 10 * 1024**3
BYTES_20G = 20 * 1024**3
NEXT_OOM_INSTALL = "next action: scripts/install-p0-oom-containment --install --verify-live"
PROC_ROOT = Path(os.environ.get("HAPAX_OOM_AUDIT_PROC_ROOT", "/proc"))
CGROUP_ROOT = Path(os.environ.get("HAPAX_OOM_AUDIT_CGROUP_ROOT", "/sys/fs/cgroup"))
ROOT_REQUIRED_STATE_ROOT = Path(
    os.environ.get(
        "HAPAX_ROOT_REQUIRED_STATE_ROOT",
        str(Path.home() / ".local/state/hapax/root-required"),
    )
)
ROOT_REQUIRED_LOCK_FILE = Path(
    os.environ.get("HAPAX_ROOT_REQUIRED_LOCK_FILE", str(ROOT_REQUIRED_STATE_ROOT / ".lock"))
)
RECOVERY_SYSTEM_UNITS = {
