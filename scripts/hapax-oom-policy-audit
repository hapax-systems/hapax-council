    values = _show(unit, list(expected))
    if "_error" in values:
        return [
            Check(
                f"{unit}_memory",
                "error",
                "bounded",
                "N/A",
                f"{values['_error']}; {NEXT_OOM_INSTALL}",
            )
        ]
    checks: list[Check] = []
    for key, target in expected.items():
        actual = values.get(key, "")
        parsed = _int_value(actual)
        status = "pass" if parsed == target else "gap"
        detail = (
            ""
            if status == "pass"
            else f"{unit} aggregate memory policy drifted; {NEXT_OOM_INSTALL}"
        )
        checks.append(Check(f"{unit}_{key}", status, str(target), actual, detail))
    return checks


def audit_zram(policy: HostMemoryPolicy) -> list[Check]:
    size_path = SYS_ROOT / "block" / "zram0" / "disksize"
    try:
        actual = int(size_path.read_text(encoding="utf-8").strip())
    except (OSError, ValueError) as exc:
        size_check = Check(
            "zram0_disksize",
            "error",
            str(policy.zram_size),
            "N/A",
            f"cannot read {size_path}: {exc}; {NEXT_OOM_INSTALL}",
        )
    else:
        status = "pass" if actual == policy.zram_size else "gap"
        detail = "" if status == "pass" else f"host zram size drifted; {NEXT_OOM_INSTALL}"
        size_check = Check("zram0_disksize", status, str(policy.zram_size), str(actual), detail)

    swaps_path = PROC_ROOT / "swaps"
    try:
        swap_lines = swaps_path.read_text(encoding="utf-8").splitlines()[1:]
    except OSError as exc:
        active_check = Check(
            "zram0_active_swap",
            "error",
            "/dev/zram0 priority 100",
            "N/A",
            f"cannot read {swaps_path}: {exc}; {NEXT_OOM_INSTALL}",
        )
    else:
        zram_fields = next(
            (line.split() for line in swap_lines if line.split()[:1] == ["/dev/zram0"]),
            None,
        )
        actual_swap = "absent" if zram_fields is None else f"active priority {zram_fields[-1]}"
        swap_ok = zram_fields is not None and zram_fields[-1] == "100"
        active_check = Check(
            "zram0_active_swap",
            "pass" if swap_ok else "gap",
            "/dev/zram0 priority 100",
            actual_swap,
            "" if swap_ok else f"zram swap activation drifted; {NEXT_OOM_INSTALL}",
        )

    compression_path = SYS_ROOT / "block" / "zram0" / "comp_algorithm"
    try:
        compression = compression_path.read_text(encoding="utf-8").strip()
    except OSError as exc:
        compression_check = Check(
            "zram0_compression",
            "error",
            "zstd",
            "N/A",
            f"cannot read {compression_path}: {exc}; {NEXT_OOM_INSTALL}",
        )
    else:
        compression_ok = "[zstd]" in compression.split()
        compression_check = Check(
            "zram0_compression",
            "pass" if compression_ok else "gap",
            "zstd",
            compression,
            "" if compression_ok else f"zram compression drifted; {NEXT_OOM_INSTALL}",
        )
    return [size_check, active_check, compression_check]


def _docker_policy(name: str) -> tuple[int, int] | None:
    if name == "hapax-local-judge":
        return BYTES_4G, BYTES_6G
    if name.startswith("hapax-github-mcp-") and name != "hapax-github-mcp-":
        return BYTES_512M, BYTES_768M
    return None


def _docker_check_name(container: str, field: str) -> str:
    safe = re.sub(r"[^A-Za-z0-9]+", "_", container).strip("_")
    return f"docker_{safe}_{field}"


def _docker_container_records() -> tuple[list[tuple[str, str]], str | None]:
    listed = _run_local_docker(["ps", "-a", "--no-trunc", "--format", "{{.ID}}\t{{.Names}}"])
    if listed.returncode != 0:
        detail = (listed.stderr or listed.stdout).strip() or f"rc={listed.returncode}"
        return [], f"cannot enumerate Docker containers: {detail}"
    records: list[tuple[str, str]] = []
    for line in listed.stdout.splitlines():
        if not line.strip():
            continue
        fields = line.split("\t")
        if len(fields) != 2 or re.fullmatch(r"[0-9a-f]{12,64}", fields[0]) is None or not fields[1]:
            return [], f"unparseable Docker identity record: {line}"
        records.append((fields[0], fields[1]))
    return records, None


def _docker_target_records() -> tuple[list[tuple[str, str, tuple[int, int]]], str | None]:
    records, error = _docker_container_records()
    if error is not None:
        return [], error
    targets: list[tuple[str, str, tuple[int, int]]] = []
    for container_id, name in records:
        if policy := _docker_policy(name):
            targets.append((container_id, name, policy))
    return targets, None


def _docker_target_absent(container_id: str, name: str) -> tuple[bool, str | None]:
    records, error = _docker_container_records()
    if error is not None:
        return False, error
    return all(
        current_id != container_id and current_name != name for current_id, current_name in records
    ), None


def audit_docker_limits() -> list[Check]:
    targets, enumeration_error = _docker_target_records()
    if enumeration_error is not None:
        return [
            Check(
                "docker_container_limits",
                "error",
                "all present target containers capped",
                "N/A",
                f"{enumeration_error}; {NEXT_OOM_INSTALL}",
            )
        ]
    if not targets:
        return [
            Check(
                "docker_container_limits",
                "pass",
                "all present target containers capped",
                "none present",
            )
        ]

    checks: list[Check] = []
    for container_id, name, (expected_memory, expected_swap) in targets:
        inspected = _run_local_docker(
            [
                "inspect",
                "--format",
                "{{.Id}}\t{{.Name}}\t{{.HostConfig.Memory}}\t{{.HostConfig.MemorySwap}}\t{{json .HostConfig.OomKillDisable}}\t{{.State.Status}}",
                container_id,
            ]
        )
        if inspected.returncode != 0:
            detail = (inspected.stderr or inspected.stdout).strip() or f"rc={inspected.returncode}"
            disappeared, reenumeration_error = _docker_target_absent(container_id, name)
            if disappeared:
                checks.append(
                    Check(
                        _docker_check_name(name, "inspect"),
                        "pass",
                        "inspectable or absent by both identity and owned name",
                        f"id={container_id} and name={name} absent",
                    )
                )
                continue
            if reenumeration_error is not None:
                detail = f"{detail}; identity/name absence proof failed: {reenumeration_error}"
            else:
                detail = f"{detail}; original identity or same-name target remains"
            checks.append(
                Check(
                    _docker_check_name(name, "inspect"),
                    "error",
                    "inspectable or absent by both identity and owned name",
                    "N/A",
                    f"Docker inspect failed: {detail}; {NEXT_OOM_INSTALL}",
                )
            )
            continue
        fields = inspected.stdout.strip().split("\t")
        if len(fields) != 6:
            checks.append(
                Check(
                    _docker_check_name(name, "inspect"),
                    "error",
                    "id, name, memory, memory-swap, OOM-kill-disabled, state",
                    inspected.stdout.strip() or "empty",
                    f"unparseable Docker inspect result; {NEXT_OOM_INSTALL}",
                )
            )
            continue
        inspected_id = fields[0]
        inspected_name = fields[1].removeprefix("/")
        oom_kill_disable_raw = fields[4]
        container_state = fields[5]
        try:
            actual_memory, actual_swap = int(fields[2]), int(fields[3])
        except ValueError:
            checks.append(
                Check(
                    _docker_check_name(name, "inspect"),
                    "error",
                    "numeric memory limits",
                    inspected.stdout.strip(),
                    f"unparseable Docker memory limits; {NEXT_OOM_INSTALL}",
                )
            )
            continue
        if inspected_id != container_id or inspected_name != name:
            checks.append(
                Check(
                    _docker_check_name(name, "inspect"),
                    "error",
                    f"{container_id} {name}",
                    f"{inspected_id} {inspected_name}",
                    f"Docker inspect identity mismatch; {NEXT_OOM_INSTALL}",
                )
            )
            continue
        if name == "hapax-local-judge":
            state_status = "pass" if container_state == "running" else "gap"
            state_detail = (
                ""
                if state_status == "pass"
                else "local-judge name is held by a non-running container; stop the user unit, "
                f"inspect immutable container id {container_id}, remove that exact ID without -f "
                "only after confirming it is stale, restart hapax-local-judge.service, and rerun "
                "the OOM audit"
            )
            checks.append(
                Check(
                    _docker_check_name(name, "State"),
                    state_status,
                    "running",
                    container_state or "empty",
                    state_detail,
                )
            )
        if oom_kill_disable_raw not in {"null", "true", "false"}:
            checks.append(
                Check(
                    _docker_check_name(name, "OomKillDisable"),
                    "error",
                    "false",
                    fields[4] or "empty",
                    f"unparseable Docker OOM-kill-disable state; {NEXT_OOM_INSTALL}",
                )
            )
            continue
        for field, expected, actual in (
            ("Memory", expected_memory, actual_memory),
            ("MemorySwap", expected_swap, actual_swap),
        ):
            status = "pass" if actual == expected else "gap"
            detail = "" if status == "pass" else f"Docker limit drifted; {NEXT_OOM_INSTALL}"
            checks.append(
                Check(
                    _docker_check_name(name, field),
                    status,
                    str(expected),
                    str(actual),
                    detail,
                )
            )
        # Docker serializes an omitted *bool as null. Both null and explicit
        # false leave the kernel OOM killer enabled; only true disables it.
        oom_kill_disable = "true" if oom_kill_disable_raw == "true" else "false"
        oom_status = "pass" if oom_kill_disable == "false" else "gap"
        oom_detail = (
            ""
            if oom_status == "pass"
            else "Docker OOM killer is disabled; recreate the container from its governed "
            f"launch source without --oom-kill-disable, then {NEXT_OOM_INSTALL}"
        )
        checks.append(
            Check(
                _docker_check_name(name, "OomKillDisable"),
                oom_status,
                "false",
                oom_kill_disable,
                oom_detail,
            )
        )
    return checks


def audit_system_slice_reservation() -> list[Check]:
    expected: dict[str, int | None] = {
        "MemoryHigh": None,
        "MemoryMax": None,
        "MemorySwapMax": None,
        "MemoryLow": BYTES_24G,
        "MemoryMin": BYTES_12G,
    }
    values = _show("system.slice", list(expected))
    if "_error" in values:
        return [
            Check(
                "system_slice_reservation",
                "error",
                "protected",
                "N/A",
                f"{values['_error']}; {NEXT_OOM_INSTALL}",
            )
        ]
    checks: list[Check] = []
    for key, target in expected.items():
        actual = values.get(key, "")
        target_text = "infinity" if target is None else str(target)
        status = "pass" if actual == target_text else "gap"
        detail = (
            ""
            if status == "pass"
            else f"system.slice recovery-plane reservation drifted; {NEXT_OOM_INSTALL}"
        )
        checks.append(Check(f"system_slice_{key}", status, target_text, actual, detail))
    return checks


def audit_user_slice_reservation() -> list[Check]:
