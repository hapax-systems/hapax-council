def _proc_oom_score(pid: str) -> int | None:
    try:
        return int((PROC_ROOT / pid / "oom_score_adj").read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return None


def _proc_cgroups(pid: str) -> list[str]:
    try:
        lines = (PROC_ROOT / pid / "cgroup").read_text(encoding="utf-8").splitlines()
    except OSError:
        return []
    paths: list[str] = []
    for line in lines:
        parts = line.split(":", 2)
        if len(parts) == 3 and parts[2].startswith("/"):
            paths.append(parts[2])
    return paths


def _pid_matches_cgroup(pid: str, cgroup: str) -> bool:
    if not cgroup.startswith("/"):
        return False
    prefix = f"{cgroup.rstrip('/')}/"
    return any(path == cgroup or path.startswith(prefix) for path in _proc_cgroups(pid))


def _cgroup_pids(cgroup: str) -> list[str]:
    if not cgroup:
        return []
    root = CGROUP_ROOT / cgroup.lstrip("/")
    if not root.is_dir():
        return []
    pids: set[str] = set()
    for procs in root.rglob("cgroup.procs"):
        try:
            for line in procs.read_text(encoding="utf-8").splitlines():
                if line.isdigit():
                    pids.add(line)
        except OSError:
            continue
    return sorted(pids, key=int)


def _pid_matches_observed_unit_process_tree(pid: str, main_pid: str, cgroup: str, uid: int) -> bool:
    if not pid.isdigit() or not main_pid.isdigit() or main_pid == "0" or not cgroup.startswith("/"):
        return False
    current = pid
    seen: set[str] = set()
    for _ in range(256):
        if current in seen or not current.isdigit() or current == "0":
            return False
        seen.add(current)
        if not _pid_matches_cgroup(current, cgroup):
            return False
        status = PROC_ROOT / current / "status"
        if _status_field(status, "Uid") != str(uid):
            return False
        if current == main_pid:
            return True
        current = _status_field(status, "PPid")
    return False


def audit_protected_user_units(policy: HostMemoryPolicy, uid: int) -> list[Check]:
    checks: list[Check] = []
    for unit, expected in PROTECTED_USER_UNITS.items():
        values = _show(
            unit,
            [
                "LoadState",
                "OOMScoreAdjust",
                "MainPID",
                "ControlGroup",
                "MemoryLow",
                "MemoryMin",
                "Slice",
                "NoNewPrivileges",
            ],
            user=True,
        )
        if values.get("LoadState") == "not-found":
            if unit in policy.optional_user_units:
                checks.append(
                    Check(
                        f"user_unit_{unit}_availability",
                        "pass",
                        "optional on appendix",
                        "not-found",
                    )
                )
            else:
                checks.append(
                    Check(
                        f"user_unit_{unit}_availability",
                        "gap",
                        "loaded",
                        "not-found",
                        f"required protected user unit is unavailable; {NEXT_OOM_ACTION}",
                    )
                )
            continue
        if "_error" in values:
            checks.append(
                Check(
                    f"user_unit_{unit}_OOMScoreAdjust",
                    "gap",
                    str(expected),
                    "N/A",
                    f"{values['_error']}; {NEXT_OOM_ACTION}",
                )
            )
            continue
        actual = values.get("OOMScoreAdjust", "")
        parsed = _int_value(actual)
        status = "pass" if parsed == 100 else "gap"
        detail = (
            ""
            if status == "pass"
            else (
                "delegated user units must remain at the user manager's score 100; "
                f"root-negative user scoring is retired; {NEXT_OOM_ACTION}"
            )
        )
        checks.append(Check(f"user_unit_{unit}_OOMScoreAdjust", status, "100", actual, detail))
        slice_target = PROTECTED_USER_UNIT_SLICES[unit]
        slice_actual = values.get("Slice", "")
        slice_status = "pass" if slice_actual == slice_target else "gap"
        slice_detail = (
            ""
            if slice_status == "pass"
            else (
                f"broadcast-critical reservation must remain below {slice_target} so its checked "
                f"ancestor protection is effective; {NEXT_OOM_ACTION}"
            )
        )
        checks.append(
            Check(
                f"user_unit_{unit}_Slice",
                slice_status,
                slice_target,
                slice_actual,
                slice_detail,
            )
        )
        if unit in AUDIO_USER_UNITS:
            sandbox_actual = values.get("NoNewPrivileges", "")
            sandbox_status = "pass" if sandbox_actual == "yes" else "gap"
            sandbox_detail = (
                ""
                if sandbox_status == "pass"
                else f"audio service must retain its distro privilege boundary; {NEXT_OOM_ACTION}"
            )
            checks.append(
                Check(
                    f"user_unit_{unit}_NoNewPrivileges",
                    sandbox_status,
                    "yes",
                    sandbox_actual,
                    sandbox_detail,
                )
            )
        for key, memory_expected in PROTECTED_USER_UNIT_MEMORY[unit].items():
            memory_actual = values.get(key, "")
            memory_status = "pass" if _int_value(memory_actual) == memory_expected else "gap"
            memory_detail = (
                ""
                if memory_status == "pass"
                else f"broadcast-critical user unit memory reservation drifted; {NEXT_OOM_ACTION}"
            )
            checks.append(
                Check(
                    f"user_unit_{unit}_{key}",
                    memory_status,
                    str(memory_expected),
                    memory_actual,
                    memory_detail,
                )
            )
        control_group = values.get("ControlGroup", "")
        live_pids = _cgroup_pids(control_group)
        main_pid = values.get("MainPID", "0")
        if main_pid.isdigit() and main_pid != "0":
            live_pids = sorted({*live_pids, main_pid}, key=int)
        for pid in live_pids:
            if not _pid_matches_cgroup(pid, control_group):
                actual_cgroups = _proc_cgroups(pid)
                checks.append(
                    Check(
                        f"user_unit_{unit}_pid_{pid}_cgroup_membership",
                        "gap",
                        f"{control_group} or descendant",
                        ",".join(actual_cgroups) if actual_cgroups else "N/A",
                        f"protected PID left or was reused outside its authoritative cgroup; {NEXT_OOM_ACTION}",
                    )
                )
                continue
            if not _pid_matches_observed_unit_process_tree(pid, main_pid, control_group, uid):
                checks.append(
                    Check(
                        f"user_unit_{unit}_pid_{pid}_process_tree_identity",
                        "gap",
                        f"uid {uid} descendant of MainPID {main_pid}",
                        f"uid={_status_field(PROC_ROOT / pid / 'status', 'Uid') or 'N/A'},"
                        f"ppid={_status_field(PROC_ROOT / pid / 'status', 'PPid') or 'N/A'}",
                        "reported user-manager cgroup/process-tree observation was inconsistent; "
                        f"user-manager data remains non-authoritative; {NEXT_OOM_ACTION}",
                    )
                )
                continue
            live = _proc_oom_score(pid)
            if not _pid_matches_cgroup(
                pid, control_group
            ) or not _pid_matches_observed_unit_process_tree(pid, main_pid, control_group, uid):
                actual_cgroups = _proc_cgroups(pid)
                checks.append(
                    Check(
                        f"user_unit_{unit}_pid_{pid}_cgroup_membership",
                        "gap",
                        f"{control_group} or descendant",
                        ",".join(actual_cgroups) if actual_cgroups else "N/A",
                        f"protected PID moved or changed process-tree identity during live-score readback; {NEXT_OOM_ACTION}",
                    )
                )
                continue
            live_actual = "N/A" if live is None else str(live)
            live_status = "pass" if live == expected else "gap"
            live_detail = (
                ""
                if live_status == "pass"
                else f"live delegated user unit must remain at score 100; {NEXT_OOM_ACTION}"
            )
            checks.append(
                Check(
                    f"user_unit_{unit}_pid_{pid}_live_oom_score_adj",
                    live_status,
                    str(expected),
                    live_actual,
                    live_detail,
                )
            )
    return checks


def audit_tmux_scopes() -> list[Check]:
    proc = _run([_systemctl(), "--user", "list-units", "--type=scope", "--all", "--no-legend"])
    if proc.returncode != 0:
        return [
            Check(
                "tmux_scope_scan",
                "error",
                "observable",
                "N/A",
                f"{(proc.stderr or proc.stdout).strip()}; {NEXT_OOM_ACTION}",
            )
        ]
    scopes = [line.split()[0] for line in proc.stdout.splitlines() if "tmux-spawn-" in line]
    checks: list[Check] = [Check("tmux_scope_count", "pass", ">=0", str(len(scopes)))]
    for scope in scopes:
        values = _show(scope, ["MemoryHigh", "MemoryMax", "MemorySwapMax", "Slice"], user=True)
        if "_error" in values:
            checks.append(
                Check(
                    f"tmux_scope_{scope}",
                    "error",
                    "bounded-or-app-slice-backed",
                    "N/A",
                    f"{values['_error']}; {NEXT_OOM_ACTION}",
                )
            )
            continue
        unbounded = [
            key
            for key in ("MemoryHigh", "MemoryMax", "MemorySwapMax")
            if values.get(key) == "infinity"
        ]
        slice_name = values.get("Slice", "")
        outside_app_slice = slice_name != "app.slice"
        status = "gap" if unbounded and outside_app_slice else "pass"
        detail_parts = []
        if unbounded:
            detail_parts.append(f"unbounded properties: {', '.join(unbounded)}")
        if outside_app_slice:
            detail_parts.append(f"Slice={slice_name}")
        detail = ""
        if status == "gap" and detail_parts:
            detail = f"tmux scope not bounded-or-app-slice-backed: {'; '.join(detail_parts)}; {NEXT_OOM_ACTION}"
        actual = ",".join(
            f"{key}={values.get(key, '')}"
            for key in ("MemoryHigh", "MemoryMax", "MemorySwapMax", "Slice")
        )
        checks.append(
            Check(f"tmux_scope_{scope}", status, "bounded-or-app-slice-backed", actual, detail)
        )
    return checks


def _status_field(status: Path, key: str) -> str:
    try:
        for line in status.read_text(encoding="utf-8", errors="replace").splitlines():
            parts = line.split()
            if parts and parts[0] == f"{key}:" and len(parts) > 1:
                return parts[1]
    except OSError:
        return ""
    return ""


def audit_residual_user_process_protection(uid: int) -> Check:
    proc_root = PROC_ROOT
    if not proc_root.is_dir():
        return Check(
            "user_process_residual_oom_protection",
            "error",
            "observable",
            "N/A",
            f"proc root unavailable; {NEXT_OOM_ACTION}",
        )
    offenders: list[str] = []
    for adj in proc_root.glob("[0-9]*/oom_score_adj"):
        pid_dir = adj.parent
        status = pid_dir / "status"
        if _status_field(status, "Uid") != str(uid):
            continue
        try:
            score = int(adj.read_text(encoding="utf-8").strip())
        except (OSError, ValueError):
            continue
        if score >= 0:
            continue
        name = _status_field(status, "Name")
        offenders.append(f"{pid_dir.name}:{name}={score}")
    if offenders:
        shown = ",".join(offenders[:8])
        extra = "" if len(offenders) <= 8 else f",+{len(offenders) - 8} more"
        return Check(
            "user_process_residual_oom_protection",
            "gap",
            "no observed uid processes with negative oom_score_adj",
            shown + extra,
            f"root-granted or inherited negative OOM score remains after bridge retirement; {NEXT_OOM_ACTION}",
        )
    return Check(
        "user_process_residual_oom_protection",
        "pass",
        "no observed uid processes with negative oom_score_adj",
        "none",
        "point-in-time observational scan only; it does not prove absence across fork or cgroup races",
    )


def audit_zram(policy: HostMemoryPolicy) -> list[Check]:
    checks: list[Check] = []
    size_path = SYS_ROOT / "block/zram0/disksize"
    try:
        actual_size = int(size_path.read_text(encoding="utf-8").strip())
    except (OSError, ValueError) as exc:
        checks.append(
            Check(
                "zram_size",
                "error",
                str(policy.zram_size),
                "N/A",
                f"cannot read {size_path}: {exc}; {NEXT_OOM_ACTION}",
            )
        )
    else:
        checks.append(
            Check(
                "zram_size",
                "pass" if actual_size == policy.zram_size else "gap",
                str(policy.zram_size),
                str(actual_size),
                ""
                if actual_size == policy.zram_size
                else f"host zram size drifted; {NEXT_OOM_ACTION}",
            )
        )

    compression_path = SYS_ROOT / "block/zram0/comp_algorithm"
    try:
        compression = compression_path.read_text(encoding="utf-8").strip()
    except OSError as exc:
        checks.append(
            Check(
                "zram_compression",
                "error",
                "zstd selected",
                "N/A",
                f"cannot read {compression_path}: {exc}; {NEXT_OOM_ACTION}",
            )
        )
    else:
        selected = next(
            (
                token[1:-1]
                for token in compression.split()
                if token.startswith("[") and token.endswith("]")
            ),
            "",
        )
        checks.append(
            Check(
                "zram_compression",
                "pass" if selected == "zstd" else "gap",
                "zstd",
                selected or compression,
                "" if selected == "zstd" else f"zram compression drifted; {NEXT_OOM_ACTION}",
            )
        )

    swaps_path = PROC_ROOT / "swaps"
    try:
        swap_lines = swaps_path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        checks.append(
            Check(
                "zram_swap_active",
                "error",
                "/dev/zram0 active",
                "N/A",
                f"cannot read {swaps_path}: {exc}; {NEXT_OOM_ACTION}",
            )
        )
    else:
        active = any(line.split()[:1] == ["/dev/zram0"] for line in swap_lines[1:])
        checks.append(
            Check(
                "zram_swap_active",
                "pass" if active else "gap",
                "/dev/zram0 active",
                "active" if active else "absent",
                "" if active else f"zram swap activation drifted; {NEXT_OOM_ACTION}",
            )
        )
    return checks


def audit_docker_limits() -> list[Check]:
    enumeration = _run_local_docker(["ps", "-a", "--no-trunc", "--format", "{{.ID}}\t{{.Names}}"])
    if enumeration.returncode != 0:
        detail = (
            enumeration.stderr or enumeration.stdout
        ).strip() or f"rc={enumeration.returncode}"
        return [
            Check(
                "docker_oom_targets",
                "error",
                "local Docker inventory observable",
                "N/A",
                f"Docker enumeration failed: {detail}; {NEXT_OOM_ACTION}",
            )
        ]

    inventory_lines = enumeration.stdout.splitlines()
    if len(inventory_lines) > DOCKER_INVENTORY_MAX_ROWS:
        return [
            Check(
                "docker_oom_targets",
                "error",
                f"at most {DOCKER_INVENTORY_MAX_ROWS} inventory rows",
                str(len(inventory_lines)),
                f"Docker inventory row bound exceeded; {NEXT_OOM_ACTION}",
            )
        ]

    targets: list[tuple[str, str]] = []
    seen_names: set[str] = set()
    for raw_line in inventory_lines:
        if not raw_line:
            continue
        if len(raw_line) > DOCKER_INVENTORY_LINE_MAX:
            return [
                Check(
                    "docker_oom_targets",
                    "error",
                    f"inventory lines at most {DOCKER_INVENTORY_LINE_MAX} characters",
                    f"length={len(raw_line)}",
                    f"Docker inventory line bound exceeded; {NEXT_OOM_ACTION}",
                )
            ]
        fields = raw_line.split("\t")
        if len(fields) != 2 or re.fullmatch(r"[0-9a-f]{64}", fields[0]) is None:
            return [
                Check(
                    "docker_oom_targets",
                    "error",
                    "full immutable IDs and exact names",
                    raw_line[:256],
                    f"malformed Docker inventory; {NEXT_OOM_ACTION}",
                )
            ]
        container_id, name = fields
        if name in seen_names:
            return [
                Check(
                    "docker_oom_targets",
                    "error",
                    "unique exact names",
                    name,
                    f"duplicate Docker name in inventory; {NEXT_OOM_ACTION}",
                )
            ]
        seen_names.add(name)
        if name == "hapax-local-judge" or (
            name.startswith("hapax-github-mcp-") and len(name) > len("hapax-github-mcp-")
        ):
            targets.append((container_id, name))

    if len(targets) > DOCKER_TARGET_MAX:
        return [
            Check(
                "docker_oom_targets",
                "error",
                f"at most {DOCKER_TARGET_MAX} OOM targets",
                str(len(targets)),
                f"Docker target count bound exceeded; {NEXT_OOM_ACTION}",
            )
        ]

    checks: list[Check] = []
    judge = next(
        ((container_id, name) for container_id, name in targets if name == "hapax-local-judge"),
        None,
    )
    checks.append(
        Check(
            "docker_hapax-local-judge_retired",
            "pass" if judge is None else "gap",
            "absent",
            "absent" if judge is None else judge[0],
            "" if judge is None else f"historical local judge remains live; {NEXT_OOM_ACTION}",
        )
    )

    mcp_targets = [
        (container_id, name)
        for container_id, name in targets
        if name.startswith("hapax-github-mcp-")
    ]
    checks.append(Check("docker_github_mcp_count", "pass", ">=0", str(len(mcp_targets))))
    for container_id, name in mcp_targets:
        inspected = _run_local_docker(
            [
                "inspect",
                "--format",
                (
                    "{{json .Id}}\t{{json .Name}}\t{{json .HostConfig.Memory}}\t"
                    "{{json .HostConfig.MemorySwap}}\t{{json .HostConfig.OomKillDisable}}\t"
                    "{{json .Image}}\t{{json .Config.Image}}\t{{json .Path}}\t{{json .Args}}"
                ),
                container_id,
            ]
        )
        if inspected.returncode != 0:
            detail = (inspected.stderr or inspected.stdout).strip() or f"rc={inspected.returncode}"
            checks.append(
                Check(
                    f"docker_{name}_limits",
                    "error",
                    f"Memory={BYTES_512M},MemorySwap={BYTES_768M},OomKillDisable=false",
                    "N/A",
                    f"Docker inspect failed for immutable ID {container_id}: {detail}; {NEXT_OOM_ACTION}",
                )
            )
            continue
        try:
            inspect_lines = inspected.stdout.splitlines()
            if len(inspect_lines) != 1 or len(inspect_lines[0]) > DOCKER_INSPECT_LINE_MAX:
                raise ValueError("expected one bounded Docker inspect line")
            fields = inspect_lines[0].split("\t")
            if len(fields) != 9:
                raise ValueError("expected nine formatted Docker inspect fields")
            (
                actual_id,
                actual_name,
                memory,
                memory_swap,
                oom_kill_disable,
                image_id,
                config_image,
                process_path,
                process_args,
            ) = (json.loads(field) for field in fields)
            if not all(
                isinstance(value, str)
                for value in (actual_id, actual_name, image_id, config_image, process_path)
            ):
                raise TypeError("Docker identity fields must be strings")
            if type(memory) is not int or type(memory_swap) is not int:
                raise TypeError("Docker memory fields must be integers")
            if oom_kill_disable is not None and type(oom_kill_disable) is not bool:
                raise TypeError("Docker OomKillDisable must be null or boolean")
            if not isinstance(process_args, list) or not all(
                isinstance(value, str) for value in process_args
            ):
                raise TypeError("Docker process arguments must be a string list")
        except (TypeError, ValueError, json.JSONDecodeError) as exc:
            checks.append(
                Check(
                    f"docker_{name}_limits",
                    "error",
                    "one complete inspect record",
                    "malformed",
                    f"cannot parse Docker inspect for {container_id}: {exc}; {NEXT_OOM_ACTION}",
                )
            )
            continue
        identity_ok = actual_id == container_id and actual_name == f"/{name}"
        command_ok = (
            image_id == GITHUB_MCP_IMAGE_DIGEST
            and config_image == GITHUB_MCP_IMAGE
            and process_path == GITHUB_MCP_PATH
            and len(process_args) == 4
            and process_args[:3] == ["stdio", "--log-file", "/tmp/github-mcp.log"]
            and re.fullmatch(r"--(?:tools|toolsets)=[A-Za-z0-9_,.-]{1,1024}", process_args[3])
            is not None
        )
        limits_ok = (
            memory == BYTES_512M and memory_swap == BYTES_768M and oom_kill_disable in {None, False}
        )
        status = "pass" if identity_ok and limits_ok and command_ok else "gap"
        actual = (
            f"id={actual_id},name={actual_name},Memory={memory},"
            f"MemorySwap={memory_swap},OomKillDisable={oom_kill_disable},"
            f"Image={image_id},ConfigImage={config_image},Path={process_path},Args={process_args}"
        )
        checks.append(
            Check(
                f"docker_{name}_limits",
                status,
                f"id={container_id},name=/{name},Memory={BYTES_512M},"
                f"MemorySwap={BYTES_768M},OomKillDisable=false,Image={GITHUB_MCP_IMAGE}",
                actual,
                ""
                if status == "pass"
                else f"Docker identity, image, command, or limit drifted; {NEXT_OOM_ACTION}",
            )
        )
    return checks


def audit_local_judge_unit() -> Check:
    values = _show(
        "hapax-local-judge.service",
        ["LoadState", "UnitFileState", "ActiveState", "FragmentPath"],
        user=True,
    )
    expected = {
        "LoadState": "masked",
        "UnitFileState": "masked",
        "ActiveState": "inactive",
        "FragmentPath": "/dev/null",
    }
    if "_error" in values:
        return Check(
            "local_judge_unit_retired",
            "error",
            ",".join(f"{key}={value}" for key, value in expected.items()),
            "N/A",
            f"cannot observe the historical local-judge unit: {values['_error']}; {NEXT_OOM_ACTION}",
        )
    actual = ",".join(f"{key}={values.get(key, 'N/A')}" for key in expected)
    matches = all(values.get(key) == value for key, value in expected.items())
    return Check(
        "local_judge_unit_retired",
        "pass" if matches else "gap",
        ",".join(f"{key}={value}" for key, value in expected.items()),
        actual,
        ""
        if matches
        else f"historical local-judge unit is not fully masked and inactive; {NEXT_OOM_ACTION}",
    )


def audit_enforcer_timer() -> list[Check]:
    timer = _show(
        "hapax-oom-score-enforce.timer",
        ["LoadState", "UnitFileState", "ActiveState"],
    )
    service = _show(
        "hapax-oom-score-enforce.service",
        ["LoadState", "ActiveState"],
    )
    checks: list[Check] = []
    for key, expected in (
        ("LoadState", "loaded"),
        ("UnitFileState", "static"),
        ("ActiveState", "inactive"),
    ):
        actual = timer.get(key, "N/A")
        status = "pass" if actual == expected else "gap"
        checks.append(
            Check(
                f"oom_enforcer_timer_{key}",
                status,
                expected,
                actual,
                ""
                if status == "pass"
                else f"retired root OOM timer must remain static and inactive; {NEXT_OOM_ACTION}",
            )
        )
    for key, expected in (("LoadState", "loaded"), ("ActiveState", "inactive")):
        actual = service.get(key, "N/A")
        status = "pass" if actual == expected else "gap"
        checks.append(
            Check(
                f"oom_enforcer_service_{key}",
                status,
                expected,
                actual,
                ""
                if status == "pass"
                else f"retired root OOM service must remain loaded but inactive; {NEXT_OOM_ACTION}",
            )
        )
    return checks


def format_human(checks: list[Check]) -> str:
    lines = []
    for check in checks:
        suffix = f" ({check.detail})" if check.detail else ""
        lines.append(
            f"{check.status.upper():5} {check.name}: actual={check.actual} target={check.target}{suffix}"
        )
    return "\n".join(lines)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    parser.add_argument("--uid", type=int, default=os.getuid(), help="user manager UID to audit")
    args = parser.parse_args(argv)

    try:
        _validate_test_mode_admission()
        policy = derive_host_policy()
        checks = [
            Check(
                "audit_authority",
                "pass",
                "non-authoritative observational drift report",
                "non-authoritative observational drift report",
            ),
            Check(
                "host_memory_policy",
                "pass",
                "canonical hostname and admitted MemTotal interval",
                f"{policy.hostname}:{policy.profile}:{policy.physical_bytes}",
            ),
            *audit_zram(policy),
            audit_local_judge_unit(),
            *audit_docker_limits(),
            *audit_enforcer_timer(),
            audit_user_manager(args.uid),
            audit_user_manager_policy(args.uid),
            audit_user_manager_live_score(args.uid),
            *audit_recovery_system_units(),
            *audit_sshd_policy(),
            *audit_system_slice_reservation(),
            *audit_user_slice_reservation(),
            *audit_system_memory_unit(f"user-{args.uid}.slice", policy),
            *audit_system_memory_unit(f"user@{args.uid}.service", policy),
            *audit_app_slice(policy),
            *audit_session_slice(),
            *audit_user_child_floor_composition(args.uid),
            *audit_protected_user_units(policy, args.uid),
            audit_residual_user_process_protection(args.uid),
            *audit_tmux_scopes(),
        ]
    except HostPolicyError as exc:
        checks = [
            Check(
                "host_memory_policy",
                "error",
                "canonical hostname and admitted MemTotal interval",
                "N/A",
                f"{exc}; {NEXT_OOM_ACTION}",
            )
        ]
    if args.json:
        print(
            json.dumps(
                {
                    "authoritative": False,
                    "checks": [asdict(check) for check in checks],
                    "scope": "observational-live-drift",
                },
                indent=2,
                sort_keys=True,
            )
        )
    else:
        print("NON-AUTHORITATIVE observational-live-drift\n" + format_human(checks))
    return 1 if any(check.status in {"gap", "error"} for check in checks) else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
