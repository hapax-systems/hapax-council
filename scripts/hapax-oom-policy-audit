def _proc_oom_score(pid: str) -> int | None:
    try:
        return int((PROC_ROOT / pid / "oom_score_adj").read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return None


def _proc_cgroups(pid: str) -> list[str]:
    try:
        lines = (PROC_ROOT / pid / "cgroup").read_text(encoding="utf-8").splitlines()
    except OSError:
        return []
    paths: list[str] = []
    for line in lines:
        parts = line.split(":", 2)
        if len(parts) == 3 and parts[2].startswith("/"):
            paths.append(parts[2])
    return paths


def _pid_matches_cgroup(pid: str, cgroup: str) -> bool:
    if not cgroup.startswith("/"):
        return False
    prefix = f"{cgroup.rstrip('/')}/"
    return any(path == cgroup or path.startswith(prefix) for path in _proc_cgroups(pid))


def _cgroup_pids(cgroup: str) -> list[str]:
    if not cgroup:
        return []
    root = CGROUP_ROOT / cgroup.lstrip("/")
    if not root.is_dir():
        return []
    pids: set[str] = set()
    for procs in root.rglob("cgroup.procs"):
        try:
            for line in procs.read_text(encoding="utf-8").splitlines():
                if line.isdigit():
                    pids.add(line)
        except OSError:
            continue
    return sorted(pids, key=int)


def _pid_matches_observed_unit_process_tree(pid: str, main_pid: str, cgroup: str, uid: int) -> bool:
    if not pid.isdigit() or not main_pid.isdigit() or main_pid == "0" or not cgroup.startswith("/"):
        return False
    current = pid
    seen: set[str] = set()
    for _ in range(256):
        if current in seen or not current.isdigit() or current == "0":
            return False
        seen.add(current)
        if not _pid_matches_cgroup(current, cgroup):
            return False
        status = PROC_ROOT / current / "status"
        if _status_field(status, "Uid") != str(uid):
            return False
        if current == main_pid:
            return True
        current = _status_field(status, "PPid")
    return False


def audit_protected_user_units(policy: HostMemoryPolicy, uid: int) -> list[Check]:
    checks: list[Check] = []
    for unit, expected in PROTECTED_USER_UNITS.items():
        values = _show(
            unit,
            [
                "LoadState",
                "OOMScoreAdjust",
                "MainPID",
                "ControlGroup",
                "MemoryLow",
                "MemoryMin",
                "Slice",
                "NoNewPrivileges",
            ],
            user=True,
        )
        if values.get("LoadState") == "not-found":
            if unit in policy.optional_user_units:
                checks.append(
                    Check(
                        f"user_unit_{unit}_availability",
                        "pass",
                        "optional on appendix",
                        "not-found",
                    )
                )
            else:
                checks.append(
                    Check(
                        f"user_unit_{unit}_availability",
                        "gap",
                        "loaded",
                        "not-found",
                        f"required protected user unit is unavailable; {NEXT_OOM_ACTION}",
                    )
                )
            continue
        if "_error" in values:
            checks.append(
                Check(
                    f"user_unit_{unit}_OOMScoreAdjust",
                    "gap",
                    str(expected),
                    "N/A",
                    f"{values['_error']}; {NEXT_OOM_ACTION}",
                )
            )
            continue
        actual = values.get("OOMScoreAdjust", "")
        parsed = _int_value(actual)
        status = "pass" if parsed == 100 else "gap"
        detail = (
            ""
            if status == "pass"
            else (
                "delegated user units must remain at the user manager's score 100; "
                f"root-negative user scoring is retired; {NEXT_OOM_ACTION}"
            )
        )
        checks.append(Check(f"user_unit_{unit}_OOMScoreAdjust", status, "100", actual, detail))
        slice_target = PROTECTED_USER_UNIT_SLICES[unit]
        slice_actual = values.get("Slice", "")
        slice_status = "pass" if slice_actual == slice_target else "gap"
        slice_detail = (
            ""
            if slice_status == "pass"
            else (
                f"broadcast-critical reservation must remain below {slice_target} so its checked "
                f"ancestor protection is effective; {NEXT_OOM_ACTION}"
            )
        )
        checks.append(
            Check(
                f"user_unit_{unit}_Slice",
                slice_status,
                slice_target,
                slice_actual,
                slice_detail,
            )
        )
        if unit in AUDIO_USER_UNITS:
            sandbox_actual = values.get("NoNewPrivileges", "")
            sandbox_status = "pass" if sandbox_actual == "yes" else "gap"
            sandbox_detail = (
                ""
                if sandbox_status == "pass"
                else f"audio service must retain its distro privilege boundary; {NEXT_OOM_ACTION}"
            )
            checks.append(
                Check(
                    f"user_unit_{unit}_NoNewPrivileges",
                    sandbox_status,
                    "yes",
                    sandbox_actual,
                    sandbox_detail,
                )
            )
        for key, memory_expected in PROTECTED_USER_UNIT_MEMORY[unit].items():
            memory_actual = values.get(key, "")
            memory_status = "pass" if _int_value(memory_actual) == memory_expected else "gap"
            memory_detail = (
                ""
                if memory_status == "pass"
                else f"broadcast-critical user unit memory reservation drifted; {NEXT_OOM_ACTION}"
            )
            checks.append(
                Check(
                    f"user_unit_{unit}_{key}",
                    memory_status,
                    str(memory_expected),
                    memory_actual,
                    memory_detail,
                )
            )
        control_group = values.get("ControlGroup", "")
        live_pids = _cgroup_pids(control_group)
        main_pid = values.get("MainPID", "0")
        if main_pid.isdigit() and main_pid != "0":
            live_pids = sorted({*live_pids, main_pid}, key=int)
        for pid in live_pids:
            if not _pid_matches_cgroup(pid, control_group):
                actual_cgroups = _proc_cgroups(pid)
                checks.append(
                    Check(
                        f"user_unit_{unit}_pid_{pid}_cgroup_membership",
                        "gap",
                        f"{control_group} or descendant",
                        ",".join(actual_cgroups) if actual_cgroups else "N/A",
                        f"protected PID left or was reused outside its authoritative cgroup; {NEXT_OOM_ACTION}",
                    )
                )
                continue
            if not _pid_matches_observed_unit_process_tree(pid, main_pid, control_group, uid):
                checks.append(
                    Check(
                        f"user_unit_{unit}_pid_{pid}_process_tree_identity",
                        "gap",
                        f"uid {uid} descendant of MainPID {main_pid}",
                        f"uid={_status_field(PROC_ROOT / pid / 'status', 'Uid') or 'N/A'},"
                        f"ppid={_status_field(PROC_ROOT / pid / 'status', 'PPid') or 'N/A'}",
                        "reported user-manager cgroup/process-tree observation was inconsistent; "
                        f"user-manager data remains non-authoritative; {NEXT_OOM_ACTION}",
                    )
                )
                continue
            live = _proc_oom_score(pid)
            if not _pid_matches_cgroup(
                pid, control_group
            ) or not _pid_matches_observed_unit_process_tree(pid, main_pid, control_group, uid):
                actual_cgroups = _proc_cgroups(pid)
                checks.append(
                    Check(
                        f"user_unit_{unit}_pid_{pid}_cgroup_membership",
                        "gap",
                        f"{control_group} or descendant",
                        ",".join(actual_cgroups) if actual_cgroups else "N/A",
                        f"protected PID moved or changed process-tree identity during live-score readback; {NEXT_OOM_ACTION}",
                    )
                )
                continue
            live_actual = "N/A" if live is None else str(live)
            live_status = "pass" if live == expected else "gap"
            live_detail = (
                ""
                if live_status == "pass"
                else f"live delegated user unit must remain at score 100; {NEXT_OOM_ACTION}"
            )
            checks.append(
                Check(
                    f"user_unit_{unit}_pid_{pid}_live_oom_score_adj",
                    live_status,
                    str(expected),
                    live_actual,
                    live_detail,
                )
            )
    return checks


def audit_tmux_scopes() -> list[Check]:
    proc = _run([_systemctl(), "--user", "list-units", "--type=scope", "--all", "--no-legend"])
    if proc.returncode != 0:
        return [
            Check(
                "tmux_scope_scan",
                "error",
                "observable",
                "N/A",
                f"{(proc.stderr or proc.stdout).strip()}; {NEXT_OOM_ACTION}",
            )
        ]
    scopes = [line.split()[0] for line in proc.stdout.splitlines() if "tmux-spawn-" in line]
    checks: list[Check] = [Check("tmux_scope_count", "pass", ">=0", str(len(scopes)))]
    for scope in scopes:
        values = _show(scope, ["MemoryHigh", "MemoryMax", "MemorySwapMax", "Slice"], user=True)
        if "_error" in values:
            checks.append(
                Check(
                    f"tmux_scope_{scope}",
                    "error",
                    "bounded-or-app-slice-backed",
                    "N/A",
                    f"{values['_error']}; {NEXT_OOM_ACTION}",
                )
            )
            continue
        unbounded = [
            key
            for key in ("MemoryHigh", "MemoryMax", "MemorySwapMax")
            if values.get(key) == "infinity"
        ]
        slice_name = values.get("Slice", "")
        outside_app_slice = slice_name != "app.slice"
        status = "gap" if unbounded and outside_app_slice else "pass"
        detail_parts = []
        if unbounded:
            detail_parts.append(f"unbounded properties: {', '.join(unbounded)}")
        if outside_app_slice:
            detail_parts.append(f"Slice={slice_name}")
        detail = ""
        if status == "gap" and detail_parts:
            detail = f"tmux scope not bounded-or-app-slice-backed: {'; '.join(detail_parts)}; {NEXT_OOM_ACTION}"
        actual = ",".join(
            f"{key}={values.get(key, '')}"
            for key in ("MemoryHigh", "MemoryMax", "MemorySwapMax", "Slice")
        )
        checks.append(
            Check(f"tmux_scope_{scope}", status, "bounded-or-app-slice-backed", actual, detail)
        )
    return checks


def _status_field(status: Path, key: str) -> str:
    try:
        for line in status.read_text(encoding="utf-8", errors="replace").splitlines():
            parts = line.split()
            if parts and parts[0] == f"{key}:" and len(parts) > 1:
                return parts[1]
    except OSError:
        return ""
    return ""


def audit_residual_user_process_protection(uid: int) -> Check:
    proc_root = PROC_ROOT
    if not proc_root.is_dir():
        return Check(
            "user_process_residual_oom_protection",
            "error",
            "observable",
            "N/A",
            f"proc root unavailable; {NEXT_OOM_ACTION}",
        )
    offenders: list[str] = []
    for adj in proc_root.glob("[0-9]*/oom_score_adj"):
        pid_dir = adj.parent
        status = pid_dir / "status"
        if _status_field(status, "Uid") != str(uid):
            continue
        try:
            score = int(adj.read_text(encoding="utf-8").strip())
        except (OSError, ValueError):
            continue
        if score >= 0:
            continue
        name = _status_field(status, "Name")
        offenders.append(f"{pid_dir.name}:{name}={score}")
    if offenders:
        shown = ",".join(offenders[:8])
        extra = "" if len(offenders) <= 8 else f",+{len(offenders) - 8} more"
        return Check(
            "user_process_residual_oom_protection",
            "gap",
            "no observed uid processes with negative oom_score_adj",
            shown + extra,
            f"root-granted or inherited negative OOM score remains after bridge retirement; {NEXT_OOM_ACTION}",
        )
    return Check(
        "user_process_residual_oom_protection",
        "pass",
        "no observed uid processes with negative oom_score_adj",
        "none",
        "point-in-time observational scan only; it does not prove absence across fork or cgroup races",
    )


def audit_zram(policy: HostMemoryPolicy) -> list[Check]:
    checks: list[Check] = []
    size_path = SYS_ROOT / "block/zram0/disksize"
    try:
        actual_size = int(size_path.read_text(encoding="utf-8").strip())
    except (OSError, ValueError) as exc:
        checks.append(
            Check(
                "zram_size",
                "error",
                str(policy.zram_size),
                "N/A",
                f"cannot read {size_path}: {exc}; {NEXT_OOM_ACTION}",
            )
        )
    else:
        checks.append(
            Check(
                "zram_size",
                "pass" if actual_size == policy.zram_size else "gap",
                str(policy.zram_size),
                str(actual_size),
                ""
                if actual_size == policy.zram_size
                else f"host zram size drifted; {NEXT_OOM_ACTION}",
            )
        )

    compression_path = SYS_ROOT / "block/zram0/comp_algorithm"
    try:
        compression = compression_path.read_text(encoding="utf-8").strip()
    except OSError as exc:
        checks.append(
            Check(
                "zram_compression",
                "error",
                "zstd selected",
                "N/A",
                f"cannot read {compression_path}: {exc}; {NEXT_OOM_ACTION}",
            )
        )
    else:
        selected = next(
            (
                token[1:-1]
                for token in compression.split()
                if token.startswith("[") and token.endswith("]")
            ),
            "",
        )
        checks.append(
            Check(
                "zram_compression",
                "pass" if selected == "zstd" else "gap",
                "zstd",
                selected or compression,
                "" if selected == "zstd" else f"zram compression drifted; {NEXT_OOM_ACTION}",
            )
        )

    swaps_path = PROC_ROOT / "swaps"
    try:
        swap_lines = swaps_path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        checks.append(
            Check(
                "zram_swap_active",
                "error",
                "/dev/zram0 active",
                "N/A",
                f"cannot read {swaps_path}: {exc}; {NEXT_OOM_ACTION}",
            )
        )
    else:
        active = any(line.split()[:1] == ["/dev/zram0"] for line in swap_lines[1:])
        checks.append(
            Check(
                "zram_swap_active",
                "pass" if active else "gap",
                "/dev/zram0 active",
                "active" if active else "absent",
                "" if active else f"zram swap activation drifted; {NEXT_OOM_ACTION}",
            )
        )
    return checks


def _docker_mcp_lease_is_live(
    lease_pid: str,
    lease_start: str,
    lease_boot: str,
    uid: int,
) -> tuple[bool, str]:
    if re.fullmatch(r"[1-9][0-9]*", lease_pid) is None:
        return False, "lease PID is malformed"
    if re.fullmatch(r"[1-9][0-9]*", lease_start) is None:
        return False, "lease start time is malformed"
    if (
        re.fullmatch(
            r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",
            lease_boot,
        )
        is None
    ):
        return False, "lease boot ID is malformed"
    try:
        live_boot = (PROC_ROOT / "sys/kernel/random/boot_id").read_text(encoding="utf-8").strip()
        status_lines = (PROC_ROOT / lease_pid / "status").read_text(encoding="utf-8").splitlines()
        stat_line = (PROC_ROOT / lease_pid / "stat").read_text(encoding="utf-8").strip()
    except OSError:
        return False, "lease process or boot identity is no longer observable"
    uid_line = next((line for line in status_lines if line.startswith("Uid:\t")), "")
    uid_fields = uid_line.split()
    try:
        stat_tail = stat_line.rsplit(") ", 1)[1].split()
        process_state = stat_tail[0]
        live_start = stat_tail[19]
    except (IndexError, ValueError):
        return False, "lease process identity is malformed"
    if len(uid_fields) != 5 or not all(value.isdecimal() for value in uid_fields[1:]):
        return False, "lease process UID identity is malformed"
    if live_boot != lease_boot:
        return False, "lease boot identity is stale"
    if process_state == "Z":
        return False, "lease process is a zombie"
    if uid_fields[1] != str(uid):
        return False, "lease process UID does not match the audited operator"
    if live_start != lease_start:
        return False, "lease PID was reused or its start identity drifted"
    return True, ""


def _same_json_value(actual: object, expected: object) -> bool:
    if type(actual) is not type(expected):
        return False
    if isinstance(expected, dict):
        assert isinstance(actual, dict)
        return actual.keys() == expected.keys() and all(
            _same_json_value(actual[key], value) for key, value in expected.items()
        )
    if isinstance(expected, list):
        assert isinstance(actual, list)
        return len(actual) == len(expected) and all(
            _same_json_value(left, right) for left, right in zip(actual, expected, strict=True)
        )
    return actual == expected


def _empty_json_value(value: object) -> bool:
    return (
        value is None or value is False or value == 0 or value == "" or value == [] or value == {}
    )


def _expected_github_mcp_labels(
    uid: int,
    launch_id: str,
    lease_pid: str,
    lease_start: str,
    lease_boot: str,
) -> dict[str, str]:
    return {
        **GITHUB_MCP_IMAGE_LABELS,
        GITHUB_MCP_APP_LABEL: GITHUB_MCP_APP_ID,
        GITHUB_MCP_UID_LABEL: str(uid),
        GITHUB_MCP_LAUNCH_LABEL: launch_id,
        GITHUB_MCP_LEASE_PID_LABEL: lease_pid,
        GITHUB_MCP_LEASE_START_LABEL: lease_start,
        GITHUB_MCP_LEASE_BOOT_LABEL: lease_boot,
    }


def _docker_mcp_host_config_matches(host: object, uid: int, launch_id: str) -> bool:
    if not isinstance(host, dict) or re.fullmatch(rf"{uid}-[A-Za-z0-9]{{10}}", launch_id) is None:
        return False
    try:
        account_home = pwd.getpwuid(uid).pw_dir
    except KeyError:
        return False
    suffix = launch_id.removeprefix(f"{uid}-")
    expected = {
        "AutoRemove": True,
        "BlkioWeight": 0,
        "CapDrop": ["ALL"],
        "Cgroup": "",
        "CgroupParent": "",
        "CgroupnsMode": "private",
        "ConsoleSize": [0, 0],
        "ContainerIDFile": str(
            Path(account_home) / ".cache/hapax/mcp-logs" / f"github-mcp.{suffix}" / "container.cid"
        ),
        "CpuCount": 0,
        "CpuPercent": 0,
        "CpuPeriod": 0,
        "CpuQuota": 0,
        "CpuRealtimePeriod": 0,
        "CpuRealtimeRuntime": 0,
        "CpuShares": 0,
        "CpusetCpus": "",
        "CpusetMems": "",
        "IOMaximumBandwidth": 0,
        "IOMaximumIOps": 0,
        "IpcMode": "private",
        "Isolation": "",
        "LogConfig": {"Config": {}, "Type": "none"},
        "MaskedPaths": [
            "/proc/acpi",
            "/proc/asound",
            "/proc/interrupts",
            "/proc/kcore",
            "/proc/keys",
            "/proc/latency_stats",
            "/proc/sched_debug",
            "/proc/scsi",
            "/proc/timer_list",
            "/proc/timer_stats",
            "/sys/devices/virtual/powercap",
            "/sys/firmware",
        ],
        "Memory": BYTES_512M,
        "MemoryReservation": 0,
        "MemorySwap": BYTES_768M,
        "NanoCpus": 0,
        "NetworkMode": "bridge",
        "OomScoreAdj": 0,
        "PidMode": "",
        "PidsLimit": 128,
        "PortBindings": {},
        "Privileged": False,
        "PublishAllPorts": False,
        "ReadonlyPaths": [
            "/proc/bus",
            "/proc/fs",
            "/proc/irq",
            "/proc/sys",
            "/proc/sysrq-trigger",
        ],
        "ReadonlyRootfs": True,
        "RestartPolicy": {"MaximumRetryCount": 0, "Name": "no"},
        "Runtime": "runc",
        "ShmSize": 64 * 1024**2,
        "UTSMode": "private",
        "UsernsMode": "",
        "VolumeDriver": "",
    }
    if any(
        key not in host or not _same_json_value(host[key], value) for key, value in expected.items()
    ):
        return False
    nullable_empty_lists = {
        "Binds",
        "BlkioDeviceReadBps",
        "BlkioDeviceReadIOps",
        "BlkioDeviceWriteBps",
        "BlkioDeviceWriteIOps",
        "BlkioWeightDevice",
        "CapAdd",
        "DeviceCgroupRules",
        "DeviceRequests",
        "Devices",
        "Dns",
        "DnsOptions",
        "DnsSearch",
        "ExtraHosts",
        "GroupAdd",
        "Links",
        "Ulimits",
        "VolumesFrom",
    }
    if any(key not in host or host[key] not in (None, []) for key in nullable_empty_lists):
        return False
    if host.get("MemorySwappiness") is not None or host.get("OomKillDisable") not in (None, False):
        return False
    if host.get("SecurityOpt") not in (["no-new-privileges"], ["no-new-privileges:true"]):
        return False
    tmpfs = host.get("Tmpfs")
    if not isinstance(tmpfs, dict) or set(tmpfs) != {"/tmp"}:
        return False
    tmpfs_options = tmpfs["/tmp"]
    if (
        not isinstance(tmpfs_options, str)
        or len(tmpfs_options.split(",")) != 4
        or set(tmpfs_options.split(",")) != {"rw", "noexec", "nosuid", "size=16m"}
    ):
        return False
    known = (
        set(expected)
        | nullable_empty_lists
        | {
            "MemorySwappiness",
            "OomKillDisable",
            "SecurityOpt",
            "Tmpfs",
        }
    )
    return all(_empty_json_value(value) for key, value in host.items() if key not in known)


def _docker_mcp_config_matches(
    config: object,
    container_id: str,
    labels: dict[str, str],
    process_args: list[str],
    healthcheck: object,
    shell: object,
    on_build: object,
    args_escaped: object,
    mac_address: object,
) -> bool:
    if not isinstance(config, dict) or re.fullmatch(r"[0-9a-f]{64}", container_id) is None:
        return False
    config_probes = {
        "ArgsEscaped": args_escaped,
        "Healthcheck": healthcheck,
        "MacAddress": mac_address,
        "OnBuild": on_build,
        "Shell": shell,
    }
    expected_probes = {
        "ArgsEscaped": False,
        "Healthcheck": None,
        "MacAddress": "",
        "OnBuild": None,
        "Shell": None,
    }
    if config_probes != expected_probes:
        return False
    complete = dict(config)
    for key, value in config_probes.items():
        if key in complete and not _same_json_value(complete[key], value):
            return False
        complete[key] = value

    token_prefix = "GITHUB_PERSONAL_ACCESS_TOKEN="
    expected_env_prefix = [
        "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt",
    ]
    env = complete.get("Env")
    if (
        not isinstance(env, list)
        or len(env) != 3
        or not all(isinstance(value, str) for value in env)
        or env[:2] != expected_env_prefix
        or not env[2].startswith(token_prefix)
        or len(env[2]) == len(token_prefix)
    ):
        return False
    normalized = dict(complete)
    normalized["Env"] = [*expected_env_prefix, f"{token_prefix}<redacted>"]
    expected = {
        "ArgsEscaped": False,
        "AttachStderr": True,
        "AttachStdin": True,
        "AttachStdout": True,
        "Cmd": process_args,
        "Domainname": "",
        "Entrypoint": [GITHUB_MCP_PATH],
        "Env": [*expected_env_prefix, f"{token_prefix}<redacted>"],
        "ExposedPorts": {"8082/tcp": {}},
        "Healthcheck": None,
        "Hostname": container_id[:12],
        "Image": GITHUB_MCP_IMAGE,
        "Labels": labels,
        "MacAddress": "",
        "NetworkDisabled": False,
        "OnBuild": None,
        "OpenStdin": True,
        "Shell": None,
        "StdinOnce": True,
        "StopSignal": "SIGTERM",
        "StopTimeout": 1,
        "Tty": False,
        "User": "0",
        "Volumes": None,
        "WorkingDir": "/server",
    }
    for key, value in expected.items():
        if key not in normalized or not _same_json_value(normalized[key], value):
            return False
    return all(_empty_json_value(value) for key, value in normalized.items() if key not in expected)


def _docker_mcp_networks_match(networks: object) -> bool:
    if not isinstance(networks, dict) or set(networks) != {"bridge"}:
        return False
    endpoint = networks["bridge"]
    if not isinstance(endpoint, dict):
        return False
    expected = {
        "Aliases": None,
        "DNSNames": None,
        "DriverOpts": None,
        "GlobalIPv6Address": "",
        "GlobalIPv6PrefixLen": 0,
        "GwPriority": 0,
        "IPAMConfig": None,
        "IPv6Gateway": "",
        "Links": None,
    }
    known = set(expected) | {
        "EndpointID",
        "Gateway",
        "IPAddress",
        "IPPrefixLen",
        "MacAddress",
        "NetworkID",
    }
    if set(endpoint) != known:
        return False
    if any(
        key not in endpoint or not _same_json_value(endpoint[key], value)
        for key, value in expected.items()
    ):
        return False
    network_id = endpoint.get("NetworkID")
    endpoint_id = endpoint.get("EndpointID")
    if (
        not isinstance(network_id, str)
        or not isinstance(endpoint_id, str)
        or re.fullmatch(r"[0-9a-f]{64}", network_id) is None
        or re.fullmatch(r"[0-9a-f]{64}", endpoint_id) is None
        or network_id == "0" * 64
        or endpoint_id == "0" * 64
        or network_id == endpoint_id
    ):
        return False
    prefix = endpoint.get("IPPrefixLen")
    ip_address = endpoint.get("IPAddress")
    gateway_address = endpoint.get("Gateway")
    if (
        type(prefix) is not int
        or not 1 <= prefix <= 30
        or not isinstance(ip_address, str)
        or not isinstance(gateway_address, str)
    ):
        return False
    try:
        address = ipaddress.IPv4Address(ip_address)
        gateway = ipaddress.IPv4Address(gateway_address)
        network = ipaddress.IPv4Network((address, prefix), strict=False)
    except (ipaddress.AddressValueError, ipaddress.NetmaskValueError):
        return False
    if (
        address == gateway
        or address not in network
        or gateway not in network
        or address in {network.network_address, network.broadcast_address}
        or gateway in {network.network_address, network.broadcast_address}
        or any(
            value.is_unspecified
            or value.is_loopback
            or value.is_link_local
            or value.is_multicast
            or value.is_reserved
            for value in (address, gateway)
        )
    ):
        return False
    mac_address = endpoint.get("MacAddress")
    if (
        not isinstance(mac_address, str)
        or re.fullmatch(r"[0-9a-f]{2}(?::[0-9a-f]{2}){5}", mac_address) is None
    ):
        return False
    mac_octets = bytes.fromhex(mac_address.replace(":", ""))
    return mac_octets[:2] == b"\x02\x42" and mac_octets[2:] == address.packed


def _read_docker_inventory(
    *, closing: bool
) -> tuple[dict[str, str] | None, set[str] | None, Check | None]:
    check_name = "docker_oom_inventory_stable" if closing else "docker_oom_targets"
    scope = "closing Docker" if closing else "Docker"
    enumeration = _run_local_docker(
        [
            "ps",
            "-a",
            "--no-trunc",
            "--format",
            '{{.ID}}\t{{.Names}}\t{{.Label "org.hapax.github-mcp.app"}}',
        ]
    )
    if enumeration.returncode != 0:
        return (
            None,
            None,
            Check(
                check_name,
                "error",
                "closing local Docker inventory observable"
                if closing
                else "local Docker inventory observable",
                "N/A",
                f"{scope} enumeration failed: {_docker_failure_summary(enumeration)}; "
                f"{NEXT_OOM_ACTION}",
            ),
        )

    inventory_lines = enumeration.stdout.splitlines()
    if len(inventory_lines) > DOCKER_INVENTORY_MAX_ROWS:
        return (
            None,
            None,
            Check(
                check_name,
                "error",
                f"at most {DOCKER_INVENTORY_MAX_ROWS} inventory rows",
                str(len(inventory_lines)),
                f"{scope} inventory row bound exceeded; {NEXT_OOM_ACTION}",
            ),
        )

    inventory: dict[str, str] = {}
    labeled_ids: set[str] = set()
    seen_names: set[str] = set()
    for raw_line in inventory_lines:
        if not raw_line:
            continue
        if len(raw_line) > DOCKER_INVENTORY_LINE_MAX:
            return (
                None,
                None,
                Check(
                    check_name,
                    "error",
                    f"inventory lines at most {DOCKER_INVENTORY_LINE_MAX} characters",
                    f"length={len(raw_line)}",
                    f"{scope} inventory line bound exceeded; {NEXT_OOM_ACTION}",
                ),
            )
        fields = raw_line.split("\t")
        if (
            len(fields) != 3
            or re.fullmatch(r"[0-9a-f]{64}", fields[0]) is None
            or re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]+", fields[1]) is None
        ):
            return (
                None,
                None,
                Check(
                    check_name,
                    "error",
                    "full immutable IDs and exact names",
                    "malformed",
                    f"malformed {scope} inventory; {NEXT_OOM_ACTION}",
                ),
            )
        container_id, name, app_label = fields
        if container_id in inventory:
            return (
                None,
                None,
                Check(
                    check_name,
                    "error",
                    "unique immutable IDs",
                    "duplicate",
                    f"duplicate {scope} ID in inventory; {NEXT_OOM_ACTION}",
                ),
            )
        if name in seen_names:
            return (
                None,
                None,
                Check(
                    check_name,
                    "error",
                    "unique exact names",
                    "duplicate",
                    f"duplicate {scope} name in inventory; {NEXT_OOM_ACTION}",
                ),
            )
        seen_names.add(name)
        inventory[container_id] = name
        if app_label:
            labeled_ids.add(container_id)
    return inventory, labeled_ids, None


def _docker_target_generation(
    inventory: dict[str, str], labeled_ids: set[str]
) -> frozenset[tuple[str, str, bool]]:
    return frozenset(
        (container_id, name, container_id in labeled_ids)
        for container_id, name in inventory.items()
        if name == "hapax-local-judge"
        or container_id in labeled_ids
        or name.startswith("hapax-github-mcp-")
    )


def audit_docker_limits(uid: int) -> list[Check]:
    inventory, labeled_ids, inventory_error = _read_docker_inventory(closing=False)
    if inventory_error is not None:
        return [inventory_error]
    assert inventory is not None
    assert labeled_ids is not None
    target_generation = _docker_target_generation(inventory, labeled_ids)

    judge = next(
        (
            (container_id, name)
            for container_id, name in inventory.items()
            if name == "hapax-local-judge"
        ),
        None,
    )
    mcp_targets = [
        (container_id, name)
        for container_id, name in inventory.items()
        if container_id in labeled_ids or name.startswith("hapax-github-mcp-")
    ]

    if len(mcp_targets) > DOCKER_TARGET_MAX:
        return [
            Check(
                "docker_oom_targets",
                "error",
                f"at most {DOCKER_TARGET_MAX} OOM targets",
                str(len(mcp_targets)),
                f"Docker target count bound exceeded; {NEXT_OOM_ACTION}",
            )
        ]

    checks: list[Check] = []
    checks.append(
        Check(
            "docker_hapax-local-judge_retired",
            "pass" if judge is None else "gap",
            "absent",
            "absent" if judge is None else judge[0],
            "" if judge is None else f"historical local judge remains live; {NEXT_OOM_ACTION}",
        )
    )

    checks.append(Check("docker_github_mcp_count", "pass", ">=0", str(len(mcp_targets))))
    resolved_image_id: str | None = None
    if mcp_targets:
        image_inspect = _run_local_docker(
            [
                "image",
                "inspect",
                "--format",
                '{{.Id}}{{range .RepoDigests}}{{printf "\\n%s" .}}{{end}}',
                GITHUB_MCP_IMAGE,
            ]
        )
        image_status = "error"
        image_actual = "N/A"
        image_detail = ""
        if image_inspect.returncode != 0:
            image_detail = (
                "cannot resolve the pinned local image: "
                f"{_docker_failure_summary(image_inspect)}; {NEXT_OOM_ACTION}"
            )
        else:
            image_lines = image_inspect.stdout.splitlines()
            if (
                len(image_lines) < 2
                or len(image_lines) > DOCKER_TARGET_MAX
                or any(len(line) > DOCKER_INVENTORY_LINE_MAX for line in image_lines)
                or re.fullmatch(r"sha256:[0-9a-f]{64}", image_lines[0]) is None
            ):
                image_detail = f"malformed bounded Docker image identity; {NEXT_OOM_ACTION}"
                image_actual = "malformed"
            else:
                local_image_id = image_lines[0]
                repo_digests = image_lines[1:]
                reviewed_digest_present = GITHUB_MCP_IMAGE in repo_digests
                image_actual = (
                    "ConfigIDFormat=true,"
                    f"ReviewedRepoDigestPresent={str(reviewed_digest_present).lower()}"
                )
                if reviewed_digest_present:
                    resolved_image_id = local_image_id
                    image_status = "pass"
                else:
                    image_status = "gap"
                    image_detail = (
                        "local image RepoDigests do not contain the exact reviewed reference; "
                        f"{NEXT_OOM_ACTION}"
                    )
        checks.append(
            Check(
                "docker_github_mcp_image",
                image_status,
                f"RepoDigest={GITHUB_MCP_IMAGE},ConfigID=sha256:<64 lowercase hex>",
                image_actual,
                image_detail,
            )
        )
    for target_index, (container_id, name) in enumerate(mcp_targets, start=1):
        check_name = f"docker_github_mcp_target_{target_index}_limits"
        inspected = _run_local_docker(
            [
                "inspect",
                "--format",
                (
                    "{{json .Id}}\t{{json .Name}}\t{{json .Config.Labels}}\t"
                    "{{json .HostConfig.Memory}}\t{{json .HostConfig.MemorySwap}}\t"
                    "{{json .HostConfig.OomKillDisable}}\t{{json .Image}}\t"
                    "{{json .Config.Image}}\t{{json .Path}}\t{{json .Args}}\t"
                    "{{json .HostConfig.ReadonlyRootfs}}\t{{json .HostConfig.CapDrop}}\t"
                    "{{json .HostConfig.SecurityOpt}}\t{{json .HostConfig.AutoRemove}}\t"
                    "{{json .HostConfig.LogConfig.Type}}\t{{json .HostConfig.Tmpfs}}\t"
                    "{{json .HostConfig.Binds}}\t{{json .Mounts}}\t"
                    "{{json .HostConfig.Privileged}}\t{{json .HostConfig.CapAdd}}\t"
                    "{{json .HostConfig.NetworkMode}}\t{{json .HostConfig.PidMode}}\t"
                    "{{json .HostConfig.IpcMode}}\t{{json .HostConfig.Devices}}\t"
                    "{{json .HostConfig.DeviceRequests}}\t{{json .HostConfig.PortBindings}}\t"
                    "{{json .State.Status}}\t{{json .Config.StopTimeout}}\t"
                    "{{len .Config.Labels}}\t{{json .Config.AttachStdin}}\t"
                    "{{json .Config.AttachStdout}}\t{{json .Config.AttachStderr}}\t"
                    "{{json .Config.OpenStdin}}\t{{json .Config.StdinOnce}}\t"
                    "{{json .Config.Tty}}\t{{json .Config.User}}\t{{len .Config.Env}}\t"
                    '"{{range .Config.Env}}{{if eq . '
                    '"PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"'
                    '}}P{{end}}{{end}}"\t'
                    '"{{range .Config.Env}}{{if eq . '
                    '"SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt"'
                    '}}S{{end}}{{end}}"\t'
                    '"{{range .Config.Env}}{{if and (eq (printf "%.29s" .) '
                    '"GITHUB_PERSONAL_ACCESS_TOKEN=") (gt (len .) 29)}}T{{end}}{{end}}"\t'
                    "{{json .Config.WorkingDir}}\t{{json .Config.StopSignal}}\t"
                    "{{json .Config.NetworkDisabled}}\t{{json .Config.ExposedPorts}}\t"
                    "{{json .HostConfig.MemoryReservation}}\t"
                    "{{json .HostConfig.OomScoreAdj}}\t{{json .HostConfig.LogConfig.Config}}\t"
                    "{{json .HostConfig.UTSMode}}\t{{json .HostConfig.CgroupnsMode}}\t"
                    "{{json .HostConfig.UsernsMode}}\t{{json .HostConfig.Runtime}}\t"
                    "{{json .HostConfig.PidsLimit}}\t"
                    "{{json .HostConfig.RestartPolicy.Name}}\t"
                    "{{json .HostConfig.RestartPolicy.MaximumRetryCount}}\t"
                    "{{json .HostConfig.NanoCpus}}\t{{json .HostConfig.CpuShares}}\t"
                    "{{json .HostConfig.PublishAllPorts}}\t{{json .HostConfig.ShmSize}}\t"
                    "{{json .HostConfig.Dns}}\t{{json .HostConfig.DnsOptions}}\t"
                    "{{json .HostConfig.DnsSearch}}\t{{json .HostConfig.ExtraHosts}}\t"
                    "{{json .HostConfig.Links}}\t{{json .HostConfig.GroupAdd}}\t"
                    "{{json .HostConfig.VolumesFrom}}\t{{len .NetworkSettings.Networks}}\t"
                    '"{{range $name, $_ := .NetworkSettings.Networks}}'
                    '{{if eq $name "bridge"}}B{{end}}{{end}}"\t'
                    "{{json .Config.Hostname}}\t{{json .Config.Domainname}}\t"
                    "{{json .Config.Entrypoint}}\t{{json .Config.Cmd}}\t"
                    "{{json .Config.Volumes}}\t{{json .NetworkSettings.Ports}}\t"
                    "{{json .Config.Healthcheck}}\t{{json .Config.Shell}}\t"
                    "{{json .Config.OnBuild}}\t{{json .Config.ArgsEscaped}}\t"
                    "{{json .Config.MacAddress}}\t{{json .HostConfig}}\t{{json .Config}}\t"
                    "{{json .NetworkSettings.Networks}}"
                ),
                container_id,
            ]
        )
        if inspected.returncode != 0:
            checks.append(
                Check(
                    check_name,
                    "error",
                    f"Memory={BYTES_512M},MemorySwap={BYTES_768M},OomKillDisable=false",
                    "N/A",
                    "Docker inspect failed for selected immutable target: "
                    f"{_docker_failure_summary(inspected)}; {NEXT_OOM_ACTION}",
                )
            )
            continue
        try:
            inspect_lines = inspected.stdout.splitlines()
            if len(inspect_lines) != 1 or len(inspect_lines[0]) > DOCKER_INSPECT_LINE_MAX:
                raise ValueError("expected one bounded Docker inspect line")
            fields = inspect_lines[0].split("\t")
            if len(fields) != 81:
                raise ValueError("expected eighty-one formatted Docker inspect fields")
            (
                actual_id,
                actual_name,
                labels,
                memory,
                memory_swap,
                oom_kill_disable,
                image_id,
                config_image,
                process_path,
                process_args,
                readonly_rootfs,
                cap_drop,
                security_opt,
                auto_remove,
                log_driver,
                tmpfs,
                binds,
                mounts,
                privileged,
                cap_add,
                network_mode,
                pid_mode,
                ipc_mode,
                devices,
                device_requests,
                port_bindings,
                container_state,
                stop_timeout,
                label_count,
                attach_stdin,
                attach_stdout,
                attach_stderr,
                open_stdin,
                stdin_once,
                tty,
                container_user,
                env_count,
                env_path_marker,
                env_ssl_marker,
                env_token_marker,
                working_dir,
                stop_signal,
                network_disabled,
                exposed_ports,
                memory_reservation,
                oom_score_adj,
                log_config,
                uts_mode,
                cgroupns_mode,
                userns_mode,
                runtime,
                pids_limit,
                restart_name,
                restart_max,
                nano_cpus,
                cpu_shares,
                publish_all_ports,
                shm_size,
                dns,
                dns_options,
                dns_search,
                extra_hosts,
                links,
                group_add,
                volumes_from,
                network_count,
                bridge_network_marker,
                hostname,
                domainname,
                entrypoint,
                config_cmd,
                volumes,
                network_ports,
                healthcheck,
                shell,
                on_build,
                args_escaped,
                config_mac_address,
                host_config,
                config,
                networks,
            ) = (json.loads(field) for field in fields)
            if not all(
                isinstance(value, str)
                for value in (actual_id, actual_name, image_id, config_image, process_path)
            ):
                raise TypeError("Docker identity fields must be strings")
            if type(memory) is not int or type(memory_swap) is not int:
                raise TypeError("Docker memory fields must be integers")
            if not isinstance(labels, dict) or not all(
                isinstance(key, str) and isinstance(value, str) for key, value in labels.items()
            ):
                raise TypeError("Docker labels must be a string map")
            if oom_kill_disable is not None and type(oom_kill_disable) is not bool:
                raise TypeError("Docker OomKillDisable must be null or boolean")
            if not isinstance(process_args, list) or not all(
                isinstance(value, str) for value in process_args
            ):
                raise TypeError("Docker process arguments must be a string list")
            if not isinstance(config_cmd, list) or not all(
                isinstance(value, str) for value in config_cmd
            ):
                raise TypeError("Docker Config.Cmd must be a string list")
            if not isinstance(entrypoint, list) or not all(
                isinstance(value, str) for value in entrypoint
            ):
                raise TypeError("Docker entrypoint must be a string list")
            if type(readonly_rootfs) is not bool or type(auto_remove) is not bool:
                raise TypeError("Docker security booleans must be boolean")
            if not isinstance(cap_drop, list) or not all(
                isinstance(value, str) for value in cap_drop
            ):
                raise TypeError("Docker CapDrop must be a string list")
            if not isinstance(security_opt, list) or not all(
                isinstance(value, str) for value in security_opt
            ):
                raise TypeError("Docker SecurityOpt must be a string list")
            if not isinstance(tmpfs, dict) or not all(
                isinstance(key, str) and isinstance(value, str) for key, value in tmpfs.items()
            ):
                raise TypeError("Docker Tmpfs must be a string map")
            if binds is not None and not isinstance(binds, list):
                raise TypeError("Docker Binds must be null or a list")
            if not isinstance(mounts, list) or not isinstance(devices, list):
                raise TypeError("Docker mounts and devices must be lists")
            if type(privileged) is not bool:
                raise TypeError("Docker Privileged must be boolean")
            if cap_add is not None and not isinstance(cap_add, list):
                raise TypeError("Docker CapAdd must be null or a list")
            if device_requests is not None and not isinstance(device_requests, list):
                raise TypeError("Docker DeviceRequests must be null or a list")
            if not isinstance(port_bindings, dict):
                raise TypeError("Docker PortBindings must be a map")
            if not all(
                isinstance(value, str)
                for value in (log_driver, network_mode, pid_mode, ipc_mode, container_state)
            ):
                raise TypeError("Docker runtime state fields must be strings")
            if type(stop_timeout) is not int:
                raise TypeError("Docker StopTimeout must be an integer")
            if healthcheck is not None and not isinstance(healthcheck, dict):
                raise TypeError("Docker Healthcheck must be null or a map")
            if shell is not None and not isinstance(shell, list):
                raise TypeError("Docker Shell must be null or a list")
            if on_build is not None and not isinstance(on_build, list):
                raise TypeError("Docker OnBuild must be null or a list")
            if type(args_escaped) is not bool or not isinstance(config_mac_address, str):
                raise TypeError("Docker ArgsEscaped and MacAddress have invalid types")
            if not all(
                type(value) is bool
                for value in (
                    attach_stdin,
                    attach_stdout,
                    attach_stderr,
                    open_stdin,
                    stdin_once,
                    tty,
                    network_disabled,
                    publish_all_ports,
                )
            ):
                raise TypeError("Docker stdio and network flags must be boolean")
            if not all(
                type(value) is int
                for value in (
                    label_count,
                    env_count,
                    memory_reservation,
                    oom_score_adj,
                    pids_limit,
                    restart_max,
                    nano_cpus,
                    cpu_shares,
                    shm_size,
                    network_count,
                )
            ):
                raise TypeError("Docker resource and cardinality fields must be integers")
            if not all(
                isinstance(value, str)
                for value in (
                    container_user,
                    env_path_marker,
                    env_ssl_marker,
                    env_token_marker,
                    working_dir,
                    stop_signal,
                    uts_mode,
                    cgroupns_mode,
                    userns_mode,
                    runtime,
                    restart_name,
                    bridge_network_marker,
                    hostname,
                    domainname,
                )
            ):
                raise TypeError("Docker immutable configuration fields must be strings")
            if exposed_ports is not None and not isinstance(exposed_ports, dict):
                raise TypeError("Docker ExposedPorts must be null or a map")
            if log_config is not None and not isinstance(log_config, dict):
                raise TypeError("Docker log configuration must be null or a map")
            if volumes is not None and not isinstance(volumes, dict):
                raise TypeError("Docker Config.Volumes must be null or a map")
            if not isinstance(network_ports, dict):
                raise TypeError("Docker network ports must be a map")
            if not isinstance(host_config, dict):
                raise TypeError("Docker HostConfig must be a map")
            if not isinstance(config, dict) or not isinstance(networks, dict):
                raise TypeError("Docker Config and network settings must be maps")
            for value in (
                dns,
                dns_options,
                dns_search,
                extra_hosts,
                links,
                group_add,
                volumes_from,
            ):
                if value is not None and not isinstance(value, list):
                    raise TypeError("Docker network lists must be null or lists")
        except (TypeError, ValueError, json.JSONDecodeError) as exc:
            checks.append(
                Check(
                    check_name,
                    "error",
                    "one complete inspect record",
                    "malformed",
                    f"cannot parse Docker inspect for selected immutable target: {exc}; "
                    f"{NEXT_OOM_ACTION}",
                )
            )
            continue
        launch_id = labels.get(GITHUB_MCP_LAUNCH_LABEL, "")
        lease_pid = labels.get(GITHUB_MCP_LEASE_PID_LABEL, "")
        lease_start = labels.get(GITHUB_MCP_LEASE_START_LABEL, "")
        lease_boot = labels.get(GITHUB_MCP_LEASE_BOOT_LABEL, "")
        expected_name = f"/hapax-github-mcp-{launch_id}"
        labels_ok = (
            labels.get(GITHUB_MCP_APP_LABEL) == GITHUB_MCP_APP_ID
            and labels.get(GITHUB_MCP_UID_LABEL) == str(uid)
            and re.fullmatch(rf"{uid}-[A-Za-z0-9]{{10}}", launch_id) is not None
            and label_count == 15
            and labels
            == _expected_github_mcp_labels(uid, launch_id, lease_pid, lease_start, lease_boot)
        )
        identity_ok = (
            actual_id == container_id
            and actual_name == f"/{name}"
            and labels_ok
            and actual_name == expected_name
        )
        command_ok = (
            resolved_image_id is not None
            and image_id == resolved_image_id
            and config_image == GITHUB_MCP_IMAGE
            and process_path == GITHUB_MCP_PATH
            and len(process_args) == 4
            and process_args[:3] == ["stdio", "--log-file", "/tmp/github-mcp.log"]
            and re.fullmatch(r"--(?:tools|toolsets)=[A-Za-z0-9_,.-]{1,1024}", process_args[3])
            is not None
            and attach_stdin is True
            and attach_stdout is True
            and attach_stderr is True
            and open_stdin is True
            and stdin_once is True
            and tty is False
            and container_user == "0"
            and env_count == 3
            and env_path_marker == "P"
            and env_ssl_marker == "S"
            and env_token_marker == "T"
            and working_dir == "/server"
            and stop_signal == "SIGTERM"
            and hostname == container_id[:12]
            and domainname == ""
            and entrypoint == [GITHUB_MCP_PATH]
            and config_cmd == process_args
            and volumes is None
            and healthcheck is None
            and shell is None
            and on_build is None
            and args_escaped is False
            and config_mac_address == ""
            and _docker_mcp_config_matches(
                config,
                container_id,
                labels,
                process_args,
                healthcheck,
                shell,
                on_build,
                args_escaped,
                config_mac_address,
            )
        )
        limits_ok = (
            memory == BYTES_512M
            and memory_swap == BYTES_768M
            and memory_reservation == 0
            and oom_kill_disable in {None, False}
            and oom_score_adj == 0
            and pids_limit == 128
            and nano_cpus == 0
            and cpu_shares == 0
        )
        security_ok = (
            readonly_rootfs is True
            and cap_drop == ["ALL"]
            and security_opt in (["no-new-privileges"], ["no-new-privileges:true"])
            and auto_remove is True
            and log_driver == "none"
            and log_config in (None, {})
            and set(tmpfs) == {"/tmp"}
            and len(tmpfs["/tmp"].split(",")) == 4
            and set(tmpfs["/tmp"].split(",")) == {"rw", "noexec", "nosuid", "size=16m"}
            and binds is None
            and mounts == []
            and privileged is False
            and cap_add is None
            and network_mode == "bridge"
            and pid_mode == ""
            and ipc_mode == "private"
            and uts_mode == "private"
            and cgroupns_mode == "private"
            and userns_mode == ""
            and devices == []
            and device_requests is None
            and port_bindings == {}
            and runtime == "runc"
            and restart_name == "no"
            and restart_max == 0
            and publish_all_ports is False
            and shm_size == 64 * 1024**2
            and network_disabled is False
            and exposed_ports == {"8082/tcp": {}}
            and dns in (None, [])
            and dns_options in (None, [])
            and dns_search in (None, [])
            and extra_hosts in (None, [])
            and links in (None, [])
            and group_add in (None, [])
            and volumes_from in (None, [])
            and network_count == 1
            and bridge_network_marker == "B"
            and network_ports == {"8082/tcp": None}
            and _docker_mcp_networks_match(networks)
            and _docker_mcp_host_config_matches(host_config, uid, launch_id)
            and container_state
            in {"created", "running", "restarting", "paused", "removing", "exited", "dead"}
            and stop_timeout == 1
        )
        lease_live, lease_detail = _docker_mcp_lease_is_live(
            lease_pid, lease_start, lease_boot, uid
        )
        converging = container_state == "removing" and lease_live
        status = (
            "pass"
            if identity_ok and limits_ok and command_ok and security_ok and lease_live
            else "gap"
        )
        safe_state = (
            container_state
            if container_state
            in {"created", "running", "restarting", "paused", "removing", "exited", "dead"}
            else "redacted"
        )
        actual = (
            f"IdMatch={actual_id == container_id},NameMatch={actual_name == expected_name},"
            f"LabelsMatch={labels_ok},"
            f"LimitsMatch={limits_ok},CommandMatch={command_ok},SecurityMatch={security_ok},"
            f"State={safe_state},LeaseLive={lease_live},Converging={converging}"
        )
        checks.append(
            Check(
                check_name,
                status,
                f"generated exact identity,Memory={BYTES_512M},"
                f"MemorySwap={BYTES_768M},OomKillDisable=false,Image={GITHUB_MCP_IMAGE},"
                "immutable labels, hardened security, live launch lease",
                actual,
                ""
                if status == "pass"
                else (
                    "Docker identity, labels, image, command, limits, security, or launch lease "
                    f"drifted{f': {lease_detail}' if not lease_live else ''}; {NEXT_OOM_ACTION}"
                ),
            )
        )

    closing_inventory, closing_labeled_ids, closing_inventory_error = _read_docker_inventory(
        closing=True
    )
    if closing_inventory_error is not None:
        checks.append(closing_inventory_error)
        return checks
    assert closing_inventory is not None
    assert closing_labeled_ids is not None

    final_inventory, final_labeled_ids, final_inventory_error = _read_docker_inventory(
        closing=True
    )
    if final_inventory_error is not None:
        checks.append(final_inventory_error)
        return checks
    assert final_inventory is not None
    assert final_labeled_ids is not None

    closing_target_count = max(
        (
            sum(
                1
                for container_id, name in bounded_inventory.items()
                if container_id in bounded_labeled_ids
                or name.startswith("hapax-github-mcp-")
            )
            for bounded_inventory, bounded_labeled_ids in (
                (closing_inventory, closing_labeled_ids),
                (final_inventory, final_labeled_ids),
            )
        )
    )
    if closing_target_count > DOCKER_TARGET_MAX:
        checks.append(
            Check(
                "docker_oom_inventory_stable",
                "error",
                f"at most {DOCKER_TARGET_MAX} OOM targets",
                str(closing_target_count),
                f"closing Docker target count bound exceeded; {NEXT_OOM_ACTION}",
            )
        )
        return checks

    inventory_stable = (
        _docker_target_generation(closing_inventory, closing_labeled_ids) == target_generation
        and _docker_target_generation(final_inventory, final_labeled_ids) == target_generation
    )
    checks.append(
        Check(
            "docker_oom_inventory_stable",
            "pass" if inventory_stable else "error",
            "one stable complete Docker target inventory generation",
            "stable" if inventory_stable else "changed",
            ""
            if inventory_stable
            else f"Docker inventory changed during bounded audit; {NEXT_OOM_ACTION}",
        )
    )
    return checks


def audit_local_judge_unit() -> Check:
    values = _show(
        "hapax-local-judge.service",
        ["LoadState", "UnitFileState", "ActiveState"],
        user=True,
    )
    expected = {
        "LoadState": "masked",
        "UnitFileState": "masked",
        "ActiveState": "inactive",
    }
    if "_error" in values:
        return Check(
            "local_judge_unit_retired",
            "error",
            ",".join(f"{key}={value}" for key, value in expected.items()),
            "N/A",
            f"cannot observe the historical local-judge unit: {values['_error']}; {NEXT_OOM_ACTION}",
        )
    actual = ",".join(f"{key}={values.get(key, 'N/A')}" for key in expected)
    matches = all(values.get(key) == value for key, value in expected.items())
    return Check(
        "local_judge_unit_retired",
        "pass" if matches else "gap",
        ",".join(f"{key}={value}" for key, value in expected.items()),
        actual,
        ""
        if matches
        else f"historical local-judge unit is not fully masked and inactive; {NEXT_OOM_ACTION}",
    )


def audit_enforcer_timer() -> list[Check]:
    timer = _show(
        "hapax-oom-score-enforce.timer",
        ["LoadState", "UnitFileState", "ActiveState"],
    )
    service = _show(
        "hapax-oom-score-enforce.service",
        ["LoadState", "ActiveState"],
    )
    checks: list[Check] = []
    for key, expected in (
        ("LoadState", "loaded"),
        ("UnitFileState", "static"),
        ("ActiveState", "inactive"),
    ):
        actual = timer.get(key, "N/A")
        status = "pass" if actual == expected else "gap"
        checks.append(
            Check(
                f"oom_enforcer_timer_{key}",
                status,
                expected,
                actual,
                ""
                if status == "pass"
                else f"retired root OOM timer must remain static and inactive; {NEXT_OOM_ACTION}",
            )
        )
    for key, expected in (("LoadState", "loaded"), ("ActiveState", "inactive")):
        actual = service.get(key, "N/A")
        status = "pass" if actual == expected else "gap"
        checks.append(
            Check(
                f"oom_enforcer_service_{key}",
                status,
                expected,
                actual,
                ""
                if status == "pass"
                else f"retired root OOM service must remain loaded but inactive; {NEXT_OOM_ACTION}",
            )
        )
    return checks


def format_human(checks: list[Check]) -> str:
    lines = []
    for check in checks:
        suffix = f" ({check.detail})" if check.detail else ""
        lines.append(
            f"{check.status.upper():5} {check.name}: actual={check.actual} target={check.target}{suffix}"
        )
    return "\n".join(lines)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    parser.add_argument("--uid", type=int, default=os.getuid(), help="user manager UID to audit")
    args = parser.parse_args(argv)

    try:
        _validate_test_mode_admission()
        policy = derive_host_policy()
        checks = [
            Check(
                "audit_authority",
                "pass",
                "non-authoritative observational drift report",
                "non-authoritative observational drift report",
            ),
            Check(
                "host_memory_policy",
                "pass",
                "canonical hostname and admitted MemTotal interval",
                f"{policy.hostname}:{policy.profile}:{policy.physical_bytes}",
            ),
            *audit_zram(policy),
            audit_local_judge_unit(),
            *audit_docker_limits(args.uid),
            *audit_enforcer_timer(),
            audit_user_manager(args.uid),
            audit_user_manager_policy(args.uid),
            audit_user_manager_live_score(args.uid),
            *audit_recovery_system_units(),
            *audit_sshd_policy(),
            *audit_system_slice_reservation(),
            *audit_user_slice_reservation(),
            *audit_system_memory_unit(f"user-{args.uid}.slice", policy),
            *audit_system_memory_unit(f"user@{args.uid}.service", policy),
            *audit_app_slice(policy),
            *audit_session_slice(),
            *audit_user_child_floor_composition(args.uid),
            *audit_protected_user_units(policy, args.uid),
            audit_residual_user_process_protection(args.uid),
            *audit_tmux_scopes(),
        ]
    except HostPolicyError as exc:
        checks = [
            Check(
                "host_memory_policy",
                "error",
                "canonical hostname and admitted MemTotal interval",
                "N/A",
                f"{exc}; {NEXT_OOM_ACTION}",
            )
        ]
    if args.json:
        print(
            json.dumps(
                {
                    "authoritative": False,
                    "checks": [asdict(check) for check in checks],
                    "scope": "observational-live-drift",
                },
                indent=2,
                sort_keys=True,
            )
        )
    else:
        print("NON-AUTHORITATIVE observational-live-drift\n" + format_human(checks))
    return 1 if any(check.status in {"gap", "error"} for check in checks) else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
