#!/usr/bin/env bash
# hapax-post-merge-smoke — gate-driven smoke verification for a merge.
#
# Invoked by hapax-post-merge-deploy after services restart. Walks a
# matrix of smoke gates that match the diff produced by $SHA, and
# ntfy's on any failure. Health-gate findings remain advisory (exit 0), while
# malformed inputs, unavailable Git objects, and probe infrastructure failures
# exit non-zero so the deploy caller cannot stamp a false completion receipt.
#
# Per cc-task `post-merge-smoke-runner` (WSJF 6.5, 2026-05-02).
#
# Usage:
#   scripts/hapax-post-merge-smoke <merge-sha>
#   scripts/hapax-post-merge-smoke --since <base-sha> <target-sha>
#
# Env:
#   NTFY_TOPIC                 (optional) ntfy topic; if unset, prints to stderr
#   HAPAX_SMOKE_NTFY_TIMEOUT_S notification deadline in seconds (1..10; default 5)
#   HAPAX_SMOKE_OFF=1          skip all gates (post-merge-deploy can hard-disable)
#   HAPAX_SMOKE_DRYRUN=1       print which gates would fire without running them
set -uo pipefail
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY
unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_SHALLOW_FILE GIT_REPLACE_REF_BASE
export GIT_NO_REPLACE_OBJECTS=1

[ "${HAPAX_SMOKE_OFF:-0}" = "1" ] && exit 0

DRYRUN="${HAPAX_SMOKE_DRYRUN:-0}"
NTFY_TIMEOUT_S="${HAPAX_SMOKE_NTFY_TIMEOUT_S:-5}"
if ! [[ "$NTFY_TIMEOUT_S" =~ ^([1-9]|10)$ ]]; then
    NTFY_TIMEOUT_S=5
fi
SHA="<missing>"
SINCE=""
EXECUTION_FAILURE=0
SYSTEMD_RUN_BIN="/usr/bin/systemd-run"

if [ -n "${HAPAX_SMOKE_SYSTEMD_RUN_BIN:-}" ]; then
    if [ -z "${HAPAX_SMOKE_ISOLATED_TEST_ROOT:-}" ]; then
        echo "hapax-post-merge-smoke: HAPAX_SMOKE_SYSTEMD_RUN_BIN is test-only" >&2
        exit 2
    fi
    if ! /usr/bin/python3 -I -S - \
        "$HAPAX_SMOKE_ISOLATED_TEST_ROOT" "$HAPAX_SMOKE_SYSTEMD_RUN_BIN" <<'PY'
import os
import stat
import sys

root = os.path.abspath(sys.argv[1])
candidate = os.path.abspath(sys.argv[2])
try:
    root_stat = os.lstat(root)
    candidate_stat = os.lstat(candidate)
    inside = os.path.commonpath((root, candidate)) == root
except (OSError, ValueError):
    raise SystemExit(2)
if (
    not inside
    or candidate == root
    or os.path.realpath(root) != root
    or os.path.realpath(candidate) != candidate
    or not stat.S_ISDIR(root_stat.st_mode)
    or root_stat.st_uid != os.geteuid()
    or root_stat.st_mode & 0o022
    or not stat.S_ISREG(candidate_stat.st_mode)
    or candidate_stat.st_uid != os.geteuid()
    or candidate_stat.st_mode & 0o022
    or not candidate_stat.st_mode & 0o100
):
    raise SystemExit(2)
PY
    then
        echo "hapax-post-merge-smoke: invalid isolated systemd-run test executable" >&2
        exit 2
    fi
    SYSTEMD_RUN_BIN="$HAPAX_SMOKE_SYSTEMD_RUN_BIN"
fi

# Failure tracking is installed before change discovery so a broken Git object
# graph cannot turn the smoke run into an empty successful change set.
MAX_RECORDED_FAILURES=12
MAX_FAILURE_ENTRY_CHARS=240
FAILED_GATE_COUNT=0
FAILED_GATES=()
record_failure() {
    local entry
    FAILED_GATE_COUNT=$((FAILED_GATE_COUNT + 1))
    if [ "${#FAILED_GATES[@]}" -lt "$MAX_RECORDED_FAILURES" ]; then
        printf -v entry "%.${MAX_FAILURE_ENTRY_CHARS}s" "$1: $2"
        FAILED_GATES+=("$entry")
    fi
}

record_execution_failure() {
    EXECUTION_FAILURE=2
    record_failure "$@"
}

run_bounded_user_service() {
    local unit_stem="$1" runtime_s="$2"
    shift 2
    local env_name env_value client_timeout_s
    local -a environment_args=()
    if [ ! -x "$SYSTEMD_RUN_BIN" ] || [ -L "$SYSTEMD_RUN_BIN" ]; then
        return 2
    fi
    for env_name in HOME PATH NTFY_TOPIC HAPAX_SMOKE_ISOLATED_TEST_ROOT \
        HAPAX_SMOKE_SYSTEMD_RUN_BIN HAPAX_SMOKE_NTFY_PAYLOAD \
        HAPAX_TEST_SMOKE_DESCENDANT_PID_FILE; do
        [[ -v "$env_name" ]] || continue
        env_value="${!env_name}"
        [ "${#env_value}" -le 4096 ] || return 2
        environment_args+=("--setenv=${env_name}=${env_value}")
    done
    client_timeout_s=$((runtime_s + 10))
    /usr/bin/timeout --foreground --signal=TERM --kill-after=2s "${client_timeout_s}s" \
        "$SYSTEMD_RUN_BIN" \
        --user \
        --wait \
        --pipe \
        --collect \
        --quiet \
        --no-ask-password \
        --unit="${unit_stem}.service" \
        --service-type=exec \
        --expand-environment=no \
        --property="RuntimeMaxSec=${runtime_s}s" \
        --property=MemoryHigh=1536M \
        --property=MemoryMax=2G \
        --property=TasksMax=512 \
        --property=TimeoutStopSec=1s \
        --property=KillMode=control-group \
        --property=SendSIGKILL=yes \
        "${environment_args[@]}" \
        -- \
        "$@"
}

emit_failure_notice() {
    local count=$FAILED_GATE_COUNT
    local retained=${#FAILED_GATES[@]}
    local omitted=$((count - retained))
    [ "$count" -eq 0 ] && return
    local sha_display body
    printf -v sha_display '%.80s' "$SHA"
    body="merge=$sha_display gates_failed=$count"
    for entry in "${FAILED_GATES[@]}"; do
        echo "smoke FAIL: $entry" >&2
        body="$body | $entry"
    done
    if [ "$omitted" -gt 0 ]; then
        echo "smoke FAIL: $omitted additional smoke failures omitted from bounded notice output" >&2
        body="$body | omitted=$omitted"
    fi
    printf -v body '%.3900s' "$body"
    if [ -n "${NTFY_TOPIC:-}" ]; then
        run_bounded_user_service \
            "hapax-post-merge-smoke-notice-${BASHPID}" \
            "$NTFY_TIMEOUT_S" \
            curl --fail --silent --show-error \
            --connect-timeout 2 \
            --max-time "$NTFY_TIMEOUT_S" \
            -H "Title: post-merge smoke FAIL ($count gate$([ "$count" -gt 1 ] && echo s))" \
            -H "Priority: default" \
            -H "Tags: warning,test" \
            -d "$body" \
            "https://ntfy.sh/${NTFY_TOPIC}" \
            >/dev/null 2>&1 || true
    fi
}
trap emit_failure_notice EXIT

case "$#" in
    1)
        if [ "$1" = "--since" ]; then
            record_execution_failure \
                "change-discovery" \
                "malformed arguments; next action: invoke hapax-post-merge-smoke <target-sha> or --since <base-sha> <target-sha>"
            exit 2
        fi
        SHA="$1"
        ;;
    3)
        if [ "$1" != "--since" ]; then
            record_execution_failure \
                "change-discovery" \
                "malformed arguments; next action: invoke hapax-post-merge-smoke <target-sha> or --since <base-sha> <target-sha>"
            exit 2
        fi
        if [ -z "$2" ]; then
            record_execution_failure \
                "change-discovery" \
                "empty --since commit; next action: pass the trusted deployed ancestor explicitly and rerun this smoke"
            exit 2
        fi
        SINCE="$2"
        SHA="$3"
        ;;
    *)
        record_execution_failure \
            "change-discovery" \
            "malformed arguments; next action: invoke hapax-post-merge-smoke <target-sha> or --since <base-sha> <target-sha>"
        exit 2
        ;;
esac

if [ -z "${REPO_ROOT:-}" ]; then
    if ! REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"; then
        record_execution_failure \
            "change-discovery" \
            "cannot discover a Git repository root; next action: set REPO_ROOT to the deployed release containing the target commit and rerun this smoke"
        exit 2
    fi
fi
if ! cd -- "$REPO_ROOT"; then
    record_execution_failure \
        "change-discovery" \
        "cannot enter repository root $REPO_ROOT; next action: restore the deployed source root and rerun this smoke"
    exit 2
fi
if ! OBSERVED_REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    record_execution_failure \
        "change-discovery" \
        "$REPO_ROOT is not a Git repository; next action: restore the deployed source root and rerun this smoke"
    exit 2
fi
if [ "$(pwd -P)" != "$(cd -- "$OBSERVED_REPO_ROOT" && pwd -P)" ]; then
    record_execution_failure \
        "change-discovery" \
        "$REPO_ROOT is not the repository top level; next action: set REPO_ROOT=$OBSERVED_REPO_ROOT and rerun this smoke"
    exit 2
fi

# Resolve every caller-provided ref once before parent or tree reads. A
# single-commit smoke compares its first parent, while --since covers the exact
# cumulative deployment range. Root commits use an explicit --root tree diff.
if ! SHA_RESOLVED="$(git rev-parse --verify --quiet "${SHA}^{commit}")"; then
    record_execution_failure \
        "change-discovery" \
        "cannot resolve target commit $SHA in $REPO_ROOT; next action: fetch or restore the exact target object and rerun this smoke"
    exit 2
fi
SHA="$SHA_RESOLVED"
if [ -n "$SINCE" ]; then
    if ! SINCE_RESOLVED="$(git rev-parse --verify --quiet "${SINCE}^{commit}")"; then
        record_execution_failure \
            "change-discovery" \
            "cannot resolve --since commit $SINCE in $REPO_ROOT; next action: fetch or restore the exact base object and rerun this smoke"
        exit 2
    fi
    SINCE="$SINCE_RESOLVED"
    if git merge-base --is-ancestor "$SINCE" "$SHA"; then
        :
    else
        ancestor_rc=$?
        if [ "$ancestor_rc" -eq 1 ]; then
            record_execution_failure \
                "change-discovery" \
                "--since commit $SINCE is not an ancestor of target $SHA; next action: select the trusted deployed ancestor and rerun this smoke"
        else
            record_execution_failure \
                "change-discovery" \
                "cannot compare --since commit $SINCE with target $SHA; next action: verify both commit objects and rerun this smoke"
        fi
        exit 2
    fi
fi

# The helper deployed immediately before this contract did not re-exec after
# atomically replacing itself. Its final smoke invocation therefore still ran
# the old fail-open caller. When this exact target smoke is that invocation,
# run the newly installed exact helper under the inherited deployment lock
# before the old caller can publish a completion receipt. A failed bridge
# terminates only the authenticated direct parent deploy process.
bridge_legacy_deploy_caller() {
    local parent_cmdline installed_helper target_helper_oid installed_helper_oid bridge_rc
    local -a bridge_args
    [ "${HAPAX_POST_MERGE_EXACT_SMOKE_CALLER:-0}" != "1" ] || return 1
    [ "${HAPAX_POST_MERGE_ROLLOUT_BRIDGE_ACTIVE:-0}" != "1" ] || return 1
    [[ "${HAPAX_ROOT_REQUIRED_LOCK_FD:-}" =~ ^[0-9]+$ ]] || return 1
    [[ "${HAPAX_ROOT_REQUIRED_LOCK_ANCHOR_FD:-}" =~ ^[0-9]+$ ]] || return 1
    [ -e "/proc/self/fd/$HAPAX_ROOT_REQUIRED_LOCK_FD" ] || return 1
    [ -e "/proc/self/fd/$HAPAX_ROOT_REQUIRED_LOCK_ANCHOR_FD" ] || return 1
    if ! parent_cmdline="$(tr '\0' '\n' < "/proc/$PPID/cmdline" 2>/dev/null)" \
        || ! grep -Eq '(^|/)hapax-post-merge-deploy$' <<< "$parent_cmdline"; then
        return 1
    fi
    installed_helper="$HOME/.local/bin/hapax-post-merge-deploy"
    if [ ! -x "$installed_helper" ] || [ -L "$installed_helper" ]; then
        record_execution_failure \
            "rollout-adoption" \
            "legacy deploy caller did not publish a trusted replacement helper; next action: restore the exact target helper and rerun the governed deploy"
        kill -TERM "$PPID" 2>/dev/null || true
        exit 2
    fi
    if ! target_helper_oid="$(git rev-parse --verify "${SHA}:scripts/hapax-post-merge-deploy" 2>/dev/null)" \
        || ! installed_helper_oid="$(git hash-object -- "$installed_helper" 2>/dev/null)" \
        || [ "$installed_helper_oid" != "$target_helper_oid" ]; then
        record_execution_failure \
            "rollout-adoption" \
            "installed deploy helper does not match the exact target object; next action: repair helper publication and rerun the governed deploy"
        kill -TERM "$PPID" 2>/dev/null || true
        exit 2
    fi
    bridge_args=("$SHA")
    if [ -n "$SINCE" ]; then
        bridge_args=(--since "$SINCE" "$SHA")
    fi
    bridge_rc=0
    HAPAX_POST_MERGE_ROLLOUT_BRIDGE_ACTIVE=1 \
        REPO="$REPO_ROOT" \
        "$installed_helper" "${bridge_args[@]}" || bridge_rc=$?
    if [ "$bridge_rc" -ne 0 ]; then
        record_execution_failure \
            "rollout-adoption" \
            "exact replacement deploy failed with rc=$bridge_rc; the legacy caller was terminated before receipt publication"
        kill -TERM "$PPID" 2>/dev/null || true
        exit "$bridge_rc"
    fi
    return 0
}

if bridge_legacy_deploy_caller; then
    exit 0
fi

if [ -n "$SINCE" ]; then
    DIFF_LABEL="${SINCE}..${SHA}"
    if ! CHANGED_FILES="$(git diff --name-only "$SINCE" "$SHA" -- 2>/dev/null)"; then
        record_execution_failure \
            "change-discovery" \
            "cannot enumerate changed files for $DIFF_LABEL; next action: verify both commit objects with git cat-file -e and rerun this smoke"
        exit 2
    fi
else
    if ! FIRST_PARENT="$(
        git cat-file -p "$SHA" 2>/dev/null \
            | awk '
                BEGIN { in_header = 1; found = 0 }
                in_header && /^$/ { in_header = 0; next }
                in_header && /^parent / && !found { print $2; found = 1 }
            '
    )"; then
        record_execution_failure \
            "change-discovery" \
            "cannot inspect target commit header for $SHA; next action: restore the exact commit object and rerun this smoke"
        exit 2
    fi
    if [ -n "$FIRST_PARENT" ]; then
        if ! [[ "$FIRST_PARENT" =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]] \
            || ! git cat-file -e "${FIRST_PARENT}^{commit}" 2>/dev/null; then
            record_execution_failure \
                "change-discovery" \
                "target $SHA names unavailable first parent object $FIRST_PARENT (likely a shallow boundary); next action: fetch the parent history and rerun this smoke"
            exit 2
        fi
        DIFF_LABEL="${FIRST_PARENT}..${SHA}"
        if ! CHANGED_FILES="$(git diff --name-only "$FIRST_PARENT" "$SHA" -- 2>/dev/null)"; then
            record_execution_failure \
                "change-discovery" \
                "cannot enumerate changed files for $DIFF_LABEL; next action: verify both commit objects with git cat-file -e and rerun this smoke"
            exit 2
        fi
    else
        DIFF_LABEL="root..${SHA}"
        if ! CHANGED_FILES="$(git diff-tree --root --no-commit-id --name-only -r "$SHA" -- 2>/dev/null)"; then
            record_execution_failure \
                "change-discovery" \
                "cannot enumerate changed files for $DIFF_LABEL; next action: verify the root commit object with git cat-file -e and rerun this smoke"
            exit 2
        fi
    fi
fi
[ -z "$CHANGED_FILES" ] && exit 0

# ── Gate: services-restarted ─────────────────────────────────────────
# When any systemd/units/*.service is in the diff, verify units that should
# be running are active after deploy. Timer-backed Type=oneshot units are
# expected to exit, so accept a completed successful oneshot as healthy.
# Newly installed disabled services are also install-only until a later
# enable/start PR; the deploy script copies them and daemon-reloads without
# starting them.

unit_install_scope() {
    local f="$1"
    local content entry scope_marker_count system_marker_count
    if ! entry="$(git ls-tree "$SHA" -- "$f")"; then
        return 1
    fi
    if [ -z "$entry" ]; then
        printf 'deleted\n'
        return 0
    fi
    if ! content="$(git show "${SHA}:$f")"; then
        return 1
    fi
    scope_marker_count="$(
        grep -Eic '^[[:blank:]]*[#;][[:blank:]]*Hapax-Install-Scope[[:blank:]]*:' <<< "$content" || true
    )"
    system_marker_count="$(
        grep -Eic '^[[:blank:]]*[#;][[:blank:]]*Hapax-Install-Scope[[:blank:]]*:[[:blank:]]*system[[:blank:]]*$' <<< "$content" || true
    )"
    if [ "$scope_marker_count" -eq 0 ]; then
        printf 'user\n'
    elif [ "$scope_marker_count" -eq 1 ] && [ "$system_marker_count" -eq 1 ]; then
        printf 'system\n'
    else
        return 1
    fi
}

DECOMMISSIONED_UNITS=()
load_decommissioned_units() {
    local source parsed
    DECOMMISSIONED_UNITS=()
    if ! source="$(git show "${SHA}:systemd/scripts/install-units.sh" 2>/dev/null)"; then
        record_execution_failure \
            "services-restarted" \
            "cannot read exact-SHA decommission data from systemd/scripts/install-units.sh"
        return 1
    fi
    if ! parsed="$(
        awk '
            BEGIN {
                state = 0
                declarations = 0
                invalid = 0
            }
            /^[[:space:]]*DECOMMISSIONED_UNITS=/ {
                declarations++
                if ($0 !~ /^[[:space:]]*DECOMMISSIONED_UNITS=\([[:space:]]*$/ || state != 0) {
                    invalid = 1
                } else {
                    state = 1
                }
                next
            }
            state == 1 && /^[[:space:]]*\)[[:space:]]*$/ {
                state = 2
                next
            }
            state == 1 {
                line = $0
                if (line ~ /^[[:space:]]*($|#)/) {
                    next
                }
                sub(/^[[:space:]]*/, "", line)
                sub(/[[:space:]]+#.*$/, "", line)
                sub(/[[:space:]]*$/, "", line)
                if (line !~ /^[A-Za-z0-9_.@:-]+$/ || seen[line]++) {
                    invalid = 1
                    next
                }
                print line
            }
            END {
                if (invalid || declarations != 1 || state != 2) {
                    exit 1
                }
            }
        ' <<< "$source"
    )"; then
        record_execution_failure \
            "services-restarted" \
            "cannot parse exact-SHA decommission data from systemd/scripts/install-units.sh"
        return 1
    fi
    if [ -n "$parsed" ]; then
        mapfile -t DECOMMISSIONED_UNITS <<< "$parsed"
    fi
}

is_decommissioned_unit() {
    local candidate="$1" retired
    for retired in "${DECOMMISSIONED_UNITS[@]}"; do
        if [ "$candidate" = "$retired" ]; then
            return 0
        fi
    done
    return 1
}

unit_parked_at_sha() {
    local unit="$1" content
    if ! content="$(git show "${SHA}:systemd/units/${unit}" 2>/dev/null)"; then
        return 2
    fi
    grep -Eiq '^[#;][[:space:]]*Hapax-Parked:[[:space:]]*(true|yes|1)[[:space:]]*$' \
        <<< "$content"
}

bridge_inactive_expected_for_live_mode() {
    local unit="$1" compositor_env imagination_state imagination_env
    [ "$unit" = "hapax-v4l2-bridge.service" ] || return 1

    if ! compositor_env="$(
        systemctl --user show studio-compositor.service -p Environment --value 2>/dev/null
    )"; then
        return 2
    fi
    if grep -Eq '(^|[[:space:]])HAPAX_V4L2_BRIDGE_ENABLED=0([[:space:]]|$)' <<< "$compositor_env"; then
        return 0
    fi
    if grep -Eq '(^|[[:space:]])HAPAX_3D_COMPOSITOR=1([[:space:]]|$)' <<< "$compositor_env"; then
        return 0
    fi

    if ! imagination_state="$(
        systemctl --user show hapax-imagination.service -p ActiveState --value 2>/dev/null
    )" || [ -z "$imagination_state" ]; then
        return 2
    fi
    [ "$imagination_state" = "active" ] || return 1
    if ! imagination_env="$(
        systemctl --user show hapax-imagination.service -p Environment --value 2>/dev/null
    )"; then
        return 2
    fi
    if grep -Eq '(^|[[:space:]])HAPAX_IMAGINATION_V4L2_OUTPUT=1([[:space:]]|$)' <<< "$imagination_env"; then
        return 0
    fi
    return 1
}

gate_services_restarted() {
    local changed_units=() scope inactive_expected parked_rc
    while IFS= read -r f; do
        case "$f" in
            systemd/units/*.service)
                if ! scope="$(unit_install_scope "$f")"; then
                    record_execution_failure "services-restarted" "$f cannot be classified from the exact target Git object or has an invalid Hapax-Install-Scope marker"
                    continue
                fi
                if [ "$scope" = "user" ]; then
                    changed_units+=("$(basename "$f")")
                fi
                ;;
        esac
    done <<< "$CHANGED_FILES"
    [ "${#changed_units[@]}" -eq 0 ] && return

    [ "$DRYRUN" = "1" ] && { echo "[dry-run] services-restarted: ${changed_units[*]}"; return; }
    load_decommissioned_units || return

    for unit in "${changed_units[@]}"; do
        # Template unit files (foo@.service) are install-only at smoke time.
        # A template is never active by itself; only concrete instances such as
        # foo@bar.service can be active. Treating the template as a runnable unit
        # creates a false failure after source activation installs the file.
        if [[ "$unit" == *@.service ]]; then
            continue
        fi
        inactive_expected=0
        if is_decommissioned_unit "$unit"; then
            inactive_expected=1
        elif unit_parked_at_sha "$unit"; then
            inactive_expected=1
        else
            parked_rc=$?
            if [ "$parked_rc" -eq 2 ]; then
                record_execution_failure \
                    "services-restarted" \
                    "cannot read exact-SHA unit content for $unit; next action: restore the target Git object and rerun this smoke"
                continue
            fi
        fi
        if [ "$inactive_expected" -eq 1 ]; then
            local active_state
            if ! active_state="$(systemctl --user show "$unit" -p ActiveState --value 2>/dev/null)"; then
                record_execution_failure \
                    "services-restarted" \
                    "cannot query ActiveState for inactive-expected unit $unit; next action: repair the user manager and rerun this smoke"
            elif [ -z "$active_state" ]; then
                record_execution_failure \
                    "services-restarted" \
                    "user manager returned an empty ActiveState for inactive-expected unit $unit; next action: inspect systemctl --user show $unit and rerun this smoke"
            elif [ "$active_state" != "inactive" ]; then
                record_failure \
                    "services-restarted" \
                    "$unit must be inactive after deploy (ActiveState=$active_state); next action: systemctl --user stop $unit, disable it, and rerun the governed deploy smoke"
            fi
            continue
        fi
        local active_state unit_type result exec_status unit_file_state
        if ! active_state="$(systemctl --user show "$unit" -p ActiveState --value 2>/dev/null)"; then
            record_execution_failure \
                "services-restarted" \
                "cannot query ActiveState for $unit; next action: repair the user manager and rerun this smoke"
            continue
        fi
        if [ -z "$active_state" ]; then
            record_execution_failure \
                "services-restarted" \
                "user manager returned an empty ActiveState for $unit; next action: inspect systemctl --user show $unit and rerun this smoke"
            continue
        fi
        [ "$active_state" != "active" ] || continue
        local bridge_mode_rc=1
        if [ "$active_state" = "inactive" ]; then
            bridge_mode_rc=0
            bridge_inactive_expected_for_live_mode "$unit" || bridge_mode_rc=$?
        fi
        case "$bridge_mode_rc" in
            0) continue ;;
            1) ;;
            *)
                record_execution_failure \
                    "services-restarted" \
                    "cannot query the live-mode exception state for $unit; next action: repair the user manager and rerun this smoke"
                continue
                ;;
        esac
        if ! unit_type="$(systemctl --user show "$unit" -p Type --value 2>/dev/null)" \
            || ! result="$(systemctl --user show "$unit" -p Result --value 2>/dev/null)" \
            || ! exec_status="$(systemctl --user show "$unit" -p ExecMainStatus --value 2>/dev/null)"; then
            record_execution_failure \
                "services-restarted" \
                "cannot query completion properties for $unit; next action: repair the user manager and rerun this smoke"
            continue
        fi
        if [ -z "$unit_type" ] || [ -z "$result" ] || [ -z "$exec_status" ]; then
            record_execution_failure \
                "services-restarted" \
                "user manager returned incomplete completion properties for $unit; next action: inspect the loaded unit and rerun this smoke"
            continue
        fi
        if [ "$active_state" = "inactive" ] \
            && [ "$unit_type" = "oneshot" ] \
            && [ "$result" = "success" ] \
            && [ "$exec_status" = "0" ]; then
            continue
        fi
        if ! unit_file_state="$(systemctl --user show "$unit" -p UnitFileState --value 2>/dev/null)"; then
            record_execution_failure \
                "services-restarted" \
                "cannot query UnitFileState for $unit; next action: repair the user manager and rerun this smoke"
            continue
        fi
        if [ -z "$unit_file_state" ]; then
            record_execution_failure \
                "services-restarted" \
                "user manager returned an empty UnitFileState for $unit; next action: inspect the loaded unit and rerun this smoke"
            continue
        fi
        if [ "$active_state" = "inactive" ] \
            && [ "$unit_file_state" = "disabled" ] \
            && [ "$result" = "success" ]; then
            continue
        fi
        record_failure \
            "services-restarted" \
            "$unit not active after deploy (ActiveState=$active_state)"
    done
}

# ── Gate: broadcast-healthy ──────────────────────────────────────────
# When the diff touches the audio-routing surface, verify the broadcast
# audio-health producer (shared.broadcast_audio_health) is still alive
# after the deploy — i.e. its state file is fresh (`checked_at` within
# 60s). This intentionally does NOT gate on `safe == true`; broadcast
# unsafety is an operator-visibility concern, separate from "did the
# deploy break the producer." A regressed producer (no fresh writes)
# blinds every downstream WCS consumer.

gate_broadcast_healthy() {
    local touched=false
    while IFS= read -r f; do
        case "$f" in
            agents/studio_compositor/*|\
            agents/hapax_daimonion/*|\
            shared/voice_output_router.py|\
            shared/voice_role_router.py|\
            shared/broadcast_audio_health.py|\
            shared/audio_world_surface_health.py|\
            config/voice-output-routes.yaml)
                touched=true
                break
                ;;
        esac
    done <<< "$CHANGED_FILES"
    $touched || return

    [ "$DRYRUN" = "1" ] && { echo "[dry-run] broadcast-healthy"; return; }

    # Real path written by shared.broadcast_audio_health.DEFAULT_STATE_PATH.
    local health_file="/dev/shm/hapax-broadcast/audio-safe-for-broadcast.json"
    local deadline=$(( $(date +%s) + 30 ))
    while [ "$(date +%s)" -lt "$deadline" ]; do
        if [ -f "$health_file" ]; then
            # Producer must be fresh: file mtime within 60s of now.
            local mtime now age
            mtime="$(stat -c %Y "$health_file" 2>/dev/null || echo 0)"
            now="$(date +%s)"
            age=$(( now - mtime ))
            if [ "$age" -le 60 ]; then
                return
            fi
        fi
        sleep 2
    done
    record_failure "broadcast-healthy" "$health_file did not show a fresh write (age ≤60s) within 30s"
}

# ── Gate: m8-midi-clock-peer ──────────────────────────────────────────
# When agents/hapax_daimonion/backends/midi_clock.py changes, verify
# the M8 device produces a peer tempo signal the daimonion picks up.

gate_m8_midi_clock_peer() {
    local touched=false
    while IFS= read -r f; do
        case "$f" in
            agents/hapax_daimonion/backends/midi_clock.py)
                touched=true
                break
                ;;
        esac
    done <<< "$CHANGED_FILES"
    $touched || return

    [ "$DRYRUN" = "1" ] && { echo "[dry-run] m8-midi-clock-peer"; return; }

    # Only run the check if the M8 is actually present (operator-physical
    # device). On absence, skip — the smoke is informational, not gating.
    local amidi_devices
    if ! command -v amidi >/dev/null 2>&1; then
        record_execution_failure \
            "m8-midi-clock-peer" \
            "amidi is unavailable; next action: restore the ALSA MIDI probe and rerun this smoke"
        return
    fi
    if ! amidi_devices="$(amidi -l 2>/dev/null)"; then
        record_execution_failure \
            "m8-midi-clock-peer" \
            "amidi device enumeration failed; next action: repair the ALSA MIDI probe and rerun this smoke"
        return
    fi
    if ! grep -qiE 'M8|hw:.*M8' <<< "$amidi_devices"; then
        return  # M8 not connected; skip
    fi
    # Look for the daimonion's published tempo signal.
    local tempo_file="/dev/shm/hapax-daimonion/peer-tempo.json"
    local deadline=$(( $(date +%s) + 15 ))
    while [ "$(date +%s)" -lt "$deadline" ]; do
        if [ -f "$tempo_file" ]; then
            if grep -qE '"source"\s*:\s*"m8"' "$tempo_file" 2>/dev/null; then
                return
            fi
        fi
        sleep 1
    done
    record_failure "m8-midi-clock-peer" "$tempo_file did not show source=m8 within 15s of deploy"
}

# ── Gate dispatch ─────────────────────────────────────────────────────

gate_services_restarted
gate_broadcast_healthy
gate_m8_midi_clock_peer

# Trap emits the bounded notice while preserving advisory-vs-execution status.
exit "$EXECUTION_FAILURE"
