#!/usr/bin/env bash
# Install the host recovery script and user units into stable post-reboot paths.
set -euo pipefail

SOURCE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEST="${HAPAX_HOST_RECOVERY_BIN:-$HOME/.local/bin/hapax-host-recovery}"
UNIT_DIR="${HAPAX_HOST_RECOVERY_UNIT_DIR:-$HOME/.config/systemd/user}"
SYSTEMCTL="${HAPAX_HOST_RECOVERY_SYSTEMCTL:-systemctl}"
MODE=check
REPORT_HOST=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --source) SOURCE="${2:?}"; shift 2 ;;
        --install) MODE=install; shift ;;
        --check) MODE=check; shift ;;
        --report-host) REPORT_HOST="${2:?}"; shift 2 ;;
        *) echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done
if [ -n "$REPORT_HOST" ] && ! [[ "$REPORT_HOST" =~ ^[a-z0-9-]+$ ]]; then
    echo "invalid report host" >&2
    exit 2
fi

units=(
    hapax-host-recovery-capture.service
    hapax-host-recovery-capture.timer
    hapax-host-recovery-restore.service
    hapax-host-recovery-restore.timer
)
if [ "$MODE" = install ]; then
    mkdir -p "$(dirname "$DEST")" "$UNIT_DIR"
    install -m 755 "$SOURCE/scripts/hapax-host-recovery" "$DEST"
    for unit in "${units[@]}"; do
        install -m 644 "$SOURCE/systemd/units/$unit" "$UNIT_DIR/$unit"
    done
    if [ -n "$REPORT_HOST" ]; then
        install -d -m 755 "$UNIT_DIR/hapax-host-recovery-restore.service.d"
        printf '[Service]\nEnvironment=HAPAX_RECOVERY_REPORT_HOST=%s\n' "$REPORT_HOST" \
            > "$UNIT_DIR/hapax-host-recovery-restore.service.d/report.conf"
    fi
    "$SYSTEMCTL" --user daemon-reload
    "$SYSTEMCTL" --user enable --now hapax-host-recovery-capture.timer \
        hapax-host-recovery-restore.service hapax-host-recovery-restore.timer
fi
cmp -s "$SOURCE/scripts/hapax-host-recovery" "$DEST" || {
    echo "host recovery script differs from source: $DEST" >&2; exit 1;
}
for unit in "${units[@]}"; do
    cmp -s "$SOURCE/systemd/units/$unit" "$UNIT_DIR/$unit" || {
        echo "host recovery unit differs from source: $unit" >&2; exit 1;
    }
done
"$SYSTEMCTL" --user is-enabled --quiet hapax-host-recovery-capture.timer
"$SYSTEMCTL" --user is-enabled --quiet hapax-host-recovery-restore.timer
"$SYSTEMCTL" --user is-enabled --quiet hapax-host-recovery-restore.service
echo "host recovery installed and enabled"
