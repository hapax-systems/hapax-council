#!/usr/bin/env python3
"""Mistral Vibe substitute reviewer seat for the review-team registry (read-only).

Runs `vibe -p` on the dispatcher's prompt in an empty temporary workdir with every tool
disabled and one turn. Two refusals, each reported as a route outage:

- Size. On 2026-09-24, `vibe -p` returned 0 B three times on 45-87 KB prompts and returned
  verdicts at 22 KB and 60 KB. Prompts above the largest size measured below the smallest
  failure (22 KB) are refused, so the seat never returns nothing silently.
- Billing surface. The CLI can be bound to the metered API (`plan_type: api`) instead of the
  Team allowance (`plan_type: chat`). The seat runs only when the configured key's own whoami
  entry is the Team plan; otherwise it is refused rather than switching billing implicitly (next
  action for the coordinator: rebind Vibe to the Team account).

Vibe runs inside the declared capability envelope (``shared.capability_envelope``): a fresh home
holding only the key file (bound read-only) and a trusted-folders file, an empty workdir, and a
cleared environment. Measured 2026-09-25 on this wrapper's argv, an inherited HOME put the estate's
``~/.vibe/AGENTS.md`` into every review. A host without a usable envelope is a route outage, never
an unenveloped run.
"""

from __future__ import annotations

import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from shared.capability_envelope import (  # noqa: E402
    CredentialBind,
    DeclaredFile,
    EnvelopeDeclaration,
    EnvelopeRefusal,
    execute,
    render,
)
from shared.review_seat_wrapper import SEAT_PREAMBLE, refuse  # noqa: E402

WRAPPER = "hapax-vibe-reviewer"
MAX_PROMPT_BYTES = 22_000
MAX_PRICE_DOLLARS = "1.00"
#: The Team allowance's plan_type, observed after the Team sign-in (frame/CAPABILITY-ROUTING-TABLE.md
#: vibe row: "the new key's whoami reads plan_type chat instead of api").
TEAM_PLAN_TYPE = "chat"
KEY_VARIABLE = "MISTRAL_API_KEY"


def configured_key(home: Path) -> str | None:
    """The key vibe runs with: ~/.vibe/.env, unless the process sets a different one (refused).

    The key stays in this process: it is only hashed, never logged, printed or passed on.
    """

    from_file = None
    try:
        for line in (home / ".vibe" / ".env").read_text(encoding="utf-8").splitlines():
            name, sep, value = line.strip().partition("=")
            if sep and name.strip() == KEY_VARIABLE:
                from_file = value.strip().strip("\"'") or None
    except OSError:
        from_file = None
    from_process = os.environ.get(KEY_VARIABLE, "").strip() or None
    if from_process and from_file and from_process != from_file:
        return None  # two different keys: which one bills is not established
    return from_process or from_file


def binding_plan_type(home: Path) -> str:
    """plan_type of the configured key's own whoami entry, or a refusal reason code.

    The whoami cache is keyed by the first 32 hex of sha256(key) (measured by the seat against
    the live cache, 2026-09-24T21:59Z). Only the configured key's entry counts: a stale entry
    for an old key (the 09-19 API key is still cached) says nothing about today's binding.
    #4728's `read_other_family` reports "api" if ANY entry is api, which is why this does not
    reuse it (that conflation is a follow-up on the reader's row).
    """

    key = configured_key(home)
    if not key:
        return "no_configured_key"
    try:
        cache = json.loads((home / ".vibe" / "whoami_cache.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return "whoami_cache_unreadable"
    if not isinstance(cache, dict):
        return "whoami_cache_unreadable"
    entry = cache.get(hashlib.sha256(key.encode("utf-8")).hexdigest()[:32])
    if not isinstance(entry, dict) or not isinstance(entry.get("payload"), dict):
        return "no_entry_for_configured_key"
    return str(entry["payload"].get("plan_type") or "plan_type_missing")


def vibe_bin() -> str | None:
    return os.environ.get("HAPAX_VIBE_BIN") or shutil.which("vibe")


def command(binary: str, prompt: str, workdir: Path) -> list[str]:
    return [
        binary,
        "-p",
        prompt,
        "--agent",
        "plan",
        "--max-turns",
        "1",
        "--max-price",
        MAX_PRICE_DOLLARS,
        "--output",
        "text",
        "--enabled-tools",
        "re:^$",  # matches no tool: with -p, every other tool is disabled
        "--workdir",
        str(workdir),
    ]


def runtime_dirs(binary: Path, home: Path) -> tuple[Path, ...]:
    """Host directories vibe needs inside the envelope, bound read-only.

    Default: the uv tool directory that holds the binary, and uv's managed interpreters, whole,
    because the tool venv's python points through a minor-version symlink. HAPAX_VIBE_RUNTIME_DIRS
    (colon-separated) replaces the default for a relocated install.
    """

    declared = os.environ.get("HAPAX_VIBE_RUNTIME_DIRS", "")
    if declared:
        candidates = [Path(p) for p in declared.split(":") if p]
    else:
        candidates = [binary.resolve().parents[1], home / ".local" / "share" / "uv" / "python"]
    return tuple(p for p in candidates if p.exists())


def run_enveloped(binary: str, text: str, home: Path, scratch: Path) -> subprocess.CompletedProcess:
    """Render and run vibe inside the declared envelope. Raises EnvelopeRefusal."""

    workdir = scratch / "work"
    workdir.mkdir()
    trusted = scratch / "trusted_folders.toml"
    trusted.write_text('trusted = ["/work"]\nuntrusted = []\n', encoding="utf-8")
    vibe = Path(binary)
    declaration = EnvelopeDeclaration(
        harness="vibe",
        argv=tuple(command(str(vibe.resolve()), text, Path("/work"))),
        binaries=runtime_dirs(vibe, home),
        workdir=workdir,
        credentials=(CredentialBind(source=home / ".vibe" / ".env", target=".vibe/.env"),),
        home_files=(DeclaredFile(source=trusted, target=".vibe/trusted_folders.toml"),),
    )
    rendered = render(declaration, run_root=scratch / "run")
    return execute(rendered, timeout=1800)


def main() -> int:
    prompt = sys.stdin.read()
    if not prompt.strip():
        return refuse(WRAPPER, "empty prompt on stdin; the dispatcher sends the review prompt")
    text = f"{SEAT_PREAMBLE}\n\n{prompt.strip()}\n"
    size = len(text.encode("utf-8"))
    if size > MAX_PROMPT_BYTES:
        return refuse(
            WRAPPER,
            f"prompt of {size} bytes exceeds the measured vibe -p ceiling of {MAX_PROMPT_BYTES} "
            "(0 B at 45-87 KB on 2026-09-24); the constitution substitutes another family",
        )
    plan = binding_plan_type(Path.home())
    if plan != TEAM_PLAN_TYPE:
        return refuse(
            WRAPPER,
            f"the configured vibe key's binding reads {plan}, not the Team allowance "
            f"(plan_type={TEAM_PLAN_TYPE}); refusing to spend on the API meter. "
            "Next action (coordinator): rebind Vibe to the Team account",
        )
    binary = vibe_bin()
    if not binary:
        return refuse(WRAPPER, "vibe binary not found; install vibe or set HAPAX_VIBE_BIN")
    if not shutil.which("bwrap"):
        return refuse(
            WRAPPER,
            "bubblewrap not found: the vibe seat runs only inside the declared envelope; next "
            "action (coordinator): install bubblewrap on this host, or the constitution "
            "substitutes another family",
        )
    home = Path.home()
    if not (home / ".vibe" / ".env").is_file():
        return refuse(
            WRAPPER,
            "no ~/.vibe/.env: the envelope carries the key only as that file, bound read-only; "
            "next action (coordinator): put the Team key in ~/.vibe/.env",
        )
    with tempfile.TemporaryDirectory(prefix="hapax-vibe-review-") as tmp:
        try:
            result = run_enveloped(binary, text, home, Path(tmp))
        except EnvelopeRefusal as exc:
            return refuse(WRAPPER, f"envelope refused: {exc}")
        except (OSError, subprocess.TimeoutExpired) as exc:
            return refuse(WRAPPER, f"failed to launch vibe ({type(exc).__name__})")
    if result.returncode != 0 and result.stderr.startswith("bwrap:"):
        first = result.stderr.splitlines()[0]
        return refuse(
            WRAPPER,
            f"the envelope carrier failed ({first}); next action (coordinator): enable "
            "unprivileged user namespaces for bubblewrap on this host, or the constitution "
            "substitutes another family",
        )
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    return result.returncode


if __name__ == "__main__":
    raise SystemExit(main())
