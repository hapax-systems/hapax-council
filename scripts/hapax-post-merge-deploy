#!/bin/bash
# hapax-post-merge-deploy — delta's post-merge deploy helper
#
# Given a commit SHA (typically a merge commit on origin/main), inspect
# the files changed and run the manual deploy steps that the automated
# rebuild-services.timer doesn't cover.
#
# Automated (by rebuild-services.timer, 5-min cadence):
#   agents/**/*.py, shared/**/*.py, logos/**/*.py  → Python service rebuild
#   hapax-logos/crates/hapax-imagination/**         → hapax-rebuild-logos.timer
#                                                     (timer name retained for
#                                                     compat; only builds and
#                                                     installs hapax-imagination
#                                                     — the Tauri/WebKit
#                                                     hapax-logos preview is
#                                                     decommissioned and is
#                                                     never built or restarted)
#
# Manual (this script):
#   config/pipewire/*.conf         → cp + restart pipewire stack
#   config/hapax/*.conf            → cp + restart hapax-audio-reconciler
#   config/wireplumber/*.conf      → cp + restart wireplumber
#   config/wireplumber/scripts/hapax/*.lua → cp to ~/.local/share/wireplumber/scripts/hapax
#                                            + restart wireplumber
#   systemd/*.service|timer|path   → cp + daemon-reload + restart
#   systemd/units/*.service|timer|path|target → cp + daemon-reload + restart
#   systemd/units/*.slice            → cp + daemon-reload (members activate it; no enable/restart)
#       unless the unit has `# Hapax-Install-Scope: system`, in which case
#       it is system/root-scoped and must be installed by its dedicated
#       installer rather than copied into the user unit directory.
#       A unit carrying `# Hapax-Auto-Enable: true` (+ an [Install] section)
#       is `enable --now`'d when newly installed, so a freshly-merged
#       service/timer goes live instead of installing-but-sleeping (the
#       try-restart-is-a-no-op-for-a-never-enabled-unit gap). Unmarked new
#       timers still auto-enable for back-compat; unmarked services do not.
#   systemd/units/*.service.d/*.conf → cp drop-in + daemon-reload + restart active unit
#       plus known stale local route-dropin cleanup for units that are being
#       sourceized out of a temporary worktree override.
#   systemd/units/*.md              → source/rationale docs only; no direct deploy
#   systemd/user-preset.d/*.preset → cp user preset
#   systemd/overrides/**           → source/rationale docs only; no direct deploy
#   systemd/scripts/*              → installer helper scripts; no direct deploy
#   systemd/watchdogs/*            → install executable into ~/.local/bin
#   config/root-required/oom-containment.files and every path it owns
#                                  → validate and stage exact-SHA desired
#                                    evidence; production application remains
#                                    unavailable until a separately authorized
#                                    root broker exists
#   systemd/logrotate.d/*          → logrotate configs; require sudo install
#   systemd/system/**              → other system-scoped configs; require sudo install
#   config/root-required/apcupsd-power-alerts.files and every path it owns
#                                  → validate and stage exact-SHA APC desired
#                                    evidence; production application remains
#                                    unavailable until a separately authorized
#                                    root broker exists
#   scripts/hapax-recovery-plane-install, scripts/hapax-p0-incident-intake,
#   scripts/hapax-coord-deploy, shared/{__init__,jsonl_append,p0_incident_intake}.py
#                                  → refresh the stable D2 recovery bundle under
#                                    ~/.local/lib/hapax-recovery/council
#   scripts/hapax-*                → publish a release-pinned regular copy in ~/.local/bin/
#   hooks/scripts/{cc-task-gate.impl.sh,agent-role.sh,escape-grant.sh,
#                  hapax_check_enable_latch.sh,cc-task-gate-bootstrap.py,
#                  hooks-doctor.sh,cc-task-gate.sh}
#                                  → reconcile the ONE canonical gate closure
#                                    on every run and redeploy drift to
#                                    ~/.local/lib/hapax/hooks via hooks-doctor
#                                    --deploy-canonical (reform FM-6: every
#                                    worktree's cc-task-gate.sh is a shim that
#                                    resolves here, so "update the gate" is a
#                                    one-file change, not a 26-worktree fan-out)
#   assets/quake/{maps,qc,csqc,models,sound,glsl,scripts,config}/** and
#   assets/quake/darkplaces/**      → install Screwm Quake assets into the
#                                    DarkPlaces gamedir; restart the visible
#                                    renderer only when already active so map,
#                                    CSQC, and live-texture binding changes do
#                                    not sit green-but-unloaded after merge.
#
# Usage:
#   hapax-post-merge-deploy <commit-sha>
#       deploy classified files for the given commit
#   hapax-post-merge-deploy --dry-run <commit-sha>
#       classify files and write the post-merge trace without copying files
#       or restarting services
#   hapax-post-merge-deploy --report-coverage <commit-sha>
#       drift-report mode — exit 1 if any systemd/** path in the commit
#       falls outside the case-globs above. Used by CI to catch the
#       absence-class deploy bug where a new systemd unit lands at a
#       path the deploy script doesn't case-match (P-4 of the
#       absence-class-bug-prevention-and-remediation epic).
#   hapax-post-merge-deploy --verify-auto-enable
#       post-deploy assertion mode — exit 1 if any unit under
#       systemd/units/ marked `# Hapax-Auto-Enable: true` is not enabled
#       (and, for timers, active). Witnesses FM-11 (and future marked
#       units) is live, not merely installed. Needs no commit SHA.
#
# Exits 0 if nothing needed deploying or all deploys succeeded.
# Exits non-zero if any deploy step failed (or, in --report-coverage
# mode, if any systemd/** path is unclassified).
set -euo pipefail
# Repository selectors are never deployment inputs. Explicit repository roots
# and immutable commit objects are the only accepted identity surface.
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY
unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_SHALLOW_FILE GIT_REPLACE_REF_BASE
export GIT_NO_REPLACE_OBJECTS=1
ORIGINAL_ARGS=("$@")

DRY_RUN=0
REPORT_COVERAGE=0
COVERAGE_FROM_STDIN=0
VERIFY_AUTO_ENABLE=0
CHECK_SYMLINK_DRIFT=0
SINCE=""
DEPLOY_CURSOR_SHA=""
TRACE_READY=0
TRACE_WRITTEN=0
SHA=""
CHANGED_FILES=""
FILES=""
SYSTEMD_PENDING_SNAPSHOT="absent"
if [ "${1:-}" = "--dry-run" ]; then
    DRY_RUN=1
    shift
fi
# --since <sha>: deploy the CUMULATIVE union diff <since>..<commit> instead of
# the single-merge first-parent diff. One deploy then realizes a multi-merge
# backlog — the systemd-units / pipewire-confs / scripts files that get skipped
# when origin/main jumps several merges between deploy cycles (the root of the
# "merged but never installed" recurrence). Used by the one-time backfill, the
# source-activation cumulative path, and the .service edge-trigger.
if [ "${1:-}" = "--since" ]; then
    SINCE="${2:?commit SHA required after --since}"
    shift 2
fi
if [ "${1:-}" = "--report-coverage" ]; then
    REPORT_COVERAGE=1
    SHA="${2:?commit SHA required after --report-coverage}"
elif [ "${1:-}" = "--report-coverage-stdin" ]; then
    REPORT_COVERAGE=1
    COVERAGE_FROM_STDIN=1
elif [ "${1:-}" = "--verify-auto-enable" ]; then
    VERIFY_AUTO_ENABLE=1
elif [ "${1:-}" = "--check-symlink-drift" ]; then
    CHECK_SYMLINK_DRIFT=1
else
    SHA="${1:?commit SHA required}"
fi
# Default to the source-activation worktree (the documented production root —
# always at the deployed release) over the interactive primary tree, which can
# be weeks stale (2026-06-11: stale-primary symlinks shipped a pre-#4039
# checker that false-failed hourly for 6h).
_ACTIVATION_WORKTREE="$HOME/.cache/hapax/source-activation/worktree"
if [ -z "${REPO:-}" ] && [ -z "${GITHUB_WORKSPACE:-}" ] && [ -d "$_ACTIVATION_WORKTREE/scripts" ]; then
    REPO="$_ACTIVATION_WORKTREE"
fi
REPO="${REPO:-${GITHUB_WORKSPACE:-$HOME/projects/hapax-council}}"
PW_CONF_DIR="$HOME/.config/pipewire/pipewire.conf.d"
HAPAX_CONF_DIR="$HOME/.config/hapax"
WP_CONF_DIR="$HOME/.config/wireplumber/wireplumber.conf.d"
# WirePlumber Lua components load from the XDG *data* dir, not the conf dir.
# scripts/hapax-wireplumber-link-deny-policy installs link-deny.lua here and
# config/wireplumber/98-hapax-link-deny.conf references it as `hapax/link-deny.lua`.
WP_SCRIPTS_DIR="$HOME/.local/share/wireplumber/scripts/hapax"
SYSTEMD_USER_DIR="$HOME/.config/systemd/user"
SYSTEMD_RUNTIME_USER_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/systemd/user"
SYSTEMD_USER_PRESET_DIR="$HOME/.config/systemd/user-preset"
SYSTEMD_SYSTEM_DIR="/etc/systemd/system"
SYSTEMD_SYSTEM_EXPECTED_UID=0
SYSTEMD_SYSTEM_TRUST_ROOT="/"
LOCAL_BIN="$HOME/.local/bin"
TRACE_PATH="${HAPAX_POST_MERGE_TRACE_PATH:-$HOME/.cache/hapax/post-merge-traces/post-merge-traces.jsonl}"
TRACE_MAX_RECORDS="${HAPAX_POST_MERGE_TRACE_MAX_RECORDS:-200}"
# Receipt of the last SHA a real deploy cycle ran against (completed or
# no_changes). The rebuild-service.sh staleness alarm and the acceptance check
# `git rev-list <last-deployed-sha>..origin/main` read this, and the .service
# edge-trigger reads it to compute the cumulative --since range. Sibling of the
# trace file by default so a test override of HAPAX_POST_MERGE_TRACE_PATH
# isolates it automatically.
LAST_DEPLOYED_SHA_PATH="${HAPAX_POST_MERGE_LAST_DEPLOYED_SHA_PATH:-$(dirname "$TRACE_PATH")/last-deployed-sha}"
# Durable replay set for system-manager work that could not be witnessed at the
# deploy SHA. The queue stores source paths only; every replay re-evaluates
# those paths against the newest exact SHA rather than trusting old bytes.
SYSTEMD_RUNTIME_PENDING_PATH="${HAPAX_POST_MERGE_SYSTEMD_PENDING_PATH:-$(dirname "$TRACE_PATH")/systemd-runtime-pending.json}"
RECOVERY_INSTALLER_PATH="scripts/hapax-recovery-plane-install"
OOM_CONTAINMENT_INSTALLER_PATH="scripts/install-p0-oom-containment"
APCUPSD_INSTALLER_PATH="scripts/install-apcupsd-power-alerts"
ROOT_DEFER_DIR="${HAPAX_POST_MERGE_ROOT_DEFER_DIR:-$HOME/.cache/hapax/post-merge-root-required}"
ROOT_REQUIRED_STATE_ROOT="${HAPAX_ROOT_REQUIRED_STATE_ROOT:-$HOME/.local/state/hapax/root-required}"
ROOT_REQUIRED_INSTALLED_SOURCE_ROOT="${HAPAX_ROOT_REQUIRED_INSTALLED_SOURCE_ROOT:-$ROOT_REQUIRED_STATE_ROOT/current-source}"
ROOT_REQUIRED_INSTALLED_RECEIPT_ROOT="${HAPAX_ROOT_REQUIRED_INSTALLED_RECEIPT_ROOT:-$ROOT_REQUIRED_STATE_ROOT/installed-receipts}"
ROOT_REQUIRED_DESIRED_RECEIPT_ROOT="${HAPAX_ROOT_REQUIRED_DESIRED_RECEIPT_ROOT:-$ROOT_REQUIRED_STATE_ROOT/desired-receipts}"
ROOT_REQUIRED_LOCK_FILE="${HAPAX_ROOT_REQUIRED_LOCK_FILE:-$ROOT_REQUIRED_STATE_ROOT/.lock}"
ROOT_REQUIRED_LOCK_ANCHOR=""
RECOVERY_BUNDLE_DEST="${HAPAX_RECOVERY_BUNDLE_DEST:-$HOME/.local/lib/hapax-recovery/council/current}"
RECOVERY_BUNDLE_SOURCE_FILES=(
    scripts/hapax-p0-incident-intake
    scripts/hapax-coord-deploy
    shared/__init__.py
    shared/jsonl_append.py
    shared/p0_incident_intake.py
)
RECOVERY_BUNDLE_REQUIRED_FILES=(
    "${RECOVERY_BUNDLE_SOURCE_FILES[@]}"
    manifest.json
)

configure_root_required_state_domain() {
    local test_root="${HAPAX_ROOT_REQUIRED_ISOLATED_TEST_ROOT:-}"
    local selector nss_home
    if [ -n "$test_root" ]; then
        /usr/bin/python3 -I -S - \
            "$test_root" \
            "HOME=$HOME" \
            "HAPAX_POST_MERGE_TRACE_PATH=$TRACE_PATH" \
            "HAPAX_POST_MERGE_LAST_DEPLOYED_SHA_PATH=$LAST_DEPLOYED_SHA_PATH" \
            "HAPAX_POST_MERGE_SYSTEMD_PENDING_PATH=$SYSTEMD_RUNTIME_PENDING_PATH" \
            "HAPAX_POST_MERGE_ROOT_DEFER_DIR=$ROOT_DEFER_DIR" \
            "HAPAX_ROOT_REQUIRED_STATE_ROOT=$ROOT_REQUIRED_STATE_ROOT" \
            "HAPAX_ROOT_REQUIRED_INSTALLED_SOURCE_ROOT=$ROOT_REQUIRED_INSTALLED_SOURCE_ROOT" \
            "HAPAX_ROOT_REQUIRED_INSTALLED_RECEIPT_ROOT=$ROOT_REQUIRED_INSTALLED_RECEIPT_ROOT" \
            "HAPAX_ROOT_REQUIRED_DESIRED_RECEIPT_ROOT=$ROOT_REQUIRED_DESIRED_RECEIPT_ROOT" \
            "HAPAX_ROOT_REQUIRED_LOCK_FILE=$ROOT_REQUIRED_LOCK_FILE" \
            "HAPAX_RECOVERY_BUNDLE_DEST=$RECOVERY_BUNDLE_DEST" <<'PY'
from __future__ import annotations

import os
import stat
import sys

root = sys.argv[1]
if not os.path.isabs(root) or "\n" in root or len(root) > 4096:
    print("hapax-post-merge-deploy: isolated test root must be one absolute path", file=sys.stderr)
    raise SystemExit(2)
root = os.path.abspath(root)
try:
    root_stat = os.lstat(root)
except OSError as exc:
    print(f"hapax-post-merge-deploy: invalid isolated test root {root}: {exc}", file=sys.stderr)
    raise SystemExit(2) from exc
if (
    not stat.S_ISDIR(root_stat.st_mode)
    or root_stat.st_uid != os.geteuid()
    or root_stat.st_mode & 0o022
    or os.path.realpath(root) != root
):
    print(
        "hapax-post-merge-deploy: isolated test root must be a caller-owned, "
        "non-symlink, non-group/world-writable directory",
        file=sys.stderr,
    )
    raise SystemExit(2)

for item in sys.argv[2:]:
    label, separator, candidate = item.partition("=")
    if not separator or not candidate or not os.path.isabs(candidate) or "\n" in candidate:
        print(f"hapax-post-merge-deploy: {label} is invalid in isolated test mode", file=sys.stderr)
        raise SystemExit(2)
    lexical = os.path.abspath(candidate)
    resolved = os.path.realpath(candidate)
    try:
        lexical_inside = os.path.commonpath((root, lexical)) == root
        resolved_inside = os.path.commonpath((root, resolved)) == root
    except ValueError:
        lexical_inside = resolved_inside = False
    if not lexical_inside or not resolved_inside or lexical == root:
        print(
            f"hapax-post-merge-deploy: {label} escapes isolated test root {root}",
            file=sys.stderr,
        )
        raise SystemExit(2)
PY
        ROOT_REQUIRED_LOCK_ANCHOR="/"
        return
    fi

    for selector in \
        HAPAX_POST_MERGE_TRACE_PATH \
        HAPAX_POST_MERGE_LAST_DEPLOYED_SHA_PATH \
        HAPAX_POST_MERGE_SYSTEMD_PENDING_PATH \
        HAPAX_POST_MERGE_ROOT_DEFER_DIR \
        HAPAX_ROOT_REQUIRED_STATE_ROOT \
        HAPAX_ROOT_REQUIRED_INSTALLED_SOURCE_ROOT \
        HAPAX_ROOT_REQUIRED_INSTALLED_RECEIPT_ROOT \
        HAPAX_ROOT_REQUIRED_DESIRED_RECEIPT_ROOT \
        HAPAX_ROOT_REQUIRED_LOCK_FILE; do
        if [[ -v "$selector" ]]; then
            echo "hapax-post-merge-deploy: $selector selects caller-selected production state; remove it or use a confined HAPAX_ROOT_REQUIRED_ISOLATED_TEST_ROOT harness" >&2
            return 2
        fi
    done
    nss_home="$(/usr/bin/python3 -I -S - <<'PY'
import os
import pwd

print(pwd.getpwuid(os.geteuid()).pw_dir)
PY
)"
    if [ -z "$nss_home" ] || [ "${nss_home#/}" = "$nss_home" ] || [ "$HOME" != "$nss_home" ]; then
        echo "hapax-post-merge-deploy: HOME does not match NSS home for UID $(/usr/bin/id -u); refusing a split production state domain" >&2
        return 2
    fi
    TRACE_PATH="$nss_home/.cache/hapax/post-merge-traces/post-merge-traces.jsonl"
    LAST_DEPLOYED_SHA_PATH="$nss_home/.cache/hapax/post-merge-traces/last-deployed-sha"
    SYSTEMD_RUNTIME_PENDING_PATH="$nss_home/.cache/hapax/post-merge-traces/systemd-runtime-pending.json"
    ROOT_DEFER_DIR="$nss_home/.cache/hapax/post-merge-root-required"
    ROOT_REQUIRED_STATE_ROOT="$nss_home/.local/state/hapax/root-required"
    ROOT_REQUIRED_INSTALLED_SOURCE_ROOT="$ROOT_REQUIRED_STATE_ROOT/current-source"
    ROOT_REQUIRED_INSTALLED_RECEIPT_ROOT="$ROOT_REQUIRED_STATE_ROOT/installed-receipts"
    ROOT_REQUIRED_DESIRED_RECEIPT_ROOT="$ROOT_REQUIRED_STATE_ROOT/desired-receipts"
    ROOT_REQUIRED_LOCK_FILE="$ROOT_REQUIRED_STATE_ROOT/.lock"
    ROOT_REQUIRED_LOCK_ANCHOR="$nss_home"
}

acquire_inherited_root_required_lock() {
    local lock_fd="${HAPAX_ROOT_REQUIRED_LOCK_FD:-}"
    local anchor_fd="${HAPAX_ROOT_REQUIRED_LOCK_ANCHOR_FD:-}"
    local isolated=0
    [ -z "${HAPAX_ROOT_REQUIRED_ISOLATED_TEST_ROOT:-}" ] || isolated=1
    if ! [[ "$lock_fd" =~ ^[0-9]+$ ]] || [ "$lock_fd" -lt 3 ] \
        || ! [[ "$anchor_fd" =~ ^[0-9]+$ ]] || [ "$anchor_fd" -lt 3 ]; then
        echo "hapax-post-merge-deploy: safe shared lock descriptors are absent; next action: remove caller-supplied HAPAX_ROOT_REQUIRED_LOCK_* values and rerun the package-owned deploy script" >&2
        return 1
    fi
    /usr/bin/python3 -I -S - "$lock_fd" "$anchor_fd" "$ROOT_REQUIRED_LOCK_FILE" \
        "$ROOT_REQUIRED_LOCK_ANCHOR" "$isolated" <<'PY'
from __future__ import annotations

import fcntl
import os
import stat
import sys

fd = int(sys.argv[1])
anchor_fd = int(sys.argv[2])
lock_path = os.path.abspath(sys.argv[3])
anchor_path = os.path.abspath(sys.argv[4])
isolated = sys.argv[5] == "1"


def validate_anchor() -> None:
    try:
        inode = os.fstat(anchor_fd)
        path_inode = os.lstat(anchor_path)
        parent_path = os.path.dirname(anchor_path)
        parent_inode = os.lstat(parent_path)
    except OSError as exc:
        raise OSError(f"cannot inspect stable lock anchor: {exc}") from exc
    expected_anchor_uid = 0 if isolated else os.geteuid()
    if isolated and anchor_path != "/":
        raise OSError("isolated lock anchor must be the stable filesystem root")
    if (
        not stat.S_ISDIR(inode.st_mode)
        or not stat.S_ISDIR(path_inode.st_mode)
        or inode.st_uid != expected_anchor_uid
        or path_inode.st_uid != expected_anchor_uid
        or inode.st_mode & 0o022
        or path_inode.st_mode & 0o022
        or (inode.st_dev, inode.st_ino) != (path_inode.st_dev, path_inode.st_ino)
        or os.path.realpath(anchor_path) != anchor_path
    ):
        raise OSError("stable lock anchor is not a trusted caller-owned directory")
    if not isolated and (
        not stat.S_ISDIR(parent_inode.st_mode)
        or parent_inode.st_uid != 0
        or parent_inode.st_mode & 0o022
        or os.path.realpath(parent_path) != parent_path
    ):
        raise OSError("production lock anchor parent is replaceable by the caller")


try:
    validate_anchor()
    fcntl.flock(anchor_fd, fcntl.LOCK_EX)
    validate_anchor()
except OSError as exc:
    print(
        f"hapax-post-merge-deploy: refused unstable shared lock anchor {anchor_path}: {exc}",
        file=sys.stderr,
    )
    raise SystemExit(1) from exc

try:
    inode_before = os.fstat(fd)
    path_before = os.lstat(lock_path)
except OSError as exc:
    print(
        f"hapax-post-merge-deploy: refused invalid shared lock descriptor for {lock_path}: "
        f"{exc}; next action: remove caller-supplied HAPAX_ROOT_REQUIRED_LOCK_* values and rerun",
        file=sys.stderr,
    )
    raise SystemExit(1) from exc
if (
    not stat.S_ISREG(inode_before.st_mode)
    or not stat.S_ISREG(path_before.st_mode)
    or (inode_before.st_dev, inode_before.st_ino)
    != (path_before.st_dev, path_before.st_ino)
    or inode_before.st_uid != os.geteuid()
    or inode_before.st_nlink != 1
    or inode_before.st_mode & 0o022
):
    print(
        f"hapax-post-merge-deploy: refused invalid shared lock descriptor for {lock_path}; "
        "expected the caller-owned, single-link, non-group-writable regular path inode; "
        "next action: remove caller-supplied HAPAX_ROOT_REQUIRED_LOCK_* values and rerun",
        file=sys.stderr,
    )
    raise SystemExit(1)
os.fchmod(fd, 0o600)
fcntl.flock(fd, fcntl.LOCK_EX)
try:
    inode_after = os.fstat(fd)
    path_after = os.lstat(lock_path)
except OSError as exc:
    print(
        f"hapax-post-merge-deploy: shared lock identity changed while acquiring {lock_path}: {exc}",
        file=sys.stderr,
    )
    raise SystemExit(1) from exc
if (
    not stat.S_ISREG(inode_after.st_mode)
    or not stat.S_ISREG(path_after.st_mode)
    or inode_after.st_uid != os.geteuid()
    or path_after.st_uid != os.geteuid()
    or inode_after.st_nlink != 1
    or path_after.st_nlink != 1
    or inode_after.st_mode & 0o022
    or path_after.st_mode & 0o022
    or (inode_after.st_dev, inode_after.st_ino)
    != (path_after.st_dev, path_after.st_ino)
    or (inode_before.st_dev, inode_before.st_ino)
    != (inode_after.st_dev, inode_after.st_ino)
):
    print(
        f"hapax-post-merge-deploy: shared lock identity changed while acquiring {lock_path}",
        file=sys.stderr,
    )
    raise SystemExit(1)
PY
}

reexec_with_safe_root_required_lock() {
    if [ -n "${HAPAX_ROOT_REQUIRED_LOCK_FD:-}" ] \
        || [ -n "${HAPAX_ROOT_REQUIRED_LOCK_ANCHOR_FD:-}" ]; then
        acquire_inherited_root_required_lock
        return
    fi
    local isolated=0
    [ -z "${HAPAX_ROOT_REQUIRED_ISOLATED_TEST_ROOT:-}" ] || isolated=1
    exec /usr/bin/python3 -I -S - "$ROOT_REQUIRED_LOCK_ANCHOR" "$ROOT_REQUIRED_LOCK_FILE" \
        "$isolated" "$0" "${ORIGINAL_ARGS[@]}" <<'PY'
from __future__ import annotations

import fcntl
import os
import stat
import subprocess
import sys

anchor_path, lock_path, isolated_raw, script, *args = sys.argv[1:]
anchor_path = os.path.abspath(anchor_path)
lock_path = os.path.abspath(lock_path)
isolated = isolated_raw == "1"
os.makedirs(os.path.dirname(lock_path) or ".", exist_ok=True)


def validate_anchor(anchor_fd: int) -> None:
    inode = os.fstat(anchor_fd)
    path_inode = os.lstat(anchor_path)
    parent_path = os.path.dirname(anchor_path)
    parent_inode = os.lstat(parent_path)
    expected_anchor_uid = 0 if isolated else os.geteuid()
    if isolated and anchor_path != "/":
        raise OSError("isolated lock anchor must be the stable filesystem root")
    if (
        not stat.S_ISDIR(inode.st_mode)
        or not stat.S_ISDIR(path_inode.st_mode)
        or inode.st_uid != expected_anchor_uid
        or path_inode.st_uid != expected_anchor_uid
        or inode.st_mode & 0o022
        or path_inode.st_mode & 0o022
        or (inode.st_dev, inode.st_ino) != (path_inode.st_dev, path_inode.st_ino)
        or os.path.realpath(anchor_path) != anchor_path
    ):
        raise OSError("stable lock anchor is not a trusted caller-owned directory")
    if not isolated and (
        not stat.S_ISDIR(parent_inode.st_mode)
        or parent_inode.st_uid != 0
        or parent_inode.st_mode & 0o022
        or os.path.realpath(parent_path) != parent_path
    ):
        raise OSError("production lock anchor parent is replaceable by the caller")


try:
    anchor_fd = os.open(
        anchor_path,
        os.O_CLOEXEC | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_RDONLY,
    )
    validate_anchor(anchor_fd)
    fcntl.flock(anchor_fd, fcntl.LOCK_EX)
    validate_anchor(anchor_fd)
except OSError as exc:
    print(
        f"hapax-post-merge-deploy: refused unstable shared lock anchor {anchor_path}: {exc}",
        file=sys.stderr,
    )
    raise SystemExit(1) from exc
try:
    fd = os.open(
        lock_path,
        os.O_CLOEXEC | os.O_CREAT | os.O_NOFOLLOW | os.O_RDWR,
        0o600,
    )
except OSError as exc:
    print(
        f"hapax-post-merge-deploy: refused unsafe shared lock {lock_path}: {exc}; "
        "next action: remove only a confirmed symlink/non-regular lock and rerun",
        file=sys.stderr,
    )
    raise SystemExit(1) from exc
try:
    inode_before = os.fstat(fd)
    path_before = os.lstat(lock_path)
    if (
        not stat.S_ISREG(inode_before.st_mode)
        or not stat.S_ISREG(path_before.st_mode)
        or inode_before.st_uid != os.geteuid()
        or path_before.st_uid != os.geteuid()
        or inode_before.st_nlink != 1
        or path_before.st_nlink != 1
        or inode_before.st_mode & 0o022
        or path_before.st_mode & 0o022
        or (inode_before.st_dev, inode_before.st_ino)
        != (path_before.st_dev, path_before.st_ino)
    ):
        print(
            f"hapax-post-merge-deploy: refused unsafe shared lock inode {lock_path}; expected "
            "one caller-owned, single-link, non-group-writable regular file; next action: "
            "remove only a confirmed unsafe lock and rerun",
            file=sys.stderr,
        )
        raise SystemExit(1)
    os.fchmod(fd, 0o600)
    fcntl.flock(fd, fcntl.LOCK_EX)
    try:
        inode_after = os.fstat(fd)
        path_after = os.lstat(lock_path)
    except OSError as exc:
        print(
            f"hapax-post-merge-deploy: shared lock identity changed while acquiring {lock_path}: {exc}",
            file=sys.stderr,
        )
        raise SystemExit(1) from exc
    if (
        not stat.S_ISREG(inode_after.st_mode)
        or not stat.S_ISREG(path_after.st_mode)
        or inode_after.st_uid != os.geteuid()
        or path_after.st_uid != os.geteuid()
        or inode_after.st_nlink != 1
        or path_after.st_nlink != 1
        or inode_after.st_mode & 0o022
        or path_after.st_mode & 0o022
        or (inode_after.st_dev, inode_after.st_ino)
        != (path_after.st_dev, path_after.st_ino)
        or (inode_before.st_dev, inode_before.st_ino)
        != (inode_after.st_dev, inode_after.st_ino)
    ):
        print(
            f"hapax-post-merge-deploy: shared lock identity changed while acquiring {lock_path}",
            file=sys.stderr,
        )
        raise SystemExit(1)
    env = os.environ.copy()
    env.pop("HAPAX_ROOT_REQUIRED_LOCK_HELD", None)
    env["HAPAX_ROOT_REQUIRED_LOCK_FD"] = str(fd)
    env["HAPAX_ROOT_REQUIRED_LOCK_ANCHOR_FD"] = str(anchor_fd)
    env["HAPAX_ROOT_REQUIRED_LOCK_MODE"] = "exclusive"
    result = subprocess.run(
        [os.path.abspath(script), *args],
        env=env,
        pass_fds=(anchor_fd, fd),
        check=False,
    )
    raise SystemExit(result.returncode)
finally:
    os.close(fd)
    os.close(anchor_fd)
PY
}

read_last_deployed_sha_under_lock() {
    /usr/bin/python3 -I -S - "$LAST_DEPLOYED_SHA_PATH" <<'PY'
from __future__ import annotations

import os
import re
import stat
import sys

path = os.path.abspath(sys.argv[1])
try:
    path_before = os.lstat(path)
except FileNotFoundError:
    raise SystemExit(0)
except OSError as exc:
    print(
        f"hapax-post-merge-deploy: cannot inspect deploy cursor {path}: {exc}",
        file=sys.stderr,
    )
    raise SystemExit(1) from exc

mode = stat.S_IMODE(path_before.st_mode)
if (
    not stat.S_ISREG(path_before.st_mode)
    or path_before.st_uid != os.geteuid()
    or path_before.st_nlink != 1
    or mode & 0o133
    or path_before.st_size != 41
):
    print(
        f"hapax-post-merge-deploy: refused unsafe deploy cursor {path}; expected "
        "one caller-owned, single-link, non-executable regular file not writable by group/other containing one SHA",
        file=sys.stderr,
    )
    raise SystemExit(1)

fd = -1
try:
    fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    before = os.fstat(fd)
    if (before.st_dev, before.st_ino) != (path_before.st_dev, path_before.st_ino):
        raise OSError("cursor path changed before read")
    payload = os.read(fd, 42)
    if os.read(fd, 1):
        raise OSError("cursor exceeded its exact size")
    after = os.fstat(fd)
    path_after = os.lstat(path)
finally:
    if fd >= 0:
        os.close(fd)

def generation(value: os.stat_result) -> tuple[int, ...]:
    return (
        value.st_dev,
        value.st_ino,
        value.st_mode,
        value.st_uid,
        value.st_nlink,
        value.st_size,
        value.st_mtime_ns,
        value.st_ctime_ns,
    )

if generation(before) != generation(after) or generation(after) != generation(path_after):
    raise OSError("cursor generation changed during read")
try:
    value = payload.decode("ascii")
except UnicodeDecodeError as exc:
    raise OSError("cursor is not ASCII") from exc
if re.fullmatch(r"[0-9a-f]{40}\n", value) is None:
    raise OSError("cursor does not contain one canonical SHA")
print(value[:-1])
PY
}

admit_monotonic_deploy_target() {
    local current rc
    DEPLOY_CURSOR_SHA=""
    if ! current="$(read_last_deployed_sha_under_lock)"; then
        echo "hapax-post-merge-deploy: cannot establish a trusted deploy cursor before mutation" >&2
        return 1
    fi
    [ -n "$current" ] || return 0
    DEPLOY_CURSOR_SHA="$current"
    if ! git -C "$REPO" cat-file -e "$current^{commit}" 2>/dev/null; then
        echo "hapax-post-merge-deploy: deploy cursor references unavailable commit $current; next action: restore the latest governed cursor object before deploying" >&2
        return 1
    fi
    [ "$current" != "$SHA" ] || return 0
    if git -C "$REPO" merge-base --is-ancestor "$current" "$SHA"; then
        return 0
    else
        rc=$?
        if [ "$rc" -ne 1 ]; then
            echo "hapax-post-merge-deploy: failed to compare deploy cursor $current with candidate $SHA" >&2
            return 1
        fi
    fi
    if git -C "$REPO" merge-base --is-ancestor "$SHA" "$current"; then
        echo "hapax-post-merge-deploy: refusing stale deploy target $SHA because cursor $current already supersedes it; governed rollback requires a separate runtime-authorized path" >&2
        return 1
    else
        rc=$?
        if [ "$rc" -ne 1 ]; then
            echo "hapax-post-merge-deploy: failed to compare deploy candidate $SHA with cursor $current" >&2
            return 1
        fi
    fi
    echo "hapax-post-merge-deploy: refusing ancestry-divergent deploy target $SHA from cursor $current; next action: reconcile source history through a governed deploy" >&2
    return 1
}

# --- auto-enable marker (reform-improve-deploy-activation-20260601) ---
# A systemd unit may declare it wants to be enabled+started on deploy by
# carrying a `# Hapax-Auto-Enable: true` comment annotation (mirrors the
# `# Hapax-Install-Scope: system` convention). Without this, `try-restart`
# is a no-op for a never-enabled unit, so a freshly-merged timer/service
# installs but never starts — the systemic "merged but sleeping" gap behind
# the FM-11 lane supervisor. The marker is honoured ONLY when the unit also
# has an [Install] section (`systemctl enable` errors on a unit with none).
unit_content_auto_enable() {
    local content="$1"
    [ -n "$content" ] || return 1
    grep -Eiq '^[#;][[:space:]]*Hapax-Auto-Enable:[[:space:]]*(true|yes|1)[[:space:]]*$' <<< "$content" || return 1
    grep -Eq '^\[Install\]' <<< "$content" || return 1
    return 0
}

unit_content_timer_enable_only() {
    local content="$1"
    [ -n "$content" ] || return 1
    grep -Eiq '^[#;][[:space:]]*Hapax-Timer-Enable-Only:[[:space:]]*(true|yes|1)[[:space:]]*$' <<< "$content" || return 1
    grep -Eq '^\[Install\]' <<< "$content" || return 1
    return 0
}

unit_content_parked() {
    local content="$1"
    [ -n "$content" ] || return 1
    grep -Eiq '^[#;][[:space:]]*Hapax-Parked:[[:space:]]*(true|yes|1)[[:space:]]*$' <<< "$content"
}

# --verify-auto-enable: post-deploy assertion that every unit in the repo's
# systemd/units/ carrying `# Hapax-Auto-Enable: true` is actually `enabled`
# (and, for timers, `active`). Exits 0 if all marked units pass, 1 if any
# marked unit is not live. Lets the operator / smoke runner witness FM-11
# (and any future marked unit) is running, not merely installed. Reads the
# working tree, so it needs no commit SHA and runs before the trace/trap setup.
if [ "$VERIFY_AUTO_ENABLE" = "1" ]; then
    UNITS_DIR="$REPO/systemd/units"
    if [ ! -d "$UNITS_DIR" ]; then
        echo "verify-auto-enable: $UNITS_DIR not found" >&2
        exit 2
    fi
    verify_rc=0
    marked_count=0
    for uf in "$UNITS_DIR"/*.service "$UNITS_DIR"/*.timer "$UNITS_DIR"/*.path "$UNITS_DIR"/*.target; do
        [ -f "$uf" ] || continue
        unit_content_auto_enable "$(cat "$uf")" || continue
        unit_base="$(basename "$uf")"
        marked_count=$((marked_count + 1))
        if ! systemctl --user is-enabled "$unit_base" >/dev/null 2>&1; then
            echo "FAIL: $unit_base is marked Hapax-Auto-Enable but is not enabled" >&2
            verify_rc=1
            continue
        fi
        if [[ "$unit_base" == *.timer ]] \
            && ! systemctl --user is-active "$unit_base" >/dev/null 2>&1; then
            echo "FAIL: timer $unit_base is marked Hapax-Auto-Enable but is not active" >&2
            verify_rc=1
            continue
        fi
        if [[ "$unit_base" == *.timer ]]; then
            echo "ok: $unit_base enabled + active"
        else
            echo "ok: $unit_base enabled"
        fi
    done
    if [ "$marked_count" -eq 0 ]; then
        echo "verify-auto-enable: no Hapax-Auto-Enable units in $UNITS_DIR"
    elif [ "$verify_rc" -eq 0 ]; then
        echo "verify-auto-enable: all $marked_count marked unit(s) enabled/active"
    fi
    exit "$verify_rc"
fi

# --- deploy symlink drift assertion (fix-deploy-symlink-skew-20260602) ---
# Assert every ~/.local/bin/hapax-* deploy symlink resolves to the canonical
# origin/main-tracking deploy tree — NOT a dangling target (a deleted worktree
# or a leaked test tmpdir) nor a stale/foreign worktree checkout. This is the
# complement of rebuild-service.sh's check_post_merge_deploy_staleness: that
# alarm catches a STOPPED deploy chain (the last-deployed-sha receipt lags
# origin/main); this catches the failure the skew P0 actually hit — the
# symlinks silently point at a worktree that no longer carries the merged
# fixes, so the .service ran a script lacking --since and exited 2 while the
# receipt still looked healthy. ntfy (throttled per distinct drift signature)
# so the skew can't recur silently. Returns 1 on drift, 0 when intact.
#
# Only deploy-installed `scripts/hapax-*` symlinks are in scope: their target
# is `<root>/scripts/<name>` and the target basename matches the link name.
# A link to a different managed hapax-* script is still deploy drift; legacy
# aliases to non-hapax script names remain outside this check.
# Symlinks to non-worktree install dirs (e.g. hapax-hooks-doctor ->
# ~/.local/lib/hapax/hooks/...) or legacy aliases to non-hapax script names
# (e.g. hapax-request-decompose -> scripts/request-decompose) are not
# deploy-tree symlinks and are intentionally ignored. Env overrides isolate it for tests:
# HAPAX_LOCAL_BIN, HAPAX_DEPLOY_SYMLINK_ROOTS, HAPAX_DRIFT_STATE_DIR,
# HAPAX_DRIFT_NTFY (set 0 to suppress curl).
check_symlink_drift() {
    local bin="${HAPAX_LOCAL_BIN:-$LOCAL_BIN}"
    local state_dir="${HAPAX_DRIFT_STATE_DIR:-$HOME/.cache/hapax/deploy-symlink-drift}"
    # $REPO is canonical too: a deploy installs scripts/hapax-* symlinks pointing
    # at $REPO/scripts, so the tree this very deploy runs from is by definition a
    # valid target. In production $REPO is the source-activation/rebuild worktree
    # (already listed); in tests it isolates to the tmp repo so the deploy-end
    # self-check stays quiet instead of false-flagging the just-installed links.
    local roots="${HAPAX_DEPLOY_SYMLINK_ROOTS:-$REPO $HOME/.cache/hapax/source-activation/worktree $HOME/.cache/hapax/rebuild/worktree}"
    local origin_main
    origin_main="$(git -C "$REPO" rev-parse --verify --quiet origin/main 2>/dev/null || true)"

    local -a dangling=() offtree=()
    local link base target target_base root ok r
    for link in "$bin"/hapax-*; do
        # A literal (no-match) glob is not a symlink, so this also covers the
        # empty-dir case without nullglob.
        [ -L "$link" ] || continue
        base="$(basename "$link")"
        target="$(readlink "$link")"
        if [ ! -e "$link" ]; then
            dangling+=("$base -> $target")
            continue
        fi
        case "$target" in
            */scripts/*)
                target_base="$(basename "$target")"
                if [ "$target_base" != "$base" ]; then
                    case "$target_base" in
                        hapax-*)
                            offtree+=("$base -> $target (target name mismatch)")
                            ;;
                    esac
                    continue
                fi
                root="${target%/scripts/*}"
                ok=0
                for r in $roots; do
                    if [ "$root" = "$r" ]; then
                        ok=1
                        break
                    fi
                done
                if [ "$ok" -eq 0 ]; then
                    offtree+=("$base -> $target")
                fi
                ;;
        esac
    done

    # Informational SHA drift: the canonical deployed tree HEAD vs origin/main.
    # Persistent lag is the receipt alarm's domain (throttled there); we only
    # annotate the alert so the operator sees how far behind the tree is.
    local sa sa_head behind=""
    sa="$HOME/.cache/hapax/source-activation/worktree"
    sa_head="$(git -C "$sa" rev-parse --verify --quiet HEAD 2>/dev/null || true)"
    if [ -n "$origin_main" ] && [ -n "$sa_head" ] && [ "$sa_head" != "$origin_main" ] \
        && git -C "$REPO" merge-base --is-ancestor "$sa_head" "$origin_main" 2>/dev/null; then
        behind="$(git -C "$REPO" rev-list --count "$sa_head..$origin_main" 2>/dev/null || echo '?')"
    fi

    if [ "${#dangling[@]}" -eq 0 ] && [ "${#offtree[@]}" -eq 0 ]; then
        return 0
    fi

    local msg="deploy symlink drift in $bin:"
    if [ "${#dangling[@]}" -gt 0 ]; then
        msg="$msg ${#dangling[@]} dangling (${dangling[*]})"
    fi
    if [ "${#offtree[@]}" -gt 0 ]; then
        msg="$msg ${#offtree[@]} off-tree (${offtree[*]})"
    fi
    if [ -n "$behind" ]; then
        msg="$msg [deployed tree ${sa_head:0:8} is ${behind} behind origin/main ${origin_main:0:8}]"
    fi
    echo "hapax-post-merge-deploy: $msg" >&2

    # ntfy once per distinct drift signature so the operator is told once, not
    # every deploy cycle, until the set of broken symlinks changes.
    if [ "${HAPAX_DRIFT_NTFY:-1}" = "1" ]; then
        local sig notified_file
        sig="$(printf '%s\n' "${dangling[@]}" "${offtree[@]}" | sort | sha256sum | cut -d' ' -f1)"
        notified_file="$state_dir/drift-notified-sig"
        if [ "$(cat "$notified_file" 2>/dev/null || true)" != "$sig" ]; then
            curl -s -o /dev/null \
                -H "Title: deploy symlink drift" \
                -H "Priority: high" \
                -H "Tags: rotating_light" \
                -d "$msg — repoint via the fix-deploy-symlink-skew runbook: re-run systemd/scripts/install-units.sh + hapax-post-merge-deploy from the canonical origin/main worktree." \
                "${NTFY_BASE_URL:-http://localhost:8090}/hapax-build" 2>/dev/null || true
            # Governed incident record alongside the ntfy channel.
            "$(dirname "$(readlink -f "$0")")/hapax-alert" high "deploy symlink drift" "$msg" --tag deploy --record-only
            mkdir -p "$state_dir" 2>/dev/null || true
            printf '%s\n' "$sig" > "$notified_file" 2>/dev/null || true
        fi
    fi
    return 1
}

# --check-symlink-drift: standalone drift assertion (no commit SHA needed).
# Exits 1 on drift so a timer/.service or smoke run surfaces it; 0 when intact.
if [ "$CHECK_SYMLINK_DRIFT" = "1" ]; then
    if check_symlink_drift; then
        echo "check-symlink-drift: all hapax-* deploy symlinks resolve to the canonical tree"
        exit 0
    fi
    exit 1
fi

_trace_join() {
    local item
    for item in "$@"; do
        printf '%s\n' "$item"
    done
}

record_post_merge_trace() {
    local status="$1"
    local exit_code="${2:-0}"
    local cursor_path="${3:-}"
    local cursor_value="${4:-}"
    local -a recovery_bundle_trace
    recovery_bundle_trace=("${RECOVERY_BUNDLE[@]}")
    if [ "${RECOVERY_BUNDLE_SELF_HEAL:-0}" = "1" ]; then
        recovery_bundle_trace+=("self-heal:$RECOVERY_BUNDLE_DEST")
    fi

    HAPAX_TRACE_FILES="$CHANGED_FILES" \
    HAPAX_TRACE_PW="$(_trace_join "${PW[@]}")" \
    HAPAX_TRACE_HAPAX_CONF="$(_trace_join "${HAPAX_CONF[@]}")" \
    HAPAX_TRACE_WP="$(_trace_join "${WP[@]}")" \
    HAPAX_TRACE_WP_LUA="$(_trace_join "${WP_LUA[@]}")" \
    HAPAX_TRACE_SYSTEMD="$(_trace_join "${SYSTEMD[@]}")" \
    HAPAX_TRACE_SYSTEMD_SYSTEM="$(_trace_join "${SYSTEMD_SYSTEM[@]}")" \
    HAPAX_TRACE_SYSTEMD_DROPINS="$(_trace_join "${SYSTEMD_DROPINS[@]}")" \
    HAPAX_TRACE_SYSTEMD_SYSTEM_DROPINS="$(_trace_join "${SYSTEMD_SYSTEM_DROPINS[@]}")" \
    HAPAX_TRACE_SYSTEMD_RUNTIME_REPLAYED="$(_trace_join "${SYSTEMD_RUNTIME_REPLAYED[@]}")" \
    HAPAX_SYSTEMD_PENDING_ADD="$(_trace_join "${SYSTEMD_PENDING_ADD[@]}")" \
    HAPAX_SYSTEMD_PENDING_REMOVE="$(_trace_join "${SYSTEMD_PENDING_REMOVE[@]}")" \
    HAPAX_TRACE_OOM_CONTAINMENT="$(_trace_join "${OOM_CONTAINMENT[@]}")" \
    HAPAX_TRACE_RUNTIME_DEFERRED="$(_trace_join "${RUNTIME_DEFERRED[@]}")" \
    HAPAX_TRACE_APCUPSD_POWER_ALERTS="$(_trace_join "${APCUPSD_POWER_ALERTS[@]}")" \
    HAPAX_TRACE_USER_PRESETS="$(_trace_join "${USER_PRESETS[@]}")" \
    HAPAX_TRACE_WATCHDOGS="$(_trace_join "${WATCHDOGS[@]}")" \
    HAPAX_TRACE_RECOVERY_BUNDLE="$(_trace_join "${recovery_bundle_trace[@]}")" \
    HAPAX_TRACE_SCRIPTS="$(_trace_join "${SCRIPTS[@]}")" \
    HAPAX_TRACE_SCRIPT_PY="$(_trace_join "${SCRIPT_PY[@]}")" \
    HAPAX_TRACE_QUAKE_ASSETS="$(_trace_join "${QUAKE_ASSETS[@]}")" \
    HAPAX_TRACE_CANONICAL_GATE="$(_trace_join "${CANONICAL_GATE[@]}")" \
    HAPAX_TRACE_AUDIO_SAFE_RESTARTS="$(_trace_join "${AUDIO_SAFE_RESTARTS[@]}")" \
    HAPAX_TRACE_SYSTEMD_UNCLASSIFIED="$(_trace_join "${SYSTEMD_UNCLASSIFIED[@]}")" \
    /usr/bin/python3 -I -S - "$TRACE_PATH" "$TRACE_MAX_RECORDS" "$SHA" "$DRY_RUN" "$status" "$exit_code" \
        "$DID_ANYTHING" "$cursor_path" "$cursor_value" "$SYSTEMD_RUNTIME_PENDING_PATH" \
        "$SYSTEMD_PENDING_SNAPSHOT" <<'PY'
from __future__ import annotations

import fcntl
import hashlib
import json
import os
import re
import stat
import sys
import tempfile
from datetime import UTC, datetime
from pathlib import Path


def lines(name: str) -> list[str]:
    return [line for line in os.environ.get(name, "").splitlines() if line]


PENDING_PATH_RE = re.compile(
    r"^systemd/units/(?:"
    r"[A-Za-z0-9_.@:-]+\.(?:service|timer|path|slice|target)|"
    r"[A-Za-z0-9_.@:-]+\.(?:service|timer|slice|scope)\.d/"
    r"[A-Za-z0-9_.@:-]+\.conf)$"
)
MAX_PENDING_PATHS = 256
MAX_PENDING_BYTES = 128 * 1024


def validate_pending_paths(value: object) -> set[str]:
    if not isinstance(value, list) or len(value) > MAX_PENDING_PATHS:
        raise ValueError("pending systemd paths must be a bounded list")
    paths: set[str] = set()
    for item in value:
        if not isinstance(item, str) or PENDING_PATH_RE.fullmatch(item) is None:
            raise ValueError("pending systemd queue contains an unsafe source path")
        if item in paths:
            raise ValueError("pending systemd queue contains a duplicate source path")
        paths.add(item)
    return paths


def read_pending(path: Path) -> tuple[set[str], str]:
    if not os.path.lexists(path):
        return set(), "absent"
    read_fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        before = os.fstat(read_fd)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_uid != os.geteuid()
            or before.st_nlink != 1
            or before.st_mode & 0o077
            or before.st_size > MAX_PENDING_BYTES
        ):
            raise OSError(f"unsafe pending systemd queue inode: {path}")
        payload = bytearray()
        while True:
            chunk = os.read(read_fd, 65536)
            if not chunk:
                break
            payload.extend(chunk)
            if len(payload) > MAX_PENDING_BYTES:
                raise OSError("pending systemd queue exceeds the bounded size")
        after = os.fstat(read_fd)
        path_after = os.lstat(path)
    finally:
        os.close(read_fd)
    generation = lambda value: (
        value.st_dev,
        value.st_ino,
        value.st_size,
        value.st_mtime_ns,
        value.st_ctime_ns,
    )
    if generation(before) != generation(after) or generation(after) != generation(path_after):
        raise OSError("pending systemd queue changed during read")
    data = json.loads(payload)
    if not isinstance(data, dict) or set(data) != {"schema_version", "paths"}:
        raise ValueError("pending systemd queue has an unsupported schema")
    if data["schema_version"] != 1:
        raise ValueError("pending systemd queue has an unsupported schema version")
    return validate_pending_paths(data["paths"]), hashlib.sha256(payload).hexdigest()


def write_temp(parent: Path, name: str, payload: bytes) -> tuple[int, str]:
    fd, temp_path = tempfile.mkstemp(prefix=f".{name}.tmp.", dir=parent)
    try:
        os.fchmod(fd, 0o600)
        offset = 0
        while offset < len(payload):
            written = os.write(fd, payload[offset:])
            if written <= 0:
                raise OSError(f"short write while staging {name}")
            offset += written
        os.fsync(fd)
    except Exception:
        os.close(fd)
        try:
            os.unlink(temp_path)
        except FileNotFoundError:
            pass
        raise
    return fd, temp_path


def fsync_dir(parent: Path) -> None:
    dir_fd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        os.fsync(dir_fd)
    finally:
        os.close(dir_fd)


path = Path(sys.argv[1]).expanduser()
try:
    max_records = int(sys.argv[2])
except ValueError:
    max_records = 200
max_records = max(1, max_records)
sha = sys.argv[3]
dry_run = sys.argv[4] == "1"
status = sys.argv[5]
exit_code = int(sys.argv[6])
manual_deploy_executed = sys.argv[7] == "1"
cursor_path = sys.argv[8]
cursor_value = sys.argv[9]
pending_path = Path(sys.argv[10]).expanduser()
pending_snapshot = sys.argv[11]
if bool(cursor_path) != bool(cursor_value):
    print("hapax-post-merge-deploy: incomplete cursor publication request", file=sys.stderr)
    raise SystemExit(1)
if cursor_value and re.fullmatch(r"[0-9a-f]{40}", cursor_value) is None:
    print(
        f"hapax-post-merge-deploy: refused invalid SHA receipt value: {cursor_value!r}",
        file=sys.stderr,
    )
    raise SystemExit(1)

deploy_groups = {
    "pipewire": lines("HAPAX_TRACE_PW"),
    "hapax_runtime_config": lines("HAPAX_TRACE_HAPAX_CONF"),
    "wireplumber": lines("HAPAX_TRACE_WP"),
    "wireplumber_lua": lines("HAPAX_TRACE_WP_LUA"),
    "systemd_units": lines("HAPAX_TRACE_SYSTEMD"),
    "systemd_system_units": lines("HAPAX_TRACE_SYSTEMD_SYSTEM"),
    "systemd_dropins": lines("HAPAX_TRACE_SYSTEMD_DROPINS"),
    "systemd_system_dropins": lines("HAPAX_TRACE_SYSTEMD_SYSTEM_DROPINS"),
    "oom_containment": lines("HAPAX_TRACE_OOM_CONTAINMENT"),
    "apcupsd_power_alerts": lines("HAPAX_TRACE_APCUPSD_POWER_ALERTS"),
    "systemd_user_presets": lines("HAPAX_TRACE_USER_PRESETS"),
    "systemd_watchdogs": lines("HAPAX_TRACE_WATCHDOGS"),
    "recovery_bundle": lines("HAPAX_TRACE_RECOVERY_BUNDLE"),
    "hapax_scripts": lines("HAPAX_TRACE_SCRIPTS"),
    "unit_backing_scripts": lines("HAPAX_TRACE_SCRIPT_PY"),
    "quake_assets": lines("HAPAX_TRACE_QUAKE_ASSETS"),
    "canonical_gate_closure": lines("HAPAX_TRACE_CANONICAL_GATE"),
}
runtime_deferred = lines("HAPAX_TRACE_RUNTIME_DEFERRED")
runtime_media_groups = [
    name
    for name in (
        "pipewire",
        "hapax_runtime_config",
        "wireplumber",
        "wireplumber_lua",
        "systemd_units",
        "systemd_system_units",
        "systemd_dropins",
        "systemd_system_dropins",
        "apcupsd_power_alerts",
        "systemd_watchdogs",
        "recovery_bundle",
        "hapax_scripts",
        "unit_backing_scripts",
        "quake_assets",
        "canonical_gate_closure",
    )
    if deploy_groups[name]
]
record = {
    "schema_version": 1,
    "event": "post_merge_deploy",
    "timestamp": datetime.now(UTC).replace(microsecond=0).isoformat().replace("+00:00", "Z"),
    "sha": sha,
    "mode": "dry_run" if dry_run else "deploy",
    "status": status,
    "exit_code": exit_code,
    "changed_files": lines("HAPAX_TRACE_FILES"),
    "deploy_groups": deploy_groups,
    "manual_deploy_needed": any(deploy_groups.values()) or bool(runtime_deferred),
    "manual_deploy_executed": manual_deploy_executed,
    "runtime_deferred": runtime_deferred,
    "systemd_runtime_replayed": lines("HAPAX_TRACE_SYSTEMD_RUNTIME_REPLAYED"),
    "audio_safe_restart_units": lines("HAPAX_TRACE_AUDIO_SAFE_RESTARTS"),
    "systemd_unclassified": lines("HAPAX_TRACE_SYSTEMD_UNCLASSIFIED"),
    "avsdlc": {
        "gate_point": "S9 post-merge production witness",
        "runtime_media_witness_required": bool(runtime_media_groups),
        "runtime_media_witness_groups": runtime_media_groups,
    },
}

parent = path.parent
fd = -1
lock_fd = -1
temp_paths: list[str] = []
failure_surface = f"trace {path}"
try:
    parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    lock_path = parent / f".{path.name}.lock"
    lock_fd = os.open(
        lock_path,
        os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW,
        0o600,
    )
    lock_stat = os.fstat(lock_fd)
    if (
        not stat.S_ISREG(lock_stat.st_mode)
        or lock_stat.st_uid != os.geteuid()
        or lock_stat.st_nlink != 1
        or lock_stat.st_mode & 0o022
    ):
        raise OSError(f"unsafe trace lock inode: {lock_path}")
    os.fchmod(lock_fd, 0o600)
    fcntl.flock(lock_fd, fcntl.LOCK_EX)
    if pending_path.absolute() == path.absolute():
        raise ValueError("trace and pending-systemd queue paths must differ")
    current_pending, current_pending_digest = read_pending(pending_path)
    pending_add = validate_pending_paths(lines("HAPAX_SYSTEMD_PENDING_ADD"))
    pending_remove = validate_pending_paths(lines("HAPAX_SYSTEMD_PENDING_REMOVE"))
    if pending_add & pending_remove:
        raise ValueError("a systemd path cannot be both pending and converged")
    if cursor_path and current_pending_digest == pending_snapshot:
        next_pending = (current_pending | pending_add) - pending_remove
    elif cursor_path:
        # Another deploy changed the queue after this process loaded it. Keep
        # every concurrent item and suppress removals until the next replay.
        next_pending = current_pending | pending_add
    else:
        next_pending = current_pending
    if len(next_pending) > MAX_PENDING_PATHS:
        raise ValueError("pending systemd queue exceeds the bounded path count")
    previous: list[str] = []
    if os.path.lexists(path):
        read_fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
        try:
            if not stat.S_ISREG(os.fstat(read_fd).st_mode):
                raise OSError("existing trace is not a regular file")
            with os.fdopen(read_fd, "r", encoding="utf-8") as stream:
                read_fd = -1
                previous = [line for line in stream.read().splitlines() if line.strip()]
        finally:
            if read_fd >= 0:
                os.close(read_fd)
    previous.append(json.dumps(record, sort_keys=True))
    payload = ("\n".join(previous[-max_records:]) + "\n").encode("utf-8")
    fd, trace_temp = write_temp(parent, path.name, payload)
    temp_paths.append(trace_temp)
    os.close(fd)
    fd = -1
    pending_temp = ""
    cursor_temp = ""
    if cursor_path:
        cursor = Path(cursor_path).expanduser()
        cursor_parent = cursor.parent
        if cursor.absolute() in {path.absolute(), pending_path.absolute()}:
            raise ValueError("trace, queue, and cursor paths must be distinct")
        pending_parent = pending_path.parent
        pending_parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        cursor_parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        if next_pending:
            failure_surface = f"pending systemd queue {pending_path}"
            pending_payload = (
                json.dumps(
                    {"schema_version": 1, "paths": sorted(next_pending)},
                    sort_keys=True,
                    separators=(",", ":"),
                )
                + "\n"
            ).encode("utf-8")
            fd, pending_temp = write_temp(pending_parent, pending_path.name, pending_payload)
            temp_paths.append(pending_temp)
            os.close(fd)
            fd = -1
        failure_surface = f"last-deployed SHA {cursor}"
        cursor_payload = f"{cursor_value}\n".encode("ascii")
        fd, cursor_temp = write_temp(cursor_parent, cursor.name, cursor_payload)
        temp_paths.append(cursor_temp)
        os.close(fd)
        fd = -1
    failure_surface = f"trace {path}"
    os.replace(trace_temp, path)
    temp_paths.remove(trace_temp)
    fsync_dir(parent)
    if cursor_path:
        failure_surface = f"pending systemd queue {pending_path}"
        if next_pending:
            os.replace(pending_temp, pending_path)
            temp_paths.remove(pending_temp)
        elif os.path.lexists(pending_path):
            os.unlink(pending_path)
        fsync_dir(pending_path.parent)
        failure_surface = f"last-deployed SHA {cursor}"
        os.replace(cursor_temp, cursor)
        temp_paths.remove(cursor_temp)
        fsync_dir(cursor_parent)
    os.close(lock_fd)
    lock_fd = -1
except (OSError, UnicodeError, ValueError) as exc:
    if fd >= 0:
        os.close(fd)
    if lock_fd >= 0:
        os.close(lock_fd)
    for temp_path in temp_paths:
        try:
            os.unlink(temp_path)
        except FileNotFoundError:
            pass
    print(f"hapax-post-merge-deploy: failed to publish {failure_surface}: {exc}", file=sys.stderr)
    raise SystemExit(1) from exc
PY
}

trace_on_exit() {
    local rc=$?
    if [ "$REPORT_COVERAGE" != "1" ] \
        && [ "$TRACE_READY" = "1" ] \
        && [ "$TRACE_WRITTEN" != "1" ]; then
        if [ "$DRY_RUN" = "1" ]; then
            record_post_merge_trace "dry_run_failed" "$rc" || true
        elif [ "$rc" -ne 0 ]; then
            record_post_merge_trace "failed" "$rc" || true
        fi
    fi
}

trap trace_on_exit EXIT

# Record the SHA this deploy cycle ran against (real-deploy modes only). The
# staleness alarm + the AC `rev-list <last-deployed-sha>..origin/main` read it;
# the .service edge-trigger reads it to compute the cumulative --since range.
atomic_write_sha_receipt() {
    local path="$1" value="$2"
    /usr/bin/python3 -I -S - "$path" "$value" <<'PY'
from __future__ import annotations

import os
import re
import sys
import tempfile

path = os.path.abspath(sys.argv[1])
value = sys.argv[2]
if re.fullmatch(r"[0-9a-f]{40}", value) is None:
    print(f"hapax-post-merge-deploy: refused invalid SHA receipt value: {value!r}", file=sys.stderr)
    raise SystemExit(1)

parent = os.path.dirname(path)
fd = -1
temp_path = ""
try:
    os.makedirs(parent, mode=0o700, exist_ok=True)
    fd, temp_path = tempfile.mkstemp(prefix=f".{os.path.basename(path)}.tmp.", dir=parent)
    os.fchmod(fd, 0o600)
    payload = f"{value}\n".encode("ascii")
    offset = 0
    while offset < len(payload):
        written = os.write(fd, payload[offset:])
        if written <= 0:
            raise OSError("short write while publishing SHA receipt")
        offset += written
    os.fsync(fd)
    os.close(fd)
    fd = -1
    os.replace(temp_path, path)
    temp_path = ""
    dir_fd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(dir_fd)
    finally:
        os.close(dir_fd)
except (OSError, ValueError) as exc:
    if fd >= 0:
        os.close(fd)
    if temp_path:
        try:
            os.unlink(temp_path)
        except FileNotFoundError:
            pass
    print(f"hapax-post-merge-deploy: failed to publish SHA receipt {path}: {exc}", file=sys.stderr)
    raise SystemExit(1) from exc
PY
}

finalize_deploy_receipts() {
    local status="$1"
    local cursor_path="" cursor_value=""
    if [ "$DRY_RUN" != "1" ] && [ "$REPORT_COVERAGE" != "1" ] && [ -n "$SHA" ]; then
        cursor_path="$LAST_DEPLOYED_SHA_PATH"
        cursor_value="$SHA"
    fi
    if ! record_post_merge_trace \
        "$status" "0" "$cursor_path" "$cursor_value"; then
        echo "hapax-post-merge-deploy: failed to publish completion trace and last-deployed SHA transaction" >&2
        return 1
    fi
    TRACE_WRITTEN=1
}

load_systemd_runtime_pending() {
    /usr/bin/python3 -I -S - "$SYSTEMD_RUNTIME_PENDING_PATH" <<'PY'
from __future__ import annotations

import hashlib
import json
import os
import re
import stat
import sys
from pathlib import Path


path = Path(sys.argv[1]).expanduser()
path_re = re.compile(
    r"^systemd/units/(?:"
    r"[A-Za-z0-9_.@:-]+\.(?:service|timer|path|slice|target)|"
    r"[A-Za-z0-9_.@:-]+\.(?:service|timer|slice|scope)\.d/"
    r"[A-Za-z0-9_.@:-]+\.conf)$"
)
if not os.path.lexists(path):
    print("absent")
    raise SystemExit(0)

fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
try:
    before = os.fstat(fd)
    if (
        not stat.S_ISREG(before.st_mode)
        or before.st_uid != os.geteuid()
        or before.st_nlink != 1
        or before.st_mode & 0o077
        or before.st_size > 128 * 1024
    ):
        raise OSError(f"unsafe pending systemd queue inode: {path}")
    payload = bytearray()
    while True:
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        payload.extend(chunk)
        if len(payload) > 128 * 1024:
            raise OSError("pending systemd queue exceeds the bounded size")
    after = os.fstat(fd)
    path_after = os.lstat(path)
finally:
    os.close(fd)

generation = lambda value: (
    value.st_dev,
    value.st_ino,
    value.st_size,
    value.st_mtime_ns,
    value.st_ctime_ns,
)
if generation(before) != generation(after) or generation(after) != generation(path_after):
    raise OSError("pending systemd queue changed during read")
data = json.loads(payload)
if not isinstance(data, dict) or set(data) != {"schema_version", "paths"}:
    raise ValueError("pending systemd queue has an unsupported schema")
if data["schema_version"] != 1:
    raise ValueError("pending systemd queue has an unsupported schema version")
paths = data["paths"]
if not isinstance(paths, list) or len(paths) > 256:
    raise ValueError("pending systemd paths must be a bounded list")
seen: set[str] = set()
for item in paths:
    if not isinstance(item, str) or path_re.fullmatch(item) is None:
        raise ValueError("pending systemd queue contains an unsafe source path")
    if item in seen:
        raise ValueError("pending systemd queue contains a duplicate source path")
    seen.add(item)
print(hashlib.sha256(payload).hexdigest())
for item in sorted(seen):
    print(item)
PY
}

if [ "$COVERAGE_FROM_STDIN" != "1" ] \
    && [ "$DRY_RUN" != "1" ] \
    && [ "$REPORT_COVERAGE" != "1" ]; then
    configure_root_required_state_domain
fi

cd "$REPO"
# Ensure the commit's objects are available locally even if main hasn't been
# pulled yet; diffing an unfetched SHA would fail and falsely signal
# "file deleted" to the per-file branches below.
if [ "$COVERAGE_FROM_STDIN" != "1" ]; then
    git fetch --quiet origin main 2>/dev/null || true
    if [[ "$SHA" == *..* ]]; then
        echo "hapax-post-merge-deploy: expected a single commit SHA/ref, got range '$SHA'" >&2
        exit 2
    fi
    if ! SHA_RESOLVED="$(git rev-parse --verify --quiet "$SHA^{commit}")"; then
        echo "hapax-post-merge-deploy: '$SHA' is not a valid commit" >&2
        exit 2
    fi
    SHA="$SHA_RESOLVED"
fi

if [ -n "$SINCE" ]; then
    if ! SINCE_RESOLVED="$(git rev-parse --verify --quiet "$SINCE^{commit}")"; then
        echo "hapax-post-merge-deploy: --since '$SINCE' is not a valid commit" >&2
        exit 2
    fi
    SINCE="$SINCE_RESOLVED"
fi

if [ "$COVERAGE_FROM_STDIN" != "1" ] \
    && [ "$DRY_RUN" != "1" ] \
    && [ "$REPORT_COVERAGE" != "1" ]; then
    reexec_with_safe_root_required_lock
    admit_monotonic_deploy_target
    if [ -n "$DEPLOY_CURSOR_SHA" ] && [ "$DEPLOY_CURSOR_SHA" != "$SHA" ]; then
        if [ -n "$SINCE" ] && [ "$SINCE" != "$DEPLOY_CURSOR_SHA" ]; then
            echo "hapax-post-merge-deploy: --since $SINCE does not match trusted deploy cursor $DEPLOY_CURSOR_SHA; refusing to skip an undeployed commit range" >&2
            exit 2
        fi
        SINCE="$DEPLOY_CURSOR_SHA"
    fi
fi

if [ -n "$SINCE" ]; then
    if git merge-base --is-ancestor "$SINCE" "$SHA"; then
        :
    else
        since_ancestor_rc=$?
        if [ "$since_ancestor_rc" -eq 1 ]; then
            echo "hapax-post-merge-deploy: --since $SINCE is not an ancestor of deploy target $SHA" >&2
        else
            echo "hapax-post-merge-deploy: failed to compare --since $SINCE with deploy target $SHA" >&2
        fi
        exit 2
    fi
fi

if [ "$COVERAGE_FROM_STDIN" = "1" ]; then
    FILES="$(cat)"
elif [ -n "$SINCE" ]; then
    # Cumulative range deploy: union of every file changed across <since>..<SHA>.
    FILES="$(git diff --name-only "$SINCE" "$SHA" | sort -u)"
elif FIRST_PARENT="$(git rev-parse --verify --quiet "$SHA^1")"; then
    FILES="$(git diff --name-only "$FIRST_PARENT" "$SHA" | sort -u)"
else
    FILES="$(git diff-tree --root --no-commit-id --name-only -r "$SHA" | sort -u)"
fi

CHANGED_FILES="$FILES"
SYSTEMD_PENDING_PRIOR=()
SYSTEMD_RUNTIME_REPLAYED=()
SYSTEMD_PENDING_ADD=()
SYSTEMD_PENDING_REMOVE=()
declare -A SYSTEMD_PENDING_PRIOR_SET=()
declare -A CHANGED_FILE_SET=()
if [ "$REPORT_COVERAGE" != "1" ]; then
    if ! pending_output="$(load_systemd_runtime_pending)"; then
        echo "hapax-post-merge-deploy: failed to load the pending systemd runtime queue; refusing to advance the deploy cursor" >&2
        exit 2
    fi
    mapfile -t pending_lines <<< "$pending_output"
    SYSTEMD_PENDING_SNAPSHOT="${pending_lines[0]:-}"
    if ! [[ "$SYSTEMD_PENDING_SNAPSHOT" =~ ^(absent|[0-9a-f]{64})$ ]]; then
        echo "hapax-post-merge-deploy: malformed pending systemd queue snapshot" >&2
        exit 2
    fi
    for ((pending_index = 1; pending_index < ${#pending_lines[@]}; pending_index++)); do
        pending_path="${pending_lines[$pending_index]}"
        SYSTEMD_PENDING_PRIOR+=("$pending_path")
        SYSTEMD_PENDING_PRIOR_SET["$pending_path"]=1
    done
    while IFS= read -r changed_path; do
        [ -n "$changed_path" ] || continue
        CHANGED_FILE_SET["$changed_path"]=1
    done <<< "$CHANGED_FILES"
    for pending_path in "${SYSTEMD_PENDING_PRIOR[@]}"; do
        if [ -z "${CHANGED_FILE_SET[$pending_path]+present}" ]; then
            SYSTEMD_RUNTIME_REPLAYED+=("$pending_path")
        fi
    done
    if [ "${#SYSTEMD_PENDING_PRIOR[@]}" -gt 0 ]; then
        FILES="$({ printf '%s\n' "$FILES"; printf '%s\n' "${SYSTEMD_PENDING_PRIOR[@]}"; } | sed '/^$/d' | sort -u)"
    fi
fi

PW=(); HAPAX_CONF=(); WP=(); WP_LUA=(); SYSTEMD=(); SYSTEMD_SYSTEM=(); SYSTEMD_DROPINS=(); SYSTEMD_SYSTEM_DROPINS=(); SYSTEMD_PENDING_USER_UNITS=(); SYSTEMD_PENDING_USER_DROPINS=(); OOM_CONTAINMENT=(); APCUPSD_POWER_ALERTS=(); USER_PRESETS=(); WATCHDOGS=(); RECOVERY_BUNDLE=(); SCRIPTS=(); SCRIPT_PY=(); QUAKE_ASSETS=(); CANONICAL_GATE=(); RUNTIME_DEFERRED=()
declare -A OOM_PACKAGE_PATHS=()
declare -A APCUPSD_PACKAGE_PATHS=()
GATE_CLOSURE=()
# Must stay a superset of hooks-doctor's CLOSURE_SIBLINGS (+ the impl):
# deploy_canonical REFUSES an incomplete staged closure, so a missing sibling
# here would make every drift redeploy fail (and, under set -e, kill the
# whole post-merge deploy) until the drift resolved itself.
