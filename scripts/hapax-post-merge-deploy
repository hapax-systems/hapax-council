root_required_manifest_path_is_safe() {
    local rel="$1"
    if [[ "$rel" =~ [[:space:]] ]]; then
        return 1
    fi
    case "$rel" in
        ""|/*|*\\*|*//*|.|..|./*|../*|*/./*|*/../*|*/.|*/..)
            return 1
            ;;
    esac
    return 0
}

load_root_required_manifest_paths() {
    local manifest="$1" revision="$2" target_name="$3"
    local content="" entry="" mode="" type="" rel="" extra="" line=""
    local -n target="$target_name"
    local -A seen=()
    if [ "$COVERAGE_FROM_STDIN" = "1" ]; then
        [ -f "$REPO/$manifest" ] || return 0
        if ! content="$(cat "$REPO/$manifest")"; then
            echo "hapax-post-merge-deploy: failed to read source coverage manifest $manifest" >&2
            return 2
        fi
    else
        if ! entry="$(git -C "$REPO" ls-tree "$revision" -- "$manifest")"; then
            echo "hapax-post-merge-deploy: failed to inspect root-required manifest $revision:$manifest; refusing package classification" >&2
            return 2
        fi
        [ -n "$entry" ] || return 0
        if [[ "$entry" == *$'\n'* ]]; then
            echo "hapax-post-merge-deploy: ambiguous root-required manifest entry $revision:$manifest; refusing package classification" >&2
            return 2
        fi
        read -r mode type _ <<< "$entry"
        if [[ "$mode" != 100644 && "$mode" != 100755 ]] || [ "$type" != blob ]; then
            echo "hapax-post-merge-deploy: root-required manifest is not a regular Git blob at $revision:$manifest; refusing package classification" >&2
            return 2
        fi
        if ! content="$(git -C "$REPO" show "$revision:$manifest")"; then
            echo "hapax-post-merge-deploy: failed to read root-required manifest $revision:$manifest; refusing package classification" >&2
            return 2
        fi
    fi
    while IFS= read -r line; do
        rel=""
        extra=""
        read -r rel extra <<< "$line" || true
        [ -n "$rel" ] || continue
        [[ "$rel" == \#* ]] && continue
        if [ -n "$extra" ] || ! root_required_manifest_path_is_safe "$rel"; then
            echo "hapax-post-merge-deploy: malformed root-required manifest entry in $manifest: $line" >&2
            return 2
        fi
        if [ -n "${seen[$rel]+present}" ]; then
            echo "hapax-post-merge-deploy: duplicate root-required manifest path in $manifest: $rel" >&2
            return 2
        fi
        seen["$rel"]=1
        target["$rel"]=1
    done <<< "$content"
}

load_root_required_package_paths() {
    local base_ref=""
    load_root_required_manifest_paths \
        config/root-required/oom-containment.files "$SHA" OOM_PACKAGE_PATHS
    load_root_required_manifest_paths \
        config/root-required/apcupsd-power-alerts.files "$SHA" APCUPSD_PACKAGE_PATHS
    [ "$COVERAGE_FROM_STDIN" = "1" ] && return 0
    if [ -n "$SINCE" ]; then
        base_ref="$SINCE"
    else
        base_ref="$(git -C "$REPO" rev-parse --verify --quiet "$SHA^1" 2>/dev/null || true)"
    fi
    [ -n "$base_ref" ] || return 0
    # Include the old manifest so removals still trigger their owning package.
    load_root_required_manifest_paths \
        config/root-required/oom-containment.files "$base_ref" OOM_PACKAGE_PATHS
    load_root_required_manifest_paths \
        config/root-required/apcupsd-power-alerts.files "$base_ref" APCUPSD_PACKAGE_PATHS
}

load_root_required_package_paths

GIT_BLOB_PRESENT=0
GIT_BLOB_MODE=""
GIT_BLOB_OID=""
git_blob_state_at() {
    local revision="$1" path="$2" label="$3"
    local entry mode type object_and_path oid tree_path
    GIT_BLOB_PRESENT=0
    GIT_BLOB_MODE=""
    GIT_BLOB_OID=""
    if ! entry="$(git -C "$REPO" ls-tree "$revision" -- "$path")"; then
        echo "hapax-post-merge-deploy: failed to inspect $label Git entry at $revision:$path; refusing to infer deletion" >&2
        return 1
    fi
    if [ -z "$entry" ]; then
        return 0
    fi
    if [[ "$entry" == *$'\n'* ]]; then
        echo "hapax-post-merge-deploy: ambiguous $label Git entry at $revision:$path" >&2
        return 1
    fi
    read -r mode type object_and_path <<< "$entry"
    if [[ "$object_and_path" != *$'\t'* ]]; then
        echo "hapax-post-merge-deploy: malformed $label Git entry at $revision:$path" >&2
        return 1
    fi
    oid="${object_and_path%%$'\t'*}"
    tree_path="${object_and_path#*$'\t'}"
    if [[ "$mode" != 100644 && "$mode" != 100755 ]] \
        || [ "$type" != "blob" ] \
        || ! [[ "$oid" =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]] \
        || [ "$tree_path" != "$path" ]; then
        echo "hapax-post-merge-deploy: unsupported $label Git entry at $revision:$path; expected one regular blob at the exact path" >&2
        return 1
    fi
    GIT_BLOB_PRESENT=1
    GIT_BLOB_MODE="$mode"
    GIT_BLOB_OID="$oid"
}

UNIT_INSTALL_SCOPE=""
unit_install_scope() {
    local f="$1" allow_absent="${2:-0}" pending_owner="${3:-$1}"
    UNIT_INSTALL_SCOPE=""
    if [ "$COVERAGE_FROM_STDIN" = "1" ]; then
        UNIT_INSTALL_SCOPE="user"
        return 0
    fi
    local revision="$SHA" content base_ref prior_content
    local prior_scope_marker_count prior_system_marker_count
    if ! git_blob_state_at "$revision" "$f" "systemd unit"; then
        return 1
    fi
    if [ "$GIT_BLOB_PRESENT" -eq 0 ]; then
        base_ref="${SINCE:-${FIRST_PARENT:-}}"
        if [ -z "$base_ref" ]; then
            if [ -n "${SYSTEMD_PENDING_PRIOR_SET[$pending_owner]+present}" ]; then
                UNIT_INSTALL_SCOPE="system"
                return 0
            fi
            if [ "$allow_absent" = "1" ]; then
                UNIT_INSTALL_SCOPE="user"
                return 0
            fi
            echo "hapax-post-merge-deploy: changed systemd unit is absent at $SHA:$f and has no base commit for install-scope classification" >&2
            return 1
        fi
        revision="$base_ref"
        if ! git_blob_state_at "$revision" "$f" "prior systemd unit"; then
            return 1
        fi
        if [ "$GIT_BLOB_PRESENT" -eq 0 ]; then
            if [ -n "${SYSTEMD_PENDING_PRIOR_SET[$pending_owner]+present}" ]; then
                UNIT_INSTALL_SCOPE="system"
                return 0
            fi
            if [ "$allow_absent" = "1" ]; then
                UNIT_INSTALL_SCOPE="user"
                return 0
            fi
            echo "hapax-post-merge-deploy: changed systemd unit is absent from both classification revisions: $f" >&2
            return 1
        fi
    fi
    if ! content="$(git -C "$REPO" show "$revision:$f")"; then
        echo "hapax-post-merge-deploy: failed to read systemd unit while classifying install scope at $revision:$f" >&2
        return 1
    fi
    local scope_marker_count system_marker_count
    scope_marker_count="$(
        grep -Eic '^[[:blank:]]*[#;][[:blank:]]*Hapax-Install-Scope[[:blank:]]*:' <<< "$content" || true
    )"
    system_marker_count="$(
        grep -Eic '^[[:blank:]]*[#;][[:blank:]]*Hapax-Install-Scope[[:blank:]]*:[[:blank:]]*system[[:blank:]]*$' <<< "$content" || true
    )"
    if [ "$scope_marker_count" -eq 0 ]; then
        UNIT_INSTALL_SCOPE="user"
    elif [ "$scope_marker_count" -eq 1 ] && [ "$system_marker_count" -eq 1 ]; then
        UNIT_INSTALL_SCOPE="system"
    else
        echo "hapax-post-merge-deploy: malformed Hapax-Install-Scope marker at $revision:$f (duplicate or unsupported value)" >&2
        return 1
    fi
    if [ "$UNIT_INSTALL_SCOPE" = "user" ] && [ "$revision" = "$SHA" ]; then
        base_ref="${SINCE:-${FIRST_PARENT:-}}"
        if [ -n "$base_ref" ]; then
            if ! git_blob_state_at "$base_ref" "$f" "prior systemd unit"; then
                return 1
            fi
            if [ "$GIT_BLOB_PRESENT" -eq 1 ]; then
                if ! prior_content="$(git -C "$REPO" show "$base_ref:$f")"; then
                    echo "hapax-post-merge-deploy: failed to read prior systemd unit while classifying install-scope transition at $base_ref:$f" >&2
                    return 1
                fi
                prior_scope_marker_count="$(
                    grep -Eic '^[[:blank:]]*[#;][[:blank:]]*Hapax-Install-Scope[[:blank:]]*:' <<< "$prior_content" || true
                )"
                prior_system_marker_count="$(
                    grep -Eic '^[[:blank:]]*[#;][[:blank:]]*Hapax-Install-Scope[[:blank:]]*:[[:blank:]]*system[[:blank:]]*$' <<< "$prior_content" || true
                )"
                if [ "$prior_scope_marker_count" -eq 1 ] \
                    && [ "$prior_system_marker_count" -eq 1 ]; then
                    UNIT_INSTALL_SCOPE="transition"
                elif [ "$prior_scope_marker_count" -ne 0 ]; then
                    echo "hapax-post-merge-deploy: malformed prior Hapax-Install-Scope marker at $base_ref:$f" >&2
                    return 1
                fi
            fi
        fi
    fi
}

AUDIO_SAFE_RESTART_UNITS=(
    hapax-broadcast-orchestrator.service
    hapax-music-player.service
    hapax-content-resolver.service
    hapax-audio-router.service
    hapax-audio-ducker.service
    hapax-lufs-panic-cap.service
    hapax-usb-router.service
    hapax-daimonion.service
)

is_audio_safe_restart_unit() {
    local unit="$1"
    local candidate
    for candidate in "${AUDIO_SAFE_RESTART_UNITS[@]}"; do
        if [[ "$candidate" == "$unit" ]]; then
            return 0
        fi
    done
    return 1
}

remove_unversioned_user_dropins_for_unit() {
    local unit="$1"
    local dropin_dir="$SYSTEMD_USER_DIR/$unit.d"
    local dropin base
    [ -d "$dropin_dir" ] || return 0
    for dropin in "$dropin_dir"/*.conf; do
        [ -f "$dropin" ] || continue
        base="$(basename "$dropin")"
        if git -C "$REPO" cat-file -e "$SHA:systemd/units/$unit.d/$base" 2>/dev/null; then
            continue
        fi
        echo "  removing unversioned local drop-in '$dropin'"
        rm -f "$dropin" || true
    done
    rmdir "$dropin_dir" 2>/dev/null || true
}

cleanup_known_stale_user_dropins_for_unit() {
    local unit="$1"
    local dropin_dir dropin
    case "$unit" in
        hapax-audio-safety.service)
            dropin_dir="$SYSTEMD_RUNTIME_USER_DIR/$unit.d"
            [ -d "$dropin_dir" ] || return 0
            for dropin in "$dropin_dir"/*.conf; do
                [ -f "$dropin" ] || continue
                if [[ "$(basename "$dropin")" == "deploy-4051.conf" ]]; then
                    echo "  removing runtime-only deploy drop-in '$dropin'"
                    rm -f "$dropin" || true
                fi
            done
            rmdir "$dropin_dir" 2>/dev/null || true
            ;;
        hapax-daimonion.service)
            # Persistent sweep FIRST: the runtime dir is ephemeral (absent
            # after any reboot) and must never short-circuit it (#4090-1).
            remove_unversioned_user_dropins_for_unit "$unit"
            dropin_dir="$SYSTEMD_RUNTIME_USER_DIR/$unit.d"
            [ -d "$dropin_dir" ] || return 0
            for dropin in "$dropin_dir"/*.conf; do
                [ -f "$dropin" ] || continue
                if [[ "$(basename "$dropin")" == "deploy-4052.conf" ]]; then
                    echo "  removing runtime-only deploy drop-in '$dropin'"
                    rm -f "$dropin" || true
                fi
            done
            rmdir "$dropin_dir" 2>/dev/null || true
            ;;
        hapax-audio-routing-check.service)
            dropin_dir="$SYSTEMD_USER_DIR/$unit.d"
            [ -d "$dropin_dir" ] || return 0
            for dropin in "$dropin_dir"/*.conf; do
                [ -f "$dropin" ] || continue
                if [[ "$(basename "$dropin")" == "99-chain13-source-artifacts.conf" ]]; then
                    echo "  removing redundant local drop-in '$dropin'"
                    rm -f "$dropin" || true
                fi
            done
            rmdir "$dropin_dir" 2>/dev/null || true
            ;;
        hapax-obs-audio-bind.service)
            dropin_dir="$SYSTEMD_USER_DIR/$unit.d"
            [ -d "$dropin_dir" ] || return 0
            for dropin in "$dropin_dir"/*.conf; do
                [ -f "$dropin" ] || continue
                if grep -Eq 'hapax-council--codex-audio-l12' "$dropin"; then
                    echo "  removing stale local drop-in '$dropin'"
                    rm -f "$dropin" || true
                fi
            done
            rmdir "$dropin_dir" 2>/dev/null || true
            ;;
        hapax-screwm-audio-reactivity.service)
            dropin_dir="$SYSTEMD_USER_DIR/$unit.d"
            [ -d "$dropin_dir" ] || return 0
            for dropin in "$dropin_dir"/*.conf; do
                [ -f "$dropin" ] || continue
                if grep -Eq 'HAPAX_SCREWM_AUDIO_TARGET=hapax-broadcast-normalized-capture' "$dropin"; then
                    echo "  removing stale local drop-in '$dropin'"
                    rm -f "$dropin" || true
                fi
            done
            rmdir "$dropin_dir" 2>/dev/null || true
            ;;
        hapax-cc-task-offer-ready.service|hapax-imagination.service|hapax-reverie.service|\
        hapax-darkplaces-v4l2.service|hapax-segment-prep.service|logos-api.service)
            remove_unversioned_user_dropins_for_unit "$unit"
            ;;
    esac
}

audio_safe_restart_bin() {
    if [[ -n "${HAPAX_AUDIO_SAFE_RESTART_BIN:-}" ]]; then
        printf '%s\n' "$HAPAX_AUDIO_SAFE_RESTART_BIN"
        return 0
    fi
    if [[ -x "$REPO/scripts/hapax-audio-safe-restart" ]]; then
        printf '%s\n' "$REPO/scripts/hapax-audio-safe-restart"
        return 0
    fi
    local candidate
    if candidate="$(command -v hapax-audio-safe-restart 2>/dev/null)" \
        && [[ -x "$candidate" ]]; then
        printf '%s\n' "$candidate"
        return 0
    fi
    return 1
}

restart_user_unit() {
    local unit="$1"
    if is_audio_safe_restart_unit "$unit"; then
        local safe_bin
        if ! safe_bin="$(audio_safe_restart_bin)"; then
            echo "hapax-post-merge-deploy: refusing plain restart for audio-touching unit $unit; hapax-audio-safe-restart not found" >&2
            return 4
        fi
        echo "audio-safe restarting $unit"
        set +e
        "$safe_bin" "$unit"
        local safe_rc=$?
        set -e
        AUDIO_SAFE_RESTARTS+=("$unit")
        if [[ "$safe_rc" -eq 0 ]]; then
            return 0
        fi
        if [[ "$safe_rc" -eq 1 ]]; then
            echo "hapax-post-merge-deploy: audio-safe restart rolled back $unit successfully" >&2
            return 0
        fi
        # safe_rc >= 2: the audio-safe restart failed AND its rollback did not
        # cleanly succeed. This is the expected outcome when the audio golden
        # chain is INTENTIONALLY down (dev): the broadcast-clean verify can't
        # pass, so every deploy would otherwise abort here (set -e on the
        # caller) and never install unrelated units — e.g. #3850's SDLC
        # cpu.idle slice. Decouple the deploy from the audio precondition:
        #   - LIVE broadcast on the line (studio-compositor active): keep
        #     aborting — breaking the audio chain mid-stream is critical.
        #   - no live broadcast: DEFER the audio restart (it is retried next
        #     deploy cycle) and let the deploy finish installing everything else.
        if systemctl --user is-active --quiet studio-compositor.service; then
            echo "hapax-post-merge-deploy: audio-safe restart of $unit failed (rc=$safe_rc) during a LIVE broadcast (studio-compositor active); aborting deploy to avoid a mid-stream audio break" >&2
            return "$safe_rc"
        fi
        echo "hapax-post-merge-deploy: audio-safe restart of $unit failed (rc=$safe_rc) but no live broadcast (studio-compositor inactive): DEFERRING the audio restart and continuing the deploy; will retry next cycle" >&2
        return 0
    fi

    systemctl --user restart "$unit"
}

stage_coord_activation_before_restart() {
    local deploy_bin="$RECOVERY_BUNDLE_DEST/scripts/hapax-coord-deploy"
    if [ ! -x "$deploy_bin" ]; then
        echo "hapax-post-merge-deploy: refusing to restart hapax-coord.service before its activation worktree is staged; missing executable $deploy_bin; next: install the D2 recovery bundle, verify $deploy_bin exists, then rerun hapax-post-merge-deploy for this merge" >&2
        return 5
    fi
    echo "staging hapax-coord activation before activating hapax-coord.service"
    HAPAX_COORD_DEPLOY_RESTART_IF_UP_TO_DATE=1 "$deploy_bin"
}

gate_closure_source_status() {
    local present=0
    local -a missing=()
    local f
    for f in "${GATE_CLOSURE_FILES[@]}"; do
        if git cat-file -e "$SHA:$f" 2>/dev/null; then
            present=$((present + 1))
        else
            missing+=("$f")
        fi
    done
    if [ "$present" -eq 0 ]; then
        return 1
    fi
    if [ "${#missing[@]}" -gt 0 ]; then
        echo "hapax-post-merge-deploy: incomplete canonical gate closure at $SHA:" >&2
        for f in "${missing[@]}"; do
            echo "  missing $f" >&2
        done
        echo "hapax-post-merge-deploy: next: ensure every GATE_CLOSURE_FILES member exists at $SHA or remove the partial closure, then rerun hapax-post-merge-deploy for this merge" >&2
        return 2
    fi
    return 0
}

stage_gate_closure() {
    local stage="$1"
    local f
    mkdir -p "$stage/hooks/scripts"
    for f in "${GATE_CLOSURE_FILES[@]}"; do
        if ! git show "$SHA:$f" > "$stage/$f"; then
            echo "hapax-post-merge-deploy: failed to materialize $f from $SHA; next: verify the source object exists and rerun hapax-post-merge-deploy for this merge" >&2
            return 2
        fi
        chmod +x "$stage/$f" 2>/dev/null || true
    done
}

canonical_gate_dest_for_source() {
    local f="$1"
    case "$f" in
        hooks/scripts/cc-task-gate.impl.sh)
            printf '%s\n' "$CANONICAL_HOOKS_DIR/cc-task-gate.sh"
            ;;
        *)
            printf '%s/%s\n' "$CANONICAL_HOOKS_DIR" "$(basename "$f")"
            ;;
    esac
}

canonical_gate_closure_in_sync() {
    local stage="$1"
    local f src dest
    for f in "${GATE_CLOSURE_FILES[@]}"; do
        src="$stage/$f"
        dest="$(canonical_gate_dest_for_source "$f")"
        [ -r "$dest" ] || return 1
        cmp -s "$src" "$dest" || return 1
    done
    return 0
}

reconcile_canonical_gate_closure() {
    local source_status=0
    local stage rc

    gate_closure_source_status || source_status=$?
    case "$source_status" in
        0) ;;
        1)
            # Backward-compatible for old/synthetic repos used by tests; the
            # production council tree always carries the hook closure.
            return 0
            ;;
        *)
            return "$source_status"
            ;;
    esac

    stage="$(mktemp -d)"
    if stage_gate_closure "$stage"; then
        :
    else
        rc=$?
        rm -rf "$stage" 2>/dev/null || true
        return "$rc"
    fi

    if canonical_gate_closure_in_sync "$stage"; then
        echo "canonical gate closure already matches $SHA"
        rm -rf "$stage" 2>/dev/null || true
        return 0
    fi

    CANONICAL_GATE+=("hooks/scripts/cc-task-gate.impl.sh")
    if [ "$DRY_RUN" = "1" ]; then
        echo "dry-run: canonical gate drift detected; would redeploy via hooks-doctor --deploy-canonical"
        rm -rf "$stage" 2>/dev/null || true
        return 0
    fi

    if [ "${#GATE_CLOSURE[@]}" -gt 0 ]; then
        echo "gate closure changed (${#GATE_CLOSURE[@]}): redeploying canonical gate"
    else
        echo "canonical gate drift detected: redeploying canonical gate"
    fi
    if bash "$stage/hooks/scripts/hooks-doctor.sh" --deploy-canonical --from "$stage"; then
        DID_ANYTHING=1
        rm -rf "$stage" 2>/dev/null || true
        return 0
    else
        rc=$?
        rm -rf "$stage" 2>/dev/null || true
        echo "hapax-post-merge-deploy: canonical gate deploy failed (rc=$rc); refusing to stamp last-deployed-sha; next: inspect hooks-doctor --deploy-canonical output, repair the staged closure, and rerun hapax-post-merge-deploy for this merge" >&2
        return "$rc"
    fi
}

# Per-file deploy uses `git cat-file -e $SHA:$path` + `git show $SHA:$path`
# to read commit-time content, decoupling the deploy decision from local
# working-tree state. Prior revision used [ -f $REPO/$f ] which raced the
# working-tree pull: when the deploy fired BEFORE the main branch had been
# pulled locally, a deletion commit's [ -f ] returned true (old file still
# present) and the script mistakenly cp-re-deployed the pre-deletion version.
# Classify the file list. SYSTEMD_UNCLASSIFIED captures systemd/** paths
# that DON'T match the case-globs below — used by --report-coverage to
# catch the absence-class deploy bug where a new unit lands at a path
# this script can't reach (P-4 of the absence-class-bug-prevention-and-
# remediation epic).
while IFS= read -r f; do
    [ -z "$f" ] && continue
    # The historical judge unit is retired. Classify it before either the old
    # or current root-package manifest so a cumulative deploy can never
    # reinstall, unmask, restart, or delete the installed tombstone. The
    # generic installer owns a separately authorized retry-convergent cleanup.
    if [ "$f" = "systemd/units/hapax-local-judge.service" ]; then
        RUNTIME_DEFERRED+=("local-judge-retirement:$f")
        continue
    fi
    if [ -n "${OOM_PACKAGE_PATHS[$f]+present}" ]; then
        OOM_CONTAINMENT+=("$f")
        continue
    fi
    if [ -n "${APCUPSD_PACKAGE_PATHS[$f]+present}" ]; then
        APCUPSD_POWER_ALERTS+=("$f")
        continue
    fi
    case "$f" in
        # ARCHIVED confs are records, not deployables. Bash case-globs match
        # across slashes, so without this exclusion config/pipewire/archive/**
        # walks straight into the PW deploy set — the 2026-06-11 09:34 P0:
        # 25 archived confs resurrected into the live conf dir, one syntax-
        # invalid, PipeWire + daimonion start-limit dead, broadcast audio out.
        config/pipewire/archive/*|config/wireplumber/archive/*|config/hapax/archive/*) : ;;
        config/pipewire/*.conf)           PW+=("$f") ;;
        config/hapax/*.conf)              HAPAX_CONF+=("$f") ;;
        config/wireplumber/scripts/hapax/*.lua) WP_LUA+=("$f") ;;
        config/wireplumber/*.conf)        WP+=("$f") ;;
        systemd/units/notify-failure@.service|systemd/units/hapax-coord.service|systemd/units/hapax-coord-rebuild.service|systemd/units/hapax-coord-rebuild.timer)
            RECOVERY_BUNDLE+=("$f")
            if ! unit_install_scope "$f"; then
                exit 2
            fi
            if [ "$UNIT_INSTALL_SCOPE" = "system" ]; then
                SYSTEMD_SYSTEM+=("$f")
            elif [ "$UNIT_INSTALL_SCOPE" = "transition" ] \
                || [ -n "${SYSTEMD_PENDING_PRIOR_SET[$f]+present}" ]; then
                SYSTEMD_PENDING_USER_UNITS+=("$f")
            else
                SYSTEMD+=("$f")
            fi
            ;;
        systemd/units/*.service|systemd/units/*.timer|systemd/units/*.path|systemd/units/*.target|systemd/units/*.slice)
            if ! unit_install_scope "$f"; then
                exit 2
            fi
            if [ "$UNIT_INSTALL_SCOPE" = "system" ]; then
                SYSTEMD_SYSTEM+=("$f")
            elif [ "$UNIT_INSTALL_SCOPE" = "transition" ] \
                || [ -n "${SYSTEMD_PENDING_PRIOR_SET[$f]+present}" ]; then
                SYSTEMD_PENDING_USER_UNITS+=("$f")
            else
                SYSTEMD+=("$f")
            fi
            ;;
        systemd/*.service|systemd/*.timer|systemd/*.path) SYSTEMD+=("$f") ;;
        systemd/units/*.service.d/*.conf|systemd/units/*.timer.d/*.conf|systemd/units/*.slice.d/*.conf|systemd/units/*.scope.d/*.conf)
            dropin_base_unit="${f%%.d/*}"
            if ! unit_install_scope "$dropin_base_unit" 1 "$f"; then
                exit 2
            fi
            if [ "$UNIT_INSTALL_SCOPE" = "system" ]; then
                SYSTEMD_SYSTEM_DROPINS+=("$f")
            elif [ "$UNIT_INSTALL_SCOPE" = "transition" ] \
                || [ -n "${SYSTEMD_PENDING_PRIOR_SET[$f]+present}" ]; then
                SYSTEMD_PENDING_USER_DROPINS+=("$f")
            else
                SYSTEMD_DROPINS+=("$f")
            fi
            ;;
        systemd/user-preset.d/*.preset)   USER_PRESETS+=("$f") ;;
        systemd/watchdogs/*)              WATCHDOGS+=("$f") ;;
        systemd/scripts/*)                ;; # installer helpers; run manually when needed
        systemd/udev/*.rules)             ;; # udev rules; require sudo install + udevadm reload (operator action)
        systemd/logrotate.d/*)            ;; # logrotate configs; require sudo install
        systemd/system/*)                 ;; # system-scoped configs; require sudo install
        scripts/hapax-recovery-plane-install|scripts/hapax-p0-incident-intake|scripts/hapax-coord-deploy)
            RECOVERY_BUNDLE+=("$f")
            SCRIPTS+=("$f")
            ;;
        shared/__init__.py|shared/jsonl_append.py|shared/p0_incident_intake.py)
            RECOVERY_BUNDLE+=("$f")
            ;;
        hooks/scripts/cc-task-gate.impl.sh|hooks/scripts/agent-role.sh|hooks/scripts/escape-grant.sh|hooks/scripts/hapax_check_enable_latch.sh|hooks/scripts/cc-task-gate-bootstrap.py|hooks/scripts/hooks-doctor.sh|hooks/scripts/cc-task-gate.sh)
            GATE_CLOSURE+=("$f") ;;
        assets/quake/maps/*|assets/quake/qc/*|assets/quake/csqc/*|assets/quake/models/*|assets/quake/sound/*|assets/quake/glsl/*|assets/quake/scripts/*|assets/quake/config/*|assets/quake/darkplaces/*)
            QUAKE_ASSETS+=("$f") ;;
        scripts/hapax-*)                  SCRIPTS+=("$f") ;;
        scripts/*.py|scripts/*.sh)        SCRIPT_PY+=("$f") ;;
        systemd/expected-timers.yaml)     ;; # frozen-baseline doc, not deployable
        systemd/README.md)                ;; # docs
        systemd/units/*.md)               ;; # docs
        systemd/units/*.d/README.md)      ;; # drop-in dir docs (e.g. collapse ledgers)
        systemd/overrides/*)              ;; # source/rationale docs; deployable copies live under systemd/units
        systemd/*)                        SYSTEMD_UNCLASSIFIED+=("$f") ;;
    esac
done <<< "$FILES"

if [ "${#OOM_CONTAINMENT[@]}" -gt 0 ]; then
    RUNTIME_DEFERRED+=("oom-containment:$SHA")
fi
if [ "${#APCUPSD_POWER_ALERTS[@]}" -gt 0 ]; then
    RUNTIME_DEFERRED+=("apcupsd-power-alerts:$SHA")
fi

if [ "$REPORT_COVERAGE" = "1" ]; then
    if [ "${#SYSTEMD_UNCLASSIFIED[@]}" -gt 0 ]; then
        echo "ERROR: ${#SYSTEMD_UNCLASSIFIED[@]} systemd/** path(s) in $SHA fall outside hapax-post-merge-deploy case-globs:" >&2
        for f in "${SYSTEMD_UNCLASSIFIED[@]}"; do
            echo "  $f" >&2
        done
        echo "" >&2
        echo "Either move the files to a covered glob (systemd/units/*.service|*.timer)" >&2
        echo "or extend the case statement in hapax-post-merge-deploy. The current" >&2
        echo "supported globs are documented at the top of the script." >&2
        exit 1
    fi
    echo "ok: all systemd/** paths in $SHA are covered by case-globs"
    exit 0
fi

TRACE_READY=1
if [ -z "$FILES" ]; then
    reconcile_canonical_gate_closure
    trace_status="no_changes"
    if [ "$DID_ANYTHING" -ne 0 ]; then
        trace_status="completed"
    fi
    if ! finalize_deploy_receipts "$trace_status"; then
        exit 1
    fi
    echo "no files changed in $SHA"
    exit 0
fi

if [ "$DRY_RUN" = "1" ]; then
    reconcile_canonical_gate_closure
    record_post_merge_trace "dry_run" "0"
    TRACE_WRITTEN=1
    echo "dry-run: post-merge deploy trace written to $TRACE_PATH"
    exit 0
fi

# --- PipeWire confs ---
if [ "${#PW[@]}" -gt 0 ]; then
    echo "pipewire confs changed (${#PW[@]}):"
    mkdir -p "$PW_CONF_DIR"
    for f in "${PW[@]}"; do
        dest="$PW_CONF_DIR/$(basename "$f")"
        if git cat-file -e "$SHA:$f" 2>/dev/null; then
            # Parse-lint BEFORE the live conf dir sees it: one syntax-invalid
            # conf start-limit-kills the whole audio stack (2026-06-11 P0).
            if command -v spa-json-dump >/dev/null 2>&1; then
                if ! git show "$SHA:$f" | spa-json-dump /dev/stdin >/dev/null 2>&1; then
                    echo "  REFUSED (spa-json parse error, would kill PipeWire): '$f'" >&2
                    DEPLOY_ERRORS=$((${DEPLOY_ERRORS:-0} + 1))
                    continue
                fi
            fi
            git show "$SHA:$f" > "$dest"
            echo "  '$f' -> '$dest'"
        else
            echo "  (deleted: $f)"
            rm -fv "$dest" || true
        fi
    done
    echo "restarting pipewire stack"
    systemctl --user restart pipewire pipewire-pulse wireplumber
    DID_ANYTHING=1
fi

# --- Hapax runtime config ---
if [ "${#HAPAX_CONF[@]}" -gt 0 ]; then
    echo "hapax runtime config changed (${#HAPAX_CONF[@]}):"
    mkdir -p "$HAPAX_CONF_DIR"
    for f in "${HAPAX_CONF[@]}"; do
        dest="$HAPAX_CONF_DIR/$(basename "$f")"
        if git cat-file -e "$SHA:$f" 2>/dev/null; then
            git show "$SHA:$f" > "$dest"
            echo "  '$f' -> '$dest'"
        else
            echo "  (deleted: $f)"
            rm -fv "$dest" || true
        fi
    done
    echo "restarting hapax-audio-reconciler"
    systemctl --user restart hapax-audio-reconciler.service || true
    DID_ANYTHING=1
fi

# --- WirePlumber confs ---
if [ "${#WP[@]}" -gt 0 ]; then
    echo "wireplumber confs changed (${#WP[@]}):"
    mkdir -p "$WP_CONF_DIR"
    for f in "${WP[@]}"; do
        dest="$WP_CONF_DIR/$(basename "$f")"
        if git cat-file -e "$SHA:$f" 2>/dev/null; then
            git show "$SHA:$f" > "$dest"
            echo "  '$f' -> '$dest'"
        else
            rm -fv "$dest" || true
        fi
    done
    # WP restart alone if we didn't already restart above
    if [ "${#PW[@]}" -eq 0 ]; then
        systemctl --user restart wireplumber
    fi
    DID_ANYTHING=1
fi

# --- WirePlumber Lua scripts (private-fence deny policy etc.) ---
# The .conf goes to ~/.config/wireplumber/wireplumber.conf.d (handled above); the
# Lua component it loads lives under the XDG *data* dir
# ~/.local/share/wireplumber/scripts/hapax (see scripts/hapax-wireplumber-link-deny-policy
# and config/wireplumber/98-hapax-link-deny.conf). Without this case the deny
# policy can go stale on deploy while its .conf updates (FM-13).
if [ "${#WP_LUA[@]}" -gt 0 ]; then
    echo "wireplumber lua scripts changed (${#WP_LUA[@]}):"
    mkdir -p "$WP_SCRIPTS_DIR"
    for f in "${WP_LUA[@]}"; do
        dest="$WP_SCRIPTS_DIR/$(basename "$f")"
        if git cat-file -e "$SHA:$f" 2>/dev/null; then
            git show "$SHA:$f" > "$dest"
            echo "  '$f' -> '$dest'"
        else
            rm -fv "$dest" || true
        fi
    done
    # Restart wireplumber only if neither the pipewire stack nor the WP confs
    # above already restarted it.
    if [ "${#PW[@]}" -eq 0 ] && [ "${#WP[@]}" -eq 0 ]; then
        systemctl --user restart wireplumber
    fi
    DID_ANYTHING=1
fi

# --- systemd watchdog helper scripts ---
if [ "${#WATCHDOGS[@]}" -gt 0 ]; then
    echo "systemd watchdog scripts changed (${#WATCHDOGS[@]}):"
    mkdir -p "$LOCAL_BIN"
    for f in "${WATCHDOGS[@]}"; do
        base="$(basename "$f")"
        dest="$LOCAL_BIN/$base"
        if git cat-file -e "$SHA:$f" 2>/dev/null; then
            git show "$SHA:$f" > "$dest"
            chmod +x "$dest" 2>/dev/null || true
            echo "  '$f' -> '$dest'"
        else
            rm -fv "$dest" || true
        fi
        matches="$(grep -l -F "$dest" "$REPO/systemd/units/"*.service 2>/dev/null || true)"
        for unit_path in $matches; do
            base_unit="$(basename "$unit_path")"
            if systemctl --user is-active --quiet "$base_unit"; then
                echo "  restarting $base_unit (uses $dest)"
                restart_user_unit "$base_unit"
            fi
        done
    done
    DID_ANYTHING=1
fi

# --- D2 recovery-plane stable bundle ---
recovery_installer_exists_at_sha() {
    git cat-file -e "$SHA:$RECOVERY_INSTALLER_PATH" 2>/dev/null
}

recovery_bundle_runtime_missing() {
    local f target
    for f in "${RECOVERY_BUNDLE_REQUIRED_FILES[@]}"; do
        target="$RECOVERY_BUNDLE_DEST/$f"
        case "$f" in
            scripts/*)
                [ -x "$target" ] || return 0
                ;;
            *)
                [ -f "$target" ] || return 0
                ;;
        esac
    done
    return 1
}

recovery_bundle_runtime_stale() {
    /usr/bin/python3 -I -S - "$RECOVERY_BUNDLE_DEST/manifest.json" "$REPO" "$SHA" "${RECOVERY_BUNDLE_SOURCE_FILES[@]}" <<'PY'
import hashlib
import json
import subprocess
import sys
from pathlib import Path

manifest_path = Path(sys.argv[1])
repo = sys.argv[2]
sha = sys.argv[3]
source_files = sys.argv[4:]

try:
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
except (OSError, json.JSONDecodeError):
    raise SystemExit(0)

installed_files = manifest.get("files")
if not isinstance(installed_files, list):
    raise SystemExit(0)

installed_sha256 = {}
for entry in installed_files:
    if not isinstance(entry, dict):
        continue
    path = entry.get("path")
    sha256 = entry.get("sha256")
    if isinstance(path, str) and isinstance(sha256, str):
        installed_sha256[path] = sha256

for relative in source_files:
    expected_sha256 = installed_sha256.get(relative)
    if expected_sha256 is None:
        raise SystemExit(0)
    try:
        runtime_bytes = (manifest_path.parent / relative).read_bytes()
    except OSError:
        raise SystemExit(0)
    result = subprocess.run(
        ["git", "-C", repo, "show", f"{sha}:{relative}"],
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        raise SystemExit(0)
    runtime_sha256 = hashlib.sha256(runtime_bytes).hexdigest()
    source_sha256 = hashlib.sha256(result.stdout).hexdigest()
    if runtime_sha256 != expected_sha256 or source_sha256 != expected_sha256:
        raise SystemExit(0)

raise SystemExit(1)
PY
}

RECOVERY_BUNDLE_SELF_HEAL=0
RECOVERY_BUNDLE_SELF_HEAL_REASON=""
if [ "${#RECOVERY_BUNDLE[@]}" -eq 0 ] \
    && recovery_installer_exists_at_sha \
    && recovery_bundle_runtime_missing; then
    RECOVERY_BUNDLE_SELF_HEAL=1
    RECOVERY_BUNDLE_SELF_HEAL_REASON="missing/incomplete"
elif [ "${#RECOVERY_BUNDLE[@]}" -eq 0 ] \
    && recovery_installer_exists_at_sha \
    && recovery_bundle_runtime_stale; then
    RECOVERY_BUNDLE_SELF_HEAL=1
    RECOVERY_BUNDLE_SELF_HEAL_REASON="stale"
fi

if [ "${#RECOVERY_BUNDLE[@]}" -gt 0 ] || [ "$RECOVERY_BUNDLE_SELF_HEAL" = "1" ]; then
    if [ "${#RECOVERY_BUNDLE[@]}" -gt 0 ]; then
        echo "recovery bundle files changed (${#RECOVERY_BUNDLE[@]}):"
        for f in "${RECOVERY_BUNDLE[@]}"; do
            echo "  $f"
        done
    else
        echo "recovery bundle runtime $RECOVERY_BUNDLE_SELF_HEAL_REASON at $RECOVERY_BUNDLE_DEST; self-healing stable closure"
    fi
    if ! git cat-file -e "$SHA:$RECOVERY_INSTALLER_PATH" 2>/dev/null; then
        echo "hapax-post-merge-deploy: missing recovery bundle installer at $SHA:$RECOVERY_INSTALLER_PATH; next: ensure scripts/hapax-recovery-plane-install exists at the deployed source-activation SHA, then rerun hapax-post-merge-deploy for this merge" >&2
        exit 2
    fi
    RECOVERY_INSTALLER="$(mktemp)"
    git show "$SHA:$RECOVERY_INSTALLER_PATH" > "$RECOVERY_INSTALLER"
    chmod +x "$RECOVERY_INSTALLER"
    set +e
    "$RECOVERY_INSTALLER" --source "$REPO" --source-ref "$SHA" --dest "$RECOVERY_BUNDLE_DEST"
    recovery_installer_rc=$?
    set -e
    rm -f "$RECOVERY_INSTALLER"
    if [ "$recovery_installer_rc" -ne 0 ]; then
        exit "$recovery_installer_rc"
    fi
    DID_ANYTHING=1
fi

# --- P0 OOM containment system/user policy ---
stage_root_required_package() {
    local stage="$1" manifest="$2" label="$3"
    local rel dest git_mode git_type git_tree manifest_line extra payload_tmp mode
    local manifest_text="" entry_count=0
    if [ ! -d "$stage" ] || [ -L "$stage" ]; then
        echo "hapax-post-merge-deploy: invalid $label stage directory: $stage" >&2
        return 2
    fi
    if ! git cat-file -e "$SHA:$manifest" 2>/dev/null; then
        echo "hapax-post-merge-deploy: missing $label manifest at $SHA:$manifest; next: restore the versioned ownership manifest and rerun hapax-post-merge-deploy for this merge" >&2
        return 2
    fi
    if ! manifest_text="$(git -C "$REPO" show "$SHA:$manifest")"; then
        echo "hapax-post-merge-deploy: failed to read $label manifest at $SHA:$manifest; refusing to publish an incomplete stage" >&2
        return 2
    fi
    while IFS= read -r manifest_line; do
        rel=""
        extra=""
        read -r rel extra <<< "$manifest_line" || true
        [ -n "$rel" ] || continue
        [[ "$rel" == \#* ]] && continue
        if [ -n "$extra" ]; then
            echo "hapax-post-merge-deploy: malformed $label manifest entry: $manifest_line; next: declare exactly one normalized path per line" >&2
            return 2
        fi
        if ! root_required_manifest_path_is_safe "$rel"; then
            echo "hapax-post-merge-deploy: unsafe or non-normalized $label manifest path: $rel; next: use normalized repository-relative paths only" >&2
            return 2
        fi
        if ! git cat-file -e "$SHA:$rel" 2>/dev/null; then
            echo "hapax-post-merge-deploy: missing $label source at $SHA:$rel; next: restore every path declared by $manifest and rerun hapax-post-merge-deploy for this merge" >&2
            return 2
        fi
        if ! git_tree="$(git -C "$REPO" ls-tree "$SHA" -- "$rel")"; then
            echo "hapax-post-merge-deploy: failed to inspect $label Git mode at $SHA:$rel; refusing to publish an incomplete stage" >&2
            return 2
        fi
        if [ -z "$git_tree" ] || [[ "$git_tree" == *$'\n'* ]]; then
            echo "hapax-post-merge-deploy: ambiguous $label Git entry at $SHA:$rel; refusing to publish an incomplete stage" >&2
            return 2
        fi
        read -r git_mode git_type _ <<< "$git_tree"
        case "$git_mode" in
            100644|100755) ;;
            *)
                echo "hapax-post-merge-deploy: unsupported $label Git mode ${git_mode:-missing} at $SHA:$rel; next: replace symlink/submodule entries with regular package files" >&2
                return 2
                ;;
        esac
        if [ "$git_type" != "blob" ]; then
            echo "hapax-post-merge-deploy: unsupported $label Git object type ${git_type:-missing} at $SHA:$rel; expected a blob" >&2
            return 2
        fi
        dest="$stage/$rel"
        if ! mkdir -p "$(dirname "$dest")"; then
            echo "hapax-post-merge-deploy: failed to create $label stage directory for $rel" >&2
            return 2
        fi
        if ! payload_tmp="$(mktemp "$dest.tmp.XXXXXX")"; then
            echo "hapax-post-merge-deploy: failed to allocate $label stage file for $rel" >&2
            return 2
        fi
        if ! git -C "$REPO" show "$SHA:$rel" > "$payload_tmp"; then
            rm -f -- "$payload_tmp" 2>/dev/null || true
            echo "hapax-post-merge-deploy: failed to read $label source at $SHA:$rel; refusing to publish an incomplete stage" >&2
            return 2
        fi
        if [ "$git_mode" = "100755" ]; then
            mode=0755
        else
            mode=0644
        fi
        if ! chmod "$mode" "$payload_tmp"; then
            rm -f -- "$payload_tmp" 2>/dev/null || true
            echo "hapax-post-merge-deploy: failed to set $label stage mode for $rel" >&2
            return 2
        fi
        if ! mv -f -- "$payload_tmp" "$dest"; then
            rm -f -- "$payload_tmp" 2>/dev/null || true
            echo "hapax-post-merge-deploy: failed to publish $label stage file for $rel" >&2
            return 2
        fi
        entry_count=$((entry_count + 1))
    done <<< "$manifest_text"
    if [ "$entry_count" -eq 0 ]; then
        echo "hapax-post-merge-deploy: $label manifest at $SHA:$manifest has no package paths; refusing to publish an empty stage" >&2
        return 2
    fi
    if ! atomic_write_sha_receipt "$stage/.hapax-root-required-package-sha" "$SHA"; then
        echo "hapax-post-merge-deploy: failed to publish the $label stage marker" >&2
        return 2
    fi
}

stage_oom_containment_installer() {
    stage_root_required_package \
        "$1" config/root-required/oom-containment.files "OOM containment"
}

defer_root_required_installer() {
    local label="$1" stage="$2" dest temp
    mkdir -p "$ROOT_DEFER_DIR"
    dest="$ROOT_DEFER_DIR/$SHA/$label"
    mkdir -p "$(dirname "$dest")"
    temp="$ROOT_DEFER_DIR/$SHA/.${label}.tmp.$$"
    rm -rf "$temp" 2>/dev/null || true
    cp -a "$stage" "$temp"
    if [ "$label" = "oom-containment" ]; then
        cat > "$temp/RUNBOOK.txt" <<EOF
Root-required OOM package staged as non-authoritative desired-state evidence.

Commit: $SHA
Package: $label

Production OOM installation and authoritative live verification are unavailable
in this source revision. This staged package and all same-UID receipts are input,
not runtime authority.

This staging does not replace, stop, or otherwise reconcile an already installed
OOM auditor or timer. Existing installed bytes may retain historical mutating semantics
until a separately runtime-authorized cutover verifies and replaces
them; do not treat source acceptance or this RUNBOOK as that cutover.

Next action: preserve this exact-SHA package and dispatch separately runtime-authorized root-broker work against
docs/security/root-authority-hazard-register.md. Do not execute the staged
interpreter as root and do not recreate the retired --install/--verify-live path.

Post-merge deploy continued so unrelated user-scope deploy groups for the same
merge were not skipped.
EOF
        rm -rf "$dest" 2>/dev/null || true
        mv "$temp" "$dest"
        echo "root-required $label desired-state package staged at $dest"
        echo "next action: dispatch separately runtime-authorized root-broker work; production OOM application is unavailable in this source revision"
        return 0
    fi
    if [ "$label" = "apcupsd-power-alerts" ]; then
        cat > "$temp/RUNBOOK.txt" <<EOF
Root-required APC package staged as non-authoritative desired-state evidence.

Commit: $SHA
Package: $label

Production APC installation is unavailable in this source revision. A
caller-owned shell and mutable staged paths cannot carry root authority, and
same-UID receipts or drained markers cannot establish runtime completion.

Next action: preserve this exact-SHA package and dispatch separately runtime-authorized root-broker work against
docs/security/root-authority-hazard-register.md. Do not execute the staged
interpreter as root and do not use its isolated-test install path against live
destinations.

Post-merge deploy continued so unrelated user-scope deploy groups for the same
merge were not skipped.
EOF
        rm -rf "$dest" 2>/dev/null || true
        mv "$temp" "$dest"
        echo "root-required $label desired-state package staged at $dest"
        echo "next action: dispatch separately runtime-authorized root-broker work; production APC application is unavailable in this source revision"
        return 0
    fi
    rm -rf "$temp" 2>/dev/null || true
    echo "hapax-post-merge-deploy: unsupported root-required package label $label; no runbook published" >&2
    return 2
}

root_required_stage_matches_commit() {
    local stage="$1" commit="$2" manifest_rel="$3" file rel git_mode git_type stage_mode
    local source_oid stage_oid git_tree manifest_line extra entry_count=0
    [ -f "$stage/$manifest_rel" ] || return 1
    [ ! -L "$stage/$manifest_rel" ] || return 1
    if ! source_oid="$(git -C "$REPO" rev-parse --verify "$commit:$manifest_rel" 2>/dev/null)"; then
        return 1
    fi
    if ! stage_oid="$(git -C "$REPO" hash-object "$stage/$manifest_rel" 2>/dev/null)"; then
        return 1
    fi
    [ "$source_oid" = "$stage_oid" ] || return 1
    while IFS= read -r manifest_line; do
        rel=""
        extra=""
        read -r rel extra <<< "$manifest_line" || true
        [ -n "$rel" ] || continue
        [[ "$rel" == \#* ]] && continue
        [ -z "$extra" ] || return 1
        root_required_manifest_path_is_safe "$rel" || return 1
        file="$stage/$rel"
        [ -f "$file" ] || return 1
        [ ! -L "$file" ] || return 1
        if ! source_oid="$(git -C "$REPO" rev-parse --verify "$commit:$rel" 2>/dev/null)"; then
            return 1
        fi
        if ! stage_oid="$(git -C "$REPO" hash-object "$file" 2>/dev/null)"; then
            return 1
        fi
        [ "$source_oid" = "$stage_oid" ] || return 1
        if ! git_tree="$(git -C "$REPO" ls-tree "$commit" -- "$rel")"; then
            return 1
        fi
        [ -n "$git_tree" ] || return 1
        [[ "$git_tree" != *$'\n'* ]] || return 1
        read -r git_mode git_type _ <<< "$git_tree"
        [ "$git_type" = "blob" ] || return 1
        stage_mode=100644
        [ -x "$file" ] && stage_mode=100755
        [ "$git_mode" = "$stage_mode" ] || return 1
        entry_count=$((entry_count + 1))
    done < "$stage/$manifest_rel"
    [ "$entry_count" -gt 0 ]
}

validate_root_required_stage_manifest() {
    local stage="$1" manifest_rel="$2" expected actual
    if ! expected="$(awk 'NF && $1 !~ /^#/ {print $1}' "$stage/$manifest_rel" | LC_ALL=C sort)"; then
        echo "hapax-post-merge-deploy: failed to read staged $manifest_rel; refusing desired-state publication" >&2
        return 1
    fi
    if ! actual="$(find "$stage" -type f ! -name .hapax-root-required-package-sha -printf '%P\n' | LC_ALL=C sort)"; then
        echo "hapax-post-merge-deploy: failed to enumerate staged root-required package; refusing desired-state publication" >&2
        return 1
    fi
    if [ -z "$expected" ] || [ "$expected" != "$actual" ]; then
        echo "hapax-post-merge-deploy: staged root-required package does not match $manifest_rel; next action: update the versioned ownership manifest and staging list together" >&2
        return 1
    fi
}

record_root_required_desired_sha() {
    local label="$1" stage="$2" receipt current manifest_rel
    case "$label" in
        oom-containment) manifest_rel="config/root-required/oom-containment.files" ;;
        apcupsd-power-alerts) manifest_rel="config/root-required/apcupsd-power-alerts.files" ;;
        *) echo "hapax-post-merge-deploy: unknown root-required package label: $label; next action: use oom-containment or apcupsd-power-alerts from the governed staging path" >&2; return 2 ;;
    esac
    validate_root_required_stage_manifest "$stage" "$manifest_rel" || return 1
    receipt="$ROOT_REQUIRED_DESIRED_RECEIPT_ROOT/$label.sha"
    if [ -f "$receipt" ]; then
        if ! current="$(tr -d '[:space:]' < "$receipt")"; then
            echo "hapax-post-merge-deploy: failed to read desired $label receipt $receipt; refusing to replace it" >&2
            return 1
        fi
        if ! [[ "$current" =~ ^[0-9a-f]{40}$ ]] || ! git -C "$REPO" cat-file -e "$current^{commit}" 2>/dev/null; then
            echo "hapax-post-merge-deploy: invalid or unavailable desired $label receipt $current; next action: restore the latest governed receipt and rerun this deploy" >&2
            return 1
        fi
        if [ "$current" = "$SHA" ]; then
            return 0
        fi
        if git -C "$REPO" merge-base --is-ancestor "$SHA" "$current"; then
            echo "root-required $label desired state $current supersedes stale deploy $SHA; desired receipt preserved"
            return 0
        fi
        if ! git -C "$REPO" merge-base --is-ancestor "$current" "$SHA"; then
            if root_required_stage_matches_commit "$stage" "$current" "$manifest_rel"; then
                echo "root-required $label desired state is ancestry-divergent but package-content equivalent; accepting squash/rebase transition to $SHA"
            else
                echo "hapax-post-merge-deploy: refusing divergent desired $label transition current=$current candidate=$SHA; next action: dispatch governed root-package reconciliation" >&2
                return 1
            fi
        fi
    fi
    if ! atomic_write_sha_receipt "$receipt" "$SHA"; then
        echo "hapax-post-merge-deploy: failed to publish desired $label receipt; refusing successful staging" >&2
        return 1
    fi
}

# Validate the APC source package before the OOM source package so recovery-plane
# policy errors are reported in dependency order. Runtime application is deferred.
stage_apcupsd_power_alert_installer() {
    stage_root_required_package \
        "$1" config/root-required/apcupsd-power-alerts.files "apcupsd power-alert"
}

if [ "${#APCUPSD_POWER_ALERTS[@]}" -gt 0 ]; then
    echo "apcupsd power-alert files changed (${#APCUPSD_POWER_ALERTS[@]}):"
    for f in "${APCUPSD_POWER_ALERTS[@]}"; do
        echo "  $f"
    done
    APCUPSD_STAGE="$(mktemp -d)"
    set +e
    stage_apcupsd_power_alert_installer "$APCUPSD_STAGE"
    stage_apcupsd_rc=$?
    set -e
    if [ "$stage_apcupsd_rc" -ne 0 ]; then
        rm -rf "$APCUPSD_STAGE" 2>/dev/null || true
        exit "$stage_apcupsd_rc"
    fi
    set +e
    "$APCUPSD_STAGE/$APCUPSD_INSTALLER_PATH" --source "$APCUPSD_STAGE" --check
    apcupsd_installer_rc=$?
    set -e
    if [ "$apcupsd_installer_rc" -ne 0 ]; then
        rm -rf "$APCUPSD_STAGE" 2>/dev/null || true
        exit "$apcupsd_installer_rc"
    fi
    if ! record_root_required_desired_sha "apcupsd-power-alerts" "$APCUPSD_STAGE"; then
        rm -rf "$APCUPSD_STAGE" 2>/dev/null || true
        exit 1
    fi
    defer_root_required_installer "apcupsd-power-alerts" "$APCUPSD_STAGE"
    rm -rf "$APCUPSD_STAGE" 2>/dev/null || true
    DID_ANYTHING=1
fi

if [ "${#OOM_CONTAINMENT[@]}" -gt 0 ]; then
    echo "P0 OOM containment files changed (${#OOM_CONTAINMENT[@]}):"
    for f in "${OOM_CONTAINMENT[@]}"; do
        echo "  $f"
    done
    OOM_STAGE="$(mktemp -d)"
    set +e
    stage_oom_containment_installer "$OOM_STAGE"
    stage_oom_rc=$?
    set -e
    if [ "$stage_oom_rc" -ne 0 ]; then
        rm -rf "$OOM_STAGE" 2>/dev/null || true
        exit "$stage_oom_rc"
    fi
    set +e
    HAPAX_ROOT_REQUIRED_PACKAGE_SHA="$SHA" \
        HAPAX_ROOT_REQUIRED_INSTALLED_SOURCE_ROOT="$ROOT_REQUIRED_INSTALLED_SOURCE_ROOT" \
        HAPAX_ROOT_REQUIRED_INSTALLED_RECEIPT_ROOT="$ROOT_REQUIRED_INSTALLED_RECEIPT_ROOT" \
        HAPAX_ROOT_REQUIRED_DESIRED_RECEIPT_ROOT="$ROOT_REQUIRED_DESIRED_RECEIPT_ROOT" \
        HAPAX_ROOT_REQUIRED_GIT_REPO="$REPO" \
        "$OOM_STAGE/$OOM_CONTAINMENT_INSTALLER_PATH" \
            --source "$OOM_STAGE" --check --no-runtime
    oom_installer_rc=$?
    set -e
    if [ "$oom_installer_rc" -ne 0 ]; then
        rm -rf "$OOM_STAGE" 2>/dev/null || true
        exit "$oom_installer_rc"
    fi
    if ! record_root_required_desired_sha "oom-containment" "$OOM_STAGE"; then
        rm -rf "$OOM_STAGE" 2>/dev/null || true
        exit 1
    fi
    defer_root_required_installer "oom-containment" "$OOM_STAGE"
    rm -rf "$OOM_STAGE" 2>/dev/null || true
fi

slice_memory_issue_from_content() {
    awk '
        function trim(value) {
            sub(/^[[:space:]]+/, "", value)
            sub(/[[:space:]]+$/, "", value)
            return value
        }
        /^[[:space:]]*[#;]/ || /^[[:space:]]*$/ { next }
        {
            line = $0
            candidate = trim(line)
            if (candidate ~ /^\[[^]]+\]$/) {
                section = candidate
                gsub(/^\[|\]$/, "", section)
                next
            }
            equals = index(line, "=")
            if (!equals) { next }
            key = trim(substr(line, 1, equals - 1))
            value = trim(substr(line, equals + 1))
            if (key !~ /^(MemoryHigh|MemoryMax|MemorySwapMax|MemoryLow|MemoryMin)$/) { next }
            if (section != "Slice") {
                print "memory property outside [Slice]: " candidate
                exit
            }
            if (value !~ /^(infinity|[0-9]+([.][0-9]+)?([KMGTPE](iB|B)?)?|[0-9]+%)$/) {
                print "invalid memory value: " candidate
                exit
            }
        }
    '
}

slice_memory_properties_from_content() {
    awk '
        function trim(value) {
            sub(/^[[:space:]]+/, "", value)
            sub(/[[:space:]]+$/, "", value)
            return value
        }
        /^[[:space:]]*[#;]/ || /^[[:space:]]*$/ { next }
        {
            line = $0
            candidate = trim(line)
            if (candidate ~ /^\[[^]]+\]$/) {
                section = candidate
                gsub(/^\[|\]$/, "", section)
                next
            }
            equals = index(line, "=")
            if (!equals) { next }
            key = trim(substr(line, 1, equals - 1))
            value = trim(substr(line, equals + 1))
            if (section == "Slice" && key ~ /^(MemoryHigh|MemoryMax|MemorySwapMax|MemoryLow|MemoryMin)$/) {
                print key "=" value
            }
        }
    '
}

generic_dropin_destination_is_replaced() {
    local candidate="$1" changed rel
    for changed in "${SYSTEMD_DROPINS[@]}"; do
        rel="${changed#systemd/units/}"
        if [ "$SYSTEMD_USER_DIR/$rel" = "$candidate" ] \
            && git -C "$REPO" cat-file -e "$SHA:$changed" 2>/dev/null; then
            return 0
        fi
    done
    return 1
}

validate_co_resident_slice_dropins() {
    local dropin_dir="$1" conf content issue
    for conf in "$SYSTEMD_USER_DIR/$dropin_dir"/*.conf; do
        [ -e "$conf" ] || [ -L "$conf" ] || continue
        generic_dropin_destination_is_replaced "$conf" && continue
        if [ -L "$conf" ] || [ ! -f "$conf" ]; then
            echo "hapax-post-merge-deploy: unsafe co-resident generic slice drop-in $conf is not a regular file; next action: remove the unsafe local entry or dispatch a slice-specific reconciliation before retrying activation" >&2
            return 1
        fi
        content="$(cat "$conf")"
        issue="$(printf '%s\n' "$content" | slice_memory_issue_from_content)"
        if [ -n "$issue" ]; then
            echo "hapax-post-merge-deploy: unsafe co-resident generic slice drop-in $conf: $issue; next action: repair or remove the local drift before retrying the governed slice activation" >&2
            return 1
        fi
    done
}

validate_generic_dropin_activation() {
    local f="$1" rel dropin_dir unit_name content unsupported invalid_memory old_content old_prop dest deployed_content
    rel="${f#systemd/units/}"
    dropin_dir="$(dirname "$rel")"
    unit_name="${dropin_dir%.d}"
    case "$unit_name" in
        *.scope)
            echo "hapax-post-merge-deploy: refusing generic scope drop-in deploy for $f; next action: use a governed scope-specific installer that updates the transient scope without restarting it" >&2
            return 1
            ;;
        *.slice)
            if ! git -C "$REPO" cat-file -e "$SHA:$f" 2>/dev/null; then
                echo "hapax-post-merge-deploy: refusing generic slice drop-in deletion for $f because runtime set-property overrides cannot be safely inferred; next action: use a governed slice-specific removal that clears persistent and runtime policy together" >&2
                return 1
            fi
            content="$(git -C "$REPO" show "$SHA:$f")"
            invalid_memory="$(printf '%s\n' "$content" | awk -F= '
                /^(MemoryHigh|MemoryMax|MemorySwapMax|MemoryLow|MemoryMin)=/ {
                    if ($2 !~ /^(infinity|[0-9]+([.][0-9]+)?([KMGTPE](iB|B)?)?|[0-9]+%)$/) {
                        print
                        exit
                    }
                }
            ')"
            if [ -n "$invalid_memory" ]; then
                echo "hapax-post-merge-deploy: invalid generic slice memory value in $f: $invalid_memory; next action: use a systemd memory size, percentage, or infinity before retrying activation" >&2
                return 1
            fi
            unsupported="$(printf '%s\n' "$content" | awk '
                /^[[:space:]]*$/ || /^[[:space:]]*[#;]/ { next }
                /^[[:space:]]*\[Slice\][[:space:]]*$/ { section = "slice"; next }
                /^[[:space:]]*\[[^]]+\][[:space:]]*$/ { print; exit }
                /^(MemoryHigh|MemoryMax|MemorySwapMax|MemoryLow|MemoryMin)=[^[:space:]].*$/ {
                    if (section != "slice") { print; exit }
                    next
                }
                { print; exit }
            ')"
            if [ -n "$unsupported" ]; then
                echo "hapax-post-merge-deploy: unsupported generic slice directive in $f: $unsupported; next action: use only MemoryHigh/MemoryMax/MemorySwapMax/MemoryLow/MemoryMin or dispatch a slice-specific activation path" >&2
                return 1
            fi
            if ! grep -Eq '^(MemoryHigh|MemoryMax|MemorySwapMax|MemoryLow|MemoryMin)=' <<< "$content"; then
                echo "hapax-post-merge-deploy: no runtime-safe memory property found in generic slice drop-in $f; next action: use a slice-specific installer for non-memory directives" >&2
                return 1
            fi
            dest="$SYSTEMD_USER_DIR/$rel"
            if [ -L "$dest" ] || { [ -e "$dest" ] && [ ! -f "$dest" ]; }; then
                echo "hapax-post-merge-deploy: unsafe changed generic slice destination $dest is not a regular file, so prior runtime properties cannot be established; next action: replace the unsafe entry with its last deployed regular content or use a governed slice-specific reconciliation" >&2
                return 1
            fi
            validate_co_resident_slice_dropins "$dropin_dir" || return 1
            old_content=""
            if [ -n "${DROPIN_BASE_REF:-}" ] \
                && git -C "$REPO" cat-file -e "$DROPIN_BASE_REF:$f" 2>/dev/null; then
                old_content="$(git -C "$REPO" show "$DROPIN_BASE_REF:$f")"
            fi
            if [ -f "$dest" ]; then
                deployed_content="$(cat "$dest")"
                old_content="${old_content}${old_content:+$'\n'}${deployed_content}"
            fi
            if [ -n "$old_content" ]; then
                while IFS= read -r old_prop; do
                    [ -n "$old_prop" ] || continue
                    if ! grep -q "^${old_prop}=" <<< "$content"; then
                        echo "hapax-post-merge-deploy: refusing generic removal of $old_prop from $f because its runtime override would remain stale; next action: use a governed slice-specific transition that resets the removed property" >&2
                        return 1
                    fi
                done < <(printf '%s\n' "$old_content" | slice_memory_properties_from_content | cut -d= -f1 | sort -u || true)
            fi
            ;;
    esac
}

system_unit_file_witness() {
    local path="$1" expected_oid="$2"
    /usr/bin/python3 -I -S - \
        "$path" "$expected_oid" "$SYSTEMD_SYSTEM_TRUST_ROOT" \
        "$SYSTEMD_SYSTEM_EXPECTED_UID" <<'PY'
from __future__ import annotations

import hashlib
import os
import stat
import sys

raw_path, expected_oid, raw_trust_root, expected_uid_text = sys.argv[1:]
try:
    expected_uid = int(expected_uid_text)
except ValueError:
    raise SystemExit(1)
path = os.path.normpath(raw_path)
trust_root = os.path.normpath(raw_trust_root)
if (
    not path.startswith("/")
    or not trust_root.startswith("/")
    or path != raw_path
    or trust_root != raw_trust_root
    or expected_uid < 0
):
    raise SystemExit(1)
try:
    if os.path.commonpath((path, trust_root)) != trust_root or path == trust_root:
        raise SystemExit(1)
except ValueError:
    raise SystemExit(1)


def generation(value: os.stat_result) -> tuple[int, ...]:
    return (
        value.st_dev,
        value.st_ino,
        value.st_mode,
        value.st_uid,
        value.st_nlink,
        value.st_size,
        value.st_mtime_ns,
        value.st_ctime_ns,
    )


def trusted_ancestors(
    *, allow_missing_suffix: bool
) -> list[tuple[str, tuple[int, ...] | None]]:
    parent = os.path.dirname(path)
    relative = os.path.relpath(parent, trust_root)
    components = [] if relative == "." else relative.split(os.sep)
    current = trust_root
    witnessed: list[tuple[str, tuple[int, ...] | None]] = []
    for component in ("", *components):
        if component:
            if component in (".", "..") or os.sep in component:
                raise OSError("unsafe system-unit ancestor component")
            current = os.path.join(current, component)
        try:
            value = os.lstat(current)
        except FileNotFoundError:
            if not allow_missing_suffix:
                raise
            witnessed.append((current, None))
            break
        if (
            not stat.S_ISDIR(value.st_mode)
            or value.st_uid != expected_uid
            or stat.S_IMODE(value.st_mode) & 0o022
        ):
            raise OSError(f"untrusted system-unit ancestor: {current}")
        witnessed.append((current, generation(value)))
    return witnessed


def serialize_ancestors(
    values: list[tuple[str, tuple[int, ...] | None]]
) -> str:
    return ";".join(
        f"{name}:missing"
        if observed is None
        else f"{name}:{','.join(str(item) for item in observed)}"
        for name, observed in values
    )


try:
    ancestors_before = trusted_ancestors(allow_missing_suffix=True)
except (FileNotFoundError, OSError):
    raise SystemExit(1)
try:
    path_before = os.lstat(path)
except FileNotFoundError:
    try:
        ancestors_after = trusted_ancestors(allow_missing_suffix=True)
    except (FileNotFoundError, OSError):
        raise SystemExit(1)
    if ancestors_before != ancestors_after:
        raise SystemExit(1)
    print("\t".join(("absent", serialize_ancestors(ancestors_after))))
    raise SystemExit(0)
if (
    not stat.S_ISREG(path_before.st_mode)
    or path_before.st_uid != expected_uid
    or path_before.st_nlink != 1
    or stat.S_IMODE(path_before.st_mode) != 0o644
):
    raise SystemExit(1)
if any(observed is None for _, observed in ancestors_before):
    raise SystemExit(1)

fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
try:
    before = os.fstat(fd)
    if (before.st_dev, before.st_ino) != (path_before.st_dev, path_before.st_ino):
        raise OSError("system unit path changed before read")
    if before.st_size > 4 * 1024 * 1024:
        raise OSError("system unit exceeds the bounded witness size")
    payload = bytearray()
    while True:
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        payload.extend(chunk)
    after = os.fstat(fd)
    path_after = os.lstat(path)
    ancestors_after = trusted_ancestors(allow_missing_suffix=False)
finally:
    os.close(fd)

generation_before = generation(before)
generation_after = generation(after)
path_generation_after = generation(path_after)
if (
    generation_before != generation_after
    or generation_after != path_generation_after
    or ancestors_before != ancestors_after
):
    raise OSError("system unit generation changed during read")

if expected_oid and len(expected_oid) not in (40, 64):
    raise SystemExit(1)
algorithm = hashlib.sha1 if len(expected_oid) == 40 else hashlib.sha256
digest = algorithm(f"blob {len(payload)}\0".encode("ascii") + payload).hexdigest()
print(
    "\t".join(
        (
            "present",
            digest,
            str(after.st_uid),
            format(stat.S_IMODE(after.st_mode), "04o"),
            str(after.st_nlink),
            *(str(value) for value in generation_after),
            serialize_ancestors(ancestors_after),
        )
    )
)
PY
}

SYSTEM_EXPECTED_DROPIN_PATHS=""
SYSTEM_EXPECTED_DROPIN_RECORDS=""
load_expected_system_dropin_paths() {
    local source_unit="$1" listing line mode type object_and_path object_oid tree_path
    local prefix="${source_unit}.d/"
    local installed_path
    local -a expected=() records=()
    SYSTEM_EXPECTED_DROPIN_PATHS=""
    SYSTEM_EXPECTED_DROPIN_RECORDS=""
    if ! listing="$(git -C "$REPO" ls-tree -r "$SHA" -- "${source_unit}.d")"; then
        echo "hapax-post-merge-deploy: failed to enumerate system drop-ins at $SHA:${source_unit}.d" >&2
        return 1
    fi
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        read -r mode type object_and_path <<< "$line"
        if [[ "$object_and_path" != *$'\t'* ]]; then
            echo "hapax-post-merge-deploy: malformed system drop-in Git entry at $SHA:${source_unit}.d" >&2
            return 1
        fi
        object_oid="${object_and_path%%$'\t'*}"
        tree_path="${object_and_path#*$'\t'}"
        case "$tree_path" in
            "$prefix"*.conf) ;;
            *) continue ;;
        esac
        if [ "$mode" != 100644 ] || [ "$type" != "blob" ] \
            || ! [[ "$object_oid" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]]; then
            echo "hapax-post-merge-deploy: unsupported system drop-in Git entry at $SHA:$tree_path" >&2
            return 1
        fi
        installed_path="$SYSTEMD_SYSTEM_DIR/${tree_path#systemd/units/}"
        expected+=("$installed_path")
        records+=("$installed_path"$'\t'"$object_oid")
    done <<< "$listing"
    if [ "${#expected[@]}" -gt 0 ]; then
        SYSTEM_EXPECTED_DROPIN_PATHS="$(printf '%s\n' "${expected[@]}" | sort -u)"
        SYSTEM_EXPECTED_DROPIN_RECORDS="$(printf '%s\n' "${records[@]}" | sort -u)"
    fi
}

SYSTEM_EXPECTED_FRAGMENT_OID=""
SYSTEM_EXPECTED_FRAGMENT_PRESENT=0
load_expected_system_fragment_oid() {
    local source_unit="$1" listing mode type object_and_path object_oid tree_path
    SYSTEM_EXPECTED_FRAGMENT_OID=""
    SYSTEM_EXPECTED_FRAGMENT_PRESENT=0
    if ! listing="$(git -C "$REPO" ls-tree "$SHA" -- "$source_unit")"; then
        echo "hapax-post-merge-deploy: cannot resolve exact system fragment at $SHA:$source_unit" >&2
        return 1
    fi
    [ -n "$listing" ] || return 0
    if [[ "$listing" == *$'\n'* ]]; then
        echo "hapax-post-merge-deploy: ambiguous exact system fragment at $SHA:$source_unit" >&2
        return 1
    fi
    read -r mode type object_and_path <<< "$listing"
    if [[ "$object_and_path" != *$'\t'* ]]; then
        return 1
    fi
    object_oid="${object_and_path%%$'\t'*}"
    tree_path="${object_and_path#*$'\t'}"
    if [ "$mode" != 100644 ] || [ "$type" != "blob" ] \
        || [ "$tree_path" != "$source_unit" ] \
        || ! [[ "$object_oid" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]]; then
        echo "hapax-post-merge-deploy: unsupported exact system fragment at $SHA:$source_unit" >&2
        return 1
    fi
    SYSTEM_EXPECTED_FRAGMENT_OID="$object_oid"
    SYSTEM_EXPECTED_FRAGMENT_PRESENT=1
}

system_dropin_file_set_witness() {
    local records="$1" path oid extra witness count=0
    if [ -z "$records" ]; then
        printf 'none\n'
        return 0
    fi
    [ "${#records}" -le 131072 ] || return 1
    while IFS=$'\t' read -r path oid extra; do
        [ -n "$path" ] && [ -n "$oid" ] && [ -z "$extra" ] || return 1
        if ! [[ "$oid" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]] \
            || ! witness="$(system_unit_file_witness "$path" "$oid")" \
            || [[ "$witness" != $'present\t'"$oid"$'\t'* ]]; then
            return 1
        fi
        printf '%s\t%s\n' "$path" "$witness"
        count=$((count + 1))
        [ "$count" -le 512 ] || return 1
    done <<< "$records"
    [ "$count" -gt 0 ]
}

system_dropin_directory_witness() {
    local unit_name="$1" witness
    if ! witness="$(
        system_unit_file_witness \
            "$SYSTEMD_SYSTEM_DIR/$unit_name.d/.hapax-directory-witness" ""
    )" \
        || [[ "$witness" != absent$'\t'* ]]; then
        return 1
    fi
    printf '%s\n' "$witness"
}

system_dropin_paths_match() {
    local observed="$1" expected="$2"
    [ "${#observed}" -le 131072 ] || return 1
    [ "${#expected}" -le 131072 ] || return 1
    /usr/bin/python3 -I -S - "$observed" "$expected" <<'PY'
from __future__ import annotations

import os
import sys

observed = sys.argv[1].split()
expected = [line for line in sys.argv[2].splitlines() if line]
if len(observed) != len(set(observed)) or len(expected) != len(set(expected)):
    raise SystemExit(1)
if any(not path.startswith("/") or any(char.isspace() for char in path) for path in observed):
    raise SystemExit(1)
raise SystemExit(0 if set(observed) == set(expected) else 1)
PY
}

pending_system_scope_absent_for_user_path() {
    local source_path="$1" rel base system_dest manager_unit
    local file_before file_after manager_record line
    local load_state fragment_path dropin_paths need_reload
    local record_ok property_count load_seen fragment_seen dropins_seen reload_seen
    rel="${source_path#systemd/units/}"
    case "$rel" in
        *.d/*.conf)
            base="${rel%%.d/*}"
            system_dest="$SYSTEMD_SYSTEM_DIR/$rel"
            ;;
        *)
            base="$(basename "$rel")"
            system_dest="$SYSTEMD_SYSTEM_DIR/$base"
            ;;
    esac
    manager_unit="$base"
    if [[ "$manager_unit" == *@.* ]]; then
        manager_unit="${manager_unit/@./@hapax-post-merge-witness.}"
    fi
    if ! file_before="$(system_unit_file_witness "$system_dest" "")" \
        || [[ "$file_before" != absent$'\t'* ]]; then
        return 1
    fi
    if ! manager_record="$(
        systemctl show "$manager_unit" \
            --property=LoadState,FragmentPath,DropInPaths,NeedDaemonReload --no-pager
    )"; then
        return 1
    fi
    load_state=""
    fragment_path=""
    dropin_paths=""
    need_reload=""
    record_ok=1
    property_count=0
    load_seen=0
    fragment_seen=0
    dropins_seen=0
    reload_seen=0
    while IFS= read -r line; do
        case "$line" in
            LoadState=*)
                [ "$load_seen" -eq 0 ] || record_ok=0
                load_seen=1
                load_state="${line#LoadState=}"
                ;;
            FragmentPath=*)
                [ "$fragment_seen" -eq 0 ] || record_ok=0
                fragment_seen=1
                fragment_path="${line#FragmentPath=}"
                ;;
            DropInPaths=*)
                [ "$dropins_seen" -eq 0 ] || record_ok=0
                dropins_seen=1
                dropin_paths="${line#DropInPaths=}"
                ;;
            NeedDaemonReload=*)
                [ "$reload_seen" -eq 0 ] || record_ok=0
                reload_seen=1
                need_reload="${line#NeedDaemonReload=}"
                ;;
            *) record_ok=0 ;;
        esac
        property_count=$((property_count + 1))
    done <<< "$manager_record"
    if [ "$property_count" -ne 4 ] \
        || [ "$load_seen" -ne 1 ] \
        || [ "$fragment_seen" -ne 1 ] \
        || [ "$dropins_seen" -ne 1 ] \
        || [ "$reload_seen" -ne 1 ] \
        || [ "$load_state" != "not-found" ] \
        || [ -n "$fragment_path" ] \
        || [ -n "$dropin_paths" ] \
        || [ "$need_reload" != "no" ]; then
        record_ok=0
    fi
    [ "$record_ok" -eq 1 ] || return 1
    if ! file_after="$(system_unit_file_witness "$system_dest" "")" \
        || [ "$file_after" != "$file_before" ]; then
        return 1
    fi
}

for f in "${SYSTEMD_PENDING_USER_UNITS[@]}"; do
    if pending_system_scope_absent_for_user_path "$f"; then
        SYSTEMD_PENDING_REMOVE+=("$f")
        SYSTEMD+=("$f")
        echo "system-to-user transition witness converged: $f"
    else
        SYSTEMD_PENDING_ADD+=("$f")
        RUNTIME_DEFERRED+=("systemd-system-to-user:$f")
        echo "  runtime deferred: prior system installation for '$f' has not been proven absent; refusing user-manager publication" >&2
    fi
done
for f in "${SYSTEMD_PENDING_USER_DROPINS[@]}"; do
    if pending_system_scope_absent_for_user_path "$f"; then
        SYSTEMD_PENDING_REMOVE+=("$f")
        SYSTEMD_DROPINS+=("$f")
        echo "system-to-user transition witness converged: $f"
    else
        SYSTEMD_PENDING_ADD+=("$f")
        RUNTIME_DEFERRED+=("systemd-system-to-user:$f")
        echo "  runtime deferred: prior system installation for '$f' has not been proven absent; refusing user-manager publication" >&2
    fi
done

user_unit_absence_witness() {
    local unit_name="$1"
    /usr/bin/python3 -I -S - "$SYSTEMD_USER_DIR" "$unit_name" <<'PY'
from __future__ import annotations

import os
import re
import stat
import sys

root, unit = sys.argv[1:]
if (
    not root.startswith("/")
    or os.path.normpath(root) != root
    or re.fullmatch(r"[A-Za-z0-9_.@:-]+", unit) is None
):
    raise SystemExit(1)


def generation(value: os.stat_result) -> tuple[int, ...]:
    return (
        value.st_dev,
        value.st_ino,
        value.st_mode,
        value.st_uid,
        value.st_nlink,
        value.st_size,
        value.st_mtime_ns,
        value.st_ctime_ns,
    )


def trusted_directory(path: str) -> os.stat_result:
    value = os.lstat(path)
    if (
        not stat.S_ISDIR(value.st_mode)
        or value.st_uid != os.geteuid()
        or stat.S_IMODE(value.st_mode) & 0o022
    ):
        raise OSError(f"untrusted user-unit directory: {path}")
    return value


if not os.path.lexists(root):
    print("absent-root")
    raise SystemExit(0)

root_before = trusted_directory(root)
if os.path.lexists(os.path.join(root, unit)) or os.path.lexists(
    os.path.join(root, f"{unit}.d")
):
    raise SystemExit(1)

wants_before: dict[str, tuple[int, ...]] = {}
with os.scandir(root) as entries:
    names = sorted(entry.name for entry in entries if entry.name.endswith(".wants"))
if len(names) > 512 or len(names) != len(set(names)):
    raise SystemExit(1)
for name in names:
    if "/" in name or name in (".", ".."):
        raise SystemExit(1)
    wants_path = os.path.join(root, name)
    wants_before[name] = generation(trusted_directory(wants_path))
    if os.path.lexists(os.path.join(wants_path, unit)):
        raise SystemExit(1)

root_after = trusted_directory(root)
with os.scandir(root) as entries:
    names_after = sorted(entry.name for entry in entries if entry.name.endswith(".wants"))
if names_after != names:
    raise SystemExit(1)
wants_after = {
    name: generation(trusted_directory(os.path.join(root, name))) for name in names_after
}
if generation(root_before) != generation(root_after) or wants_before != wants_after:
    raise SystemExit(1)
print("root=" + ",".join(str(value) for value in generation(root_after)))
for name in names_after:
    print(name + "=" + ",".join(str(value) for value in wants_after[name]))
PY
}

reconcile_user_unit_absence() {
    local unit_name="$1" user_unit="$SYSTEMD_USER_DIR/$1" user_dropin_dir
    local wants_link user_record line load_state fragment_path active_state sub_state
    local record_ok property_count load_seen fragment_seen active_seen sub_seen
    local absence_before absence_after
    user_dropin_dir="$SYSTEMD_USER_DIR/$unit_name.d"
    systemctl --user disable --now "$unit_name" >/dev/null 2>&1 || true
    if [ -e "$user_unit" ] || [ -L "$user_unit" ]; then
        if ! rm -f -- "$user_unit"; then
            echo "hapax-post-merge-deploy: failed to remove stale user unit $user_unit" >&2
            return 1
        fi
        DID_ANYTHING=1
    fi
    for wants_link in "$SYSTEMD_USER_DIR"/*.wants/"$unit_name"; do
        [ -e "$wants_link" ] || [ -L "$wants_link" ] || continue
        if ! rm -f -- "$wants_link"; then
            echo "hapax-post-merge-deploy: failed to remove stale user wants link $wants_link" >&2
            return 1
        fi
        DID_ANYTHING=1
    done
    if [ -e "$user_dropin_dir" ] || [ -L "$user_dropin_dir" ]; then
        if ! rm -rf -- "$user_dropin_dir"; then
            echo "hapax-post-merge-deploy: failed to remove stale user drop-in directory $user_dropin_dir" >&2
            return 1
        fi
        DID_ANYTHING=1
    fi
    if ! systemctl --user daemon-reload; then
        echo "hapax-post-merge-deploy: failed to reload the user manager while retiring stale $unit_name artifacts" >&2
        return 1
    fi
    if ! absence_before="$(user_unit_absence_witness "$unit_name")"; then
        echo "hapax-post-merge-deploy: cannot establish stable filesystem absence for stale user $unit_name artifacts" >&2
        return 1
    fi
    if ! user_record="$(
        systemctl --user show "$unit_name" \
            --property=LoadState,FragmentPath,ActiveState,SubState --no-pager
    )"; then
        echo "hapax-post-merge-deploy: cannot obtain the combined user-manager absence witness for $unit_name" >&2
        return 1
    fi
    load_state=""
    fragment_path=""
    active_state=""
    sub_state=""
    record_ok=1
    property_count=0
    load_seen=0
    fragment_seen=0
    active_seen=0
    sub_seen=0
    while IFS= read -r line; do
        case "$line" in
            LoadState=*)
                [ "$load_seen" -eq 0 ] || record_ok=0
                load_seen=1
                load_state="${line#LoadState=}"
                ;;
            FragmentPath=*)
                [ "$fragment_seen" -eq 0 ] || record_ok=0
                fragment_seen=1
                fragment_path="${line#FragmentPath=}"
                ;;
            ActiveState=*)
                [ "$active_seen" -eq 0 ] || record_ok=0
                active_seen=1
                active_state="${line#ActiveState=}"
                ;;
            SubState=*)
                [ "$sub_seen" -eq 0 ] || record_ok=0
                sub_seen=1
                sub_state="${line#SubState=}"
                ;;
            *) record_ok=0 ;;
        esac
        property_count=$((property_count + 1))
    done <<< "$user_record"
    if [ "$property_count" -ne 4 ] \
        || [ "$load_seen" -ne 1 ] \
        || [ "$fragment_seen" -ne 1 ] \
        || [ "$active_seen" -ne 1 ] \
        || [ "$sub_seen" -ne 1 ] \
        || [ "$load_state" != "not-found" ] \
        || [ -n "$fragment_path" ] \
        || [ "$active_state" != "inactive" ] \
        || [ "$sub_state" != "dead" ]; then
        record_ok=0
    fi
    if [ "$record_ok" -ne 1 ]; then
        echo "hapax-post-merge-deploy: stale user-manager state remains for system-scoped $unit_name" >&2
        return 1
    fi
    if ! absence_after="$(user_unit_absence_witness "$unit_name")" \
        || [ "$absence_after" != "$absence_before" ]; then
        echo "hapax-post-merge-deploy: stale user $unit_name filesystem state changed across the manager absence witness" >&2
        return 1
    fi
}

# A system-owned base unit owns all of its drop-ins. Never materialize those
# bytes in the user manager; remove stale user artifacts and leave the exact
# system installation to an authorized runtime deploy.
if [ "${#SYSTEMD_SYSTEM_DROPINS[@]}" -gt 0 ]; then
    echo "system-scoped systemd drop-ins changed (${#SYSTEMD_SYSTEM_DROPINS[@]}):"
    for f in "${SYSTEMD_SYSTEM_DROPINS[@]}"; do
        rel="${f#systemd/units/}"
        dropin_dir="$(dirname "$rel")"
        unit_name="${dropin_dir%.d}"
        system_dest="$SYSTEMD_SYSTEM_DIR/$rel"
        if ! reconcile_user_unit_absence "$unit_name"; then
            exit 1
        fi
        if ! git_blob_state_at "$SHA" "$f" "system-scoped systemd drop-in"; then
            exit 2
        fi
        dropin_base_source="${f%%.d/*}"
        if ! load_expected_system_dropin_paths "$dropin_base_source"; then
            exit 2
        fi
        expected_system_dropins="$SYSTEM_EXPECTED_DROPIN_PATHS"
        expected_system_dropin_records="$SYSTEM_EXPECTED_DROPIN_RECORDS"
        if ! load_expected_system_fragment_oid "$dropin_base_source"; then
            exit 2
        fi
        expected_system_fragment_oid="$SYSTEM_EXPECTED_FRAGMENT_OID"
        expected_system_fragment_present="$SYSTEM_EXPECTED_FRAGMENT_PRESENT"
        if [ "$expected_system_fragment_present" -eq 0 ] \
            && [ -n "$expected_system_dropin_records" ]; then
            echo "hapax-post-merge-deploy: exact SHA has system drop-ins without their owning fragment at $SHA:$dropin_base_source" >&2
            exit 2
        fi
        system_fragment_dest="$SYSTEMD_SYSTEM_DIR/$unit_name"
        system_dropin_converged=0
        system_dropin_file_before=""
        if system_dropin_file_before="$(system_unit_file_witness "$system_dest" "$GIT_BLOB_OID")"; then
            if [ "$GIT_BLOB_PRESENT" -eq 1 ] \
                && [[ "$system_dropin_file_before" == $'present\t'"$GIT_BLOB_OID"$'\t'* ]]; then
                system_dropin_converged=1
            elif [ "$GIT_BLOB_PRESENT" -eq 0 ] \
                && [[ "$system_dropin_file_before" == absent$'\t'* ]]; then
                system_dropin_converged=1
            fi
        else
            echo "  runtime deferred: cannot obtain a stable file witness for '$system_dest'" >&2
        fi
        system_fragment_file_before=""
        system_dropin_files_before=""
        system_dropin_directory_before=""
        if [ "$system_dropin_converged" -eq 1 ]; then
            if ! system_fragment_file_before="$(
                system_unit_file_witness \
                    "$system_fragment_dest" "$expected_system_fragment_oid"
            )"; then
                system_dropin_converged=0
            elif [ "$expected_system_fragment_present" -eq 1 ] \
                && [[ "$system_fragment_file_before" != $'present\t'"$expected_system_fragment_oid"$'\t'* ]]; then
                system_dropin_converged=0
            elif [ "$expected_system_fragment_present" -eq 0 ] \
                && [[ "$system_fragment_file_before" != absent$'\t'* ]]; then
                system_dropin_converged=0
            elif ! system_dropin_files_before="$(
                system_dropin_file_set_witness "$expected_system_dropin_records"
            )"; then
                system_dropin_converged=0
            elif ! system_dropin_directory_before="$(
                system_dropin_directory_witness "$unit_name"
            )"; then
                system_dropin_converged=0
            fi
            if [ "$system_dropin_converged" -ne 1 ]; then
                echo "  runtime deferred: effective fragment or sibling drop-in bytes for '$unit_name' are not exact trusted Git objects" >&2
            fi
        fi
        system_dropin_manager_converged=0
        if [ "$system_dropin_converged" -eq 1 ]; then
            system_manager_record=""
            if ! system_manager_record="$(
                systemctl show "$unit_name" \
                    --property=LoadState,FragmentPath,DropInPaths,NeedDaemonReload --no-pager
            )"; then
                echo "  runtime deferred: cannot query the system-manager witness for '$unit_name'" >&2
            else
                system_load_state=""
                system_fragment_path=""
                system_dropin_paths=""
                system_need_reload=""
                system_manager_record_ok=1
                system_manager_property_count=0
                system_load_seen=0
                system_fragment_seen=0
                system_dropins_seen=0
                system_reload_seen=0
                while IFS= read -r system_manager_line; do
                    case "$system_manager_line" in
                        LoadState=*)
                            [ "$system_load_seen" -eq 0 ] || system_manager_record_ok=0
                            system_load_seen=1
                            system_load_state="${system_manager_line#LoadState=}"
                            ;;
                        FragmentPath=*)
                            [ "$system_fragment_seen" -eq 0 ] || system_manager_record_ok=0
                            system_fragment_seen=1
                            system_fragment_path="${system_manager_line#FragmentPath=}"
                            ;;
                        DropInPaths=*)
                            [ "$system_dropins_seen" -eq 0 ] || system_manager_record_ok=0
                            system_dropins_seen=1
                            system_dropin_paths="${system_manager_line#DropInPaths=}"
                            ;;
                        NeedDaemonReload=*)
                            [ "$system_reload_seen" -eq 0 ] || system_manager_record_ok=0
                            system_reload_seen=1
                            system_need_reload="${system_manager_line#NeedDaemonReload=}"
                            ;;
                        *) system_manager_record_ok=0 ;;
                    esac
                    system_manager_property_count=$((system_manager_property_count + 1))
                done <<< "$system_manager_record"
                if [ "$system_manager_property_count" -ne 4 ] \
                    || [ "$system_load_seen" -ne 1 ] \
                    || [ "$system_fragment_seen" -ne 1 ] \
                    || [ "$system_dropins_seen" -ne 1 ] \
                    || [ "$system_reload_seen" -ne 1 ] \
                    || [ -z "$system_load_state" ] \
                    || [ -z "$system_need_reload" ]; then
                    system_manager_record_ok=0
                fi
                if [ "$system_manager_record_ok" -ne 1 ]; then
                    echo "  runtime deferred: malformed combined system-manager witness for '$unit_name'" >&2
                elif [ "$expected_system_fragment_present" -eq 1 ] \
                    && [ "$system_load_state" = "loaded" ] \
                    && [ "$system_fragment_path" = "$SYSTEMD_SYSTEM_DIR/$unit_name" ] \
                    && system_dropin_paths_match \
                        "$system_dropin_paths" "$expected_system_dropins" \
                    && [ "$system_need_reload" = "no" ]; then
                    system_dropin_manager_converged=1
                elif [ "$expected_system_fragment_present" -eq 0 ] \
                    && [ "$system_load_state" = "not-found" ] \
                    && [ -z "$system_fragment_path" ] \
                    && system_dropin_paths_match \
                        "$system_dropin_paths" "$expected_system_dropins" \
                    && [ "$system_need_reload" = "no" ]; then
                    system_dropin_manager_converged=1
                else
                    echo "  runtime deferred: system manager has not loaded the exact '$system_dest' state" >&2
                fi
            fi
            if [ "$system_dropin_manager_converged" -eq 1 ]; then
                system_dropin_file_after=""
                system_fragment_file_after=""
                system_dropin_files_after=""
                system_dropin_directory_after=""
                if ! system_dropin_file_after="$(
                    system_unit_file_witness "$system_dest" "$GIT_BLOB_OID"
                )" \
                    || [ "$system_dropin_file_after" != "$system_dropin_file_before" ] \
                    || ! system_fragment_file_after="$(
                        system_unit_file_witness \
                            "$system_fragment_dest" "$expected_system_fragment_oid"
                    )" \
                    || [ "$system_fragment_file_after" != "$system_fragment_file_before" ] \
                    || ! system_dropin_files_after="$(
                        system_dropin_file_set_witness "$expected_system_dropin_records"
                    )" \
                    || [ "$system_dropin_files_after" != "$system_dropin_files_before" ] \
                    || ! system_dropin_directory_after="$(
                        system_dropin_directory_witness "$unit_name"
                    )" \
                    || [ "$system_dropin_directory_after" != "$system_dropin_directory_before" ]; then
                    system_dropin_manager_converged=0
                    echo "  runtime deferred: effective fragment/drop-in generations for '$unit_name' changed across the system-manager witness" >&2
                fi
            fi
        fi
        if [ "$system_dropin_converged" -eq 1 ] \
            && [ "$system_dropin_manager_converged" -eq 1 ]; then
            SYSTEMD_PENDING_REMOVE+=("$f")
            echo "  exact file and system-manager witness: '$system_dest'"
        else
            SYSTEMD_PENDING_ADD+=("$f")
            RUNTIME_DEFERRED+=("systemd-system-dropin:$f")
            echo "  runtime deferred: '$system_dest' lacks an exact $SHA file-and-manager witness; next action: install or remove it through an authorized system-unit installer, reload the system manager, then rerun this deploy" >&2
        fi
    done
fi

# --- user-scoped systemd unit drop-ins ---
if [ "${#SYSTEMD_DROPINS[@]}" -gt 0 ]; then
    echo "systemd drop-ins changed (${#SYSTEMD_DROPINS[@]}):"
    DROPIN_BASE_REF="${SINCE:-${FIRST_PARENT:-}}"
    for f in "${SYSTEMD_DROPINS[@]}"; do
        validate_generic_dropin_activation "$f"
    done
    mkdir -p "$SYSTEMD_USER_DIR"
    DROPIN_UNITS_TO_RESTART=()
    for f in "${SYSTEMD_DROPINS[@]}"; do
        rel="${f#systemd/units/}"
        dropin_dir="$(dirname "$rel")"
        conf_name="$(basename "$f")"
        unit_name="${dropin_dir%.d}"
        dest_dir="$SYSTEMD_USER_DIR/$dropin_dir"
        dest="$dest_dir/$conf_name"
        mkdir -p "$dest_dir"
        if git cat-file -e "$SHA:$f" 2>/dev/null; then
            if ! dropin_temp="$(mktemp "$dest_dir/.${conf_name}.tmp.XXXXXX")"; then
                echo "hapax-post-merge-deploy: unable to reserve a temporary path for $f; next action: verify destination ownership and capacity, then rerun the governed deploy" >&2
                exit 1
            fi
            if ! git show "$SHA:$f" > "$dropin_temp"; then
                rm -f "$dropin_temp" 2>/dev/null || true
                echo "hapax-post-merge-deploy: unable to materialize $f before drop-in activation; next action: verify the commit object and rerun the governed deploy" >&2
                exit 1
            fi
            chmod 0644 "$dropin_temp"
            if ! mv -fT "$dropin_temp" "$dest"; then
                rm -f "$dropin_temp" 2>/dev/null || true
                echo "hapax-post-merge-deploy: unable to atomically replace drop-in $dest; next action: remove unsafe destination drift and rerun the governed deploy" >&2
                exit 1
            fi
            echo "  '$f' -> '$dest'"
            DROPIN_UNITS_TO_RESTART+=("$unit_name")
        else
            rm -fv "$dest" || true
        fi
    done
    systemctl --user daemon-reload
    for u in "${DROPIN_UNITS_TO_RESTART[@]}"; do
        if [[ "$u" == *.slice ]]; then
            slice_props=()
            for conf in "$SYSTEMD_USER_DIR/$u.d"/*.conf; do
                [ -f "$conf" ] || continue
                content="$(cat "$conf")"
                issue="$(printf '%s\n' "$content" | slice_memory_issue_from_content)"
                if [ -n "$issue" ]; then
                    echo "hapax-post-merge-deploy: refusing runtime promotion from unsafe generic slice drop-in $conf after daemon reload: $issue; next action: repair local slice drift and rerun the governed deploy" >&2
                    exit 1
                fi
                while IFS= read -r prop; do
                    slice_props+=("$prop")
                done < <(printf '%s\n' "$content" | slice_memory_properties_from_content)
            done
            if [ "${#slice_props[@]}" -gt 0 ]; then
                echo "applying active slice properties for $u without restart"
                systemctl --user set-property --runtime "$u" "${slice_props[@]}"
            else
                echo "not restarting active slice $u after drop-in deploy; no runtime set-property candidates found"
            fi
        elif systemctl --user is-active --quiet "$u"; then
            echo "restarting $u"
            restart_user_unit "$u"
        elif [[ "$u" == *.timer ]]; then
            echo "try-restarting $u"
            systemctl --user try-restart "$u" || true
        fi
    done
    DID_ANYTHING=1
fi

# --- systemd units ---
if [ "${#SYSTEMD_SYSTEM[@]}" -gt 0 ]; then
    echo "system-scoped systemd units changed (${#SYSTEMD_SYSTEM[@]}):"
    mkdir -p "$SYSTEMD_USER_DIR"
    for f in "${SYSTEMD_SYSTEM[@]}"; do
        base="$(basename "$f")"
        system_dest="$SYSTEMD_SYSTEM_DIR/$base"
        system_manager_unit="$base"
        if [[ "$system_manager_unit" == *@.* ]]; then
            system_manager_unit="${system_manager_unit/@./@hapax-post-merge-witness.}"
        fi
        echo "  '$f' marked Hapax-Install-Scope: system; reconciling user copy and verifying exact system installation"
        if ! git_blob_state_at "$SHA" "$f" "system-scoped systemd unit"; then
            exit 2
        fi
        if ! load_expected_system_dropin_paths "$f"; then
            exit 2
        fi
        expected_system_dropins="$SYSTEM_EXPECTED_DROPIN_PATHS"
        expected_system_dropin_records="$SYSTEM_EXPECTED_DROPIN_RECORDS"
        if ! reconcile_user_unit_absence "$base"; then
            exit 1
        fi
        system_unit_converged=0
        system_file_before=""
        if system_file_before="$(system_unit_file_witness "$system_dest" "$GIT_BLOB_OID")"; then
            if [ "$GIT_BLOB_PRESENT" -eq 1 ] \
                && [[ "$system_file_before" == $'present\t'"$GIT_BLOB_OID"$'\t'* ]]; then
                system_unit_converged=1
            elif [ "$GIT_BLOB_PRESENT" -eq 0 ] \
                && [[ "$system_file_before" == absent$'\t'* ]]; then
                system_unit_converged=1
            fi
        else
            echo "  runtime deferred: cannot obtain a stable file witness for '$system_dest'" >&2
        fi
        system_dropin_files_before=""
        system_dropin_directory_before=""
        if [ "$system_unit_converged" -eq 1 ] \
            && ! system_dropin_files_before="$(
                system_dropin_file_set_witness "$expected_system_dropin_records"
            )"; then
            system_unit_converged=0
            echo "  runtime deferred: effective sibling drop-in bytes for '$base' are not exact trusted Git objects" >&2
        fi
        if [ "$system_unit_converged" -eq 1 ] \
            && ! system_dropin_directory_before="$(
                system_dropin_directory_witness "$base"
            )"; then
            system_unit_converged=0
            echo "  runtime deferred: sibling drop-in directory for '$base' is not a stable trusted generation" >&2
        fi
        system_manager_converged=0
        if [ "$system_unit_converged" -eq 1 ]; then
            system_manager_record=""
            if ! system_manager_record="$(
                systemctl show "$system_manager_unit" \
                    --property=LoadState,FragmentPath,DropInPaths,NeedDaemonReload --no-pager
            )"; then
                echo "  runtime deferred: cannot query the system-manager witness for '$system_manager_unit'" >&2
            else
                system_load_state=""
                system_fragment_path=""
                system_dropin_paths=""
                system_need_reload=""
                system_manager_record_ok=1
                system_manager_property_count=0
                system_load_seen=0
                system_fragment_seen=0
                system_dropins_seen=0
                system_reload_seen=0
                while IFS= read -r system_manager_line; do
                    case "$system_manager_line" in
                        LoadState=*)
                            [ "$system_load_seen" -eq 0 ] || system_manager_record_ok=0
                            system_load_seen=1
                            system_load_state="${system_manager_line#LoadState=}"
                            ;;
                        FragmentPath=*)
                            [ "$system_fragment_seen" -eq 0 ] || system_manager_record_ok=0
                            system_fragment_seen=1
                            system_fragment_path="${system_manager_line#FragmentPath=}"
                            ;;
                        DropInPaths=*)
                            [ "$system_dropins_seen" -eq 0 ] || system_manager_record_ok=0
                            system_dropins_seen=1
                            system_dropin_paths="${system_manager_line#DropInPaths=}"
                            ;;
                        NeedDaemonReload=*)
                            [ "$system_reload_seen" -eq 0 ] || system_manager_record_ok=0
                            system_reload_seen=1
                            system_need_reload="${system_manager_line#NeedDaemonReload=}"
                            ;;
                        *) system_manager_record_ok=0 ;;
                    esac
                    system_manager_property_count=$((system_manager_property_count + 1))
                done <<< "$system_manager_record"
                if [ "$system_manager_property_count" -ne 4 ] \
                    || [ "$system_load_seen" -ne 1 ] \
                    || [ "$system_fragment_seen" -ne 1 ] \
                    || [ "$system_dropins_seen" -ne 1 ] \
                    || [ "$system_reload_seen" -ne 1 ] \
                    || [ -z "$system_load_state" ] \
                    || [ -z "$system_need_reload" ]; then
                    system_manager_record_ok=0
                fi
                if [ "$system_manager_record_ok" -ne 1 ]; then
                    echo "  runtime deferred: malformed combined system-manager witness for '$system_manager_unit'" >&2
                elif [ "$GIT_BLOB_PRESENT" -eq 1 ] \
                && [ "$system_load_state" = "loaded" ] \
                && [ "$system_fragment_path" = "$system_dest" ] \
                && system_dropin_paths_match \
                    "$system_dropin_paths" "$expected_system_dropins" \
                && [ "$system_need_reload" = "no" ]; then
                    system_manager_converged=1
                elif [ "$GIT_BLOB_PRESENT" -eq 0 ] \
                && [ "$system_load_state" = "not-found" ] \
                && [ -z "$system_fragment_path" ] \
                && system_dropin_paths_match \
                    "$system_dropin_paths" "$expected_system_dropins" \
                && [ "$system_need_reload" = "no" ]; then
                    system_manager_converged=1
                else
                    echo "  runtime deferred: system manager has not loaded the exact '$system_dest' state" >&2
                fi
            fi
            if [ "$system_manager_converged" -eq 1 ]; then
                system_file_after=""
                system_dropin_files_after=""
                system_dropin_directory_after=""
                if ! system_file_after="$(
                    system_unit_file_witness "$system_dest" "$GIT_BLOB_OID"
                )" \
                    || [ "$system_file_after" != "$system_file_before" ] \
                    || ! system_dropin_files_after="$(
                        system_dropin_file_set_witness "$expected_system_dropin_records"
                    )" \
                    || [ "$system_dropin_files_after" != "$system_dropin_files_before" ] \
                    || ! system_dropin_directory_after="$(
                        system_dropin_directory_witness "$base"
                    )" \
                    || [ "$system_dropin_directory_after" != "$system_dropin_directory_before" ]; then
                    system_manager_converged=0
                    echo "  runtime deferred: effective fragment/drop-in generations for '$base' changed across the system-manager witness" >&2
                fi
            fi
        fi
        if [ "$system_unit_converged" -eq 1 ] && [ "$system_manager_converged" -eq 1 ]; then
            SYSTEMD_PENDING_REMOVE+=("$f")
            echo "  exact file and system-manager witness: '$system_dest'"
        else
            SYSTEMD_PENDING_ADD+=("$f")
            RUNTIME_DEFERRED+=("systemd-system:$f")
            echo "  runtime deferred: '$system_dest' lacks an exact $SHA file-and-manager witness; next action: install or remove it through an authorized system-unit installer, reload the system manager, then rerun this deploy" >&2
        fi
    done
fi

PUBLISHED_GIT_CONTENT=""
publish_systemd_unit_at_sha() {
    local source_path="$1" dest="$2" dest_dir base temp
    PUBLISHED_GIT_CONTENT=""
    dest_dir="$(dirname "$dest")"
    base="$(basename "$dest")"
    if ! temp="$(mktemp "$dest_dir/.${base}.tmp.XXXXXX")"; then
        echo "hapax-post-merge-deploy: failed to reserve an atomic systemd unit temporary beside $dest" >&2
        return 1
    fi
    if ! git -C "$REPO" show "$SHA:$source_path" > "$temp"; then
        rm -f -- "$temp" 2>/dev/null || true
        echo "hapax-post-merge-deploy: failed to materialize systemd unit at $SHA:$source_path; existing destination is unchanged" >&2
        return 1
    fi
    if ! PUBLISHED_GIT_CONTENT="$(/usr/bin/cat -- "$temp")"; then
        rm -f -- "$temp" 2>/dev/null || true
        echo "hapax-post-merge-deploy: failed to read staged systemd unit at $temp" >&2
        return 1
    fi
    if ! chmod 0644 "$temp"; then
        rm -f -- "$temp" 2>/dev/null || true
        echo "hapax-post-merge-deploy: failed to set staged systemd unit mode for $source_path" >&2
        return 1
    fi
    if ! mv -fT -- "$temp" "$dest"; then
        rm -f -- "$temp" 2>/dev/null || true
        echo "hapax-post-merge-deploy: failed to atomically publish systemd unit $dest" >&2
        return 1
    fi
}

if [ "${#SYSTEMD[@]}" -gt 0 ]; then
    echo "systemd units changed (${#SYSTEMD[@]}):"
    mkdir -p "$SYSTEMD_USER_DIR"
    SYSTEMD_INSTALLED=()
    declare -A SYSTEMD_INSTALLED_CONTENT=()
    for f in "${SYSTEMD[@]}"; do
        base="$(basename "$f")"
        dest="$SYSTEMD_USER_DIR/$base"
        if ! git_blob_state_at "$SHA" "$f" "systemd unit"; then
            exit 2
        fi
        if [ "$GIT_BLOB_PRESENT" -eq 1 ]; then
            if ! publish_systemd_unit_at_sha "$f" "$dest"; then
                exit 1
            fi
            echo "  '$f' -> '$dest'"
            cleanup_known_stale_user_dropins_for_unit "$base"
            SYSTEMD_INSTALLED+=("$f")
            SYSTEMD_INSTALLED_CONTENT["$f"]="$PUBLISHED_GIT_CONTENT"
        else
            rm -fv "$dest" || true
        fi
    done
    systemctl --user daemon-reload
    for f in "${SYSTEMD_INSTALLED[@]}"; do
        base="$(basename "$f")"
        unit_content="${SYSTEMD_INSTALLED_CONTENT[$f]}"
        if unit_content_parked "$unit_content"; then
            echo "parking $base (Hapax-Parked marker)"
            if ! systemctl --user disable --now "$base"; then
                echo "hapax-post-merge-deploy: unable to disable parked unit $base; next action: inspect systemctl --user status $base and rerun the governed deploy" >&2
                exit 1
            fi
            systemctl --user reset-failed "$base" >/dev/null 2>&1 || true
        elif systemctl --user is-active --quiet "$base"; then
            if [[ "$base" == *.timer ]] && unit_content_timer_enable_only "$unit_content"; then
                echo "leaving active $base running (Hapax-Timer-Enable-Only marker; not restarting during deploy)"
                systemctl --user enable "$base"
                continue
            fi
            # Already running — restart to pick up the new unit definition.
            if [ "$base" = "hapax-coord.service" ]; then
                stage_coord_activation_before_restart
                echo "hapax-coord.service restarted by hapax-coord-deploy"
                continue
            fi
            echo "restarting $base"
            restart_user_unit "$base"
        elif [[ "$base" == *.timer ]] && unit_content_timer_enable_only "$unit_content"; then
            echo "enabling $base (Hapax-Timer-Enable-Only marker; not starting during deploy)"
            systemctl --user enable "$base"
        elif unit_content_auto_enable "$unit_content"; then
            # Marked `# Hapax-Auto-Enable: true` (+ [Install]): enable+start so a
            # freshly-merged service OR timer goes live instead of sleeping.
            # try-restart is a no-op for a never-enabled unit (the FM-11 gap).
            if [ "$base" = "hapax-coord.service" ]; then
                stage_coord_activation_before_restart
                echo "auto-enabling $base (Hapax-Auto-Enable marker; activation staged by hapax-coord-deploy)"
                systemctl --user enable "$base"
            else
                echo "auto-enabling $base (Hapax-Auto-Enable marker)"
                systemctl --user enable --now "$base"
            fi
        elif [[ "$base" == *.timer ]]; then
            # Back-compat: an unmarked NEW timer still auto-enables — timers are
            # inert until started, and this has been the behaviour since #3475.
            echo "enabling+starting $base"
            systemctl --user enable --now "$base"
        fi
    done
    DID_ANYTHING=1
fi

declare -A USER_PRESET_CONTENT=()
preset_enables_unit_at_sha() {
    local unit="$1" preset
    for preset in "${USER_PRESETS[@]}"; do
        [ -n "${USER_PRESET_CONTENT[$preset]+present}" ] || continue
        if grep -Eq "^[[:space:]]*enable[[:space:]]+$unit([[:space:]]|$)" \
            <<< "${USER_PRESET_CONTENT[$preset]}"; then
            return 0
        fi
    done
    return 1
}

install_governed_intake_unit_at_sha() {
    local unit="$1" reason="$2"
    local rel dest
    rel="systemd/units/$unit"
    dest="$SYSTEMD_USER_DIR/$unit"
    if ! publish_systemd_unit_at_sha "$rel" "$dest"; then
        return 1
    fi
    echo "  '$rel' -> '$dest' ($reason)"
    cleanup_known_stale_user_dropins_for_unit "$unit"
    return 0
}

governed_intake_unit_exists_at_sha() {
    local unit="$1"
    local rel="systemd/units/$unit"
    if ! git_blob_state_at "$SHA" "$rel" "governed intake systemd unit"; then
        return 2
    fi
    if [ "$GIT_BLOB_PRESENT" -eq 1 ]; then
        return 0
    fi
    echo "  warning: preset requires $unit but $rel is absent at $SHA; cannot activate governed intake. Next action: add $rel at the deployed SHA or remove the preset enable for its timer." >&2
    return 1
}

install_governed_intake_preset_units() {
    local set timer unit install_ok unit_status
    GOVERNED_INTAKE_PRESET_ENABLE=()
    for set in "${GOVERNED_INTAKE_PRESET_UNIT_SETS[@]}"; do
        timer="${set%% *}"
        preset_enables_unit_at_sha "$timer" || continue
        install_ok=1
        for unit in $set; do
            if governed_intake_unit_exists_at_sha "$unit"; then
                :
            else
                unit_status=$?
                if [ "$unit_status" -gt 1 ]; then
                    return "$unit_status"
                fi
                install_ok=0
            fi
        done
        [ "$install_ok" -eq 1 ] || continue
        for unit in $set; do
            if ! install_governed_intake_unit_at_sha "$unit" "preset-activated governed intake unit"; then
                return 1
            fi
        done
        GOVERNED_INTAKE_PRESET_ENABLE+=("$timer")
    done
}

# --- systemd user presets ---
if [ "${#USER_PRESETS[@]}" -gt 0 ]; then
    echo "systemd user presets changed (${#USER_PRESETS[@]}):"
    mkdir -p "$SYSTEMD_USER_PRESET_DIR"
    mkdir -p "$SYSTEMD_USER_DIR"
    for f in "${USER_PRESETS[@]}"; do
        base="$(basename "$f")"
        dest="$SYSTEMD_USER_PRESET_DIR/$base"
        if ! git_blob_state_at "$SHA" "$f" "systemd user preset"; then
            exit 2
        fi
        if [ "$GIT_BLOB_PRESENT" -eq 1 ]; then
            if ! publish_systemd_unit_at_sha "$f" "$dest"; then
                exit 1
            fi
            USER_PRESET_CONTENT["$f"]="$PUBLISHED_GIT_CONTENT"
            echo "  '$f' -> '$dest'"
        else
            if ! rm -fv -- "$dest"; then
                echo "hapax-post-merge-deploy: failed to remove deleted systemd user preset $dest" >&2
                exit 1
            fi
        fi
    done
    install_governed_intake_preset_units
    systemctl --user daemon-reload
    for unit in "${GOVERNED_INTAKE_PRESET_ENABLE[@]}"; do
        echo "enable+starting $unit (governed intake preset)"
        systemctl --user enable --now "$unit"
    done
    DID_ANYTHING=1
fi

publish_git_executable_at_sha() {
    local source_path="$1" dest="$2" dest_dir base temp
    dest_dir="$(dirname "$dest")"
    base="$(basename "$dest")"
    if ! temp="$(mktemp "$dest_dir/.${base}.tmp.XXXXXX")"; then
        echo "hapax-post-merge-deploy: unable to reserve a temporary launcher beside $dest; next action: verify destination ownership and capacity, then rerun the governed deploy" >&2
        return 1
    fi
    if ! git -C "$REPO" show "$SHA:$source_path" > "$temp"; then
        rm -f "$temp" 2>/dev/null || true
        echo "hapax-post-merge-deploy: unable to materialize $source_path for $dest; next action: verify the commit object and rerun the governed deploy" >&2
        return 1
    fi
    chmod 0755 "$temp"
    if ! mv -fT -- "$temp" "$dest"; then
        rm -f "$temp" 2>/dev/null || true
        echo "hapax-post-merge-deploy: unable to atomically publish launcher $dest; next action: move unsafe destination drift aside and rerun the governed deploy" >&2
        return 1
    fi
}

# --- scripts/hapax-* release copies ---
if [ "${#SCRIPTS[@]}" -gt 0 ]; then
    echo "scripts changed (${#SCRIPTS[@]}):"
    mkdir -p "$LOCAL_BIN"
    for f in "${SCRIPTS[@]}"; do
        base="$(basename "$f")"
        dest="$LOCAL_BIN/$base"
        if git -C "$REPO" cat-file -e "$SHA:$f" 2>/dev/null; then
            # Copy-from-SHA (the WATCHDOGS pattern): the installed script is the
            # deployed release's content, never a live view of a mutable tree.
            publish_git_executable_at_sha "$f" "$dest"
            echo "  '$f' -> '$dest' (copy @ ${SHA:0:9})"
        else
            rm -fv "$dest" || true
        fi
        matches="$(
            { grep -l -F "$dest" "$REPO/systemd/units/"*.service 2>/dev/null || true; \
              grep -l -F "$f" "$REPO/systemd/units/"*.service 2>/dev/null || true; } | sort -u
        )"
        for unit_path in $matches; do
            base_unit="$(basename "$unit_path")"
            if systemctl --user is-active --quiet "$base_unit"; then
                echo "  restarting $base_unit (uses $dest)"
                restart_user_unit "$base_unit"
            fi
        done
    done
    DID_ANYTHING=1
fi

# --- scripts/*.py / *.sh that back systemd user units ---
# The rebuild-services.timer cascade doesn't watch scripts/; if a
# systemd user unit's ExecStart references a script we just changed,
# restart that unit. Catches producers like hapax-youtube-viewer-count
# that live in scripts/ rather than agents/.
if [ "${#SCRIPT_PY[@]}" -gt 0 ]; then
    echo "backing-script changes (${#SCRIPT_PY[@]}):"
    for f in "${SCRIPT_PY[@]}"; do
        # Find units whose ExecStart references this script (any invocation form).
        # Search both the repo definitions and the installed user units.
        matches="$(grep -l -F "$f" "$REPO/systemd/units/"*.service 2>/dev/null || true)"
        for unit_path in $matches; do
            base="$(basename "$unit_path")"
            if systemctl --user is-active --quiet "$base"; then
                echo "  restarting $base (backs $f)"
                restart_user_unit "$base"
                DID_ANYTHING=1
            fi
        done
    done
fi

# --- Screwm Quake runtime assets ---
# Map, WAD, QC/CSQC, and DarkPlaces live-texture patch artifacts are loaded by
# the running renderer, not by the Python service rebuild loop. Install them
# after merge, then restart the visible renderer only when it is already active.
if [ "${#QUAKE_ASSETS[@]}" -gt 0 ]; then
    echo "quake assets changed (${#QUAKE_ASSETS[@]}):"
    for f in "${QUAKE_ASSETS[@]}"; do
        echo "  $f"
    done
    QUAKE_INSTALLER="$REPO/scripts/install-darkplaces-screwm-assets.sh"
    if [ ! -f "$QUAKE_INSTALLER" ]; then
        echo "hapax-post-merge-deploy: missing Screwm Quake asset installer: $QUAKE_INSTALLER" >&2
        exit 2
    fi
    echo "installing Screwm Quake assets"
    bash "$QUAKE_INSTALLER"
    if systemctl --user is-active --quiet hapax-darkplaces-v4l2.service; then
        echo "restarting hapax-darkplaces-v4l2.service (Screwm Quake assets changed)"
        restart_user_unit hapax-darkplaces-v4l2.service
    else
        echo "hapax-darkplaces-v4l2.service inactive; assets installed for next renderer start"
    fi
    DID_ANYTHING=1
fi

# --- canonical gate closure (reform FM-6 shim collapse) ---
# Every real deploy invocation reconciles the canonical hook closure, even when
# the current diff did not touch gate files. This closes the pre-existing-drift
# gap where a missed/failed deploy left ~/.local/lib/hapax/hooks stale forever
# while later merges stamped last-deployed-sha as healthy.
reconcile_canonical_gate_closure

if [ "$DID_ANYTHING" -eq 0 ] && [ "${#RUNTIME_DEFERRED[@]}" -gt 0 ]; then
    echo "merge $SHA: source staging completed; runtime work remains deferred (${RUNTIME_DEFERRED[*]})"
elif [ "$DID_ANYTHING" -eq 0 ]; then
    echo "merge $SHA: no manual deploys needed (only auto-rebuild paths changed)"
fi

# Smoke-runner gate (cc-task post-merge-smoke-deploy-wiring, 2026-05-02).
# DRY_RUN and REPORT_COVERAGE modes exited earlier so this only fires
# in real-deploy mode. The smoke runner inspects the diff for $SHA,
# fires gates that match, ntfy's on failure, and ALWAYS exits 0 — the
# deploy already happened; the smoke is informational. The script
# itself enforces the 0-exit contract; we still wrap with `|| true`
# defensively so a smoke-side bug can never block trace recording or
# the deploy script's normal exit. Rationale: shipping in #2148
# without a deploy-chain caller meant every smoke-side fix lived as
# dead code (zeta audit finding 2026-05-02, severity HIGH).
SMOKE_SCRIPT="$REPO/scripts/hapax-post-merge-smoke"
if [ -x "$SMOKE_SCRIPT" ]; then
    "$SMOKE_SCRIPT" "$SHA" || true
fi

# Self-verify the deploy symlinks resolve to the canonical tree (advisory:
# ntfy's on drift but never fails the deploy that just succeeded). This is the
# "live" half of the drift assertion — it runs every real deploy cycle so a
# dangling/foreign ~/.local/bin/hapax-* symlink can't sit unnoticed.
check_symlink_drift || true

trace_status="completed"
if [ "${#RUNTIME_DEFERRED[@]}" -gt 0 ]; then
    trace_status="completed_with_runtime_deferral"
fi
if ! finalize_deploy_receipts "$trace_status"; then
    exit 1
fi
