{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hapax.local/schemas/capability-inventory-baseline.schema.json",
  "title": "CapabilityInventoryBaselineV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "count", "records"],
  "properties": {
    "schema_version": {"const": 2},
    "count": {"type": "integer", "minimum": 0},
    "records": {
      "type": "object",
      "propertyNames": {
        "anyOf": [
          {"const": "local_compute.agentic_trust_evaluator_surface"},
          {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "^(?:(?:[sS][uU][rR][fF][aA][cC][eE]|[rR][oO][uU][tT][eE])[./])?[lL][oO][cC][aA][lL]_[cC][oO][mM][pP][uU][tT][eE][./][aA][gG][eE][nN][tT][iI][cC]_[tT][rR][uU][sS][tT]_[eE][vV][aA][lL][uU][aA][tT][oO][rR]_[sS][uU][rR][fF][aA][cC][eE]$|(^|[^a-zA-Z0-9_-])(?:[aA][gG][eE][nN][tT][iI][cC][tT][rR][uU][sS][tT][eE][vV][iI][dD][eE][nN][cC][eE][rR][eE][cC][eE][iI][pP][tT][vV]1|[aA][gG][eE][nN][tT][iI][cC]-[tT][rR][uU][sS][tT]-[eE][vV][iI][dD][eE][nN][cC][eE]-[rR][eE][cC][eE][iI][pP][tT]-[vV]1)($|[^a-zA-Z0-9_-])"
            }
          }
        ]
      },
      "properties": {
        "local_compute.agentic_trust_evaluator_surface": {
          "type": "object",
          "properties": {
            "inventory_disposition": {"const": "evidence_only_non_supply"}
          },
          "required": ["inventory_disposition"]
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["inventory_disposition", "fingerprint"],
        "properties": {
          "inventory_disposition": {
            "enum": ["admitted_supply", "evidence_only_non_supply"]
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
