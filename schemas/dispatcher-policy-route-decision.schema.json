{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hapax.local/schemas/dispatcher-policy-route-decision.schema.json",
  "title": "DispatcherPolicyRouteDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_schema",
    "decision_id",
    "created_at",
    "task_id",
    "lane",
    "route_id",
    "platform",
    "mode",
    "profile",
    "action",
    "policy_outcome",
    "launch_allowed",
    "prompt_allowed",
    "route_policy_green",
    "clog_state",
    "compatibility_mode",
    "degraded_state",
    "registry_freshness_green",
    "quota_freshness_green",
    "resource_freshness_green",
    "route_selection_authority",
    "quality_floor_satisfied",
    "authority_allowed",
    "cloud_burst_eligible",
    "cloud_burst_guard_state",
    "cloud_burst_spike_reasons",
    "cloud_burst_guard_reasons",
    "local_execution_target",
    "selected_descriptor_leaf",
    "reason_codes",
    "message",
    "quota_evidence_refs",
    "resource_state_refs"
  ],
  "properties": {
    "decision_schema": {"const": 1},
    "adjudicator_sha": {
      "description": "Verified git HEAD of the checkout the deciding code was loaded from. Null when no checkout could be verified; never inferred from a directory name.",
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "adjudicator_source": {
      "description": "How adjudicator_sha was established. Says WHERE the code was loaded from, not that the executed bytes belong to that commit.",
      "enum": ["release_tree", "git_worktree", "indeterminate"]
    },
    "adjudicator_resolved_from": {
      "description": "Resolved path the identity was determined from, recorded even when adjudicator_sha is null so the claim stays auditable.",
      "type": ["string", "null"]
    },
    "adjudicator_dirty": {
      "description": "Three-valued: true modified, false verified clean, null cleanliness could not be determined. Consumers must test `is false`, never falsiness.",
      "type": ["boolean", "null"]
    },
    "adjudicator_loaded_modules": {
      "description": "First-party modules the process had loaded. A coverage statement naming what participated, with no per-module verdict.",
      "type": "array",
      "items": {"type": "string"}
    },
    "adjudicator_declared_sha": {
      "description": "The sha the deploy PATH claimed, kept separate from adjudicator_sha because release trees here are writable checkouts and can disagree with their own names.",
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^rd-[0-9TZ]+-[A-Za-z0-9_.-]+-[a-f0-9]{12}$"
    },
    "created_at": {"type": "string", "format": "date-time"},
    "task_id": {"type": "string", "minLength": 1},
    "lane": {"type": "string", "minLength": 1},
    "route_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+\\.[a-z0-9_]+$"
    },
    "platform": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "action": {"enum": ["launch", "hold", "support_only", "refuse"]},
    "policy_outcome": {"enum": ["launch", "hold", "support_only", "refuse"]},
    "launch_allowed": {"type": "boolean"},
    "prompt_allowed": {"type": "boolean"},
    "route_policy_green": {"type": "boolean"},
    "clog_state": {
      "enum": [
        "policy_green",
        "compatibility_degraded",
        "held",
        "refused",
        "support_only"
      ]
    },
    "compatibility_mode": {"enum": ["none", "rollback_full_profile"]},
    "degraded_state": {"type": ["string", "null"]},
    "registry_freshness_green": {"type": "boolean"},
    "quota_freshness_green": {"type": "boolean"},
    "resource_freshness_green": {"type": "boolean"},
    "route_selection_authority": {"const": false},
    "quality_floor_satisfied": {"type": "boolean"},
    "authority_allowed": {"type": "boolean"},
    "cloud_burst_eligible": {"type": "boolean"},
    "cloud_burst_guard_state": {
      "enum": [
        "not_applicable",
        "excluded_local",
        "appendix_default",
        "ineligible",
        "blocked",
        "eligible"
      ]
    },
    "cloud_burst_spike_reasons": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "cloud_burst_guard_reasons": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "local_execution_target": {"type": ["string", "null"]},
    "selected_descriptor_leaf": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "string",
          "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+\\.[a-z0-9_]+#[^#]+$",
          "not": {
            "pattern": "(?:(?:[sS][uU][rR][fF][aA][cC][eE]|[rR][oO][uU][tT][eE])[./])?[lL][oO][cC][aA][lL]_[cC][oO][mM][pP][uU][tT][eE][./][aA][gG][eE][nN][tT][iI][cC]_[tT][rR][uU][sS][tT]_[eE][vV][aA][lL][uU][aA][tT][oO][rR]_[sS][uU][rR][fF][aA][cC][eE]|[aA][gG][eE][nN][tT][iI][cC][tT][rR][uU][sS][tT][eE][vV][iI][dD][eE][nN][cC][eE][rR][eE][cC][eE][iI][pP][tT][vV]1|[aA][gG][eE][nN][tT][iI][cC]-[tT][rR][uU][sS][tT]-[eE][vV][iI][dD][eE][nN][cC][eE]-[rR][eE][cC][eE][iI][pP][tT]-[vV]1"
          }
        }
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "message": {"type": "string", "minLength": 1},
    "quota_evidence_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "resource_state_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
