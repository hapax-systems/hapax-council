[Unit]
Description=Write the registered and unregistered estate-store canaries
Documentation=https://github.com/hapax-systems/hapax-council/blob/main/docs/runbooks/estate-store-registration-stage1.md
X-Hapax-Store=estate-registration-runtime

[Service]
Type=oneshot
ExecStart=%h/.local/bin/uv --directory %h/.cache/hapax/source-activation/worktree run python scripts/hapax-estate-store-registry originate
NoNewPrivileges=true
PrivateTmp=true
