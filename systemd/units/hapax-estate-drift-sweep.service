[Unit]
Description=Run the report-only estate-store drift sweep on the peer host
Documentation=https://github.com/hapax-systems/hapax-council/blob/main/docs/runbooks/estate-store-registration-stage1.md
X-Hapax-Store=estate-registration-runtime

[Service]
Type=oneshot
ExecStart=%h/.local/bin/uv --directory %h/.cache/hapax/source-activation/worktree run python scripts/hapax-estate-store-registry sweep-peer
NoNewPrivileges=true
# No PrivateTmp= (or any other user-namespace sandbox option): in a user unit it implies a user
# namespace, where root-owned /etc/ssh config maps to `nobody` and ssh refuses it. Pinned by
# tests/systemd/test_estate_registration_stage1_units.py.
