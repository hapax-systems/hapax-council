[Unit]
Description=Hapax Secrets — agent env from reins FileStore
# Not pass. Same FileStore as POST /command/secret (estate ≡ shipped).
# Producer is in-tree: scripts/secret_env_from_filestore.py (activation worktree).
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Do not truncate hapax-secrets.env before FileStore validation. The producer
# writes atomically after .key + required names exist; a failed start keeps
# the last valid environment. ExecStop (not ExecStopPost) so a failed start
# does not delete that file.
ExecStart=/usr/bin/python3 %h/.cache/hapax/source-activation/worktree/scripts/secret_env_from_filestore.py
ExecStop=/bin/rm -f /run/user/%U/hapax-secrets.env
SyslogIdentifier=hapax-secrets

[Install]
WantedBy=default.target
