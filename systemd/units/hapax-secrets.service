[Unit]
Description=Hapax Secrets — agent env from reins FileStore
# Not pass. Same FileStore as POST /command/secret (estate ≡ shipped).
# Producer is in-tree: scripts/secret_env_from_filestore.py (activation worktree).
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Destination is /run/user/%U/hapax-secrets.env (producer default). Do not
# truncate or stop-delete it: RemainAfterExit restart would run ExecStop first
# and drop the last valid file before FileStore validation. The producer writes
# atomically after .key + required names exist; a failed start keeps the prior
# environment. /run/user tmpfs reaps the file on logout.
ExecStart=/usr/bin/python3 %h/.cache/hapax/source-activation/worktree/scripts/secret_env_from_filestore.py
SyslogIdentifier=hapax-secrets

[Install]
WantedBy=default.target
