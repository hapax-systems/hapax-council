[Unit]
Description=Hapax Secrets — agent env from reins FileStore
# Not pass. Same FileStore as POST /command/secret (estate ≡ shipped).
# Instance producer: ~/.local/lib/hapax/secret_env_from_filestore.py
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/bash -c 'install -m 600 /dev/null /run/user/%U/hapax-secrets.env'
ExecStart=/usr/bin/python3 %h/.local/lib/hapax/secret_env_from_filestore.py
ExecStopPost=/bin/rm -f /run/user/%U/hapax-secrets.env
SyslogIdentifier=hapax-secrets

[Install]
WantedBy=default.target
