[Unit]
Description=gdrive sync (Google API)
After=network-online.target
Wants=network-online.target
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/.cache/hapax/source-activation/worktree
ExecStartPre=%h/.local/bin/hapax-env-setup
ExecStart=%h/.cache/hapax/source-activation/worktree/.venv/bin/python -m agents.gdrive_sync --auto
EnvironmentFile=-/run/user/1000/hapax-secrets.env
Environment=PATH=%h/.cache/hapax/source-activation/worktree/.venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=%h/.cache/hapax/source-activation/worktree
Environment=HOME=%h
Environment=GNUPGHOME=%h/.gnupg
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gdrive-sync
# Measured 2026-09-24 on podium: a 4-change incremental run peaked at 1.5G
# (the 213k-file state.json is loaded whole). 3G is 2x that peak.
MemoryMax=3G
CPUQuota=30%
TimeoutStartSec=30min
