[Unit]
Description=Hapax seat snapshot or memory projection (%i)
Documentation=file://%h/.cache/hapax/source-activation/worktree/scripts/hapax-seat-watch

[Service]
Type=oneshot
WorkingDirectory=%h/.cache/hapax/source-activation/worktree
ExecStart=%h/.cache/hapax/source-activation/worktree/.venv/bin/python %h/.cache/hapax/source-activation/worktree/scripts/hapax-seat-watch %i
Environment=HOME=%h
UMask=0077
NoNewPrivileges=true
TimeoutStartSec=30
MemoryMax=128M
StandardOutput=journal
StandardError=journal
