[Unit]
Description=Langfuse LLM trace sync (incremental)
After=network.target hapax-secrets.service
Requires=hapax-secrets.service
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/.cache/hapax/source-activation/worktree
EnvironmentFile=/run/user/1000/hapax-secrets.env
ExecStart=%h/.cache/hapax/source-activation/worktree/.venv/bin/python -m agents.langfuse_sync --auto
Environment=PATH=%h/.cache/hapax/source-activation/worktree/.venv/bin:%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=%h/.cache/hapax/source-activation/worktree
Environment=HOME=%h
MemoryMax=512M
CPUQuota=50%
StandardOutput=journal
StandardError=journal
SyslogIdentifier=langfuse-sync
TimeoutStartSec=1200
