[Unit]
# Hapax-Install-Scope: system
Description=Retired Hapax root-to-user OOM score bridge sentinel
Documentation=https://github.com/hapax-systems/hapax-council/blob/main/systemd/README.md
StartLimitIntervalSec=0
RefuseManualStart=yes

[Service]
Type=oneshot
TimeoutStartSec=5s
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/sbin/hapax-oom-score-enforce --apply
SyslogIdentifier=hapax-oom-score-enforce
