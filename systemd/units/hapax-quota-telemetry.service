[Unit]
Description=Hapax live quota/resource telemetry writer (routing Phase 0.4 / R3 slice)
Documentation=file://%h/.cache/hapax/source-activation/worktree/scripts/hapax-quota-telemetry-writer
After=hapax-secrets.service
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
# Refreshes per-provider platform capability receipts (quota stale_after=15m —
# the paired timer fires every 10m to stay inside that window) and rebuilds the
# live quota/spend ledger at ~/.cache/hapax/orchestration/quota-spend-ledger-live.json,
# which load_dispatch_policy_sources prefers over the checked-in fixtures.
# Credential use (review finding on #4665, round 2): the step-0 pull-forward
# hosts the agy admission chain (hapax-determine → hapax-agy-quota-admission →
# reviewer smoke), which reads the operator OAuth token from the EnvironmentFile
# below inside its isolated smoke workspace — same credential surface as
# hapax-determine.service, now invoked from this unit too. No secret VALUES are
# read by the writer itself or persisted anywhere: receipts carry
# secret_source names with secret_value_persisted=false.
ExecStart=%h/.cache/hapax/source-activation/worktree/.venv/bin/python %h/.cache/hapax/source-activation/worktree/scripts/hapax-quota-telemetry-writer
WorkingDirectory=%h/.cache/hapax/source-activation/worktree
Environment=HOME=%h
Environment=PYTHONPATH=%h/.cache/hapax/source-activation/worktree
EnvironmentFile=-/run/user/1000/hapax-secrets.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hapax-quota-telemetry
# On the overlap tick where this unit wins the producer lock, it hosts the
# agy producer chain (hapax-determine → hapax-agy-quota-admission → reviewer
# smoke) that normally runs under hapax-determine.service's 512M cgroup;
# match that ceiling so the smoke is not OOM-killed into a skipped tick
# (a skip re-forwards the stale-receipt problem this writer repairs).
# Measured evidence (review findings on #4665, round 2), recheck with
# `systemctl --user show hapax-quota-telemetry.service hapax-determine.service
# -p MemoryPeak`: writer-alone tick peak 191 MiB, determine tick peak 217 MiB
# (both 2026-09-12). The combined tick runs them IN SERIES in one cgroup, so
# the additive worst case is ~408 MiB against this 512 MiB ceiling — ~104 MiB
# headroom. NOTE: hapax-determine.service itself took a cgroup OOM kill at
# 2026-09-12T14:59:26Z despite the same 512M, so this ceiling is monitored,
# not assumed: `journalctl --user -u hapax-quota-telemetry.service --since -1d
# | grep -i oom` after any suspected skipped mint.
MemoryMax=512M
# Step 0 of the writer pulls the determination producer forward (child budgets:
# 90s lock wait + 90s producer run ≤ a 210s pull timeout) before the receipt
# refresh (bounded by its own 360s outer timeout), in series. The worst-case
# serial path is therefore 210s + 360s = 570s against the 600s timer cadence —
# UNDER the cadence, so a tick can no longer defer the next fire by duration
# alone; TestPullForwardBudgetPins in tests/scripts/
# test_hapax_quota_telemetry_writer.py re-derives this from the unit files and
# the writer constants, so the arithmetic cannot drift silently.
#
# Overrun semantics, stated so no future operator has to infer them (review
# findings on #4665): a tick that still crosses the next cadence boundary
# (external stalls — host suspend, cgroup CPU pressure) DEFERS that fire —
# systemd will not overlap a oneshot unit — which is a silently skipped write
# cycle, the quieter failure mode. That deferral is ACCEPTED: the pull-forward
# dedups through the determine lock, so the determine timer still mints the
# receipt on cadence and the following writer tick embeds it; one deferred
# write never lapses the 15m receipt window. TimeoutStartSec=900 bounds the
# kill so a wedged tick cannot linger past one deferred cycle.
TimeoutStartSec=900
# Killswitch: `systemctl --user mask hapax-quota-telemetry.timer` stops the
# writer; receipts then lapse after quota stale_after (15m) and the live ledger
# goes stale after its TTL — the dispatcher falls back to fail-closed HOLDs,
# never to silently trusting old telemetry.
