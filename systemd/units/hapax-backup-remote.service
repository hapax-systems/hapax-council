[Unit]
Description=Hapax Remote Backup (restic → B2)
After=network-online.target
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
# The script lives in this repository and runs from the activation worktree, never from a mutable checkout (it was
# ~/projects/distro-work/hapax-backup-remote.sh, an archived repository's working copy, until 2026-09-27).
ExecStart=%h/.cache/hapax/source-activation/worktree/scripts/hapax-backup-remote
WorkingDirectory=%h/.cache/hapax/source-activation/worktree
Environment=PATH=/home/hapax/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/hapax
Environment=GNUPGHOME=/home/hapax/.gnupg
# 2026-06-03: the offsite backup was OOM-killed under a 2GB MemoryMax — the `restic forget --prune` step rebuilds
# the index and exceeds 2GB. Real headroom, and the Go heap capped (GOMEMLIMIT) so restic GCs hard instead of OOMing.
# These were podium's ~/.config drop-in memory-max.conf; stated here since 2026-09-27, so the repository says what
# podium runs.
MemoryMax=8G
MemoryHigh=6G
Environment=GOMEMLIMIT=6GiB
CPUQuota=50%
SyslogIdentifier=hapax-backup-remote
