[Unit]
Description=Hapax Remote Backup (restic → B2)
After=network-online.target
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
ExecStart=/bin/bash /home/hapax/projects/distro-work/hapax-backup-remote.sh
WorkingDirectory=/home/hapax/projects/distro-work
Environment=PATH=/home/hapax/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/hapax
Environment=GNUPGHOME=/home/hapax/.gnupg
MemoryMax=2G
CPUQuota=50%
SyslogIdentifier=hapax-backup-remote
