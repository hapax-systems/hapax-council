[Unit]
Description=gdrive sync (every minute)

[Timer]
# Operator 2026-09-24: "sync is 15 min, but prolly should be 1". Each tick is
# one Drive changes.list call against the stored changes token, so an idle
# minute costs one API request. OnUnitInactiveSec counts from the end of the
# previous run, so a long catch-up run never overlaps the next tick.
OnBootSec=2min
OnUnitInactiveSec=1min
AccuracySec=5s

[Install]
WantedBy=timers.target
