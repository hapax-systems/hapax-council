# Hapax-Parked: true
# Retired 2026-10-16: the heartbeat waits for governed activation of the livestream vector.
[Unit]
Description=Check segment-prep emitted at least one segment after the daily run

[Timer]
OnCalendar=*-*-* 06:20:00 UTC
Persistent=true
RandomizedDelaySec=300
Unit=hapax-segment-prep-emit-health.service

[Install]
WantedBy=timers.target
