[Unit]
Description=Run the peer estate-store drift sweep daily
Documentation=https://github.com/hapax-systems/hapax-council/blob/main/docs/runbooks/estate-store-registration-stage1.md

[Timer]
OnCalendar=*-*-* 03:40:00
Persistent=true
RandomizedDelaySec=20min
Unit=hapax-estate-drift-sweep.service

[Install]
WantedBy=timers.target
