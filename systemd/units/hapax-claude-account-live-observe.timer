# Hapax-Auto-Enable: true
# Without this marker `hapax-post-merge-deploy` installs the unit but never enables it —
# the file lands, nothing arms, and the receipt lapses exactly as before. Only 7 of 150
# shipped timers carry it, so its absence is the silent default, not an oversight to
# assume away.
[Unit]
Description=Observe account-live Claude quota every 10m (receipt stale_after=30m window)

[Timer]
# Fire shortly after boot so the first review dispatch of a fresh session sees a fresh
# seat, then every 10 minutes — three fires inside the 30m stale_after, so a single
# slipped or failed run cannot lapse the receipt.
#
# Cadence is the whole point of this unit. Measured 2026-08-19, when nothing scheduled
# this: receipts appeared every ~55 minutes from 05:15z to 14:25z, then stopped. The
# Claude and GLM review seats both went stale at 15:25:02z and the next review dispatch
# found ZERO available families. The only symptom was a PR that could not be reviewed.
OnBootSec=3min
OnUnitActiveSec=10min
AccuracySec=1min
# Deliberately NO Persistent=. systemd.timer(5): "this setting only has an effect on timers
# configured with OnCalendar=" — on a monotonic timer it is silently inert. An earlier
# revision set Persistent=true with a comment claiming it caught up after a suspend gap;
# that comment asserted behaviour the unit did not have, which is the same documentation-rot
# defect this whole change exists to remove.
#
# Catch-up is also the wrong goal here. After downtime you want a FRESH observation, not a
# replayed one, and OnBootSec=3min already provides it.

[Install]
WantedBy=timers.target
