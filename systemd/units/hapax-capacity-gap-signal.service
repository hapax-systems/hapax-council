[Unit]
Description=Hapax capacity-gap signal — compare observed supply with waiting work
After=hapax-capacity-observer.service

[Service]
Type=oneshot
WorkingDirectory=%h/.cache/hapax/source-activation/worktree
ExecStart=%h/.cache/hapax/source-activation/worktree/.venv/bin/python -m scripts.capacity_gap_signal
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HAPAX_CAPACITY_PANE_TZ=America/Chicago
TimeoutStartSec=180
