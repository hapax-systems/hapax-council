# Hapax-Auto-Enable: true
# hapax-post-merge-deploy `enable --now`s units carrying this marker, so the
# refresh goes live on merge. The marker requires the [Install] section below.
[Unit]
Description=hapax — publish-path services follow the activation (5 min check)

[Timer]
OnBootSec=4min
OnUnitActiveSec=5min
RandomizedDelaySec=30
Unit=hapax-publish-path-refresh.service

[Install]
WantedBy=timers.target
