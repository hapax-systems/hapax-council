[Unit]
Description=Check enabled routes for published public inboxes
ConditionHost=hapax-appendix
After=network-online.target
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/.cache/hapax/source-activation/worktree
Environment=PATH=%h/.cache/hapax/source-activation/worktree/.venv/bin:%h/.local/bin:/usr/bin:/bin
Environment=PYTHONPATH=%h/.cache/hapax/source-activation/worktree
ExecStart=%h/.cache/hapax/source-activation/worktree/.venv/bin/python -m scripts.public_inbox_monitor check
NoNewPrivileges=true
TimeoutStartSec=240
MemoryMax=256M
