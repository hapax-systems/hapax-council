[Unit]
Description=Hapax SDLC vocabulary export (feeds hapax-coord RC-4)
Documentation=file:%h/projects/hapax-council/shared/sdlc_lifecycle.py

[Service]
Type=oneshot
# Canonical-root: the activation worktree, never the mutable dev tree (#4090).
WorkingDirectory=%h/.cache/hapax/source-activation/worktree
ExecStart=/usr/bin/python3 %h/.cache/hapax/source-activation/worktree/scripts/hapax-sdlc-vocab-export

