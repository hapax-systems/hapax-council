[Unit]
Description=Hapax Critical Off-site Backup (restic)
After=network-online.target
Wants=network-online.target
OnFailure=notify-failure@%n.service
ConditionPathExists=/store/llm-data
ConditionPathExists=%h/.config/rclone/rclone.conf

[Service]
Type=oneshot
ExecStart=%h/.cache/hapax/source-activation/worktree/scripts/hapax-backup-critical-offsite
WorkingDirectory=%h/.cache/hapax/source-activation/worktree
Environment=PATH=/home/hapax/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/hapax
Environment=GNUPGHOME=/home/hapax/.gnupg
Environment=PASSWORD_STORE_DIR=/home/hapax/.password-store
Environment=HAPAX_CRITICAL_OFFSITE_RESTIC_PASSWORD_ENTRY=cloudflare/r2/restic-password
Environment=RESTIC_CACHE_DIR=/store/llm-data/restic-cache/critical-offsite
MemoryHigh=1G
MemoryMax=2G
CPUQuota=25%
TimeoutStartSec=2h
SyslogIdentifier=hapax-backup-critical-offsite
