# Hapax-Parked: true
# Retired 2026-10-16: the watermark requires the deliberately disabled lane supervisor.
[Unit]
Description=Reform-complete regression detector — re-verify every reform realization every 6h

[Timer]
OnBootSec=15min
OnUnitActiveSec=6h
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
