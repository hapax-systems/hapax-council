[Unit]
Description=Hapax bounded lane mailbox wake loop
# Replaces the preserved transient v2 only after separately admitted installation.

[Service]
Type=simple
ExecStart=%h/.cache/hapax/source-activation/worktree/scripts/hapax-lanes-mailwake
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hapax-lanes-mailwake
# Intentionally no Install section: source publication must not enable the unit.
