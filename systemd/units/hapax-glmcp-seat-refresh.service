[Unit]
Description=Keep the GLM review seat admitted: one sanctioned reviewer round-trip when the passive admission receipt is older than 5 minutes (it lives 15)
# The receipt chain: reviewer round-trip (exit 0) -> witness yaml (no prompt/output/secret persisted)
# -> hapax-glmcp-quota-admission observe-success -> hapax-quota-telemetry-writer -> live ledger the
# review dispatcher and the autoqueue read. Measured 2026-09-02: with no refresher the seat had been
# expired since 4 August and every review dossier was refused as "blocked route family seated".
# The script runs from the governed source-activation worktree (main), never a mutable checkout.

[Service]
Type=oneshot
ExecStart=%h/.cache/hapax/source-activation/worktree/scripts/hapax-glmcp-seat-refresh
Environment=HOME=/home/hapax
Environment=PATH=/home/hapax/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=GNUPGHOME=/home/hapax/.gnupg
Environment=PASSWORD_STORE_DIR=/home/hapax/.password-store
# Three attempts of up to 180 s plus two 15 s pauses, then the admission writer (60 s) and the
# telemetry writer (120 s): 750 s is the budget the script can spend, so the unit must not kill
# it earlier than that.
TimeoutStartSec=780
# The receipt chain runs the activation worktree and nothing else: pinned here so an inherited
# user-manager HAPAX_COUNCIL cannot redirect governance-sensitive code to a mutable tree.
Environment=HAPAX_COUNCIL=%h/.cache/hapax/source-activation/worktree
# The probe measures the Coding Plan seat: its endpoint is pinned here as well as in the script.
Environment=HAPAX_GLMCP_REVIEW_BASE_URL=https://api.z.ai/api/coding/paas/v4
MemoryMax=512M
SyslogIdentifier=hapax-glmcp-seat-refresh
