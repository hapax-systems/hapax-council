[Unit]
Description=Keep the GLM review seat admitted within the script's bounded no-lapse envelope
# The receipt chain: reviewer round-trip (exit 0) -> witness yaml (no prompt/output/secret persisted)
# -> hapax-glmcp-quota-admission observe-success -> hapax-quota-telemetry-writer -> live ledger the
# review dispatcher and the autoqueue read. Measured 2026-09-02: with no refresher the seat had been
# expired since 4 August and every review dossier was refused as "blocked route family seated".
# The script runs from the governed source-activation worktree (main), never a mutable checkout.

[Service]
Type=oneshot
ExecStart=%h/.cache/hapax/source-activation/worktree/scripts/hapax-glmcp-seat-refresh
Environment=HOME=/home/hapax
Environment=PATH=/home/hapax/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=GNUPGHOME=/home/hapax/.gnupg
Environment=PASSWORD_STORE_DIR=/home/hapax/.password-store
# The script accounts for every stage, kill-after grace, bounded filtering, launches, file I/O,
# scheduler slack and an explicit margin, then refuses with exit 7 unless that chain fits this exact
# whole-service bound. This cap covers wall time from ExecStart launch through normal process exit.
TimeoutStartSec=600
# Bound the final TERM-to-KILL transition too: OnUnitInactiveSec does not start until shutdown ends,
# so post-check shutdown is part of the freshness predicate rather than unbounded cleanup time.
TimeoutStopSec=5
KillMode=control-group
SendSIGKILL=yes
# The receipt chain runs the activation worktree, the Coding Plan endpoint and the Coding Plan
# credential, and nothing else. Environment= expands specifiers such as %h (systemd.exec(5));
# shell variable expansion does not occur. The pins live in the script's own defaults;
# this line removes the inherited user-manager values that could
# override them (UnsetEnvironment= applies after every Environment= source).
UnsetEnvironment=HAPAX_COUNCIL HAPAX_GLMCP_REVIEW_BASE_URL HAPAX_GLMCP_REVIEW_SECRET_ENTRY HAPAX_GLMCP_REVIEW_ALLOW_SECRET_ENTRY_OVERRIDE HAPAX_GLMCP_SEAT_ROOT_OVERRIDE HAPAX_PLATFORM_CAPABILITY_RECEIPT_DIR HAPAX_QUOTA_SPEND_LEDGER_LIVE HAPAX_RELAY_RECEIPT_DIR HAPAX_GLMCP_SEAT_RETRY_SLEEP
MemoryMax=512M
SyslogIdentifier=hapax-glmcp-seat-refresh
