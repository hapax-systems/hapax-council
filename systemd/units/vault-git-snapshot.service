[Unit]
Description=Vault git snapshot — commit on podium, mirror history to appendix bare repo
Documentation=file://%h/Documents/Personal/20-projects/hapax-requests/active/ratify-line-20260818-infra-gates.txt
OnFailure=notify-failure@%n.service
# Defect 2 (vault-nfs-mount-boot-race-and-gate-fail-closed-20261003): a USER unit cannot order
# against the SYSTEM vault .mount — RequiresMountsFor binds to nothing in the user manager — so
# the vault-presence check moves to an ExecCondition marker probe in [Service] (below).

[Service]
Type=oneshot
# Skip CLEANLY (condition-not-met, not a failure) when the vault is unmounted/absent, so no
# snapshot runs into a boot-race shadow directory: a real vault root carries .git or .obsidian
# (the defect-3 marker a shadow writer never creates); a shadow directory carries neither.
ExecCondition=/bin/sh -c 'test -e %h/Documents/Personal/.git || test -e %h/Documents/Personal/.obsidian'
ExecStart=%h/.cache/hapax/source-activation/worktree/scripts/vault-git-snapshot
Environment=HOME=%h
# A latched oneshot would stay active and hide the next failure.
RemainAfterExit=no
