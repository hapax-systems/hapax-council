[Unit]
# Hapax-Install-Scope: system
Description=Retired Hapax OOM score timer (must remain disabled)
Documentation=https://github.com/hapax-systems/hapax-council/blob/main/systemd/README.md
RefuseManualStart=yes
# Also block dependency activation of an already-enabled historical timer.
ConditionPathExists=!/

[Timer]
OnBootSec=120s
OnUnitActiveSec=120s
AccuracySec=1s
Unit=hapax-oom-score-enforce.service
