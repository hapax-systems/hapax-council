[Unit]
Description=Hapax L-12 feedback-loop detector + smooth auto-mute
Documentation=https://github.com/ryanklee/hapax-council/pull/1517
After=hapax-secrets.service pipewire.service
PartOf=hapax.target
Requires=hapax-secrets.service
Wants=pipewire.service

[Service]
Type=notify
WorkingDirectory=%h/.cache/hapax/source-activation/worktree
EnvironmentFile=-%h/.config/hapax/secrets.env
Environment=PATH=%h/.cache/hapax/source-activation/worktree/.venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=%h/.cache/hapax/source-activation/worktree
ExecStartPre=%h/.cache/hapax/source-activation/worktree/scripts/hapax-compositor-runtime-source-check --require-file agents/studio_compositor/feedback_loop_daemon.py
ExecStart=%h/.cache/hapax/source-activation/worktree/.venv/bin/python -m agents.studio_compositor.feedback_loop_daemon
Restart=always
RestartSec=5s
WatchdogSec=120s

# Memory cap per cc-task spec.
MemoryMax=200M

# The delegated user tree remains at the user-manager score. Cgroup memory
# reservations, not root-only negative score grants, protect safety services.
OOMScoreAdjust=100

[Install]
WantedBy=hapax.target
