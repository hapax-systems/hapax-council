# Hapax-Parked: true
[Unit]
Description=Retired L-12 feedback-loop detector sentinel
Documentation=https://github.com/hapax-systems/hapax-council/blob/main/docs/audio-topology-reference.md
RefuseManualStart=yes
# The Behringer L-12 path is retired. Keep this historical unit inert even if a
# stale dependency or enablement link survives until the next governed deploy.
ConditionPathExists=!/

[Service]
Type=oneshot
ExecStart=/usr/bin/true
MemoryMax=200M
OOMScoreAdjust=100
