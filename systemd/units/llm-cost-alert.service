[Unit]
Description=LLM cost anomaly alerter
Wants=hapax-secrets.service
After=network-online.target docker.service hapax-secrets.service
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
Environment=PATH=/usr/bin:/usr/local/bin
Environment=HOME=%h
EnvironmentFile=-%t/hapax-secrets.env
ExecCondition=/usr/bin/env bash -lc 'grep -q "^LANGFUSE_PUBLIC_KEY=." %t/hapax-secrets.env 2>/dev/null && grep -q "^LANGFUSE_SECRET_KEY=." %t/hapax-secrets.env 2>/dev/null || { echo "llm-cost-alert: degraded readiness: Langfuse credentials unavailable in %t/hapax-secrets.env (produced by hapax-secrets.service from the FileStore)"; exit 1; }'
ExecCondition=/usr/bin/env bash -lc 'deadline=$((SECONDS + 60)); until curl -s --connect-timeout 1 --max-time 2 -o /dev/null http://localhost:3000; do if (( SECONDS >= deadline )); then echo "llm-cost-alert: degraded readiness: Langfuse unavailable at http://localhost:3000 after 60s"; exit 1; fi; sleep 2; done'
ExecStart=%h/projects/distro-work/scripts/llm-cost-alert.sh
