[Unit]
Description=HAN inbound mail to private foreign-data quarantine
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.cache/hapax/source-activation/worktree
Environment=PATH=%h/.cache/hapax/source-activation/worktree/.venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=%h/.cache/hapax/source-activation/worktree
ExecStart=%h/.cache/hapax/source-activation/worktree/.venv/bin/python %h/.cache/hapax/source-activation/worktree/scripts/han_mail_pull.py
UMask=0077
NoNewPrivileges=true
TimeoutStartSec=240
MemoryMax=256M
StandardOutput=journal
StandardError=journal
