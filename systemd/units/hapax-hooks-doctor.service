[Unit]
Description=Hapax gate-drift sweep — hooks-doctor (reform FM-6 shim collapse)
Documentation=file:%h/.cache/hapax/source-activation/worktree/hooks/scripts/hooks-doctor.sh

[Service]
Type=oneshot
Environment=PATH=/home/hapax/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/hapax
StandardOutput=journal
StandardError=journal
Nice=10
# Prefer activated source: deploy may start this timer before refreshing the
# canonical hook closure. Keep canonical/rebuild lookup for existing recovery
# paths; every source inspects the activation root when classifying lane gates.
# --session stays advisory; --notify writes actual critical drift to the Crow's
# vault mailbox and reports delivery failure on stderr.
ExecStart=/bin/bash -c 'r="$HOME/.cache/hapax/source-activation/worktree"; for d in "$r/hooks/scripts" "$HOME/.local/lib/hapax/hooks" "$HOME/.cache/hapax/rebuild/worktree/hooks/scripts"; do if [ -x "$d/hooks-doctor.sh" ]; then exec bash "$d/hooks-doctor.sh" --session --notify --root "$r"; fi; done; echo "hooks-doctor.sh not found in any known location" >&2; exit 0'
