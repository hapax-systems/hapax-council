[Unit]
# Hapax-Auto-Enable: true
Description=Restore recorded lane sessions after a host reboot
Wants=network-online.target
After=network-online.target
Before=hapax-host-recovery-capture.service

[Service]
Type=oneshot
ExecStart=%h/.local/bin/hapax-host-recovery restore
MemoryMax=256M
TimeoutStartSec=5min

[Install]
WantedBy=default.target
