[Unit]
Description=Hapax bare-host capability probe (R3.1 L5)
Documentation=file://%h/.cache/hapax/source-activation/worktree/scripts/hapax-bare-host-capability-probe
OnFailure=notify-failure@%n.service
# Guard the tree the unit actually imports from. Must stay under Unit.
# systemd ignores AssertPathExists under Service.

AssertPathExists=%h/.cache/hapax/source-activation/worktree/scripts/hapax-bare-host-capability-probe

[Service]
Type=oneshot
WorkingDirectory=%h/.cache/hapax/source-activation/worktree
Environment=HOME=%h
Environment=PYTHONPATH=%h/.cache/hapax/source-activation/worktree
Environment=TMPDIR=/store-fast/tmp
ExecStart=%h/.cache/hapax/source-activation/worktree/.venv/bin/python %h/.cache/hapax/source-activation/worktree/scripts/hapax-bare-host-capability-probe
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hapax-bare-host-capability-probe
TimeoutStartSec=180
Restart=no
