[Unit]
Description=Dump PostgreSQL/Qdrant/n8n and back up system state to NAS with restic
After=network-online.target hapax-source-activate.service
Wants=network-online.target hapax-source-activate.service
RequiresMountsFor=/store/llm-data /mnt/nas/backups/restic
ConditionPathIsMountPoint=/store
ConditionPathIsMountPoint=/mnt/nas
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
ExecStart=%h/.cache/hapax/source-activation/worktree/scripts/hapax-backup-local
WorkingDirectory=%h/.cache/hapax/source-activation/worktree
Environment=PATH=/home/hapax/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/hapax
Environment=GNUPGHOME=/home/hapax/.gnupg
Environment=PASSWORD_STORE_DIR=/home/hapax/.password-store
MemoryHigh=3G
MemoryMax=4G
CPUQuota=50%
SyslogIdentifier=hapax-backup-local
