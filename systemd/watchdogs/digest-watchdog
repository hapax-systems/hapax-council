#!/usr/bin/env bash
set -euo pipefail

# Content digest generator — saves to profiles/ + vault and sends notification
COUNCIL_ROOT="${HAPAX_COUNCIL_ROOT:-${HOME}/.cache/hapax/source-activation/worktree}"
if [[ ! -e "${COUNCIL_ROOT}/.git" ]]; then
  echo "ERROR: council activation checkout missing at ${COUNCIL_ROOT}" >&2
  echo "NEXT ACTION: run source activation or set HAPAX_COUNCIL_ROOT to that worktree" >&2
  exit 1
fi
cd "${COUNCIL_ROOT}"
export HAPAX_REINS_API="${HAPAX_REINS_API:-${HOME}/.local/share/reins/current/api}"
export HAPAX_SECRET="${HAPAX_SECRET:-${HOME}/.local/bin/hapax-secret}"
if [[ ! -x "${HAPAX_SECRET}" ]]; then
  echo "ERROR: hapax-secret missing at ${HAPAX_SECRET}" >&2
  echo "NEXT ACTION: install hapax-secret from reins (make install) or set HAPAX_SECRET" >&2
  exit 1
fi

# Load credentials from reins FileStore via pinned hapax-secret (not PATH, not pass).
export LITELLM_API_KEY=$("${HAPAX_SECRET}" litellm/master-key 2>/dev/null || echo "changeme")
export LANGFUSE_PUBLIC_KEY=$("${HAPAX_SECRET}" langfuse/public-key 2>/dev/null || true)
export LANGFUSE_SECRET_KEY=$("${HAPAX_SECRET}" langfuse/secret-key 2>/dev/null || true)

UV="${HAPAX_UV:-${HOME}/.local/bin/uv}"
REPORT=$($UV run python -m agents.digest --hours 24 --save --json 2>/dev/null)

# Notify via shared.notify (pass JSON via stdin)
echo "$REPORT" | $UV run python -c "
import sys, json
from shared.notify import send_notification
r = json.load(sys.stdin)
headline = r.get('headline', 'Digest generated')
new_docs = r.get('stats', {}).get('new_documents', 0)
body = headline
if new_docs > 0:
    body += f'\n{new_docs} new document(s) ingested'
    send_notification('Content Digest', body, tags=['books'])
" 2>/dev/null || true

# Append to history
echo "$REPORT" >> "${COUNCIL_ROOT}/profiles/digest-history.jsonl" 2>/dev/null || true
