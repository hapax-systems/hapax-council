#!/usr/bin/env bash
set -euo pipefail

# Meeting prep generator — auto-generates 1:1 prep docs for upcoming meetings
COUNCIL_ROOT="${HAPAX_COUNCIL_ROOT:-${HOME}/.cache/hapax/source-activation/worktree}"
if [[ ! -e "${COUNCIL_ROOT}/.git" ]]; then
  echo "ERROR: council activation checkout missing at ${COUNCIL_ROOT}" >&2
  echo "NEXT ACTION: run source activation or set HAPAX_COUNCIL_ROOT to that worktree" >&2
  exit 1
fi
cd "${COUNCIL_ROOT}"

# Load credentials from reins FileStore via hapax-secret (not pass).
export LITELLM_API_KEY=$(hapax-secret litellm/master-key 2>/dev/null || echo "changeme")
export LANGFUSE_PUBLIC_KEY=$(hapax-secret langfuse/public-key 2>/dev/null || true)
export LANGFUSE_SECRET_KEY=$(hapax-secret langfuse/secret-key 2>/dev/null || true)

UV="${HAPAX_UV:-${HOME}/.local/bin/uv}"
REPORT=$($UV run python -m agents.meeting_lifecycle --prepare --save --json 2>/dev/null)

# Notify via shared.notify
echo "$REPORT" | $UV run python -c "
import sys, json
from shared.notify import send_notification
r = json.load(sys.stdin)
prepped = r.get('meetings_prepped', 0)
if prepped > 0:
    body = f'{prepped} meeting prep doc(s) generated'
    send_notification('Meeting Prep', body, tags=['calendar'])
" 2>/dev/null || true
