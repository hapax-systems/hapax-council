#!/usr/bin/env bash
# drift-watchdog — Scheduled drift detection with notification.
# Runs via systemd timer. Saves report and notifies on drift.
set -euo pipefail

COUNCIL_ROOT="${HAPAX_COUNCIL_ROOT:-${HOME}/.cache/hapax/source-activation/worktree}"
if [[ ! -e "${COUNCIL_ROOT}/.git" ]]; then
  echo "ERROR: council activation checkout missing at ${COUNCIL_ROOT}" >&2
  echo "NEXT ACTION: run source activation or set HAPAX_COUNCIL_ROOT to that worktree" >&2
  exit 1
fi
cd "${COUNCIL_ROOT}"
export HAPAX_REINS_API="${HAPAX_REINS_API:-${HOME}/.local/share/reins/current/api}"

# Load credentials from reins FileStore via hapax-secret (not pass).
export LITELLM_API_KEY=$(hapax-secret litellm/master-key 2>/dev/null || echo "changeme")
export LANGFUSE_PUBLIC_KEY=$(hapax-secret langfuse/public-key 2>/dev/null || true)
export LANGFUSE_SECRET_KEY=$(hapax-secret langfuse/secret-key 2>/dev/null || true)

PROFILES="${COUNCIL_ROOT}/profiles"
UV="${HAPAX_UV:-${HOME}/.local/bin/uv}"

# Run drift detection
REPORT=$($UV run python -m agents.drift_detector --json 2>/dev/null) || {
    $UV run python -c "
from shared.notify import send_notification
send_notification('Drift Detector Failed', 'Could not run drift detection', priority='urgent', tags=['skull'])
" 2>/dev/null || true
    exit 1
}

# Save latest report
echo "$REPORT" > "$PROFILES/drift-report.json"

# Extract summary, append to history, and notify via shared.notify
echo "$REPORT" | python3 -c "
import sys, json
from datetime import datetime, timezone
r = json.load(sys.stdin)
count = len(r.get('drift_items', []))
docs = len(r.get('docs_analyzed', []))
summary = r.get('summary', '')[:120]
ts = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
print(json.dumps({'timestamp': ts, 'drift_count': count, 'docs_analyzed': docs, 'summary': summary}))
" >> "$PROFILES/drift-history.jsonl" 2>/dev/null || true

# Notify if drift found
echo "$REPORT" | $UV run python -c "
import sys, json
from shared.notify import send_notification
r = json.load(sys.stdin)
count = len(r.get('drift_items', []))
if count > 0:
    summary = r.get('summary', '')[:120]
    send_notification(f'Documentation Drift: {count} items', summary, tags=['warning'])
" 2>/dev/null || true
